' v1.5.2 core fixes (review 5 CS-n / ST-n): the pure helpers

sub test_cs1_effectiveAdmin()
    t_ok(MissingArt_effectiveAdmin(true, { url: "http://a", maxRating: "" }), "admin, no limit")
    t_ok(not MissingArt_effectiveAdmin(true, { url: "http://a", maxRating: "PG" }), "admin under PG is not an admin")
    t_ok(not MissingArt_effectiveAdmin(false, { maxRating: "" }), "not an admin")
    t_ok(not MissingArt_effectiveAdmin(true, invalid), "no server")
    t_ok(MissingArt_effectiveAdmin(true, { url: "http://a" }), "no maxRating field")
    t_ok(Ratings_effectiveAdmin({ maxRating: "" }, true), "Ratings: admin, no limit")
    t_ok(not Ratings_effectiveAdmin({ maxRating: "R" }, true), "Ratings: admin under R")
    t_ok(not Ratings_effectiveAdmin({ maxRating: "G" }, false), "Ratings: not admin")
    t_ok(not Ratings_effectiveAdmin(invalid, true), "Ratings: no server")
end sub

sub test_cs1_keepAllowed()
    rows = [{ id: "a", name: "A" }, { id: "b", name: "B" }, { id: "c", name: "C" }]
    kept = MissingArt_keepAllowed(rows, [{ Id: "c" }, { Id: "a" }, "junk"])
    t_eq(kept.count(), 2, "two allowed")
    t_eq(kept[0].id, "a", "order of the rows kept")
    t_eq(kept[1].id, "c", "second")
    t_eq(MissingArt_keepAllowed(rows, invalid).count(), 0, "no allowed list: nothing")
    t_eq(MissingArt_keepAllowed(invalid, []).count(), 0, "no rows")
    srv = { id: "s1", maxRating: "PG" }
    items = [{ Id: "a", Type: "Movie", OfficialRating: "R" }, { Id: "b", Type: "Movie", OfficialRating: "G" }]
    kept = MissingArt_keepAllowed([{ id: "a" }, { id: "b" }], Ratings_keep(srv, items))
    t_eq(kept.count(), 1, "R dropped under PG")
    t_eq(kept[0].id, "b", "G kept")
    t_ok(MissingArt_scanPath("u", "l", 0, 300).instr("OfficialRating") > 0, "scan asks for the rating")
end sub

sub test_cs2_postOutcome()
    t_eq(MissingArt_postOutcome(204), "ok", "204")
    t_eq(MissingArt_postOutcome(200), "ok", "200")
    t_eq(MissingArt_postOutcome(401), "refused", "401")
    t_eq(MissingArt_postOutcome(403), "refused", "403")
    t_eq(MissingArt_postOutcome(500), "failed", "500")
    t_eq(MissingArt_postOutcome(-1), "failed", "no answer")
    t_eq(MissingArt_postOutcome(invalid), "failed", "invalid")
    t_eq(MissingArt_refusedText(403), "The server refused the refresh (403)", "toast")
end sub

sub v_clear()
    sec = createObject("roRegistrySection", "Cove")
    for each k in sec.getKeyList()
        sec.delete(k)
    end for
    sec.flush()
end sub

sub test_st1_scoped_keys()
    v_clear()
    Util_writeText("active", "aaaaaaaa1111")
    Prefs_setLibrary("4", "name", "Films")
    NavPrefs_setLibraryOnHome("4", false)
    sec = createObject("roRegistrySection", "Cove")
    t_ok(sec.exists("lib:aaaaaaaa:4"), "server A's key")
    t_ok(not sec.exists("lib:4"), "no shared key")
    t_eq(Prefs_library("4").name, "Films", "A sees its name")
    Util_writeText("active", "bbbbbbbb2222")
    t_eq(Prefs_library("4").name, "", "B's library 4 keeps its own name")
    t_ok(NavPrefs_libraryOnHome("4"), "B's row on")
    t_ok(NavPrefs_libraryInMyMedia("4"), "My Media default on")
    t_eq(NavPrefs_navKey("top"), "navtop:bbbbbbbb", "menu list per server")
    Prefs_setLibFilters("4", { s: "rating" })
    t_eq(Prefs_libFilters("4").s, "rating", "B's filter")
    Util_writeText("active", "aaaaaaaa1111")
    t_eq(Prefs_libFilters("4"), invalid, "A has no filter")
    Prefs_setSeriesSubLang("77", "rum")
    Util_writeText("active", "bbbbbbbb2222")
    t_eq(Prefs_seriesSubLang("77"), "", "series languages per server")
end sub

sub test_st8_compact_and_media()
    v_clear()
    Util_writeText("active", "cccccccc")
    t_eq(Prefs_library("x").media, true, "media filled in")
    Prefs_setLibrary("x", "media", false)
    t_eq(Prefs_library("x").media, false, "media off kept")
    t_ok(not NavPrefs_libraryInMyMedia("x"), "My Media off")
    stored = Util_readJson("lib:cccccccc:x")
    t_eq(stored.count(), 1, "only the changed field is written")
    Prefs_setLibrary("x", "media", true)
    t_eq(Util_readJson("lib:cccccccc:x").count(), 0, "back to the default: empty record")
    t_eq(Prefs_compactLibrary({ nav: true, home: false, name: "", style: "latest", homeOwn: true }), { home: false, homeOwn: true }, "compact")
end sub

sub test_st1_migration()
    v_clear()
    sec = createObject("roRegistrySection", "Cove")
    sec.write("lib:4", formatJson({ name: "Films" }))
    sec.write("navtop", "search,-L4")
    sec.write("libFilters", formatJson([{ id: "4", s: "rating" }]))
    sec.write("seriesLangs", formatJson([{ id: "77", lang: "rum" }]))
    sec.write("lib:dddddddd:9", "{}")
    sec.flush()
    t_eq(Prefs_migrateScoped("dddddddd5555"), 4, "four moved")
    t_ok(not sec.exists("lib:4"), "old library key gone")
    t_ok(not sec.exists("navtop"), "old menu key gone")
    t_eq(Util_readText("navtop:dddddddd"), "search,-L4", "menu list moved")
    Util_writeText("active", "dddddddd5555")
    t_eq(Prefs_library("4").name, "Films", "name moved to the active server")
    t_eq(Prefs_libFilters("4").s, "rating", "filter moved")
    t_eq(Prefs_seriesSubLang("77"), "rum", "series language moved")
    t_eq(Prefs_migrateScoped("dddddddd5555"), 0, "runs once")
    t_eq(Prefs_migrateScoped(""), 0, "no server: nothing")
end sub

sub test_cs3_forgetAll()
    v_clear()
    Util_writeText("active", "eeeeeeee0001")
    Prefs_setLibrary("4", "name", "A")
    NavPrefs_setShown("top", "recent", false, [{ id: "4", title: "M" }])
    Prefs_setLibFilters("4", { s: "rating" })
    Prefs_setSeriesSubLang("77", "rum")
    Util_writeText("active", "ffffffff0002")
    Prefs_setLibrary("4", "name", "B")
    Prefs_setLibFilters("4", { s: "year" })
    Servers_forgetAll("eeeeeeee0001")
    sec = createObject("roRegistrySection", "Cove")
    t_ok(not sec.exists("lib:eeeeeeee:4"), "A's library gone")
    t_ok(not sec.exists("navtop:eeeeeeee"), "A's menu list gone")
    t_ok(sec.exists("lib:ffffffff:4"), "B's library kept")
    t_eq(Prefs_library("4").name, "B", "B's name kept")
    t_eq(Prefs_libFilters("4").s, "year", "B's filter kept")
    t_eq(Util_readJson("libFilters").count(), 1, "A's filter gone")
    t_eq(Util_readJson("seriesLangs").count(), 0, "A's series language gone")
    t_eq(Servers_withoutTag([{ id: "ab:1" }, { id: "cd:1" }, "x"], "ab").count(), 2, "withoutTag")
end sub

sub test_st5_newRoute()
    t_eq(Api_newRoute("/Users/u1/Views", "u1"), "/UserViews?userId=u1", "views")
    t_eq(Api_newRoute("/Users/u1/Items?ParentId=4&Limit=3", "u1"), "/Items?userId=u1&ParentId=4&Limit=3", "items")
    t_eq(Api_newRoute("/Users/u1/Items/x9?Fields=Path", "u1"), "/Items/x9?userId=u1&Fields=Path", "one item")
    t_eq(Api_newRoute("/Users/u1/Items/Latest?Limit=3", "u1"), "/Items/Latest?userId=u1&Limit=3", "latest")
    t_eq(Api_newRoute("/Users/u1/Items/x9/Refresh", "u1"), "", "deeper path: none")
    t_eq(Api_newRoute("/Users/u2/Views", "u1"), "", "another user")
    t_eq(Api_newRoute("/Shows/NextUp", "u1"), "", "not a user route")
    t_eq(Api_newRoute("/Users/u1/Views", ""), "", "no user")
    t_eq(Api_routeKind("/Users/u1/Views"), "Views", "same route kind as Home")
end sub

sub test_cs7_token_origin()
    t_ok(Util_tokenSafeTarget("http://h:8096", "http://h:8096/videos/1/master.m3u8"), "same origin")
    t_ok(not Util_tokenSafeTarget("http://h:8096", "http://h:9999/videos/1"), "same host, another port")
    t_ok(not Util_tokenSafeTarget("https://h:8920", "https://h:8096/x"), "8920 vs 8096")
    t_ok(Util_tokenSafeTarget("https://h", "https://h:443/x"), "default port written out")
    t_ok(Util_tokenSafeTarget("http://h", "https://h/x"), "http upgraded 80 → 443")
    t_ok(Util_tokenSafeTarget("http://h:8096", "https://h:8096/x"), "upgrade on the same port")
    t_ok(not Util_tokenSafeTarget("http://h:8096", "https://h/x"), "upgrade to another port")
    t_ok(Util_tokenSafeTarget("http://h:8096", "/videos/1"), "relative")
end sub

sub test_cs4_retriesSilent()
    t_ok(Api_retriesSilent(1, 7), "one silent of seven: ask again")
    t_ok(Api_retriesSilent(6, 7), "six of seven")
    t_ok(not Api_retriesSilent(7, 7), "all silent: no retry")
    t_ok(not Api_retriesSilent(0, 7), "all answered")
    t_ok(not Api_retriesSilent(1, 1), "the only one silent")
end sub
