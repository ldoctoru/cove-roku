' v1.6 core: ST-9 per-profile preferences (PrefScope + Util), CS-8 Emby sign-in headers, CS-11 PIN check

sub c16_clear()
    sec = createObject("roRegistrySection", "Cove")
    for each k in sec.getKeyList()
        sec.delete(k)
    end for
    sec.flush()
end sub

' One server "srv1aaaa…" with two profiles, the first one active
sub c16_twoProfiles()
    c16_clear()
    Servers_saveAll([{ id: "srv1aaaa0000", name: "Home", url: "http://192.168.1.2:8096", type: "emby", cur: "userAAAA1111", users: [{ i: "userAAAA1111", n: "Liviu", t: "tok1" }, { i: "userBBBB2222", n: "Kids", t: "tok2" }] }])
    Servers_setActive("srv1aaaa0000")
end sub

sub test_st9_isPersonal()
    t_ok(PrefScope_isPersonal("subLang"), "subLang")
    t_ok(PrefScope_isPersonal("navStyle"), "navStyle")
    t_ok(PrefScope_isPersonal("seriesLangs"), "seriesLangs")
    t_ok(PrefScope_isPersonal("lib:srv1aaaa:4"), "a library")
    t_ok(PrefScope_isPersonal("homeRows:srv1aaaa0000"), "Home rows")
    t_ok(PrefScope_isPersonal("navside:srv1aaaa"), "sidebar list")
    t_ok(PrefScope_isPersonal("libOrder:srv1aaaa0000"), "library order")
    t_ok(PrefScope_isPersonal("banner"), "banner")
    t_ok(PrefScope_isPersonal("subBg"), "subtitle style")
    t_ok(not PrefScope_isPersonal("lib:"), "a bare prefix")
    t_ok(not PrefScope_isPersonal("subLang@userAAAA"), "already a profile key")
    for each k in ["servers", "active", "pinWait", "pscope", "startQualityHome", "startQualityNet", "audioChannels", "dtsPassthrough", "rewindOnResume", "jumpSeconds", "skipSeconds", "background", "dimWatched", "hintOpts", "segSkip", "autoNext", "authLegacy"]
        t_ok(not PrefScope_isPersonal(k), "shared: " + k)
    end for
end sub

sub test_st9_pure_helpers()
    js = FormatJson([{ id: "x", cur: "nobody" }, { id: "srv1", cur: "abcdef0123456789" }])
    t_eq(PrefScope_activeOf("srv1", js), "abcdef01", "active user's p")
    t_eq(PrefScope_activeOf("srv2", js), "", "unknown server")
    t_eq(PrefScope_activeOf("", js), "", "no active server")
    t_eq(PrefScope_activeOf("srv1", "not json"), "", "broken record")
    t_eq(PrefScope_activeOf("srv1", FormatJson([{ id: "srv1" }])), "", "no cur")
    t_eq(PrefScope_activeOf("srv1", FormatJson(["junk", { id: 5 }, { id: "srv1", cur: "u1" }])), "u1", "junk entries skipped")
    t_ok(PrefScope_belongsTo("subLang@abcdef01", "abcdef01"), "belongs")
    t_ok(not PrefScope_belongsTo("subLang@abcdef02", "abcdef01"), "another profile")
    t_ok(not PrefScope_belongsTo("subLang", "abcdef01"), "shared")
    t_ok(not PrefScope_belongsTo("subLang@abcdef01", ""), "no profile")
    keep = { servers: true }
    t_ok(not PrefScope_resetGoes("servers", keep, "p1"), "kept")
    t_ok(PrefScope_resetGoes("subLang", keep, "p1"), "shared setting goes")
    t_ok(PrefScope_resetGoes("subLang@p1", keep, "p1"), "this profile's goes")
    t_ok(not PrefScope_resetGoes("subLang@p2", keep, "p1"), "another profile's stays")
    t_eq(PrefScope_keyOf("subLang", "p1"), "subLang@p1", "key form")
end sub

sub test_st9_sync_follows_profile()
    c16_twoProfiles()
    t_eq(PrefScope_current(), "userAAAA", "first profile active")
    Servers_useUser("srv1aaaa0000", "userBBBB2222")
    t_eq(PrefScope_current(), "userBBBB", "switched profile")
    Servers_setActive("")
    t_eq(PrefScope_current(), "", "no server: shared keys")
end sub

sub test_st9_fallback_and_own_values()
    c16_twoProfiles()
    sec = createObject("roRegistrySection", "Cove")
    ' (a v1.5 setting, shared)
    sec.write("subLang", "romanian")
    sec.write("navStyle", "topbar")
    t_eq(Prefs_subLang(), "romanian", "profile A starts with the shared value")
    Util_writeText("subLang", "french")
    t_ok(sec.exists("subLang@userAAAA"), "A's own key")
    t_eq(sec.read("subLang"), "romanian", "shared value untouched")
    t_eq(Prefs_subLang(), "french", "A sees its own")
    Servers_useUser("srv1aaaa0000", "userBBBB2222")
    t_eq(Prefs_subLang(), "romanian", "B still has the shared value")
    t_eq(Prefs_navStyle(), "topbar", "B's menu style from the shared value")
    NavPrefs_setMenuStyle("sidebar")
    t_eq(Prefs_navStyle(), "sidebar", "B changed its menu")
    Servers_useUser("srv1aaaa0000", "userAAAA1111")
    t_eq(Prefs_navStyle(), "topbar", "A keeps the top bar")
    t_eq(Prefs_subLang(), "french", "A keeps French")
end sub

sub test_st9_library_and_lists_per_profile()
    c16_twoProfiles()
    Prefs_setLibrary("4", "name", "Films")
    Prefs_setSeriesSubLang("ser1", "rum")
    Prefs_setLibFilters("4", { s: "rating" })
    t_eq(Prefs_library("4").name, "Films", "A's name")
    Servers_useUser("srv1aaaa0000", "userBBBB2222")
    t_eq(Prefs_library("4").name, "", "B: the server's name")
    t_eq(Prefs_seriesSubLang("ser1"), "", "B: no series language")
    t_ok(Prefs_libFilters("4") = invalid, "B: no page filters")
    Prefs_setSeriesSubLang("ser1", "eng")
    Servers_useUser("srv1aaaa0000", "userAAAA1111")
    t_eq(Prefs_seriesSubLang("ser1"), "rum", "A keeps its series language")
    t_eq(Util_toText(Prefs_libFilters("4").s), "rating", "A keeps its filters")
end sub

sub test_st9_deletePref_tombstone()
    c16_twoProfiles()
    sec = createObject("roRegistrySection", "Cove")
    sec.write("navside:srv1aaaa", "home,lib:4-")
    Util_deletePref("navside:srv1aaaa")
    t_ok(sec.exists("navside:srv1aaaa"), "shared list kept for the others")
    t_eq(sec.read("navside:srv1aaaa@userAAAA"), "", "A's list back to the default")
    t_eq(Util_readText("navside:srv1aaaa"), "", "A reads the default, not the shared list")
    ' (no shared value: the profile key just goes)
    Util_writeText("banner", "random,0")
    t_ok(sec.exists("banner@userAAAA"), "A's banner")
    Util_deletePref("banner")
    t_ok(not sec.exists("banner@userAAAA"), "A's banner key removed")
    ' (a shared setting is deleted as before)
    sec.write("jumpSeconds", "60")
    Util_deletePref("jumpSeconds")
    t_ok(not sec.exists("jumpSeconds"), "shared key removed")
    ' (readJson of a tombstone is invalid, not a parse error)
    Util_writeText("seriesLangs", "")
    t_ok(Util_readJson("seriesLangs") = invalid, "empty personal list")
end sub

sub test_st9_forget_and_reset()
    c16_twoProfiles()
    sec = createObject("roRegistrySection", "Cove")
    Util_writeText("subLang", "french")
    sec.write("subLang", "romanian")
    sec.write("jumpSeconds", "60")
    Servers_useUser("srv1aaaa0000", "userBBBB2222")
    Util_writeText("subLang", "german")
    Prefs_resetAll()
    t_ok(not sec.exists("subLang@userBBBB"), "reset: this profile's own setting gone")
    t_ok(not sec.exists("subLang"), "reset: the shared setting gone")
    t_ok(not sec.exists("jumpSeconds"), "reset: a TV setting gone")
    t_ok(sec.exists("subLang@userAAAA"), "reset: the other profile keeps its own")
    t_ok(sec.exists("servers") and sec.exists("active") and sec.exists("pscope"), "reset: sign-ins and the profile kept")
    t_eq(Prefs_subLang(), "english", "B back to the default")
    Servers_removeUser("srv1aaaa0000", "userAAAA1111")
    t_ok(not sec.exists("subLang@userAAAA"), "a removed profile's settings go")
    ' (a removed server takes its profiles' settings along)
    Util_writeText("navStyle", "topbar")
    t_ok(sec.exists("navStyle@userBBBB"), "B's menu")
    Servers_forgetAll("srv1aaaa0000")
    t_ok(not sec.exists("navStyle@userBBBB"), "server removed: its profiles' settings go")
end sub

sub test_st9_trim_profile_lists()
    c16_twoProfiles()
    sec = createObject("roRegistrySection", "Cove")
    big = []
    for i = 1 to 10
        big.push({ id: "srv1aaaa:" + i.toStr(), lang: "rum" })
    end for
    sec.write("seriesLangs@userAAAA", FormatJson(big))
    sec.write("seriesLangs", FormatJson(big))
    Util_trimLists(sec)
    t_eq(ParseJson(sec.read("seriesLangs@userAAAA")).count(), 5, "profile list halved")
    t_eq(ParseJson(sec.read("seriesLangs")).count(), 5, "shared list halved")
end sub
