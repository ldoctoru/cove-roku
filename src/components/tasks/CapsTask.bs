import "pkg:/source/Util.bs"
import "pkg:/source/DeviceCaps.bs"
import "pkg:/source/Log.bs"

sub init()
    m.top.functionName = "work"
end sub

sub work()
    try
        m.top.line = DeviceCaps.deviceLine(DeviceCaps.get())
    catch e
        Log.line("Cove: device check failed: " + Util.redact(Util.toText(e.message)))
    end try
    ' (v1.7.1 NV6-2) the batched log lines left
    Log.flush()
end sub
