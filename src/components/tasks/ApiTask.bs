import "pkg:/source/Api.bs"
import "pkg:/source/Subs.bs"
import "pkg:/source/Log.bs"

sub init()
    m.top.functionName = "work"
end sub

sub work()
    req = m.top.request
    reqTag = invalid
    if Util.isAA(req) then reqTag = req.tag
    try
        if Util.toText(req.readFrom) <> ""
            ' (v1.3.1 E-10) a subtitle track downloaded before in this session (tmp:/)
            r = readCached(req)
        else
            r = timedExecute(req)
        end if
        ' a route that only newer servers have (or only older ones): the same request on the other route
        if r.code = 404 and Util.toText(req.fallbackUrl) <> ""
            alt = {}
            alt.append(req)
            alt.url = req.fallbackUrl
            alt.delay = 0
            r = timedExecute(alt)
        end if
        ' a download nobody wants any more (the player closed): don't leave it in tmp:
        if req.saveTo <> invalid and m.top.discard then DeleteFile(req.saveTo)
        ' subtitles: parsed here, off the render thread
        if Util.toText(req.parse) = "srt"
            r.cues = Subs.parseSrt(r.text)
            saveCached(req, r)
            r.text = invalid
        end if
        m.top.response = r
    catch e
        ' (an exception must still answer: callers wait on response, e.g. "Connecting..." or the player's ring)
        msg = Util.toText(e.message)
        where = ""
        if type(e.backtrace) = "roArray" and e.backtrace.count() > 0
            frame = e.backtrace[e.backtrace.count() - 1]
            if Util.isAA(frame) then where = " (" + Util.toText(frame.filename) + ":" + Util.toText(frame.line_number) + ")"
        end if
        Log.line("Cove: ApiTask failed: " + Util.redact(msg + where))
        m.top.response = { code: -1, json: invalid, value: invalid, error: "The request failed: " + msg, tag: reqTag }
    end try
end sub

' (v1.3.1 E-10) req.readFrom → { code 200, text } from tmp:/, or code -2 when the file is gone
function readCached(req as object) as object
    r = { code: -2, json: invalid, value: invalid, text: invalid, error: "", tag: req.tag }
    path = Util.toText(req.readFrom)
    fs = createObject("roFileSystem")
    if fs <> invalid and fs.exists(path)
        r.text = ReadAsciiFile(path)
        if r.text <> invalid and r.text <> "" then r.code = 200
    end if
    Log.line("Cove: subtitle from the session copy -> " + Util.toText(r.code))
    return r
end function

' The whole track in req.cacheTo (only when cues came, and a piece only when it reached past cacheIfPast)
sub saveCached(req as object, r as object)
    path = Util.toText(req.cacheTo)
    if path = "" or r.code <> 200 or type(r.cues) <> "roArray" or r.cues.count() = 0 or r.text = invalid then return
    lastEnd = r.cues[r.cues.count() - 1].e
    past = Util.toNumber(req.cacheIfPast)
    if past > 0 and lastEnd <= past then return
    if WriteAsciiFile(path, r.text) then r.savedTo = path
end sub

' (v1.1.1) Api.execute with one timing line: "Cove: http GET /Users/x/Items 200 143" (ms, without a delay)
function timedExecute(req as object) as object
    stopwatch = createObject("roTimespan")
    r = Api.execute(req)
    ms = stopwatch.totalMilliseconds()
    if req.delay <> invalid and req.delay > 0 then ms = ms - req.delay
    Log.line("Cove: " + Util.redact(Api.timingLine(Util.toText(req.method), Util.toText(req.url), r.code, ms)))
    return r
end function
