import "pkg:/source/Api.bs"
import "pkg:/source/Items.bs"
import "pkg:/source/Prefs.bs"
import "pkg:/source/Ratings.bs"
import "pkg:/source/HomeLayout.bs"
import "pkg:/source/NavPrefs.bs"
import "pkg:/source/Dates.bs"
import "pkg:/source/QuickPlay.bs"
import "pkg:/source/Servers.bs"
import "pkg:/source/Clock.bs"
import "pkg:/source/HomeBanner.bs"
import "pkg:/source/Log.bs"

sub init()
    m.top.functionName = "work"
end sub

' Any runtime error must reach the screen (a Task that stops on an error just goes quiet, leaving "Loading...")
sub work()
    try
        if m.top.bannerOnly
            ' (v1.3.2) Settings → Home → Refresh banner: only the banner's list, the rows stay
            m.srv = m.top.server
            m.h = Api.headers(m.srv, true)
            loadBanner(m.top.libraries)
        else
            m.delivered = false
            m.because = invalid
            load()
            ' (v1.3.2) the banner's own titles after the rows are on screen (never slowing them down)
            if m.delivered and not m.top.authFailed then loadBanner(m.top.libraries)
            ' (v1.7 NAV M-6) Because You Watched, put in place among the rows on screen
            if m.delivered and not m.top.authFailed and m.because <> invalid then loadBecause()
            ' (v1.7.1 NV6-1) Because You Watched is no longer among the rows: the rows Home carried over go
            if m.delivered and not m.top.authFailed and m.because = invalid and m.top.becauseAge >= 0 then dropBecauseRows()
        end if
    catch e
        where = ""
        if e.backtrace <> invalid and e.backtrace.count() > 0
            f = e.backtrace[e.backtrace.count() - 1]
            where = " at " + Util.toText(f.filename).replace("pkg:/", "") + ":" + Util.toText(f.line_number)
        end if
        Log.line("Cove: home failed: " + Util.redact(Util.toText(e.message)) + Util.toText(where))
        m.top.error = "Loading failed: " + Util.toText(e.message) + where
    end try
end sub

sub load()
    srv = m.top.server
    if m.top.timing then Clock.startupMark("home task running")
    Log.line("Cove: home loading from " + Util.toText(Util.originOf(Util.toText(srv.url))))
    m.srv = srv
    m.h = Api.headers(srv, true)
    uid = Util.toText(srv.userId)
    f = Items.fields()
    root = createObject("roSGNode", "ContentNode")
    m.failures = 0
    m.requests = 0

    ' The libraries first (the rows depend on them); Jellyfin 10.9+ also has /UserItems, /UserViews, while the
    ' /Users/{id}/... routes work on Emby and Jellyfin
    ' (C2-12: Jellyfin answers 403 for a revoked token too: the libraries request then asks for the sign-in)
    views = fetchList("/Users/" + uid + "/Views", "/UserViews?userId=" + uid, true)
    if m.top.authFailed then return
    ' Settings → Libraries: their order and names, which are in the sidebar / on Home, and what the row shows
    libs = []
    for each v in views
        libs.push({ id: Util.toText(v.Id), title: Util.toText(v.Name), itemType: Util.toText(v.Type), collectionType: LCase(Util.toText(v.CollectionType)), view: v })
    end for
    sid = Util.toText(srv.id)
    libs = Prefs.orderLibraries(libs, sid)
    ' (v1.5) a library hidden from the sidebar had no Home row before: it keeps none (once per library)
    migrated = NavPrefs.migrateHome(libs)
    if migrated > 0 then Log.line("Cove: home migration: " + Util.toText(migrated.toStr()) + " libraries hidden from the sidebar keep no Home row")
    ' (v1.5) My Media (Emby's row of library tiles): each library's own switch, not the menu's list any more
    shown = []
    byId = {}
    for each l in HomeLayout.myMediaLibs(libs)
        v = l.view
        v.Name = l.title
        shown.push(v)
    end for
    for each l in libs
        byId[HomeLayout.libRowId(l.id)] = l
        l.delete("view")
    end for
    m.top.libraries = libs
    if m.top.timing then Clock.startupMark("home libraries read")

    ' Settings → Home → Rows: the order and switches, or the server's Home layout (its web app's Home sections)
    ids = HomeLayout.orderedIds(sid, libs)
    serverMode = HomeLayout.useServerLayout(sid)
    m.sections = invalid
    m.spotlightId = ""
    if serverMode
        fromSrv = invalid
        ' (v1.6 H-1) Emby 4.10+: the new Home sections (Spotlight, Dynamic media, custom names); a 404 or an
        ' empty answer falls back to the legacy CustomPrefs below (Jellyfin keeps those)
        if HomeLayout.hasHomeSections(Servers.isJellyfin(srv), Util.toText(srv.version))
            m.sections = homeSections(uid, libs)
            if m.sections <> invalid
                fromSrv = m.sections.ids
                m.spotlightId = m.sections.spotlight
            end if
        end if
        if fromSrv = invalid then fromSrv = HomeLayout.fromServer(displayPrefs(uid), libs)
        if fromSrv = invalid
            Log.line("Cove: home: the server's Home layout couldn't be read, using Cove's")
            serverMode = false
        else
            ids = fromSrv
        end if
    end if
    Log.line("Cove: home rows order " + Util.toText(Util.join(ids, ",").len()) + " chars, server layout " + Util.toText(serverMode))
    ' (v1.1) Settings → Home → Row options
    unw = HomeLayout.unwatchedQuery(Prefs.hideWatchedLatest())
    cutoff = ""
    if Prefs.nextUpDays() > 0 then cutoff = Dates.isoDaysAgo(Prefs.nextUpDays())
    nuq = HomeLayout.nextUpQuery(Servers.isJellyfin(srv), Prefs.nextUpRewatch(), cutoff)
    ' (v1.1.1 SP-4) the lists are fetched first and the rows built after, so a kids limit asks for the series
    ' ratings of all rows in one request instead of one per row
    m.pendingRows = []
    m.firstLogged = not m.top.timing
    for each id in ids
        isShown = false
        if serverMode
            ' (the server decides the sections; a library's row still needs its Home switch on)
            isShown = true
            if id.left(1) = "L" then isShown = NavPrefs.libraryOnHome(id.mid(1))
        else
            isShown = HomeLayout.isOn(sid, id)
        end if
        if isShown
            if id = "resume"
                queueRow("Continue Watching", getList("/Users/" + uid + "/Items/Resume?Limit=20&MediaTypes=Video&" + f, "/UserItems/Resume?userId=" + uid + "&Limit=20&MediaTypes=Video&" + f), true)
                m.pendingRows.peek().preset = { kind: "resume" }
            else if id = "nextup"
                queueRow("Next Up", getList("/Shows/NextUp?UserId=" + uid + "&Limit=20" + nuq + "&" + f, ""), true)
                m.pendingRows.peek().preset = { kind: "nextup" }
            else if id = "upcoming"
                ' (v1.1) episodes not aired yet (both servers); no row when the server has none
                queueRow("Upcoming", getList("/Shows/Upcoming?UserId=" + uid + "&Limit=20&" + f, ""), true, true)
                m.pendingRows.peek().preset = { kind: "upcoming" }
            else if id = "released"
                rq = HomeLayout.releasedQuery(Dates.isoNow(), Prefs.hideWatchedLatest()) + "&" + f
                queueRow("Recently Released", getList("/Users/" + uid + "/Items?" + rq, "/Items?userId=" + uid + "&" + rq), false)
                m.pendingRows.peek().preset = { kind: "released" }
            else if id = "favorites"
                queueRow("Favorites", getList("/Users/" + uid + "/Items?Filters=IsFavorite&Recursive=true&IncludeItemTypes=Movie,Series,Episode,Video&SortBy=SortName&Limit=40&" + f, "/Items?userId=" + uid + "&Filters=IsFavorite&Recursive=true&IncludeItemTypes=Movie,Series,Episode,Video&SortBy=SortName&Limit=40&" + f), false)
                m.pendingRows.peek().preset = { kind: "favorites" }
            else if id = "recent"
                queueRow("Recently Added", getList("/Users/" + uid + "/Items/Latest?Limit=20" + unw + "&" + f, "/Items/Latest?userId=" + uid + "&Limit=20" + unw + "&" + f), false)
                m.pendingRows.peek().preset = { kind: "recent" }
            else if m.sections <> invalid and m.sections.rows.doesExist(id)
                ' (v1.6 H-1) an Emby 4.10 section of its own (Dynamic media, a collection, tag, genre ...)
                sec = m.sections.rows[id]
                queueRow(sec.title, getList("/Users/" + uid + "/Sections/" + sec.sectionId + "/Items?Limit=20&" + f, ""), sec.landscape)
                m.pendingRows.peek().preset = { kind: "section", sectionId: sec.sectionId }
                m.pendingRows.peek().sectionKind = sec.kind
            else if id = "because"
                ' (v1.7 NAV M-6) fetched after the rows are delivered (loadBecause); placed after the rows
                ' queued before it
                before = {}
                for each p in m.pendingRows
                    before[p.title] = true
                end for
                m.because = { before: before }
            else if id = "libraries"
                Log.line("Cove: home my media " + Util.toText(shown.count()) + " libraries")
                queueRow("My Media", shown, false)
                m.pendingRows.peek().myMedia = true
            else if byId.doesExist(id)
                l = byId[id]
                lp = Prefs.library(l.id)
                ' (v1.5) every library kind has a row (an empty one is left out)
                queueRow(rowTitle(lp.style, l.title), libraryRow(uid, l, lp.style, f, unw), false)
                m.pendingRows.peek().libRow = true
                m.pendingRows.peek().preset = { kind: "library", libId: l.id, collectionType: l.collectionType, style: lp.style }
            end if
        end if
    end for
    ' (v1.2) every row's request at once, except Upcoming: on Emby it took 7 s (or never answered) while the
    ' other lists ran, and ~0.1 s alone. Home shows the other rows first; Upcoming follows on its own.
    fetchQueued(false)
    if m.top.authFailed then return
    if m.top.timing then Clock.startupMark("home lists fetched")
    hasLate = false
    for each p in m.pendingRows
        if p.spec <> invalid and not p.spec.done then hasLate = true
    end for
    if hasLate
        first = createObject("roSGNode", "ContentNode")
        buildRows(first, true)
        shownFirst = first.getChildCount() > 0
        if shownFirst
            Log.line(Util.toText("Cove: home rows " + first.getChildCount().toStr() + " (library rows " + m.libRowsShown.toStr() + ", Upcoming still loading)"))
            if m.top.timing then Log.line("Cove: home all rows " + Util.toText(Clock.msSinceLaunch()) + " ms after launch (without Upcoming)")
            m.top.partial = true
            m.top.content = first
        end if
        fetchQueued(true)
        if m.top.authFailed then return
        if m.top.timing then Clock.startupMark("home upcoming fetched")
        ' (v1.2) the rows already on screen get the late row put in place, instead of all 7 rows being built
        ' and drawn again (~0.45 s on the Streambar)
        if shownFirst
            insertLateRows(first)
            Log.line(Util.toText("Cove: home rows " + first.getChildCount().toStr() + " (library rows " + m.libRowsShown.toStr() + ")"))
            if m.top.timing then Log.line("Cove: home all rows " + Util.toText(Clock.msSinceLaunch()) + " ms after launch")
            m.top.rowsAdded = m.top.rowsAdded + 1
            m.pendingRows = []
            m.delivered = true
            return
        end if
    end if
    buildRows(root, false)
    if m.top.timing then Clock.startupMark("home rows built")

    if root.getChildCount() = 0
        if m.failures > 0
            m.top.error = "Couldn't load your libraries from " + Util.toText(srv.name) + "."
        else
            m.top.error = "Nothing to show yet: your libraries on " + Util.toText(srv.name) + " are empty."
        end if
        return
    end if
    Log.line(Util.toText("Cove: home rows " + root.getChildCount().toStr() + " (library rows " + m.libRowsShown.toStr() + ")"))
    if m.top.timing then Log.line("Cove: home all rows " + Util.toText(Clock.msSinceLaunch()) + " ms after launch")
    m.top.partial = false
    m.top.content = root
    m.delivered = true
end sub

' (v1.3.2) Settings → Home → Banner shows: Newest / Random Picks / Favorites from the libraries on Home, at
' most 8 films and shows with a backdrop, delivered as heroItems (a ContentNode of cards). From Home Rows,
' nothing found or a failed request: heroItems stays empty and Home keeps the rows' titles.
sub loadBanner(libs as dynamic)
    source = Util.toText(m.top.bannerSource)
    ' (v1.6 H-1) From Home Rows with an Emby 4.10 Spotlight section: the banner shows the Spotlight's titles
    if source = "rows" and Util.toText(m.spotlightId) <> "" and not m.top.bannerOnly then loadSpotlight()
    if source = "" or source = "rows" then return
    stopwatch = createObject("roTimespan")
    parents = []
    kinds = {}
    if type(libs) = "roArray"
        for each l in libs
            ct = Util.toText(l.collectionType)
            if NavPrefs.libraryOnHome(Util.toText(l.id)) and Prefs.holdsFilmsOrShows(ct)
                parents.push(Util.toText(l.id))
                kinds[Util.toText(l.id)] = ct
            end if
        end for
    end if
    fetched = invalid
    ' (v1.7, Liviu) no library with a Home row (the row is its own switch since v1.5): the whole server, in
    ' one query per kind (parents [] = every library; films and shows only), instead of an empty banner
    if parents.count() = 0 and HomeBanner.anyFilmsOrShows(libs)
        Log.line("Cove: home banner " + source + " from all libraries (no library row on Home)")
    else if type(libs) = "roArray" and libs.count() > 0 and parents.count() = 0
        ' (no film or show library at all: nothing to pick from)
        fetched = []
    end if
    if fetched = invalid
        paths = HomeBanner.queries(source, Util.toText(m.srv.userId), parents, kinds)
        reqs = []
        for each path in paths
            reqs.push({ url: Util.toText(m.srv.url) + Ratings.withLimit(m.srv, path), headers: m.h })
        end for
        ' (the rows are done: at most two at a time, each with its own deadline)
        answers = Api.executeMany(reqs, 8000, 2)
        for k = 0 to answers.count() - 1
            r = answers[k]
            Log.line("Cove: " + Util.redact(Api.timingLine("GET", paths[k], r.code, r.ms)))
            if r.code = 200 and r.json <> invalid
                if fetched = invalid then fetched = []
                list = Util.field(r.json, "Items")
                if type(list) = "roArray" then fetched.append(list)
            end if
        end for
    end if
    if fetched <> invalid
        fetched = Ratings.keepChecked(m.srv, fetched)
        if source = "newest"
            fetched = HomeBanner.newestFirst(fetched)
        else
            fetched = shuffled(fetched)
            if source = "random" then fetched = HomeBanner.preferUnwatched(fetched)
            ' (a refresh: titles not in the banner on screen first)
            if type(m.top.bannerPrevious) = "roArray" and m.top.bannerPrevious.count() > 0 then fetched = HomeBanner.avoidingPrevious(fetched, m.top.bannerPrevious)
        end if
    end if
    reason = HomeBanner.fallbackReason(source, fetched)
    ms = stopwatch.totalMilliseconds()
    if reason <> ""
        Log.line("Cove: home banner " + Util.toText(source) + " fallback to Home rows (" + Util.toText(reason) + ") " + Util.toText(ms) + " ms")
        m.top.heroItems = createObject("roSGNode", "ContentNode")
        return
    end if
    picked = HomeBanner.resolveTitles(source, fetched)
    out = createObject("roSGNode", "ContentNode")
    for each it in picked
        out.appendChild(Items.node(m.srv, it, true))
    end for
    Log.line("Cove: home banner " + Util.toText(source) + " " + Util.toText(out.getChildCount()) + " titles " + Util.toText(ms) + " ms")
    m.top.heroItems = out
end sub

' The list in a random order (Fisher-Yates)
function shuffled(list as object) as object
    out = []
    out.append(list)
    i = out.count() - 1
    while i > 0
        j = Rnd(i + 1) - 1
        tmp = out[i]
        out[i] = out[j]
        out[j] = tmp
        i = i - 1
    end while
    return out
end function

' A row to load: "what" is a request from getList ({ path, fallback, ... }) or a list already known (Libraries)
sub queueRow(title as string, what as object, isLandscape as boolean, isUpcoming = false as boolean)
    p = { title: title, list: [], landscape: isLandscape, upcoming: isUpcoming, spec: invalid, preset: invalid, sectionKind: "", ms: 0 }
    if type(what) = "roArray"
        p.list = what
    else
        p.spec = what
    end if
    m.pendingRows.push(p)
end sub

' (v1.2) The queued rows' requests, all at once (Api.executeMany); a 404 tries the newer Jellyfin route in a
' second round. Each answer is read as getList used to read it (route memory, 401, failures, objects only).
sub fetchQueued(late as boolean)
    rounds = 0
    while rounds < 2
        rounds = rounds + 1
        reqs = []
        which = []
        for i = 0 to m.pendingRows.count() - 1
            sp = m.pendingRows[i].spec
            if sp <> invalid and not sp.done and (late or not m.pendingRows[i].upcoming)
                reqs.push({ url: Util.toText(m.srv.url) + sp.path, headers: m.h })
                which.push(i)
            end if
        end for
        if reqs.count() = 0 then exit while
        answers = Api.executeMany(reqs, 8000, 4)
        ' (v1.5.2 CS-4) requests with no answer at all: asked again together (one Upcoming request never
        ' answered while 7 others ran), not one after another; when none of them answered the server is stuck,
        ' so Home shows its error panel now instead of after 8 s per row
        silent = []
        for k = 0 to answers.count() - 1
            Log.line("Cove: " + Util.redact(Api.timingLine("GET", m.pendingRows[which[k]].spec.path, answers[k].code, answers[k].ms)))
            if answers[k].timedOut = true then silent.push(k)
        end for
        if rounds = 1 and Api.retriesSilent(silent.count(), answers.count())
            Log.line("Cove: home " + Util.toText(silent.count()) + " lists didn't answer, asking again together")
            again = []
            for each k in silent
                again.push(reqs[k])
            end for
            retried = Api.executeMany(again, 8000, 2)
            for j = 0 to silent.count() - 1
                r = retried[j]
                Log.line("Cove: " + Util.redact(Api.timingLine("GET", m.pendingRows[which[silent[j]]].spec.path, r.code, r.ms)))
                r.timedOut = false
                answers[silent[j]] = r
            end for
        else if silent.count() > 0
            Log.line("Cove: home " + Util.toText(silent.count()) + " of " + Util.toText(answers.count()) + " lists didn't answer, not asking again")
        end if
        for k = 0 to answers.count() - 1
            p = m.pendingRows[which[k]]
            sp = p.spec
            r = answers[k]
            if r.code = 404 and sp.fallback <> "" and rounds = 1
                ' (the newer route next round)
                sp.path = sp.fallback
                sp.fallback = ""
                sp.usedNew = true
            else
                sp.done = true
                p.ms = r.ms
                p.list = readList(r, sp)
                if not m.firstLogged and p.list.count() > 0
                    m.firstLogged = true
                    Log.line("Cove: home first rows " + Util.toText(Clock.msSinceLaunch()) + " ms after launch")
                end if
            end if
        end for
    end while
end sub

' (SP-4) One series-ratings request for every row's unrated episodes, then the rows
' (skipLate: leave out the rows whose request hasn't answered yet; the list stays for the full build)
sub buildRows(root as object, skipLate = false as boolean)
    if Ratings.limitOf(m.srv) > 0
        everything = []
        for each p in m.pendingRows
            everything.append(p.list)
        end for
        Ratings.prefetchSeries(m.srv, everything)
    end if
    m.libRowsShown = 0
    for each p in m.pendingRows
        if skipLate and p.spec <> invalid and not p.spec.done
            ' (still loading)
        else if p.upcoming
            addUpcomingRow(root, p.list, p.preset)
        else if Util.flag(p, "myMedia")
            addMyMediaRow(root, p.list)
        else
            before = root.getChildCount()
            addRow(root, p.title, p.list, p.landscape, p.preset)
            if Util.flag(p, "libRow") and root.getChildCount() > before then m.libRowsShown = m.libRowsShown + 1
            if Util.toText(p.sectionKind) <> "" then Log.line("Cove: home section " + Util.toText(p.sectionKind) + " " + Util.toText(p.list.count()) + " titles " + Util.toText(Util.toNumber(p.ms)) + " ms")
        end if
    end for
    if not skipLate then m.pendingRows = []
end sub

' "New in Movies", "Top Rated in Movies", ...
function rowTitle(style as string, name as string) as string
    if style = "top" then return "Top Rated in " + name
    if style = "random" then return "Picks from " + name
    if style = "az" then return name + " A-Z"
    return "New in " + name
end function

' A library's Home row: Latest (what the server added last), Top Rated, Random or A-Z
function libraryRow(uid as string, l as object, style as string, f as string, unw as string) as object
    if style = "latest" and HomeLayout.usesLatestRoute(l.collectionType)
        return getList("/Users/" + uid + "/Items/Latest?ParentId=" + l.id + "&Limit=20" + unw + "&" + f, "/Items/Latest?userId=" + uid + "&ParentId=" + l.id + "&Limit=20" + unw + "&" + f)
    end if
    ' (v1.5: music, books, box sets, unknown kinds too: their items newest first for Latest)
    q = HomeLayout.libraryItemsQuery(l.id, Items.homeTypesFor(l.collectionType), style) + "&" + f
    if style = "latest" then q = q + unw
    return getList("/Users/" + uid + "/Items?" + q, "/Items?userId=" + uid + "&" + q)
end function

' The web app's Home sections (GET /DisplayPreferences/usersettings?client=emby), or invalid
function displayPrefs(uid as string) as dynamic
    Log.line("Cove: GET /DisplayPreferences/usersettings")
    r = Api.execute({ method: "GET", url: Util.toText(m.srv.url) + "/DisplayPreferences/usersettings?userId=" + uid + "&client=emby", headers: m.h, timeout: 15000 })
    Log.line("Cove:   -> " + Util.toText(r.code))
    if r.code <> 200 or not Util.isAA(r.json) then return invalid
    return r.json
end function

' One GET with its timing line ("Cove: http GET /Users/x/Items/Resume 200 143")
function timedGet(path as string, timeoutMs = 20000 as integer) as object
    stopwatch = createObject("roTimespan")
    r = Api.execute({ method: "GET", url: Util.toText(m.srv.url) + path, headers: m.h, timeout: timeoutMs })
    Log.line("Cove: " + Util.redact(Api.timingLine("GET", path, r.code, stopwatch.totalMilliseconds())))
    return r
end function

' (v1.2) The request for a list (an array, or { Items: [...] }), sent later with the others (fetchQueued):
' the profile's rating limit applied, and straight to the newer Jellyfin route where only that one answered
function getList(rawPath as string, rawFallback as string, authOn403 = false as boolean) as object
    sp = { path: Ratings.withLimit(m.srv, rawPath), fallback: Ratings.withLimit(m.srv, rawFallback), rawFallback: rawFallback, kind: "home:" + Api.routeKind(rawPath), usedNew: false, authOn403: authOn403, done: false }
    if sp.fallback <> "" and Api.knownRoute(m.srv, sp.kind) = "new"
        sp.path = sp.fallback
        sp.fallback = ""
        sp.usedNew = true
    end if
    return sp
end function

' GET one list now (the libraries, which the rows depend on); on 404 try the newer Jellyfin route
function fetchList(rawPath as string, rawFallback as string, authOn403 = false as boolean) as object
    sp = getList(rawPath, rawFallback, authOn403)
    r = timedGet(sp.path)
    if r.code = 404 and sp.fallback <> ""
        sp.path = sp.fallback
        sp.usedNew = true
        r = timedGet(sp.path)
    end if
    return readList(r, sp)
end function

' One answer read as a list of objects: route memory, 401 (403 too for the libraries) asks for the sign-in
function readList(r as object, sp as object) as object
    if r.code = 200 and sp.rawFallback <> "" then Api.rememberRoute(m.srv, sp.kind, sp.usedNew)
    if r.code = 401 or (r.code = 403 and sp.authOn403)
        m.top.authFailed = true
        return []
    end if
    if r.code <> 200 or r.json = invalid
        m.failures = m.failures + 1
        Log.line("Cove: home list failed " + Util.toText(sp.path.split("?")[0]) + " -> " + Util.toText(r.code) + " " + Util.redact(Util.toText(r.error)))
        return []
    end if
    list = Util.field(r.json, "Items")
    if type(r.json) = "roArray" then list = r.json
    if type(list) <> "roArray" then return []
    ' (only objects: a wrong type in the list would stop the whole home at the first field read)
    kept = []
    for each it in list
        if Util.isAA(it) then kept.push(it)
    end for
    return kept
end function

sub addRow(root as object, title as string, list as object, isLandscape as boolean, preset = invalid as dynamic)
    ' (titles above the profile's rating limit, from routes that ignore MaxOfficialRating; unrated episodes
    ' by their series' rating)
    list = Ratings.keepChecked(m.srv, list)
    if list.count() = 0 then return
    row = root.createChild("ContentNode")
    row.title = title
    row.addFields({ landscape: isLandscape })
    for each it in list
        row.appendChild(Items.node(m.srv, it, isLandscape))
    end for
    addSeeAll(row, preset)
end sub

' (v1.5) My Media, as on Emby: one 16:9 tile per library (its own Primary picture, the name under it); the
' libraries carry no rating, so the profile's limit doesn't apply. No library switched on: no row.
sub addMyMediaRow(root as object, views as object)
    if views.count() = 0 then return
    row = root.createChild("ContentNode")
    row.title = "My Media"
    row.addFields({ landscape: false, myMedia: true })
    for each v in views
        ' (the picture at twice the 360 px tile)
        row.appendChild(Items.libraryTileNode(m.srv, v, Util.toText(v.Name), 720))
    end for
end sub

' (v1.1) Upcoming: 16:9 cards with the air date first ("Tomorrow  ·  S2:E5  ·  Name"). One that hasn't aired
' and has no file yet (BG-6: QuickPlay.isUnaired) carries upcoming = true and its series, so OK opens the series
' page and * has no Play; the server also lists yesterday's and today's episodes, and those play as usual.
' (BG-3) The dates are in the Roku's own time zone.
sub addUpcomingRow(root as object, list as object, preset = invalid as dynamic)
    list = Ratings.keepChecked(m.srv, list)
    if list.count() = 0 then return
    today = Dates.localToday()
    monthFirst = Dates.usesMonthFirst()
    tz = Dates.localOffsetSecs()
    nowIso = QuickPlay.nowStamp()
    row = root.createChild("ContentNode")
    row.title = "Upcoming"
    row.addFields({ landscape: true })
    for each it in list
        c = Items.node(m.srv, it, true)
        air = Dates.airLabel(it.PremiereDate, today, monthFirst, tz)
        if air = "" then air = "Coming soon"
        c.addFields({ upcoming: QuickPlay.isUnaired(it, nowIso), seriesId: Util.toText(it.SeriesId), airLabel: air })
        if c.episode <> ""
            c.episode = air + "  ·  " + c.episode
        else
            c.episode = air
        end if
        c.progress = 0.0
        c.timeLeft = ""
        c.resumeAt = 0.0
        row.appendChild(c)
    end for
    addSeeAll(row, preset)
end sub

' (v1.2) The rows that answered late (Upcoming), built and put at their place among the rows already shown
' (the place: after the rows of the queue entries before it that made a row; rows are matched by title)
sub insertLateRows(shown as object)
    titles = {}
    for i = 0 to shown.getChildCount() - 1
        titles[shown.getChild(i).title] = true
    end for
    at = 0
    firstAt = -1
    added = 0
    for each p in m.pendingRows
        if p.spec <> invalid and p.spec.done and p.upcoming and not titles.doesExist(p.title)
            one = createObject("roSGNode", "ContentNode")
            addUpcomingRow(one, p.list, p.preset)
            if one.getChildCount() > 0
                ' (v1.7.1 NV6-1) a row queued after Because You Watched goes after the Because rows Home carried
                ' over from the last load
                if m.because <> invalid and not m.because.before.doesExist(p.title)
                    while at < shown.getChildCount() and isBecauseRow(shown.getChild(at))
                        at = at + 1
                    end while
                end if
                row = one.getChild(0)
                one.removeChild(row)
                shown.insertChild(row, at)
                if firstAt < 0 then firstAt = at
                added = added + 1
                at = at + 1
            end if
        else if titles.doesExist(p.title)
            at = at + 1
            ' (the carried-over Because rows right after it count too)
            while at < shown.getChildCount() and isBecauseRow(shown.getChild(at)) and m.because <> invalid and m.because.before.doesExist(p.title)
                at = at + 1
            end while
        end if
    end for
    ' (v1.7.1 NV6-1) Home keeps the focused row when Upcoming goes in above it
    if firstAt < 0 then firstAt = 0
    m.top.lateRows = { at: firstAt, n: added, removed: 0 }
end sub

sub dropBecauseRows()
    shown = m.top.content
    if shown = invalid then return
    at = -1
    gone = 0
    for k = shown.getChildCount() - 1 to 0 step -1
        if isBecauseRow(shown.getChild(k))
            shown.removeChildIndex(k)
            at = k
            gone = gone + 1
        end if
    end for
    if gone = 0 then return
    Log.line("Cove: home because rows dropped (" + Util.toText(gone) + ")")
    m.top.lateRows = { at: at, n: 0, removed: gone }
    m.top.rowsAdded = m.top.rowsAdded + 1
end sub

function isBecauseRow(row as dynamic) as boolean
    return row <> invalid and row.hasField("because") and row.because = true
end function

' ---------------------------------------------------------------- v1.6 HOME

' (v1.6 H-1) GET /Users/{id}/HomeSections (Emby 4.10+) mapped to Cove rows (HomeLayout.fromSections), or
' invalid (404, an error, nothing usable): the caller falls back to the legacy CustomPrefs
function homeSections(uid as string, libs as object) as dynamic
    r = timedGet("/Users/" + uid + "/HomeSections", 10000)
    if r.code <> 200
        Log.line("Cove: home sections -> " + Util.toText(r.code) + ", using the legacy Home layout")
        return invalid
    end if
    json = r.json
    if json = invalid then json = r.value
    out = HomeLayout.fromSections(json, libs)
    if out = invalid
        Log.line("Cove: home sections: none usable, using the legacy Home layout")
        return invalid
    end if
    for each k in out.skipped
        Log.line("Cove: home section " + Util.toText(k) + " skipped")
    end for
    Log.line("Cove: home sections " + Util.toText(out.ids.count()) + " rows, spotlight " + Util.toText(out.spotlight <> ""))
    return out
end function

' (v1.6 H-1) The Spotlight section's titles as the banner (films and shows with a backdrop, at most 8); nothing
' found or a failed request: heroItems stays empty and Home keeps the rows' titles
sub loadSpotlight()
    stopwatch = createObject("roTimespan")
    path = "/Users/" + Util.toText(m.srv.userId) + "/Sections/" + m.spotlightId + "/Items?Limit=24&Fields=Overview,ProductionYear,OfficialRating,CommunityRating,Genres&ImageTypeLimit=1&EnableImageTypes=Primary,Backdrop,Thumb,Logo&EnableUserData=true"
    r = Api.execute({ method: "GET", url: Util.toText(m.srv.url) + Ratings.withLimit(m.srv, path), headers: m.h, timeout: 8000 })
    Log.line("Cove: " + Util.redact(Api.timingLine("GET", path, r.code, stopwatch.totalMilliseconds())))
    out = createObject("roSGNode", "ContentNode")
    if r.code = 200
        list = Ratings.keepChecked(m.srv, HomeLayout.sectionList(r.json))
        for each it in HomeBanner.pickTitles(list)
            out.appendChild(Items.node(m.srv, it, true))
        end for
    end if
    Log.line("Cove: home banner spotlight " + Util.toText(out.getChildCount()) + " titles " + Util.toText(stopwatch.totalMilliseconds()) + " ms")
    m.top.heroItems = out
end sub

' (v1.6 M-2) The row's last card: "See All" in the row's card shape; OK opens the row's whole list (SeeAllScreen).
' It carries every field of Items.node, so code reading a focused card never meets a missing field.
sub addSeeAll(row as object, preset as dynamic)
    if not Util.isAA(preset) or row.getChildCount() = 0 then return
    c = createObject("roSGNode", "ContentNode")
    c.addFields({ itemId: "", itemType: "SeeAll", collectionType: "", meta: "", heroMeta: "", chip: "", overview: "", backdrop: "", logo: "", progress: 0.0, landscape: row.landscape, favorite: false, played: false, unplayed: 0, timeLeft: "", resumeAt: 0.0, episode: "" })
    preset.title = Util.toText(row.title)
    preset.landscape = row.landscape
    c.addFields({ kind: "seeall", seeAll: preset })
    c.title = "See All"
    c.shortDescriptionLine1 = "See All"
    row.appendChild(c)
end sub

' ---------------------------------------------------------------- v1.7 NAV

' (M-6) Because You Watched: 1-3 rows (Settings → Home) from GET /Movies/Recommendations (its Similar To
' Recently Played categories), filled up from /Items/{id}/Similar of the last titles watched to the end (an
' episode stands for its series), so shows get rows too. The profile's rating limit applies; rows without a
' title left are not shown; no See All card (v1.6 See All has no query for these lists). The rows go into the
' content already on screen (late-row insert), after the rows queued before "because".
sub loadBecause()
    stopwatch = createObject("roTimespan")
    want = HomeLayout.becauseRows()
    uid = Util.toText(m.srv.userId)
    f = Items.fields()
    pq = HomeLayout.playedQuery()
    m.pendingRows = []
    ' (v1.7.1 NV6-13) a reload with the Because rows carried over: only the played list first; the rows stay
    ' as they are while they are fresh and the last title watched is the same
    age = m.top.becauseAge
    if age >= 0 and age < 600
        queueRow("played", getList("/Users/" + uid + "/Items?" + pq, "/Items?userId=" + uid + "&" + pq), true)
        fetchQueued(true)
        if m.top.authFailed then return
        played = m.pendingRows[0].list
        if HomeLayout.becauseStillFresh(age, firstIdOf(played), Util.toText(m.top.becausePlayedId))
            Log.line("Cove: home because kept (" + Util.toText(age) + " s old, same last watched) " + Util.toText(stopwatch.totalMilliseconds()) + " ms")
            m.pendingRows = []
            return
        end if
        m.pendingRows = []
        queueRow("rec", getList(HomeLayout.recommendationsPath(uid, f), ""), true)
        fetchQueued(true)
        if m.top.authFailed then return
        recList = m.pendingRows[0].list
    else
        queueRow("rec", getList(HomeLayout.recommendationsPath(uid, f), ""), true)
        queueRow("played", getList("/Users/" + uid + "/Items?" + pq, "/Items?userId=" + uid + "&" + pq), true)
        fetchQueued(true)
        if m.top.authFailed then return
        recList = m.pendingRows[0].list
        played = m.pendingRows[1].list
    end if
    rows = HomeLayout.becauseFromRecommendations(recList, want)
    fromRec = rows.count()
    used = {}
    for each r in rows
        used[LCase(r.name)] = true
    end for
    ' (fewer Because categories than rows asked for: Similar of the last titles watched)
    if rows.count() < want
        bases = HomeLayout.becauseBaselines(played, used, want - rows.count())
        m.pendingRows = []
        for each b in bases
            queueRow(b.name, getList(HomeLayout.similarPath(b.id, uid, f), ""), true)
        end for
        if bases.count() > 0 then fetchQueued(true)
        if m.top.authFailed then return
        for each p in m.pendingRows
            rows.push({ name: p.title, baseId: "", items: p.list })
        end for
    end if
    m.pendingRows = []
    if Ratings.limitOf(m.srv) > 0
        everything = []
        for each r in rows
            everything.append(r.items)
        end for
        Ratings.prefetchSeries(m.srv, everything)
    end if
    one = createObject("roSGNode", "ContentNode")
    for each r in rows
        if one.getChildCount() < want
            had = one.getChildCount()
            addRow(one, HomeLayout.becauseTitle(r.name), r.items, false, invalid)
            ' (v1.7.1 NV6-1) marked, so a reload can carry the row over and this task find it again
            if one.getChildCount() > had then one.getChild(had).addFields({ because: true })
        end if
    end for
    n = one.getChildCount()
    Log.line("Cove: home because " + Util.toText(n) + " rows (" + Util.toText(fromRec) + " from recommendations, " + Util.toText(rows.count() - fromRec) + " from similar) " + Util.toText(stopwatch.totalMilliseconds()) + " ms")
    shown = m.top.content
    if shown = invalid then return
    ' (v1.7.1 NV6-1) the Because rows Home carried over from the last load
    kept = []
    for i = 0 to shown.getChildCount() - 1
        c = shown.getChild(i)
        if c.hasField("because") and c.because = true then kept.push(i)
    end for
    if n = 0 and kept.count() = 0 then return
    playedId = firstIdOf(played)
    if kept.count() = n
        ' the same number of rows: refreshed in place (no row moves, the focus stays)
        for i = 0 to n - 1
            src = one.getChild(i)
            dst = shown.getChild(kept[i])
            dst.title = src.title
            cards = src.getChildren(-1, 0)
            src.removeChildrenIndex(src.getChildCount(), 0)
            dst.removeChildrenIndex(dst.getChildCount(), 0)
            dst.appendChildren(cards)
        end for
        Log.line("Cove: home because rows refreshed in place (" + Util.toText(n) + ")")
        m.top.lateRows = { at: kept[0], n: n, removed: n, because: true, playedId: playedId }
        m.top.rowsAdded = m.top.rowsAdded + 1
        return
    end if
    at = -1
    for k = kept.count() - 1 to 0 step -1
        shown.removeChildIndex(kept[k])
        at = kept[k]
    end for
    if at < 0
        titles = []
        for i = 0 to shown.getChildCount() - 1
            titles.push(shown.getChild(i).title)
        end for
        at = HomeLayout.lateRowIndex(titles, m.because.before)
    end if
    for i = 0 to n - 1
        row = one.getChild(0)
        one.removeChild(row)
        shown.insertChild(row, at + i)
    end for
    m.top.lateRows = { at: at, n: n, removed: kept.count(), because: true, playedId: playedId }
    m.top.rowsAdded = m.top.rowsAdded + 1
end sub

' (v1.7.1 NV6-13) The id of the first title of a list ("" when none)
function firstIdOf(list as dynamic) as string
    if type(list) <> "roArray" or list.count() = 0 or not Util.isAA(list[0]) then return ""
    return Util.toText(list[0].Id)
end function
