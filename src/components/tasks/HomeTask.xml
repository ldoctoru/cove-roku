<?xml version="1.0" encoding="utf-8" ?>
<!-- Loads the home rows for "server": the rows of Settings → Home → Rows in their order
     (Continue Watching, Next Up, Favourites, Recently Added, each library's row, libraries) or the server's layout.
     "content" = RowList content (one child per row, row title = its title); "error" if nothing could be loaded. -->
<component name="HomeTask" extends="Task">
    <script type="text/brightscript" uri="HomeTask.bs" />
    <interface>
        <field id="server" type="assocarray" />
        <field id="content" type="node" />
        <!-- [{ id, title, itemType, collectionType }] for the top navigation -->
        <field id="libraries" type="array" />
        <field id="error" type="string" />
        <field id="authFailed" type="boolean" />
        <!-- (v1.1.1) print "home first rows / all rows <ms since launch>" (the first Home load only) -->
        <field id="timing" type="boolean" />
        <!-- (v1.2) content without the rows still loading (Upcoming); the full content follows -->
        <field id="partial" type="boolean" />
        <!-- (v1.2) a late row (Upcoming) was put into the content already shown: Home re-sizes its rows -->
        <field id="rowsAdded" type="integer" value="0" />
        <!-- (v1.3.2) Settings → Home → Banner shows: "newest" / "random" / "favorites" fetch the banner's own titles
             after the rows ("rows" or "": none); heroItems = their cards (no children = keep the rows' titles) -->
        <field id="bannerSource" type="string" />
        <field id="heroItems" type="node" />
        <!-- (v1.3.2) Refresh banner: only the banner's list (libraries given in "libraries"), the ids on screen -->
        <field id="bannerOnly" type="boolean" />
        <field id="bannerPrevious" type="array" />
    </interface>
</component>
