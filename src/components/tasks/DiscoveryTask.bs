import "pkg:/source/Util.bs"
import "pkg:/source/Servers.bs"
import "pkg:/source/Log.bs"

sub init()
    m.top.functionName = "work"
end sub

sub work()
    found = []
    try
        found = broadcastAndListen(m.top.seconds)
    catch e
        Log.line("Cove: discovery failed: " + Util.toText(e.message))
    end try
    Log.line("Cove: discovery -> " + Util.toText(found.count()) + " server(s)")
    m.top.servers = found
    ' (v1.7.1 NV6-2) the batched log lines left
    Log.flush()
end sub

function broadcastAndListen(seconds as integer) as object
    out = []
    port = createObject("roMessagePort")
    sock = createObject("roDatagramSocket")
    if sock = invalid then return out
    sock.setMessagePort(port)
    target = createObject("roSocketAddress")
    target.setHostName("255.255.255.255")
    target.setPort(7359)
    sock.setBroadcast(true)
    sock.setSendToAddress(target)
    sock.notifyReadable(true)
    sock.sendStr("Who is JellyfinServer?")
    sock.sendStr("who is EmbyServer?")
    seen = {}
    clock = createObject("roTimespan")
    limitMs = seconds * 1000
    while clock.TotalMilliseconds() < limitMs and out.count() < 10
        waitMs = limitMs - clock.TotalMilliseconds()
        if waitMs < 1 then waitMs = 1
        msg = wait(waitMs, port)
        if type(msg) = "roSocketEvent" and msg.getSocketID() = sock.getID()
            ' (C2-9: two answers that arrive together come as one event: read every waiting one)
            while sock.isReadable() and out.count() < 10
                answer = sock.receiveStr(4096)
                srv = Servers.parseDiscovery(answer)
                if srv <> invalid and not seen.doesExist(srv.id)
                    seen[srv.id] = true
                    out.push(srv)
                    Log.line("Cove: discovered " + Util.toText(srv.name) + " at " + Util.toText(srv.address))
                end if
            end while
        end if
    end while
    sock.close()
    return out
end function
