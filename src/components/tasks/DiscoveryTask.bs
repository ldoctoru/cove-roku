import "pkg:/source/Util.bs"

sub init()
    m.top.functionName = "work"
end sub

sub work()
    found = []
    try
        found = broadcastAndListen(m.top.seconds)
    catch e
        print "Cove: discovery failed: "; Util.toText(e.message)
    end try
    print "Cove: discovery -> "; found.count(); " server(s)"
    m.top.servers = found
end sub

function broadcastAndListen(seconds as integer) as object
    out = []
    port = createObject("roMessagePort")
    sock = createObject("roDatagramSocket")
    if sock = invalid then return out
    sock.setMessagePort(port)
    target = createObject("roSocketAddress")
    target.setHostName("255.255.255.255")
    target.setPort(7359)
    sock.setBroadcast(true)
    sock.setSendToAddress(target)
    sock.notifyReadable(true)
    sock.sendStr("Who is JellyfinServer?")
    sock.sendStr("who is EmbyServer?")
    seen = {}
    clock = createObject("roTimespan")
    limitMs = seconds * 1000
    while clock.TotalMilliseconds() < limitMs and out.count() < 10
        waitMs = limitMs - clock.TotalMilliseconds()
        if waitMs < 1 then waitMs = 1
        msg = wait(waitMs, port)
        if type(msg) = "roSocketEvent" and msg.getSocketID() = sock.getID() and sock.isReadable()
            answer = sock.receiveStr(4096)
            srv = parseAnswer(answer)
            if srv <> invalid and not seen.doesExist(srv.id)
                seen[srv.id] = true
                out.push(srv)
                print "Cove: discovered "; srv.name; " at "; srv.address
            end if
        end if
    end while
    sock.close()
    return out
end function

' { Address: "http://192.168.1.20:8096", Id, Name } → { id, name, address } or invalid. Any device on the
' network can answer, so only a plain http(s)://host[:port] address with safe characters is kept.
function parseAnswer(text as dynamic) as dynamic
    if type(text) <> "roString" and type(text) <> "String" then return invalid
    j = ParseJson(text)
    if not Util.isAA(j) then return invalid
    addr = Util.toText(j.Address).trim()
    id = Util.toText(j.Id)
    if addr = "" or id = "" or not Util.isSafeId(id, false) then return invalid
    while addr.len() > 0 and addr.right(1) = "/"
        addr = addr.left(addr.len() - 1)
    end while
    low = LCase(addr)
    if not (low.startsWith("http://") or low.startsWith("https://")) then return invalid
    rx = createObject("roRegex", "^https?://[A-Za-z0-9.\-\[\]:]+$", "")
    if not rx.isMatch(addr) then return invalid
    name = Util.toText(j.Name)
    if name.len() > 40 then name = name.left(40)
    if name = "" then name = Util.hostOf(addr)
    return { id: id, name: name, address: addr }
end function
