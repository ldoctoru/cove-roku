import "pkg:/source/Api.bs"
import "pkg:/source/Playback.bs"
import "pkg:/source/Tracks.bs"
import "pkg:/source/Log.bs"

sub init()
    m.top.functionName = "work"
end sub

sub work()
    try
        srv = m.top.server
        caps = DeviceCaps.get()
        opts = m.top.options
        if opts = invalid or opts.audio = invalid then opts = Playback.options(srv)
        url = Util.toText(srv.url) + "/Items/" + m.top.itemId + "/PlaybackInfo?" + Playback.infoQuery(srv, m.top.forceTranscode, opts)
        r = Api.execute({ method: "POST", url: url, headers: Api.headers(srv, true), body: Playback.infoBody(caps, opts, Servers.isJellyfin(srv)), timeout: 30000 })
        Log.line("Cove: PlaybackInfo -> " + Util.toText(r.code))
        if r.code <> 200
            m.top.error = "The server couldn't prepare this video. " + Api.describeFailure(r)
            return
        end if
        force = m.top.forceTranscode
        ' (PL-11: the quality cap is below the file's bitrate: the server encodes, as for a conversion)
        if not force and Tracks.capForcesEncode(r.json, Util.toText(opts.sourceId), opts.maxBitrate)
            Log.line("Cove: quality cap below the file's bitrate, converting")
            force = true
        end if
        s = Playback.streamFrom(srv, m.top.itemId, r.json, force, opts)
        if s = invalid
            m.top.error = "The server offered no way to play this video on this Roku."
            return
        end if
        Log.line("Cove: play " + Util.toText(s.method) + " (" + Util.toText(s.streamFormat) + ", source video " + Util.toText(s.sourceVideoCodec) + ")")
        m.top.stream = s
    catch e
        Log.line("Cove: PlayTask failed: " + Util.redact(Util.toText(e.message)))
        m.top.error = "Couldn't start playback: " + Util.redact(Util.toText(e.message))
    end try
end sub
