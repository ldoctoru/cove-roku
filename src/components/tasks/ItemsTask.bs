import "pkg:/source/Api.bs"
import "pkg:/source/Items.bs"
import "pkg:/source/Ratings.bs"
import "pkg:/source/Log.bs"

sub init()
    m.top.functionName = "work"
end sub

sub work()
    try
        srv = m.top.server
        h = Api.headers(srv, true)
        spent = createObject("roTimespan")
        ' (the profile's rating limit, v0.9.0: asked of the server, and checked again below)
        r = Api.execute({ method: "GET", url: Util.toText(srv.url) + Ratings.withLimit(srv, m.top.path), headers: h, timeout: 20000 })
        if r.code = 404 and m.top.fallback <> "" then r = Api.execute({ method: "GET", url: Util.toText(srv.url) + Ratings.withLimit(srv, m.top.fallback), headers: h, timeout: 20000 })
        ' (v1.1.1: the time per request, so a device test gives real numbers)
        Log.line("Cove: items " + Util.toText(m.top.path.split("?")[0]) + " -> " + Util.toText(r.code) + " (" + Util.toText(spent.TotalMilliseconds()) + " ms)")
        if r.code <> 200 or r.json = invalid
            m.top.error = "Couldn't load the list. " + Api.describeFailure(r)
            return
        end if
        list = r.json
        total = 0
        if GetInterface(list, "ifAssociativeArray") <> invalid
            total = Util.toNumber(r.json.TotalRecordCount)
            list = r.json.Items
        end if
        if type(list) <> "roArray" then list = []
        ' (only objects: a wrong type in the list would stop at the first field read)
        ' (served: what the server sent, before the rating filter; the caller pages from it, R-3)
        served = list.count()
        kept = []
        ' (v0.9.1: the series ratings of unrated episodes, one request)
        if m.top.kind <> "person" then Ratings.prefetchSeries(srv, list)
        for each it in list
            if Util.isAA(it) and (m.top.kind = "person" or Ratings.allowed(srv, it)) then kept.push(it)
        end for
        list = kept
        if total = 0 then total = list.count()
        kind = m.top.kind
        if kind = "names"
            names = []
            for each it in list
                names.push(Util.toText(it.Name))
            end for
            m.top.result = { names: names, total: total, served: served, gen: m.top.gen }
            return
        end if
        holder = createObject("roSGNode", "ContentNode")
        for each it in list
            if kind = "person"
                holder.appendChild(Items.personNode(srv, it))
            else
                holder.appendChild(Items.node(srv, it, kind = "landscape"))
            end if
        end for
        m.top.result = { nodes: holder, total: total, served: served, startIndex: m.top.startIndex, gen: m.top.gen, kind: kind }
    catch e
        Log.line("Cove: ItemsTask failed: " + Util.redact(Util.toText(e.message)))
        m.top.error = "Loading failed: " + Util.toText(e.message)
    end try
end sub
