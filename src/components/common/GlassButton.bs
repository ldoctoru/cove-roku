sub init()
    m.body = m.top.findNode("body")
    m.base = m.top.findNode("base")
    m.label = m.top.findNode("label")
    m.shadowLabel = m.top.findNode("shadowLabel")
    m.iconImg = m.top.findNode("iconImg")
    m.fog = m.top.findNode("fog")
    m.ring = m.top.findNode("ring")
    t = m.global.theme
    m.accent = "0xE60A14FF"
    m.whiteAccent = false
    if t <> invalid
        m.accent = t.accent
        m.whiteAccent = t.accentName = "white"
    end if
    m.w = 0
    m.h = 69
    layout()
end sub

' Places every piece for the current style, text and icon; the width follows the measured label
sub layout()
    style = m.top.style
    h = m.top.height
    if h <= 0 then h = 69
    m.h = h
    isAccent = style = "accent"
    isCircle = style = "circle"
    hasText = m.top.text <> "" and not isCircle
    hasIcon = m.top.icon <> ""
    ts = m.top.textSize
    for each l in [m.label, m.shadowLabel]
        l.font.size = ts
        l.text = m.top.text
        l.visible = hasText
        l.height = h
    end for
    tw = 0
    if hasText then tw = Int(m.label.boundingRect().width) + 2
    isz = m.top.iconSize
    gap = 12
    pad = m.top.padX
    if pad < 0
        pad = Int(h * 0.46)
        if hasIcon then pad = Int(h * 0.4)
    end if
    if isCircle
        w = h
    else
        w = pad * 2 + tw
        if hasIcon and hasText then w = w + isz + gap
        if hasIcon and not hasText then w = pad * 2 + isz
    end if
    if w < m.top.minWidth then w = m.top.minWidth
    m.w = w
    ' content (icon + label) centred in the button
    cw = tw
    if hasIcon and hasText then cw = isz + gap + tw
    if hasIcon and not hasText then cw = isz
    x = Int((w - cw) / 2)
    m.iconImg.visible = hasIcon
    if hasIcon
        m.iconImg.uri = m.top.icon
        m.iconImg.width = isz
        m.iconImg.height = isz
        m.iconImg.translation = [x, Int((h - isz) / 2)]
        m.iconImg.blendColor = m.top.iconColor
        x = x + isz + gap
    end if
    m.label.width = tw + 4
    m.shadowLabel.width = tw + 4
    m.label.translation = [x, 0]
    m.shadowLabel.translation = [x + 1, 3]
    ' backgrounds
    m.base.width = w
    m.base.height = h
    m.fog.width = w
    m.fog.height = h
    small = h < 60
    if isCircle
        m.base.uri = "pkg:/images/ui/g3_circle_69.png"
        m.fog.uri = "pkg:/images/ui/fog_circle_69.png"
        m.ring.uri = "pkg:/images/ui/focus_ring_circle_85.png"
        rg = Int(h * 8 / 69 + 0.5)
        m.ring.translation = [-rg, -rg]
        m.ring.width = h + 2 * rg
        m.ring.height = h + 2 * rg
    else
        if isAccent
            m.base.uri = "pkg:/images/ui/g3_dark_pill.9.png"
        else if small
            m.base.uri = "pkg:/images/ui/g3_capsule_44.9.png"
        else
            m.base.uri = "pkg:/images/ui/g3_capsule.9.png"
        end if
        m.fog.uri = "pkg:/images/ui/fog_capsule.9.png"
        m.ring.uri = "pkg:/images/ui/focus_ring_pill.9.png"
        if small
            m.fog.uri = "pkg:/images/ui/fog_capsule_44.9.png"
            m.ring.uri = "pkg:/images/ui/focus_ring_pill_60.9.png"
        end if
        m.ring.translation = [-8, -8]
        m.ring.width = w + 16
        m.ring.height = h + 16
    end if
    layoutAccent(isAccent, w, h)
    m.body.scaleRotateCenter = [w / 2, h / 2]
    m.top.buttonWidth = w
    paint()
end sub

' The accent pill's layers: tinted caps and the stretched fade between them, rim, shine and the bottom line
sub layoutAccent(isAccent as boolean, w as integer, h as integer)
    half = Int(h / 2)
    tintOp = 1.0
    if m.whiteAccent then tintOp = 0.45
    for each id in ["tintL", "tintMid", "tintR", "rim", "shine", "baseLine"]
        n = m.top.findNode(id)
        n.visible = isAccent
    end for
    if not isAccent then return
    tl = m.top.findNode("tintL")
    tm = m.top.findNode("tintMid")
    tr = m.top.findNode("tintR")
    tl.width = half
    tl.height = h
    tm.translation = [half, 0]
    tm.width = w - 2 * half
    tm.height = h
    tr.translation = [w - half, 0]
    tr.width = half
    tr.height = h
    for each n in [tl, tm, tr]
        n.blendColor = m.accent
        n.opacity = tintOp
    end for
    rim = m.top.findNode("rim")
    rim.width = w
    rim.height = h
    rim.blendColor = m.accent.left(8) + "CC"
    sh = m.top.findNode("shine")
    sh.width = Int(w * 0.6)
    sh.translation = [Int(w * 0.2), 2]
    bl = m.top.findNode("baseLine")
    bl.width = Int(w * 0.6)
    bl.translation = [Int(w * 0.2), h - 4]
    bl.color = m.accent
end sub

' Focus and dimming only: nothing is rebuilt
sub paint()
    f = m.top.focused
    m.fog.visible = f
    m.ring.visible = f
    s = 1.0
    if f then s = 1.06
    m.body.scale = [s, s]
    m.body.opacity = 1.0
    if m.top.dimmed and not f then m.body.opacity = 0.35
end sub
