<?xml version="1.0" encoding="utf-8" ?>
<!-- A choice panel on the right (audio track, subtitles, quality, player options). Set title, options
     ([{ id, label }]) and selectedId, show it and give it focus; "chosen" = { id } or "cancelled". -->
<component name="Picker" extends="Group">
    <script type="text/brightscript" uri="Picker.bs" />
    <interface>
        <field id="title" type="string" onChange="onTitle" />
        <field id="options" type="array" onChange="onOptions" />
        <field id="selectedId" type="string" />
        <field id="purpose" type="string" />
        <field id="chosen" type="assocarray" alwaysNotify="true" />
        <field id="cancelled" type="boolean" alwaysNotify="true" />
    </interface>
    <children>
        <!-- Glass side panel (Cove player panels): dark rounded panel on the right over a dimmed screen -->
        <Rectangle width="1920" height="1080" color="0x00000066" />
        <Poster uri="pkg:/images/ui/panel_r21.9.png" width="600" height="972" translation="[1272,54]" />
        <Label id="title" width="540" height="50" translation="[1302,86]" color="0xFFFFFFFF">
            <Font role="font" uri="font:BoldSystemFontFile" size="32" />
        </Label>
        <LabelList id="list" focusBitmapUri="pkg:/images/ui/white_rr12.9.png" translation="[1296,160]" itemSize="[552,66]" numRows="12" itemSpacing="[0,6]"
                   color="0xFFFFFFD9" focusedColor="0x000000FF">
            <Font role="font" uri="font:MediumSystemFontFile" size="28" />
            <Font role="focusedFont" uri="font:BoldSystemFontFile" size="28" />
        </LabelList>
    </children>
</component>
