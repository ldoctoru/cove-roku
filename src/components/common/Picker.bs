import "pkg:/source/Util.bs"
import "pkg:/source/Speak.bs"

sub init()
    m.list = m.top.findNode("list")
    m.list.observeField("itemSelected", "onSelected")
    m.top.observeField("focusedChild", "onFocusChanged")
    ' (Audio Guide: Cove says the options itself, without the "> " mark and with the menu's title first)
    m.list.observeField("itemFocused", "onItemFocused")
    m.spokeTitle = false
    Speak.mute([m.list])
end sub

sub onItemFocused()
    i = m.list.itemFocused
    opts = m.top.options
    if not Speak.isOn() or opts = invalid or i < 0 or i >= opts.count() or not m.top.isInFocusChain() then return
    text = Speak.clean(Util.toText(opts[i].label))
    if Util.toText(opts[i].id) = m.top.selectedId then text = text + ", selected"
    text = text + Speak.position(i, opts.count())
    if not m.spokeTitle
        m.spokeTitle = true
        text = Util.toText(m.top.title) + ", menu. " + text
    end if
    Speak.say(text)
end sub

sub onTitle()
    m.top.findNode("title").text = m.top.title
end sub

' The current choice is marked with "> " and focused
sub onOptions()
    c = createObject("roSGNode", "ContentNode")
    focusAt = 0
    for i = 0 to m.top.options.count() - 1
        o = m.top.options[i]
        n = c.createChild("ContentNode")
        if o.id = m.top.selectedId
            n.title = "> " + o.label
            focusAt = i
        else
            n.title = "   " + o.label
        end if
    end for
    m.list.content = c
    m.list.jumpToItem = focusAt
end sub

sub onSelected()
    i = m.list.itemSelected
    if i >= 0 and i < m.top.options.count() then m.top.chosen = { id: m.top.options[i].id, purpose: m.top.purpose }
end sub

sub onFocusChanged()
    if m.top.hasFocus()
        m.list.setFocus(true)
        onItemFocused()
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if key = "back" or key = "left" or key = "options"
        m.top.cancelled = true
        return true
    end if
    return true
end function
