import "pkg:/source/Util.bs"
import "pkg:/source/Items.bs"
import "pkg:/source/Speak.bs"

sub init()
    m.keyboard = m.top.findNode("keyboard")
    m.grid = m.top.findNode("grid")
    m.status = m.top.findNode("status")
    m.debounce = m.top.findNode("debounce")
    m.keyboard.observeField("text", "onText")
    m.debounce.observeField("fire", "search")
    m.grid.observeField("rowItemSelected", "onSelected")
    m.found = {}
    m.taskList = []
    m.waiting = 0
    m.top.observeField("focusedChild", "onFocusChanged")
    m.gen = 0
    m.task = invalid
    m.failed = 0
    m.lastError = ""
    m.inGrid = false        ' the results had the focus (Back from a result returns there)
    ' Audio Guide: Roku says the keyboard keys; Cove says the result cards and the result count
    m.speakRow = -1
    m.grid.observeField("rowItemFocused", "onResultFocused")
    Speak.mute([m.grid])
end sub

sub onResultFocused()
    Speak.rowCard(m.grid)
end sub

' Search once typing pauses
sub onText()
    m.debounce.control = "stop"
    m.debounce.control = "start"
end sub

sub search()
    term = m.keyboard.text.trim()
    m.gen = m.gen + 1
    if term.len() < 2
        m.grid.content = invalid
        m.status.text = "Type to search your libraries."
        return
    end if
    m.status.text = "Searching for " + chr(34) + term + chr(34) + "..."
    m.found = {}
    m.failed = 0
    m.lastError = ""
    m.waiting = 3
    uid = Util.toText(m.top.server.userId)
    enc = term.encodeUriComponent()
    q = "SearchTerm=" + enc + "&Recursive=true&Limit=40&" + Items.fields()
    runSearch("titles", "", "/Users/" + uid + "/Items?" + q + "&IncludeItemTypes=Movie,Series,Video", "/Items?userId=" + uid + "&" + q + "&IncludeItemTypes=Movie,Series,Video")
    runSearch("episodes", "landscape", "/Users/" + uid + "/Items?" + q + "&IncludeItemTypes=Episode", "/Items?userId=" + uid + "&" + q + "&IncludeItemTypes=Episode")
    runSearch("people", "person", "/Persons?SearchTerm=" + enc + "&UserId=" + uid + "&Limit=24&Recursive=true&Fields=PrimaryImageAspectRatio", "")
end sub

sub runSearch(key as string, kind as string, path as string, fallback as string)
    t = createObject("roSGNode", "ItemsTask")
    t.server = m.top.server
    t.path = path
    t.fallback = fallback
    t.kind = kind
    t.gen = m.gen
    t.addFields({ rowKey: key })
    t.observeField("result", "onResult")
    t.observeField("error", "onError")

    m.taskList.push(t)
    if m.taskList.count() > 9 then m.taskList.shift()
    t.control = "RUN"
end sub

sub onResult(ev as object)
    r = ev.getData()
    if r.gen <> m.gen then return
    m.found[ev.getRoSGNode().rowKey] = r.nodes
    m.waiting = m.waiting - 1
    if m.waiting <= 0 then showResults()
end sub

sub onError(ev as object)
    if ev.getRoSGNode().gen <> m.gen then return
    m.failed = m.failed + 1
    m.lastError = Util.toText(ev.getData())
    m.waiting = m.waiting - 1
    if m.waiting <= 0 then showResults()
end sub

' People first (when the term is a name), then movies & shows, then episodes
sub showResults()
    root = createObject("roSGNode", "ContentNode")
    sizes = []
    heights = []
    total = 0
    order = [{ key: "people", title: "People", size: [170, 296] }, { key: "titles", title: "Movies & Shows", size: [236, 406] }, { key: "episodes", title: "Episodes", size: [380, 240] }]
    for each o in order
        holder = m.found[o.key]
        if holder <> invalid and holder.getChildCount() > 0
            row = root.createChild("ContentNode")
            row.title = o.title
            kids = []
            for i = 0 to holder.getChildCount() - 1
                kids.push(holder.getChild(i))
            end for
            row.appendChildren(kids)
            total = total + kids.count()
            sizes.push(o.size)
            heights.push(o.size[1] + 44)
        end if
    end for
    if total = 0
        m.grid.content = invalid
        m.inGrid = false
        ' (every request failed: say so, "No results" would be wrong)
        if m.failed >= 3
            m.status.text = "Couldn't search. " + m.lastError
            return
        end if
        m.status.text = "No results for " + chr(34) + m.keyboard.text.trim() + chr(34) + "."
        Speak.say("No results", false)
        return
    end if
    m.grid.rowItemSize = sizes
    m.grid.rowHeights = heights
    m.grid.content = root
    m.status.text = total.toStr() + " results   ·   press Right to choose"
    if total = 1 then m.status.text = "1 result   ·   press Right to choose"
    Speak.say(Speak.clean(m.status.text), false)
end sub

sub onSelected()
    s = m.grid.rowItemSelected
    if s = invalid or s.count() < 2 or m.grid.content = invalid then return
    row = m.grid.content.getChild(s[0])
    if row = invalid then return
    it = row.getChild(s[1])
    if it <> invalid then m.top.action = { id: "open", itemId: it.itemId, itemType: it.itemType, collectionType: it.collectionType, title: it.title }
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    hasResults = m.grid.content <> invalid and m.grid.content.getChildCount() > 0
    if key = "right" and m.keyboard.isInFocusChain() and hasResults
        m.inGrid = true
        m.grid.setFocus(true)
        m.speakRow = -1
        Speak.rowCard(m.grid)
        return true
    else if key = "left" and m.grid.isInFocusChain()
        m.inGrid = false
        m.keyboard.setFocus(true)
        return true
    end if
    return false
end function

' Back from a result: the focus goes back to the results, on the card that was opened
sub onFocusChanged()
    if not m.top.hasFocus() then return
    if m.inGrid and m.grid.content <> invalid and m.grid.content.getChildCount() > 0
        m.grid.setFocus(true)
        m.speakRow = -1
        Speak.rowCard(m.grid)
    else
        m.inGrid = false
        m.keyboard.setFocus(true)
    end if
end sub
