<?xml version="1.0" encoding="utf-8" ?>
<!-- Search: keyboard on the left, results (movies, series, episodes) on the right as you type.
     Right / Left move between them. "action" = { id: "open", ... } like the home. -->
<component name="SearchScreen" extends="Group">
    <script type="text/brightscript" uri="SearchScreen.bs" />
    <interface>
        <field id="screenId" type="string" value="search" />
        <field id="server" type="assocarray" />
        <field id="action" type="assocarray" alwaysNotify="true" />
    </interface>
    <children>
        <Poster id="logo" uri="pkg:/images/logo.png" width="64" height="64" translation="[100,48]" />
        <Label text="Search" width="800" height="60" translation="[180,46]" color="0xFFFFFFFF">
            <Font role="font" uri="font:BoldSystemFontFile" size="44" />
        </Label>
        <MiniKeyboard id="keyboard" translation="[90,170]" />
        <Label id="status" width="1080" height="44" translation="[740,170]" color="0xFFFFFF8C" text="Type to search your libraries.">
            <Font role="font" uri="font:MediumSystemFontFile" size="30" />
        </Label>
        <MarkupGrid id="grid" translation="[720,230]" itemComponentName="PosterItem" itemSize="[200,374]"
                    itemSpacing="[24,30]" numColumns="5" numRows="2" vertFocusAnimationStyle="fixedFocusWrap"
                    drawFocusFeedback="false" />
        <Timer id="debounce" duration="0.6" repeat="false" />
    </children>
</component>
