<?xml version="1.0" encoding="utf-8" ?>
<!-- Search: keyboard on the left, results on the right as you type, in rows: People, Movies & Shows,
     Episodes. Right / Left move between them. "action" = { id: "open", ... } like the home. -->
<component name="SearchScreen" extends="Group">
    <script type="text/brightscript" uri="SearchScreen.bs" />
    <interface>
        <field id="screenId" type="string" value="search" />
        <field id="server" type="assocarray" />
        <field id="action" type="assocarray" alwaysNotify="true" />
        <!-- (SC-1) set by MainScene after playback or a change: the search runs again when shown -->
        <field id="stale" type="boolean" value="false" />
    </interface>
    <children>
        <Poster id="logo" uri="pkg:/images/logo.png" width="64" height="64" translation="[100,48]" />
        <Label text="Search" width="800" height="60" translation="[180,46]" color="0xFFFFFFFF">
            <Font role="font" uri="font:BoldSystemFontFile" size="44" />
        </Label>
        <MiniKeyboard id="keyboard" translation="[90,170]" />
        <Label id="status" width="1080" height="44" translation="[720,150]" color="0xFFFFFFCC" text="Type to search your libraries.">
            <Font role="font" uri="font:MediumSystemFontFile" size="30" />
        </Label>
        <RowList id="grid" translation="[702,220]" itemComponentName="PosterItem" numRows="3"
                 itemSize="[1200,420]" rowHeights="[420]" rowItemSize="[[236,406]]" rowItemSpacing="[[0,0]]"
                 itemSpacing="[0,10]" showRowLabel="[true]" rowLabelOffset="[[18,4]]" rowLabelColor="0xFFFFFFFF"
                 focusXOffset="[0]" rowFocusAnimationStyle="floatingFocus" vertFocusAnimationStyle="fixedFocus"
                 drawFocusFeedback="false">
            <Font role="rowLabelFont" uri="font:BoldSystemFontFile" size="30" />
        </RowList>
        <!-- every search request failed: Try Again / Switch Server / Settings (Right from the keyboard) -->
        <ErrorPanel id="errorPanel" translation="[720,300]" width="1100" visible="false" />
        <Timer id="debounce" duration="0.45" repeat="false" />
    </children>
</component>
