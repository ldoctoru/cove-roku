import "pkg:/source/Util.bs"
import "pkg:/source/Servers.bs"
import "pkg:/source/Api.bs"
import "pkg:/source/DeviceCaps.bs"
import "pkg:/source/Theme.bs"
import "pkg:/source/Pins.bs"
import "pkg:/source/Ratings.bs"

sub init()
    ' Colours and theme images for every component (Cove Glass: accent and page colour as chosen in Settings)
    look = Theme.get()
    m.global.addFields({ theme: look })
    m.top.backgroundColor = look.bg.left(8)
    m.top.backgroundURI = ""
    m.top.findNode("background").color = look.bg
    m.screens = m.top.findNode("screens")
    m.stack = []
    m.pending = []              ' running ApiTasks (kept referenced until they answer)
    m.beaconSent = false
    m.inDialog = false
    m.server = invalid          ' the server being added / signed in to
    m.users = []                ' its public users
    m.quickConnect = false      ' Jellyfin Quick Connect enabled on it
    m.qcTask = invalid
    m.pendingUser = ""
    m.keyboardFor = ""
    m.nextAsk = invalid
    m.nextNotice = invalid      ' a PIN message shown once the PIN pad has closed
    m.pinFor = invalid          ' { serverId, userId } whose PIN is being asked
    m.dialogTimer = m.top.findNode("dialogTimer")
    m.dialogTimer.observeField("fire", "onDialogTimer")
    m.removeId = ""
    m.plainServer = invalid     ' a plain http server outside the home network, waiting for "Continue Anyway"
    m.homeStale = false
    m.deviceLine = ""
    try
        m.deviceLine = DeviceCaps.deviceLine(DeviceCaps.get())
    catch e
        print "Cove: device check failed: "; e.message
    end try
    m.pendingLink = invalid
    m.homeReady = false         ' Home is on screen with a signed-in server: deep links can be opened
    ' (v0.9.0: saved sign-ins become profiles, several per server)
    Servers.migrate()
    m.suspendedAt = 0           ' (Instant Resume) when the app went to the background, in seconds
    m.homeLoadedAt = 0          ' when Home last loaded its rows
    ' (Instant Resume: the stop report and the end of a conversion still go out after the app is suspended)
    if m.top.hasField("allowBackgroundTask") then m.top.allowBackgroundTask = true
    start()
end sub

' Signed in before: check the saved sign-in still works, otherwise show the server list
sub start()
    s = Servers.active()
    if s <> invalid and wantsWho(s)
        ' Who's watching? (2 or more profiles on the server, Settings → Servers)
        showWho(s, "", false)
    else if s <> invalid and Util.toText(s.token) <> ""
        validate(s)
    else
        showServers("")
    end if
end sub

' ---------------------------------------------------------------- screens

function newMenu(id as string, title as string, subtitle as string, items as object) as object
    s = createObject("roSGNode", "MenuScreen")
    s.screenId = id
    s.title = title
    s.subtitle = subtitle
    s.items = items
    s.observeField("selected", "onSelected")
    s.observeField("options", "onOptions")
    return s
end function

sub push(s as object)
    if m.stack.count() > 0 then m.stack.peek().visible = false
    m.screens.appendChild(s)
    m.stack.push(s)
    s.setFocus(true)
    ' the server list / sign-in shown before Home is a dialog for Roku's launch timing
    sid = Util.toText(s.screenId)
    if not m.beaconSent and not m.inDialog and (sid = "servers" or sid = "signin" or sid = "address" or sid = "profiles")
        m.inDialog = true
        m.top.signalBeacon("AppDialogInitiate")
    end if
end sub

' Home is on screen: the launch is complete (after the dialog, if one was shown)
sub launchComplete()
    if m.beaconSent then return
    if m.inDialog
        m.inDialog = false
        m.top.signalBeacon("AppDialogComplete")
    end if
    m.beaconSent = true
    m.top.signalBeacon("AppLaunchComplete")
end sub

' Settings → Servers: connect to another server, sign out, or add one
sub onSettingsAction(ev as object)
    a = ev.getData()
    if a.id = "connect"
        m.themeDirty = false
        openServer(Servers.find(Util.toText(a.serverId)))
    else if a.id = "signout"
        m.themeDirty = false
        signOut()
    else if a.id = "switch"
        m.themeDirty = false
        showServers("")
    else if a.id = "profiles"
        showWho(m.server, "", true)
    else if a.id = "profileChanged"
        ' (the rating limit of the profile on Home: the saved record, read again)
        if m.server <> invalid
            fresh = Servers.find(Util.toText(m.server.id))
            if fresh <> invalid then m.server = fresh
        end if
    else if a.id = "addProfile"
        if m.server <> invalid then openSignIn(m.server, "")
    else if a.id = "useProfile"
        m.themeDirty = false
        if m.server <> invalid then chooseProfile(m.server, Util.toText(a.userId))
    else if a.id = "renamed"
        ' the current server was renamed: keep MainScene's copy in step, Home is rebuilt when Settings closes
        if m.server <> invalid and Util.toText(m.server.id) = Util.toText(a.serverId) then m.server.name = Util.toText(a.name)
    end if
end sub

' Accent / background changed in Settings: the scene colour now, the screens below when Settings closes
sub onThemeChanged()
    look = m.global.theme
    m.top.backgroundColor = look.bg.left(8)
    m.top.findNode("background").color = look.bg
    m.themeDirty = true
end sub

sub pop()
    s = m.stack.pop()
    m.screens.removeChild(s)
    ' screens under Settings were drawn with the old colours: start again from a fresh home
    if m.themeDirty = true and m.server <> invalid
        m.themeDirty = false
        showHome(m.server)
        return
    end if
    t = m.stack.peek()
    t.visible = true
    t.setFocus(true)
    ' Continue Watching / Next Up changed while something was played
    if m.homeStale and t.screenId = "home"
        m.homeStale = false
        t.reload = true
        m.homeLoadedAt = nowSecs()
    end if
end sub

' Replace the whole stack with one screen (after signing in, or when starting over)
sub reset(s as object)
    m.screens.removeChildrenIndex(m.screens.getChildCount(), 0)
    m.stack = []
    ' (showHome sets it again; any other start-over screen is before or outside Home)
    m.homeReady = false
    push(s)
end sub

function top() as dynamic
    if m.stack.count() = 0 then return invalid
    return m.stack.peek()
end function

function topIs(id as string) as boolean
    t = top()
    return t <> invalid and t.screenId = id
end function

sub setStatus(id as string, text as string)
    if topIs(id) then top().status = text
end sub

sub showServers(status as string)
    items = []
    for each s in Servers.all()
        who = profileNames(s)
        lbl = Util.toText(s.name) + "   ·   " + who + "   ·   " + Servers.typeName(s)
        if Util.isPlainHttp(Util.toText(s.url)) then lbl = lbl + "   ·   Not encrypted"
        items.push({ id: "srv:" + Util.toText(s.id), label: lbl })
    end for
    items.push({ id: "add", label: "Add a server" })
    sub_ = "Choose a server, or add one."
    if items.count() > 1 then sub_ = "Choose a server  ·  press * on a server to remove it"
    sc = newMenu("servers", "Servers", sub_, items)
    sc.status = status
    reset(sc)
    if status = "" and m.deviceLine <> "" then sc.status = m.deviceLine
end sub

' "Liviu", "Liviu, Ana", "3 profiles" or "not signed in" for the server list
function profileNames(s as object) as string
    names = []
    for each p in Servers.profiles(s)
        if p.signedIn then names.push(p.name)
    end for
    if names.count() = 0 then return "not signed in"
    if names.count() > 2 then return names.count().toStr() + " profiles"
    return Util.join(names, ", ")
end function

sub showHome(server as object)
    Servers.setActive(Util.toText(server.id))
    m.server = server
    h = createObject("roSGNode", "HomeScreen")
    h.observeField("action", "onHomeAction")
    reset(h)
    h.server = server
    m.homeReady = true
    m.homeLoadedAt = nowSecs()
    launchComplete()
    ' a deep link that came before the sign-in finished
    if m.pendingLink <> invalid
        link = m.pendingLink
        m.pendingLink = invalid
        openDeepLink(link)
    end if
end sub

' ---------------------------------------------------------------- deep links

' contentId is the server's item id. movie / episode / shortFormVideo / tvSpecial play from the saved position;
' series / season and anything else open their page. The link waits until Home is on screen: at a cold launch
' the saved sign-in is still being checked, and a player pushed over "Connecting..." left the app stuck there.
sub onDeepLink()
    link = m.top.deepLink
    if link = invalid or Util.toText(link.contentId) = "" then return
    ' (from Roku Search / voice, or from any device on the network via ECP: only plain item ids go into the
    ' request path, anything else is ignored)
    if not Util.isSafeId(link.contentId, false) or not Util.isSafeId(link.mediaType, true)
        print "Cove: ignored a deep link with an invalid contentId / mediaType"
        return
    end if
    if not m.homeReady or m.server = invalid or Util.toText(m.server.token) = ""
        m.pendingLink = link
        return
    end if
    openDeepLink(link)
end sub

sub openDeepLink(link as object)
    stopPlayers()
    request("GET", m.server, "/Users/" + Util.toText(m.server.userId) + "/Items/" + Util.toText(link.contentId), true, "", { kind: "deeplink", mediaType: LCase(Util.toText(link.mediaType)), contentId: Util.toText(link.contentId), linkType: Util.toText(link.mediaType) })
end sub

' A link while a video plays: end that player properly (video, stop report, timers) before the new title,
' otherwise it kept playing and reporting under the new screen
sub stopPlayers()
    stopped = false
    while topIs("player")
        p = m.stack.pop()
        p.unobserveField("done")
        p.stopNow = true
        m.screens.removeChild(p)
        stopped = true
    end while
    if not stopped then return
    markStale()
    t = top()
    if t = invalid then return
    t.visible = true
    t.setFocus(true)
    if t.screenId = "details" then t.refresh = true
end sub

sub onDeepLinkItem(r as object)
    if r.code = 401
        ' the saved sign-in has expired: sign in again, then the link opens from Home
        m.pendingLink = { contentId: r.tag.contentId, mediaType: r.tag.linkType }
        m.server.token = ""
        Servers.upsert(m.server)
        openSignIn(m.server, "Your sign-in has expired. Please sign in again.")
        return
    end if
    if r.code <> 200 or not Util.isAA(r.json)
        showNotice("Not found", "This title isn't on " + Util.toText(m.server.name) + ".")
        return
    end if
    it = r.json
    if not Ratings.allowed(m.server, it)
        showNotice("Not available", "This title is above the rating limit of this profile.")
        return
    end if
    mt = r.tag.mediaType
    t = Util.toText(it.Type)
    playable = mt = "movie" or mt = "episode" or mt = "shortformvideo" or mt = "tvspecial"
    if playable and (t = "Movie" or t = "Episode" or t = "Video")
        title = Util.toText(it.Name)
        sub_ = ""
        if t = "Episode"
            title = Util.toText(it.SeriesName)
            sub_ = "S" + Util.toText(it.ParentIndexNumber) + ":E" + Util.toText(it.IndexNumber) + "  ·  " + Util.toText(it.Name)
        end if
        ' (the saved position, as a bookmark)
        atSec = Util.toNumber(Util.field(it.UserData, "PlaybackPositionTicks")) / 10000000
        if atSec < 30 then atSec = 0.0
        startPlayer({ id: Util.toText(it.Id), title: title, subtitle: sub_, start: atSec })
    else
        openItem({ itemId: Util.toText(it.Id), itemType: t, collectionType: LCase(Util.toText(it.CollectionType)), title: Util.toText(it.Name), seriesId: Util.toText(it.SeriesId), seriesName: Util.toText(it.SeriesName) })
    end if
end sub

sub onHomeAction(ev as object)
    a = ev.getData()
    if a.id = "switch"
        showServers("")
    else if a.id = "signout"
        signOut()
    else if a.id = "expired"
        m.server.token = ""
        Servers.upsert(m.server)
        openSignIn(m.server, "Your sign-in has expired. Please sign in again.")
    else if a.id = "open"
        openItem(a)
    else if a.id = "play"
        playItem = { id: a.itemId, title: a.title, subtitle: Util.toText(a.subtitle), start: a.start }
        ' (library Shuffle: the titles to play after this one)
        if type(a.queue) = "roArray" then playItem.queue = a.queue
        startPlayer(playItem)
    else if a.id = "favorites"
        ' rows by kind (Movies, Shows, Episodes, Collections, People), as the Mac's Favorites page
        fs = createObject("roSGNode", "FavoritesScreen")
        fs.observeField("action", "onHomeAction")
        push(fs)
        fs.server = m.server
    else if a.id = "changed"
        ' (a favourite person on their page: Home and Favorites reload when shown again)
        markStale()
    else if a.id = "recent"
        l = createObject("roSGNode", "LibraryScreen")
        l.server = m.server
        l.observeField("action", "onHomeAction")
        push(l)
        title = "Favorites"
        if a.id = "recent" then title = "Recently Added"
        l.library = { id: "", title: title, itemType: "", collectionType: "", feed: a.id }
    else if a.id = "profile"
        ' the sidebar's profile entry: Who's watching? over Home (Back returns)
        showWho(m.server, "", true)
    else if a.id = "nowplaying"
        s = createObject("roSGNode", "NowPlayingScreen")
        s.server = m.server
        s.observeField("action", "onHomeAction")
        push(s)
    else if a.id = "settings"
        s = createObject("roSGNode", "SettingsScreen")
        s.server = m.server
        s.observeField("themeChanged", "onThemeChanged")
        s.observeField("action", "onSettingsAction")
        push(s)
    else if a.id = "search"
        s = createObject("roSGNode", "SearchScreen")
        s.server = m.server
        s.observeField("action", "onHomeAction")
        push(s)
    end if
end sub

' Movies, episodes, series and videos open their details; whole libraries come in a later update
sub openItem(a as object)
    t = a.itemType
    if t = "Playlist"
        showNotice(a.title, "Playlists come in a later update.")
        return
    end if
    ' A library or folder: its titles as a grid (a collection / BoxSet has its own details page, as on the Mac)
    if t = "CollectionFolder" or t = "UserView" or t = "Folder"
        l = createObject("roSGNode", "LibraryScreen")
        l.server = m.server
        l.observeField("action", "onHomeAction")
        push(l)
        l.library = { id: a.itemId, title: a.title, itemType: t, collectionType: Util.toText(a.collectionType) }
        return
    end if
    ' a season: its series' page on that season (seriesId from the item, when known)
    if t = "Season"
        if Util.toText(a.seriesId) = ""
            ' (lists don't carry the series: ask the server, then come back here)
            request("GET", m.server, "/Users/" + Util.toText(m.server.userId) + "/Items/" + Util.toText(a.itemId), true, "", { kind: "seasonOpen" })
            return
        end if
        a = { itemId: a.seriesId, itemType: "Series", title: Util.toText(a.seriesName), seasonId: a.itemId }
        t = "Series"
    end if
    ' an actor / director: their page
    if t = "Person"
        ps = createObject("roSGNode", "PersonScreen")
        ps.server = m.server
        ps.observeField("action", "onHomeAction")
        push(ps)
        ps.person = { id: a.itemId, name: a.title }
        return
    end if
    d = createObject("roSGNode", "DetailsScreen")
    d.server = m.server
    d.observeField("play", "onPlay")
    d.observeField("changed", "onDetailsChanged")
    d.observeField("openItem", "onDetailsOpen")
    push(d)
    if a.seasonId <> invalid then d.seasonId = a.seasonId
    d.itemId = a.itemId
end sub

' More Like This: open that title on top
sub onDetailsOpen(ev as object)
    openItem(ev.getData())
end sub

' A favourite changed: the home rows reload when we get back there
sub onDetailsChanged()
    markStale()
end sub

' Something was played or changed on Details: Home and the library pages under it (Favorites, Recently Added,
' a library with its progress bars and watched checks) reload when they are shown again
sub markStale()
    m.homeStale = true
    for each s in m.stack
        if s.screenId = "library" or s.screenId = "favorites" then s.stale = true
    end for
end sub

sub onPlay(ev as object)
    startPlayer(ev.getData())
end sub

sub startPlayer(item as object)
    p = createObject("roSGNode", "PlayerScreen")
    p.server = m.server
    p.observeField("done", "onPlayerDone")
    push(p)
    p.item = item
end sub

' Back from the player: refresh the details (new resume point) and, later, the home rows
sub onPlayerDone(ev as object)
    ' (before pop: a Home or library page right under the player reloads as it is shown)
    markStale()
    seriesId = Util.toText(ev.getRoSGNode().openSeries)
    pop()
    t = top()
    if t <> invalid and t.screenId = "details" then t.refresh = true
    ' "Back to the series" (Are you still watching?): its page, unless it is the one under the player
    if seriesId <> "" and not (t <> invalid and t.screenId = "details" and Util.toText(t.itemId) = seriesId) then openItem({ itemId: seriesId, itemType: "Series", title: "" })
end sub

sub showNotice(title as string, text as string)
    d = createObject("roSGNode", "StandardMessageDialog")
    d.title = title
    d.message = [text]
    d.buttons = ["OK"]
    d.observeField("buttonSelected", "onNoticeButton")
    d.observeField("wasClosed", "onDialogClosed")
    m.top.dialog = d
end sub

sub onNoticeButton()
    closeDialog()
end sub

' ---------------------------------------------------------------- user actions

sub onSelected(ev as object)
    s = ev.getRoSGNode()
    id = ev.getData().id
    if s.screenId = "servers"
        if id = "add"
            askText("address", "Add a server", "The server's address, e.g. 192.168.1.20:8096 or https://emby.example.com", "", false)
        else
            openServer(Servers.find(id.mid(4)))
        end if
    else if s.screenId = "signin"
        if id = "manual"
            askText("username", "Username", "Your username on " + Util.toText(m.server.name), "", false)
        else if id = "quick"
            startQuickConnect()
        else if id = "cancelqc"
            stopQuickConnect()
            showSignInItems("")
        else if id.startsWith("user:")
            u = m.users[id.mid(5).toInt()]
            if not Util.isAA(u) then return
            m.pendingUser = Util.toText(u.Name)
            if Util.flag(u, "HasPassword")
                askText("password", "Password", "Password for " + m.pendingUser, "", true)
            else
                signIn(m.pendingUser, "")
            end if
        end if
    else if s.screenId = "connecting"
        if id = "retry"
            validate(m.server)
        else if id = "servers"
            showServers("")
        end if
    end if
end sub

sub onOptions(ev as object)
    s = ev.getRoSGNode()
    id = ev.getData().id
    if s.screenId = "servers" and id.startsWith("srv:")
        srv = Servers.find(id.mid(4))
        if srv = invalid then return
        m.removeId = Util.toText(srv.id)
        d = createObject("roSGNode", "StandardMessageDialog")
        d.title = "Remove " + Util.toText(srv.name) + "?"
        d.message = ["Cove forgets this server and its sign-in. You can add it again any time."]
        d.buttons = ["Remove", "Cancel"]
        d.observeField("buttonSelected", "onRemoveButton")
        d.observeField("wasClosed", "onDialogClosed")
        m.top.dialog = d
    end if
end sub

sub onRemoveButton()
    remove = m.top.dialog.buttonSelected = 0
    closeDialog()
    if remove
        ' end the sessions of all its profiles on the server too (best effort, nothing waits for them)
        for each us in Servers.sessions(Servers.find(m.removeId))
            request("POST", us, "/Sessions/Logout", true, "", { kind: "logout" })
        end for
        Servers.remove(m.removeId)
        showServers("Server removed.")
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if key = "back" and m.stack.count() > 1
        stopQuickConnect()
        pop()
        return true
    end if
    return false
end function

' ---------------------------------------------------------------- keyboard

sub askText(purpose as string, title as string, message as string, text as string, secure as boolean)
    m.keyboardFor = purpose
    d = createObject("roSGNode", "StandardKeyboardDialog")
    d.title = title
    d.message = [message]
    d.text = text
    d.buttons = ["OK", "Cancel"]
    if secure
        if d.hasField("keyboardDomain") then d.keyboardDomain = "password"
        if d.hasField("textEditBox") and d.textEditBox <> invalid then d.textEditBox.secureMode = true
    end if
    d.observeField("buttonSelected", "onKeyboardButton")
    d.observeField("wasClosed", "onDialogClosed")
    m.top.dialog = d
    d.setFocus(true)
end sub

' Opening a keyboard while the previous one is still closing leaves the new one on screen without focus
' (the closing dialog hands focus back to the page), so the user can't type. Wait until it has gone.
sub askTextLater(purpose as string, title as string, message as string, text as string, secure as boolean)
    m.nextAsk = { purpose: purpose, title: title, message: message, text: text, secure: secure }
    m.dialogTimer.control = "start"
end sub

sub onDialogTimer()
    a = m.nextAsk
    m.nextAsk = invalid
    if a <> invalid then askText(a.purpose, a.title, a.message, a.text, a.secure)
    if m.nextNotice <> invalid
        n = m.nextNotice
        m.nextNotice = invalid
        showNotice("Profile PIN", n)
    end if
end sub

sub onKeyboardButton()
    d = m.top.dialog
    ok = d.buttonSelected = 0
    text = Util.toText(d.text).trim()
    closeDialog()
    if not ok then return
    if m.keyboardFor = "address"
        if text <> "" then probe(Util.urlCandidates(text), 0, text)
    else if m.keyboardFor = "username"
        if text = "" then return
        m.pendingUser = text
        askTextLater("password", "Password", "Password for " + text + " (leave empty if none)", "", true)
    else if m.keyboardFor = "password"
        signIn(m.pendingUser, text)
    end if
end sub

' Back pressed on a dialog. Only the dialog still on screen counts, because a dialog that was just closed
' must not close the next one (username → password).
sub onDialogClosed(ev as object)
    d = ev.getRoSGNode()
    if m.top.dialog <> invalid and d.isSameNode(m.top.dialog) then closeDialog()
end sub

' Stop listening to the dialog before closing it, so its late "wasClosed" can't reach the next dialog
sub closeDialog()
    d = m.top.dialog
    if d <> invalid
        d.unobserveField("buttonSelected")
        d.unobserveField("wasClosed")
        d.close = true
    end if
    t = top()
    if t <> invalid then t.setFocus(true)
end sub

' ---------------------------------------------------------------- requests

sub request(method as string, server as object, path as string, withToken as boolean, body as string, tag as object)
    t = createObject("roSGNode", "ApiTask")
    t.request = { method: method, url: Util.toText(server.url) + path, headers: Api.headers(server, withToken), body: body, tag: tag }
    t.observeField("response", "onResponse")
    m.pending.push(t)
    t.control = "RUN"
end sub

sub onResponse(ev as object)
    t = ev.getRoSGNode()
    for i = 0 to m.pending.count() - 1
        if m.pending[i].isSameNode(t)
            m.pending.delete(i)
            exit for
        end if
    end for
    r = ev.getData()
    ' (an answer of an unexpected shape must give a message, not stop the app)
    try
        dispatchResponse(r)
    catch e
        where = ""
        if e.backtrace <> invalid and e.backtrace.count() > 0
            f = e.backtrace[e.backtrace.count() - 1]
            where = " at " + Util.toText(f.filename).replace("pkg:/", "") + ":" + Util.toText(f.line_number)
        end if
        print "Cove: couldn't handle a server answer: "; Util.redact(Util.toText(e.message)); where
        showNotice("Unexpected answer", "The server sent an answer Cove couldn't read. Please try again.")
    end try
end sub

sub dispatchResponse(r as object)
    kind = Util.toText(Util.field(r.tag, "kind"))
    if kind = "probe"
        onProbe(r)
    else if (kind = "users" or kind = "qcEnabled") and (m.server = invalid or Util.toText(r.tag.serverId) <> Util.toText(m.server.id))
        print "Cove: ignored a sign-in answer from another server"
    else if kind = "users"
        onUsers(r)
    else if kind = "qcEnabled"
        m.quickConnect = r.code = 200 and Util.flag({ v: r.value }, "v")
        showSignInItems("")
    else if kind = "signin"
        onSignIn(r)
    else if kind = "validate"
        onValidate(r)
    else if kind = "deeplink"
        onDeepLinkItem(r)
    else if kind = "seasonOpen"
        if r.code = 200 and Util.isAA(r.json) and Util.toText(r.json.SeriesId) <> ""
            openItem({ itemId: Util.toText(r.json.Id), itemType: "Season", seriesId: Util.toText(r.json.SeriesId), seriesName: Util.toText(r.json.SeriesName), title: Util.toText(r.json.Name) })
        end if
    else if kind = "resumeCheck"
        onResumeCheck(r)
    else if kind = "logout"
        print "Cove: signed out of the removed server -> "; r.code
    end if
end sub

' ---------------------------------------------------------------- add a server

' Tries the typed address as https / http / :8096 until one answers like an Emby or Jellyfin server
sub probe(candidates as object, index as integer, typed as string)
    if index >= candidates.count()
        setStatus("servers", "Couldn't find an Emby or Jellyfin server at " + typed + ". Check the address and that the server is running.")
        return
    end if
    setStatus("servers", "Looking for the server at " + candidates[index] + "...")
    request("GET", { url: candidates[index], type: "emby" }, "/System/Info/Public", false, "", { kind: "probe", candidates: candidates, index: index, typed: typed })
end sub

sub onProbe(r as object)
    j = r.json
    if r.code = 200 and j <> invalid and GetInterface(j, "ifAssociativeArray") <> invalid and Util.toText(j.Id) <> ""
        url = r.tag.candidates[r.tag.index]
        kind = "emby"
        if LCase(Util.toText(j.ProductName)).instr("jellyfin") >= 0 then kind = "jellyfin"
        srv = Servers.find(Util.toText(j.Id))
        if srv = invalid then srv = { id: Util.toText(j.Id), userId: "", userName: "", token: "" }
        srv.name = Util.toText(j.ServerName)
        srv.url = url
        srv.type = kind
        srv.version = Util.toText(j.Version)
        ' plain http outside the home network: say so before anything (the password) is sent
        if Util.isPlainRemote(url)
            m.plainServer = srv
            d = createObject("roSGNode", "StandardMessageDialog")
            d.title = "This connection isn't encrypted"
            d.message = [Util.hostOf(url) + " uses plain http and isn't on your home network, so your password and your sign-in can be read by anyone on the networks in between (for example public Wi-Fi).", "If the server has an https address, use that instead."]
            d.buttons = ["Cancel", "Continue Anyway"]
            d.observeField("buttonSelected", "onPlainButton")
            d.observeField("wasClosed", "onDialogClosed")
            m.top.dialog = d
            return
        end if
        addProbed(srv)
    else
        probe(r.tag.candidates, r.tag.index + 1, r.tag.typed)
    end if
end sub

sub onPlainButton()
    proceed = m.top.dialog.buttonSelected = 1
    srv = m.plainServer
    m.plainServer = invalid
    closeDialog()
    if not proceed or srv = invalid
        setStatus("servers", "Not added. Use the server's https address if it has one.")
        return
    end if
    addProbed(srv)
end sub

' Saves the server that answered and opens it. A saved sign-in stays with the address it was made on: the
' server id is public (any host can answer /System/Info/Public with it), so a known id at a new address
' (another host or port, or http instead of https) must not get the saved token. Sign in again there; the
' old session is ended at the old address, where the token belongs (best effort).
sub addProbed(srv as object)
    prev = Servers.find(Util.toText(srv.id))
    if prev <> invalid and Util.originOf(Util.toText(prev.url)) <> Util.originOf(Util.toText(srv.url))
        ' (every profile's sign-in: Servers.upsert clears their tokens, the profiles stay to sign in again)
        for each us in Servers.sessions(prev)
            print "Cove: known server at a new address: the saved sign-in is not reused"
            request("POST", us, "/Sessions/Logout", true, "", { kind: "logout" })
        end for
        srv.token = ""
        srv.userId = ""
    end if
    Servers.upsert(srv)
    openServer(srv)
end sub

' ---------------------------------------------------------------- sign in

sub openServer(server as dynamic)
    if server = invalid then return
    ' (several profiles, or the last one used has a PIN: Who's watching? asks for it)
    if Servers.profiles(server).count() >= 2 or Servers.pinOf(server, Util.toText(server.userId)) <> ""
        showWho(server, "", topIs("servers"))
    else if Util.toText(server.token) <> ""
        validate(server)
    else
        openSignIn(server, "")
    end if
end sub

sub openSignIn(server as object, status as string)
    m.server = server
    m.users = []
    m.quickConnect = false
    line = Servers.typeName(server) + " " + Util.toText(server.version) + "   ·   " + Util.toText(server.url)
    if Util.isPlainHttp(Util.toText(server.url)) then line = line + "   ·   Not encrypted"
    sc = newMenu("signin", "Sign in to " + Util.toText(server.name), line, [{ id: "manual", label: "Enter username and password" }])
    if status = "" and Util.isPlainRemote(Util.toText(server.url)) then status = "This connection isn't encrypted: your password can be read on the networks in between."
    sc.status = status
    if topIs("servers") or topIs("profiles") or topIs("settings")
        ' (Back returns to the list / Who's watching? / Settings it came from)
        push(sc)
    else
        ' (from "connecting" or home: start from the server list so Back goes there)
        showServers("")
        push(sc)
    end if
    ' (tagged with the server: a slow answer from the server opened before must not fill this list)
    sid = Util.toText(server.id)
    request("GET", server, "/Users/Public", false, "", { kind: "users", serverId: sid })
    if Servers.isJellyfin(server) then request("GET", server, "/QuickConnect/Enabled", false, "", { kind: "qcEnabled", serverId: sid })
end sub

sub onUsers(r as object)
    if r.code = 200 and type(r.json) = "roArray" then m.users = r.json
    showSignInItems("")
end sub

' The sign-in menu: the server's visible users, manual entry, Quick Connect (Jellyfin)
sub showSignInItems(status as string)
    if not topIs("signin") then return
    items = []
    for i = 0 to m.users.count() - 1
        if Util.isAA(m.users[i]) then items.push({ id: "user:" + i.toStr(), label: Util.toText(m.users[i].Name) })
    end for
    items.push({ id: "manual", label: "Enter username and password" })
    if m.quickConnect then items.push({ id: "quick", label: "Quick Connect (approve from another Jellyfin app)" })
    t = top()
    t.code = ""
    t.items = items
    if status <> "" then t.status = status
end sub

sub signIn(name as string, password as string)
    setStatus("signin", "Signing in as " + name + "...")
    request("POST", m.server, "/Users/AuthenticateByName", false, Api.credentialsBody(name, password), { kind: "signin" })
end sub

sub onSignIn(r as object)
    if r.code = 200 and Util.isAA(r.json) and Util.toText(r.json.AccessToken) <> ""
        signedIn(r.json)
    else if r.code = 401
        setStatus("signin", "Wrong username or password.")
    else
        setStatus("signin", "Sign-in failed. " + Api.describeFailure(r))
    end if
end sub

' Successful sign-in (password or Quick Connect): save it and go home
sub signedIn(auth as object)
    s = m.server
    s.token = Util.toText(Util.field(auth, "AccessToken"))
    if Util.isAA(Util.field(auth, "User"))
        s.userId = Util.toText(auth.User.Id)
        s.userName = Util.toText(auth.User.Name)
        ' (the profile picture, for Who's watching?)
        s.avatar = Util.toText(auth.User.PrimaryImageTag)
    end if
    Servers.upsert(s)
    showHome(s)
end sub

' ---------------------------------------------------------------- Quick Connect (Jellyfin)

sub startQuickConnect()
    stopQuickConnect()
    t = top()
    t.items = [{ id: "cancelqc", label: "Cancel" }]
    t.status = "Getting a code..."
    m.qcTask = createObject("roSGNode", "QuickConnectTask")
    m.qcTask.server = m.server
    m.qcTask.observeField("code", "onQcCode")
    m.qcTask.observeField("result", "onQcResult")
    m.qcTask.observeField("error", "onQcError")
    m.qcTask.control = "RUN"
end sub

sub stopQuickConnect()
    if m.qcTask <> invalid
        m.qcTask.unobserveField("code")
        m.qcTask.unobserveField("result")
        m.qcTask.unobserveField("error")
        m.qcTask.cancel = true
        m.qcTask = invalid
    end if
end sub

sub onQcCode()
    if not topIs("signin") or m.qcTask = invalid then return
    t = top()
    t.code = m.qcTask.code
    t.status = "In another signed-in Jellyfin app: Settings → Quick Connect, enter this code."
end sub

sub onQcResult()
    if m.qcTask = invalid then return
    auth = m.qcTask.result
    stopQuickConnect()
    signedIn(auth)
end sub

sub onQcError()
    if m.qcTask = invalid then return
    msg = m.qcTask.error
    stopQuickConnect()
    showSignInItems(msg)
end sub

' ---------------------------------------------------------------- saved sign-in

sub validate(server as object)
    m.server = server
    sc = newMenu("connecting", Util.toText(server.name), Servers.typeName(server) + "   ·   " + Util.toText(server.url), [])
    sc.status = "Connecting..."
    reset(sc)
    request("GET", server, "/Users/" + Util.toText(server.userId), true, "", { kind: "validate" })
end sub

sub onValidate(r as object)
    if not topIs("connecting") then return
    if r.code = 200
        showHome(m.server)
    else if r.code = 401 or r.code = 403 or r.code = 404
        ' The saved sign-in no longer works (password changed, device removed on the server)
        m.server.token = ""
        Servers.upsert(m.server)
        openSignIn(m.server, "Your sign-in has expired. Please sign in again.")
    else
        t = top()
        t.items = [
            { id: "retry", label: "Try again" },
            { id: "servers", label: "Choose another server" }
        ]
        t.status = "Couldn't reach " + Util.toText(m.server.name) + ". " + Api.describeFailure(r)
    end if
end sub

sub signOut()
    s = m.server
    if s = invalid then s = Servers.active()
    if s = invalid
        showServers("")
        return
    end if
    ' only this profile: the server's other profiles stay signed in
    if Util.toText(s.token) <> "" then request("POST", s, "/Sessions/Logout", true, "", { kind: "logout" })
    who = Util.toText(s.userName)
    Servers.removeUser(Util.toText(s.id), Util.toText(s.userId))
    rest = Servers.find(Util.toText(s.id))
    msg = "Signed out of " + Util.toText(s.name) + "."
    if who <> "" then msg = who + " signed out of " + Util.toText(s.name) + "."
    if rest <> invalid and Servers.sessions(rest).count() > 0
        m.server = rest
        afterSignOut(rest, msg)
        return
    end if
    Servers.setActive("")
    showServers(msg)
end sub

' Another profile is still signed in on that server: its list (Who's watching?), or the server list
sub afterSignOut(server as object, msg as string)
    showWho(server, msg, false)
end sub

' ---------------------------------------------------------------- profiles (Who's watching?)

' At start: the server has 2 or more profiles and Settings → Servers → "Ask who's watching at start" is on
' (also, whatever that setting, when the last profile used has a PIN: it's asked before its Home opens)
function wantsWho(s as object) as boolean
    if Servers.pinOf(s, Util.toText(s.userId)) <> "" then return true
    return Servers.profiles(s).count() >= 2 and Servers.asksWho(s)
end function

' The profile picker for a server; asPush keeps the screen below (Back returns there)
sub showWho(server as object, status as string, asPush as boolean)
    if server = invalid
        showServers("")
        return
    end if
    srv = Servers.find(Util.toText(server.id))
    if srv = invalid then srv = server
    w = createObject("roSGNode", "ProfileScreen")
    w.observeField("chosen", "onWhoChosen")
    w.server = srv
    w.currentId = Util.toText(srv.userId)
    w.profiles = whoList(srv)
    if asPush
        push(w)
    else
        reset(w)
    end if
    w.status = status
end sub

function whoList(srv as object) as object
    out = []
    for each p in Servers.profiles(srv)
        note = ""
        if p.maxRating <> "" then note = "Up to " + p.maxRating
        if not p.signedIn then note = "Signed out"
        out.push({ id: p.id, name: p.name, avatar: avatarUrl(srv, p.id, p.avatar), hasPin: p.hasPin, signedIn: p.signedIn, note: note })
    end for
    return out
end function

' The user's picture on the server (public, no token in the address); "" without one
function avatarUrl(srv as object, userId as string, imageTag as string) as string
    if imageTag = "" or userId = "" then return ""
    base = Util.toText(srv.url)
    q = "?maxWidth=220&quality=90&tag=" + imageTag
    ' (Jellyfin 10.9 moved user pictures to /UserImage)
    v = Util.toText(srv.version).split(".")
    if Servers.isJellyfin(srv) and v.count() >= 2 and (v[0].toInt() > 10 or (v[0].toInt() = 10 and v[1].toInt() >= 9))
        return base + "/UserImage" + q + "&userId=" + userId
    end if
    return base + "/Users/" + userId + "/Images/Primary" + q
end function

sub onWhoChosen(ev as object)
    w = ev.getRoSGNode()
    id = Util.toText(ev.getData().id)
    srv = Servers.find(Util.toText(w.server.id))
    if srv = invalid
        showServers("")
        return
    end if
    if id = "add"
        openSignIn(srv, "")
    else if id = "servers"
        showServers("")
    else
        chooseProfile(srv, id)
    end if
end sub

' A profile was picked (Who's watching?, Settings): its PIN first when it has one, then switch
sub chooseProfile(srv as object, userId as string)
    sid = Util.toText(srv.id)
    stored = Servers.pinOf(srv, userId)
    onHome = m.server <> invalid and m.homeReady and Util.toText(m.server.id) = sid and Util.toText(m.server.userId) = userId
    if stored = "" or onHome
        switchProfile(srv, userId)
        return
    end if
    wait_ = Pins.waitLeft(sid, userId)
    if wait_ > 0
        pinMessage(Pins.waitText(wait_))
        return
    end if
    u = Servers.userOf(srv, userId)
    m.pinFor = { serverId: sid, userId: userId }
    askPin("Enter the PIN for " + Util.toText(Util.field(u, "n")), "This profile is locked with a PIN.")
end sub

' The Roku's PIN pad (4 digits, hidden as they are typed)
sub askPin(title as string, message as string)
    d = createObject("roSGNode", "StandardPinPadDialog")
    d.title = title
    d.message = [message]
    d.buttons = ["OK", "Cancel"]
    if d.hasField("textEditBox") and d.textEditBox <> invalid
        d.textEditBox.secureMode = true
        d.textEditBox.maxTextLength = 4
    end if
    d.observeField("buttonSelected", "onPinButton")
    d.observeField("wasClosed", "onDialogClosed")
    m.top.dialog = d
    d.setFocus(true)
end sub

sub onPinButton()
    d = m.top.dialog
    ok = d.buttonSelected = 0
    pin = Util.toText(d.pin)
    closeDialog()
    f = m.pinFor
    m.pinFor = invalid
    if not ok or f = invalid then return
    srv = Servers.find(f.serverId)
    if srv = invalid then return
    if Pins.matches(Servers.pinOf(srv, f.userId), f.serverId, f.userId, pin)
        Pins.clearWrong(f.serverId, f.userId)
        switchProfile(srv, f.userId)
    else
        print "Cove: wrong profile PIN"
        pinMessage(Pins.wrongText(Pins.noteWrong(f.serverId, f.userId)))
    end if
end sub

' On Who's watching? as its status line, elsewhere (Settings) as a notice
sub pinMessage(text as string)
    if topIs("profiles")
        top().status = text
    else
        ' (after the PIN pad has closed, so the notice gets the focus)
        m.nextNotice = text
        m.dialogTimer.control = "start"
    end if
end sub

' Makes the profile the active one and rebuilds Home for it (sign in again when its sign-in has gone)
sub switchProfile(srv as object, userId as string)
    ' (the profile already on Home, picked from the sidebar: just go back)
    if m.server <> invalid and m.homeReady and Util.toText(m.server.id) = Util.toText(srv.id) and Util.toText(m.server.userId) = userId and Util.toText(m.server.token) <> ""
        while m.stack.count() > 1 and not topIs("home")
            pop()
        end while
        return
    end if
    s = Servers.useUser(Util.toText(srv.id), userId)
    if s = invalid then return
    print "Cove: switching profile on "; Util.toText(s.name)
    if Util.toText(s.token) <> ""
        validate(s)
    else
        openSignIn(s, "Sign in again as " + Util.toText(s.userName) + ".")
    end if
end sub

' Voice / transport commands go to the player on top; elsewhere the Roku does its default
function handleTransport(evt as object) as object
    t = top()
    if t <> invalid and t.screenId = "player" then return t.callFunc("handleTransport", evt)
    return { status: "unhandled" }
end function

' ---------------------------------------------------------------- Instant Resume

function nowSecs() as integer
    return createObject("roDateTime").asSeconds()
end function

' The app goes to the background (Home, Back out of the app, the screensaver). It stays in memory, so the
' screens stay as they are; only what runs on its own stops: a playing video ends as on Back (stop report,
' the server's conversion ended), Home and Now Playing stop polling.
sub customSuspend(args as dynamic)
    reason = ""
    if Util.isAA(args) then reason = Util.toText(args.lastSuspendOrResumeReason)
    where = ""
    t = top()
    if t <> invalid then where = Util.toText(t.screenId)
    print "Cove: suspended ("; reason; ") on "; where
    m.suspendedAt = nowSecs()
    try
        stopNextAsk()
        stopQuickConnect()
        ' (the player is taken off the stack: when the app comes back the user is on the page it was started from)
        stopPlayers()
        for each s in m.stack
            if s.hasField("suspended") then s.suspended = true
        end for
    catch e
        print "Cove: suspend failed: "; Util.redact(Util.toText(e.message))
    end try
end sub

' The app is launched again from memory: the screens pick up their timers, the saved sign-in is checked
' (it may have been revoked meanwhile), Home reloads its rows if they are older than a few minutes, and a
' deep link that came with the launch is opened.
sub customResume(args as dynamic)
    away = 0
    if m.suspendedAt > 0 then away = nowSecs() - m.suspendedAt
    reason = ""
    if Util.isAA(args) then reason = Util.toText(args.lastSuspendOrResumeReason)
    print "Cove: resumed ("; reason; ") after "; away; " s"
    try
        for each s in m.stack
            if s.hasField("suspended") then s.suspended = false
        end for
        if m.homeReady and m.server <> invalid and Util.toText(m.server.token) <> ""
            request("GET", m.server, "/Users/" + Util.toText(m.server.userId), true, "", { kind: "resumeCheck", serverId: Util.toText(m.server.id) })
        else if topIs("connecting")
            ' (still checking the saved sign-in when the app was suspended: try again)
            validate(m.server)
        end if
        if Util.isAA(args) and Util.isAA(args.launchParams)
            lp = args.launchParams
            if lp.contentId <> invalid and lp.mediaType <> invalid
                print "Cove: resumed with contentId="; Util.toText(lp.contentId); " mediaType="; Util.toText(lp.mediaType)
                m.top.deepLink = { contentId: lp.contentId, mediaType: lp.mediaType }
            end if
        end if
    catch e
        print "Cove: resume failed: "; Util.redact(Util.toText(e.message))
    end try
    ' (the screen is on and can be used: Roku measures the resume up to here)
    m.top.signalBeacon("AppResumeComplete")
end sub

sub stopNextAsk()
    m.nextAsk = invalid
    m.dialogTimer.control = "stop"
end sub

' The sign-in check after a resume
sub onResumeCheck(r as object)
    if m.server = invalid or Util.toText(r.tag.serverId) <> Util.toText(m.server.id) then return
    if r.code = 401 or r.code = 403
        print "Cove: the saved sign-in no longer works after the resume"
        m.pendingLink = invalid
        m.server.token = ""
        Servers.upsert(m.server)
        openSignIn(m.server, "Your sign-in has expired. Please sign in again.")
        return
    end if
    if r.code <> 200
        print "Cove: sign-in check after the resume -> "; r.code
        return
    end if
    ' rows older than 5 minutes: Home reloads now if it is on top, otherwise when it is shown again
    if nowSecs() - m.homeLoadedAt < 300 then return
    if topIs("home")
        m.homeLoadedAt = nowSecs()
        top().reload = true
    else
        markStale()
    end if
end sub
