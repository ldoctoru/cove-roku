import "pkg:/source/Util.bs"
import "pkg:/source/Tracks.bs"
import "pkg:/source/Servers.bs"
import "pkg:/source/Api.bs"
import "pkg:/source/DeviceCaps.bs"
import "pkg:/source/Theme.bs"
import "pkg:/source/Ratings.bs"
import "pkg:/source/Prefs.bs"
import "pkg:/source/QuickPlay.bs"
import "pkg:/source/HomeLayout.bs"
import "pkg:/source/NavUtil.bs"

sub init()
    ' Colours and theme images for every component (Cove Glass: accent and page colour as chosen in Settings)
    look = Theme.get()
    m.global.addFields({ theme: look })
    ' (v0.9.1) series ratings looked up this session, for unrated episodes under a rating limit (Ratings.bs)
    m.global.addFields({ seriesRatings: {} })
    m.top.backgroundColor = look.bg.left(8)
    m.top.backgroundURI = ""
    m.top.findNode("background").color = look.bg
    m.screens = m.top.findNode("screens")
    m.stack = []
    m.pending = []              ' running ApiTasks (kept referenced until they answer)
    m.beaconSent = false
    m.inDialog = false
    m.server = invalid          ' the server being added / signed in to
    m.users = []                ' its public users
    m.quickConnect = false      ' Jellyfin Quick Connect enabled on it
    m.qcTask = invalid
    m.pendingUser = ""
    m.emptyTry = ""             ' user tile signed in without a password (Jellyfin 12: ask for one on 401)
    m.keyboardFor = ""
    m.nextAsk = invalid
    ' (v0.9.1) the profile PIN steps, shared with Settings (components/profiles/PinFlow)
    m.pinFlow = createObject("roSGNode", "PinFlow")
    m.pinFlow.observeField("result", "onPinResult")
    m.top.appendChild(m.pinFlow)
    m.dialogTimer = m.top.findNode("dialogTimer")
    m.dialogTimer.observeField("fire", "onDialogTimer")
    m.removeId = ""
    m.plainServer = invalid     ' a plain http server outside the home network, waiting for "Continue Anyway"
    m.homeStale = false
    m.deviceLine = ""
    ' (v1.1.1 SP-24) the decoder probes run on a Task, not before the first screen
    m.capsTask = createObject("roSGNode", "CapsTask")
    m.capsTask.observeField("line", "onDeviceLine")
    m.capsTask.control = "RUN"
    m.pendingLink = invalid
    m.pendingLinkAt = 0         ' (C2-16) when it was held, and the server it came for ("" = any)
    m.pendingLinkServer = ""
    m.lastLinkId = ""           ' the last deep link and when it came (repeats within 2 s are dropped)
    m.lastLinkAt = 0
    m.homeReady = false         ' Home is on screen with a signed-in server: deep links can be opened
    ' (v1.0 LAN discovery: servers that answered the UDP broadcast, and the task while it listens)
    m.found = []
    m.discovery = invalid
    m.scanned = false
    ' (v0.9.0: saved sign-ins become profiles, several per server)
    Servers.migrate()
    ' (C2-1) the profile with a rating limit that is or was last active ({ serverId, userId }): until a parent PIN
    ' or a profile without a limit takes over, the server list asks for a parent PIN before it adds, removes or
    ' opens another server, and a sign-in as someone else waits for one too
    m.lock = invalid
    m.heldAuth = invalid
    noteLock(Servers.active())
    m.probeGen = 0              ' (C2-10) the current server probe: answers of an earlier one are dropped
    m.suspendedAt = 0           ' (Instant Resume) when the app went to the background, in seconds
    m.homeLoadedAt = 0          ' when Home last loaded its rows
    m.toastOnHome = ""          ' a toast for the next Home (profile switch)
    ' (SC-3 / SC-4) MainScene's own requests for a screen: the answer is dropped when that screen is no longer on top
    m.reqSeq = 0
    m.introsPending = invalid   ' { id, screen, at } while Cinema Mode asks for the intros (a second Play waits)
    m.seasonPending = invalid   ' { id, screen } while a season card asks for its series
    m.quickPending = invalid    ' (v1.1 U-1) { id, screen, at, title } while the Play key on a card looks up what to play
    ' (Instant Resume: the stop report and the end of a conversion still go out after the app is suspended)
    if m.top.hasField("allowBackgroundTask") then m.top.allowBackgroundTask = true
    start()
end sub

' Signed in before: check the saved sign-in still works, otherwise show the server list
sub start()
    s = Servers.active()
    if s <> invalid and wantsWho(s)
        ' Who's watching? (2 or more profiles on the server, Settings → Profiles)
        showWho(s, "", false)
    else if s <> invalid and Util.toText(s.token) <> ""
        validate(s)
    else
        showServers("")
    end if
end sub

' ---------------------------------------------------------------- toasts

sub onToast()
    host = m.top.findNode("toastHost")
    if host <> invalid then host.show = m.top.toast
end sub

' ---------------------------------------------------------------- screens

function newMenu(id as string, title as string, subtitle as string, items as object) as object
    s = createObject("roSGNode", "MenuScreen")
    s.screenId = id
    s.title = title
    s.subtitle = subtitle
    s.items = items
    s.observeField("selected", "onSelected")
    s.observeField("options", "onOptions")
    return s
end function

sub push(s as object)
    ' (BG-8) every page and the player count toward the cap, not only the ones that called capStack
    sid0 = Util.toText(s.screenId)
    if not (sid0 = "servers" or sid0 = "signin" or sid0 = "address" or sid0 = "profiles") then capStack()
    if m.stack.count() > 0 then m.stack.peek().visible = false
    m.screens.appendChild(s)
    m.stack.push(s)
    s.setFocus(true)
    ' the server list / sign-in shown before Home is a dialog for Roku's launch timing
    sid = Util.toText(s.screenId)
    if sid = "servers" or sid = "signin" or sid = "address" or sid = "profiles" then dialogStarted()
end sub

' A screen that waits for the user before Home (server list, sign-in, Who's watching?, "Couldn't reach"):
' a dialog for Roku's launch timing, once, closed by launchComplete
sub dialogStarted()
    if m.beaconSent or m.inDialog then return
    m.inDialog = true
    m.top.signalBeacon("AppDialogInitiate")
end sub

' Home has its first rows or shows its error (C-2: Home sends "ready"): the launch is complete (after the
' dialog, if one was shown)
sub launchComplete()
    if m.beaconSent then return
    if m.inDialog
        m.inDialog = false
        m.top.signalBeacon("AppDialogComplete")
    end if
    m.beaconSent = true
    m.top.signalBeacon("AppLaunchComplete")
end sub

' Settings → Servers: connect to another server, sign out, or add one
sub onSettingsAction(ev as object)
    a = ev.getData()
    ' (C2-1: Settings asked for the parent PIN before these while a limited profile was on Home)
    if a.id = "connect" or a.id = "signout" or a.id = "switch" or a.id = "addProfile" then m.lock = invalid
    if a.id = "connect"
        m.themeDirty = false
        openServer(Servers.find(Util.toText(a.serverId)))
    else if a.id = "signout"
        m.themeDirty = false
        signOut()
    else if a.id = "switch"
        ' (SC-5) the server list over Settings: Back returns there; the stack is replaced only when another
        ' server or profile is opened
        showServers("", m.homeReady)
    else if a.id = "profiles"
        showWho(m.server, "", true)
    else if a.id = "profileChanged"
        ' (the rating limit of the profile on Home: the saved record, read again)
        if m.server <> invalid
            fresh = Servers.find(Util.toText(m.server.id))
            if fresh <> invalid then m.server = fresh
        end if
    else if a.id = "addProfile"
        if m.server <> invalid then openSignIn(m.server, "")
    else if a.id = "useProfile"
        m.themeDirty = false
        if m.server <> invalid then chooseProfile(m.server, Util.toText(a.userId))
    else if a.id = "renamed"
        ' the current server was renamed: keep MainScene's copy in step, Home is rebuilt when Settings closes
        if m.server <> invalid and Util.toText(m.server.id) = Util.toText(a.serverId) then m.server.name = Util.toText(a.name)
    end if
end sub

' Accent / background changed in Settings: the scene colour now, the screens below when Settings closes
sub onThemeChanged()
    look = m.global.theme
    m.top.backgroundColor = look.bg.left(8)
    m.top.findNode("background").color = look.bg
    m.themeDirty = true
end sub

sub pop()
    s = m.stack.pop()
    m.screens.removeChild(s)
    detachScreen(s)
    ' screens under Settings were drawn with the old colours: start again from a fresh home (SC-14: only when
    ' Settings itself closes, not a page opened from it such as Who's watching?)
    if m.themeDirty = true and m.server <> invalid and Util.toText(s.screenId) = "settings"
        m.themeDirty = false
        showHome(m.server)
        return
    end if
    t = m.stack.peek()
    t.visible = true
    t.setFocus(true)
    ' Continue Watching / Next Up changed while something was played
    if m.homeStale and t.screenId = "home"
        m.homeStale = false
        t.reload = true
        m.homeLoadedAt = nowSecs()
    end if
end sub

' (SC-3) A removed screen can still answer (its tasks keep it alive): it may not start playback or open pages.
' Its "action" stays observed for "changed" (onHomeAction drops the rest from screens not on top).
sub detachScreen(s as dynamic)
    if s = invalid then return
    if s.screenId = "details"
        s.unobserveField("play")
        s.unobserveField("openItem")
    end if
end sub

' Replace the whole stack with one screen (after signing in, or when starting over)
sub reset(s as object)
    for each old in m.stack
        detachScreen(old)
    end for
    m.screens.removeChildrenIndex(m.screens.getChildCount(), 0)
    m.stack = []
    ' (the screens drawn with the old colours are gone)
    m.themeDirty = false
    ' (showHome sets it again; any other start-over screen is before or outside Home)
    m.homeReady = false
    push(s)
end sub

' Takes the top screen away without showing the one under it (it is replaced right after)
sub dropTop()
    s = m.stack.pop()
    if s = invalid then return
    m.screens.removeChild(s)
    detachScreen(s)
end sub

function top() as dynamic
    if m.stack.count() = 0 then return invalid
    return m.stack.peek()
end function

function topIs(id as string) as boolean
    t = top()
    return t <> invalid and t.screenId = id
end function

' (SC-3) The node is the screen on top (a late answer from a screen under it, or already removed, is dropped)
function isTopScreen(node as dynamic) as boolean
    t = top()
    return t <> invalid and node <> invalid and t.isSameNode(node)
end function

function inStack(node as dynamic) as boolean
    if node = invalid then return false
    for each s in m.stack
        if s.isSameNode(node) then return true
    end for
    return false
end function

function nextReqId() as integer
    m.reqSeq = m.reqSeq + 1
    return m.reqSeq
end function

sub setStatus(id as string, text as string)
    if topIs(id) then top().status = text
end sub

' asPush (SC-5): over the current stack (opened from Home or Settings), so Back returns there
sub showServers(status as string, asPush = false as boolean)
    items = []
    for each s in Servers.all()
        who = profileNames(s)
        lbl = Util.toText(s.name) + "   ·   " + who + "   ·   " + Servers.typeName(s)
        if Util.isPlainHttp(Util.toText(s.url)) then lbl = lbl + "   ·   Not encrypted"
        items.push({ id: "srv:" + Util.toText(s.id), label: lbl })
    end for
    sub_ = "Choose a server, or add one."
    if items.count() > 0 then sub_ = "Choose a server  ·  press * on a server to remove it"
    if items.count() > 0 and lockServer() <> invalid then sub_ = "Choose a server  ·  a parent PIN is needed to add, remove or open another server"
    if items.count() = 0
        ' first launch: the servers found on the network above "Enter address" (U-2 / F-8)
        sub_ = "Pick a server found on your network, or enter its address."
        items = foundItems("add")
    else
        items.push({ id: "add", label: "Add Server..." })
    end if
    sc = newMenu("servers", "Servers", sub_, items)
    sc.status = status
    if asPush
        push(sc)
    else
        reset(sc)
    end if
    if status = "" and m.deviceLine <> "" then sc.status = m.deviceLine
    if Servers.all().count() = 0
        if not m.scanned then startDiscovery()
        if status = "" then sc.status = foundStatus()
    end if
end sub

' ---------------------------------------------------------------- LAN discovery (U-2 / F-8)

' "Found on your network" entries, then Enter address (enterId) and Search again
function foundItems(enterId as string) as object
    items = []
    for i = 0 to m.found.count() - 1
        f = m.found[i]
        items.push({ id: "found:" + i.toStr(), label: Util.toText(f.name) + "   ·   " + foundAddress(f) + "   ·   Found on your network" })
    end for
    items.push({ id: enterId, label: "Enter Address..." })
    if m.discovery = invalid then items.push({ id: "rescan", label: "Search Again" })
    return items
end function

' "192.168.1.20:8096" (the scheme is tried https first when picked)
function foundAddress(f as object) as string
    a = Util.toText(f.address)
    at = a.instr("://")
    if at >= 0 then a = a.mid(at + 3)
    return a
end function

function foundStatus() as string
    if m.discovery <> invalid then return "Looking for servers on your network..."
    if not m.scanned then return ""
    if m.found.count() = 0 then return "No servers found on your network. Enter the address instead."
    if m.found.count() = 1 then return "Found 1 server on your network."
    return "Found " + m.found.count().toStr() + " servers on your network."
end function

sub startDiscovery()
    if m.discovery <> invalid then return
    t = createObject("roSGNode", "DiscoveryTask")
    t.seconds = 2
    t.observeField("servers", "onDiscovered")
    m.discovery = t
    m.scanned = true
    t.control = "RUN"
end sub

sub onDiscovered(ev as object)
    list = ev.getData()
    m.discovery = invalid
    m.found = []
    if type(list) = "roArray" then m.found = list
    refreshFound()
end sub

' The list on screen again with the answers (first-launch server list, or Add a server)
sub refreshFound()
    t = top()
    if t = invalid then return
    if t.screenId = "servers" and Servers.all().count() = 0
        t.items = foundItems("add")
        t.status = foundStatus()
    else if t.screenId = "address"
        t.items = foundItems("enter")
        t.status = foundStatus()
    end if
end sub

' Add a server: the servers found on the network, Enter address, Search again
sub showAddServer()
    sc = newMenu("address", "Add Server", "Pick a server found on your network, or enter its address.", [])
    push(sc)
    startDiscovery()
    sc.items = foundItems("enter")
    sc.status = foundStatus()
end sub

' A found server: the usual probe (https first, then the address it gave), so the security rules still apply
sub pickFound(index as integer)
    if index < 0 or index >= m.found.count() then return
    f = m.found[index]
    addr = Util.toText(f.address)
    hostPort = foundAddress(f)
    cands = ["https://" + hostPort]
    if LCase(addr).startsWith("http://") then cands.push(addr)
    print "Cove: picked a discovered server"
    startProbe(cands, Util.toText(f.name))
end sub

sub askAddress()
    askText("address", "Add Server", "The server's address, e.g. 192.168.1.20:8096 or https://emby.example.com", "", false)
end sub

' "Liviu", "Liviu, Ana", "3 profiles" or "not signed in" for the server list
function profileNames(s as object) as string
    names = []
    for each p in Servers.profiles(s)
        if p.signedIn then names.push(p.name)
    end for
    if names.count() = 0 then return "not signed in"
    if names.count() > 2 then return names.count().toStr() + " profiles"
    return Util.join(names, ", ")
end function

sub showHome(server as object)
    Servers.setActive(Util.toText(server.id))
    m.server = server
    ' (C2-1: a limited profile locks the server list; any other profile on Home unlocks it)
    m.lock = invalid
    noteLock(server)
    h = createObject("roSGNode", "HomeScreen")
    h.observeField("action", "onHomeAction")
    reset(h)
    h.server = server
    m.homeReady = true
    m.homeLoadedAt = nowSecs()
    ' (AppLaunchComplete waits for Home's "ready": its rows or its error on screen)
    ' (a profile switch: say whose Home this is now)
    if Util.toText(m.toastOnHome) <> ""
        m.top.toast = { text: m.toastOnHome, icon: "" }
        m.toastOnHome = ""
    end if
    ' a deep link that came before the sign-in finished
    if m.pendingLink <> invalid
        link = m.pendingLink
        m.pendingLink = invalid
        ' (C2-16: a link held for long, or for another server, is no longer what the user asked for)
        if nowSecs() - m.pendingLinkAt > 90 or (m.pendingLinkServer <> "" and m.pendingLinkServer <> Util.toText(server.id))
            print "Cove: dropped a deep link that waited too long or was for another server"
        else
            openDeepLink(link)
        end if
    end if
end sub

' (C2-16) Keeps a deep link until Home is ready, with when and for which server it came
sub holdLink(link as object)
    m.pendingLink = link
    m.pendingLinkAt = nowSecs()
    m.pendingLinkServer = ""
    if m.server <> invalid then m.pendingLinkServer = Util.toText(m.server.id)
end sub

' ---------------------------------------------------------------- deep links

' contentId is the server's item id. movie / episode / shortFormVideo / tvSpecial play from the saved position;
' series / season and anything else open their page. The link waits until Home is on screen: at a cold launch
' the saved sign-in is still being checked, and a player pushed over "Connecting..." left the app stuck there.
sub onDeepLink()
    link = m.top.deepLink
    if link = invalid or Util.toText(link.contentId) = "" then return
    ' (from Roku Search / voice, or from any device on the network via ECP: only plain item ids go into the
    ' request path, anything else is ignored)
    if not Util.isSafeId(link.contentId, false) or not Util.isSafeId(link.mediaType, true)
        print "Cove: ignored a deep link with an invalid contentId / mediaType"
        return
    end if
    ' (R-13: one launch can arrive twice, as resume launchParams and as an roInputEvent: once within 2 s)
    cid = Util.toText(link.contentId)
    if cid = m.lastLinkId and nowSecs() - m.lastLinkAt <= 2
        print "Cove: ignored a repeated deep link"
        return
    end if
    m.lastLinkId = cid
    m.lastLinkAt = nowSecs()
    if not m.homeReady or m.server = invalid or Util.toText(m.server.token) = ""
        holdLink(link)
        return
    end if
    openDeepLink(link)
end sub

sub openDeepLink(link as object)
    stopPlayers()
    request("GET", m.server, "/Users/" + Util.toText(m.server.userId) + "/Items/" + Util.toText(link.contentId), true, "", { kind: "deeplink", mediaType: LCase(Util.toText(link.mediaType)), contentId: Util.toText(link.contentId), linkType: Util.toText(link.mediaType) })
end sub

' A link while a video plays: end that player properly (video, stop report, timers) before the new title,
' otherwise it kept playing and reporting under the new screen
sub stopPlayers()
    stopped = false
    while topIs("player")
        p = m.stack.pop()
        p.unobserveField("done")
        p.stopNow = true
        m.screens.removeChild(p)
        stopped = true
    end while
    if not stopped then return
    markStale()
    t = top()
    if t = invalid then return
    t.visible = true
    ' (SC-1: a details page reloads as it gets the focus, since markStale flagged it)
    t.setFocus(true)
end sub

sub onDeepLinkItem(r as object)
    if r.code = 401
        ' the saved sign-in has expired: sign in again, then the link opens from Home
        holdLink({ contentId: r.tag.contentId, mediaType: r.tag.linkType })
        m.server.token = ""
        Servers.upsert(m.server)
        openSignIn(m.server, "Your sign-in has expired. Please sign in again.")
        return
    end if
    if r.code <> 200 or not Util.isAA(r.json)
        showNotice("Not found", "This title isn't on " + Util.toText(m.server.name) + ".")
        return
    end if
    it = r.json
    if Ratings.seriesUnknown(m.server, it)
        ' (v0.9.1: an episode without its own rating, under a limit: its series' rating decides)
        sid = Util.toText(it.SeriesId)
        request("GET", m.server, Ratings.seriesPath(m.server, [sid]), true, "", { kind: "deeplinkSeries", seriesId: sid, serverId: Util.toText(m.server.id), link: r })
        return
    end if
    if not Ratings.allowed(m.server, it)
        showNotice("Not available", "This title is above the rating limit of this profile.")
        return
    end if
    mt = r.tag.mediaType
    t = Util.toText(it.Type)
    playable = mt = "movie" or mt = "episode" or mt = "shortformvideo" or mt = "tvspecial"
    if playable and (t = "Movie" or t = "Episode" or t = "Video")
        title = Util.toText(it.Name)
        sub_ = ""
        if t = "Episode"
            title = Util.toText(it.SeriesName)
            sub_ = "S" + Util.toText(it.ParentIndexNumber) + ":E" + Util.toText(it.IndexNumber) + "  ·  " + Util.toText(it.Name)
        end if
        ' (the saved position, as a bookmark)
        atSec = Util.toNumber(Util.field(it.UserData, "PlaybackPositionTicks")) / 10000000
        if atSec < 30 then atSec = 0.0
        startPlayer({ id: Util.toText(it.Id), title: title, subtitle: sub_, start: atSec })
    else
        openItem({ itemId: Util.toText(it.Id), itemType: t, collectionType: LCase(Util.toText(it.CollectionType)), title: Util.toText(it.Name), seriesId: Util.toText(it.SeriesId), seriesName: Util.toText(it.SeriesName) })
    end if
end sub

sub onHomeAction(ev as object)
    a = ev.getData()
    sender = ev.getRoSGNode()
    ' (SC-3) a late answer (Shuffle's queue, a search result) from a screen that was closed or covered must not
    ' start playback or open a page over whatever is on top now; "ready" and "changed" are always fine
    if a.id <> "ready" and a.id <> "changed" and not isTopScreen(sender)
        if not (a.id = "expired" and inStack(sender))
            print "Cove: ignored a late "; Util.toText(a.id); " from a screen that is no longer on top"
            return
        end if
    end if
    if a.id = "ready"
        launchComplete()
    else if a.id = "switch"
        ' (v0.9.1: another server could lift the rating limit: a parent PIN first while a limited profile watches)
        guardedAct(m.server, { do: "servers" })
    else if a.id = "signout"
        guardedAct(m.server, { do: "signout" })
    else if a.id = "expired"
        m.server.token = ""
        Servers.upsert(m.server)
        openSignIn(m.server, "Your sign-in has expired. Please sign in again.")
    else if a.id = "open"
        openItem(a)
    else if a.id = "quickplay"
        playFromCard(a)
    else if a.id = "play"
        playItem = { id: a.itemId, title: a.title, subtitle: Util.toText(a.subtitle), start: a.start }
        ' (library Shuffle: the titles to play after this one)
        if type(a.queue) = "roArray" then playItem.queue = a.queue
        startPlayer(playItem)
    else if a.id = "favorites"
        ' rows by kind (Movies, Shows, Episodes, Collections, People), as the Mac's Favorites page
        fs = createObject("roSGNode", "FavoritesScreen")
        fs.observeField("action", "onHomeAction")
        push(fs)
        fs.server = m.server
    else if a.id = "changed"
        ' (a favourite person on their page: Home and Favorites reload when shown again)
        markStale(sender)
    else if a.id = "recent"
        l = createObject("roSGNode", "LibraryScreen")
        l.server = m.server
        l.observeField("action", "onHomeAction")
        push(l)
        l.library = { id: "", title: "Recently Added", itemType: "", collectionType: "", feed: a.id }
    else if a.id = "profile"
        ' the sidebar's profile entry: Who's watching? over Home (Back returns)
        showWho(m.server, "", true)
    else if a.id = "nowplaying"
        s = createObject("roSGNode", "NowPlayingScreen")
        s.server = m.server
        s.observeField("action", "onHomeAction")
        push(s)
    else if a.id = "settings"
        s = createObject("roSGNode", "SettingsScreen")
        s.server = m.server
        s.observeField("themeChanged", "onThemeChanged")
        s.observeField("action", "onSettingsAction")
        push(s)
    else if a.id = "search"
        s = createObject("roSGNode", "SearchScreen")
        s.server = m.server
        s.observeField("action", "onHomeAction")
        push(s)
    end if
end sub

' Movies, episodes, series and videos open their details; whole libraries come in a later update
sub openItem(a as object)
    t = a.itemType
    if t = "Playlist"
        showNotice(a.title, "Playlists come in a later update.")
        return
    end if
    ' (v1.1) a genre or studio pill on a details page: its titles across the libraries, as a library page
    if t = "Genre" or t = "Studio"
        ' (BG-8) that genre's / studio's page is already open further down: back to it
        at = stackIndexOf("library", NavUtil.tagPageKey(t, Util.toText(a.itemId), Util.toText(a.title)))
        if at >= 0
            backTo(at)
            return
        end if
        l = createObject("roSGNode", "LibraryScreen")
        l.server = m.server
        l.observeField("action", "onHomeAction")
        push(l)
        l.library = { id: "", title: Util.toText(a.title), itemType: t, collectionType: "", feed: "tag", tagKind: t, tagId: Util.toText(a.itemId), tagName: Util.toText(a.title), tagTypes: Util.toText(a.tagTypes) }
        return
    end if
    ' A library or folder: its titles as a grid (a collection / BoxSet has its own details page, as on the Mac)
    if t = "CollectionFolder" or t = "UserView" or t = "Folder"
        l = createObject("roSGNode", "LibraryScreen")
        l.server = m.server
        l.observeField("action", "onHomeAction")
        push(l)
        l.library = { id: a.itemId, title: a.title, itemType: t, collectionType: Util.toText(a.collectionType) }
        return
    end if
    ' a season: its series' page on that season (seriesId from the item, when known)
    if t = "Season"
        if Util.toText(a.seriesId) = ""
            ' (lists don't carry the series: ask the server, then come back here)
            rid = nextReqId()
            m.seasonPending = { id: rid, screen: top() }
            request("GET", m.server, "/Users/" + Util.toText(m.server.userId) + "/Items/" + Util.toText(a.itemId), true, "", { kind: "seasonOpen", reqId: rid })
            return
        end if
        a = { itemId: a.seriesId, itemType: "Series", title: Util.toText(a.seriesName), seasonId: a.itemId }
        t = "Series"
    end if
    ' an actor / director: their page
    if t = "Person"
        ' (SC-11) their page is already open further down (Cast -> Person -> title -> Cast...): back to it
        at = stackIndexOf("person", Util.toText(a.itemId))
        if at >= 0
            backTo(at)
            return
        end if
        ps = createObject("roSGNode", "PersonScreen")
        ps.server = m.server
        ps.observeField("action", "onHomeAction")
        push(ps)
        ps.person = { id: a.itemId, name: a.title }
        return
    end if
    ' (SC-11) the title is already open further down (Go to Series from an episode of it, More Like This
    ' loops): back to that page, on the season asked for
    at = stackIndexOf("details", Util.toText(a.itemId))
    if at >= 0
        backTo(at)
        if Util.toText(a.seasonId) <> "" then m.stack[at].openSeason = Util.toText(a.seasonId)
        return
    end if
    d = createObject("roSGNode", "DetailsScreen")
    d.server = m.server
    d.observeField("play", "onPlay")
    d.observeField("changed", "onDetailsChanged")
    d.observeField("openItem", "onDetailsOpen")
    push(d)
    if a.seasonId <> invalid then d.seasonId = a.seasonId
    d.itemId = a.itemId
end sub

' (SC-11) Where a details / person page for this id is in the stack, or -1
function stackIndexOf(kind as string, id as string) as integer
    if id = "" then return -1
    for i = m.stack.count() - 1 to 0 step -1
        s = m.stack[i]
        if s.screenId = kind
            lib = invalid
            if kind = "library" then lib = s.library
            per = invalid
            if kind = "person" then per = s.person
            itemKey = invalid
            if kind = "details" then itemKey = s.itemId
            if NavUtil.pageKey(kind, itemKey, per, lib) = id then return i
        end if
    end for
    return -1
end function

' Closes the screens above index (no rebuild: they are pages opened from the one kept)
sub backTo(index as integer)
    if index < 0 or index >= m.stack.count() then return
    if index = m.stack.count() - 1 then return
    while m.stack.count() - 1 > index
        dropTop()
    end while
    t = m.stack.peek()
    t.visible = true
    t.setFocus(true)
end sub

' (SC-11) At most maxScreens screens: the oldest page above Home goes first (it only costs a Back step)
sub capStack()
    maxScreens = 12
    while m.stack.count() >= maxScreens
        kinds = []
        for each sc in m.stack
            kinds.push(Util.toText(sc.screenId))
        end for
        i = NavUtil.capDropIndex(kinds, maxScreens)
        if i < 0 then return
        old = m.stack[i]
        m.stack.delete(i)
        m.screens.removeChild(old)
        detachScreen(old)
        print "Cove: closed the oldest page ("; kinds[i]; "), "; m.stack.count(); " screens open"
    end while
end sub

' More Like This: open that title on top
sub onDetailsOpen(ev as object)
    if not isTopScreen(ev.getRoSGNode())
        print "Cove: ignored a late page from a details page that is no longer on top"
        return
    end if
    a = ev.getData()
    ' (v1.1 U-1: the Play key on a More Like This / collection card)
    if Util.toText(a.id) = "quickplay"
        playFromCard(a)
        return
    end if
    openItem(a)
end sub

' A favourite changed: the home rows reload when we get back there
sub onDetailsChanged(ev as object)
    markStale(ev.getRoSGNode())
end sub

' Something was played or changed on Details: Home and the library pages under it (Favorites, Recently Added,
' a library with its progress bars and watched checks) reload when they are shown again
' (SC-1) Every page that shows progress or watched / favourite state, at any depth: details pages lower in
' the stack, person and search results too. except: the page that made the change (it is up to date).
sub markStale(except = invalid as dynamic)
    m.homeStale = true
    for each s in m.stack
        k = s.screenId
        if k = "library" or k = "favorites" or k = "details" or k = "person" or k = "search"
            if except = invalid or not s.isSameNode(except) then s.stale = true
        end if
    end for
end sub

sub onPlay(ev as object)
    ' (SC-3: Play All / Shuffle answering after Back)
    if not isTopScreen(ev.getRoSGNode())
        print "Cove: ignored a late play from a details page that is no longer on top"
        return
    end if
    startPlayer(ev.getData())
end sub

sub startPlayer(item as object)
    ' (v1.0 F-10) Settings → Playback → Cinema Mode: the server's intros first, for a title started from the
    ' beginning (not a trailer / extra, not a Shuffle queue); the server decides which titles get intros
    if Prefs.cinemaMode() and m.server <> invalid and not Util.flag(item, "trailer") and type(item.queue) <> "roArray" and Util.toNumber(item.start) <= 0
        ' (SC-4) a second OK while the intros are asked for would open a second player: wait for the answer
        ' (at most 15 s, so a lost answer doesn't block Play)
        if m.introsPending <> invalid and nowSecs() - m.introsPending.at < 15
            print "Cove: cinema mode: still waiting for the intros"
            return
        end if
        rid = nextReqId()
        m.introsPending = { id: rid, screen: top(), at: nowSecs() }
        m.top.toast = { text: "Getting the intros...", icon: "" }
        ' (v1.1.1 SP-11) straight to the route that answered before on this server
        if Api.knownRoute(m.server, "intros") = "new"
            request("GET", m.server, "/Items/" + Util.toText(item.id) + "/Intros?userId=" + Util.toText(m.server.userId), true, "", { kind: "intros", item: item, newRoute: true, reqId: rid })
        else
            request("GET", m.server, "/Users/" + Util.toText(m.server.userId) + "/Items/" + Util.toText(item.id) + "/Intros", true, "", { kind: "intros", item: item, newRoute: false, reqId: rid })
        end if
        return
    end if
    openPlayer(item)
end sub

' ---------------------------------------------------------------- Play key on a card (v1.1 U-1)

' The Play key on a focused card anywhere: a movie / episode plays from its resume point, a series its next up
' (else its first unwatched episode), a season its first unwatched episode, a collection its first unwatched
' film. The title is asked for first, so the rating limit and the resume point are the server's current ones;
' playback goes through startPlayer (Cinema Mode). The answer is dropped when the page that asked is covered.
sub playFromCard(a as object)
    if m.server = invalid then return
    id = Util.toText(a.itemId)
    if not Util.isSafeId(id, false) or QuickPlay.playKind(Util.toText(a.itemType)) = "" then return
    ' (a second press while the first is looked up: wait for it, at most 10 s)
    if m.quickPending <> invalid and nowSecs() - m.quickPending.at < 10
        print "Cove: play key: still looking up the last one"
        return
    end if
    rid = nextReqId()
    m.quickPending = { id: rid, screen: top(), at: nowSecs(), title: Util.toText(a.title) }
    print "Cove: play key on "; Util.toText(a.itemType); " "; id
    request("GET", m.server, "/Users/" + Util.toText(m.server.userId) + "/Items/" + id, true, "", { kind: "qpItem", reqId: rid })
end sub

' The answer still belongs to the last Play press, from the page on top (else it is dropped)
function quickCurrent(r as object) as boolean
    p = m.quickPending
    if p = invalid or Util.toNumber(Util.field(r.tag, "reqId")) <> p.id
        print "Cove: ignored an old play key answer"
        return false
    end if
    if not isTopScreen(p.screen)
        m.quickPending = invalid
        print "Cove: dropped the play key answer: the page that asked is no longer on top"
        return false
    end if
    return true
end function

sub quickFailed(text as string)
    m.quickPending = invalid
    m.top.toast = { text: text, icon: "info" }
end sub

sub onQuickItem(r as object)
    if not quickCurrent(r) then return
    if r.code <> 200 or not Util.isAA(r.json)
        quickFailed("Couldn't start this title. Please try again.")
        return
    end if
    it = r.json
    if Ratings.seriesUnknown(m.server, it)
        ' (an unrated episode under a limit: its series' rating decides, as for deep links)
        sid = Util.toText(it.SeriesId)
        request("GET", m.server, Ratings.seriesPath(m.server, [sid]), true, "", { kind: "qpSeries", reqId: m.quickPending.id, seriesId: sid, item: it })
        return
    end if
    quickRated(it)
end sub

sub quickRated(it as object)
    if not Ratings.allowed(m.server, it)
        quickFailed("This title is above this profile's rating limit")
        return
    end if
    ' (v1.1) an episode that hasn't aired yet has nothing to play
    if QuickPlay.isUnaired(it, QuickPlay.nowStamp())
        quickFailed("This episode hasn't aired yet")
        return
    end if
    k = QuickPlay.playKind(Util.toText(it.Type))
    uid = Util.toText(m.server.userId)
    rid = m.quickPending.id
    id = Util.toText(it.Id)
    if k = "play"
        quickStart(it)
    else if k = "series"
        ' (its unrated episodes inherit this rating: keep it for Ratings.keep below)
        Ratings.rememberSeries(m.server, [id], [it])
        ' (BG-5) Include rewatching (Jellyfin), as Home's Next Up row; no date cutoff here
        nuq = HomeLayout.nextUpQuery(Servers.isJellyfin(m.server), Prefs.nextUpRewatch(), "")
        request("GET", m.server, "/Shows/NextUp?SeriesId=" + id + "&UserId=" + uid + "&Limit=1" + nuq + "&Fields=OfficialRating&EnableUserData=true", true, "", { kind: "qpList", phase: "nextUp", reqId: rid, seriesId: id })
    else if k = "season"
        sid = Util.toText(it.SeriesId)
        if sid = ""
            quickFailed("Couldn't find this season's episodes")
            return
        end if
        if Ratings.limitOf(m.server) > 0 and Ratings.cachedSeries(m.server, sid) = invalid
            ' (a season with its own rating: the series' rating, for its unrated episodes, first)
            request("GET", m.server, Ratings.seriesPath(m.server, [sid]), true, "", { kind: "qpSeries", reqId: rid, seriesId: sid, item: it })
            return
        end if
        request("GET", m.server, "/Shows/" + sid + "/Episodes?SeasonId=" + id + "&UserId=" + uid + "&Fields=OfficialRating&EnableUserData=true", true, "", { kind: "qpList", phase: "episodes", reqId: rid })
    else if k = "box"
        request("GET", m.server, Ratings.withLimit(m.server, "/Users/" + uid + "/Items?ParentId=" + id + "&SortBy=PremiereDate,ProductionYear,SortName&SortOrder=Ascending&Fields=OfficialRating&EnableUserData=true"), true, "", { kind: "qpList", phase: "box", reqId: rid })
    else
        quickFailed("Nothing to play here")
    end if
end sub

' Next Up / a season's episodes / a collection's titles: pick one and play it
sub onQuickList(r as object)
    if not quickCurrent(r) then return
    if r.code <> 200
        quickFailed("Couldn't start this title. Please try again.")
        return
    end if
    src = r.json
    if Util.isAA(src) then src = src.Items
    list = Ratings.keep(m.server, src)
    phase = Util.toText(r.tag.phase)
    pick = invalid
    if phase = "nextUp"
        if list.count() > 0 and not QuickPlay.isUnaired(list[0], QuickPlay.nowStamp()) then pick = list[0]
        if pick = invalid
            ' (not started, or all watched: the first unwatched episode of the whole series)
            request("GET", m.server, "/Shows/" + Util.toText(r.tag.seriesId) + "/Episodes?UserId=" + Util.toText(m.server.userId) + "&Fields=OfficialRating&EnableUserData=true", true, "", { kind: "qpList", phase: "episodes", reqId: m.quickPending.id })
            return
        end if
    else if phase = "box"
        pick = QuickPlay.pickTitle(list)
    else
        pick = QuickPlay.pickEpisode(list, QuickPlay.nowStamp())
    end if
    if pick = invalid
        quickFailed("Nothing to play here")
        return
    end if
    quickStart(pick)
end sub

sub quickStart(it as object)
    m.quickPending = invalid
    item = QuickPlay.playerItem(it)
    print "Cove: play key starts "; item.id; " at "; item.start
    startPlayer(item)
end sub

' The intros answer: the first intro plays with the rest and the film behind it (PlayerScreen.playAfterIntro)
sub onIntros(r as object)
    item = r.tag.item
    ' (SC-3 / SC-4) only the answer to the last request, and only while the page that asked is still on top
    p = m.introsPending
    if p = invalid or Util.toNumber(r.tag.reqId) <> p.id
        print "Cove: ignored an old intros answer"
        return
    end if
    if not isTopScreen(p.screen)
        m.introsPending = invalid
        print "Cove: dropped the intros answer: the page that asked was closed"
        return
    end if
    if (r.code = 404 or r.code = 405) and not Util.flag(r.tag, "newRoute")
        ' (Jellyfin 10.9+ route)
        request("GET", m.server, "/Items/" + Util.toText(item.id) + "/Intros?userId=" + Util.toText(m.server.userId), true, "", { kind: "intros", item: item, newRoute: true, reqId: p.id })
        return
    end if
    m.introsPending = invalid
    list = []
    if r.code = 200 then Api.rememberRoute(m.server, "intros", Util.flag(r.tag, "newRoute"))
    if r.code = 200
        src = r.json
        if Util.isAA(src) then src = src.Items
        for each it in Ratings.keep(m.server, src)
            if Util.isAA(it) and Util.isSafeId(it.Id, false) and list.count() < 5 then list.push({ id: Util.toText(it.Id), subtitle: Util.toText(it.Name) })
        end for
    end if
    print "Cove: cinema mode intros -> "; r.code; " "; list.count()
    if list.count() = 0
        openPlayer(item)
        return
    end if
    first = list.shift()
    sub_ = "Intro"
    if first.subtitle <> "" then sub_ = "Intro  ·  " + first.subtitle
    openPlayer({ id: first.id, title: Util.toText(item.title), subtitle: sub_, start: 0.0, trailer: true, after: item, intros: list })
end sub

sub openPlayer(item as object)
    p = createObject("roSGNode", "PlayerScreen")
    p.server = m.server
    p.observeField("done", "onPlayerDone")
    push(p)
    p.item = item
end sub

' Back from the player: refresh the details (new resume point) and, later, the home rows
sub onPlayerDone(ev as object)
    ' (before pop: a Home or library page right under the player reloads as it is shown)
    markStale()
    seriesId = Util.toText(ev.getRoSGNode().openSeries)
    ' (SC-1: the page under the player, and every page under it, reload as they are shown: "stale")
    pop()
    t = top()
    ' "Back to the series" (Are you still watching?): its page, unless it is the one under the player
    if seriesId <> "" and not (t <> invalid and t.screenId = "details" and Util.toText(t.itemId) = seriesId) then openItem({ itemId: seriesId, itemType: "Series", title: "" })
end sub

sub showNotice(title as string, text as string)
    d = createObject("roSGNode", "StandardMessageDialog")
    d.title = title
    d.message = [text]
    d.buttons = ["OK"]
    d.observeField("buttonSelected", "onNoticeButton")
    d.observeField("wasClosed", "onDialogClosed")
    m.top.dialog = d
end sub

sub onNoticeButton()
    closeDialog()
end sub

' ---------------------------------------------------------------- user actions

sub onSelected(ev as object)
    s = ev.getRoSGNode()
    id = ev.getData().id
    if s.screenId = "servers" or s.screenId = "address"
        ' (C2-1) while a limited profile is or was active: a parent PIN before adding or opening another server
        ' (its own server, and Search again, stay open, so a child can get back after "Couldn't reach")
        if lockServer() <> invalid and id <> "rescan" and id <> "srv:" + Util.toText(m.lock.serverId)
            guardedAct(invalid, { do: "listPick", id: id })
            return
        end if
        listPick(id)
    else if s.screenId = "signin"
        if id = "manual"
            askText("username", "Username", "Your username on " + Util.toText(m.server.name), "", false)
        else if id = "quick"
            startQuickConnect()
        else if id = "cancelqc"
            stopQuickConnect()
            showSignInItems("")
        else if id.startsWith("user:")
            u = m.users[id.mid(5).toInt()]
            if not Util.isAA(u) then return
            m.pendingUser = Util.toText(u.Name)
            ' (Jellyfin 12 no longer fills in HasPassword: it is always true there, so the keyboard takes an empty
            ' entry; when it says false and the empty password is refused, onSignIn asks for one)
            m.emptyTry = ""
            if Util.flag(u, "HasPassword")
                askText("password", "Password", "Password for " + m.pendingUser + " (leave empty if none)", "", true)
            else
                m.emptyTry = m.pendingUser
                signIn(m.pendingUser, "")
            end if
        end if
    else if s.screenId = "connecting"
        if id = "retry"
            validate(m.server)
        else if id = "servers"
            showServers("")
        end if
    end if
end sub

' A choice on the server list or Add a server
sub listPick(id as string)
    if id = "enter" or (id = "add" and Servers.all().count() = 0)
        askAddress()
    else if id = "add"
        showAddServer()
    else if id = "rescan"
        m.found = []
        startDiscovery()
        refreshFound()
    else if id.startsWith("found:")
        pickFound(id.mid(6).toInt())
    else if id.startsWith("srv:")
        openServer(Servers.find(id.mid(4)))
    end if
end sub

sub onOptions(ev as object)
    s = ev.getRoSGNode()
    id = ev.getData().id
    if s.screenId = "servers" and id.startsWith("srv:")
        ' (C2-1: Remove forgets every profile, PIN and rating limit of that server: a parent PIN first)
        if lockServer() <> invalid
            guardedAct(invalid, { do: "askRemove", serverId: id.mid(4) })
            return
        end if
        askRemove(id.mid(4))
    end if
end sub

sub askRemove(serverId as string)
    srv = Servers.find(serverId)
    if srv = invalid or not topIs("servers") then return
    m.removeId = Util.toText(srv.id)
    d = createObject("roSGNode", "StandardMessageDialog")
    d.title = "Remove " + Util.toText(srv.name) + "?"
    d.message = ["Cove forgets this server and its sign-in. You can add it again any time."]
    d.buttons = ["Remove", "Cancel"]
    d.observeField("buttonSelected", "onRemoveButton")
    d.observeField("wasClosed", "onDialogClosed")
    m.top.dialog = d
end sub

sub onRemoveButton()
    remove = m.top.dialog.buttonSelected = 0
    closeDialog()
    if remove
        ' end the sessions of all its profiles on the server too (best effort, nothing waits for them)
        for each us in Servers.sessions(Servers.find(m.removeId))
            request("POST", us, "/Sessions/Logout", true, "", { kind: "logout" })
        end for
        ' (SC-5) another server than the one on Home, from the list opened over Home: Home stays under it
        keepStack = m.homeReady and m.server <> invalid and Util.toText(m.server.id) <> m.removeId and topIs("servers") and m.stack.count() > 1
        Servers.forgetAll(m.removeId)
        Servers.remove(m.removeId)
        if keepStack
            dropTop()
            showServers("Server removed.", true)
        else
            showServers("Server removed.")
        end if
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if key = "back" and m.stack.count() > 1
        stopQuickConnect()
        pop()
        return true
    end if
    return false
end function

' ---------------------------------------------------------------- keyboard

sub askText(purpose as string, title as string, message as string, text as string, secure as boolean)
    m.keyboardFor = purpose
    d = createObject("roSGNode", "StandardKeyboardDialog")
    d.title = title
    d.message = [message]
    d.text = text
    d.buttons = ["OK", "Cancel"]
    if secure
        if d.hasField("keyboardDomain") then d.keyboardDomain = "password"
        if d.hasField("textEditBox") and d.textEditBox <> invalid then d.textEditBox.secureMode = true
    end if
    d.observeField("buttonSelected", "onKeyboardButton")
    d.observeField("wasClosed", "onDialogClosed")
    m.top.dialog = d
    d.setFocus(true)
end sub

' Opening a keyboard while the previous one is still closing leaves the new one on screen without focus
' (the closing dialog hands focus back to the page), so the user can't type. Wait until it has gone.
sub askTextLater(purpose as string, title as string, message as string, text as string, secure as boolean)
    m.nextAsk = { purpose: purpose, title: title, message: message, text: text, secure: secure }
    m.dialogTimer.control = "start"
end sub

sub onDialogTimer()
    a = m.nextAsk
    m.nextAsk = invalid
    if a <> invalid then askText(a.purpose, a.title, a.message, a.text, a.secure)
end sub

sub onKeyboardButton()
    d = m.top.dialog
    ok = d.buttonSelected = 0
    text = Util.toText(d.text).trim()
    closeDialog()
    if not ok then return
    if m.keyboardFor = "address"
        if text <> "" then startProbe(Util.urlCandidates(text), text)
    else if m.keyboardFor = "username"
        if text = "" then return
        m.pendingUser = text
        askTextLater("password", "Password", "Password for " + text + " (leave empty if none)", "", true)
    else if m.keyboardFor = "password"
        m.emptyTry = ""
        signIn(m.pendingUser, text)
    end if
end sub

' Back pressed on a dialog. Only the dialog still on screen counts, because a dialog that was just closed
' must not close the next one (username → password).
sub onDialogClosed(ev as object)
    d = ev.getRoSGNode()
    if m.top.dialog <> invalid and d.isSameNode(m.top.dialog) then closeDialog()
end sub

' Stop listening to the dialog before closing it, so its late "wasClosed" can't reach the next dialog
sub closeDialog()
    d = m.top.dialog
    if d <> invalid
        d.unobserveField("buttonSelected")
        d.unobserveField("wasClosed")
        d.close = true
    end if
    t = top()
    if t <> invalid then t.setFocus(true)
end sub

' ---------------------------------------------------------------- requests

sub request(method as string, server as object, path as string, withToken as boolean, body as string, tag as object)
    t = createObject("roSGNode", "ApiTask")
    t.request = { method: method, url: Util.toText(server.url) + path, headers: Api.headers(server, withToken), body: body, tag: tag }
    t.observeField("response", "onResponse")
    m.pending.push(t)
    t.control = "RUN"
end sub

sub onResponse(ev as object)
    t = ev.getRoSGNode()
    for i = 0 to m.pending.count() - 1
        if m.pending[i].isSameNode(t)
            m.pending.delete(i)
            exit for
        end if
    end for
    r = ev.getData()
    ' (an answer of an unexpected shape must give a message, not stop the app)
    try
        dispatchResponse(r)
    catch e
        where = ""
        if e.backtrace <> invalid and e.backtrace.count() > 0
            f = e.backtrace[e.backtrace.count() - 1]
            where = " at " + Util.toText(f.filename).replace("pkg:/", "") + ":" + Util.toText(f.line_number)
        end if
        print "Cove: couldn't handle a server answer: "; Util.redact(Util.toText(e.message)); where
        showNotice("Unexpected answer", "The server sent an answer Cove couldn't read. Please try again.")
    end try
end sub

sub dispatchResponse(r as object)
    kind = Util.toText(Util.field(r.tag, "kind"))
    if kind = "probe"
        onProbe(r)
    else if (kind = "users" or kind = "qcEnabled") and (m.server = invalid or Util.toText(r.tag.serverId) <> Util.toText(m.server.id))
        print "Cove: ignored a sign-in answer from another server"
    else if kind = "users"
        onUsers(r)
    else if kind = "qcEnabled"
        m.quickConnect = r.code = 200 and Util.flag({ v: r.value }, "v")
        showSignInItems("")
    else if kind = "signin" and (m.server = invalid or Util.toText(r.tag.serverId) <> Util.toText(m.server.id) or not topIs("signin"))
        ' (C2-5: Back and another server picked meanwhile: its token must not be saved under, or sent to, that one)
        print "Cove: ignored a sign-in answer for another server or a closed sign-in"
    else if kind = "signin"
        onSignIn(r)
    else if kind = "validate"
        onValidate(r)
    else if kind = "deeplinkSeries"
        ' (v0.9.1) the series' rating of an unrated episode from a deep link
        if m.server <> invalid and Util.toText(r.tag.serverId) = Util.toText(m.server.id)
            if r.code = 200
                Ratings.rememberSeries(m.server, [Util.toText(r.tag.seriesId)], r.json)
                onDeepLinkItem(r.tag.link)
            else
                showNotice("Not available", "Cove couldn't check this title's rating. Please try again.")
            end if
        end if
    else if kind = "deeplink"
        onDeepLinkItem(r)
    else if kind = "seasonOpen"
        ' (SC-3) dropped when the page with the season card was closed or covered meanwhile
        p = m.seasonPending
        if p = invalid or Util.toNumber(r.tag.reqId) <> p.id or not isTopScreen(p.screen)
            print "Cove: ignored a late season answer"
            return
        end if
        m.seasonPending = invalid
        if r.code = 200 and Util.isAA(r.json) and Util.toText(r.json.SeriesId) <> ""
            openItem({ itemId: Util.toText(r.json.Id), itemType: "Season", seriesId: Util.toText(r.json.SeriesId), seriesName: Util.toText(r.json.SeriesName), title: Util.toText(r.json.Name) })
        end if
    else if kind = "resumeCheck"
        onResumeCheck(r)
    else if kind = "intros"
        onIntros(r)
    else if kind = "qpItem"
        onQuickItem(r)
    else if kind = "qpSeries"
        ' (v1.1 U-1) the series' rating of an unrated episode, for the Play key
        if quickCurrent(r)
            if r.code = 200
                Ratings.rememberSeries(m.server, [Util.toText(r.tag.seriesId)], r.json)
                quickRated(r.tag.item)
            else
                quickFailed("Couldn't check this title's rating. Please try again.")
            end if
        end if
    else if kind = "qpList"
        onQuickList(r)
    else if kind = "logout"
        print "Cove: signed out of the removed server -> "; r.code
    end if
end sub

' ---------------------------------------------------------------- add a server

' (C2-10) A new probe: the answers of the one before are dropped
sub startProbe(candidates as object, typed as string)
    m.probeGen = m.probeGen + 1
    probe(candidates, 0, typed)
end sub

' Tries the typed address as https / http / :8096 until one answers like an Emby or Jellyfin server
sub probe(candidates as object, index as integer, typed as string)
    if index >= candidates.count()
        probeStatus("Couldn't find an Emby or Jellyfin server at " + typed + ". Check the address and that the server is running.")
        return
    end if
    probeStatus("Looking for the server at " + candidates[index] + "...")
    request("GET", { url: candidates[index], type: "emby" }, "/System/Info/Public", false, "", { kind: "probe", candidates: candidates, index: index, typed: typed, gen: m.probeGen })
end sub

' (the server list, or Add a server when the address was typed or picked there)
sub probeStatus(text as string)
    setStatus("servers", text)
    setStatus("address", text)
end sub

sub onProbe(r as object)
    ' (C2-10: a newer probe started, or the list it came from has gone: it must not open a server over another screen)
    if Util.toNumber(r.tag.gen) <> m.probeGen or not (topIs("servers") or topIs("address"))
        print "Cove: ignored the answer of an earlier server probe"
        return
    end if
    j = r.json
    if r.code = 200 and j <> invalid and GetInterface(j, "ifAssociativeArray") <> invalid and Util.toText(j.Id) <> ""
        url = r.tag.candidates[r.tag.index]
        kind = "emby"
        if LCase(Util.toText(j.ProductName)).instr("jellyfin") >= 0 then kind = "jellyfin"
        srv = Servers.find(Util.toText(j.Id))
        if srv = invalid then srv = { id: Util.toText(j.Id), userId: "", userName: "", token: "" }
        srv.name = Util.toText(j.ServerName)
        srv.url = url
        srv.type = kind
        srv.version = Util.toText(j.Version)
        ' plain http outside the home network: say so before anything (the password) is sent
        if Util.isPlainRemote(url)
            m.plainServer = srv
            d = createObject("roSGNode", "StandardMessageDialog")
            d.title = "This connection isn't encrypted"
            d.message = [Util.hostOf(url) + " uses plain http and isn't on your home network, so your password and your sign-in can be read by anyone on the networks in between (for example public Wi-Fi).", "If the server has an https address, use that instead."]
            d.buttons = ["Cancel", "Continue Anyway"]
            d.observeField("buttonSelected", "onPlainButton")
            d.observeField("wasClosed", "onDialogClosed")
            m.top.dialog = d
            return
        end if
        addProbed(srv)
    else
        probe(r.tag.candidates, r.tag.index + 1, r.tag.typed)
    end if
end sub

sub onPlainButton()
    proceed = m.top.dialog.buttonSelected = 1
    srv = m.plainServer
    m.plainServer = invalid
    closeDialog()
    if not proceed or srv = invalid
        probeStatus("Not added. Use the server's https address if it has one.")
        return
    end if
    addProbed(srv)
end sub

' Saves the server that answered and opens it. A saved sign-in stays with the address it was made on: the
' server id is public (any host can answer /System/Info/Public with it), so a known id at a new address
' (another host or port, or http instead of https) must not get the saved token. Sign in again there; the
' old session is ended at the old address, where the token belongs (best effort).
sub addProbed(srv as object)
    prev = Servers.find(Util.toText(srv.id))
    if prev <> invalid and Util.originOf(Util.toText(prev.url)) <> Util.originOf(Util.toText(srv.url))
        ' (every profile's sign-in: Servers.upsert clears their tokens, the profiles stay to sign in again)
        for each us in Servers.sessions(prev)
            print "Cove: known server at a new address: the saved sign-in is not reused"
            request("POST", us, "/Sessions/Logout", true, "", { kind: "logout" })
        end for
        srv.token = ""
        srv.userId = ""
    end if
    Servers.upsert(srv)
    openServer(srv)
end sub

' ---------------------------------------------------------------- sign in

sub openServer(server as dynamic)
    if server = invalid then return
    ' (several profiles, or the last one used has a PIN: Who's watching? asks for it)
    if Servers.profiles(server).count() >= 2 or Servers.pinOf(server, Util.toText(server.userId)) <> ""
        showWho(server, "", topIs("servers"))
    else if isOnHome(server)
        ' (SC-5) the server already on Home, picked from the list opened over it: just go back
        backToHome()
    else if Util.toText(server.token) <> ""
        validate(server)
    else
        openSignIn(server, "")
    end if
end sub

' The server (and its profile) is the one on Home, signed in
function isOnHome(server as object) as boolean
    if not m.homeReady or m.server = invalid or Util.toText(m.server.token) = "" then return false
    return Util.toText(m.server.id) = Util.toText(server.id) and Util.toText(m.server.userId) = Util.toText(server.userId)
end function

sub backToHome()
    while m.stack.count() > 1 and not topIs("home")
        pop()
    end while
end sub

sub openSignIn(server as object, status as string)
    m.server = server
    m.users = []
    m.quickConnect = false
    line = Servers.typeName(server) + " " + Util.toText(server.version) + "   ·   " + Util.toText(server.url)
    if Util.isPlainHttp(Util.toText(server.url)) then line = line + "   ·   Not encrypted"
    sc = newMenu("signin", "Sign in to " + Util.toText(server.name), line, [{ id: "manual", label: "Enter Username and Password..." }])
    if status = "" and Util.isPlainRemote(Util.toText(server.url)) then status = "This connection isn't encrypted: your password can be read on the networks in between."
    sc.status = status
    if topIs("servers") or topIs("profiles") or topIs("settings")
        ' (Back returns to the list / Who's watching? / Settings it came from)
        push(sc)
    else
        ' (from "connecting" or home: start from the server list so Back goes there)
        showServers("")
        push(sc)
    end if
    ' (tagged with the server: a slow answer from the server opened before must not fill this list)
    sid = Util.toText(server.id)
    request("GET", server, "/Users/Public", false, "", { kind: "users", serverId: sid })
    if Servers.isJellyfin(server) then request("GET", server, "/QuickConnect/Enabled", false, "", { kind: "qcEnabled", serverId: sid })
end sub

sub onUsers(r as object)
    if r.code = 200 and type(r.json) = "roArray" then m.users = r.json
    showSignInItems("")
end sub

' The sign-in menu: the server's visible users, manual entry, Quick Connect (Jellyfin)
sub showSignInItems(status as string)
    if not topIs("signin") then return
    items = []
    for i = 0 to m.users.count() - 1
        if Util.isAA(m.users[i]) then items.push({ id: "user:" + i.toStr(), label: Util.toText(m.users[i].Name) })
    end for
    items.push({ id: "manual", label: "Enter Username and Password..." })
    if m.quickConnect then items.push({ id: "quick", label: "Quick Connect (approve from another Jellyfin app)" })
    t = top()
    t.code = ""
    t.items = items
    if status <> "" then t.status = status
end sub

sub signIn(name as string, password as string)
    setStatus("signin", "Signing in as " + name + "...")
    request("POST", m.server, "/Users/AuthenticateByName", false, Api.credentialsBody(name, password), { kind: "signin", serverId: Util.toText(m.server.id) })
end sub

sub onSignIn(r as object)
    if r.code = 200 and Util.isAA(r.json) and Util.toText(r.json.AccessToken) <> ""
        signedIn(r.json)
    else if r.code = 401 and Util.toText(m.emptyTry) <> "" and Util.toText(m.emptyTry) = Util.toText(m.pendingUser) and topIs("signin")
        ' a user tile tried without a password and the server wants one: ask for it instead of failing
        m.emptyTry = ""
        setStatus("signin", "Enter the password for " + m.pendingUser + ".")
        askTextLater("password", "Password", "Password for " + m.pendingUser, "", true)
    else if r.code = 401
        m.emptyTry = ""
        setStatus("signin", "Wrong username or password.")
    else
        setStatus("signin", "Sign-in failed. " + Api.describeFailure(r))
    end if
end sub

' Successful sign-in (password or Quick Connect): save it and go home
sub signedIn(auth as object)
    ' (C2-1) the sign-in screen under a limited profile (an expired sign-in): signing in as anyone else, or on
    ' another server, could lift the limit, so it waits for a parent PIN
    uid = Util.toText(Util.field(Util.field(auth, "User"), "Id"))
    if m.server <> invalid and lockServer() <> invalid and not (Util.toText(m.server.id) = Util.toText(m.lock.serverId) and uid = Util.toText(m.lock.userId))
        m.heldAuth = { auth: auth, serverId: Util.toText(m.server.id) }
        setStatus("signin", "A parent PIN is needed to sign in as another profile.")
        guardedAct(invalid, { do: "heldSignIn" })
        return
    end if
    saveSignIn(auth)
end sub

sub saveSignIn(auth as object)
    s = m.server
    s.token = Util.toText(Util.field(auth, "AccessToken"))
    if Util.isAA(Util.field(auth, "User"))
        s.userId = Util.toText(auth.User.Id)
        s.userName = Util.toText(auth.User.Name)
        ' (the profile picture, for Who's watching?)
        s.avatar = Util.toText(auth.User.PrimaryImageTag)
    end if
    Servers.upsert(s)
    showHome(s)
end sub

' ---------------------------------------------------------------- Quick Connect (Jellyfin)

sub startQuickConnect()
    stopQuickConnect()
    t = top()
    t.items = [{ id: "cancelqc", label: "Cancel" }]
    t.status = "Getting a code..."
    m.qcTask = createObject("roSGNode", "QuickConnectTask")
    m.qcTask.server = m.server
    m.qcTask.observeField("code", "onQcCode")
    m.qcTask.observeField("result", "onQcResult")
    m.qcTask.observeField("error", "onQcError")
    m.qcTask.control = "RUN"
end sub

sub stopQuickConnect()
    if m.qcTask <> invalid
        m.qcTask.unobserveField("code")
        m.qcTask.unobserveField("result")
        m.qcTask.unobserveField("error")
        m.qcTask.cancel = true
        m.qcTask = invalid
    end if
end sub

sub onQcCode()
    if not topIs("signin") or m.qcTask = invalid then return
    t = top()
    t.code = m.qcTask.code
    t.status = "In another signed-in Jellyfin app: Settings → Quick Connect, enter this code."
end sub

sub onQcResult()
    if m.qcTask = invalid then return
    auth = m.qcTask.result
    stopQuickConnect()
    signedIn(auth)
end sub

sub onQcError()
    if m.qcTask = invalid then return
    msg = m.qcTask.error
    stopQuickConnect()
    showSignInItems(msg)
end sub

' ---------------------------------------------------------------- saved sign-in

sub validate(server as object)
    m.server = server
    sc = newMenu("connecting", Util.toText(server.name), Servers.typeName(server) + "   ·   " + Util.toText(server.url), [])
    sc.status = "Connecting..."
    reset(sc)
    request("GET", server, "/Users/" + Util.toText(server.userId), true, "", { kind: "validate", serverId: Util.toText(server.id), userId: Util.toText(server.userId) })
end sub

sub onValidate(r as object)
    if not topIs("connecting") or m.server = invalid then return
    ' (C2-10: the answer for an earlier profile or server, after two quick switches)
    if Util.toText(r.tag.serverId) <> Util.toText(m.server.id) or Util.toText(r.tag.userId) <> Util.toText(m.server.userId) then return
    if r.code = 200
        ' (v1.1.1 SP-13a) the same user object the player would ask for: its audio preference, so the first
        ' play of the session skips that request
        Tracks.rememberServerAudio(m.server, r.json)
        showHome(m.server)
    else if r.code = 401 or r.code = 403
        ' (C2-12: a 404 is a proxy path change or a server still starting: "Couldn't reach" below, the token stays)
        ' The saved sign-in no longer works (password changed, device removed on the server)
        m.server.token = ""
        Servers.upsert(m.server)
        openSignIn(m.server, "Your sign-in has expired. Please sign in again.")
    else
        t = top()
        t.items = [
            { id: "retry", label: "Try Again" },
            { id: "servers", label: "Choose Another Server" }
        ]
        t.status = "Couldn't reach " + Util.toText(m.server.name) + ". " + Api.describeFailure(r)
        ' (R-10: the user has to choose here, so Roku's launch timing gets a dialog)
        dialogStarted()
    end if
end sub

' (SP-24) The device line from CapsTask: under Servers when that page shows no other status
sub onDeviceLine(ev as object)
    m.deviceLine = Util.toText(ev.getData())
    m.capsTask = invalid
    if topIs("servers")
        sc = top()
        if Util.toText(sc.status) = "" then sc.status = m.deviceLine
    end if
end sub

sub signOut()
    s = m.server
    if s = invalid then s = Servers.active()
    if s = invalid
        showServers("")
        return
    end if
    ' only this profile: the server's other profiles stay signed in
    if Util.toText(s.token) <> "" then request("POST", s, "/Sessions/Logout", true, "", { kind: "logout" })
    who = Util.toText(s.userName)
    Servers.removeUser(Util.toText(s.id), Util.toText(s.userId))
    rest = Servers.find(Util.toText(s.id))
    msg = "Signed out of " + Util.toText(s.name) + "."
    if who <> "" then msg = who + " signed out of " + Util.toText(s.name) + "."
    if rest <> invalid and Servers.sessions(rest).count() > 0
        m.server = rest
        afterSignOut(rest, msg)
        return
    end if
    Servers.setActive("")
    showServers(msg)
end sub

' Another profile is still signed in on that server: its list (Who's watching?), or the server list
sub afterSignOut(server as object, msg as string)
    showWho(server, msg, false)
end sub

' ---------------------------------------------------------------- profiles (Who's watching?)

' At start: the server has 2 or more profiles and Settings → Profiles → "Ask who's watching at start" is on
' (also, whatever that setting, when the last profile used has a PIN: it's asked before its Home opens)
function wantsWho(s as object) as boolean
    if Servers.pinOf(s, Util.toText(s.userId)) <> "" then return true
    return Servers.profiles(s).count() >= 2 and Servers.asksWho(s)
end function

' The profile picker for a server; asPush keeps the screen below (Back returns there)
sub showWho(server as object, status as string, asPush as boolean)
    if server = invalid
        showServers("")
        return
    end if
    srv = Servers.find(Util.toText(server.id))
    if srv = invalid then srv = server
    w = createObject("roSGNode", "ProfileScreen")
    w.observeField("chosen", "onWhoChosen")
    w.server = srv
    w.currentId = Util.toText(srv.userId)
    w.profiles = whoList(srv)
    if asPush
        push(w)
    else
        reset(w)
    end if
    w.status = status
end sub

function whoList(srv as object) as object
    out = []
    for each p in Servers.profiles(srv)
        note = ""
        if p.maxRating <> "" then note = "Up to " + p.maxRating
        if not p.signedIn then note = "Signed out"
        out.push({ id: p.id, name: p.name, avatar: avatarUrl(srv, p.id, p.avatar), hasPin: p.hasPin, signedIn: p.signedIn, note: note })
    end for
    return out
end function

' The user's picture on the server (public, no token in the address); "" without one
function avatarUrl(srv as object, userId as string, imageTag as string) as string
    if imageTag = "" or userId = "" then return ""
    base = Util.toText(srv.url)
    q = "?maxWidth=220&quality=90&tag=" + imageTag
    ' (Jellyfin 10.9 moved user pictures to /UserImage)
    v = Util.toText(srv.version).split(".")
    if Servers.isJellyfin(srv) and v.count() >= 2 and (v[0].toInt() > 10 or (v[0].toInt() = 10 and v[1].toInt() >= 9))
        return base + "/UserImage" + q + "&userId=" + userId
    end if
    return base + "/Users/" + userId + "/Images/Primary" + q
end function

sub onWhoChosen(ev as object)
    w = ev.getRoSGNode()
    id = Util.toText(ev.getData().id)
    srv = Servers.find(Util.toText(w.server.id))
    if srv = invalid
        showServers("")
        return
    end if
    ' (v0.9.1: adding a profile or leaving for another server, while the profile last used here has a rating
    ' limit: a parent PIN first)
    ' (C2-6: whenever a profile on this server has a limit and a parent PIN exists, whoever was last used)
    if id = "add"
        pickerGuard(srv, { do: "addProfile", serverId: Util.toText(srv.id) })
    else if id = "servers"
        pickerGuard(srv, { do: "servers" })
    else
        chooseProfile(srv, id)
    end if
end sub

' A profile was picked (Who's watching?, Settings): its PIN first when it has one, then switch
sub chooseProfile(srv as object, userId as string)
    sid = Util.toText(srv.id)
    onHome = m.server <> invalid and m.homeReady and Util.toText(m.server.id) = sid and Util.toText(m.server.userId) = userId
    if Servers.pinOf(srv, userId) = "" or onHome
        ' (C2-13) from a limited profile to one without a limit and without a PIN: a parent PIN first, otherwise
        ' that profile lifts the limit with one press (only when a parent PIN exists to ask for)
        if not onHome and (lockServer() <> invalid or Ratings.limitOf(srv) > 0) and not profileLimited(srv, userId) and Servers.parentIds(srv).count() > 0
            askPin({ goal: "parent", serverId: sid, message: "This profile has no rating limit and no PIN. Enter a parent PIN to switch to it." }, { do: "switchProfile", serverId: sid, userId: userId, unlock: true })
            return
        end if
        switchProfile(srv, userId)
        return
    end if
    askPin({ goal: "verify", serverId: sid, userId: userId }, { do: "switchProfile", serverId: sid, userId: userId })
end sub

' (v0.9.1) Runs act now, or after a parent PIN when the server's profile on Home has a rating limit, or (C2-1)
' while the server list is locked by a limited profile that is or was active
sub guardedAct(srv as dynamic, act as object)
    ps = invalid
    if srv <> invalid and Ratings.limitOf(srv) > 0 then ps = srv
    if ps = invalid then ps = lockServer()
    if ps <> invalid
        act.unlock = true
        askPin({ goal: "parent", serverId: Util.toText(ps.id), message: "A profile with a rating limit is watching. Enter a parent PIN (the PIN of a profile without a limit) to continue." }, act)
    else
        runAct(act)
    end if
end sub

' (C2-6) Who's watching?'s Servers / Add profile: a parent PIN whenever a profile on the server has a limit and a
' parent PIN exists, whichever profile was used last
sub pickerGuard(srv as object, act as object)
    if Servers.anyLimited(srv) and Servers.parentIds(srv).count() > 0
        act.unlock = true
        askPin({ goal: "parent", serverId: Util.toText(srv.id), message: "A profile on this server has a rating limit. Enter a parent PIN (the PIN of a profile without a limit) to continue." }, act)
    else
        guardedAct(srv, act)
    end if
end sub

' (C2-1) Remembers a profile with a rating limit as the lock of the server list
sub noteLock(s as dynamic)
    if s <> invalid and Ratings.limitOf(s) > 0 then m.lock = { serverId: Util.toText(s.id), userId: Util.toText(s.userId) }
end sub

' The server whose parent PIN unlocks the server list, or invalid when it isn't locked (no lock, the server is
' gone, or the locking profile no longer has a limit)
function lockServer() as dynamic
    if m.lock = invalid then return invalid
    ls = Servers.find(Util.toText(m.lock.serverId))
    if ls = invalid or not profileLimited(ls, Util.toText(m.lock.userId)) then return invalid
    ' (no parent PIN on it: there is nobody to ask, and the profiles without a limit can be picked anyway)
    if Servers.parentIds(ls).count() = 0 then return invalid
    return ls
end function

function profileLimited(srv as object, userId as string) as boolean
    for each p in Servers.profiles(srv)
        if p.id = userId then return p.maxRating <> ""
    end for
    return false
end function

' The PIN steps (PinFlow); act runs when they succeed. On Who's watching? a wrong PIN shows in its status line.
sub askPin(q as object, act as object)
    q.tag = act
    q.quiet = topIs("profiles")
    m.pinFlow.focusBack = top()
    m.pinFlow.request = q
end sub

sub onPinResult(ev as object)
    r = ev.getData()
    if Util.flag(r, "ok")
        if Util.isAA(r.tag) then runAct(r.tag)
    else if Util.toText(r.message) <> "" and topIs("profiles")
        top().status = Util.toText(r.message)
    end if
end sub

sub runAct(act as object)
    what = Util.toText(act.do)
    ' (C2-1: a parent PIN was given: the server list is open until a limited profile is on Home again)
    if Util.flag(act, "unlock") then m.lock = invalid
    if what = "listPick"
        if topIs("servers") or topIs("address") then listPick(Util.toText(act.id))
    else if what = "askRemove"
        askRemove(Util.toText(act.serverId))
    else if what = "heldSignIn"
        h = m.heldAuth
        m.heldAuth = invalid
        if h <> invalid and m.server <> invalid and Util.toText(m.server.id) = h.serverId and topIs("signin") then saveSignIn(h.auth)
    else if what = "switchProfile"
        srv = Servers.find(Util.toText(act.serverId))
        if srv <> invalid then switchProfile(srv, Util.toText(act.userId))
    else if what = "servers"
        ' (SC-5: from Home or a Who's watching? opened over it, Back returns there)
        showServers("", m.homeReady)
    else if what = "signout"
        signOut()
    else if what = "addProfile"
        srv = Servers.find(Util.toText(act.serverId))
        if srv <> invalid then openSignIn(srv, "")
    end if
end sub

' Makes the profile the active one and rebuilds Home for it (sign in again when its sign-in has gone)
sub switchProfile(srv as object, userId as string)
    ' (the profile already on Home, picked from the sidebar: just go back)
    if m.server <> invalid and m.homeReady and Util.toText(m.server.id) = Util.toText(srv.id) and Util.toText(m.server.userId) = userId and Util.toText(m.server.token) <> ""
        backToHome()
        return
    end if
    s = Servers.useUser(Util.toText(srv.id), userId)
    if s = invalid then return
    print "Cove: switching profile on "; Util.toText(s.name)
    m.toastOnHome = "Switched to " + Util.toText(s.userName)
    if Util.toText(s.token) <> ""
        validate(s)
    else
        openSignIn(s, "Sign in again as " + Util.toText(s.userName) + ".")
    end if
end sub

' Voice / transport commands go to the player on top; elsewhere the Roku does its default
function handleTransport(evt as object) as object
    t = top()
    if t <> invalid and t.screenId = "player" then return t.callFunc("handleTransport", evt)
    return { status: "unhandled" }
end function

' ---------------------------------------------------------------- Instant Resume

function nowSecs() as integer
    return createObject("roDateTime").asSeconds()
end function

' The app goes to the background (Home, Back out of the app, the screensaver). It stays in memory, so the
' screens stay as they are; only what runs on its own stops: a playing video ends as on Back (stop report,
' the server's conversion ended), Home and Now Playing stop polling.
sub customSuspend(args as dynamic)
    reason = ""
    if Util.isAA(args) then reason = Util.toText(args.lastSuspendOrResumeReason)
    where = ""
    t = top()
    if t <> invalid then where = Util.toText(t.screenId)
    print "Cove: suspended ("; reason; ") on "; where
    m.suspendedAt = nowSecs()
    try
        stopNextAsk()
        stopQuickConnect()
        ' (the player is taken off the stack: when the app comes back the user is on the page it was started from)
        stopPlayers()
        for each s in m.stack
            if s.hasField("suspended") then s.suspended = true
        end for
    catch e
        print "Cove: suspend failed: "; Util.redact(Util.toText(e.message))
    end try
end sub

' The app is launched again from memory: the screens pick up their timers, the saved sign-in is checked
' (it may have been revoked meanwhile), Home reloads its rows if they are older than a few minutes, and a
' deep link that came with the launch is opened.
sub customResume(args as dynamic)
    away = 0
    if m.suspendedAt > 0 then away = nowSecs() - m.suspendedAt
    reason = ""
    if Util.isAA(args) then reason = Util.toText(args.lastSuspendOrResumeReason)
    print "Cove: resumed ("; reason; ") after "; away; " s"
    try
        for each s in m.stack
            if s.hasField("suspended") then s.suspended = false
        end for
        if away > 60 and m.homeReady and m.server <> invalid and whoOnResume(m.server)
            ' (v0.9.1) someone else may be in front of the TV now: Who's watching? (and the profile's PIN) before
            ' anything else; a link that came with the launch waits until a profile is picked (reset() clears
            ' homeReady, so onDeepLink keeps it in pendingLink)
            print "Cove: resumed after a while: asking who's watching"
            stopPlayers()
            showWho(m.server, "", false)
        else if m.homeReady and m.server <> invalid and Util.toText(m.server.token) <> ""
            request("GET", m.server, "/Users/" + Util.toText(m.server.userId), true, "", { kind: "resumeCheck", serverId: Util.toText(m.server.id) })
        else if topIs("connecting")
            ' (still checking the saved sign-in when the app was suspended: try again)
            validate(m.server)
        else if topIs("signin") and Util.toText(top().code) <> ""
            ' (C2-11: customSuspend stopped the Quick Connect polling, so the code on screen no longer works)
            showSignInItems("The Quick Connect code was stopped. Choose Quick Connect again.")
        end if
        if Util.isAA(args) and Util.isAA(args.launchParams)
            lp = args.launchParams
            if lp.contentId <> invalid and lp.mediaType <> invalid
                print "Cove: resumed with contentId="; Util.toText(lp.contentId); " mediaType="; Util.toText(lp.mediaType)
                m.top.deepLink = { contentId: lp.contentId, mediaType: lp.mediaType }
            end if
        end if
    catch e
        print "Cove: resume failed: "; Util.redact(Util.toText(e.message))
    end try
    ' (the screen is on and can be used: Roku measures the resume up to here)
    m.top.signalBeacon("AppResumeComplete")
end sub

sub stopNextAsk()
    m.nextAsk = invalid
    ' (R-9: a PIN notice waiting for that timer would pop up later over an unrelated keyboard)
    m.nextNotice = invalid
    m.dialogTimer.control = "stop"
end sub

' (v0.9.1) Ask again at a resume: as at start (2+ profiles with the setting on, or the last profile has a PIN),
' and also when a profile has a rating limit while the one on Home has none
function whoOnResume(s as object) as boolean
    srv = Servers.find(Util.toText(s.id))
    if srv = invalid then return false
    if wantsWho(srv) then return true
    return Servers.profiles(srv).count() >= 2 and Servers.anyLimited(srv) and Ratings.limitOf(srv) = 0
end function

' The sign-in check after a resume
sub onResumeCheck(r as object)
    if m.server = invalid or Util.toText(r.tag.serverId) <> Util.toText(m.server.id) then return
    if r.code = 401 or r.code = 403
        print "Cove: the saved sign-in no longer works after the resume"
        m.pendingLink = invalid
        m.server.token = ""
        Servers.upsert(m.server)
        openSignIn(m.server, "Your sign-in has expired. Please sign in again.")
        return
    end if
    if r.code <> 200
        print "Cove: sign-in check after the resume -> "; r.code
        return
    end if
    ' rows older than 5 minutes: Home reloads now if it is on top, otherwise when it is shown again
    if nowSecs() - m.homeLoadedAt < 300 then return
    if topIs("home")
        m.homeLoadedAt = nowSecs()
        top().reload = true
    else
        markStale()
    end if
end sub
