import "pkg:/source/DeviceCaps.bs"

sub init()
    m.top.backgroundColor = "0x0B0D14"
    m.top.backgroundURI = ""
    info = createObject("roAppInfo")
    m.top.findNode("subtitle").text = "Emby and Jellyfin client  ·  version " + info.getVersion()
    ' A failed check must not leave the line empty: show (and print) what went wrong instead
    text = ""
    try
        caps = DeviceCaps.get()
        text = DeviceCaps.describe(caps)
    catch e
        text = "Device check failed: " + DeviceCaps.toText(e.message) + " (error " + DeviceCaps.toText(e.number) + ")"
        print "Cove: "; text
        if e.backtrace <> invalid
            for each f in e.backtrace
                print "  at "; f.filename; ":"; f.line_number
            end for
        end if
    end try
    m.top.findNode("device").text = text
    m.top.setFocus(true)
end sub
