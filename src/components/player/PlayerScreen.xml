<?xml version="1.0" encoding="utf-8" ?>
<!-- Full-screen player with Cove's flat controls (v1.5) (Sources/Views.swift player): the Video node draws only the
     picture (enableUI off); text subtitles are drawn by SubtitleLayer; this component draws the controls.
     Set server + item ({ id, title, subtitle, start, options }); "done" fires when the user leaves.
     (v1.4 key model, the Mac's Glass3D bottom block) Controls hidden: OK pause / play and shows the controls with
     play / pause focused; Left / Right -10 / +10 s with the timeline focused; Up / Down show the controls.
     Controls shown, on the row: Left / Right move along it (previous · back N · play / pause · forward N · next,
     then the tool bar: episodes, chapters, previous / next chapter, subtitles, audio, quality, speed, info; a
     caption names the focused one), OK uses it, Up goes to the timeline. On the timeline: Left / Right move
     along it (presses add up, held they speed up, a thumbnail shows), OK jumps there now and Down returns to the
     row. Back cancels a pending jump, else hides the controls (leaves the player while paused).
     Rewind / Fast forward: Settings → Playback → Jump buttons (default 30 s). * : audio, subtitles, quality. Skip intro and Up next appear over the video. -->
<component name="PlayerScreen" extends="Group">
    <script type="text/brightscript" uri="PlayerScreen.bs" />
    <interface>
        <field id="screenId" type="string" value="player" />
        <field id="server" type="assocarray" />
        <!-- (v1.2 SP-13b) optional, set before item: the item JSON a details page already loaded (no People);
             used once when its Id is the item's, instead of asking the server again -->
        <field id="info" type="assocarray" />
        <field id="item" type="assocarray" onChange="begin" />
        <field id="done" type="boolean" alwaysNotify="true" />
        <!-- set by the scene before it removes the player (a deep link): stop everything, no "done" -->
        <field id="stopNow" type="boolean" onChange="onStopNow" />
        <!-- set before "done" by "Back to the series" (Are you still watching?): the scene opens that series -->
        <field id="openSeries" type="string" />
        <!-- (v1.3.1) set by the scene when playback started from Home: { itemId, itemType } of that card; when
             the player closes, the scene opens that title's page (NavUtil.returnPage) -->
        <field id="returnTo" type="assocarray" />
        <!-- (v1.3.1) the first title played: { id, type, seriesId, seasonId } (for returnTo) -->
        <field id="playedInfo" type="assocarray" />
        <!-- voice / transport commands (main.bs → MainScene): { command, direction, duration } → { status } -->
        <function name="handleTransport" />
    </interface>
    <children>
        <Rectangle width="1920" height="1080" color="0x000000FF" />
        <Video id="video" width="1920" height="1080" enableUI="false" />
        <Group id="keys" focusable="true" />
        <!-- text subtitles, drawn by Cove (Settings → Subtitles style); above the controls while they show -->
        <SubtitleLayer id="subLayer" />
        <Timer id="subTimer" duration="0.1" repeat="true" />
        <!-- (v1.3.1 E-3) past the part of the subtitles downloaded so far, while the rest is still coming -->
        <Group id="subNote" visible="false" translation="[790,924]">
            <Poster uri="pkg:/images/ui/flat_pill_52.9.png" width="340" height="52" blendColor="0x1C1C1CFF" opacity="0.85" />
            <Label text="Loading subtitles..." width="340" height="52" horizAlign="center" vertAlign="center" color="0xFFFFFFE6">
                <Font role="font" uri="font:MediumSystemFontFile" size="24" />
            </Label>
        </Group>

        <!-- (v1.4) the controls as Cove for macOS's Glass3D bottom block (Classic/ClassicPlayer.swift bottomBar):
             no centre buttons. Inside the 96 px safe edge: episode line and title, the timeline with the times
             under it, then one row: the transport controls at the left (previous · back N · play / pause ·
             forward N · next) and the tool bar at the right (Episodes · Chapters · Subtitles · Audio · Quality ·
             Speed · Info). The row is built by buildTools / buildRow (PlayerNav), drawn by drawControls. -->
        <Group id="osd" opacity="0">
            <Poster uri="pkg:/images/ui/scrim_top.png" width="1920" height="200" />
            <Poster uri="pkg:/images/ui/pl_scrim.png" width="1920" height="540" translation="[0,540]" />
            <!-- (v1.0 F-12) top right: the sleep timer's time left -->
            <Label id="sleepLeft" width="700" height="40" translation="[1124,54]" horizAlign="right" color="0xFFFFFFD9">
                <Font role="font" uri="font:MediumSystemFontFile" size="26" />
            </Label>
            <!-- episode line (S1:E3 - Name) over the title -->
            <Label id="episode" width="1400" height="36" translation="[96,724]" color="0xFFFFFFD9">
                <Font role="font" uri="font:MediumSystemFontFile" size="26" />
            </Label>
            <Label id="title" width="1400" height="56" translation="[96,760]" color="0xFFFFFFFF">
                <Font role="font" uri="font:BoldSystemFontFile" size="44" />
            </Label>
            <!-- the timeline, x 96 to 1824, its middle at y 852: 12 px at rest, 18 px with the knob while it has
                 the focus. (v1.5 flat) a flat white line: the played part white, the rest white at 30 %; no glow
                 or sheen -->
            <Group id="bar" translation="[96,852]">
                <Poster id="track" uri="pkg:/images/ui/pl_fill_12.9.png" width="1728" height="12" translation="[0,-6]" opacity="0.3" />
                <Poster id="fill" uri="pkg:/images/ui/pl_fill_12.9.png" width="12" height="12" translation="[0,-6]" />
                <!-- (v1.1) chapter starts: small gaps in the line (drawChapterTicks) -->
                <Group id="ticks" />
                <Poster id="thumb" uri="pkg:/images/ui/white_circle_56.png" width="34" height="34" translation="[-17,-17]" visible="false" />
            </Group>
            <!-- the times under the timeline: elapsed at the left; the time left and the Mac's "Ends at" (the Roku's
                 local time in its clock format, after the time left at the current speed) at the right -->
            <Label id="elapsed" text="0:00" width="600" height="36" translation="[96,876]" color="0xFFFFFFD9">
                <Font role="font" uri="font:MediumSystemFontFile" size="26" />
            </Label>
            <Label id="timesRight" text="Ends at --:--" width="900" height="36" translation="[924,876]" horizAlign="right" color="0xFFFFFFD9">
                <Font role="font" uri="font:MediumSystemFontFile" size="26" />
            </Label>
            <!-- the row, centred on y 966: transport controls at the left, the tool bar at the right -->
            <Group id="row" />
            <Group id="tools" />
            <!-- what the focused button does (and the current value of Subtitles / Audio / Quality / Speed), in
                 the gap between the controls and the tool bar -->
            <Label id="caption" width="500" height="40" translation="[600,946]" vertAlign="center" color="0xFFFFFFEB">
                <Font role="font" uri="font:MediumSystemFontFile" size="26" />
            </Label>
            <!-- seek thumbnail above the timeline (Emby BIF / Jellyfin trickplay) -->
            <Group id="preview" visible="false" translation="[96,595]">
                <Poster uri="pkg:/images/ui/pl_panel_black.9.png" width="336" height="236" />
                <Group id="previewClip" translation="[8,8]" clippingRect="[0,0,320,180]">
                    <Poster id="previewImg" width="320" height="180" />
                </Group>
                <Label id="previewTime" width="336" height="40" translation="[0,190]" horizAlign="center" vertAlign="center" color="0xFFFFFFFF">
                    <Font role="font" uri="font:BoldSystemFontFile" size="26" />
                </Label>
            </Group>
        </Group>

        <!-- loading the video: a progress ring with the percentage (and a line under it when there is something to say) -->
        <!-- (v1.5 flat) on a dark 85 % disc, the arc in white -->
        <Group id="loader" visible="false">
            <Poster uri="pkg:/images/ui/white_circle_240.png" width="164" height="164" translation="[878,458]" blendColor="0x1C1C1CFF" opacity="0.85" />
            <Poster uri="pkg:/images/ui/load_track.png" width="132" height="132" translation="[894,474]" />
            <Poster id="loaderArc" width="132" height="132" translation="[894,474]" />
            <Label id="loaderPct" width="132" height="132" translation="[894,474]" horizAlign="center" vertAlign="center" color="0xFFFFFFFF">
                <Font role="font" uri="font:BoldSystemFontFile" size="30" />
            </Label>
        </Group>
        <Label id="status" width="1920" height="60" translation="[0,510]" horizAlign="center" color="0xFFFFFFD9" visible="false">
            <Font role="font" uri="font:MediumSystemFontFile" size="36" />
        </Label>

        <!-- (v1.3.1 E-7) the video couldn't play: the reason with Try Again (and Play Without Subtitles when a
             subtitle was burned in); Back leaves the player -->
        <Group id="errorBox" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000B3" />
            <!-- (v1.5 flat) the reason and its buttons on a flat dark panel -->
            <Poster id="errorGlass" uri="pkg:/images/ui/pl_panel_black.9.png" width="1680" height="360" translation="[120,352]" />
            <ErrorPanel id="errorPanel" translation="[160,400]" width="1600" />
        </Group>

        <!-- Skip intro / Next episode / Watch Intro: a button over the video (OK uses it, any other key dismisses it) -->
        <!-- (v1.5 flat) a flat chip: solid white with dark text while it holds the remote (over the bare video),
             a dark 85 % pill with white text while the controls show (placeAction moves it above the bottom block) -->
        <Group id="action" translation="[1554,880]" visible="false">
            <Poster id="actionBg" uri="pkg:/images/ui/flat_pill_72.9.png" width="270" height="72" />
            <Label id="actionLabel" width="270" height="72" horizAlign="center" vertAlign="center" color="0xFFFFFFFF">
                <Font role="font" uri="font:BoldSystemFontFile" size="28" />
            </Label>
        </Group>

        <!-- Up Next, a card bottom-right: (v1.3) over an episode's credits (or its last 30 s) with Play Now and
             Back to Credits, counting down while they play; and after an episode, the next one starts by itself -->
        <!-- (v1.5 flat) a flat dark panel (the page colour at 85 %, r27, no rim); the still with the white countdown
             under it; Play Now and Back to Credits as flat pills, the focused one solid white with dark text
             (drawUpNextCard) -->
        <Group id="upNext" translation="[1164,758]" visible="false">
            <Poster id="upNextPanel" uri="pkg:/images/ui/pl_panel_black.9.png" width="660" height="238" />
            <Poster id="upNextStill" width="240" height="135" translation="[24,24]" loadWidth="240" loadHeight="135" loadDisplayMode="scaleToZoom" />
            <!-- the countdown: a bar along the still's bottom edge that empties -->
            <Rectangle width="240" height="5" translation="[24,154]" color="0xFFFFFF40" />
            <Rectangle id="upNextFill" width="240" height="5" translation="[24,154]" color="0xFFFFFFFF" />
            <Label id="upNextHead" text="UP NEXT" width="350" height="32" translation="[288,20]" color="0xFFFFFFCC">
                <Font role="font" uri="font:BoldSystemFontFile" size="24" />
            </Label>
            <Label id="upNextTitle" width="350" height="36" translation="[288,54]" color="0xFFFFFFFF">
                <Font role="font" uri="font:BoldSystemFontFile" size="28" />
            </Label>
            <Label id="upNextEpisode" width="350" height="34" translation="[288,92]" color="0xFFFFFFD9">
                <Font role="font" uri="font:MediumSystemFontFile" size="24" />
            </Label>
            <Group translation="[24,170]">
                <Poster id="upNextPlayBg" uri="pkg:/images/ui/flat_pill_52.9.png" width="250" height="52" />
                <Label id="upNextCount" width="250" height="52" horizAlign="center" vertAlign="center" color="0xFFFFFFFF">
                    <Font role="font" uri="font:BoldSystemFontFile" size="24" />
                </Label>
            </Group>
            <Label id="upNextHint" text="Back: stop" width="350" height="52" translation="[288,170]" vertAlign="center" color="0xFFFFFFCC">
                <Font role="font" uri="font:MediumSystemFontFile" size="24" />
            </Label>
            <Group id="upNextAlt" translation="[288,170]" visible="false">
                <Poster id="upNextAltBg" uri="pkg:/images/ui/flat_pill_52.9.png" width="348" height="52" opacity="0.12" />
                <Label id="upNextAltLabel" text="Back to Credits" width="348" height="52" horizAlign="center" vertAlign="center" color="0xFFFFFFFF">
                    <Font role="font" uri="font:BoldSystemFontFile" size="24" />
                </Label>
            </Group>
        </Group>

        <!-- Are you still watching? (Settings → Playback): after several episodes in a row, or 2 hours,
             without a key press. Left / Right choose, OK uses the button, Back leaves the player. -->
        <Group id="still" visible="false">
            <Rectangle width="1920" height="1080" color="0x000000A6" />
            <!-- (v1.5 flat) a flat dark panel; two flat pills, the focused one solid white with dark text (drawStill) -->
            <Group translation="[540,370]">
                <Poster id="stillPanel" uri="pkg:/images/ui/pl_panel_black.9.png" width="840" height="340" />
                <Label text="Are you still watching" width="840" height="40" translation="[0,40]" horizAlign="center" color="0xFFFFFFCC">
                    <Font role="font" uri="font:MediumSystemFontFile" size="30" />
                </Label>
                <Label id="stillTitle" text="this series?" width="780" height="60" translation="[30,90]" horizAlign="center" color="0xFFFFFFFF">
                    <Font role="font" uri="font:BoldSystemFontFile" size="44" />
                </Label>
                <Group id="stillBtns" translation="[48,222]" />
            </Group>
        </Group>

        <Timer id="progressTimer" duration="10" repeat="true" />
        <Timer id="watchdog" duration="45" repeat="false" />
        <!-- (v1.1.1 SP-15) Emby's seek thumbnails start downloading 8 s into playback -->
        <Timer id="thumbTimer" duration="8" repeat="false" />
        <!-- (v1.7.1 SP6-1) the start lines for 5 s after the first frame -->
        <Timer id="startDiagTimer" duration="1" repeat="true" />
        <Timer id="noticeTimer" duration="5" repeat="false" />
        <Timer id="closeTimer" duration="0.3" repeat="false" />
        <Timer id="countdown" duration="1" repeat="true" />
        <Timer id="hideTimer" duration="4" repeat="false" />
        <Timer id="seekTimer" duration="0.8" repeat="false" />
        <!-- (v1.3 U-4) Left / Right held: the next bigger step every 0.25 s while no key repeats come -->
        <Timer id="holdTimer" duration="0.25" repeat="true" />
        <Animation id="osdAnim" duration="0.25" easeFunction="linear">
            <FloatFieldInterpolator id="osdFade" key="[0.0, 1.0]" fieldToInterp="osd.opacity" />
        </Animation>
    </children>
</component>
