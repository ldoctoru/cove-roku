import "pkg:/source/Util.bs"
import "pkg:/source/Prefs.bs"
import "pkg:/source/Api.bs"
import "pkg:/source/Playback.bs"
import "pkg:/source/Tracks.bs"
import "pkg:/source/Subs.bs"
import "pkg:/source/Items.bs"
import "pkg:/source/MediaInfo.bs"
import "pkg:/source/Speak.bs"
import "pkg:/source/Ratings.bs"
import "pkg:/source/Clock.bs"
import "pkg:/source/Toasts.bs"

sub init()
    m.video = m.top.findNode("video")
    ' The remote goes to this node, not to the Video node: a focused Video node with its own controls off
    ' lets Roku open its system Options panel on *, so our audio / subtitle menu never got the key.
    m.keys = m.top.findNode("keys")
    m.status = m.top.findNode("status")
    m.loader = m.top.findNode("loader")
    m.subLayer = m.top.findNode("subLayer")
    m.subTimer = m.top.findNode("subTimer")
    m.subTimer.observeField("fire", "onSubTick")
    m.subsOn = false        ' cues loaded (the subtitle timer runs only while they are and the video plays)
    m.stillClock = invalid  ' since "Are you still watching?" showed (R-5)
    m.loaderArc = m.top.findNode("loaderArc")
    m.loaderPct = m.top.findNode("loaderPct")
    m.video.observeField("bufferingStatus", "onBufferingStatus")
    m.action = m.top.findNode("action")
    m.actionLabel = m.top.findNode("actionLabel")
    m.upNext = m.top.findNode("upNext")
    m.progressTimer = m.top.findNode("progressTimer")
    m.closeTimer = m.top.findNode("closeTimer")
    m.countdown = m.top.findNode("countdown")
    m.progressTimer.observeField("fire", "onProgressTimer")
    m.closeTimer.observeField("fire", "finish")
    m.countdown.observeField("fire", "onCountdown")
    m.watchdog = m.top.findNode("watchdog")
    m.watchdog.observeField("fire", "onWatchdog")
    m.thumbTimer = m.top.findNode("thumbTimer")
    m.thumbTimer.observeField("fire", "startDeferredThumbs")
    ' (v1.1) "Intro skipped · Watch Intro" shows for 5 s after an automatic skip
    m.noticeTimer = m.top.findNode("noticeTimer")
    m.noticeTimer.observeField("fire", "onNoticeTimer")
    m.thumbFiles = {}
    m.osd = m.top.findNode("osd")
    m.hideTimer = m.top.findNode("hideTimer")
    m.seekTimer = m.top.findNode("seekTimer")
    m.hideTimer.observeField("fire", "hideOsd")
    m.seekTimer.observeField("fire", "applySeek")
    m.seekTarget = -1.0
    m.osdShown = false
    m.area = "center"
    m.idx = 1
    m.toolIds = []
    m.video.observeField("state", "onState")
    m.video.observeField("position", "onPosition")
    m.video.notificationInterval = 1
    m.top.observeField("focusedChild", "onFocusChanged")
    m.pending = []
    m.infoAnswer = invalid  ' (v1.2) the item's details, waiting for the audio preference (startWhenReady)
    m.waitUser = false
    m.startClock = invalid
    m.keepClock = false     ' (v1.2) the next begin keeps the clock (film -> its first Cinema Mode intro)
    m.hasQueue = false      ' (PL-13) the title came with a Shuffle queue
    m.orphans = []          ' superseded PlayTasks, kept until they answer so their server conversion can be ended
    m.tasksHolder = invalid
    tasksHolder()
    m.picker = invalid
    m.pausedByPicker = false  ' the picker paused the video (closing it resumes only then)
    m.bifTask = invalid
    m.bifPath = ""
    m.subLang = ""          ' subtitle language chosen in this session, kept for the next episode
    m.pbInfo = invalid      ' Playback info overlay (* menu), m.pbTimer refreshes it
    m.pbTimer = invalid
    m.pbTask = invalid
    m.pbServer = invalid
    m.pbTick = 0
    ' Are you still watching?: episodes started by the countdown since the last key press, and the time
    ' since that press (both span episodes, so they live outside resetState)
    m.still = m.top.findNode("still")
    m.stillKind = ""
    m.stillBtn = 0
    m.autoCount = 0
    m.lastInput = createObject("roTimespan")
    m.pauseClock = invalid  ' since the video paused (Rewind on resume after a long pause)
    ' Audio Guide: Cove says its own controls (the control said last, so a redraw stays quiet)
    m.spokenKey = ""
    Speak.mute([m.keys, m.action, m.upNext, m.still])
    resetState()
end sub

' Settings read once per title (P-3: each Prefs read opens the registry, and some ran every second);
' read again when a picker closes, since the player's menus can change them
sub refreshPrefs()
    m.pf = {
        skipIntro: Prefs.autoSkipIntro(),
        skipRecap: Prefs.autoSkipRecap(),
        stillAfter: Prefs.stillWatchingAfter(),
        jump: Prefs.jumpSeconds(),
        skip: Prefs.skipSeconds(),
        subBottom: Prefs.subBottom(),
        autoNext: Prefs.autoNext(),
        rewind: Prefs.rewindOnResume()
    }
end sub

sub resetState()
    refreshPrefs()
    m.loadNote = ""
    m.loadBase = 0
    m.subPos = 0.0
    ' Subtitle delay (Subtitles menu), for this title only: a new title starts at 0
    m.subDelayMs = 0
    m.subLayer.delay = 0.0
    ' Roku captions set to "Instant replay": a text subtitle loaded hidden, shown for a while after a replay
    m.replaySub = -1
    m.replayReady = false
    m.subLayer.visible = true
    clearSubs()
    m.seekTarget = -1.0
    m.osdShown = false
    m.osd.opacity = 0
    m.pauseClock = invalid
    ' playback speed (* menu → Speed), back to Settings → Playback → Default speed (v1.0 F-3) for every new
    ' title; Ends at divides the time left by it
    m.speed = 1.0
    m.speedId = "1"
    if speedSupported()
        m.speedId = Prefs.defaultSpeed()
        m.speed = Val(m.speedId)
    end if
    m.session = invalid
    if m.playTask <> invalid then orphanPlayTask(m.playTask)
    m.playTask = invalid
    m.retried = false
    m.started = false
    m.closing = false
    m.failed = false
    m.lastPos = 0
    m.info = invalid
    m.tracks = { sourceId: "", audio: [], subs: [] }
    m.versions = []
    m.marks = Tracks.markers({})
    m.segsDone = {}         ' segments skipped or dismissed (by key), so their button doesn't come back
    m.actionSeg = invalid
    m.next = invalid
    m.prev = invalid
    m.episodes = []
    m.epWaiting = invalid
    m.epIndex = -1
    m.actionKind = ""
    m.watchAt = -1.0        ' (v1.1) where Watch Intro / Watch Recap goes back to
    m.noticeTimer.control = "stop"
    m.tickDur = -1.0        ' (v1.1) the duration the chapter ticks on the bar were drawn for
    m.top.findNode("ticks").removeChildrenIndex(m.top.findNode("ticks").getChildCount(), 0)
    m.introDismissed = false
    m.creditsDismissed = false
    m.opts = Playback.options()
    m.startAt = 0.0
    m.pauseOnStart = false  ' (PL-15) pause again on the first "playing" after a restart of a paused video
    m.action.visible = false
    m.upNext.visible = false
    m.countdown.control = "stop"
    m.watchdog.control = "stop"
    m.thumbs = invalid       ' { kind: "bif", ... } or { kind: "tiles", ... } for seek thumbnails
    m.thumbShown = -1
    ' (v1.1.1 SP-15) Emby's BIF waits for the video: the stream it belongs to, until playback has started
    m.thumbStream = invalid
    m.thumbTimer.control = "stop"
    m.top.findNode("preview").visible = false
    clearThumbFiles()
end sub

' A new item (also the next episode): load its details first (tracks, markers), then ask for a stream
sub begin()
    resetState()
    ' (v1.1.1) "Cove: player <ms> <step>" (v1.2 playerMark): from here (the player pushed, or the next title)
    ' to info ready, PlaybackInfo answered, stream URL set and the first frame
    ' (kept over the switch from the film to its first Cinema Mode intro, so the line counts from OK)
    if not m.keepClock or m.startClock = invalid then m.startClock = createObject("roTimespan")
    m.keepClock = false
    it = m.top.item
    ' library Shuffle: the titles still to play (Up next takes them before the series' next episode)
    m.queue = []
    ' (PL-13: started as a queue, even an empty one now)
    m.hasQueue = type(it.queue) = "roArray"
    if m.hasQueue then m.queue = it.queue
    m.startAt = it.start
    ' Settings → Playback → Rewind on resume: a title resuming from its saved position starts a little earlier
    rw = m.pf.rewind
    if rw > 0 and m.startAt > 1
        m.startAt = m.startAt - rw
        if m.startAt < 0 then m.startAt = 0
        print "Cove: rewind on resume, starting at "; Int(m.startAt); " s"
    end if
    tasksHolder()
    m.top.findNode("title").text = Util.toText(it.title)
    m.top.findNode("episode").text = Util.toText(it.subtitle)
    if it.options <> invalid and it.options.audio <> invalid then m.opts = it.options
    showLoading(0, "")
    Speak.say(Speak.clean("Loading " + Util.toText(it.title) + ", " + Util.toText(it.subtitle)))
    ' (v1.1) the account's preferred audio language, once per session (Tracks.serverAudioPref; usually known
    ' from the launch sign-in check). (v1.2 SP-13a) Asked for in parallel with the item, not before it:
    ' the stream request waits for both (startWhenReady).
    m.infoAnswer = invalid
    m.waitUser = Tracks.serverAudioPref(m.top.server) = invalid
    if m.waitUser then get("/Users/" + Util.toText(m.top.server.userId), { kind: "user", itemId: it.id })
    requestInfo()
end sub

' The item's details and the account's audio preference are both in: choose the tracks and ask for a stream
sub startWhenReady()
    if m.waitUser or m.infoAnswer = invalid then return
    r = m.infoAnswer
    m.infoAnswer = invalid
    playerMark("info ready")
    onInfo(r)
end sub

' "Cove: player <ms> <step>": ms since the player started this title (begin)
sub playerMark(stepName as string)
    if m.startClock = invalid then return
    print "Cove: player "; m.startClock.totalMilliseconds(); " "; stepName
end sub

sub requestInfo()
    it = m.top.item
    get("/Users/" + Util.toText(m.top.server.userId) + "/Items/" + it.id + "?Fields=MediaSources,MediaStreams,Chapters,Trickplay", { kind: "info", itemId: it.id })
end sub

' (v1.1) The audio to start with when none was picked by hand: the series' last choice, the server account's
' audio language, else the file's default, never a commentary track (Tracks.startAudio). A pick on the
' details page is remembered for the series.
sub chooseStartAudio()
    picked = m.top.item.options <> invalid and m.opts.audio >= 0
    if picked
        rememberAudio(m.opts.audio)
        return
    end if
    seriesLang = ""
    if seriesKey() <> "" then seriesLang = Prefs.seriesAudioLang(seriesKey())
    wanted = Tracks.wantedAudio(m.tracks, seriesLang, Tracks.serverAudioPref(m.top.server))
    a = Tracks.startAudio(m.tracks, wanted)
    print "Cove: audio wanted ["; Util.join(wanted, ","); "] -> track "; a; " (file default "; m.opts.defaultAudio; ")"
    if a >= 0 and a <> m.opts.defaultAudio then m.opts.audio = a
end sub

' The audio language chosen by hand, kept for the series (Prefs.seriesLangs)
sub rememberAudio(index as integer)
    a = Tracks.findAudio(m.tracks, index)
    if a <> invalid and seriesKey() <> "" and a.language <> "" then Prefs.setSeriesAudioLang(seriesKey(), a.language)
end sub

sub onInfo(r as object)
    if r.code = 200 and r.json <> invalid
        m.info = r.json
        m.versions = Tracks.versions(r.json)
        m.tracks = Tracks.fromItem(r.json, Util.toText(m.opts.sourceId))
        m.marks = Tracks.markers(r.json)
        m.opts.defaultAudio = Tracks.defaultAudio(m.tracks)
        chooseStartAudio()
        buildTools()
        ' Not chosen on the details page: forced subtitles, or the language chosen for the previous episode
        ' The series' subtitle language (series page pill, or the last choice made in the player for it):
        ' "" = automatic (forced subtitles only), "off", or a language code
        ' Settings → "Always load my subtitle language" wins over the series' language, as on the Mac
        ' (also when the title was started from its details page: unless a subtitle was picked there by hand)
        always = -1
        picked = m.top.item.options <> invalid and m.top.item.options.subPicked = true
        ' a language chosen for this series on its page (or in the player) is more specific and wins
        seriesPref = ""
        if seriesKey() <> "" then seriesPref = Prefs.seriesSubLang(seriesKey())
        if Prefs.subAlways() and not picked and seriesPref = "" and m.subLang = "" then always = Tracks.subForLanguage(m.tracks, Prefs.subLang())
        langs = []
        for each s in m.tracks.subs
            langs.push(s.language + "=" + s.label)
        end for
        print "Cove: subtitles available: "; Util.join(langs, " | ")
        if Prefs.subAlways() then print "Cove: always load "; Prefs.subLang(); " -> track "; always
        if always >= 0
            m.opts.sub = always
            m.opts.burn = not Tracks.findSub(m.tracks, always).isText
            print "Cove: subtitles in "; Prefs.subLang(); " (Settings)"
        else if m.top.item.options = invalid
            pref = m.subLang
            if pref = "" and seriesKey() <> "" then pref = Prefs.seriesSubLang(seriesKey())
            if pref <> "off"
                s = Tracks.defaultSub(m.tracks, pref)
                if s >= 0
                    m.opts.sub = s
                    m.opts.burn = not Tracks.findSub(m.tracks, s).isText
                end if
            end if
        end if
        ' The Roku's captions are On (Settings → Accessibility → Captions) and nothing in Cove chose subtitles:
        ' the language from Settings, else the Roku's caption language. Off in the player or on the series page,
        ' or a choice on the details page, wins.
        if m.opts.sub < 0 and not picked and seriesPref = "" and m.subLang = "" and Subs.rokuMode() = "On"
            rs = Tracks.subForLanguage(m.tracks, Subs.rokuLanguage())
            print "Cove: Roku captions on, "; Subs.rokuLanguage(); " -> track "; rs
            ' (text ones only: burning one in would make the server convert the video)
            if rs >= 0 and Tracks.findSub(m.tracks, rs).isText
                m.opts.sub = rs
                m.opts.burn = false
            end if
        else if m.opts.sub < 0 and Subs.rokuMode() = "Instant replay"
            rs = Tracks.subForLanguage(m.tracks, Subs.rokuLanguage())
            if rs >= 0 and Tracks.findSub(m.tracks, rs).isText then m.replaySub = rs
            print "Cove: Roku captions on instant replay -> track "; rs
        end if
        ' Jellyfin keeps intro / credits (and recaps, previews, commercials) as media segments
        if Util.toText(m.top.server.type) = "jellyfin" then get("/MediaSegments/" + m.top.item.id + "?includeSegmentTypes=Intro&includeSegmentTypes=Outro&includeSegmentTypes=Recap&includeSegmentTypes=Preview&includeSegmentTypes=Commercial", { kind: "segments", itemId: m.top.item.id })
        if Util.toText(r.json.Type) = "Episode" and Util.toText(r.json.SeriesId) <> ""
            ' (C2-4: the profile's rating limit, as on Details)
            get(Ratings.withLimit(m.top.server, "/Shows/" + Util.toText(r.json.SeriesId) + "/Episodes?UserId=" + Util.toText(m.top.server.userId) + "&" + Items.fields()), { kind: "episodes", itemId: m.top.item.id })
        end if
    end if
    useQueue()
    start(m.startAt, false)
end sub

' Shuffle queue hook: the next title is the queue's first
' (PL-13: after the queue's last title nothing follows, not that series' next episodes; Previous stays)
sub useQueue()
    if m.queue <> invalid and m.queue.count() > 0
        m.next = m.queue[0]
    else if m.hasQueue
        m.next = invalid
    end if
end sub

function seriesKey() as string
    if m.info = invalid or Util.toText(m.info.SeriesId) = "" then return ""
    return Util.toText(m.info.SeriesId)
end function

' Asks the server for a stream; forceTranscode after a playback error
sub start(startSeconds as float, forceTranscode as boolean)
    m.startAt = startSeconds
    ' (keeps a "Converting..." line from retryConverted)
    showLoading(5, m.loadNote)
    ' (a change while "Starting...": the earlier request is superseded, only its conversion still needs ending)
    if m.playTask <> invalid then orphanPlayTask(m.playTask)
    m.playTask = createObject("roSGNode", "PlayTask")
    m.playTask.server = m.top.server
    m.playTask.itemId = m.top.item.id
    m.playTask.forceTranscode = forceTranscode
    m.playTask.options = m.opts
    m.playTask.observeField("stream", "onStream")
    m.playTask.observeField("error", "onPlayError")
    m.playTask.control = "RUN"
end sub

' A PlayTask that is no longer wanted (new settings, another episode, the player closed): its answer is
' ignored, but a conversion the server started for it is stopped
sub orphanPlayTask(t as object)
    t.unobserveField("stream")
    t.unobserveField("error")
    if t.state = "done" or t.state = "stop" then return
    t.observeField("stream", "onOrphanStream")
    t.observeField("error", "onOrphanStream")
    m.orphans.push(t)
end sub

sub onOrphanStream(ev as object)
    t = ev.getRoSGNode()
    t.unobserveField("stream")
    t.unobserveField("error")
    for i = 0 to m.orphans.count() - 1
        if m.orphans[i].isSameNode(t)
            m.orphans.delete(i)
            exit for
        end if
    end for
    s = t.stream
    if s <> invalid and Util.toText(s.method) <> ""
        print "Cove: ending the superseded play session "; Util.toText(s.playSessionId)
        stopEncodingFor(s)
    end if
end sub

sub onStream(ev as object)
    t = ev.getRoSGNode()
    s = ev.getData()
    if m.playTask = invalid or not t.isSameNode(m.playTask) or s = invalid
        ' (a stale answer: end its conversion instead of playing it)
        onOrphanStream(ev)
        return
    end if
    t.unobserveField("stream")
    t.unobserveField("error")
    m.playTask = invalid
    s.itemId = m.top.item.id
    m.session = s
    playerMark("PlaybackInfo answered")
    ' left while the server was preparing it: stop that conversion and go
    if m.closing
        stopEncoding()
        return
    end if
    print "Cove: play "; s.method; " ("; s.streamFormat; ")"
    m.watchdog.control = "stop"
    m.watchdog.control = "start"
    if m.thumbs = invalid
        ' (SP-15) Jellyfin's tiles load one by one while seeking; Emby's BIF (a few MB) starts after the video
        if Util.toText(m.top.server.type) = "jellyfin"
            loadThumbs(s)
        else
            m.thumbStream = s
        end if
    end if
    c = createObject("roSGNode", "ContentNode")
    c.url = s.url
    ' (Jellyfin: the sign-in travels as a header, not in the URL; Playback.videoHeaders)
    if type(s.headers) = "roArray" and s.headers.count() > 0 then c.HttpHeaders = s.headers
    c.streamFormat = s.streamFormat
    c.title = Util.toText(m.top.item.title)
    c.secondaryTitle = Util.toText(m.top.item.subtitle)
    if m.startAt > 1 then c.PlayStart = m.startAt
    ' A text subtitle: Cove downloads the server's SRT and draws it (SubtitleLayer); Roku's captions stay off
    m.video.content = c
    playerMark("stream URL set")
    ' (no subtitleTracks, so Roku's renderer has nothing to show; the Roku's global caption mode is left alone)
    m.video.subtitleTrack = ""
    loadTextSub()
    ' (a new title starts at 1×; a restart for other settings keeps the chosen speed)
    if speedSupported() then m.video.setField("playbackSpeed", m.speed)
    m.video.control = "play"
    ' (the stream is ready: the rest of the ring is the Video node's buffering)
    if m.loader.visible
        m.loadBase = 15
        setLoadPct(15)
    end if
    ' (PL-2: a menu opened during loading keeps the remote)
    focusPlayer()
end sub

' The chosen text subtitle (if any): download it as SRT and draw it
sub loadTextSub()
    clearSubs()
    m.subLayer.visible = true
    m.replayReady = false
    if m.session = invalid then return
    sub_ = Tracks.findSub(m.tracks, m.opts.sub)
    if m.opts.sub < 0 and m.replaySub >= 0
        ' (subtitles off, Roku captions on instant replay: loaded now, shown only after a replay)
        probeSubtitle(Playback.subtitleUrl(m.top.server, m.top.item.id, Util.toText(m.session.mediaSourceId), m.replaySub), m.replaySub, true)
        return
    end if
    if sub_ = invalid or not sub_.isText or m.opts.burn then return
    url = Playback.subtitleUrl(m.top.server, m.top.item.id, Util.toText(m.session.mediaSourceId), sub_.index)
    probeSubtitle(url, sub_.index)
end sub

sub clearSubs()
    if m.subLayer = invalid then return
    m.subTimer.control = "stop"
    m.subsOn = false
    m.subLayer.cues = []
end sub

' The Video node reports its position once a second: in between, add the time since that report
sub onSubTick()
    p = m.subPos
    if m.video.state = "playing" and m.subClock <> invalid then p = p + m.speed * m.subClock.TotalMilliseconds() / 1000.0
    m.subLayer.position = p
end sub

' (called on every position report and after a jump)
sub syncSubClock(atSec as float)
    m.subPos = atSec
    if m.subClock = invalid then m.subClock = createObject("roTimespan")
    m.subClock.Mark()
end sub

' Settings → Subtitles → Distance from bottom; above the controls while they show (as on the Mac)
sub liftSubs(controlsShown as boolean)
    base = Int(1080 * m.pf.subBottom / 100)
    if controlsShown and base < 236 then base = 236
    m.subLayer.lift = base
end sub

' Download the subtitle (the server extracts embedded ones the first time, so it can take a while). If the
' server answers with an error, play the subtitle burned into the picture instead of showing nothing.
sub probeSubtitle(url as string, index as integer, forReplay = false as boolean)
    t = createObject("roSGNode", "ApiTask")
    t.request = { method: "GET", url: url, headers: Playback.subtitleHeaders(m.top.server), body: "", keepText: true, parse: "srt", tag: { kind: "subProbe", itemId: m.top.item.id, index: index, replay: forReplay }, timeout: 180000 }
    t.observeField("response", "onResponse")
    m.pending.push(t)
    t.control = "RUN"
end sub

sub onSubProbe(r as object)
    print "Cove: subtitle -> "; r.code
    if r.tag.replay = true
        ' (the instant-replay subtitle: kept hidden; nothing to fall back to if it fails)
        if r.tag.itemId <> m.top.item.id or m.opts.sub >= 0 or m.closing or r.code < 200 or r.code >= 400 or r.cues = invalid or r.cues.count() = 0 then return
        m.subLayer.visible = false
        m.subLayer.restyle = true
        liftSubs(m.osdShown)
        m.subLayer.cues = r.cues
        m.subsOn = true
        m.subTimer.control = "start"
        m.replayReady = true
        return
    end if
    if r.tag.itemId <> m.top.item.id or m.opts.sub <> r.tag.index or m.opts.burn or m.closing then return
    if r.code >= 200 and r.code < 400
        if r.cues <> invalid then print "Cove: subtitle cues "; r.cues.count()
        if r.cues <> invalid and r.cues.count() > 0
            m.subLayer.restyle = true
            liftSubs(m.osdShown)
            m.subLayer.cues = r.cues
            m.subsOn = true
            m.subTimer.control = "start"
        end if
        return
    end if
    ' (no answer in time: nothing to show)
    if r.code < 400 then return
    print "Cove: text subtitle failed, burning it in"
    m.opts.burn = true
    ' (the line stays under the loading ring)
    m.loadNote = "The subtitles couldn't load as text. Adding them to the picture..."
    restartAt(m.video.position)
end sub

sub onPlayError(ev as object)
    t = ev.getRoSGNode()
    if m.playTask = invalid or not t.isSameNode(m.playTask) or m.closing then return
    t.unobserveField("stream")
    t.unobserveField("error")
    m.playTask = invalid
    m.watchdog.control = "stop"
    m.status.text = Util.toText(ev.getData()) + chr(10) + "Press Back to return."
    m.status.visible = true
    hideLoading()
end sub

sub onState()
    st = m.video.state
    print "Cove: video "; st
    if st = "buffering" and m.started then showLoading(0, "")
    if st = "playing" or st = "paused" then updateCenter()
    if st = "paused"
        if m.pauseClock = invalid then m.pauseClock = createObject("roTimespan")
        m.pauseClock.Mark()
        ' (P-6: the 10 Hz subtitle timer rests while paused; the layer keeps the cue shown)
        m.subTimer.control = "stop"
    else if st = "playing"
        m.pauseClock = invalid
        if m.subsOn then m.subTimer.control = "start"
    end if
    ' (PL-9: not under the "Are you still watching?" card, whose pause comes first)
    if st = "paused" and not m.still.visible then showOsd(false)
    if st = "playing" and m.osdShown then m.hideTimer.control = "start"
    if st = "playing"
        m.status.visible = false
        hideLoading()
        m.watchdog.control = "stop"
        first = not m.started
        if not m.started
            m.started = true
            playerMark("first frame")
            m.startClock = invalid
            ' (SP-15) the thumbnails 8 s into playback, or at the first seek if that comes sooner
            if m.thumbStream <> invalid then m.thumbTimer.control = "start"
            report("/Sessions/Playing", false)
            m.progressTimer.control = "start"
        end if
        ' (PL-15) a restart of a paused video: paused again; (PL-2) a menu opened while loading: the video
        ' waits under it, and closing it plays on
        if first and (m.pauseOnStart or m.picker <> invalid)
            if not m.pauseOnStart then m.pausedByPicker = true
            m.pauseOnStart = false
            m.video.control = "pause"
        end if
    else if st = "paused"
        report("/Sessions/Playing/Progress", true)
    else if st = "finished"
        ' (the Video node also reports "finished" right after an error: only a real end counts)
        if m.started and not m.failed then onFinished()
    else if st = "error"
        onVideoError()
    end if
end sub

' The Roku couldn't play the stream: once, have the server convert the video and continue at the same position
sub onVideoError()
    m.failed = true
    ' (the error texts can hold the stream URL with its api_key)
    print "Cove: video error "; m.video.errorCode; " "; Util.redact(Util.toText(m.video.errorMsg)); " | "; Util.redact(Util.toText(m.video.errorStr)); " | "; Util.redact(formatJson(m.video.errorInfo))
    if m.session <> invalid then print "Cove: was "; m.session.method; " "; m.session.streamFormat
    atSec = m.video.position
    if atSec < 1 then atSec = m.startAt
    if not m.retried
        retryConverted(atSec)
        return
    end if
    m.status.text = "This video can't be played on this Roku." + chr(10) + Util.redact(Util.toText(m.video.errorMsg)) + "  (" + Util.toText(m.video.errorCode) + ")" + chr(10) + "Press Back to return."
    m.status.visible = true
    hideLoading()
end sub

' Every 10 s: progress while playing; while paused a ping plus the paused progress, so the server keeps
' its conversion running (it ends one after about a minute without news)
sub onProgressTimer()
    st = m.video.state
    ' (while paused the position doesn't move, but "Ends at" does)
    if m.osdShown and m.seekTarget < 0 then updateBar(m.video.position)
    ' R-5: the question unanswered for 15 minutes: close (stop report, end the conversion); while it shows,
    ' no ping keeps the server's conversion alive
    if m.still.visible
        if m.stillClock <> invalid and m.stillClock.TotalSeconds() >= 900
            print "Cove: still watching unanswered for 15 min, closing"
            m.still.visible = false
            m.stillKind = ""
            close()
        end if
        return
    end if
    ' (Settings → Playback → Ask if still watching after, 2 hours by default, without a key press: pause and
    ' ask, so a sleeping viewer doesn't stream all night; v1.0 F-11, read once per player). Episodes only:
    ' a movie is never interrupted (v1.0.1)
    if m.idleLimit = invalid then m.idleLimit = Prefs.stillIdleSeconds()
    if st = "playing" and m.idleLimit > 0 and seriesKey() <> "" and m.lastInput.TotalSeconds() >= m.idleLimit and not m.still.visible
        m.video.control = "pause"
        askStill("idle")
        return
    end if
    if st = "playing"
        report("/Sessions/Playing/Progress", false)
    else if st = "paused" and m.session <> invalid
        fire("POST", "/Sessions/Playing/Ping?PlaySessionId=" + Util.toText(m.session.playSessionId), "")
        report("/Sessions/Playing/Progress", true)
    end if
end sub

' The video didn't start: try once with the server converting it, then explain
sub onWatchdog()
    if m.started or m.closing then return
    print "Cove: video didn't start within 45 s (state "; m.video.state; ")"
    atSec = m.startAt
    if not m.retried
        retryConverted(atSec)
        return
    end if
    m.video.control = "stop"
    stopEncoding()
    m.status.text = "The server didn't start the video." + chr(10) + "Try again, or choose a lower quality with *." + chr(10) + "Press Back to return."
    m.status.visible = true
    hideLoading()
end sub

sub retryConverted(atSec as float)
    m.retried = true
    m.watchdog.control = "stop"
    ' (end the first session on the server too, as restartAt does: the retry starts a new PlaySessionId)
    if m.started then report("/Sessions/Playing/Stopped", false, atSec)
    m.video.control = "stop"
    stopEncoding()
    m.started = false
    m.failed = false
    m.progressTimer.control = "stop"
    m.loadNote = "Converting the video for this Roku..."
    start(atSec, true)
end sub

' ---------------------------------------------------------------- skip intro / next episode

sub onPosition()
    syncSubClock(m.video.position)
    if m.osdShown and m.seekTarget < 0 then updateBar(m.video.position)
    p = m.video.position
    if m.video.state <> "playing" or m.upNext.visible or m.still.visible then return
    mk = m.marks
    inIntro = mk.introStart >= 0 and mk.introEnd > mk.introStart and p >= mk.introStart and p < mk.introEnd - 2
    inCredits = mk.credits > 0 and p >= mk.credits
    ' (credits with a known end before the real end: a scene after them, the button goes when it starts)
    if inCredits and m.next = invalid and mk.creditsEnd > mk.credits and p >= mk.creditsEnd - 2 then inCredits = false
    seg = segmentAt(p)
    if inIntro and not m.introDismissed and m.pf.skipIntro
        ' Settings → Skip intros automatically
        m.introDismissed = true
        print "Cove: skipping the intro to "; Int(mk.introEnd); " s"
        m.video.seek = mk.introEnd
        ' (v1.1 P-2, as on the Mac: a notice to go back)
        showSkipNotice(mk.introStart, "Intro skipped · Watch Intro")
    else if inIntro and not m.introDismissed
        showAction("intro", "Skip intro")
    else if seg <> invalid and seg.kind = "recap" and m.pf.skipRecap
        ' Settings → Skip recaps automatically
        m.segsDone[seg.key] = true
        print "Cove: skipping the recap to "; Int(seg.e); " s"
        skipTo(seg.e)
        showSkipNotice(seg.s, "Recap skipped · Watch Recap")
    else if seg <> invalid
        m.actionSeg = seg
        showAction("seg:" + seg.key, Tracks.segmentLabel(seg.kind))
    else if inCredits and not m.creditsDismissed and m.next <> invalid
        ' (PL-8: a film next in a Shuffle queue isn't an episode)
        if nextIsEpisodeItem()
            showAction("next", "Next episode")
        else
            showAction("next", "Up Next")
        end if
    else if inCredits and not m.creditsDismissed
        ' a film or the last episode: no Up next, so the credits get their own button
        showAction("credits", "Skip credits")
    else if m.actionKind <> "" and m.actionKind <> "watch"
        ' (the Watch Intro notice goes by its own 5 s timer)
        hideAction()
    end if
end sub

' (v1.1) After an automatic skip: the notice with a button back to the part's start, for 5 s
sub showSkipNotice(backTo as float, label as string)
    if backTo < 0 then return
    ' (BG-13) a second automatic skip while the first notice shows (a recap right after the intro): one notice
    ' that goes back to the earliest start, so the intro isn't lost
    if m.actionKind = "watch" and m.watchAt >= 0
        if m.watchAt < backTo then backTo = m.watchAt
        label = "Intro and recap skipped · Watch"
    end if
    m.watchAt = backTo
    m.actionKind = ""
    showAction("watch", label)
    m.noticeTimer.control = "stop"
    m.noticeTimer.control = "start"
end sub

sub onNoticeTimer()
    if m.actionKind = "watch" then hideAction()
end sub

sub showAction(kind as string, label as string)
    if m.actionKind = kind then return
    m.actionKind = kind
    m.actionLabel.text = label
    ' (the button grows for a longer label, keeping its right edge)
    w = 270
    est = label.len() * 16 + 64
    if est > w then w = est
    m.actionLabel.width = w
    m.top.findNode("actionBg").width = w
    m.action.translation = [1824 - w, 840]
    m.action.visible = true
    ' (PL-2 / PL-4: not over a menu or the controls in use, where OK belongs to them; the button takes the
    ' remote when the controls hide)
    focusPlayer()
end sub

sub hideAction()
    m.actionKind = ""
    m.action.visible = false
    focusPlayer()
end sub

' The remote to the Skip intro / Next button when it shows over the bare video, else to the player's keys;
' an open menu keeps it
sub focusPlayer()
    if m.picker <> invalid or m.still.visible or m.upNext.visible then return
    if m.action.visible and not m.osdShown
        if not m.action.isInFocusChain() then Speak.say(Speak.button(m.actionLabel.text) + ", press OK")
        m.action.setFocus(true)
    else
        m.keys.setFocus(true)
    end if
end sub

sub useAction()
    k = m.actionKind
    hideAction()
    if k = "intro"
        m.introDismissed = true
        m.video.seek = m.marks.introEnd
    else if k = "watch" and m.watchAt >= 0
        ' (v1.1) Watch Intro / Watch Recap: back to its start; it isn't skipped again in this play
        print "Cove: watch the skipped part from "; Int(m.watchAt); " s"
        m.noticeTimer.control = "stop"
        m.video.seek = m.watchAt
        syncSubClock(m.watchAt)
        m.subLayer.position = m.watchAt
    else if k = "next"
        playNext()
    else if k = "credits"
        m.creditsDismissed = true
        skipCredits()
    else if Left(k, 4) = "seg:" and m.actionSeg <> invalid
        m.segsDone[m.actionSeg.key] = true
        print "Cove: skipping the "; m.actionSeg.kind; " to "; Int(m.actionSeg.e); " s"
        skipTo(m.actionSeg.e)
    end if
end sub

sub dismissAction()
    k = m.actionKind
    if k = "intro" then m.introDismissed = true
    if k = "watch" then m.noticeTimer.control = "stop"
    if k = "next" or k = "credits" then m.creditsDismissed = true
    if Left(k, 4) = "seg:" and m.actionSeg <> invalid then m.segsDone[m.actionSeg.key] = true
    hideAction()
end sub

' The recap / preview / commercial segment playing at p that wasn't skipped or dismissed yet
function segmentAt(p as float) as dynamic
    if m.marks.segs = invalid then return invalid
    for each sg in m.marks.segs
        if p >= sg.s and p < sg.e - 2 and not m.segsDone.doesExist(sg.key) then return sg
    end for
    return invalid
end function

' Jump to t; a jump to the very end (a preview or the credits closing the file) ends the title as if it
' had played to the end (Up next, or the player closes; close() marks it watched from the credits)
sub skipTo(t as float)
    d = m.video.duration
    if d > 0 and t >= d - 3
        print "Cove: skipped to the end"
        if m.next <> invalid and m.pf.autoNext
            ' (Up next runs over a stopped video, as after a real end)
            m.video.control = "stop"
            onFinished()
        else
            close(t)
        end if
        return
    end if
    m.video.seek = t
    syncSubClock(t)
    m.subLayer.position = t
end sub

' Skip credits (no next episode): past their end when a scene follows them, else to the end
sub skipCredits()
    d = m.video.duration
    t = d
    mk = m.marks
    if mk.creditsEnd > mk.credits and (d <= 0 or mk.creditsEnd < d - 10) then t = mk.creditsEnd
    print "Cove: skipping the credits to "; Int(t); " s"
    skipTo(t)
end sub

sub onFinished()
    ' (v1.0 F-10) Cinema Mode: the next intro, then the film (PL-7: before the sleep timer, whose "End of
    ' episode" means the film's end)
    if m.top.item.after <> invalid
        playAfterIntro()
        return
    end if
    ' (v1.0 F-12) sleep timer on "End of episode": the player closes here (PL-10: at the end, since the
    ' Video node's position after stop / finished can read 0)
    if Util.toText(m.sleepMode) = "episode"
        sleepExpire(m.video.duration)
        return
    end if
    ' Settings → Play the next episode automatically (off: the player closes at the end)
    if m.next <> invalid and m.pf.autoNext
        report("/Sessions/Playing/Stopped", false, m.video.duration)
        stopEncoding()
        m.progressTimer.control = "stop"
        m.started = false
        hideAction()
        m.top.findNode("upNextTitle").text = Util.toText(m.next.SeriesName)
        m.top.findNode("upNextEpisode").text = Items.episodeLabel(m.next)
        ' (a film from the Shuffle queue: its name)
        if Util.toText(m.next.Type) <> "Episode" and Util.toText(m.next.Type) <> ""
            m.top.findNode("upNextTitle").text = Util.toText(m.next.Name)
            m.top.findNode("upNextEpisode").text = ""
        end if
        ' Settings → Playback → Up Next countdown (v1.0 F-11): Off starts the next one at once
        secs = Prefs.upNextSeconds()
        if secs <= 0
            m.count = 1
            onCountdown()
            return
        end if
        m.count = secs
        m.top.findNode("upNextCount").text = "Play now  (" + secs.toStr() + ")"
        m.top.findNode("upNextStill").uri = Items.landscape(m.top.server, m.next, 240)
        m.osdShown = false
        m.osd.opacity = 0
        liftSubs(false)
        m.upNext.visible = true
        m.upNext.setFocus(true)
        m.countdown.control = "start"
        Speak.say(Speak.clean("Up next: " + m.top.findNode("upNextTitle").text + ", " + m.top.findNode("upNextEpisode").text) + ". Play now, button, plays in " + secs.toStr() + " seconds")
    else
        close(m.video.duration)
    end if
end sub

sub onCountdown()
    m.count = m.count - 1
    if m.count <= 0
        m.countdown.control = "stop"
        ' Settings → Playback → Are you still watching?: this many episodes in a row without a key press
        ' (PL-8: episodes only, like the idle question: a film from a Shuffle queue is never interrupted)
        lim = m.pf.stillAfter
        nextIsEpisode = nextIsEpisodeItem()
        if lim > 0 and m.autoCount >= lim and nextIsEpisode
            askStill("next")
            return
        end if
        if nextIsEpisode then m.autoCount = m.autoCount + 1
        playNext()
    else
        m.top.findNode("upNextCount").text = "Play now  (" + m.count.toStr() + ")"
    end if
end sub

' The next title is an episode (an unknown type counts as one, as the series' own list)
function nextIsEpisodeItem() as boolean
    if m.next = invalid then return false
    ty = Util.toText(m.next.Type)
    return ty = "Episode" or ty = ""
end function

' The next episode in the same player, keeping the subtitle language
sub playNext()
    playEpisode(m.next)
end sub

' Another episode in the same player, keeping the subtitle language
sub playEpisode(n as dynamic)
    if n = invalid then return
    m.countdown.control = "stop"
    if m.started
        report("/Sessions/Playing/Stopped", false)
        markIfWatched(m.video.position)
    end if
    ' (PL-3: also a conversion still preparing the first picture; DirectPlay or no session: nothing sent)
    stopEncoding()
    keep = Tracks.findSub(m.tracks, m.opts.sub)
    if keep <> invalid then m.subLang = keep.language
    if keep = invalid then m.subLang = ""
    m.video.control = "stop"
    ni = { id: Util.toText(n.Id), title: Util.toText(n.SeriesName), subtitle: Items.episodeLabel(n), start: 0.0 }
    ' Shuffle queue: this one leaves the queue (an episode picked by hand keeps it), films show their name
    if m.queue <> invalid and m.queue.count() > 0
        rest = []
        for i = 0 to m.queue.count() - 1
            if not (i = 0 and Util.toText(m.queue[0].Id) = ni.id) then rest.push(m.queue[i])
        end for
        ni.queue = rest
        if Util.toText(n.Type) <> "Episode" and Util.toText(n.Type) <> ""
            ni.title = Util.toText(n.Name)
            ni.subtitle = ""
        end if
    end if
    m.top.item = ni
end sub

' ---------------------------------------------------------------- * menu: audio, subtitles, quality

sub showMenu()
    opts = [
        { id: "audio", label: "Audio: " + Tracks.audioLabel(m.tracks, effectiveAudio()) },
        { id: "subs", label: "Subtitles: " + Tracks.subLabel(m.tracks, m.opts.sub) },
        { id: "quality", label: "Quality: " + Tracks.qualityLabel(m.opts.maxBitrate) }
    ]
    if m.versions <> invalid and m.versions.count() > 1 then opts.push({ id: "version", label: "Version: " + Tracks.versionLabel(m.versions, Util.toText(m.opts.sourceId)) })
    ' (only on Rokus whose Video node has the playbackSpeed field)
    if speedSupported() then opts.push({ id: "speed", label: "Speed: " + m.speedId + "×" })
    addMenuExtras(opts)
    openPicker("menu", "Playback", opts, "")
end sub

function effectiveAudio() as integer
    if m.opts.audio >= 0 then return m.opts.audio
    return m.opts.defaultAudio
end function

sub openPicker(purpose as string, title as string, options as object, selectedId as string)
    ' (a picker opened from another one keeps the first one's answer)
    if m.picker = invalid then m.pausedByPicker = m.video.state = "playing"
    closePicker()
    if m.video.state = "playing" then m.video.control = "pause"
    p = createObject("roSGNode", "Picker")
    p.purpose = purpose
    p.title = title
    p.selectedId = selectedId
    p.options = options
    p.observeField("chosen", "onPicked")
    p.observeField("cancelled", "onPickerCancelled")
    m.top.appendChild(p)
    m.picker = p
    p.setFocus(true)
end sub

sub closePicker()
    if m.picker <> invalid
        m.picker.unobserveField("chosen")
        m.picker.unobserveField("cancelled")
        m.top.removeChild(m.picker)
        m.picker = invalid
        m.subLayer.sample = ""
        ' (PL-14: hidden again for an Instant replay subtitle)
        m.subLayer.visible = not m.replayReady or m.opts.sub >= 0
        ' (Audio Guide: the focused control is said again)
        m.spokenKey = ""
        refreshPrefs()
    end if
end sub

sub onPickerCancelled()
    ' (Back from the subtitle search: the Subtitles menu again)
    if m.picker <> invalid and (m.picker.purpose = "subsearchlang" or m.picker.purpose = "subresults")
        openSubsMenu()
        return
    end if
    closePicker()
    focusPlayer()
    resumeAfterPicker()
end sub

' Play on only if the picker paused the video: one the user had paused stays paused
sub resumeAfterPicker()
    if m.pausedByPicker and m.video.state = "paused" then resumeVideo()
    m.pausedByPicker = false
end sub

' Play on after a pause; after 5 minutes or more, Settings → Playback → Rewind on resume goes back a little first
sub resumeVideo()
    rw = m.pf.rewind
    if rw > 0 and m.pauseClock <> invalid and m.pauseClock.TotalSeconds() >= 300
        t = m.video.position - rw
        if t < 0 then t = 0
        print "Cove: rewind on resume after "; m.pauseClock.TotalSeconds(); " s paused, to "; Int(t); " s"
        m.video.seek = t
        syncSubClock(t)
        m.subLayer.position = t
    end if
    m.pauseClock = invalid
    m.video.control = "resume"
end sub

sub onPicked(ev as object)
    c = ev.getData()
    if c.purpose = "menu"
        if c.id = "audio"
            o = []
            for each a in m.tracks.audio
                o.push({ id: a.index.toStr(), label: a.label })
            end for
            openPicker("audio", "Audio", o, effectiveAudio().toStr())
        else if c.id = "subs"
            openSubsMenu()
        else if c.id = "quality"
            openPicker("quality", "Quality", Tracks.qualities(), m.opts.maxBitrate.toStr())
        else if c.id = "version"
            cur = Util.toText(m.opts.sourceId)
            if cur = "" then cur = m.versions[0].id
            openPicker("version", "Version", m.versions, cur)
        else if c.id = "speed"
            o = []
            for each r in speedChoices()
                o.push({ id: r, label: r + "×" })
            end for
            openPicker("speed", "Speed", o, m.speedId)
        else
            useMenuExtra(c.id)
        end if
        return
    end if
    ' the Subtitles panel's Style column: applied at once, the panel stays open (a live preview underneath)
    if c.purpose = "subpanel"
        if c.key = "delay"
            ' (at once: the layer shows the cue for position - delay)
            m.subDelayMs = c.id.toInt()
            m.subLayer.delay = m.subDelayMs / 1000.0
            print "Cove: subtitle delay "; delayLabel(m.subDelayMs)
        else
            Util.writeText(c.key, c.id)
            refreshPrefs()
            m.subLayer.restyle = true
            liftSubs(m.osdShown)
        end if
        return
    end if
    if c.purpose = "subs" and c.id = "search"
        openSubSearchLangs()
        return
    end if
    if c.purpose = "subsearchlang"
        searchSubtitles(c.id)
        return
    end if
    if c.purpose = "subresults"
        downloadSubtitle(c.id)
        return
    end if
    closePicker()
    if c.purpose = "chapter"
        seekToChapter(c)
        return
    end if
    if c.purpose = "sleep"
        focusPlayer()
        setSleep(c.id)
        resumeAfterPicker()
        return
    end if
    if c.purpose = "speed"
        focusPlayer()
        setSpeed(c.id)
        drawControls()
        ' (resuming after the picker's pause also applies the new speed)
        resumeAfterPicker()
        return
    end if
    if c.purpose = "version"
        focusPlayer()
        if c.id <> Util.toText(m.opts.sourceId) and c.id <> m.tracks.sourceId
            ' another file: its own tracks (defaults), same position
            m.opts.sourceId = c.id
            m.tracks = Tracks.fromItem(m.info, c.id)
            m.opts.audio = -1
            m.opts.sub = -1
            m.opts.burn = false
            m.opts.defaultAudio = Tracks.defaultAudio(m.tracks)
            chooseStartAudio()
            buildTools()
            restartAt(m.video.position)
        else
            resumeAfterPicker()
        end if
        return
    end if
    if c.purpose = "episode"
        focusPlayer()
        if c.id = m.top.item.id then resumeAfterPicker()
        for each e in m.episodes
            if Util.toText(e.Id) = c.id and c.id <> m.top.item.id then playEpisode(e)
        end for
        drawControls()
        return
    end if
    v = c.id.toInt()
    restart = false
    if c.purpose = "audio" and v <> effectiveAudio()
        m.opts.audio = v
        ' (v1.1) the language is kept for the series' next episodes
        rememberAudio(v)
        restart = true
    else if c.purpose = "quality" and v <> m.opts.maxBitrate
        m.opts.maxBitrate = v
        restart = true
    else if c.purpose = "subs" and v <> m.opts.sub
        s = Tracks.findSub(m.tracks, v)
        wasBurned = m.opts.burn
        m.opts.sub = v
        m.opts.burn = s <> invalid and not s.isText
        if s <> invalid then m.subLang = s.language
        if s = invalid then m.subLang = "off"
        ' remembered for the series, like on the Mac
        if seriesKey() <> "" and m.subLang <> "" then Prefs.setSeriesSubLang(seriesKey(), m.subLang)
        ' Text subtitles are Cove's own layer, so switching them is on the spot; a burned-in one (to or from)
        ' needs the stream again
        if wasBurned or m.opts.burn
            clearSubs()
            restart = true
        else
            loadTextSub()
        end if
    end if
    focusPlayer()
    print "Cove: picked "; c.purpose; " "; c.id; " restart="; restart
    drawControls()
    if restart
        restartAt(m.video.position)
    else
        resumeAfterPicker()
    end if
end sub

' Same item, new settings, same position
sub restartAt(atSec as float)
    ' (PL-1: still loading, the Video node's position is 0 until PlayStart applies: keep the resume point)
    if not m.started then atSec = m.startAt
    ' (PL-15: a video the user had paused stays paused once the new stream plays)
    m.pauseOnStart = m.started and m.video.state = "paused" and not m.pausedByPicker
    m.pausedByPicker = false
    if m.started then report("/Sessions/Playing/Stopped", false, atSec)
    stopEncoding()
    m.video.control = "stop"
    m.started = false
    m.retried = false
    m.failed = false
    m.progressTimer.control = "stop"
    m.watchdog.control = "stop"
    start(atSec, false)
end sub

' ---------------------------------------------------------------- keys, leaving

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    ' (any key: someone is watching)
    noteInput()
    if m.still.visible
        stillKey(key)
        return true
    end if
    if m.upNext.visible
        if key = "OK" or key = "play"
            playNext()
        else if key = "back"
            m.countdown.control = "stop"
            close()
        end if
        return true
    end if
    if m.action.visible and m.action.isInFocusChain()
        if key = "OK"
            useAction()
        else if key = "back"
            dismissAction()
        else
            dismissAction()
            return onKeyEvent(key, press)
        end if
        return true
    end if
    if key = "options"
        showMenu()
        return true
    else if key = "replay"
        instantReplay()
        return true
    else if key = "rewind" or key = "fastforward"
        ' Settings → Playback → Jump buttons
        if key = "fastforward"
            seekBy(m.pf.jump)
        else
            seekBy(-m.pf.jump)
        end if
        return true
    else if key = "play"
        togglePause()
        return true
    end if
    if not m.osdShown
        ' controls hidden: quick keys
        if key = "back"
            leavePlayer()
        else if key = "OK"
            togglePause()
        else if key = "left"
            seekBy(-m.pf.skip)
        else if key = "right"
            seekBy(m.pf.skip)
        else
            showOsd(true)
        end if
        return true
    end if
    ' controls shown: move between the buttons
    m.hideTimer.control = "stop"
    if m.video.state = "playing" then m.hideTimer.control = "start"
    if key = "back"
        if m.seekTarget >= 0
            m.seekTimer.control = "stop"
            m.seekTarget = -1
            updateBar(m.video.position)
        else if m.video.state = "paused"
            leavePlayer()
        else
            m.osdShown = false
            m.spokenKey = ""
            fadeOsd(0.0)
            focusPlayer()
        end if
    else if m.area = "bar" and (key = "left" or key = "right")
        ' the progress bar has the focus: Left / Right move along it (presses add up, thumbnail shows)
        if key = "left"
            seekBy(-m.pf.skip)
        else
            seekBy(m.pf.skip)
        end if
    else if key = "left"
        if m.idx > 0 then m.idx = m.idx - 1
        drawControls()
    else if key = "right"
        if m.idx < areaSize() - 1 then m.idx = m.idx + 1
        drawControls()
    else if key = "down" and m.area = "center"
        setArea("bar", 0)
    else if key = "down" and m.area = "bar" and m.toolIds.count() > 0
        ' (v1.1 U-3: the first tool, back, not the rightmost)
        setArea("tools", 0)
    else if key = "up" and m.area = "tools"
        setArea("bar", 0)
    else if key = "up" and m.area = "bar"
        setArea("center", playIndex())
    else if key = "OK"
        if m.area = "bar"
            togglePause()
        else
            useControl()
        end if
    end if
    return true
end function

' ---------------------------------------------------------------- controls

sub setArea(area as string, idx as integer)
    m.area = area
    m.idx = idx
    drawControls()
    updateBar(currentPos())
end sub

function areaSize() as integer
    if m.area = "tools" then return m.toolIds.count()
    if m.area = "bar" then return 1
    return centerIds().count()
end function

' Centre buttons: previous episode, play / pause, next episode (episodes); play / pause alone otherwise
' (an episode found in its series' list: a special outside the list has no previous / next / episodes)
function hasEpisodes() as boolean
    return m.episodes.count() > 0 and m.epIndex >= 0
end function

function centerIds() as object
    if hasEpisodes() then return ["prev", "play", "next"]
    return ["play"]
end function

' the play / pause button's place in the centre row
function playIndex() as integer
    if hasEpisodes() then return 1
    return 0
end function

sub togglePause()
    if m.seekTarget >= 0
        applySeek()
    else if m.video.state = "playing"
        m.video.control = "pause"
    else if m.video.state = "paused"
        resumeVideo()
    end if
    showOsd(true)
end sub

sub useControl()
    if m.area = "center"
        ids = centerIds()
        if m.idx >= ids.count() then m.idx = playIndex()
        cid = ids[m.idx]
        if cid = "prev"
            playEpisode(m.prev)
        else if cid = "next"
            playEpisode(m.next)
        else
            togglePause()
        end if
        return
    end if
    id = m.toolIds[m.idx]
    if id = "jumpBack"
        seekBy(-m.pf.jump)
    else if id = "jumpFwd"
        seekBy(m.pf.jump)
    else if id = "prev"
        playEpisode(m.prev)
    else if id = "next"
        playEpisode(m.next)
    else if id = "episodes"
        showEpisodes()
    else if id = "subs"
        openSubsMenu()
    else if id = "audio"
        o = []
        for each a in m.tracks.audio
            o.push({ id: a.index.toStr(), label: a.label })
        end for
        openPicker("audio", "Audio", o, effectiveAudio().toStr())
    else if id = "quality"
        openPicker("quality", "Quality", Tracks.qualities(), m.opts.maxBitrate.toStr())
    else if id = "chapters"
        showChapters()
    else if id = "chapPrev"
        jumpChapter(-1)
    else if id = "chapNext"
        jumpChapter(1)
    end if
end sub

' The episodes of the current season in the side panel; OK plays one
sub showEpisodes()
    if m.epIndex < 0 then return
    season = Util.toText(m.episodes[m.epIndex].SeasonId)
    o = []
    for each e in m.episodes
        if Util.toText(e.SeasonId) = season
            l = Util.toText(e.IndexNumber) + ".  " + Util.toText(e.Name)
            if Util.flag(e.UserData, "Played") then l = l + "  ·  watched"
            o.push({ id: Util.toText(e.Id), label: l })
        end if
    end for
    openPicker("episode", Util.toText(m.episodes[m.epIndex].SeasonName), o, m.top.item.id)
end sub

' Bottom-right buttons: back / forward (Settings → Playback → Jump buttons), episodes (episodes only), subtitles, audio, quality, chapters
' (previous / next episode are in the centre, beside play)
sub buildTools()
    ' (the focused tool stays focused when buttons are added, e.g. the episode list arriving late)
    keep = ""
    if m.area = "tools" and m.idx < m.toolIds.count() then keep = m.toolIds[m.idx]
    ids = ["jumpBack", "jumpFwd"]
    if hasEpisodes() then ids.push("episodes")
    if m.tracks.subs.count() > 0 then ids.push("subs")
    if m.tracks.audio.count() > 1 then ids.push("audio")
    ids.push("quality")
    if chapterEntries().count() > 0
        ids.push("chapters")
        ' (v1.1) previous / next chapter
        if chapterEntries().count() > 1
            ids.push("chapPrev")
            ids.push("chapNext")
        end if
    end if
    m.toolIds = ids
    if keep <> ""
        for i = 0 to ids.count() - 1
            if ids[i] = keep then m.idx = i
        end for
    end if
    if m.area = "tools" and m.idx >= ids.count() then m.idx = ids.count() - 1
    drawControls()
end sub

function toolIcon(id as string) as string
    if id = "subs" then return "subtitles"
    ' (the icon shows the jump length from Settings → Playback → Jump buttons: back10 ... fwd60)
    if id = "jumpBack" then return "back" + m.pf.jump.toStr()
    if id = "jumpFwd" then return "fwd" + m.pf.jump.toStr()
    if id = "chapPrev" then return "chapprev"
    if id = "chapNext" then return "chapnext"
    return id
end function

' (v1.1 U-2) The caption over the focused tool: its name, and the current value for subtitles / audio /
' quality ("Subtitles · English"). It sits above the capsule: the scrubber is right under it.
function toolCaption(id as string) as string
    j = m.pf.jump.toStr()
    if id = "jumpBack" then return "Back " + j + " s"
    if id = "jumpFwd" then return "Forward " + j + " s"
    if id = "episodes" then return "Episodes"
    if id = "subs" then return captionWithValue("Subtitles", Tracks.subLabel(m.tracks, m.opts.sub))
    if id = "audio" then return captionWithValue("Audio", Tracks.audioLabel(m.tracks, effectiveAudio()))
    if id = "quality" then return captionWithValue("Quality", Tracks.qualityLabel(m.opts.maxBitrate))
    if id = "chapters" then return "Chapters"
    if id = "chapPrev" then return "Previous Chapter"
    if id = "chapNext" then return "Next Chapter"
    return ""
end function

' "Audio · English 5.1" (the current value, cut to fit one short line)
function captionWithValue(name as string, value as string) as string
    if value = "" then return name
    t = name + " · " + value
    if t.len() > 44 then t = Left(t, 42).trim() + "..."
    return t
end function

sub drawControls()
    focused = m.osdShown and m.picker = invalid
    ' centre: 69 px circles for previous / next episode, 105 px for play / pause
    c = m.top.findNode("center")
    c.removeChildrenIndex(c.getChildCount(), 0)
    playing = m.video.state = "playing" or m.video.state = "buffering"
    playIcon = "pause_48"
    if not playing then playIcon = "play_48"
    specs = [{ size: 105, icon: playIcon, isz: 48, x: 908, dim: false }]
    if hasEpisodes()
        specs = [
            { size: 69, icon: "prev_36", isz: 36, x: 798, dim: m.prev = invalid },
            specs[0],
            { size: 69, icon: "next_36", isz: 36, x: 1053, dim: m.next = invalid }
        ]
    end if
    for i = 0 to specs.count() - 1
        s = specs[i]
        isFocus = focused and m.area = "center" and m.idx = i
        g = c.createChild("Group")
        y = 540 - s.size / 2
        g.translation = [s.x, y]
        g.scaleRotateCenter = [s.size / 2, s.size / 2]
        bg = g.createChild("Poster")
        bg.width = s.size
        bg.height = s.size
        ic = g.createChild("Poster")
        ic.uri = "pkg:/images/ui/icon_" + s.icon + ".png"
        ic.width = s.isz
        ic.height = s.isz
        ic.translation = [(s.size - s.isz) / 2, (s.size - s.isz) / 2]
        if isFocus
            bg.uri = "pkg:/images/ui/white_circle_" + s.size.toStr() + ".png"
            ic.blendColor = "0x000000FF"
            g.scale = [1.08, 1.08]
        else
            bg.uri = "pkg:/images/ui/glass_circle_" + s.size.toStr() + ".png"
            ic.blendColor = "0xFFFFFFFF"
            ' (no previous / next episode)
            if s.dim then ic.blendColor = "0xFFFFFF59"
        end if
    end for
    ' bottom-right: icons in a glass capsule, right-aligned above the scrubber
    tl = m.top.findNode("tools")
    tl.removeChildrenIndex(tl.getChildCount(), 0)
    n = m.toolIds.count()
    if n = 0 then return
    gap = 62
    w = n * gap + 14
    tl.translation = [1896 - w, 878]
    pill = tl.createChild("Poster")
    pill.uri = "pkg:/images/ui/glass_pill.9.png"
    pill.width = w
    pill.height = 70
    accent = m.global.theme.accent
    for i = 0 to n - 1
        id = m.toolIds[i]
        isFocus = focused and m.area = "tools" and m.idx = i
        x = 7 + i * gap + 3
        if isFocus
            bg = tl.createChild("Poster")
            bg.uri = "pkg:/images/ui/white_circle_56.png"
            bg.width = 56
            bg.height = 56
            bg.translation = [x, 7]
        end if
        ic = tl.createChild("Poster")
        ic.uri = "pkg:/images/ui/icon_" + toolIcon(id) + "_36.png"
        ic.width = 36
        ic.height = 36
        ic.translation = [x + 10, 17]
        col = "0xFFFFFFFF"
        if id = "subs" and m.opts.sub >= 0 then col = accent
        if isFocus then col = "0x000000FF"
        ic.blendColor = col
        if isFocus then drawToolCaption(tl, toolCaption(id), x + 28, w)
    end for
    if focused then speakControl()
end sub

' (v1.1 U-2) A small caption above the focused tool icon (cx: the icon's centre in the capsule, capW: the
' capsule's width; the caption stays inside the screen)
sub drawToolCaption(tl as object, text as string, cx as integer, capW as integer)
    if text = "" then return
    w = text.len() * 13 + 32
    x = cx - w \ 2
    if x + w > capW then x = capW - w
    g = tl.createChild("Group")
    g.translation = [x, -50]
    bg = g.createChild("Poster")
    bg.uri = "pkg:/images/ui/panel_dark_r18.9.png"
    bg.width = w
    bg.height = 40
    lb = g.createChild("Label")
    lb.width = w
    lb.height = 40
    lb.horizAlign = "center"
    lb.vertAlign = "center"
    lb.color = "0xFFFFFFFF"
    f = createObject("roSGNode", "Font")
    f.uri = "font:MediumSystemFontFile"
    f.size = 24
    lb.font = f
    lb.text = text
end sub

' ---------------------------------------------------------------- Audio Guide

' The focused control: "Pause, button, 2 of 3"; "Subtitles: Romanian, button, 4 of 6"; on the bar the
' position, "12 minutes 5 seconds of 45 minutes"
sub speakControl()
    if not Speak.isOn() then return
    text = ""
    if m.area = "bar"
        text = "Progress, " + positionSpeech(currentPos()) + ". Left or Right to move, OK to pause"
        if m.video.state = "paused" then text = "Progress, " + positionSpeech(currentPos()) + ", paused. Left or Right to move, OK to play"
        key = "bar" + m.video.state
    else if m.area = "center"
        ids = centerIds()
        if m.idx >= ids.count() then return
        cid = ids[m.idx]
        label = "Pause"
        if not (m.video.state = "playing" or m.video.state = "buffering") then label = "Play"
        if cid = "prev"
            label = "Previous episode"
            if m.prev = invalid then label = label + ", unavailable"
        else if cid = "next"
            label = "Next episode"
            if m.next = invalid then label = label + ", unavailable"
        end if
        text = Speak.button(label) + Speak.position(m.idx, ids.count())
        key = "c" + text
    else
        if m.idx >= m.toolIds.count() then return
        text = Speak.button(toolSpeech(m.toolIds[m.idx])) + Speak.position(m.idx, m.toolIds.count())
        key = "t" + text
    end if
    if key = m.spokenKey then return
    m.spokenKey = key
    Speak.say(Speak.clean(text))
end sub

function positionSpeech(atSec as float) as string
    d = m.video.duration
    if d <= 0 then return Speak.duration(atSec)
    return Speak.duration(atSec) + " of " + Speak.duration(d)
end function

function toolSpeech(id as string) as string
    j = m.pf.jump.toStr()
    if id = "jumpBack" then return "Back " + j + " seconds"
    if id = "jumpFwd" then return "Forward " + j + " seconds"
    if id = "episodes" then return "Episodes"
    if id = "subs" then return "Subtitles: " + Tracks.subLabel(m.tracks, m.opts.sub)
    if id = "audio" then return "Audio: " + Tracks.audioLabel(m.tracks, effectiveAudio())
    if id = "quality" then return "Quality: " + Tracks.qualityLabel(m.opts.maxBitrate)
    if id = "chapters" then return "Chapters"
    if id = "chapPrev" then return "Previous chapter"
    if id = "chapNext" then return "Next chapter"
    return id
end function

sub showOsd(autoHide as boolean)
    if not m.osdShown
        m.osdShown = true
        ' the progress bar starts with the focus (Left / Right seek), Up: the centre buttons, Down: the tools
        m.area = "bar"
        m.idx = 0
        fadeOsd(1.0)
        ' (PL-4: the controls take the remote from the Skip intro / Next button, which stays on screen)
        if m.action.isInFocusChain() then m.keys.setFocus(true)
    end if
    updateBar(currentPos())
    drawControls()
    m.hideTimer.control = "stop"
    if autoHide and m.video.state = "playing" then m.hideTimer.control = "start"
end sub

sub hideOsd()
    if m.video.state = "paused" or m.seekTarget >= 0 or m.picker <> invalid then return
    m.osdShown = false
    m.spokenKey = ""
    fadeOsd(0.0)
    focusPlayer()
end sub

sub fadeOsd(target as float)
    liftSubs(target > 0)
    a = m.top.findNode("osdAnim")
    a.control = "stop"
    m.top.findNode("osdFade").keyValue = [m.osd.opacity, target]
    a.control = "start"
end sub

function currentPos() as float
    if m.seekTarget >= 0 then return m.seekTarget
    return m.video.position
end function

' Presses add up: the bar shows where playback will continue, the jump happens 0.8 s after the last press
sub seekBy(delta as integer)
    if m.session = invalid then return
    target = currentPos() + delta
    d = m.video.duration
    if target < 0 then target = 0
    if d > 0 and target > d - 5 then target = d - 5
    m.seekTarget = target
    showOsd(false)
    m.seekTimer.control = "stop"
    m.seekTimer.control = "start"
    ' (each press replaces the last: only where it lands is heard)
    Speak.say(positionSpeech(target))
end sub

sub applySeek()
    m.seekTimer.control = "stop"
    if m.seekTarget < 0 then return
    m.video.seek = m.seekTarget
    syncSubClock(m.seekTarget)
    m.subLayer.position = m.seekTarget
    m.seekTarget = -1
    if m.video.state = "paused" then m.video.control = "resume"
    m.hideTimer.control = "start"
end sub

sub updateBar(atSec as float)
    d = m.video.duration
    drawChapterTicks(d)
    frac = 0.0
    if d > 0 then frac = atSec / d
    if frac > 1 then frac = 1
    if frac < 0 then frac = 0
    ' (the track ends before "Ends at" and the time left)
    w = Int(1380 * frac)
    m.top.findNode("fill").width = w
    ' focused bar: thicker line and a bigger knob
    barFocus = m.osdShown and m.area = "bar" and m.picker = invalid
    sz = 22
    lineH = 6
    if barFocus
        sz = 36
        lineH = 10
    end if
    th = m.top.findNode("thumb")
    th.width = sz
    th.height = sz
    th.translation = [130 + w - sz / 2, 33 - sz / 2]
    for each id in ["track", "fill"]
        r = m.top.findNode(id)
        r.height = lineH
        r.translation = [130, 33 - lineH / 2]
    end for
    m.top.findNode("elapsed").text = Playback.clock(atSec)
    showPreview(atSec, 154 + w)
    remain = d - atSec
    if remain < 0 then remain = 0
    if d > 0
        m.top.findNode("remaining").text = "-" + Playback.clock(remain)
        m.top.findNode("endsAt").text = endsAtClock(remain)
    else
        m.top.findNode("remaining").text = ""
        m.top.findNode("endsAt").text = ""
    end if
end sub

' "Ends at 10:41 PM": the Roku's local time, in its clock format (v1.1 Clock.bs), after remain seconds of
' video at the current playback speed
function endsAtClock(remain as float) as string
    rate = m.speed
    if rate <= 0 then rate = 1.0
    return Clock.endsAtText(Int(remain / rate + 0.5))
end function

' Play / pause symbol follows the state
sub updateCenter()
    if m.osdShown then drawControls()
end sub

' Report the stop (the server saves the position / marks it watched), end the server's conversion, then leave
' ---------------------------------------------------------------- seek thumbnails

' (SP-15) The deferred BIF download (the timer, or the first seek)
sub startDeferredThumbs()
    s = m.thumbStream
    if s = invalid or m.thumbs <> invalid then return
    m.thumbStream = invalid
    m.thumbTimer.control = "stop"
    loadThumbs(s)
end sub

sub loadThumbs(s as object)
    m.thumbs = { kind: "none" }
    srv = m.top.server
    if Util.toText(srv.type) = "jellyfin"
        if m.info <> invalid
            tp = Playback.trickplayInfo(srv, m.info, Util.toText(s.mediaSourceId))
            if tp <> invalid
                tp.kind = "tiles"
                m.thumbs = tp
                print "Cove: trickplay "; tp.width; "x"; tp.height; " every "; tp.interval; " ms"
            end if
        end if
        return
    end if
    ' Emby: download the BIF file once (a few MB at 320 px)
    ' (a file per title: after an episode switch the old download can still be writing its own)
    path = "tmp:/cove-" + m.top.item.id + ".bif"
    DeleteFile(path)
    url = "/Videos/" + m.top.item.id + "/index.bif?Width=320&MediaSourceId=" + Util.toText(s.mediaSourceId)
    print "Cove: GET "; url
    t = createObject("roSGNode", "ApiTask")
    t.request = { method: "GET", url: Util.toText(srv.url) + url, headers: Api.headers(srv, true), saveTo: path, timeout: 60000, tag: { kind: "bif", itemId: m.top.item.id, path: path } }
    t.observeField("response", "onResponse")
    m.bifTask = t
    m.bifPath = path
    m.pending.push(t)
    t.control = "RUN"
end sub

sub onBif(r as object)
    print "Cove:   -> "; r.code; " (thumbnails)"
    if r.tag.itemId <> m.top.item.id or r.code <> 200
        DeleteFile(Util.toText(r.tag.path))
        return
    end if
    b = Playback.readBif(r.tag.path)
    if b = invalid
        print "Cove: no usable BIF"
        return
    end if
    b.kind = "bif"
    m.thumbs = b
    n = b.offsets.count() - 1
    gapMs = 0
    if n > 1 then gapMs = b.times[1] - b.times[0]
    print "Cove: BIF "; n; " frames, every "; gapMs; " ms"
end sub

' The frame for atSec above the scrubber at x (only while seeking)
sub showPreview(atSec as float, x as integer)
    pv = m.top.findNode("preview")
    if m.thumbs = invalid and m.thumbStream <> invalid then startDeferredThumbs()
    th = m.thumbs
    if m.seekTarget < 0 or th = invalid or th.kind = "none"
        pv.visible = false
        return
    end if
    px = x - 168
    if px < 24 then px = 24
    if px > 1896 - 336 then px = 1896 - 336
    pv.translation = [px, 712]
    m.top.findNode("previewTime").text = Playback.clock(atSec)
    img = m.top.findNode("previewImg")
    if th.kind = "bif"
        ' the last frame at or before atSec (binary search over the frame times)
        ms = atSec * 1000
        lo = 0
        hi = th.offsets.count() - 2
        i = 0
        while lo <= hi
            mid = (lo + hi) \ 2
            if th.times[mid] >= 0 and th.times[mid] <= ms
                i = mid
                lo = mid + 1
            else
                hi = mid - 1
            end if
        end while
        if i <> m.thumbShown
            f = "tmp:/cove_th" + i.toStr() + ".jpg"
            if not m.thumbFiles.doesExist(f)
                ba = createObject("roByteArray")
                start_ = th.offsets[i]
                size = th.offsets[i + 1] - start_
                if size <= 0 or not ba.readFile(th.path, start_, size) then return
                ba.writeFile(f)
                m.thumbFiles[f] = true
            end if
            img.width = 320
            img.height = 180
            img.translation = [0, 0]
            img.uri = f
            m.thumbShown = i
        end if
    else
        i = Int(atSec * 1000 / th.interval)
        if th.count <> invalid and i >= th.count then i = th.count - 1
        per = th.cols * th.rows
        tile = i \ per
        within = i mod per
        col = within mod th.cols
        row = within \ th.cols
        ' one tile image holds cols x rows thumbnails: scale it so one is 320 x 180 and shift it under the clip
        img.width = 320 * th.cols
        img.height = 180 * th.rows
        img.translation = [-col * 320, -row * 180]
        img.uri = th.url + tile.toStr() + th.query
    end if
    pv.visible = true
end sub

sub clearThumbFiles()
    if m.thumbFiles = invalid then return
    for each f in m.thumbFiles
        DeleteFile(f)
    end for
    m.thumbFiles = {}
    if m.bifPath <> "" then DeleteFile(m.bifPath)
    ' a download still running deletes its file when it ends (the player is gone or on another title)
    if m.bifTask <> invalid then m.bifTask.discard = true
    m.bifTask = invalid
    m.bifPath = ""
end sub

' atSec: where the title was left (PL-10: given at the end, when the Video node may already read 0)
sub close(atSec = -1.0 as float)
    if m.closing then return
    m.closing = true
    m.subTimer.control = "stop"
    m.progressTimer.control = "stop"
    m.countdown.control = "stop"
    m.watchdog.control = "stop"
    m.hideTimer.control = "stop"
    m.seekTimer.control = "stop"
    if atSec <= 0 then atSec = m.video.position
    m.video.control = "stop"
    if m.started then report("/Sessions/Playing/Stopped", false, atSec)
    markIfWatched(atSec)
    stopEncoding()
    ' still preparing a stream: drop it, but end the conversion when the server answers
    if m.playTask <> invalid then orphanPlayTask(m.playTask)
    m.playTask = invalid
    clearThumbFiles()
    m.closeTimer.control = "start"
end sub

' The scene removes the player for a deep link: stop like Back, without "done"
sub onStopNow()
    if not m.top.stopNow then return
    closePicker()
    close()
    m.closeTimer.control = "stop"
end sub

sub finish()
    m.top.done = true
end sub

sub stopEncoding()
    stopEncodingFor(m.session)
end sub

sub stopEncodingFor(s as dynamic)
    if s = invalid or s.method = "DirectPlay" then return
    path = "/Videos/ActiveEncodings?DeviceId=" + Util.deviceId() + "&PlaySessionId=" + Util.toText(s.playSessionId)
    fire("DELETE", path, "")
    ' again after 2 s and 6 s: a conversion the server was still starting can survive the first one
    fire("DELETE", path, "", 2000)
    fire("DELETE", path, "", 6000)
end sub

' Closing past 90 % (or in the credits) counts as watched, like on the Mac
sub markIfWatched(atSec as float)
    if isIntro() then return
    d = m.video.duration
    if m.info = invalid or d <= 0 or Util.flag(m.info.UserData, "Played") then return
    inCredits = m.marks.credits > 0 and atSec >= m.marks.credits
    if atSec < d * 0.9 and not inCredits then return
    print "Cove: marking watched at "; Int(atSec); " of "; Int(d); " s"
    uid = Util.toText(m.top.server.userId)
    ' Emby and Jellyfin up to 10.8 know only /Users/{id}/PlayedItems; Jellyfin 10.9+ also /UserPlayedItems, used
    ' if the first answers 404 (as on Home)
    fallback = ""
    if Util.toText(m.top.server.type) = "jellyfin" then fallback = "/UserPlayedItems/" + m.top.item.id + "?userId=" + uid
    fire("POST", "/Users/" + uid + "/PlayedItems/" + m.top.item.id, "", 0, fallback)
    if Util.isAA(m.info.UserData) then m.info.UserData.Played = true
end sub

sub report(path as string, paused as boolean, atSec = -1 as float)
    s = m.session
    if s = invalid then return
    ' (PL-7: a Cinema Mode intro isn't reported, so the server doesn't mark it played or list it in the history)
    if isIntro() then return
    if atSec < 0 then atSec = m.video.position
    if atSec > 0 then m.lastPos = atSec
    fire("POST", path, Playback.reportBody(s, m.lastPos, paused))
end sub

' ---------------------------------------------------------------- requests

sub get(path as string, tag as object)
    t = createObject("roSGNode", "ApiTask")
    t.request = { method: "GET", url: Util.toText(m.top.server.url) + path, headers: Api.headers(m.top.server, true), body: "", tag: tag, timeout: 15000 }
    t.observeField("response", "onResponse")
    m.pending.push(t)
    t.control = "RUN"
end sub

sub onResponse(ev as object)
    t = ev.getRoSGNode()
    for i = 0 to m.pending.count() - 1
        if m.pending[i].isSameNode(t)
            m.pending.delete(i)
            exit for
        end if
    end for
    r = ev.getData()
    k = r.tag.kind
    ' (left, or removed for a deep link: late answers would start a new stream)
    if m.closing then return
    if k = "user"
        ' (v1.1) the account's audio preference (kept for the session), then the item
        if r.tag.itemId <> m.top.item.id then return
        json = invalid
        if r.code = 200 then json = r.json
        if r.code <> 200 then print "Cove: user settings -> "; r.code
        Tracks.rememberServerAudio(m.top.server, json)
        m.waitUser = false
        startWhenReady()
    else if k = "info"
        if r.tag.itemId <> m.top.item.id then return
        m.infoAnswer = r
        startWhenReady()
    else if k = "bif"
        onBif(r)
    else if k = "subProbe"
        onSubProbe(r)
    else if (k = "segments" or k = "episodes" or k = "epSeries") and r.tag.itemId <> m.top.item.id
        ' (the previous episode's answer after Next / Episodes)
        return
    else if k = "segments" and r.code = 200
        m.marks = Tracks.fromSegments(r.json, m.marks)
    else if k = "epSeries"
        ' (C2-4) the series' rating for its unrated episodes, then the list as below
        if r.code = 200 then Ratings.rememberSeries(m.top.server, r.tag.ids, r.json)
        list = m.epWaiting
        m.epWaiting = invalid
        if type(list) = "roArray" then useEpisodes(list)
    else if k = "episodes" and r.code = 200 and r.json <> invalid
        ' the series' episodes: previous / next and the Episodes panel
        list = r.json.Items
        if type(list) = "roArray"
            ' (C2-4: only the episodes the profile's rating limit allows; an unrated one takes its series' rating)
            ids = Ratings.missingSeries(m.top.server, list)
            if ids.count() > 0
                m.epWaiting = list
                get(Ratings.seriesPath(m.top.server, ids), { kind: "epSeries", itemId: m.top.item.id, ids: ids })
                return
            end if
            useEpisodes(list)
        end if
    end if
end sub

' The series' episodes the profile may see: previous / next and the Episodes panel (C2-4)
sub useEpisodes(fullList as object)
    ' (the episode playing stays in, so previous / next are still found around it)
    list = []
    for each ep in fullList
        if Util.isAA(ep) and (Util.toText(ep.Id) = m.top.item.id or Ratings.allowed(m.top.server, ep)) then list.push(ep)
    end for
    m.episodes = list
    for i = 0 to list.count() - 1
        if Util.toText(list[i].Id) = m.top.item.id
            m.epIndex = i
            if i > 0 then m.prev = list[i - 1]
            if i + 1 < list.count() then m.next = list[i + 1]
        end if
    end for
    useQueue()
    ' (prev / next join the centre row: keep the focus on play)
    if m.area = "center" then m.idx = playIndex()
    buildTools()
end sub

' A request whose answer nobody waits for. The task is parked in the scene's "tasks" group so it keeps running
' after this screen is gone (finished ones are cleared each time).
sub fire(method as string, path as string, body as string, delay = 0 as integer, fallbackPath = "" as string)
    holder = tasksHolder()
    t = createObject("roSGNode", "ApiTask")
    req = { method: method, url: Util.toText(m.top.server.url) + path, headers: Api.headers(m.top.server, true), body: body, delay: delay, tag: { kind: "fire" } }
    if fallbackPath <> "" then req.fallbackUrl = Util.toText(m.top.server.url) + fallbackPath
    t.request = req
    if holder = invalid
        ' (no scene any more: keep it referenced here instead)
        m.pending.push(t)
        t.control = "RUN"
        return
    end if
    for i = holder.getChildCount() - 1 to 0 step -1
        if holder.getChild(i).state = "done" or holder.getChild(i).state = "stop" then holder.removeChildIndex(i)
    end for
    holder.appendChild(t)
    t.control = "RUN"
end sub

' The scene's "tasks" group, saved while the player is on screen: a late answer after Back runs on a node
' that has left the scene, where getScene() is invalid
function tasksHolder() as dynamic
    if m.tasksHolder = invalid
        sc = m.top.getScene()
        if sc <> invalid then m.tasksHolder = sc.findNode("tasks")
    end if
    return m.tasksHolder
end function

sub onFocusChanged()
    if not m.top.hasFocus() then return
    if m.picker <> invalid
        m.picker.setFocus(true)
    else if m.still.visible
        m.still.setFocus(true)
    else if m.upNext.visible
        m.upNext.setFocus(true)
    else if m.action.visible and not m.osdShown
        m.action.setFocus(true)
    else
        m.keys.setFocus(true)
    end if
end sub

' ---------------------------------------------------------------- chapters (Cove for macOS: chaptersPanel)

' The item's chapters without the intro / credits markers → [{ index, name, start, image }]; index is the
' position in the server's list (the chapter image is asked for by that number)
function chapterEntries() as object
    out = []
    if m.info = invalid or type(m.info.Chapters) <> "roArray" then return out
    list = m.info.Chapters
    for i = 0 to list.count() - 1
        ch = list[i]
        mt = Util.toText(ch.MarkerType)
        if mt = "" or mt = "Chapter"
            label = Util.toText(ch.Name)
            if label = "" then label = "Chapter " + (i + 1).toStr()
            img = Items.imageUrl(m.top.server, m.top.item.id, "Chapter/" + i.toStr(), Util.toText(ch.ImageTag), 320)
            out.push({ index: i, name: label, start: Playback.seconds(ch.StartPositionTicks), image: img })
        end if
    end for
    return out
end function

' Side panel with the chapters; OK jumps to one. Handled like the other panels (m.picker), so focus, the
' paused video and Back work the same.
sub showChapters()
    list = chapterEntries()
    if list.count() = 0 then return
    fromPicker = m.picker <> invalid
    closePicker()
    atSec = m.video.position
    cur = 0
    for i = 0 to list.count() - 1
        if list[i].start <= atSec + 1 then cur = i
    end for
    ' (opened from the tools: remember whether this panel paused the video, as openPicker does)
    if not fromPicker then m.pausedByPicker = m.video.state = "playing"
    if m.video.state = "playing" then m.video.control = "pause"
    p = createObject("roSGNode", "ChapterPanel")
    p.current = cur
    p.chapters = list
    p.observeField("chosen", "onPicked")
    p.observeField("cancelled", "onPickerCancelled")
    m.top.appendChild(p)
    m.picker = p
    p.setFocus(true)
    print "Cove: chapters panel, "; list.count(); " chapters, at "; cur
end sub

sub seekToChapter(c as object)
    focusPlayer()
    print "Cove: chapter "; c.id; " at "; Int(c.start); " s"
    m.seekTarget = -1
    m.seekTimer.control = "stop"
    m.video.seek = c.start
    syncSubClock(c.start)
    m.subLayer.position = c.start
    if m.video.state = "paused" then m.video.control = "resume"
    drawControls()
end sub

' (v1.1) Previous / next chapter tools: like a scrub (the bar and thumbnail show the target, presses add
' up, the jump follows 0.8 s later). Previous goes to the current chapter's start, or the one before when
' that start is less than 3 s back.
sub jumpChapter(dir as integer)
    list = chapterEntries()
    if list.count() = 0 or m.session = invalid then return
    p = currentPos()
    cur = 0
    for i = 0 to list.count() - 1
        if list[i].start <= p + 1 then cur = i
    end for
    target = -1
    if dir > 0
        if cur + 1 < list.count() and list[cur + 1].start > p + 1 then target = cur + 1
        if list[0].start > p + 1 then target = 0
    else
        target = cur
        if p - list[cur].start < 3 and cur > 0 then target = cur - 1
    end if
    if target < 0
        ' (BG-12) visible with the Audio Guide off too (the toast also speaks it)
        Toasts.notify("Last chapter", "info")
        return
    end if
    t = list[target].start
    d = m.video.duration
    if d > 0 and t > d - 5 then t = d - 5
    if t < 0 then t = 0
    print "Cove: chapter "; target + 1; " of "; list.count(); " at "; Int(t); " s"
    m.seekTarget = t
    showOsd(false)
    m.seekTimer.control = "stop"
    m.seekTimer.control = "start"
    Speak.say(Speak.clean(list[target].name + ", " + positionSpeech(t)))
end sub

' (v1.1 U-5) Chapter starts as small gaps in the progress bar, drawn once the duration is known
sub drawChapterTicks(d as float)
    if d <= 0 or d = m.tickDur then return
    m.tickDur = d
    g = m.top.findNode("ticks")
    g.removeChildrenIndex(g.getChildCount(), 0)
    for each ch in chapterEntries()
        if ch.start > 1 and ch.start < d - 1
            r = g.createChild("Rectangle")
            r.width = 4
            r.height = 12
            r.color = "0x000000B3"
            r.translation = [130 + Int(1380 * ch.start / d) - 2, 27]
        end if
    end for
end sub

' ---------------------------------------------------------------- playback speed (Cove for macOS: Speed)

' The Video node's playbackSpeed field isn't in Roku's documentation and not every model has it: the
' Speed entry shows only where it exists
function speedSupported() as boolean
    return m.video.hasField("playbackSpeed")
end function

function speedChoices() as object
    return ["0.5", "0.75", "1", "1.25", "1.5", "1.75", "2"]
end function

' The new speed takes effect on the next resume (the Video node applies it after a pause / resume): the
' Speed picker paused the video, so closing it applies it; a video playing without the picker gets both now
sub setSpeed(id as string)
    if not speedSupported() then return
    m.speedId = id
    m.speed = Val(id)
    if m.speed <= 0
        m.speed = 1.0
        m.speedId = "1"
    end if
    m.video.setField("playbackSpeed", m.speed)
    print "Cove: speed "; m.speedId; "x"
    if m.video.state = "playing"
        m.video.control = "pause"
        m.video.control = "resume"
    end if
    if m.osdShown then updateBar(currentPos())
end sub

' * menu entries added after audio / subtitles / quality / version: Chapters, Playback info
sub addMenuExtras(opts as object)
    if chapterEntries().count() > 0 then opts.push({ id: "chapters", label: "Chapters" })
    opts.push({ id: "sleep", label: "Sleep timer: " + sleepLabel() })
    if m.pbInfo = invalid
        opts.push({ id: "pbinfo", label: "Show playback info" })
    else
        opts.push({ id: "pbinfo", label: "Hide playback info" })
    end if
end sub

sub useMenuExtra(id as string)
    if id = "sleep"
        o = []
        for each c in sleepChoices()
            o.push({ id: c[0], label: c[1] })
        end for
        cur = Util.toText(m.sleepId)
        if cur = "" then cur = "off"
        openPicker("sleep", "Sleep timer", o, cur)
    else if id = "chapters"
        showChapters()
    else if id = "pbinfo"
        togglePlaybackInfo()
        closePicker()
        focusPlayer()
        resumeAfterPicker()
    end if
end sub

' ---------------------------------------------------------------- playback info (Cove for macOS: infoOverlay)

' Top-left panel over the video, refreshed every 1.5 s until hidden (stays on across episodes)
sub togglePlaybackInfo()
    if m.pbInfo <> invalid
        m.pbTimer.control = "stop"
        m.top.removeChild(m.pbInfo)
        m.pbInfo = invalid
        print "Cove: playback info off"
        return
    end if
    m.pbInfo = createObject("roSGNode", "PlaybackInfoOverlay")
    m.pbInfo.translation = [24, 36]
    ' above the controls, under the status text, Skip intro, Up next and the side panels
    at = 0
    for i = 0 to m.top.getChildCount() - 1
        if m.top.getChild(i).isSameNode(m.osd) then at = i + 1
    end for
    m.top.insertChild(m.pbInfo, at)
    if m.pbTimer = invalid
        m.pbTimer = createObject("roSGNode", "Timer")
        m.pbTimer.duration = 1.5
        m.pbTimer.repeat = true
        m.pbTimer.observeField("fire", "refreshPlaybackInfo")
        m.top.appendChild(m.pbTimer)
    end if
    m.pbTick = 0
    m.pbServer = invalid
    m.pbTimer.control = "start"
    print "Cove: playback info on"
    refreshPlaybackInfo()
end sub

sub refreshPlaybackInfo()
    if m.pbInfo = invalid then return
    if m.closing
        m.pbTimer.control = "stop"
        return
    end if
    ' the server's view of a conversion (TranscodingInfo) every 3 s
    if m.pbTick mod 2 = 0 and m.session <> invalid and m.session.method <> "DirectPlay" then askSessionInfo()
    m.pbTick = m.pbTick + 1
    m.pbInfo.lines = playbackInfoLines()
end sub

sub askSessionInfo()
    if m.pbTask <> invalid and m.pbTask.state = "run" then return
    t = createObject("roSGNode", "ApiTask")
    t.request = { method: "GET", url: Util.toText(m.top.server.url) + "/Sessions?DeviceId=" + Util.deviceId(), headers: Api.headers(m.top.server, true), body: "", tag: { kind: "pbSession", itemId: m.top.item.id }, timeout: 8000 }
    t.observeField("response", "onPbSession")
    m.pbTask = t
    t.control = "RUN"
end sub

sub onPbSession(ev as object)
    r = ev.getData()
    if r.tag.itemId <> m.top.item.id or r.code <> 200 or type(r.json) <> "roArray" or r.json.count() = 0 then return
    ti = r.json[0].TranscodingInfo
    if ti <> invalid and GetInterface(ti, "ifAssociativeArray") <> invalid
        m.pbServer = { itemId: r.tag.itemId, info: ti }
    else
        m.pbServer = invalid
    end if
end sub

' [{ k, v }]: play method, why converting, file, source / server video and audio, subtitles, what the Roku gets
function playbackInfoLines() as object
    out = []
    s = m.session
    if s = invalid
        out.push({ k: "Play method", v: "Starting..." })
        return out
    end if
    method = MediaInfo.methodLabel(Util.toText(s.method))
    if Util.toText(s.streamFormat) <> "" then method = method + " (" + UCase(Util.toText(s.streamFormat)) + ")"
    out.push({ k: "Play method", v: method })
    ti = invalid
    if m.pbServer <> invalid and m.pbServer.itemId = m.top.item.id and s.method <> "DirectPlay" then ti = m.pbServer.info
    why = ""
    if ti <> invalid then why = MediaInfo.reasonsLabel(ti.TranscodeReasons)
    if why = "" and s.method <> "DirectPlay" then why = MediaInfo.reasonsLabel(MediaInfo.queryValue(Util.toText(s.url), "TranscodeReasons"))
    if why <> "" then out.push({ k: "Why transcoding", v: why })
    src = MediaInfo.findSource(m.info, Util.toText(s.mediaSourceId))
    if src <> invalid
        f = UCase(Util.toText(src.Container))
        sz = MediaInfo.sizeText(src.Size)
        if sz <> "" then f = f + " · " + sz
        br = MediaInfo.rateText(src.Bitrate)
        if br <> "" then f = f + " · " + br
        out.push({ k: "Container", v: f })
        vids = MediaInfo.streamsOfType(src, "Video")
        if vids.count() > 0 then out.push({ k: "Source video", v: MediaInfo.videoLine(vids[0]) })
        a = MediaInfo.streamAt(src, effectiveAudio())
        if a <> invalid then out.push({ k: "Source audio", v: MediaInfo.trackLine(a) })
    end if
    subText = Tracks.subLabel(m.tracks, m.opts.sub)
    if m.opts.sub >= 0
        if m.opts.burn
            subText = subText + " (burned in)"
        else
            subText = subText + " (text)"
        end if
    end if
    out.push({ k: "Subtitles", v: subText })
    if ti <> invalid
        v = "?"
        if Util.flag(ti, "IsVideoDirect")
            v = "copied"
        else if Util.toText(ti.VideoCodec) <> ""
            v = UCase(Util.toText(ti.VideoCodec))
        end if
        w = Int(MediaInfo.toNumber(ti.Width))
        h = Int(MediaInfo.toNumber(ti.Height))
        if w > 0 and h > 0 then v = v + " · " + w.toStr() + "x" + h.toStr()
        out.push({ k: "Server video", v: v })
        au = "?"
        if Util.flag(ti, "IsAudioDirect")
            au = "copied"
        else if Util.toText(ti.AudioCodec) <> ""
            au = UCase(Util.toText(ti.AudioCodec))
        end if
        ch = Int(MediaInfo.toNumber(ti.AudioChannels))
        if ch > 0 then au = au + " · " + ch.toStr() + " ch"
        out.push({ k: "Server audio", v: au })
        sb = MediaInfo.rateText(ti.Bitrate)
        if sb <> "" then out.push({ k: "Stream bitrate", v: sb })
        fps = MediaInfo.toNumber(ti.Framerate)
        if fps > 0 then out.push({ k: "Encoder speed", v: Int(fps + 0.5).toStr() + " fps" })
        pc = MediaInfo.toNumber(ti.CompletionPercentage)
        if pc > 0 then out.push({ k: "Converted", v: Int(pc).toStr() + " %" })
    end if
    ' what the Roku's player reports
    vf = videoNodeText("videoFormat")
    af = videoNodeText("audioFormat")
    dec = []
    if vf <> "" then dec.push(vf)
    if af <> "" then dec.push(af)
    if dec.count() > 0 then out.push({ k: "Roku decodes", v: Util.join(dec, " · ") })
    si = videoNodeObject("streamInfo")
    if si <> invalid
        ind = MediaInfo.rateText(si.streamBitrate)
        if ind <> "" then out.push({ k: "Indicated", v: ind })
        net = MediaInfo.rateText(si.measuredBitrate)
        if net <> "" then out.push({ k: "Network", v: net })
        if Util.flag(si, "isUnderrun") then out.push({ k: "Buffer", v: "underrun" })
    end if
    seg = videoNodeObject("streamingSegment")
    if seg <> invalid
        sg = MediaInfo.rateText(seg.segBitrateBps)
        segW = Int(MediaInfo.toNumber(seg.width))
        segH = Int(MediaInfo.toNumber(seg.height))
        if segW > 0 and segH > 0
            if sg <> "" then sg = " · " + sg
            sg = segW.toStr() + "x" + segH.toStr() + sg
        end if
        if sg <> "" then out.push({ k: "Segment", v: sg })
    end if
    out.push({ k: "Position", v: Playback.clock(m.video.position) + " / " + Playback.clock(m.video.duration) + "  (" + Util.toText(m.video.state) + ")" })
    if m.speed <> 1 then out.push({ k: "Speed", v: m.speedId + "×" })
    return out
end function

function videoNodeText(field as string) as string
    if not m.video.hasField(field) then return ""
    return Util.toText(m.video.getField(field))
end function

function videoNodeObject(field as string) as dynamic
    if not m.video.hasField(field) then return invalid
    v = m.video.getField(field)
    if v = invalid or GetInterface(v, "ifAssociativeArray") = invalid or v.count() = 0 then return invalid
    return v
end function

' ---------------------------------------------------------------- loading ring

' The ring while the video loads: before the stream answers it stays low (pct), then follows the
' Video node's buffering percentage. note: an optional line under the ring (e.g. "Converting...").
sub showLoading(pct as integer, note as string)
    m.loadBase = pct
    m.loadNote = note
    m.status.visible = false
    setLoadPct(pct)
    m.loader.visible = true
    if note <> ""
        m.status.text = note
        m.status.translation = [0, 640]
        m.status.visible = true
    end if
end sub

sub hideLoading()
    m.loader.visible = false
    m.loadNote = ""
    m.status.translation = [0, 510]
end sub

sub setLoadPct(pct as integer)
    if pct < 0 then pct = 0
    if pct > 100 then pct = 100
    m.loaderPct.text = pct.toStr() + "%"
    frame = Int(pct / 4) * 4
    if frame = 0
        m.loaderArc.uri = ""
    else
        m.loaderArc.uri = "pkg:/images/ui/load_arc_" + Right("00" + frame.toStr(), 3) + ".png"
    end if
end sub

' Video node buffering: 0-100 % of what it needs before it plays; mapped onto what is left of the ring
sub onBufferingStatus()
    if not m.loader.visible then return
    bs = m.video.bufferingStatus
    if bs = invalid or bs.percentage = invalid then return
    base = m.loadBase
    setLoadPct(base + Int((100 - base) * bs.percentage / 100))
end sub

' The Subtitles menu (v1.0.1): Language and Style side by side in one panel (SubtitlePanel), the subtitles
' visible underneath as a live preview; style changes apply at once and the panel stays open
sub openSubsMenu()
    langRows = [{ id: "-1", label: "Off" }]
    for each s in m.tracks.subs
        langRows.push({ id: s.index.toStr(), label: s.label })
    end for
    styles = []
    ' (text subtitles only: burned-in ones are part of the picture)
    if m.opts.sub >= 0 and not m.opts.burn
        o = []
        for each ms in [-5000, -4500, -4000, -3500, -3000, -2500, -2000, -1500, -1000, -500, -250, 0, 250, 500, 1000, 1500, 2000, 2500, 3000, 3500, 4000, 4500, 5000]
            o.push({ id: ms.toStr(), label: delayLabel(ms) })
        end for
        styles.push({ key: "delay", label: "Subtitle delay", options: o, current: m.subDelayMs.toStr() })
    end if
    for each ch in Subs.styleChoices()
        styles.push({ key: ch.key, label: ch.label, options: ch.options, current: Subs.current(ch) })
    end for
    if m.picker = invalid then m.pausedByPicker = m.video.state = "playing"
    closePicker()
    if m.video.state = "playing" then m.video.control = "pause"
    p = createObject("roSGNode", "SubtitlePanel")
    p.purpose = "subs"
    p.tracks = langRows
    p.selectedId = m.opts.sub.toStr()
    p.styles = styles
    p.ready = true
    p.observeField("chosen", "onPicked")
    p.observeField("cancelled", "onPickerCancelled")
    m.top.appendChild(p)
    m.picker = p
    p.setFocus(true)
    ' (no subtitle on screen while paused: a sample line shows the style; PL-14: also with Roku captions on
    ' Instant replay, which keep the layer hidden)
    m.subLayer.visible = true
    m.subLayer.sample = "This is how subtitles will look"
end sub

' ---------------------------------------------------------------- are you still watching?

sub noteInput()
    m.autoCount = 0
    m.lastInput.Mark()
end sub

' kind "next": the countdown ended (the next episode isn't started yet, so the server converts nothing);
' "idle": 2 hours without a key press, the video is paused
sub askStill(kind as string)
    m.stillKind = kind
    m.stillBtn = 0
    hideAction()
    m.upNext.visible = false
    m.countdown.control = "stop"
    m.hideTimer.control = "stop"
    m.osdShown = false
    m.osd.opacity = 0
    liftSubs(false)
    name = Util.toText(m.top.item.title)
    if m.info <> invalid and Util.toText(m.info.SeriesName) <> "" then name = Util.toText(m.info.SeriesName)
    if kind = "next" and m.next <> invalid and Util.toText(m.next.SeriesName) <> "" then name = Util.toText(m.next.SeriesName)
    m.top.findNode("stillTitle").text = name + "?"
    print "Cove: are you still watching ("; kind; ")"
    m.stillSpoken = false
    if m.stillClock = invalid then m.stillClock = createObject("roTimespan")
    m.stillClock.Mark()
    ' (the 10 s timer also closes the player when nobody answers; after the countdown it was stopped)
    m.progressTimer.control = "start"
    drawStill()
    m.still.visible = true
    m.still.setFocus(true)
end sub

function stillLabels() as object
    leave = "Stop watching"
    if seriesKey() <> "" then leave = "Back to the series"
    return ["Continue watching", leave]
end function

' Two buttons: white when focused, glass otherwise (as Up next and the Glass dialogs)
sub drawStill()
    g = m.top.findNode("stillBtns")
    g.removeChildrenIndex(g.getChildCount(), 0)
    labels = stillLabels()
    for i = 0 to 1
        b = g.createChild("Group")
        b.translation = [i * 384, 0]
        bg = b.createChild("Poster")
        bg.width = 360
        bg.height = 68
        l = b.createChild("Label")
        l.width = 360
        l.height = 68
        l.horizAlign = "center"
        l.vertAlign = "center"
        l.text = labels[i]
        f = createObject("roSGNode", "Font")
        f.uri = "font:BoldSystemFontFile"
        f.size = 28
        l.font = f
        if i = m.stillBtn
            bg.uri = "pkg:/images/ui/white_rr12.9.png"
            l.color = "0x000000FF"
        else
            bg.uri = "pkg:/images/ui/glass_pill.9.png"
            l.color = "0xFFFFFFFF"
        end if
    end for
    text = Speak.button(labels[m.stillBtn]) + Speak.position(m.stillBtn, 2)
    if m.stillSpoken <> true then text = "Are you still watching " + m.top.findNode("stillTitle").text + " " + text
    m.stillSpoken = true
    Speak.say(text)
end sub

sub stillKey(key as string)
    if key = "left" or key = "right"
        m.stillBtn = 1 - m.stillBtn
        drawStill()
    else if key = "OK" or key = "play"
        if key = "play" then m.stillBtn = 0
        useStill()
    else if key = "back"
        m.stillBtn = 1
        useStill()
    end if
end sub

sub useStill()
    kind = m.stillKind
    stillAsked = 0
    if m.stillClock <> invalid then stillAsked = m.stillClock.TotalSeconds()
    m.still.visible = false
    m.stillKind = ""
    focusPlayer()
    if m.stillBtn = 0
        print "Cove: still watching"
        if kind = "next"
            playNext()
        else if kind = "idle" and m.session <> invalid and m.session.method <> "DirectPlay" and stillAsked >= 45
            ' (PL-5: no ping while the question showed, so the server has ended its conversion: a new stream
            ' at the same place; it plays, as Continue asks)
            print "Cove: the conversion ended while asking, restarting at "; Int(m.video.position); " s"
            restartAt(m.video.position)
            m.pauseOnStart = false
        else if m.video.state = "paused"
            resumeVideo()
        end if
        return
    end if
    ' Back to the series: its page opens where the player was (MainScene.onPlayerDone)
    if seriesKey() <> "" then m.top.openSeries = seriesKey()
    close()
end sub

' 1500 → "+1.5 s", -250 → "-0.25 s", 0 → "0.0 s"
function delayLabel(ms as integer) as string
    if ms = 0 then return "0.0 s"
    sign = "+"
    if ms < 0 then sign = "-"
    a = ms
    if a < 0 then a = -a
    frac = Right("00" + (a mod 1000).toStr(), 3)
    ' (one decimal unless the quarter needs two)
    if Right(frac, 1) = "0" then frac = Left(frac, 2)
    if Right(frac, 1) = "0" then frac = Left(frac, 1)
    return sign + (a \ 1000).toStr() + "." + frac + " s"
end function

' ---------------------------------------------------------------- instant replay, voice / transport

' Jump to t now (no adding up of presses as with Left / Right)
sub jumpTo(t as float)
    d = m.video.duration
    if t < 0 then t = 0
    if d > 0 and t > d - 5 then t = d - 5
    m.seekTimer.control = "stop"
    m.seekTarget = -1
    m.video.seek = t
    syncSubClock(t)
    m.subLayer.position = t
    if m.video.state = "paused" then m.video.control = "resume"
    showOsd(true)
end sub

' Instant Replay: 10 s back at once; with the Roku's captions on "Instant replay" (and subtitles off), the
' subtitle shows for the replayed part (Roku's guideline)
sub instantReplay()
    if m.session = invalid then return
    jumpTo(currentPos() - 10)
    if m.opts.sub < 0 and m.replayReady
        m.subLayer.visible = true
        if m.replayTimer = invalid
            m.replayTimer = createObject("roSGNode", "Timer")
            m.replayTimer.duration = 12
            m.replayTimer.observeField("fire", "onReplayTimer")
            m.top.appendChild(m.replayTimer)
        end if
        m.replayTimer.control = "stop"
        m.replayTimer.control = "start"
    end if
end sub

sub onReplayTimer()
    if m.opts.sub < 0 and m.replayReady then m.subLayer.visible = false
end sub

' main.bs → MainScene → here (callFunc): one voice / transport command → { status } (roInput eventResponse)
function handleTransport(evt as object) as object
    noteInput()
    cmd = LCase(Util.toText(evt.command))
    print "Cove: voice / transport "; cmd
    if m.closing then return { status: "error.no-media" }
    ok = { status: "success" }
    if m.still.visible
        if cmd = "play" or cmd = "resume" or cmd = "stop"
            m.stillBtn = 0
            if cmd = "stop" then m.stillBtn = 1
            useStill()
            return ok
        end if
        return { status: "unhandled" }
    end if
    if m.upNext.visible
        if cmd = "play" or cmd = "resume" or cmd = "next" or cmd = "skip"
            playNext()
            return ok
        else if cmd = "stop"
            m.countdown.control = "stop"
            close()
            return ok
        end if
        return { status: "unhandled" }
    end if
    if cmd = "stop"
        close()
        return ok
    end if
    ' (still starting: nothing to control yet)
    if m.session = invalid then return { status: "error" }
    st = m.video.state
    if cmd = "play" or cmd = "resume"
        if st <> "paused" then return { status: "error.redundant" }
        resumeVideo()
    else if cmd = "pause"
        if st <> "playing" then return { status: "error.redundant" }
        m.video.control = "pause"
    else if cmd = "forward"
        seekBy(m.pf.jump)
    else if cmd = "rewind"
        seekBy(-m.pf.jump)
    else if cmd = "replay"
        instantReplay()
    else if cmd = "startover"
        jumpTo(0)
    else if cmd = "seek"
        ' "skip forward 2 minutes": duration in seconds, direction forward / backward
        secs = Val(Util.toText(evt.duration))
        if Util.toText(evt.direction) = "backward" then secs = -secs
        target = m.video.position + secs
        d = m.video.duration
        if target < 0
            ok.status = "success.seek-start"
        else if d > 0 and target > d - 5
            ok.status = "success.seek-end"
        end if
        jumpTo(target)
    else if cmd = "next"
        if m.next = invalid then return { status: "error.generic" }
        playEpisode(m.next)
    else if cmd = "skip"
        ' "skip intro" / "skip recap": the button on screen, else the next episode
        if m.action.visible and m.actionKind <> ""
            useAction()
        else if m.next <> invalid
            playEpisode(m.next)
        else
            return { status: "error.generic" }
        end if
    else if cmd = "nowplaying"
        showOsd(true)
        kind = "movie"
        if m.info <> invalid and Util.toText(m.info.Type) = "Episode" then kind = "episode"
        name = Util.toText(m.top.item.title)
        if Util.toText(m.top.item.subtitle) <> "" then name = name + " - " + Util.toText(m.top.item.subtitle)
        ok.nowPlaying = { title: name, contentType: kind }
    else
        return { status: "unhandled" }
    end if
    return ok
end function

' ---------------------------------------------------------------- sleep timer (v1.0 F-12)

' (kept for the whole player: it spans the next episodes)
function sleepChoices() as object
    return [["off", "Off"], ["episode", "End of episode"], ["30", "30 minutes"], ["60", "60 minutes"], ["90", "90 minutes"]]
end function

sub setSleep(id as string)
    m.sleepId = id
    m.sleepMode = ""
    m.sleepSecs = 0
    if id = "episode"
        m.sleepMode = "episode"
    else if id.toInt() > 0
        m.sleepMode = "time"
        m.sleepSecs = id.toInt() * 60
        m.sleepClock = createObject("roTimespan")
    end if
    if m.sleepTimer = invalid
        m.sleepTimer = createObject("roSGNode", "Timer")
        m.sleepTimer.duration = 10
        m.sleepTimer.repeat = true
        m.sleepTimer.observeField("fire", "onSleepTick")
        m.top.appendChild(m.sleepTimer)
    end if
    if m.sleepMode = "time"
        m.sleepTimer.control = "start"
    else
        m.sleepTimer.control = "stop"
    end if
    print "Cove: sleep timer "; id
    showSleepLeft()
end sub

' Seconds left on a timed sleep timer (-1 when none runs)
function sleepRemaining() as integer
    if Util.toText(m.sleepMode) <> "time" or m.sleepClock = invalid then return -1
    left_ = m.sleepSecs - m.sleepClock.TotalSeconds()
    if left_ < 0 then left_ = 0
    return left_
end function

function sleepLabel() as string
    mode = Util.toText(m.sleepMode)
    if mode = "episode" then return "End of episode"
    r = sleepRemaining()
    if r < 0 then return "Off"
    mins = (r + 59) \ 60
    if mins <= 1 then return "1 min left"
    return mins.toStr() + " min left"
end function

' The time left at the top right of the controls (and nothing when the timer is off)
sub showSleepLeft()
    lb = m.top.findNode("sleepLeft")
    if lb = invalid then return
    if Util.toText(m.sleepMode) = ""
        lb.text = ""
    else
        lb.text = "Sleep timer: " + sleepLabel()
    end if
end sub

sub onSleepTick()
    if m.closing
        m.sleepTimer.control = "stop"
        return
    end if
    showSleepLeft()
    if sleepRemaining() = 0 then sleepExpire()
end sub

' Time is up (or the episode ended): pause, then close the player as Back does (stop report, watched mark)
sub sleepExpire(atSec = -1.0 as float)
    print "Cove: sleep timer ended, closing the player"
    m.sleepMode = ""
    m.sleepId = "off"
    if m.sleepTimer <> invalid then m.sleepTimer.control = "stop"
    if m.video.state = "playing" then m.video.control = "pause"
    closePicker()
    close(atSec)
end sub

' ---------------------------------------------------------------- Cinema Mode (v1.0 F-10)

' A Cinema Mode intro playing before its film (not a trailer opened from a details page)
function isIntro() as boolean
    it = m.top.item
    return it <> invalid and Util.flag(it, "trailer") and it.after <> invalid
end function

' Back: during an intro, the film starts (PL-7); otherwise the player closes
sub leavePlayer()
    if isIntro()
        print "Cove: Back during an intro, starting the film"
        playAfterIntro(true)
        return
    end if
    close()
end sub

' An intro ended: the next one, or the film it was for (MainScene.onIntros put them in the item)
' skipRest: the remaining intros too (Back during one)
sub playAfterIntro(skipRest = false as boolean)
    it = m.top.item
    if m.started then report("/Sessions/Playing/Stopped", false, m.video.duration)
    ' (PL-3: also before the intro started)
    stopEncoding()
    m.video.control = "stop"
    rest = it.intros
    if skipRest then rest = []
    if type(rest) = "roArray" and rest.count() > 0
        nx = rest[0]
        more = []
        for i = 1 to rest.count() - 1
            more.push(rest[i])
        end for
        sub_ = "Intro"
        if Util.toText(nx.subtitle) <> "" then sub_ = "Intro  ·  " + Util.toText(nx.subtitle)
        m.top.item = { id: Util.toText(nx.id), title: Util.toText(it.title), subtitle: sub_, start: 0.0, trailer: true, after: it.after, intros: more }
    else
        print "Cove: intros done, starting the film"
        m.top.item = it.after
    end if
end sub

' ---------------------------------------------------------------- search for subtitles (v1.0 F-13)

' GET /Items/{id}/RemoteSearch/Subtitles/{lang} (Emby and Jellyfin; the user needs the server's subtitle
' download permission), POST /Items/{id}/RemoteSearch/Subtitles/{subtitleId} to download one, then the
' item's streams again until the new subtitle is there; it is then chosen.
sub openSubSearchLangs()
    o = []
    for each l in Prefs.languages()
        o.push({ id: LCase(l.name), label: l.name })
    end for
    openPicker("subsearchlang", "Search for subtitles in", o, Prefs.subLang())
end sub

' The 3-letter code the providers use ("romanian" → "rum" / "ron": the first 3-letter one)
function subSearchCode(langName as string) as string
    for each c in Prefs.codesFor(langName)
        if Len(c) = 3 then return c
    end for
    return "eng"
end function

sub searchSubtitles(langName as string)
    m.subSearchLang = langName
    code = subSearchCode(langName)
    openPicker("subresults", "Searching...", [{ id: "none", label: "Searching for subtitles..." }], "")
    subSearchRequest("GET", "/Items/" + m.top.item.id + "/RemoteSearch/Subtitles/" + code, { kind: "subSearch", itemId: m.top.item.id }, 0)
end sub

sub downloadSubtitle(id as string)
    if id = "none" or Left(id, 2) <> "r:"
        openSubsMenu()
        return
    end if
    subId = Mid(id, 3)
    m.subsBefore = {}
    for each s in m.tracks.subs
        m.subsBefore[s.index.toStr()] = true
    end for
    openPicker("subresults", "Downloading...", [{ id: "none", label: "Downloading the subtitle..." }], "")
    subSearchRequest("POST", "/Items/" + m.top.item.id + "/RemoteSearch/Subtitles/" + subId.encodeUriComponent(), { kind: "subGet", itemId: m.top.item.id }, 0)
end sub

sub subSearchRequest(method as string, path as string, tag as object, delay as integer)
    t = createObject("roSGNode", "ApiTask")
    t.request = { method: method, url: Util.toText(m.top.server.url) + path, headers: Api.headers(m.top.server, true), body: "", tag: tag, timeout: 60000, delay: delay }
    t.observeField("response", "onSubSearch")
    m.subSearchTask = t
    t.control = "RUN"
end sub

' (answers for another title, after the player closed, or with the menu gone are dropped)
sub onSubSearch(ev as object)
    r = ev.getData()
    if m.closing or r.tag.itemId <> m.top.item.id then return
    k = r.tag.kind
    print "Cove: subtitle "; k; " -> "; r.code
    waiting = m.picker <> invalid and Util.toText(m.picker.purpose) = "subresults"
    if k = "subSearch"
        if not waiting then return
        if r.code = 401 or r.code = 403
            subSearchNote("Your user on the server isn't allowed to download subtitles.")
            return
        end if
        o = []
        if r.code = 200 and type(r.json) = "roArray"
            for each x in r.json
                if Util.isAA(x) and Util.toText(x.Id) <> "" and o.count() < 25 then o.push({ id: "r:" + Util.toText(x.Id), label: subResultLabel(x) })
            end for
        end if
        if o.count() = 0
            subSearchNote("No subtitles found. Check that the server has a subtitle provider (e.g. OpenSubtitles).")
            return
        end if
        openPicker("subresults", "Subtitles found", o, "")
    else if k = "subGet"
        if r.code < 200 or r.code >= 300
            if r.code = 401 or r.code = 403
                subSearchNote("Your user on the server isn't allowed to download subtitles.")
            else
                subSearchNote("The server couldn't download this subtitle (" + r.code.toStr() + ").")
            end if
            return
        end if
        m.subTries = 0
        subSearchRequest("GET", "/Users/" + Util.toText(m.top.server.userId) + "/Items/" + m.top.item.id + "?Fields=MediaSources,MediaStreams", { kind: "subRefresh", itemId: m.top.item.id }, 1500)
    else if k = "subRefresh"
        if r.code <> 200 or not Util.isAA(r.json) then return
        fresh = Tracks.fromItem(r.json, Util.toText(m.opts.sourceId))
        added = invalid
        for each s in fresh.subs
            if m.subsBefore = invalid or not m.subsBefore.doesExist(s.index.toStr())
                if added = invalid and s.isText then added = s
            end if
        end for
        if added = invalid
            m.subTries = m.subTries + 1
            if m.subTries < 4
                subSearchRequest("GET", "/Users/" + Util.toText(m.top.server.userId) + "/Items/" + m.top.item.id + "?Fields=MediaSources,MediaStreams", { kind: "subRefresh", itemId: m.top.item.id }, 3000)
            else if waiting
                subSearchNote("Downloaded. It will be in the Subtitles list once the server has added it.")
            end if
            return
        end if
        ' the new track list (the item's streams too, for the playback info), and the new subtitle on
        m.tracks = fresh
        ' (PL-6: the Subtitles button too, for a title that had none)
        buildTools()
        if m.info <> invalid
            m.info.MediaSources = r.json.MediaSources
            m.info.MediaStreams = r.json.MediaStreams
        end if
        wasBurned = m.opts.burn
        m.opts.sub = added.index
        m.opts.burn = false
        m.subLang = added.language
        print "Cove: downloaded subtitle is track "; added.index
        if waiting
            closePicker()
            focusPlayer()
        end if
        if wasBurned
            ' (PL-6: an image subtitle is burned into this stream: a new one without it, same place)
            clearSubs()
            restartAt(m.video.position)
        else
            loadTextSub()
            if waiting then resumeAfterPicker()
        end if
        drawControls()
    end if
end sub

' "Name  ·  OpenSubtitles  ·  SRT  ·  1234 downloads"
function subResultLabel(x as object) as string
    parts = []
    n = Util.toText(x.Name)
    if n.len() > 60 then n = n.left(58) + "..."
    if n <> "" then parts.push(n)
    if Util.toText(x.ProviderName) <> "" then parts.push(Util.toText(x.ProviderName))
    if Util.toText(x.Format) <> "" then parts.push(UCase(Util.toText(x.Format)))
    dl = Util.toNumber(x.DownloadCount)
    if dl > 0 then parts.push(Int(dl).toStr() + " downloads")
    if Util.flag(x, "IsHashMatch") then parts.push("exact match")
    return Util.join(parts, "  ·  ")
end function

' One line in the results panel (OK or Back goes back to the Subtitles menu)
sub subSearchNote(text as string)
    if m.picker = invalid or Util.toText(m.picker.purpose) <> "subresults" then return
    openPicker("subresults", "Search for subtitles", [{ id: "none", label: text }], "")
end sub
