import "pkg:/source/Util.bs"
import "pkg:/source/Prefs.bs"
import "pkg:/source/Api.bs"
import "pkg:/source/Playback.bs"
import "pkg:/source/Tracks.bs"
import "pkg:/source/Items.bs"
import "pkg:/source/MediaInfo.bs"

sub init()
    m.video = m.top.findNode("video")
    ' The remote goes to this node, not to the Video node: a focused Video node with its own controls off
    ' lets Roku open its system Options panel on *, so our audio / subtitle menu never got the key.
    m.keys = m.top.findNode("keys")
    m.status = m.top.findNode("status")
    m.action = m.top.findNode("action")
    m.actionLabel = m.top.findNode("actionLabel")
    m.upNext = m.top.findNode("upNext")
    m.progressTimer = m.top.findNode("progressTimer")
    m.closeTimer = m.top.findNode("closeTimer")
    m.countdown = m.top.findNode("countdown")
    m.progressTimer.observeField("fire", "onProgressTimer")
    m.closeTimer.observeField("fire", "finish")
    m.countdown.observeField("fire", "onCountdown")
    m.watchdog = m.top.findNode("watchdog")
    m.watchdog.observeField("fire", "onWatchdog")
    m.thumbFiles = {}
    m.osd = m.top.findNode("osd")
    m.hideTimer = m.top.findNode("hideTimer")
    m.seekTimer = m.top.findNode("seekTimer")
    m.hideTimer.observeField("fire", "hideOsd")
    m.seekTimer.observeField("fire", "applySeek")
    m.seekTarget = -1.0
    m.osdShown = false
    m.area = "center"
    m.idx = 1
    m.toolIds = []
    m.video.observeField("state", "onState")
    m.video.observeField("position", "onPosition")
    m.video.notificationInterval = 1
    m.top.observeField("focusedChild", "onFocusChanged")
    m.pending = []
    m.orphans = []          ' superseded PlayTasks, kept until they answer so their server conversion can be ended
    m.tasksHolder = invalid
    tasksHolder()
    m.picker = invalid
    m.pausedByPicker = false  ' the picker paused the video (closing it resumes only then)
    m.bifTask = invalid
    m.bifPath = ""
    m.subLang = ""          ' subtitle language chosen in this session, kept for the next episode
    m.pbInfo = invalid      ' Playback info overlay (* menu), m.pbTimer refreshes it
    m.pbTimer = invalid
    m.pbTask = invalid
    m.pbServer = invalid
    m.pbTick = 0
    resetState()
end sub

sub resetState()
    m.seekTarget = -1.0
    m.osdShown = false
    m.osd.opacity = 0
    m.session = invalid
    if m.playTask <> invalid then orphanPlayTask(m.playTask)
    m.playTask = invalid
    m.retried = false
    m.started = false
    m.closing = false
    m.failed = false
    m.lastPos = 0
    m.info = invalid
    m.tracks = { sourceId: "", audio: [], subs: [] }
    m.versions = []
    m.marks = { introStart: -1.0, introEnd: -1.0, credits: -1.0 }
    m.next = invalid
    m.prev = invalid
    m.episodes = []
    m.epIndex = -1
    m.actionKind = ""
    m.introDismissed = false
    m.creditsDismissed = false
    m.opts = Playback.options()
    m.startAt = 0.0
    m.action.visible = false
    m.upNext.visible = false
    m.countdown.control = "stop"
    m.watchdog.control = "stop"
    m.thumbs = invalid       ' { kind: "bif", ... } or { kind: "tiles", ... } for seek thumbnails
    m.thumbShown = -1
    m.top.findNode("preview").visible = false
    clearThumbFiles()
end sub

' A new item (also the next episode): load its details first (tracks, markers), then ask for a stream
sub begin()
    resetState()
    it = m.top.item
    m.startAt = it.start
    tasksHolder()
    m.top.findNode("title").text = Util.toText(it.title)
    m.top.findNode("episode").text = Util.toText(it.subtitle)
    if it.options <> invalid and it.options.audio <> invalid then m.opts = it.options
    m.status.text = "Starting..."
    m.status.visible = true
    get("/Users/" + Util.toText(m.top.server.userId) + "/Items/" + it.id + "?Fields=MediaSources,MediaStreams,Chapters,Trickplay", { kind: "info", itemId: it.id })
end sub

sub onInfo(r as object)
    if r.code = 200 and r.json <> invalid
        m.info = r.json
        m.versions = Tracks.versions(r.json)
        m.tracks = Tracks.fromItem(r.json, Util.toText(m.opts.sourceId))
        m.marks = Tracks.markers(r.json)
        m.opts.defaultAudio = Tracks.defaultAudio(m.tracks)
        buildTools()
        ' Not chosen on the details page: forced subtitles, or the language chosen for the previous episode
        ' The series' subtitle language (series page pill, or the last choice made in the player for it):
        ' "" = automatic (forced subtitles only), "off", or a language code
        ' Settings → "Always load my subtitle language" wins over the series' language, as on the Mac
        ' (also when the title was started from its details page: unless a subtitle was picked there by hand)
        always = -1
        picked = m.top.item.options <> invalid and m.top.item.options.subPicked = true
        ' a language chosen for this series on its page (or in the player) is more specific and wins
        seriesPref = ""
        if seriesKey() <> "" then seriesPref = Prefs.seriesSubLang(seriesKey())
        if Prefs.subAlways() and not picked and seriesPref = "" and m.subLang = "" then always = Tracks.subForLanguage(m.tracks, Prefs.subLang())
        langs = []
        for each s in m.tracks.subs
            langs.push(s.language + "=" + s.label)
        end for
        print "Cove: subtitles available: "; Util.join(langs, " | ")
        if Prefs.subAlways() then print "Cove: always load "; Prefs.subLang(); " -> track "; always
        if always >= 0
            m.opts.sub = always
            m.opts.burn = not Tracks.findSub(m.tracks, always).isText
            print "Cove: subtitles in "; Prefs.subLang(); " (Settings)"
        else if m.top.item.options = invalid
            pref = m.subLang
            if pref = "" and seriesKey() <> "" then pref = Prefs.seriesSubLang(seriesKey())
            if pref <> "off"
                s = Tracks.defaultSub(m.tracks, pref)
                if s >= 0
                    m.opts.sub = s
                    m.opts.burn = not Tracks.findSub(m.tracks, s).isText
                end if
            end if
        end if
        ' Jellyfin keeps intro / credits as media segments
        if Util.toText(m.top.server.type) = "jellyfin" then get("/MediaSegments/" + m.top.item.id + "?includeSegmentTypes=Intro&includeSegmentTypes=Outro", { kind: "segments", itemId: m.top.item.id })
        if Util.toText(r.json.Type) = "Episode" and Util.toText(r.json.SeriesId) <> ""
            get("/Shows/" + Util.toText(r.json.SeriesId) + "/Episodes?UserId=" + Util.toText(m.top.server.userId) + "&" + Items.fields(), { kind: "episodes", itemId: m.top.item.id })
        end if
    end if
    start(m.startAt, false)
end sub

function seriesKey() as string
    if m.info = invalid or Util.toText(m.info.SeriesId) = "" then return ""
    return Util.toText(m.info.SeriesId)
end function

' Asks the server for a stream; forceTranscode after a playback error
sub start(startSeconds as float, forceTranscode as boolean)
    m.startAt = startSeconds
    m.status.text = "Starting..."
    m.status.visible = true
    ' (a change while "Starting...": the earlier request is superseded, only its conversion still needs ending)
    if m.playTask <> invalid then orphanPlayTask(m.playTask)
    m.playTask = createObject("roSGNode", "PlayTask")
    m.playTask.server = m.top.server
    m.playTask.itemId = m.top.item.id
    m.playTask.forceTranscode = forceTranscode
    m.playTask.options = m.opts
    m.playTask.observeField("stream", "onStream")
    m.playTask.observeField("error", "onPlayError")
    m.playTask.control = "RUN"
end sub

' A PlayTask that is no longer wanted (new settings, another episode, the player closed): its answer is
' ignored, but a conversion the server started for it is stopped
sub orphanPlayTask(t as object)
    t.unobserveField("stream")
    t.unobserveField("error")
    if t.state = "done" or t.state = "stop" then return
    t.observeField("stream", "onOrphanStream")
    t.observeField("error", "onOrphanStream")
    m.orphans.push(t)
end sub

sub onOrphanStream(ev as object)
    t = ev.getRoSGNode()
    t.unobserveField("stream")
    t.unobserveField("error")
    for i = 0 to m.orphans.count() - 1
        if m.orphans[i].isSameNode(t)
            m.orphans.delete(i)
            exit for
        end if
    end for
    s = t.stream
    if s <> invalid and Util.toText(s.method) <> ""
        print "Cove: ending the superseded play session "; Util.toText(s.playSessionId)
        stopEncodingFor(s)
    end if
end sub

sub onStream(ev as object)
    t = ev.getRoSGNode()
    s = ev.getData()
    if m.playTask = invalid or not t.isSameNode(m.playTask) or s = invalid
        ' (a stale answer: end its conversion instead of playing it)
        onOrphanStream(ev)
        return
    end if
    t.unobserveField("stream")
    t.unobserveField("error")
    m.playTask = invalid
    s.itemId = m.top.item.id
    m.session = s
    ' left while the server was preparing it: stop that conversion and go
    if m.closing
        stopEncoding()
        return
    end if
    print "Cove: play "; s.method; " ("; s.streamFormat; ")"
    m.watchdog.control = "stop"
    m.watchdog.control = "start"
    if m.thumbs = invalid then loadThumbs(s)
    c = createObject("roSGNode", "ContentNode")
    c.url = s.url
    c.streamFormat = s.streamFormat
    c.title = Util.toText(m.top.item.title)
    c.secondaryTitle = Util.toText(m.top.item.subtitle)
    if m.startAt > 1 then c.PlayStart = m.startAt
    ' A text subtitle is shown by the Roku from the server's SRT
    sub_ = Tracks.findSub(m.tracks, m.opts.sub)
    subUrl = ""
    if sub_ <> invalid and sub_.isText
        subUrl = Playback.subtitleUrl(m.top.server, m.top.item.id, s.mediaSourceId, sub_.index)
        lang = sub_.language
        if lang = "" then lang = "und"
        c.subtitleTracks = [{ Language: lang, TrackName: subUrl, Description: sub_.label }]
    end if
    m.video.content = c
    applyCaptionStyle()
    applySubtitle(subUrl)
    if subUrl <> "" then probeSubtitle(subUrl, sub_.index)
    m.video.control = "play"
    m.keys.setFocus(true)
end sub

' Check the server can actually make the text subtitle (it extracts embedded ones the first time). If it
' answers with an error, play the subtitle burned into the picture instead of showing nothing.
sub probeSubtitle(url as string, index as integer)
    t = createObject("roSGNode", "ApiTask")
    t.request = { method: "GET", url: url, headers: invalid, body: "", tag: { kind: "subProbe", itemId: m.top.item.id, index: index }, timeout: 180000 }
    t.observeField("response", "onResponse")
    m.pending.push(t)
    t.control = "RUN"
end sub

sub onSubProbe(r as object)
    print "Cove: subtitle check -> "; r.code
    if r.tag.itemId <> m.top.item.id or m.opts.sub <> r.tag.index or m.opts.burn or m.closing then return
    ' (no answer in time: leave it, the Roku may still get it)
    if r.code < 400 then return
    print "Cove: text subtitle failed, burning it in"
    m.opts.burn = true
    m.status.text = "The subtitles couldn't load as text." + chr(10) + "Adding them to the picture..."
    m.status.visible = true
    restartAt(m.video.position)
end sub

' Settings → Subtitles → Style: size, colour, shadow, background, and the distance from the bottom
' (Roku's own caption settings win when they aren't Default)
sub applyCaptionStyle()
    m.video.captionStyle = Prefs.captionStyle()
    pct = Prefs.subBottom()
    if pct <> 10 and m.video.hasField("captionRenderArea")
        ' a render area that ends pct % above the bottom; Roku centres the captions at its bottom
        h = 1080 - Int(1080 * pct / 100)
        m.video.captionRenderArea = { mode: "override", overridePlacement: true, scaleFonts: "off", x: 96, y: 0, width: 1728, height: h }
    end if
end sub

sub applySubtitle(url as string)
    if url <> ""
        m.video.subtitleTrack = url
        m.video.globalCaptionMode = "On"
    else
        m.video.subtitleTrack = ""
        m.video.globalCaptionMode = "Off"
    end if
end sub

sub onPlayError(ev as object)
    t = ev.getRoSGNode()
    if m.playTask = invalid or not t.isSameNode(m.playTask) or m.closing then return
    t.unobserveField("stream")
    t.unobserveField("error")
    m.playTask = invalid
    m.status.text = Util.toText(ev.getData()) + chr(10) + "Press Back to return."
    m.status.visible = true
end sub

sub onState()
    st = m.video.state
    print "Cove: video "; st
    if st = "buffering" and m.started
        m.status.text = "Loading..."
        m.status.visible = true
    end if
    if st = "playing" or st = "paused" then updateCenter()
    if st = "paused" then showOsd(false)
    if st = "playing" and m.osdShown then m.hideTimer.control = "start"
    if st = "playing"
        m.status.visible = false
        m.watchdog.control = "stop"
        if not m.started
            m.started = true
            report("/Sessions/Playing", false)
            m.progressTimer.control = "start"
        end if
    else if st = "paused"
        report("/Sessions/Playing/Progress", true)
    else if st = "finished"
        ' (the Video node also reports "finished" right after an error: only a real end counts)
        if m.started and not m.failed then onFinished()
    else if st = "error"
        onVideoError()
    end if
end sub

' The Roku couldn't play the stream: once, have the server convert the video and continue at the same position
sub onVideoError()
    m.failed = true
    ' (the error texts can hold the stream URL with its api_key)
    print "Cove: video error "; m.video.errorCode; " "; Util.redact(Util.toText(m.video.errorMsg)); " | "; Util.redact(Util.toText(m.video.errorStr)); " | "; Util.redact(formatJson(m.video.errorInfo))
    if m.session <> invalid then print "Cove: was "; m.session.method; " "; m.session.streamFormat
    atSec = m.video.position
    if atSec < 1 then atSec = m.startAt
    if not m.retried
        retryConverted(atSec)
        return
    end if
    m.status.text = "This video can't be played on this Roku." + chr(10) + Util.redact(Util.toText(m.video.errorMsg)) + "  (" + Util.toText(m.video.errorCode) + ")" + chr(10) + "Press Back to return."
    m.status.visible = true
end sub

' Every 10 s: progress while playing; while paused a ping plus the paused progress, so the server keeps
' its conversion running (it ends one after about a minute without news)
sub onProgressTimer()
    st = m.video.state
    if st = "playing"
        report("/Sessions/Playing/Progress", false)
    else if st = "paused" and m.session <> invalid
        fire("POST", "/Sessions/Playing/Ping?PlaySessionId=" + Util.toText(m.session.playSessionId), "")
        report("/Sessions/Playing/Progress", true)
    end if
end sub

' The video didn't start: try once with the server converting it, then explain
sub onWatchdog()
    if m.started or m.closing then return
    print "Cove: video didn't start within 45 s (state "; m.video.state; ")"
    atSec = m.startAt
    if not m.retried
        retryConverted(atSec)
        return
    end if
    m.video.control = "stop"
    stopEncoding()
    m.status.text = "The server didn't start the video." + chr(10) + "Try again, or choose a lower quality with *." + chr(10) + "Press Back to return."
    m.status.visible = true
end sub

sub retryConverted(atSec as float)
    m.retried = true
    ' (end the first session on the server too, as restartAt does: the retry starts a new PlaySessionId)
    if m.started then report("/Sessions/Playing/Stopped", false, atSec)
    m.video.control = "stop"
    stopEncoding()
    m.started = false
    m.failed = false
    m.progressTimer.control = "stop"
    m.status.text = "Converting the video for this Roku..."
    m.status.visible = true
    start(atSec, true)
end sub

' ---------------------------------------------------------------- skip intro / next episode

sub onPosition()
    if m.osdShown and m.seekTarget < 0 then updateBar(m.video.position)
    p = m.video.position
    if m.video.state <> "playing" or m.upNext.visible then return
    mk = m.marks
    inIntro = mk.introStart >= 0 and mk.introEnd > mk.introStart and p >= mk.introStart and p < mk.introEnd - 2
    inCredits = m.next <> invalid and mk.credits > 0 and p >= mk.credits
    if inIntro and not m.introDismissed and Prefs.autoSkipIntro()
        ' Settings → Skip intros automatically
        m.introDismissed = true
        print "Cove: skipping the intro to "; Int(mk.introEnd); " s"
        m.video.seek = mk.introEnd
    else if inIntro and not m.introDismissed
        showAction("intro", "Skip intro")
    else if inCredits and not m.creditsDismissed
        showAction("next", "Next episode")
    else if m.actionKind <> ""
        hideAction()
    end if
end sub

sub showAction(kind as string, label as string)
    if m.actionKind = kind then return
    m.actionKind = kind
    m.actionLabel.text = label
    m.action.visible = true
    m.action.setFocus(true)
end sub

sub hideAction()
    m.actionKind = ""
    m.action.visible = false
    if m.picker = invalid then m.keys.setFocus(true)
end sub

sub useAction()
    k = m.actionKind
    hideAction()
    if k = "intro"
        m.introDismissed = true
        m.video.seek = m.marks.introEnd
    else if k = "next"
        playNext()
    end if
end sub

sub dismissAction()
    if m.actionKind = "intro" then m.introDismissed = true
    if m.actionKind = "next" then m.creditsDismissed = true
    hideAction()
end sub

sub onFinished()
    ' Settings → Play the next episode automatically (off: the player closes at the end)
    if m.next <> invalid and Prefs.autoNext()
        report("/Sessions/Playing/Stopped", false, m.video.duration)
        stopEncoding()
        m.progressTimer.control = "stop"
        m.started = false
        hideAction()
        m.top.findNode("upNextTitle").text = Util.toText(m.next.SeriesName)
        m.top.findNode("upNextEpisode").text = Items.episodeLabel(m.next)
        m.count = 10
        m.top.findNode("upNextCount").text = "Play now  (10)"
        m.top.findNode("upNextStill").uri = Items.landscape(m.top.server, m.next, 240)
        m.osdShown = false
        m.osd.opacity = 0
        m.upNext.visible = true
        m.upNext.setFocus(true)
        m.countdown.control = "start"
    else
        close()
    end if
end sub

sub onCountdown()
    m.count = m.count - 1
    if m.count <= 0
        m.countdown.control = "stop"
        playNext()
    else
        m.top.findNode("upNextCount").text = "Play now  (" + m.count.toStr() + ")"
    end if
end sub

' The next episode in the same player, keeping the subtitle language
sub playNext()
    playEpisode(m.next)
end sub

' Another episode in the same player, keeping the subtitle language
sub playEpisode(n as dynamic)
    if n = invalid then return
    m.countdown.control = "stop"
    if m.started
        report("/Sessions/Playing/Stopped", false)
        markIfWatched(m.video.position)
        stopEncoding()
    end if
    keep = Tracks.findSub(m.tracks, m.opts.sub)
    if keep <> invalid then m.subLang = keep.language
    if keep = invalid then m.subLang = ""
    m.video.control = "stop"
    m.top.item = { id: Util.toText(n.Id), title: Util.toText(n.SeriesName), subtitle: Items.episodeLabel(n), start: 0.0 }
end sub

' ---------------------------------------------------------------- * menu: audio, subtitles, quality

sub showMenu()
    opts = [
        { id: "audio", label: "Audio: " + Tracks.audioLabel(m.tracks, effectiveAudio()) },
        { id: "subs", label: "Subtitles: " + Tracks.subLabel(m.tracks, m.opts.sub) },
        { id: "quality", label: "Quality: " + Tracks.qualityLabel(m.opts.maxBitrate) }
    ]
    if m.versions <> invalid and m.versions.count() > 1 then opts.push({ id: "version", label: "Version: " + Tracks.versionLabel(m.versions, Util.toText(m.opts.sourceId)) })
    addMenuExtras(opts)
    openPicker("menu", "Playback", opts, "")
end sub

function effectiveAudio() as integer
    if m.opts.audio >= 0 then return m.opts.audio
    return m.opts.defaultAudio
end function

sub openPicker(purpose as string, title as string, options as object, selectedId as string)
    ' (a picker opened from another one keeps the first one's answer)
    if m.picker = invalid then m.pausedByPicker = m.video.state = "playing"
    closePicker()
    if m.video.state = "playing" then m.video.control = "pause"
    p = createObject("roSGNode", "Picker")
    p.purpose = purpose
    p.title = title
    p.selectedId = selectedId
    p.options = options
    p.observeField("chosen", "onPicked")
    p.observeField("cancelled", "onPickerCancelled")
    m.top.appendChild(p)
    m.picker = p
    p.setFocus(true)
end sub

sub closePicker()
    if m.picker <> invalid
        m.picker.unobserveField("chosen")
        m.picker.unobserveField("cancelled")
        m.top.removeChild(m.picker)
        m.picker = invalid
    end if
end sub

sub onPickerCancelled()
    closePicker()
    m.keys.setFocus(true)
    resumeAfterPicker()
end sub

' Play on only if the picker paused the video: one the user had paused stays paused
sub resumeAfterPicker()
    if m.pausedByPicker and m.video.state = "paused" then m.video.control = "resume"
    m.pausedByPicker = false
end sub

sub onPicked(ev as object)
    c = ev.getData()
    if c.purpose = "menu"
        if c.id = "audio"
            o = []
            for each a in m.tracks.audio
                o.push({ id: a.index.toStr(), label: a.label })
            end for
            openPicker("audio", "Audio", o, effectiveAudio().toStr())
        else if c.id = "subs"
            o = [{ id: "-1", label: "Off" }]
            for each s in m.tracks.subs
                o.push({ id: s.index.toStr(), label: s.label })
            end for
            openPicker("subs", "Subtitles", o, m.opts.sub.toStr())
        else if c.id = "quality"
            openPicker("quality", "Quality", Tracks.qualities(), m.opts.maxBitrate.toStr())
        else if c.id = "version"
            cur = Util.toText(m.opts.sourceId)
            if cur = "" then cur = m.versions[0].id
            openPicker("version", "Version", m.versions, cur)
        else
            useMenuExtra(c.id)
        end if
        return
    end if
    closePicker()
    if c.purpose = "chapter"
        seekToChapter(c)
        return
    end if
    if c.purpose = "version"
        closePicker()
        m.keys.setFocus(true)
        if c.id <> Util.toText(m.opts.sourceId) and c.id <> m.tracks.sourceId
            ' another file: its own tracks (defaults), same position
            m.opts.sourceId = c.id
            m.tracks = Tracks.fromItem(m.info, c.id)
            m.opts.audio = -1
            m.opts.sub = -1
            m.opts.burn = false
            m.opts.defaultAudio = Tracks.defaultAudio(m.tracks)
            buildTools()
            restartAt(m.video.position)
        else
            resumeAfterPicker()
        end if
        return
    end if
    if c.purpose = "episode"
        m.keys.setFocus(true)
        for each e in m.episodes
            if Util.toText(e.Id) = c.id and c.id <> m.top.item.id then playEpisode(e)
        end for
        drawControls()
        return
    end if
    v = c.id.toInt()
    restart = false
    if c.purpose = "audio" and v <> effectiveAudio()
        m.opts.audio = v
        restart = true
    else if c.purpose = "quality" and v <> m.opts.maxBitrate
        m.opts.maxBitrate = v
        restart = true
    else if c.purpose = "subs" and v <> m.opts.sub
        s = Tracks.findSub(m.tracks, v)
        wasBurned = m.opts.burn
        m.opts.sub = v
        m.opts.burn = s <> invalid and not s.isText
        if s <> invalid then m.subLang = s.language
        if s = invalid then m.subLang = "off"
        ' remembered for the series, like on the Mac
        if seriesKey() <> "" and m.subLang <> "" then Prefs.setSeriesSubLang(seriesKey(), m.subLang)
        ' Turning a subtitle on restarts the stream at the same position with it attached (as at the start):
        ' changing the subtitle tracks of the playing video froze playback on the Streambar.
        ' Turning one off (when it isn't burned in) works on the spot.
        if s = invalid and not wasBurned
            applySubtitle("")
        else
            restart = true
        end if
    end if
    m.keys.setFocus(true)
    print "Cove: picked "; c.purpose; " "; c.id; " restart="; restart
    drawControls()
    if restart
        restartAt(m.video.position)
    else
        resumeAfterPicker()
    end if
end sub

' Same item, new settings, same position
sub restartAt(atSec as float)
    if m.started then report("/Sessions/Playing/Stopped", false, atSec)
    stopEncoding()
    m.video.control = "stop"
    m.started = false
    m.retried = false
    m.failed = false
    m.progressTimer.control = "stop"
    m.watchdog.control = "stop"
    start(atSec, false)
end sub

' ---------------------------------------------------------------- keys, leaving

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if m.upNext.visible
        if key = "OK" or key = "play"
            playNext()
        else if key = "back"
            m.countdown.control = "stop"
            close()
        end if
        return true
    end if
    if m.action.visible and m.action.isInFocusChain()
        if key = "OK"
            useAction()
        else if key = "back"
            dismissAction()
        else
            dismissAction()
            return onKeyEvent(key, press)
        end if
        return true
    end if
    if key = "options"
        showMenu()
        return true
    else if key = "rewind" or key = "fastforward" or key = "replay"
        if key = "fastforward"
            seekBy(30)
        else
            seekBy(-30)
        end if
        return true
    else if key = "play"
        togglePause()
        return true
    end if
    if not m.osdShown
        ' controls hidden: quick keys
        if key = "back"
            close()
        else if key = "OK"
            togglePause()
        else if key = "left"
            seekBy(-Prefs.skipSeconds())
        else if key = "right"
            seekBy(Prefs.skipSeconds())
        else
            showOsd(true)
        end if
        return true
    end if
    ' controls shown: move between the buttons
    m.hideTimer.control = "stop"
    if m.video.state = "playing" then m.hideTimer.control = "start"
    if key = "back"
        if m.seekTarget >= 0
            m.seekTimer.control = "stop"
            m.seekTarget = -1
            updateBar(m.video.position)
        else if m.video.state = "paused"
            close()
        else
            m.osdShown = false
            fadeOsd(0.0)
        end if
    else if m.area = "bar" and (key = "left" or key = "right")
        ' the progress bar has the focus: Left / Right move along it (presses add up, thumbnail shows)
        if key = "left"
            seekBy(-Prefs.skipSeconds())
        else
            seekBy(Prefs.skipSeconds())
        end if
    else if key = "left"
        if m.idx > 0 then m.idx = m.idx - 1
        drawControls()
    else if key = "right"
        if m.idx < areaSize() - 1 then m.idx = m.idx + 1
        drawControls()
    else if key = "down" and m.area = "center"
        setArea("bar", 0)
    else if key = "down" and m.area = "bar" and m.toolIds.count() > 0
        setArea("tools", m.toolIds.count() - 1)
    else if key = "up" and m.area = "tools"
        setArea("bar", 0)
    else if key = "up" and m.area = "bar"
        setArea("center", 1)
    else if key = "OK"
        if m.area = "bar"
            togglePause()
        else
            useControl()
        end if
    end if
    return true
end function

' ---------------------------------------------------------------- controls

sub setArea(area as string, idx as integer)
    m.area = area
    m.idx = idx
    drawControls()
    updateBar(currentPos())
end sub

function areaSize() as integer
    if m.area = "tools" then return m.toolIds.count()
    if m.area = "bar" then return 1
    return 3
end function

sub togglePause()
    if m.seekTarget >= 0
        applySeek()
    else if m.video.state = "playing"
        m.video.control = "pause"
    else if m.video.state = "paused"
        m.video.control = "resume"
    end if
    showOsd(true)
end sub

sub useControl()
    if m.area = "center"
        if m.idx = 0
            seekBy(-30)
        else if m.idx = 2
            seekBy(30)
        else
            togglePause()
        end if
        return
    end if
    id = m.toolIds[m.idx]
    if id = "prev"
        playEpisode(m.prev)
    else if id = "next"
        playEpisode(m.next)
    else if id = "episodes"
        showEpisodes()
    else if id = "subs"
        o = [{ id: "-1", label: "Off" }]
        for each s in m.tracks.subs
            o.push({ id: s.index.toStr(), label: s.label })
        end for
        openPicker("subs", "Subtitles", o, m.opts.sub.toStr())
    else if id = "audio"
        o = []
        for each a in m.tracks.audio
            o.push({ id: a.index.toStr(), label: a.label })
        end for
        openPicker("audio", "Audio", o, effectiveAudio().toStr())
    else if id = "quality"
        openPicker("quality", "Quality", Tracks.qualities(), m.opts.maxBitrate.toStr())
    else if id = "chapters"
        showChapters()
    end if
end sub

' The episodes of the current season in the side panel; OK plays one
sub showEpisodes()
    if m.epIndex < 0 then return
    season = Util.toText(m.episodes[m.epIndex].SeasonId)
    o = []
    for each e in m.episodes
        if Util.toText(e.SeasonId) = season
            l = Util.toText(e.IndexNumber) + ".  " + Util.toText(e.Name)
            if Util.flag(e.UserData, "Played") then l = l + "  ·  watched"
            o.push({ id: Util.toText(e.Id), label: l })
        end if
    end for
    openPicker("episode", Util.toText(m.episodes[m.epIndex].SeasonName), o, m.top.item.id)
end sub

' Bottom-right buttons: previous / next episode (episodes only), episodes, subtitles, audio, quality
sub buildTools()
    ids = []
    if m.episodes.count() > 0
        ids.push("prev")
        ids.push("next")
        ids.push("episodes")
    end if
    if m.tracks.subs.count() > 0 then ids.push("subs")
    if m.tracks.audio.count() > 1 then ids.push("audio")
    ids.push("quality")
    if chapterEntries().count() > 0 then ids.push("chapters")
    m.toolIds = ids
    if m.area = "tools" and m.idx >= ids.count() then m.idx = ids.count() - 1
    drawControls()
end sub

function toolIcon(id as string) as string
    if id = "subs" then return "subtitles"
    return id
end function

sub drawControls()
    focused = m.osdShown and m.picker = invalid
    ' centre: 69 px circles for back / forward 30, 105 px for play / pause
    c = m.top.findNode("center")
    c.removeChildrenIndex(c.getChildCount(), 0)
    playing = m.video.state = "playing" or m.video.state = "buffering"
    specs = [
        { size: 69, icon: "back30_36", isz: 36, x: 798 },
        { size: 105, icon: "pause_48", isz: 48, x: 908 },
        { size: 69, icon: "fwd30_36", isz: 36, x: 1053 }
    ]
    if not playing then specs[1].icon = "play_48"
    for i = 0 to 2
        s = specs[i]
        isFocus = focused and m.area = "center" and m.idx = i
        g = c.createChild("Group")
        y = 540 - s.size / 2
        g.translation = [s.x, y]
        g.scaleRotateCenter = [s.size / 2, s.size / 2]
        bg = g.createChild("Poster")
        bg.width = s.size
        bg.height = s.size
        ic = g.createChild("Poster")
        ic.uri = "pkg:/images/ui/icon_" + s.icon + ".png"
        ic.width = s.isz
        ic.height = s.isz
        ic.translation = [(s.size - s.isz) / 2, (s.size - s.isz) / 2]
        if isFocus
            bg.uri = "pkg:/images/ui/white_circle_" + s.size.toStr() + ".png"
            ic.blendColor = "0x000000FF"
            g.scale = [1.08, 1.08]
        else
            bg.uri = "pkg:/images/ui/glass_circle_" + s.size.toStr() + ".png"
            ic.blendColor = "0xFFFFFFFF"
        end if
    end for
    ' bottom-right: icons in a glass capsule, right-aligned above the scrubber
    tl = m.top.findNode("tools")
    tl.removeChildrenIndex(tl.getChildCount(), 0)
    n = m.toolIds.count()
    if n = 0 then return
    gap = 62
    w = n * gap + 14
    tl.translation = [1896 - w, 878]
    pill = tl.createChild("Poster")
    pill.uri = "pkg:/images/ui/glass_pill.9.png"
    pill.width = w
    pill.height = 70
    accent = m.global.theme.accent
    for i = 0 to n - 1
        id = m.toolIds[i]
        isFocus = focused and m.area = "tools" and m.idx = i
        x = 7 + i * gap + 3
        if isFocus
            bg = tl.createChild("Poster")
            bg.uri = "pkg:/images/ui/white_circle_56.png"
            bg.width = 56
            bg.height = 56
            bg.translation = [x, 7]
        end if
        ic = tl.createChild("Poster")
        ic.uri = "pkg:/images/ui/icon_" + toolIcon(id) + "_36.png"
        ic.width = 36
        ic.height = 36
        ic.translation = [x + 10, 17]
        col = "0xFFFFFFFF"
        if id = "subs" and m.opts.sub >= 0 then col = accent
        if (id = "prev" and m.prev = invalid) or (id = "next" and m.next = invalid) then col = "0xFFFFFF59"
        if isFocus then col = "0x000000FF"
        ic.blendColor = col
    end for
end sub

sub showOsd(autoHide as boolean)
    if not m.osdShown
        m.osdShown = true
        ' the progress bar starts with the focus (Left / Right seek), Up: the centre buttons, Down: the tools
        m.area = "bar"
        m.idx = 0
        fadeOsd(1.0)
    end if
    updateBar(currentPos())
    drawControls()
    m.hideTimer.control = "stop"
    if autoHide and m.video.state = "playing" then m.hideTimer.control = "start"
end sub

sub hideOsd()
    if m.video.state = "paused" or m.seekTarget >= 0 or m.picker <> invalid then return
    m.osdShown = false
    fadeOsd(0.0)
end sub

sub fadeOsd(target as float)
    a = m.top.findNode("osdAnim")
    a.control = "stop"
    m.top.findNode("osdFade").keyValue = [m.osd.opacity, target]
    a.control = "start"
end sub

function currentPos() as float
    if m.seekTarget >= 0 then return m.seekTarget
    return m.video.position
end function

' Presses add up: the bar shows where playback will continue, the jump happens 0.8 s after the last press
sub seekBy(delta as integer)
    if m.session = invalid then return
    target = currentPos() + delta
    d = m.video.duration
    if target < 0 then target = 0
    if d > 0 and target > d - 5 then target = d - 5
    m.seekTarget = target
    showOsd(false)
    m.seekTimer.control = "stop"
    m.seekTimer.control = "start"
end sub

sub applySeek()
    m.seekTimer.control = "stop"
    if m.seekTarget < 0 then return
    m.video.seek = m.seekTarget
    m.seekTarget = -1
    if m.video.state = "paused" then m.video.control = "resume"
    m.hideTimer.control = "start"
end sub

sub updateBar(atSec as float)
    d = m.video.duration
    frac = 0.0
    if d > 0 then frac = atSec / d
    if frac > 1 then frac = 1
    if frac < 0 then frac = 0
    w = Int(1600 * frac)
    m.top.findNode("fill").width = w
    ' focused bar: thicker line and a bigger knob
    barFocus = m.osdShown and m.area = "bar" and m.picker = invalid
    sz = 22
    lineH = 6
    if barFocus
        sz = 36
        lineH = 10
    end if
    th = m.top.findNode("thumb")
    th.width = sz
    th.height = sz
    th.translation = [130 + w - sz / 2, 33 - sz / 2]
    for each id in ["track", "fill"]
        r = m.top.findNode(id)
        r.height = lineH
        r.translation = [130, 33 - lineH / 2]
    end for
    m.top.findNode("elapsed").text = Playback.clock(atSec)
    showPreview(atSec, 154 + w)
    remain = d - atSec
    if remain < 0 then remain = 0
    if d > 0
        m.top.findNode("remaining").text = "-" + Playback.clock(remain)
    else
        m.top.findNode("remaining").text = ""
    end if
end sub

' Play / pause symbol follows the state
sub updateCenter()
    if m.osdShown then drawControls()
end sub

' Report the stop (the server saves the position / marks it watched), end the server's conversion, then leave
' ---------------------------------------------------------------- seek thumbnails

sub loadThumbs(s as object)
    m.thumbs = { kind: "none" }
    srv = m.top.server
    if Util.toText(srv.type) = "jellyfin"
        if m.info <> invalid
            tp = Playback.trickplayInfo(srv, m.info, Util.toText(s.mediaSourceId))
            if tp <> invalid
                tp.kind = "tiles"
                m.thumbs = tp
                print "Cove: trickplay "; tp.width; "x"; tp.height; " every "; tp.interval; " ms"
            end if
        end if
        return
    end if
    ' Emby: download the BIF file once (a few MB at 320 px)
    ' (a file per title: after an episode switch the old download can still be writing its own)
    path = "tmp:/cove-" + m.top.item.id + ".bif"
    DeleteFile(path)
    url = "/Videos/" + m.top.item.id + "/index.bif?Width=320&MediaSourceId=" + Util.toText(s.mediaSourceId)
    print "Cove: GET "; url
    t = createObject("roSGNode", "ApiTask")
    t.request = { method: "GET", url: Util.toText(srv.url) + url, headers: Api.headers(srv, true), saveTo: path, timeout: 60000, tag: { kind: "bif", itemId: m.top.item.id, path: path } }
    t.observeField("response", "onResponse")
    m.bifTask = t
    m.bifPath = path
    m.pending.push(t)
    t.control = "RUN"
end sub

sub onBif(r as object)
    print "Cove:   -> "; r.code; " (thumbnails)"
    if r.tag.itemId <> m.top.item.id or r.code <> 200
        DeleteFile(Util.toText(r.tag.path))
        return
    end if
    b = Playback.readBif(r.tag.path)
    if b = invalid
        print "Cove: no usable BIF"
        return
    end if
    b.kind = "bif"
    m.thumbs = b
    n = b.offsets.count() - 1
    gapMs = 0
    if n > 1 then gapMs = b.times[1] - b.times[0]
    print "Cove: BIF "; n; " frames, every "; gapMs; " ms"
end sub

' The frame for atSec above the scrubber at x (only while seeking)
sub showPreview(atSec as float, x as integer)
    pv = m.top.findNode("preview")
    th = m.thumbs
    if m.seekTarget < 0 or th = invalid or th.kind = "none"
        pv.visible = false
        return
    end if
    px = x - 168
    if px < 24 then px = 24
    if px > 1896 - 336 then px = 1896 - 336
    pv.translation = [px, 712]
    m.top.findNode("previewTime").text = Playback.clock(atSec)
    img = m.top.findNode("previewImg")
    if th.kind = "bif"
        ' the last frame at or before atSec (binary search over the frame times)
        ms = atSec * 1000
        lo = 0
        hi = th.offsets.count() - 2
        i = 0
        while lo <= hi
            mid = (lo + hi) \ 2
            if th.times[mid] >= 0 and th.times[mid] <= ms
                i = mid
                lo = mid + 1
            else
                hi = mid - 1
            end if
        end while
        if i <> m.thumbShown
            f = "tmp:/cove_th" + i.toStr() + ".jpg"
            if not m.thumbFiles.doesExist(f)
                ba = createObject("roByteArray")
                start_ = th.offsets[i]
                size = th.offsets[i + 1] - start_
                if size <= 0 or not ba.readFile(th.path, start_, size) then return
                ba.writeFile(f)
                m.thumbFiles[f] = true
            end if
            img.width = 320
            img.height = 180
            img.translation = [0, 0]
            img.uri = f
            m.thumbShown = i
        end if
    else
        i = Int(atSec * 1000 / th.interval)
        if th.count <> invalid and i >= th.count then i = th.count - 1
        per = th.cols * th.rows
        tile = i \ per
        within = i mod per
        col = within mod th.cols
        row = within \ th.cols
        ' one tile image holds cols x rows thumbnails: scale it so one is 320 x 180 and shift it under the clip
        img.width = 320 * th.cols
        img.height = 180 * th.rows
        img.translation = [-col * 320, -row * 180]
        img.uri = th.url + tile.toStr() + th.query
    end if
    pv.visible = true
end sub

sub clearThumbFiles()
    if m.thumbFiles = invalid then return
    for each f in m.thumbFiles
        DeleteFile(f)
    end for
    m.thumbFiles = {}
    if m.bifPath <> "" then DeleteFile(m.bifPath)
    ' a download still running deletes its file when it ends (the player is gone or on another title)
    if m.bifTask <> invalid then m.bifTask.discard = true
    m.bifTask = invalid
    m.bifPath = ""
end sub

sub close()
    if m.closing then return
    m.closing = true
    m.progressTimer.control = "stop"
    m.countdown.control = "stop"
    m.watchdog.control = "stop"
    m.hideTimer.control = "stop"
    m.seekTimer.control = "stop"
    atSec = m.video.position
    m.video.control = "stop"
    if m.started then report("/Sessions/Playing/Stopped", false, atSec)
    markIfWatched(atSec)
    stopEncoding()
    ' still preparing a stream: drop it, but end the conversion when the server answers
    if m.playTask <> invalid then orphanPlayTask(m.playTask)
    m.playTask = invalid
    clearThumbFiles()
    m.closeTimer.control = "start"
end sub

' The scene removes the player for a deep link: stop like Back, without "done"
sub onStopNow()
    if not m.top.stopNow then return
    closePicker()
    close()
    m.closeTimer.control = "stop"
end sub

sub finish()
    m.top.done = true
end sub

sub stopEncoding()
    stopEncodingFor(m.session)
end sub

sub stopEncodingFor(s as dynamic)
    if s = invalid or s.method = "DirectPlay" then return
    path = "/Videos/ActiveEncodings?DeviceId=" + Util.deviceId() + "&PlaySessionId=" + Util.toText(s.playSessionId)
    fire("DELETE", path, "")
    ' again after 2 s and 6 s: a conversion the server was still starting can survive the first one
    fire("DELETE", path, "", 2000)
    fire("DELETE", path, "", 6000)
end sub

' Closing past 90 % (or in the credits) counts as watched, like on the Mac
sub markIfWatched(atSec as float)
    d = m.video.duration
    if m.info = invalid or d <= 0 or Util.flag(m.info.UserData, "Played") then return
    inCredits = m.marks.credits > 0 and atSec >= m.marks.credits
    if atSec < d * 0.9 and not inCredits then return
    print "Cove: marking watched at "; Int(atSec); " of "; Int(d); " s"
    uid = Util.toText(m.top.server.userId)
    ' Emby and Jellyfin up to 10.8 know only /Users/{id}/PlayedItems; Jellyfin 10.9+ also /UserPlayedItems, used
    ' if the first answers 404 (as on Home)
    fallback = ""
    if Util.toText(m.top.server.type) = "jellyfin" then fallback = "/UserPlayedItems/" + m.top.item.id + "?userId=" + uid
    fire("POST", "/Users/" + uid + "/PlayedItems/" + m.top.item.id, "", 0, fallback)
    m.info.UserData.Played = true
end sub

sub report(path as string, paused as boolean, atSec = -1 as float)
    s = m.session
    if s = invalid then return
    if atSec < 0 then atSec = m.video.position
    if atSec > 0 then m.lastPos = atSec
    fire("POST", path, Playback.reportBody(s, m.lastPos, paused))
end sub

' ---------------------------------------------------------------- requests

sub get(path as string, tag as object)
    t = createObject("roSGNode", "ApiTask")
    t.request = { method: "GET", url: Util.toText(m.top.server.url) + path, headers: Api.headers(m.top.server, true), body: "", tag: tag, timeout: 15000 }
    t.observeField("response", "onResponse")
    m.pending.push(t)
    t.control = "RUN"
end sub

sub onResponse(ev as object)
    t = ev.getRoSGNode()
    for i = 0 to m.pending.count() - 1
        if m.pending[i].isSameNode(t)
            m.pending.delete(i)
            exit for
        end if
    end for
    r = ev.getData()
    k = r.tag.kind
    ' (left, or removed for a deep link: late answers would start a new stream)
    if m.closing then return
    if k = "info"
        if r.tag.itemId <> m.top.item.id then return
        onInfo(r)
    else if k = "bif"
        onBif(r)
    else if k = "subProbe"
        onSubProbe(r)
    else if (k = "segments" or k = "episodes") and r.tag.itemId <> m.top.item.id
        ' (the previous episode's answer after Next / Episodes)
        return
    else if k = "segments" and r.code = 200
        m.marks = Tracks.fromSegments(r.json, m.marks)
    else if k = "episodes" and r.code = 200 and r.json <> invalid
        ' the series' episodes: previous / next and the Episodes panel
        list = r.json.Items
        if type(list) = "roArray"
            m.episodes = list
            for i = 0 to list.count() - 1
                if Util.toText(list[i].Id) = m.top.item.id
                    m.epIndex = i
                    if i > 0 then m.prev = list[i - 1]
                    if i + 1 < list.count() then m.next = list[i + 1]
                end if
            end for
            buildTools()
        end if
    end if
end sub

' A request whose answer nobody waits for. The task is parked in the scene's "tasks" group so it keeps running
' after this screen is gone (finished ones are cleared each time).
sub fire(method as string, path as string, body as string, delay = 0 as integer, fallbackPath = "" as string)
    holder = tasksHolder()
    t = createObject("roSGNode", "ApiTask")
    req = { method: method, url: Util.toText(m.top.server.url) + path, headers: Api.headers(m.top.server, true), body: body, delay: delay, tag: { kind: "fire" } }
    if fallbackPath <> "" then req.fallbackUrl = Util.toText(m.top.server.url) + fallbackPath
    t.request = req
    if holder = invalid
        ' (no scene any more: keep it referenced here instead)
        m.pending.push(t)
        t.control = "RUN"
        return
    end if
    for i = holder.getChildCount() - 1 to 0 step -1
        if holder.getChild(i).state = "done" or holder.getChild(i).state = "stop" then holder.removeChildIndex(i)
    end for
    holder.appendChild(t)
    t.control = "RUN"
end sub

' The scene's "tasks" group, saved while the player is on screen: a late answer after Back runs on a node
' that has left the scene, where getScene() is invalid
function tasksHolder() as dynamic
    if m.tasksHolder = invalid
        sc = m.top.getScene()
        if sc <> invalid then m.tasksHolder = sc.findNode("tasks")
    end if
    return m.tasksHolder
end function

sub onFocusChanged()
    if not m.top.hasFocus() then return
    if m.picker <> invalid
        m.picker.setFocus(true)
    else if m.upNext.visible
        m.upNext.setFocus(true)
    else if m.action.visible
        m.action.setFocus(true)
    else
        m.keys.setFocus(true)
    end if
end sub

' ---------------------------------------------------------------- chapters (Cove for macOS: chaptersPanel)

' The item's chapters without the intro / credits markers → [{ index, name, start, image }]; index is the
' position in the server's list (the chapter image is asked for by that number)
function chapterEntries() as object
    out = []
    if m.info = invalid or type(m.info.Chapters) <> "roArray" then return out
    list = m.info.Chapters
    for i = 0 to list.count() - 1
        ch = list[i]
        mt = Util.toText(ch.MarkerType)
        if mt = "" or mt = "Chapter"
            label = Util.toText(ch.Name)
            if label = "" then label = "Chapter " + (i + 1).toStr()
            img = Items.imageUrl(m.top.server, m.top.item.id, "Chapter/" + i.toStr(), Util.toText(ch.ImageTag), 320)
            out.push({ index: i, name: label, start: Playback.seconds(ch.StartPositionTicks), image: img })
        end if
    end for
    return out
end function

' Side panel with the chapters; OK jumps to one. Handled like the other panels (m.picker), so focus, the
' paused video and Back work the same.
sub showChapters()
    list = chapterEntries()
    if list.count() = 0 then return
    closePicker()
    atSec = m.video.position
    cur = 0
    for i = 0 to list.count() - 1
        if list[i].start <= atSec + 1 then cur = i
    end for
    if m.video.state = "playing" then m.video.control = "pause"
    p = createObject("roSGNode", "ChapterPanel")
    p.current = cur
    p.chapters = list
    p.observeField("chosen", "onPicked")
    p.observeField("cancelled", "onPickerCancelled")
    m.top.appendChild(p)
    m.picker = p
    p.setFocus(true)
    print "Cove: chapters panel, "; list.count(); " chapters, at "; cur
end sub

sub seekToChapter(c as object)
    m.keys.setFocus(true)
    print "Cove: chapter "; c.id; " at "; Int(c.start); " s"
    m.seekTarget = -1
    m.seekTimer.control = "stop"
    m.video.seek = c.start
    if m.video.state = "paused" then m.video.control = "resume"
    drawControls()
end sub

' * menu entries added after audio / subtitles / quality / version: Chapters, Playback info
sub addMenuExtras(opts as object)
    if chapterEntries().count() > 0 then opts.push({ id: "chapters", label: "Chapters" })
    if m.pbInfo = invalid
        opts.push({ id: "pbinfo", label: "Show playback info" })
    else
        opts.push({ id: "pbinfo", label: "Hide playback info" })
    end if
end sub

sub useMenuExtra(id as string)
    if id = "chapters"
        showChapters()
    else if id = "pbinfo"
        togglePlaybackInfo()
        closePicker()
        m.keys.setFocus(true)
        if m.video.state = "paused" then m.video.control = "resume"
    end if
end sub

' ---------------------------------------------------------------- playback info (Cove for macOS: infoOverlay)

' Top-left panel over the video, refreshed every 1.5 s until hidden (stays on across episodes)
sub togglePlaybackInfo()
    if m.pbInfo <> invalid
        m.pbTimer.control = "stop"
        m.top.removeChild(m.pbInfo)
        m.pbInfo = invalid
        print "Cove: playback info off"
        return
    end if
    m.pbInfo = createObject("roSGNode", "PlaybackInfoOverlay")
    m.pbInfo.translation = [24, 36]
    ' above the controls, under the status text, Skip intro, Up next and the side panels
    at = 0
    for i = 0 to m.top.getChildCount() - 1
        if m.top.getChild(i).isSameNode(m.osd) then at = i + 1
    end for
    m.top.insertChild(m.pbInfo, at)
    if m.pbTimer = invalid
        m.pbTimer = createObject("roSGNode", "Timer")
        m.pbTimer.duration = 1.5
        m.pbTimer.repeat = true
        m.pbTimer.observeField("fire", "refreshPlaybackInfo")
        m.top.appendChild(m.pbTimer)
    end if
    m.pbTick = 0
    m.pbServer = invalid
    m.pbTimer.control = "start"
    print "Cove: playback info on"
    refreshPlaybackInfo()
end sub

sub refreshPlaybackInfo()
    if m.pbInfo = invalid then return
    if m.closing
        m.pbTimer.control = "stop"
        return
    end if
    ' the server's view of a conversion (TranscodingInfo) every 3 s
    if m.pbTick mod 2 = 0 and m.session <> invalid and m.session.method <> "DirectPlay" then askSessionInfo()
    m.pbTick = m.pbTick + 1
    m.pbInfo.lines = playbackInfoLines()
end sub

sub askSessionInfo()
    if m.pbTask <> invalid and m.pbTask.state = "run" then return
    t = createObject("roSGNode", "ApiTask")
    t.request = { method: "GET", url: Util.toText(m.top.server.url) + "/Sessions?DeviceId=" + Util.deviceId(), headers: Api.headers(m.top.server, true), body: "", tag: { kind: "pbSession", itemId: m.top.item.id }, timeout: 8000 }
    t.observeField("response", "onPbSession")
    m.pbTask = t
    t.control = "RUN"
end sub

sub onPbSession(ev as object)
    r = ev.getData()
    if r.tag.itemId <> m.top.item.id or r.code <> 200 or type(r.json) <> "roArray" or r.json.count() = 0 then return
    ti = r.json[0].TranscodingInfo
    if ti <> invalid and GetInterface(ti, "ifAssociativeArray") <> invalid
        m.pbServer = { itemId: r.tag.itemId, info: ti }
    else
        m.pbServer = invalid
    end if
end sub

' [{ k, v }]: play method, why converting, file, source / server video and audio, subtitles, what the Roku gets
function playbackInfoLines() as object
    out = []
    s = m.session
    if s = invalid
        out.push({ k: "Play method", v: "Starting..." })
        return out
    end if
    method = MediaInfo.methodLabel(Util.toText(s.method))
    if Util.toText(s.streamFormat) <> "" then method = method + " (" + UCase(Util.toText(s.streamFormat)) + ")"
    out.push({ k: "Play method", v: method })
    ti = invalid
    if m.pbServer <> invalid and m.pbServer.itemId = m.top.item.id and s.method <> "DirectPlay" then ti = m.pbServer.info
    why = ""
    if ti <> invalid then why = MediaInfo.reasonsLabel(ti.TranscodeReasons)
    if why = "" and s.method <> "DirectPlay" then why = MediaInfo.reasonsLabel(MediaInfo.queryValue(Util.toText(s.url), "TranscodeReasons"))
    if why <> "" then out.push({ k: "Why transcoding", v: why })
    src = MediaInfo.findSource(m.info, Util.toText(s.mediaSourceId))
    if src <> invalid
        f = UCase(Util.toText(src.Container))
        sz = MediaInfo.sizeText(src.Size)
        if sz <> "" then f = f + " · " + sz
        br = MediaInfo.rateText(src.Bitrate)
        if br <> "" then f = f + " · " + br
        out.push({ k: "Container", v: f })
        vids = MediaInfo.streamsOfType(src, "Video")
        if vids.count() > 0 then out.push({ k: "Source video", v: MediaInfo.videoLine(vids[0]) })
        a = MediaInfo.streamAt(src, effectiveAudio())
        if a <> invalid then out.push({ k: "Source audio", v: MediaInfo.trackLine(a) })
    end if
    subText = Tracks.subLabel(m.tracks, m.opts.sub)
    if m.opts.sub >= 0
        if m.opts.burn
            subText = subText + " (burned in)"
        else
            subText = subText + " (text)"
        end if
    end if
    out.push({ k: "Subtitles", v: subText })
    if ti <> invalid
        v = "?"
        if Util.flag(ti, "IsVideoDirect")
            v = "copied"
        else if Util.toText(ti.VideoCodec) <> ""
            v = UCase(Util.toText(ti.VideoCodec))
        end if
        w = Int(MediaInfo.toNumber(ti.Width))
        h = Int(MediaInfo.toNumber(ti.Height))
        if w > 0 and h > 0 then v = v + " · " + w.toStr() + "x" + h.toStr()
        out.push({ k: "Server video", v: v })
        au = "?"
        if Util.flag(ti, "IsAudioDirect")
            au = "copied"
        else if Util.toText(ti.AudioCodec) <> ""
            au = UCase(Util.toText(ti.AudioCodec))
        end if
        ch = Int(MediaInfo.toNumber(ti.AudioChannels))
        if ch > 0 then au = au + " · " + ch.toStr() + " ch"
        out.push({ k: "Server audio", v: au })
        sb = MediaInfo.rateText(ti.Bitrate)
        if sb <> "" then out.push({ k: "Stream bitrate", v: sb })
        fps = MediaInfo.toNumber(ti.Framerate)
        if fps > 0 then out.push({ k: "Encoder speed", v: Int(fps + 0.5).toStr() + " fps" })
        pc = MediaInfo.toNumber(ti.CompletionPercentage)
        if pc > 0 then out.push({ k: "Converted", v: Int(pc).toStr() + " %" })
    end if
    ' what the Roku's player reports
    vf = videoNodeText("videoFormat")
    af = videoNodeText("audioFormat")
    dec = []
    if vf <> "" then dec.push(vf)
    if af <> "" then dec.push(af)
    if dec.count() > 0 then out.push({ k: "Roku decodes", v: Util.join(dec, " · ") })
    si = videoNodeObject("streamInfo")
    if si <> invalid
        ind = MediaInfo.rateText(si.streamBitrate)
        if ind <> "" then out.push({ k: "Indicated", v: ind })
        net = MediaInfo.rateText(si.measuredBitrate)
        if net <> "" then out.push({ k: "Network", v: net })
        if Util.flag(si, "isUnderrun") then out.push({ k: "Buffer", v: "underrun" })
    end if
    seg = videoNodeObject("streamingSegment")
    if seg <> invalid
        sg = MediaInfo.rateText(seg.segBitrateBps)
        segW = Int(MediaInfo.toNumber(seg.width))
        segH = Int(MediaInfo.toNumber(seg.height))
        if segW > 0 and segH > 0
            if sg <> "" then sg = " · " + sg
            sg = segW.toStr() + "x" + segH.toStr() + sg
        end if
        if sg <> "" then out.push({ k: "Segment", v: sg })
    end if
    out.push({ k: "Position", v: Playback.clock(m.video.position) + " / " + Playback.clock(m.video.duration) + "  (" + Util.toText(m.video.state) + ")" })
    return out
end function

function videoNodeText(field as string) as string
    if not m.video.hasField(field) then return ""
    return Util.toText(m.video.getField(field))
end function

function videoNodeObject(field as string) as dynamic
    if not m.video.hasField(field) then return invalid
    v = m.video.getField(field)
    if v = invalid or GetInterface(v, "ifAssociativeArray") = invalid or v.count() = 0 then return invalid
    return v
end function
