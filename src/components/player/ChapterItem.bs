sub init()
    m.name = m.top.findNode("name")
    m.time = m.top.findNode("time")
    m.bg = m.top.findNode("bg")
    m.isCurrent = false
end sub

sub onContent()
    c = m.top.itemContent
    if c = invalid then return
    m.name.text = c.title
    m.time.text = c.description
    m.top.findNode("thumb").uri = c.hdPosterUrl
    m.isCurrent = c.hasField("isCurrent") and c.isCurrent
    onFocus()
end sub

' (v1.5 flat) Focused: a solid white row with dark text; at rest the chapter playing now in full white, the
' others at 80 % (no accent)
sub onFocus()
    f = 0.0
    if m.top.listHasFocus then f = m.top.focusPercent
    m.bg.opacity = f
    if f > 0.5
        m.name.color = "0x111111FF"
        m.time.color = "0x111111B3"
        return
    end if
    m.name.color = "0xFFFFFFFF"
    if not m.isCurrent then m.name.color = "0xFFFFFFCC"
    m.time.color = "0xFFFFFFCC"
end sub
