sub init()
    m.name = m.top.findNode("name")
    m.time = m.top.findNode("time")
    m.bg = m.top.findNode("bg")
    m.isCurrent = false
end sub

sub onContent()
    c = m.top.itemContent
    if c = invalid then return
    m.name.text = c.title
    m.time.text = c.description
    m.top.findNode("thumb").uri = c.hdPosterUrl
    m.isCurrent = c.hasField("isCurrent") and c.isCurrent
    onFocus()
end sub

' (v1.4) Focused: the Glass3D fog and a white ring, the text stays white; the chapter playing now in full white
sub onFocus()
    f = 0.0
    if m.top.listHasFocus then f = m.top.focusPercent
    m.bg.opacity = f
    m.top.findNode("ring").opacity = f
    m.name.color = "0xFFFFFFFF"
    ' (v1.5 flat) no accent: the chapter playing now is white, the others 80 %
    if not m.isCurrent and f <= 0.5 then m.name.color = "0xFFFFFFCC"
    m.time.color = "0xFFFFFFCC"
end sub
