<?xml version="1.0" encoding="utf-8" ?>
<!-- The home screen in Cove's Glass style.
     Like the Cove for macOS home: the sidebar on the left (Home, Search, Favorites, Now Playing, Recently Added,
     the libraries, Settings; Left opens it), the hero (a full-screen title with logo, details and Play / favourite /
     info buttons, changing every 9 s) with the first row fully visible under it, and the rows of cards.
     Moving down into the rows slides them up; the backdrop then follows the focused card and its details show at
     the top. "action" reports what the user chose: { id: "open" | "play" | "search" | "switch" | "signout" ... }. -->
<component name="HomeScreen" extends="Group">
    <script type="text/brightscript" uri="HomeScreen.bs" />
    <interface>
        <field id="server" type="assocarray" onChange="load" />
        <field id="action" type="assocarray" alwaysNotify="true" />
        <field id="screenId" type="string" value="home" />
        <field id="reload" type="boolean" alwaysNotify="true" onChange="onReload" />
    </interface>
    <children>
        <!-- backdrop: two layers that crossfade -->
        <Group id="bdLayer">
            <Poster id="bdA" width="1920" height="1080" loadWidth="1280" loadHeight="720" loadDisplayMode="scaleToZoom" opacity="0" />
            <Poster id="bdB" width="1920" height="1080" loadWidth="1280" loadHeight="720" loadDisplayMode="scaleToZoom" opacity="0" />
        </Group>
        <Poster id="scrimLeft" uri="pkg:/images/ui/scrim_left.png" width="1152" height="1080" />
        <Poster id="scrimTop" uri="pkg:/images/ui/scrim_top.png" width="1920" height="300" />
        <Poster id="scrimBottom" width="1920" height="1080" />
        <!-- under the rows when they are up: a fade into the page colour, then solid (card corners sit on it) -->
        <Group id="rowsBg" opacity="0">
            <Poster id="rowsFade" width="1920" height="140" translation="[0,290]" />
            <Rectangle id="rowsSolid" width="1920" height="650" translation="[0,430]" />
        </Group>

        <!-- hero text, bottom-left -->
        <Group id="hero" translation="[80,0]">
            <Group id="chip" translation="[96,0]" visible="false">
                <Rectangle id="chipBg" height="36" color="0x0000008C" />
                <Label id="chipText" height="36" vertAlign="center" translation="[12,0]" color="0xFFFFFFFF">
                    <Font role="font" uri="font:BoldSystemFontFile" size="22" />
                </Label>
            </Group>
            <Poster id="heroLogo" loadDisplayMode="scaleToFit" loadWidth="630" loadHeight="135" visible="false" />
            <Label id="heroTitle" width="1100" height="100" color="0xFFFFFFFF">
                <Font role="font" uri="font:BoldSystemFontFile" size="80" />
            </Label>
            <Label id="heroMeta" width="1200" height="40" translation="[96,0]" color="0xFFFFFFFF">
                <Font role="font" uri="font:MediumSystemFontFile" size="26" />
            </Label>
            <Group id="heroOv" translation="[96,0]">
                <Label id="hov0" width="760" height="38" color="0xFFFFFFCC"><Font role="font" uri="font:MediumSystemFontFile" size="26" /></Label>
                <Label id="hov1" width="760" height="38" translation="[0,38]" color="0xFFFFFFCC"><Font role="font" uri="font:MediumSystemFontFile" size="26" /></Label>
                <Label id="hov2" width="760" height="38" translation="[0,76]" color="0xFFFFFFCC"><Font role="font" uri="font:MediumSystemFontFile" size="26" /></Label>
            </Group>
            <Group id="buttons" translation="[96,0]">
                <Group id="btnPlay">
                    <Poster id="playRing" uri="pkg:/images/ui/focus_ring_pill.9.png" width="271" height="85" translation="[-8,-8]" visible="false" />
                    <Poster uri="pkg:/images/ui/white_pill.9.png" width="255" height="69" />
                    <Poster uri="pkg:/images/ui/icon_play_28.png" width="28" height="28" translation="[60,20]" blendColor="0x000000FF" />
                    <Label id="playLabel" text="Play" width="150" height="69" translation="[98,0]" vertAlign="center" color="0x000000FF">
                        <Font role="font" uri="font:BoldSystemFontFile" size="28" />
                    </Label>
                </Group>
                <Group id="btnFav" translation="[276,0]">
                    <Poster id="favBg" uri="pkg:/images/ui/glass_circle_69.png" width="69" height="69" />
                    <Poster id="favIcon" uri="pkg:/images/ui/icon_plus_28.png" width="28" height="28" translation="[20,20]" />
                </Group>
                <Group id="btnInfo" translation="[366,0]">
                    <Poster id="infoBg" uri="pkg:/images/ui/glass_circle_69.png" width="69" height="69" />
                    <Poster id="infoIcon" uri="pkg:/images/ui/icon_info_28.png" width="28" height="28" translation="[20,20]" />
                </Group>
            </Group>
            <Group id="dots" translation="[0,734]" />
        </Group>

        <!-- details of the focused card (rows up) -->
        <Group id="info" translation="[176,96]" opacity="0">
            <Label id="title" width="1500" height="84" color="0xFFFFFFFF">
                <Font role="font" uri="font:BoldSystemFontFile" size="64" />
            </Label>
            <Label id="meta" width="1500" height="40" translation="[0,92]" color="0xFFFFFFFF">
                <Font role="font" uri="font:MediumSystemFontFile" size="26" />
            </Label>
            <Label id="ov0" width="1150" height="38" translation="[0,146]" color="0xFFFFFFCC"><Font role="font" uri="font:MediumSystemFontFile" size="26" /></Label>
            <Label id="ov1" width="1150" height="38" translation="[0,184]" color="0xFFFFFFCC"><Font role="font" uri="font:MediumSystemFontFile" size="26" /></Label>
            <Label id="ov2" width="1150" height="38" translation="[0,222]" color="0xFFFFFFCC"><Font role="font" uri="font:MediumSystemFontFile" size="26" /></Label>
        </Group>

        <RowList id="rows" translation="[150,770]" itemComponentName="PosterItem" numRows="3"
                 itemSize="[1770,466]" rowHeights="[466]" rowItemSize="[[276,466]]" rowItemSpacing="[[0,0]]"
                 itemSpacing="[0,44]" showRowLabel="[true]" rowLabelOffset="[[18,0]]" rowLabelColor="0xFFFFFFFF"
                 focusXOffset="[0]" rowFocusAnimationStyle="floatingFocus" vertFocusAnimationStyle="fixedFocus"
                 drawFocusFeedback="false" visible="false">
            <Font role="rowLabelFont" uri="font:BoldSystemFontFile" size="32" />
        </RowList>

        <!-- Settings → General → Navigation: the sidebar (default) or the top bar; HomeScreen uses one of them -->
        <Group id="navs">
            <SideBar id="side" visible="false" />
            <NavBar id="top" visible="false" />
        </Group>
        <!-- Holds the focus while the hero buttons are active (keys reach HomeScreen.onKeyEvent) -->
        <Group id="heroKeys" focusable="true" />

        <Label id="status" width="1728" height="44" translation="[176,520]" color="0xFFFFFF8C" text="Loading your libraries...">
            <Font role="font" uri="font:MediumSystemFontFile" size="30" />
        </Label>

        <Timer id="backdropTimer" duration="0.3" repeat="false" />
        <Timer id="heroTimer" duration="9" repeat="true" />
        <Timer id="watchdog" duration="45" repeat="false" />
        <Timer id="sessionsTimer" duration="30" repeat="true" />
        <Animation id="slide" duration="0.3" easeFunction="outCubic">
            <Vector2DFieldInterpolator id="rowsMove" key="[0.0, 1.0]" fieldToInterp="rows.translation" />
            <FloatFieldInterpolator id="heroFadeI" key="[0.0, 1.0]" fieldToInterp="hero.opacity" />
            <FloatFieldInterpolator id="infoFadeI" key="[0.0, 1.0]" fieldToInterp="info.opacity" />
            <FloatFieldInterpolator id="navFadeI" key="[0.0, 1.0]" fieldToInterp="navs.opacity" />
            <FloatFieldInterpolator id="bdDimI" key="[0.0, 1.0]" fieldToInterp="bdLayer.opacity" />
            <FloatFieldInterpolator id="rowsBgI" key="[0.0, 1.0]" fieldToInterp="rowsBg.opacity" />
        </Animation>
        <Animation id="xfade" duration="0.6" easeFunction="inOutQuad">
            <FloatFieldInterpolator id="xfadeA" key="[0.0, 1.0]" fieldToInterp="bdA.opacity" />
            <FloatFieldInterpolator id="xfadeB" key="[0.0, 1.0]" fieldToInterp="bdB.opacity" />
        </Animation>
    </children>
</component>
