<?xml version="1.0" encoding="utf-8" ?>
<!-- The top navigation pill (Cove's top-bar style): a glass capsule centred at the top with Home, Search and the
     libraries. (v1.4 N4) The current page sits on an accent glass band; the focused item gets the fog and the
     white ring, its text stays white.
     Set "items" ([{ id, label, icon, pinned }]; pinned = always shown, the rest goes behind More when too wide); OK sets "chosen" = { id }. Left / Right move; other keys go to the screen. -->
<component name="NavBar" extends="Group">
    <script type="text/brightscript" uri="NavBar.bs" />
    <interface>
        <field id="items" type="array" onChange="build" />
        <!-- Settings → Top bar shows: "both" (icons and names), "names" or "icons" -->
        <field id="labels" type="string" value="both" onChange="build" />
        <field id="current" type="string" value="home" onChange="paint" />
        <field id="chosen" type="assocarray" alwaysNotify="true" />
        <!-- (v1.5) the entries that don't fit in the screen width: behind the "More" entry (chosen = { id: "more" }) -->
        <field id="overflow" type="array" />
    </interface>
    <children>
        <Poster id="pill" uri="pkg:/images/ui/g3_capsule.9.png" height="64" />
        <Group id="entries" />
    </children>
</component>
