import "pkg:/source/Util.bs"
import "pkg:/source/Speak.bs"
import "pkg:/source/NavUtil.bs"

sub init()
    m.entries = m.top.findNode("entries")
    m.index = 0
    ' (an array field with no value reads invalid on the device: the scene-level copy is painted before MainScene
    ' hands it Home's entries, and its.count() crashed)
    if type(m.top.items) <> "roArray" then m.top.items = []
    m.top.observeField("focusedChild", "onFocus")
    ' (v1.7.1 NV6-15) the scene-level copy is hidden on Home: it paints only when it is shown
    m.paintLater = false
    m.fonts = {}
    m.top.observeField("visible", "onVisible")
    Speak.mute([m.top])
end sub

sub build()
    its = m.top.items
    ' (v1.7.1 NV6-10) New appearing / going above the highlighted entry: the same entry stays highlighted
    m.index = NavUtil.keptEntryIndex(m.prevItems, its, m.index)
    m.prevItems = its
    if m.index >= its.count() or isHeader(m.index) then m.index = firstEntry()
    paint()
end sub

function isHeader(i as integer) as boolean
    its = m.top.items
    return i < 0 or i >= its.count() or its[i].header = true
end function

function firstEntry() as integer
    for i = 0 to m.top.items.count() - 1
        if not isHeader(i) then return i
    end for
    return 0
end function

sub onFocus()
    open = m.top.isInFocusChain()
    if open and not m.top.expanded
        ' (v1.2 NV-6) open on the entry last opened from here this session, else the page being shown
        at = NavUtil.openEntry(m.top.items, lastChosenId(), lastChosenLabel(), m.top.current)
        if at >= 0 and not isHeader(at) then m.index = at
    end if
    wasOpen = m.top.expanded
    m.top.expanded = open
    paint()
    if open and not wasOpen then speakEntry("Menu. ")
end sub

' Audio Guide: the focused entry, "Movies, 4 of 9"
sub speakEntry(prefix as string)
    if not Speak.isOn() then return
    its = m.top.items
    if m.index < 0 or m.index >= its.count() then return
    n = 0
    at = 0
    for i = 0 to its.count() - 1
        if not isHeader(i)
            if i = m.index then at = n
            n = n + 1
        end if
    end for
    text = Util.toText(its[m.index].label)
    b = Util.toNumber(its[m.index].badge)
    if b > 0 then text = text + ", " + Int(b).toStr() + " playing"
    if its[m.index].id = m.top.current then text = text + ", current page"
    Speak.say(prefix + text + Speak.position(at, n))
end sub

' Every entry is 64 px high; section titles 56 px. Closed: icons only on a 112 px rail. Open: 400 px with names.
sub paint()
    ' (no theme yet: the scene is still being made; paint runs again when items / compact are set)
    if not Util.isAA(m.global.theme) then return
    ' (v1.7.1 NV6-15) the hidden scene rail: repainted when it shows (onVisible)
    if m.top.compact and not m.top.visible
        m.paintLater = true
        return
    end if
    m.paintLater = false
    m.entries.removeChildrenIndex(m.entries.getChildCount(), 0)
    open = m.top.expanded
    w = 112
    if open then w = 400
    ' (v1.7 NAV M-4) the scene-level sidebar on other top-level pages: a 76 px rail while closed (the pages'
    ' content starts at x 96), the usual 400 px panel over the page while open
    slim = m.top.compact and not open
    if slim then w = 76
    iconX = 38
    pillX = 16
    railPill = 80
    if slim
        iconX = 20
        pillX = 6
        railPill = 64
    end if
    m.top.findNode("bg").width = w
    m.top.findNode("bg").color = "0x000000D9"
    if open then m.top.findNode("bg").color = "0x0D0D0DF7"
    m.top.findNode("edge").translation = [w - 1, 0]
    m.top.findNode("appName").visible = open
    ' (the page shows its own logo next to the slim rail)
    m.top.findNode("logo").visible = not slim
    dark = m.global.theme.onFocus
    y = 0
    focusY = 0
    its = m.top.items
    for i = 0 to its.count() - 1
        it = its[i]
        if it.header = true
            if open
                l = m.entries.createChild("Label")
                l.font = font("font:BoldSystemFontFile", 24)
                l.text = UCase(Util.toText(it.label))
                l.color = "0xFFFFFF9E"
                l.translation = [36, y + 14]
                l.height = 36
            else
                r = m.entries.createChild("Rectangle")
                r.width = railPill - 32
                r.height = 2
                r.color = "0xFFFFFF26"
                r.translation = [pillX + 16, y + 27]
            end if
            y = y + 56
        else
            isFocus = open and i = m.index
            isCurrent = it.id = m.top.current
            g = m.entries.createChild("Group")
            g.translation = [0, y]
            pillW = railPill
            if open then pillW = 360
            if isFocus or isCurrent
                bg = g.createChild("Poster")
                bg.translation = [pillX, 4]
                bg.width = pillW
                bg.height = 56
                ' (v1.5 flat) the focus is a solid white row with dark text and icon, which must win from the
                ' sofa (N3); the current page a faint 16 % white row (no accent band, no hairline)
                bg.uri = "pkg:/images/ui/white_pill.9.png"
                if not isFocus then bg.opacity = 0.16
            end if
            ic = g.createChild("Poster")
            ic.uri = "pkg:/images/ui/icon_" + Util.toText(it.icon) + "_36.png"
            ic.width = 36
            ic.height = 36
            ic.translation = [iconX, 14]
            ' (v1.5 flat) neutral icons: 85 % white, white on the current page, dark on the focused row
            col = "0xFFFFFFD9"
            if isCurrent then col = "0xFFFFFFFF"
            if isFocus then col = dark
            ic.blendColor = col
            if open
                l = g.createChild("Label")
                l.font = font("font:MediumSystemFontFile", 28)
                if isFocus or isCurrent then l.font = font("font:BoldSystemFontFile", 28)
                l.text = Util.toText(it.label)
                l.color = "0xFFFFFFD9"
                if isFocus then l.color = dark
                l.translation = [94, 0]
                l.width = 230
                l.height = 64
                l.vertAlign = "center"
            end if
            b = 0
            if it.badge <> invalid then b = it.badge
            if b > 0
                dot = g.createChild("Poster")
                dot.uri = "pkg:/images/ui/white_circle_56.png"
                ' (v1.5 flat) a white disc with the count in dark (dark disc, white count on the focused row)
                dot.blendColor = "0xFFFFFFFF"
                if isFocus then dot.blendColor = dark
                bl = g.createChild("Label")
                bl.font = font("font:BoldSystemFontFile", 24)
                bl.text = b.toStr()
                bl.color = dark
                if isFocus then bl.color = "0xFFFFFFFF"
                bl.horizAlign = "center"
                bl.vertAlign = "center"
                if open
                    dot.width = 38
                    dot.height = 38
                    dot.translation = [328, 13]
                else
                    dot.width = 32
                    dot.height = 32
                    dot.translation = [iconX + 24, 4]
                end if
                bl.width = dot.width
                bl.height = dot.height
                bl.translation = dot.translation
            end if
            if i = m.index then focusY = y
            y = y + 64
        end if
    end for
    ' keep the focused entry inside the visible part
    top = 0
    if focusY > 820 then top = 820 - focusY
    m.entries.translation = [0, top]
end sub

' Which entries are section titles, for NavUtil.nextEntry
function headerFlags() as object
    flags = []
    for i = 0 to m.top.items.count() - 1
        flags.push(isHeader(i))
    end for
    return flags
end function

' (v1.2 NV-6) The entry last opened from the menu, for the session (m.global, so a rebuilt Home keeps it)
sub rememberChosen(it as object)
    if not m.global.hasField("navLastEntry") then m.global.addFields({ navLastEntry: {} })
    m.global.navLastEntry = { id: Util.toText(it.id), label: Util.toText(it.label) }
end sub

function lastChosenId() as string
    if not m.global.hasField("navLastEntry") or not Util.isAA(m.global.navLastEntry) then return ""
    return Util.toText(m.global.navLastEntry.id)
end function

function lastChosenLabel() as string
    if not m.global.hasField("navLastEntry") or not Util.isAA(m.global.navLastEntry) then return ""
    return Util.toText(m.global.navLastEntry.label)
end function

' (v1.7.1 NV6-15) one Font node per face and size, reused by every paint
function font(uri as string, size as integer) as object
    k = uri + "@" + size.toStr()
    if m.fonts = invalid then m.fonts = {}
    if m.fonts.doesExist(k) then return m.fonts[k]
    f = createObject("roSGNode", "Font")
    f.uri = uri
    f.size = size
    m.fonts[k] = f
    return f
end function

sub onVisible()
    if m.top.visible and m.paintLater then paint()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    n = m.top.items.count()
    if key = "up" or key = "down"
        ' (v1.2 NV-7) Up on the first entry goes to the last, Down on the last to the first
        dir = 1
        if key = "up" then dir = -1
        i = NavUtil.nextEntry(headerFlags(), m.index, dir)
        if i >= 0 then m.index = i
        paint()
        speakEntry("")
        return true
    else if key = "OK" and n > 0
        rememberChosen(m.top.items[m.index])
        m.top.chosen = { id: m.top.items[m.index].id }
        return true
    else if key = "left"
        return true
    end if
    return false
end function
