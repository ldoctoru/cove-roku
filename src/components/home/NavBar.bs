import "pkg:/source/Util.bs"

sub init()
    m.pill = m.top.findNode("pill")
    m.entries = m.top.findNode("entries")
    m.index = 0
    m.top.observeField("focusedChild", "paint")
end sub

' Each entry: a capsule behind an icon and / or a label (Settings → Top bar shows); widths follow the text
sub build()
    m.entries.removeChildrenIndex(m.entries.getChildCount(), 0)
    if m.top.items = invalid then return
    mode = m.top.labels
    x = 8
    for each it in m.top.items
        hasIcon = mode <> "names" and Util.toText(it.icon) <> ""
        hasText = mode <> "icons" or not hasIcon
        g = m.entries.createChild("Group")
        g.translation = [x, 8]
        bg = g.createChild("Poster")
        bg.uri = "pkg:/images/ui/white_pill.9.png"
        bg.height = 48
        bg.visible = false
        l = g.createChild("Label")
        l.height = 48
        l.vertAlign = "center"
        f = createObject("roSGNode", "Font")
        f.uri = "font:MediumSystemFontFile"
        f.size = 26
        l.font = f
        ic = g.createChild("Poster")
        ic.width = 30
        ic.height = 30
        ic.translation = [22, 9]
        ic.visible = hasIcon
        if hasIcon then ic.uri = "pkg:/images/ui/icon_" + it.icon + "_36.png"
        w = 0
        if hasText
            l.text = it.label
            tw = it.label.len() * 15
            if hasIcon
                l.translation = [62, 0]
                w = 62 + tw + 22
            else
                l.translation = [22, 0]
                w = tw + 44
                if w < 110
                    l.translation = [Int((110 - tw) / 2), 0]
                    w = 110
                end if
            end if
            l.width = tw + 6
        else
            w = 74
        end if
        bg.width = w
        x = x + w + 6
    end for
    total = x + 2
    m.pill.width = total
    m.top.translation = [Int((1920 - total) / 2), 36]
    if m.index >= m.top.items.count() then m.index = 0
    paint()
end sub

sub paint()
    focused = m.top.hasFocus()
    for i = 0 to m.entries.getChildCount() - 1
        g = m.entries.getChild(i)
        bg = g.getChild(0)
        l = g.getChild(1)
        ic = g.getChild(2)
        isCurrent = m.top.items[i].id = m.top.current
        f = createObject("roSGNode", "Font")
        if focused and i = m.index
            bg.uri = "pkg:/images/ui/white_pill.9.png"
            bg.visible = true
            l.color = "0x000000FF"
            f.uri = "font:BoldSystemFontFile"
        else if isCurrent
            bg.uri = "pkg:/images/ui/sel_pill.9.png"
            bg.visible = true
            l.color = "0xFFFFFFFF"
            f.uri = "font:BoldSystemFontFile"
        else
            bg.visible = false
            l.color = "0xFFFFFF8C"
            f.uri = "font:MediumSystemFontFile"
        end if
        ic.blendColor = l.color
        f.size = 26
        l.font = f
    end for
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    n = m.top.items.count()
    if key = "left" and m.index > 0
        m.index = m.index - 1
        paint()
        return true
    else if key = "right" and m.index < n - 1
        m.index = m.index + 1
        paint()
        return true
    else if key = "OK" and n > 0
        m.top.chosen = { id: m.top.items[m.index].id }
        return true
    else if key = "left" or key = "right"
        return true
    end if
    return false
end function
