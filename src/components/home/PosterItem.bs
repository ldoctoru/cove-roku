import "pkg:/source/Util.bs"

sub init()
    t = m.global.theme
    m.card = m.top.findNode("card")
    m.image = m.top.findNode("image")
    m.initials = m.top.findNode("initials")
    m.title = m.top.findNode("title")
    m.year = m.top.findNode("year")
    m.top.findNode("ph").color = t.placeholder
    m.top.findNode("mask").uri = t.maskPoster
    ' (v1.5 flat) no accent: the progress bar, the favourite heart and the resume arc are white
    m.top.findNode("barFill").color = "0xFFFFFFFF"
    m.top.findNode("heart").blendColor = "0xFFFFFFFF"
    ' (v1.5) Liviu: the resume arc in a colour, easier to see on Continue Watching (Emby's green; the one
    ' coloured element left besides rating icons)
    m.top.findNode("resumeArc").blendColor = "0x52B54BFF"
    ' (v1.4 R5) Settings → General → Dim Watched (on by default, as on the Mac)
    m.dimWatched = true
    dv = t.dimWatched
    if dv <> invalid and not dv then m.dimWatched = false
    m.image.observeField("loadStatus", "onLoad")
    m.landscape = false
    m.person = false
    m.libTile = false
    m.selected = false
    m.phBars = invalid
    m.seeAll = invalid
end sub

' The tile keeps a margin of PAD around the card, because a list clips each item to its own area: without
' it the focus ring is cut off (the gap between cards = 2 x PAD + the list's spacing).
' Image area: 16:9 cards fill the tile; poster cards keep 2:3 and put title + year underneath.
sub onSize()
    pad = 18
    w = m.top.width - 2 * pad
    if w <= 0 or m.top.height <= 0 then return
    c = m.top.itemContent
    m.landscape = c <> invalid and c.hasField("landscape") and c.landscape
    m.person = c <> invalid and c.hasField("kind") and c.kind = "person"
    m.epCard = c <> invalid and c.hasField("kind") and c.kind = "episode"
    m.libTile = c <> invalid and c.hasField("kind") and c.kind = "library"
    h = m.top.height - 2 * pad
    if not m.landscape then h = Int(w * 1.5)
    ' (v1.5) My Media: a 16:9 library picture with the name under it (Emby's My Media row)
    if m.libTile then h = Int(w * 9 / 16)
    if m.person then h = w
    if h > m.top.height - 2 * pad then h = m.top.height - 2 * pad
    m.card.translation = [pad, pad]
    ' (VD-8: the year 30 px under the title; VD-9: both move down with the focus ring, see onFocus)
    m.title.translation = [pad, pad + h + 14]
    m.year.translation = [pad, pad + h + 44]
    ' (v1.1.2) poster titles take up to two lines where the tile leaves room under the card (the library
    ' grid: 294-high cards in 432-high tiles leave 102 px); rows on Home, Details, Search, Person and Favorites
    ' (70 px) keep one. (v1.1.3) The limit was 120 px, so the library never got two lines; 100 px fits the
    ' two lines and the year with the focus drop (focused: title at y 332, year at 396, ending at 426 of 432)
    m.twoLine = not m.person and not m.landscape and (m.top.height - 2 * pad - h) >= 100
    m.year.color = "0xFFFFFF99"
    if m.person then m.year.color = "0xFFFFFFCC"
    ' people: the name on up to two lines across the whole tile, the role under it
    n2 = m.top.findNode("name2")
    n2.visible = m.person
    if m.person
        m.title.translation = [0, pad + h + 12]
        n2.translation = [0, pad + h + 42]
        m.year.translation = [0, pad + h + 74]
    end if
    m.w = w
    m.h = h
    ' (VD-1) the 216-wide library cards: smaller initials and badges
    m.small = w < 230
    m.initials.font.size = 48
    if m.small then m.initials.font.size = 40
    for each id in ["ph", "image", "mask", "initials"]
        n = m.top.findNode(id)
        n.width = w
        n.height = h
    end for
    ' (v1.4 R4) the resume ring at the bottom right, 12 px in (54 px; 48 on episode cards, under their text)
    rs = 54
    if m.epCard then rs = 48
    rg = m.top.findNode("resume")
    rg.translation = [w - 12 - rs, h - 12 - rs]
    for each id in ["resumeBg", "resumeTrack", "resumeArc"]
        n = m.top.findNode(id)
        n.width = rs
        n.height = rs
    end for
    rp = m.top.findNode("resumePlay")
    rp.width = Int(rs * 0.41)
    rp.height = rp.width
    rp.translation = [Int((rs - rp.width) / 2) + 2, Int((rs - rp.width) / 2)]
    m.image.loadWidth = w
    m.image.loadHeight = h
    ' (v1.5 flat) one focus rule for every card: a plain white 4 px ring, 4 px outside the edge (r18 around the
    ' r12 cards, a circle around people), no glow, shadow or zoom
    ring = m.top.findNode("ring")
    ring.uri = "pkg:/images/ui/focus_ring_r18.9.png"
    ring.translation = [-8, -8]
    ring.width = w + 16
    ring.height = h + 16
    if m.person
        ring.uri = "pkg:/images/ui/ring_circle_256.png"
        ring.translation = [-8, -8]
        ring.width = w + 16
        ring.height = h + 16
    end if
    m.top.findNode("heart").translation = [14, 14]
    ' poster: progress inside the bottom of the image
    m.top.findNode("barTrack").translation = [12, h - 18]
    m.top.findNode("barTrack").width = w - 24
    m.top.findNode("barFill").translation = [12, h - 18]
    ' landscape overlay: (v1.4) the Mac's thumbnail scrim, dark at the top and the bottom
    sc = m.top.findNode("scrim")
    sc.uri = "pkg:/images/ui/scrim_thumb.png"
    sc.translation = [0, 0]
    sc.width = w
    sc.height = h
    for each id in ["overTop", "overTopShadow"]
        n = m.top.findNode(id)
        n.width = w - 42
        n.height = 34
    end for
    m.top.findNode("overTop").translation = [21, 16]
    m.top.findNode("overTopShadow").translation = [22, 19]
    if m.epCard
        sc.uri = "pkg:/images/ui/scrim_card.png"
        sc.translation = [0, h - 270]
        sc.height = 270
        lw = w - 40
        m.top.findNode("epEyebrow").translation = [20, h - 214]
        m.top.findNode("epTitle").translation = [20, h - 182]
        for i = 0 to 2
            l = m.top.findNode("epOv" + i.toStr())
            l.translation = [20, h - 142 + i * 30]
            l.width = lw
        end for
        m.top.findNode("epEyebrow").width = lw
        m.top.findNode("epTitle").width = lw
        m.top.findNode("epCheck").translation = [20, h - 36]
        m.top.findNode("epTrack").translation = [20, h - 29]
        m.top.findNode("epFill").translation = [20, h - 29]
        m.top.findNode("epFoot").translation = [50, h - 42]
    end if
    ot = m.top.findNode("overTitle")
    ot.translation = [21, h - 96]
    ot.width = w - 42
    os = m.top.findNode("overSub")
    os.translation = [21, h - 64]
    os.width = w - 42
    m.top.findNode("miniTrack").translation = [21, h - 26]
    m.top.findNode("miniTrack").width = 64
    m.top.findNode("miniFill").translation = [21, h - 26]
    m.top.findNode("miniLeft").translation = [100, h - 40]
    m.title.width = w
    m.title.wrap = m.twoLine
    m.title.maxLines = 1
    if m.twoLine
        m.title.maxLines = 2
        m.title.lineSpacing = 0
    end if
    m.year.width = w
    m.year.wrap = m.person
    m.year.maxLines = 1
    if m.person
        ' the role may take two lines (long character names were cut off)
        m.year.maxLines = 2
        m.year.height = 58
        m.title.width = m.top.width
        m.year.width = m.top.width
        m.top.findNode("name2").width = m.top.width
    end if
    onContent()
    onFocus()
end sub

sub onContent()
    c = m.top.itemContent
    if c = invalid or m.w = invalid then return
    isPerson = c.hasField("kind") and c.kind = "person"
    isEp = c.hasField("kind") and c.kind = "episode"
    isLib = c.hasField("kind") and c.kind = "library"
    if (c.hasField("landscape") and c.landscape) <> m.landscape or isPerson <> m.person or isEp <> m.epCard or isLib <> m.libTile
        onSize()
        return
    end if
    ' people (cast): round photo, no border; a round focus ring (VD-7)
    t = m.global.theme
    mk = m.top.findNode("mask")
    if m.person
        mk.uri = t.maskCircle
    else
        mk.uri = t.maskPoster
    end if
    if drawPlaceholder(c) then return
    if drawSeeAll(c) then return
    m.initials.text = UCase(Left(c.title, 1))
    m.initials.visible = true
    m.image.uri = c.hdPosterUrl
    played = c.hasField("played") and c.played
    m.image.opacity = 1.0
    ' (v1.4 R5) watched posters, wide cards and episodes at 60 % (Settings → General → Dim Watched)
    if played and m.dimWatched and not m.person then m.image.opacity = 0.6
    m.selected = c.hasField("selected") and c.selected
    p = 0.0
    if c.hasField("progress") then p = c.progress
    hasProgress = p > 0.01 and p < 0.99
    ' poster cards: title and year below, a white bar inside the image
    m.title.visible = not m.landscape
    m.year.visible = not m.landscape
    if m.person then m.year.visible = true
    m.title.text = c.title
    m.year.text = c.shortDescriptionLine2
    placeText()
    if m.person
        lines = Util.wrapLines(c.title, 13, 2)
        first = ""
        second = ""
        if lines.count() > 0 then first = lines[0]
        if lines.count() > 1 then second = lines[1]
        if second.endsWith("...") then second = second.left(second.len() - 3)
        m.title.text = first
        m.top.findNode("name2").text = second
    end if
    m.top.findNode("barTrack").visible = hasProgress and not m.landscape
    bf = m.top.findNode("barFill")
    bf.visible = hasProgress and not m.landscape
    bf.width = (m.w - 24) * p
    ' landscape cards: text over a dark fade, a small white bar and the time left
    m.top.findNode("scrim").visible = m.landscape
    ot = m.top.findNode("overTitle")
    ot.visible = m.landscape
    ot.text = c.title
    os = m.top.findNode("overSub")
    remain = ""
    if c.hasField("timeLeft") then remain = c.timeLeft
    ' (v1.4 R4) as the Mac's Continue Watching card: "S3:E3  ·  42m left" at the top left, the title at the
    ' bottom left and the resume ring at the bottom right (no progress bar). Upcoming cards keep their
    ' "Tomorrow  ·  S1:E2  ·  Name" line over the title.
    epText = ""
    if c.hasField("episode") then epText = c.episode
    upcoming = c.hasField("airLabel")
    topParts = []
    if not upcoming and epText <> ""
        se = epText
        cut = Instr(1, se, "  ·  ")
        if cut > 0 then se = se.left(cut - 1)
        topParts.push(se)
    end if
    if hasProgress and remain <> "" then topParts.push(remain)
    topText = Util.join(topParts, "  ·  ")
    for each id in ["overTop", "overTopShadow"]
        n = m.top.findNode(id)
        n.text = topText
        n.visible = m.landscape and topText <> ""
    end for
    os.visible = m.landscape and upcoming and epText <> ""
    os.text = epText
    showRing = m.landscape and hasProgress
    showResumeRing(showRing, p)
    m.top.findNode("miniTrack").visible = false
    mf = m.top.findNode("miniFill")
    mf.visible = false
    ml = m.top.findNode("miniLeft")
    ml.visible = false
    ' (the title keeps clear of the ring)
    ow = m.w - 42
    if showRing then ow = m.w - 42 - 66
    ot.width = ow
    os.width = ow
    ot.translation = [21, m.h - 56]
    if os.visible then ot.translation = [21, m.h - 92]
    os.translation = [21, m.h - 52]
    ' episode card: its own text block replaces the wide-card overlay
    epG = m.top.findNode("ep")
    epG.visible = m.epCard
    if m.epCard
        ot.visible = false
        os.visible = false
        m.top.findNode("miniTrack").visible = false
        mf.visible = false
        ml.visible = false
        m.top.findNode("scrim").visible = true
        m.top.findNode("overTop").visible = false
        m.top.findNode("overTopShadow").visible = false
        m.top.findNode("epEyebrow").text = UCase(c.episode)
        m.top.findNode("epTitle").text = c.title
        lines = Util.wrapLines(c.overview, 35, 3)
        for i = 0 to 2
            line = ""
            if i < lines.count() then line = lines[i]
            m.top.findNode("epOv" + i.toStr()).text = line
        end for
        runtime = ""
        if c.hasField("runtime") then runtime = c.runtime
        check = m.top.findNode("epCheck")
        track = m.top.findNode("epTrack")
        fill = m.top.findNode("epFill")
        foot = m.top.findNode("epFoot")
        ' (v1.3.2) watched shows as the corner badge (below), not a small check by the runtime
        check.visible = false
        ' (v1.4 D5) the resume ring at the bottom right replaces the progress bar
        track.visible = false
        fill.visible = false
        inProgress = hasProgress and not played
        showResumeRing(inProgress, p)
        foot.translation = [20, m.h - 42]
        foot.text = runtime
        if inProgress and remain <> "" then foot.text = remain
        ' (the last overview line keeps clear of the ring)
        ol = m.top.findNode("epOv2")
        ol.width = m.w - 40
        if inProgress then ol.width = m.w - 40 - 60
        unplayed = 0
    end if
    ' favourite heart, watched check / unwatched count
    m.top.findNode("heart").visible = c.hasField("favorite") and c.favorite
    badge = m.top.findNode("badge")
    icon = m.top.findNode("badgeIcon")
    bt = m.top.findNode("badgeText")
    unplayed = 0
    if c.hasField("unplayed") then unplayed = c.unplayed
    ' (wide Continue Watching / Next Up cards don't show it, as on the Mac; episode cards do)
    if (m.landscape and not m.epCard and not (c.hasField("showBadge") and c.showBadge)) or m.person
        played = false
        unplayed = 0
    end if
    bs = 36
    if m.small then bs = 32
    icon.width = bs - 14
    icon.height = bs - 14
    icon.blendColor = "0xFFFFFFFF"
    badge.blendColor = "0xFFFFFFFF"
    ' (v1.1.2) 2:3 posters: the check / count in the top-left corner, because many posters carry rating
    ' badges (IMDb, RT, Metacritic) baked into their top-right corner; the heart moves under it.
    ' Wide cards keep them top-right (their heart is top-left).
    leftSide = not m.landscape
    heart = m.top.findNode("heart")
    heart.translation = [14, 14]
    if leftSide and (played or unplayed > 0) then heart.translation = [12 + Int((bs - 28) / 2), 12 + bs + 8]
    if played
        ' (v1.5 flat) a solid white disc with a thin dark edge (reads on bright posters) and a dark check
        badge.uri = "pkg:/images/ui/badge_watched.png"
        badge.blendColor = "0xFFFFFFFF"
        icon.blendColor = t.onFocus
        icon.width = bs - 12
        icon.height = bs - 12
        bx = m.w - 12 - bs
        if leftSide then bx = 12
        badge.width = bs
        badge.height = bs
        badge.translation = [bx, 12]
        icon.translation = [bx + 6, 18]
        badge.visible = true
        icon.visible = true
        bt.visible = false
    else if unplayed > 0
        s = unplayed.toStr()
        if unplayed > 99 then s = "99+"
        bw = bs + (s.len() - 1) * 15
        badge.uri = "pkg:/images/ui/badge_capsule.9.png"
        badge.width = bw
        badge.height = bs
        bx = m.w - 12 - bw
        if leftSide then bx = 12
        badge.translation = [bx, 12]
        bt.text = s
        bt.width = bw
        bt.height = bs
        bt.translation = [bx, 12]
        badge.visible = true
        bt.visible = true
        icon.visible = false
    else
        badge.visible = false
        icon.visible = false
        bt.visible = false
    end if
end sub

' (v1.1.1 SP-6) A library page still loading: an empty card with a title and a year bar, as the skeleton.
' The bars are made the first time a placeholder is shown, so other cards don't carry them.
function drawPlaceholder(c as object) as boolean
    isPh = c.hasField("kind") and c.kind = "placeholder"
    if m.phBars <> invalid then m.phBars.visible = isPh
    if not isPh then return false
    if m.phBars = invalid
        m.phBars = m.top.createChild("Group")
        for each wide in [0.7, 0.4]
            b = m.phBars.createChild("Poster")
            b.uri = "pkg:/images/ui/white_pill.9.png"
            b.blendColor = "0xFFFFFF1A"
            b.width = Int(m.w * wide)
            b.height = 22
            if wide < 0.5 then b.height = 18
        end for
    end if
    pad = 18
    bars = [m.phBars.getChild(0), m.phBars.getChild(1)]
    bars[0].width = Int(m.w * 0.7)
    bars[0].translation = [pad + Int(m.w * 0.15), pad + m.h + 18]
    bars[1].width = Int(m.w * 0.4)
    bars[1].translation = [pad + Int(m.w * 0.3), pad + m.h + 52]
    m.image.uri = ""
    m.initials.visible = false
    m.title.visible = false
    m.year.visible = false
    for each id in ["barTrack", "barFill", "scrim", "overTitle", "overSub", "overTop", "overTopShadow", "resume", "miniTrack", "miniFill", "miniLeft", "ep", "heart", "badge", "badgeIcon", "badgeText"]
        m.top.findNode(id).visible = false
    end for
    return true
end function

' (v1.6 M-2) A Home row's last card, "See All": a flat tile in the row's card shape (the page's control fill,
' the label and a right chevron in the middle, no picture); the focus ring as on every card. Made the first
' time one is shown; a recycled tile hides it again.
function drawSeeAll(c as object) as boolean
    isSeeAll = c.hasField("kind") and c.kind = "seeall"
    if m.seeAll <> invalid then m.seeAll.visible = isSeeAll
    ph = m.top.findNode("ph")
    if not isSeeAll
        ph.color = m.global.theme.placeholder
        return false
    end if
    t = m.global.theme
    if m.seeAll = invalid
        m.seeAll = m.top.findNode("card").createChild("Group")
        lab = m.seeAll.createChild("Label")
        lab.id = "seeAllText"
        lab.text = "See All"
        lab.horizAlign = "center"
        lab.vertAlign = "center"
        fnt = createObject("roSGNode", "Font")
        fnt.uri = "font:BoldSystemFontFile"
        fnt.size = 30
        lab.font = fnt
        chev = m.seeAll.createChild("Poster")
        chev.id = "seeAllChev"
        chev.uri = "pkg:/images/ui/icon_chevron_28.png"
        chev.width = 28
        chev.height = 28
        chev.scaleRotateCenter = [14, 14]
        ' (the down chevron turned to point right)
        chev.rotation = 1.5708
    end if
    lab = m.seeAll.findNode("seeAllText")
    lab.color = t.text
    lab.width = m.w
    lab.height = 44
    lab.translation = [0, Int(m.h / 2) - 40]
    chev = m.seeAll.findNode("seeAllChev")
    chev.blendColor = t.text
    chev.translation = [Int(m.w / 2) - 14, Int(m.h / 2) + 12]
    ph.color = t.controlFill
    m.image.uri = ""
    m.image.opacity = 1.0
    m.initials.text = ""
    m.initials.visible = false
    m.title.visible = false
    m.year.visible = false
    m.selected = false
    for each id in ["barTrack", "barFill", "scrim", "overTitle", "overSub", "overTop", "overTopShadow", "resume", "miniTrack", "miniFill", "miniLeft", "ep", "heart", "badge", "badgeIcon", "badgeText"]
        m.top.findNode(id).visible = false
    end for
    return true
end function

' (v1.4 R4) The resume ring: the accent arc drawn from the 4 % frames of the player's loading ring
sub showResumeRing(show as boolean, p as float)
    rg = m.top.findNode("resume")
    rg.visible = show
    if not show then return
    frame = Int(p * 25 + 0.5) * 4
    if frame < 4 then frame = 4
    if frame > 100 then frame = 100
    s = frame.toStr()
    while s.len() < 3
        s = "0" + s
    end while
    m.top.findNode("resumeArc").uri = "pkg:/images/ui/load_arc_" + s + ".png"
end sub

sub onLoad()
    m.initials.visible = m.image.loadStatus <> "ready" and m.initials.text <> ""
end sub

' Poster title and year under the card (v1.5 flat: no zoom, so they stay put; the ring ends 8 px under the
' card, above the title). (v1.1.2) The year follows the title's one or two lines: the wrapped title's height is
' measured (one line: the year 30 px under the title, as before; two lines: 60 to 64 px).
sub placeText()
    if m.person or m.landscape or m.h = invalid then return
    gap = 14
    yearAt = 30
    if m.twoLine
        gap = 12
        tall = m.title.localBoundingRect().height
        if tall > 45
            yearAt = Int(tall)
            if yearAt < 60 then yearAt = 60
            if yearAt > 64 then yearAt = 64
        end if
    end if
    top = 18 + m.h + gap
    m.title.translation = [18, top]
    m.year.translation = [18, top + yearAt]
end sub

' (v1.5 flat) Focus: the plain white ring only (no zoom, glow or shadow), title fully white
sub onFocus()
    listFocus = m.top.rowListHasFocus or m.top.gridHasFocus
    f = 0.0
    if listFocus then f = m.top.focusPercent * m.top.rowFocusPercent
    ' a chosen season keeps its ring
    ringOp = f
    if m.selected and ringOp < 1 then ringOp = 1
    m.top.findNode("ring").opacity = ringOp
    if f > 0.5
        m.title.color = "0xFFFFFFFF"
    else
        m.title.color = "0xFFFFFFEB"
    end if
end sub
