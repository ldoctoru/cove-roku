import "pkg:/source/Util.bs"
import "pkg:/source/QuickPlay.bs"
import "pkg:/source/Servers.bs"
import "pkg:/source/Api.bs"
import "pkg:/source/Prefs.bs"
import "pkg:/source/NavPrefs.bs"
import "pkg:/source/Speak.bs"
import "pkg:/source/Ratings.bs"
import "pkg:/source/Toasts.bs"
import "pkg:/source/Hints.bs"
import "pkg:/source/NavUtil.bs"
import "pkg:/source/Clock.bs"

sub init()
    Clock.startupMark("HomeScreen init")
    m.readySent = false     ' Home told MainScene it is ready (AppLaunchComplete)
    m.partialShown = false   ' (v1.2) the rows on screen are a first part; the full rows are still to come
    t = m.global.theme
    m.rows = m.top.findNode("rows")
    m.status = m.top.findNode("status")
    m.errorPanel = m.top.findNode("errorPanel")
    m.errorPanel.observeField("chosen", "onErrorChosen")
    m.hintBar = m.top.findNode("hintBar")
    m.wantHint = invalid     ' (read from the registry once, when the first card takes the focus)
    m.hintShown = false
    ' Sidebar or top bar (Settings → General → Navigation)
    m.side = NavPrefs.menuStyle() <> "topbar"
    m.navLogged = ""
    m.navs = m.top.findNode("navs")
    if m.side
        m.nav = m.top.findNode("side")
        m.rowsX = 150
    else
        m.nav = m.top.findNode("top")
        m.nav.labels = Prefs.topBarLabels()
        m.rowsX = 78
        m.top.findNode("hero").translation = [0, 0]
        m.top.findNode("info").translation = [96, 96]
        m.top.findNode("status").translation = [96, 520]
        m.top.findNode("errorPanel").translation = [140, 380]
        m.top.findNode("rows").itemSize = [1842, 466]
    end if
    m.nav.visible = true
    m.bdA = m.top.findNode("bdA")
    m.bdB = m.top.findNode("bdB")
    m.heroLogo = m.top.findNode("heroLogo")
    m.top.findNode("scrimBottom").uri = t.scrimBottom
    m.top.findNode("rowsFade").uri = t.fade
    m.top.findNode("rowsSolid").color = t.bg
    m.backdropTimer = m.top.findNode("backdropTimer")
    m.heroTimer = m.top.findNode("heroTimer")
    m.watchdog = m.top.findNode("watchdog")
    m.slide = m.top.findNode("slide")
    m.xfade = m.top.findNode("xfade")
    m.backdropTimer.observeField("fire", "onBackdropTimer")
    m.heroTimer.observeField("fire", "onHeroTimer")
    m.watchdog.observeField("fire", "onWatchdog")
    m.bdA.observeField("loadStatus", "onBackdropLoaded")
    m.bdB.observeField("loadStatus", "onBackdropLoaded")
    m.heroLogo.observeField("loadStatus", "onLogoLoaded")
    m.rows.observeField("rowItemFocused", "onItemFocused")
    m.rows.observeField("rowItemSelected", "onItemSelected")
    m.nav.observeField("chosen", "onNavChosen")
    m.top.observeField("focusedChild", "onFocusChanged")
    m.task = invalid
    m.pending = []
    m.heroes = []
    m.heroIndex = 0
    m.btn = 0
    m.state = "loading"
    m.front = invalid         ' the backdrop Poster on screen
    m.wantBackdrop = ""
    m.pendingBackdrop = ""
    m.libraries = []
    m.nowPlaying = 0
    m.navReturn = "hero"
    m.sessionsTimer = m.top.findNode("sessionsTimer")
    m.sessionsTimer.observeField("fire", "loadSessions")
    ' (v1.3.2) Settings → Home → Banner: its source and refresh, the fetched titles (nodes), the rows' rotation
    m.bannerPref = Prefs.bannerPref()
    m.bannerNodes = []
    m.bannerRound = 0
    m.bannerLast = 0
    m.bannerTask = invalid
    m.bannerTick = m.top.findNode("bannerTick")
    m.bannerTick.observeField("fire", "onBannerTick")
    buildNav()
    m.top.findNode("hero").visible = false
    m.picker = invalid
    m.menuItem = invalid
    m.timersPaused = false
    ' (v1.1.1 NV-5) the hero stops rotating once a key is pressed on Home, until Home is left and reached again
    m.heroHeld = false
    m.spokenRow = -1
    ' (Cove speaks the cards and the hero itself, see speakHero / onItemFocused)
    Speak.mute([m.rows, m.top.findNode("heroKeys")])
    Clock.startupMark("HomeScreen init done")
end sub

' ---------------------------------------------------------------- loading

sub load()
    s = m.top.server
    if m.reloading <> true
        m.status.text = "Loading your libraries..."
        m.status.visible = true
    end if
    hideError()
    ' a reload while one still runs: drop the older task, its late answer must not be read as this one's
    if m.task <> invalid
        m.task.unobserveField("content")
        m.task.unobserveField("rowsAdded")
        m.task.unobserveField("error")
        m.task.unobserveField("authFailed")
        m.task.unobserveField("heroItems")
        m.task.control = "stop"
    end if
    m.task = createObject("roSGNode", "HomeTask")
    m.libsPending = true
    m.task.server = s
    ' (v1.1.1) the launch timing lines, for the first load only
    m.task.timing = m.timedLoad <> true
    m.timedLoad = true
    m.task.observeField("content", "onContent")
    m.task.observeField("rowsAdded", "onRowsAdded")
    m.task.observeField("error", "onError")
    m.task.observeField("authFailed", "onAuthFailed")
    ' (v1.3.2) the banner's own titles, fetched by the task after the rows; a reload (after playback, a
    ' favourite) keeps Random Picks as they are instead of picking a new set
    src = m.bannerPref.source
    if m.reloading = true and src = "random" and m.bannerNodes.count() > 0 then src = ""
    m.task.bannerSource = src
    m.task.observeField("heroItems", "onHeroItems")
    m.bannerLast = bannerNowSecs()
    m.bannerRound = 0
    m.task.control = "RUN"
    Clock.startupMark("home task started")
    m.watchdog.control = "start"
end sub

sub onWatchdog()
    if m.status.visible and not m.rows.visible
        showError("The server is taking too long to answer.")
        signalReady()
    end if
end sub

' ---------------------------------------------------------------- error panel

' Instead of the rows: the message with Try Again / Switch Server / Settings (the focus goes to the buttons)
sub showError(text as string, icon = "error" as string)
    m.watchdog.control = "stop"
    m.status.visible = false
    m.rows.visible = false
    m.top.findNode("hero").visible = false
    m.errorPanel.icon = icon
    m.errorPanel.message = text
    m.errorPanel.index = 0
    m.errorPanel.visible = true
    m.state = "error"
    if m.top.isInFocusChain() and m.picker = invalid then m.errorPanel.setFocus(true)
end sub

sub hideError()
    if not m.errorPanel.visible then return
    m.errorPanel.visible = false
    if m.errorPanel.isInFocusChain() then m.top.findNode("heroKeys").setFocus(true)
end sub

sub onErrorChosen(ev as object)
    id = ev.getData().id
    if id = "retry"
        m.state = "loading"
        m.rows.visible = false
        load()
    else if id = "switch"
        m.top.action = { id: "switch" }
    else if id = "settings"
        m.top.action = { id: "settings" }
    end if
end sub

' Reload after playback, keeping the screen as it is until the new rows arrive
sub onReload()
    ' (SC-2) no rows on screen (the error panel, or still loading): the normal load with its status and
    ' watchdog, and the focus goes to the hero / rows when they arrive
    if not m.rows.visible
        m.reloading = false
        if m.state = "error" then m.state = "loading"
        load()
        return
    end if
    m.reloading = true
    load()
end sub

sub onContent(ev as object)
    if m.task = invalid or not ev.getRoSGNode().isSameNode(m.task) then return
    content = ev.getData()
    if content = invalid then return
    Clock.startupMark("home rows received")
    m.watchdog.control = "stop"
    if content.getChildCount() = 0
        showError("There is nothing to show on Home yet. Check that this account can see a library on the server.", "info")
        signalReady()
        return
    end if
    hideError()
    signalReady()
    ' Per row: 16:9 cards for Continue Watching / Next Up, My Media's library tiles, 2:3 posters with title and year otherwise
    sizeRows(content)
    ' (v1.2) the full rows after a first part: a reload (keep the focus, don't jump to the hero)
    wasReload = m.reloading = true or m.partialShown = true
    m.partialShown = ev.getRoSGNode().partial = true
    m.reloading = false
    keep = m.rows.rowItemFocused
    m.rows.content = content
    if wasReload and keep <> invalid and keep.count() >= 2 and keep[0] < content.getChildCount()
        r = content.getChild(keep[0])
        col = keep[1]
        if col >= r.getChildCount() then col = r.getChildCount() - 1
        if col >= 0 then m.rows.jumpToRowItem = [keep[0], col]
    end if
    m.rows.visible = true
    m.status.visible = false
    m.libsPending = false
    buildNav()
    loadSessions()
    ' (a reload can answer while another screen is on top: polling starts again when Home is back)
    if m.top.isInFocusChain()
        m.sessionsTimer.control = "start"
        startBannerTick()
    end if
    buildHeroes(content)
    ' (SC-2: also from the error panel, which had the focus and is gone now)
    if not wasReload or m.state = "loading" or m.state = "error"
        ' (SC5-2) a cold-launch deep link may already have pushed the player or a page over Home: lay Home out
        ' but leave the remote there; onFocusChanged focuses the hero or rows when Home is back on top
        onTop = m.top.isInFocusChain()
        if not onTop then print "Cove: home rows arrived under another screen (focus left there)"
        if m.heroes.count() > 0
            enterHero(false, onTop)
        else
            enterRows(false, onTop)
        end if
    end if
    Clock.startupMark("home rows drawn")
    ' (no backdrop to wait for: the startup steps end here)
    if m.heroes.count() = 0 then m.global.startupDone = true
end sub

sub onError(ev as object)
    if m.task = invalid or not ev.getRoSGNode().isSameNode(m.task) then return
    m.watchdog.control = "stop"
    text = Util.toText(ev.getData())
    ' (a refresh that failed while the rows are up: keep them, say so)
    if m.rows.visible and m.rows.content <> invalid and m.rows.content.getChildCount() > 0
        m.reloading = false
        if m.top.isInFocusChain() then Toasts.notify("Couldn't refresh Home. " + text, "info")
        signalReady()
        return
    end if
    showError(text)
    signalReady()
end sub

' The first rows or an error are on screen: MainScene sends AppLaunchComplete (C-2), once per Home
sub signalReady()
    if m.readySent then return
    m.readySent = true
    m.top.action = { id: "ready" }
end sub

' A 401 on one list: check the sign-in itself before asking to sign in again (a single list can refuse
' for other reasons, e.g. a library the user may not see)
sub onAuthFailed(ev as object)
    if m.task = invalid or not ev.getRoSGNode().isSameNode(m.task) or not ev.getData() then return
    t = createObject("roSGNode", "ApiTask")
    t.request = { method: "GET", url: Util.toText(m.top.server.url) + "/Users/" + Util.toText(m.top.server.userId), headers: Api.headers(m.top.server, true), body: "", tag: { kind: "authCheck" }, timeout: 15000 }
    t.observeField("response", "onAuthCheck")
    m.pending.push(t)
    t.control = "RUN"
end sub

sub onAuthCheck(ev as object)
    r = ev.getData()
    print "Cove: sign-in check -> "; r.code
    if r.code = 401 then m.top.action = { id: "expired" }
end sub

' The sidebar / top bar, as on the Mac: Home first, then the menu style's own list (v1.5 NavPrefs: Settings →
' Navigation, in its order, only the entries switched on; Search, Favorites, Now Playing with the count, Recently
' Added, the libraries), then the profile and Settings last. The sidebar keeps the Mac's "My Media" header
' while Recently Added and the libraries still come after the pages.
sub buildNav()
    items = [{ id: "home", label: "Home", icon: "home", pinned: true }]
    libs = invalid
    if m.task <> invalid then libs = m.task.libraries
    ' (SC-6) a reload's task has no libraries until its rows arrive: keep the last list meanwhile
    if m.libsPending = true and m.libraries.count() > 0 then libs = m.libraries
    m.libraries = []
    libAt = {}
    if libs <> invalid
        for i = 0 to libs.count() - 1
            m.libraries.push(libs[i])
            libAt["L" + Util.toText(libs[i].id)] = i
        end for
    end if
    place = NavPrefs.activePlace()
    shownList = []
    for each e in NavPrefs.entries(place, m.libraries)
        if e.on
            if e.id = "search"
                shownList.push({ id: "search", label: "Search", icon: "search" })
            else if e.id = "favorites"
                shownList.push({ id: "favorites", label: "Favorites", icon: "heart" })
            else if e.id = "nowplaying"
                shownList.push({ id: "nowplaying", label: "Now Playing", icon: "nowplaying", badge: m.nowPlaying })
            else if e.id = "recent"
                shownList.push({ id: "recent", label: "Recently Added", icon: "clock", media: true })
            else if e.isLibrary and libAt.doesExist(e.id)
                ic = "folder"
                if e.collectionType = "movies" then ic = "film"
                if e.collectionType = "tvshows" then ic = "tv"
                shownList.push({ id: "lib:" + libAt[e.id].toStr(), label: e.label, icon: ic, media: true })
            end if
        end if
    end for
    ' (v1.4 N2) the Mac's sidebar header, before the first of Recently Added / the libraries when no page
    ' follows them
    headerAt = -1
    if m.side
        for k = shownList.count() - 1 to 0 step -1
            if Util.flag(shownList[k], "media")
                headerAt = k
            else
                exit for
            end if
        end for
    end if
    for k = 0 to shownList.count() - 1
        if k = headerAt then items.push({ header: true, label: "My Media" })
        items.push(shownList[k])
    end for
    if m.side then items.push({ header: true, label: "" })
    ' (v0.9.0) the signed-in profile: OK opens Who's watching? to switch or add one
    who = ""
    if m.top.server <> invalid then who = Util.toText(m.top.server.userName)
    if who = "" then who = "Profiles"
    items.push({ id: "profile", label: who, icon: "profile", pinned: true })
    items.push({ id: "settings", label: "Settings", icon: "gear", pinned: true })
    sig = place + ":" + shownList.count().toStr()
    if sig <> m.navLogged
        m.navLogged = sig
        print "Cove: nav " + place + " " + shownList.count().toStr() + " entries"
    end if
    m.nav.items = items
end sub

' How many are playing on the server right now (the Now Playing badge)
sub loadSessions()
    t = createObject("roSGNode", "ApiTask")
    t.request = { method: "GET", url: Util.toText(m.top.server.url) + "/Sessions?ActiveWithinSeconds=960", headers: Api.headers(m.top.server, true), body: "", tag: { kind: "sessions" }, timeout: 15000 }
    t.observeField("response", "onSessions")
    m.sessionsTask = t
    t.control = "RUN"
end sub

sub onSessions(ev as object)
    r = ev.getData()
    n = 0
    if r.code = 200 and type(r.json) = "roArray"
        for each s in r.json
            ' (v0.9.1: as on Now Playing, only what the profile's rating limit lets through)
            if Util.isAA(s) and Util.isAA(s.NowPlayingItem) and Ratings.allowed(m.top.server, s.NowPlayingItem) then n = n + 1
        end for
    end if
    if n <> m.nowPlaying
        m.nowPlaying = n
        buildNav()
    end if
end sub

' The hero shows up to 8 titles: the first two with a backdrop from each row, as on the Mac. (v1.3.2) Or the
' banner's own titles (Settings → Home → Banner shows) once fetched; a refresh of From Home Rows takes the
' next two of each row (m.bannerRound, wrapping at the row's end).
sub buildHeroes(content as object)
    if m.bannerNodes.count() > 0
        applyHeroes(m.bannerNodes)
        return
    end if
    applyHeroes(rowHeroes(content, m.bannerRound))
end sub

function rowHeroes(content as object, round as integer) as object
    out = []
    seen = {}
    if content = invalid then return out
    for i = 0 to content.getChildCount() - 1
        row = content.getChild(i)
        withArt = []
        for j = 0 to row.getChildCount() - 1
            it = row.getChild(j)
            if it.backdrop <> "" and not isFolderKind(it.itemType) and not isUpcomingCard(it) and not seen.doesExist(it.itemId) then withArt.push(it)
        end for
        n = withArt.count()
        take = 2
        if n < take then take = n
        for k = 0 to take - 1
            it = withArt[(round * 2 + k) mod n]
            if out.count() < 8 and not seen.doesExist(it.itemId)
                seen[it.itemId] = true
                out.push(it)
            end if
        end for
    end for
    return out
end function

' The hero's titles: the one on screen keeps its place when it is still there; while the hero has the focus
' and a key was pressed (NV-5), a new set keeps the title on screen first, so OK still acts on what is shown
sub applyHeroes(list as object)
    keep = invalid
    if m.heroes.count() > 0 and m.heroIndex < m.heroes.count() then keep = m.heroes[m.heroIndex]
    heroes = []
    heroes.append(list)
    found = -1
    if keep <> invalid
        for i = 0 to heroes.count() - 1
            if heroes[i].itemId = keep.itemId then found = i
        end for
        if found < 0 and m.state = "hero" and m.heroHeld and heroes.count() > 0
            heroes.unshift(keep)
            if heroes.count() > 8 then heroes.pop()
            found = 0
        end if
    end if
    m.heroes = heroes
    m.heroIndex = 0
    if found >= 0 then m.heroIndex = found
    buildDots()
    m.top.findNode("hero").visible = m.heroes.count() > 0
    if m.heroes.count() > 0 then showHero(m.heroIndex)
    ' (SC5-11) the banner emptied while it had the focus (a reload): the rows take over
    if m.heroes.count() = 0 and m.state = "hero" then enterRows(false, m.top.isInFocusChain())
end sub

' (v1.3.2) The banner's own titles arrived (load or refresh): only the hero changes, the focus stays where it
' is. No children: From Home Rows' fallback (nothing found or a failed request), the rows' titles stay.
sub onHeroItems(ev as object)
    t = ev.getRoSGNode()
    fromLoad = m.task <> invalid and t.isSameNode(m.task)
    fromRefresh = m.bannerTask <> invalid and t.isSameNode(m.bannerTask)
    if not fromLoad and not fromRefresh then return
    node = ev.getData()
    if node = invalid then return
    nodes = []
    for i = 0 to node.getChildCount() - 1
        nodes.push(node.getChild(i))
    end for
    if nodes.count() = 0
        ' (a refresh that found nothing: the rows' next titles, as on the Mac)
        if fromRefresh and m.rows.content <> invalid and m.bannerNodes.count() = 0
            m.bannerRound = m.bannerRound + 1
            applyHeroes(rowHeroes(m.rows.content, m.bannerRound))
        end if
        return
    end if
    before = ""
    if m.heroes.count() > 0 then before = m.heroes[m.heroIndex].itemId
    wasEmpty = m.heroes.count() = 0
    m.bannerNodes = nodes
    applyHeroes(nodes)
    ' (the hero came in where there was none: the rows make room for it unless they have the focus)
    if wasEmpty and m.state <> "rows" and m.state <> "error" then goTop(false)
    if m.state = "hero" and m.heroes.count() > 0 and m.heroes[m.heroIndex].itemId <> before then speakHero(true)
end sub

' ---------------------------------------------------------------- banner refresh (v1.3.2)

function bannerNowSecs() as integer
    d = createObject("roDateTime")
    return d.asSeconds()
end function

' Settings → Home → Refresh banner: a 30 s check while Home is on top (stopped with the other Home timers)
sub startBannerTick()
    if m.bannerPref.minutes > 0 then m.bannerTick.control = "start"
end sub

sub onBannerTick()
    if not HomeBanner.refreshDue(m.bannerPref.minutes, m.bannerLast, bannerNowSecs()) then return
    ' (not while Home loads, nor under a remote that is acting on the hero (NV-5): the next check)
    if m.task <> invalid and m.task.state = "run" then return
    if m.state = "hero" and m.heroHeld then return
    if not m.rows.visible then return
    m.bannerLast = bannerNowSecs()
    src = m.bannerPref.source
    if src = "rows"
        ' (v1.6 H-1) an Emby 4.10 Spotlight banner keeps its titles (they come with the next Home load)
        if m.bannerNodes.count() > 0 then return
        m.bannerRound = m.bannerRound + 1
        applyHeroes(rowHeroes(m.rows.content, m.bannerRound))
        print "Cove: home banner rows "; m.heroes.count(); " titles 0 ms (refresh "; m.bannerRound; ")"
        return
    end if
    if m.bannerTask <> invalid
        m.bannerTask.unobserveField("heroItems")
        m.bannerTask.control = "stop"
    end if
    prev = []
    for each h in m.heroes
        prev.push(h.itemId)
    end for
    t = createObject("roSGNode", "HomeTask")
    t.server = m.top.server
    t.libraries = m.libraries
    t.bannerSource = src
    t.bannerPrevious = prev
    t.bannerOnly = true
    t.observeField("heroItems", "onHeroItems")
    m.bannerTask = t
    t.control = "RUN"
end sub

function isFolderKind(t as string) as boolean
    return t = "CollectionFolder" or t = "UserView" or t = "Folder" or t = "BoxSet" or t = "Playlist"
end function

' ---------------------------------------------------------------- hero

sub buildDots()
    dots = m.top.findNode("dots")
    dots.removeChildrenIndex(dots.getChildCount(), 0)
    n = m.heroes.count()
    if n < 2 then return
    ' centred over the page (right of the sidebar; the hero group is moved 80 px right)
    x = Int((1808 - (n * 10 + (n - 1) * 14)) / 2) + 112 - 80
    if not m.side then x = Int((1920 - (n * 10 + (n - 1) * 14)) / 2)
    for i = 0 to n - 1
        d = dots.createChild("Poster")
        d.uri = "pkg:/images/ui/dot_10.png"
        d.width = 10
        d.height = 10
        d.translation = [x + i * 24, 0]
    end for
end sub

sub showHero(i as integer)
    n = m.heroes.count()
    if n = 0 then return
    m.heroIndex = (i + n) mod n
    it = m.heroes[m.heroIndex]
    dots = m.top.findNode("dots")
    for k = 0 to dots.getChildCount() - 1
        dots.getChild(k).opacity = 0.4
        if k = m.heroIndex then dots.getChild(k).opacity = 1.0
    end for
    m.top.findNode("heroTitle").text = it.title
    m.top.findNode("heroMeta").text = it.heroMeta
    lines = Util.wrapLines(it.overview, 58, 3)
    for k = 0 to 2
        line = ""
        if k < lines.count() then line = lines[k]
        m.top.findNode("hov" + k.toStr()).text = line
    end for
    m.lines = lines.count()
    chip = m.top.findNode("chipText")
    chip.text = it.chip
    m.top.findNode("chipBg").width = Int(chip.boundingRect().width) + 28
    ' (v1.2) the season and episode are on the meta line now (Items.heroMeta): no chip
    m.top.findNode("chip").visible = false
    ' (v1.4 H1) "Resume 24:10" with the restart arrow when there is a resume point (the Mac's "↻ 24:10"; the
    ' word stays on TV, the arrow alone reads poorly from the sofa)
    play = m.top.findNode("btnPlay")
    if it.resumeAt > 30
        play.icon = "pkg:/images/ui/icon_restart_28.png"
        play.text = "Resume " + clockText(it.resumeAt)
    else
        play.icon = "pkg:/images/ui/icon_play_28.png"
        play.text = "Play"
    end if
    ' title text until the logo has loaded
    m.logoReady = false
    m.heroLogo.visible = false
    m.top.findNode("heroTitle").visible = true
    m.heroLogo.uri = it.logo
    layoutHero()
    paintButtons()
    if m.state = "hero" or m.state = "nav" then showBackdrop(it.backdrop)
end sub

' Bottom-anchored: buttons end at y=880, overview above them, then details, then logo or title, then the chip
sub layoutHero()
    btnY = 640
    m.top.findNode("buttons").translation = [96, btnY]
    ovY = btnY - 30 - m.lines * 38
    m.top.findNode("heroOv").translation = [96, ovY]
    metaY = ovY - 50
    m.top.findNode("heroMeta").translation = [96, metaY]
    topY = metaY - 104
    m.top.findNode("heroTitle").translation = [96, topY]
    if m.logoReady
        topY = metaY - 16 - m.heroLogo.height
        m.heroLogo.translation = [96, topY]
    end if
    m.top.findNode("chip").translation = [96, topY - 50]
end sub

' Fit the logo into 630 x 135, keeping its proportions, aligned bottom-left
sub onLogoLoaded()
    if m.heroLogo.loadStatus <> "ready" then return
    bw = m.heroLogo.bitmapWidth
    bh = m.heroLogo.bitmapHeight
    if bw <= 0 or bh <= 0 then return
    s = 630 / bw
    if 135 / bh < s then s = 135 / bh
    m.heroLogo.width = Int(bw * s)
    m.heroLogo.height = Int(bh * s)
    m.logoReady = true
    m.heroLogo.visible = true
    m.top.findNode("heroTitle").visible = false
    layoutHero()
end sub

sub paintButtons()
    focused = m.state = "hero"
    it = invalid
    if m.heroes.count() > 0 then it = m.heroes[m.heroIndex]
    play = m.top.findNode("btnPlay")
    fav = m.top.findNode("btnFav")
    info = m.top.findNode("btnInfo")
    favIcon = "pkg:/images/ui/icon_plus_28.png"
    if it <> invalid and it.favorite then favIcon = "pkg:/images/ui/icon_check_28.png"
    if fav.icon <> favIcon then fav.icon = favIcon
    ' (v1.4 VD-10) the circles follow the Play pill's measured width
    x = play.buttonWidth + 21
    fav.translation = [x, 0]
    info.translation = [x + 90, 0]
    play.focused = focused and m.btn = 0
    fav.focused = focused and m.btn = 1
    info.focused = focused and m.btn = 2
end sub

sub onHeroTimer()
    if m.heroHeld then return
    if (m.state = "hero" or m.state = "nav") and m.heroes.count() > 1 then showHero(m.heroIndex + 1)
end sub

' (NV-5) the 9 s rotation, unless a key was pressed on Home since it was last reached
sub startHeroTimer()
    m.heroTimer.control = "stop"
    if not m.heroHeld then m.heroTimer.control = "start"
end sub

' (NV-5) a key on Home: OK must act on the title on screen, so the hero holds still from now on
sub holdHero()
    m.heroHeld = true
    m.heroTimer.control = "stop"
end sub

sub useButton()
    ' (SC5-11) no banner titles (left behind by a reload): nothing to act on
    if m.heroIndex < 0 or m.heroIndex >= m.heroes.count() then return
    it = m.heroes[m.heroIndex]
    if m.btn = 1
        toggleFavourite(it)
    else if m.btn = 2 or it.itemType = "Series"
        m.top.action = { id: "open", itemId: it.itemId, itemType: it.itemType, collectionType: it.collectionType, title: it.title }
    else
        start = 0.0
        if it.resumeAt > 30 then start = it.resumeAt
        m.top.action = { id: "play", itemId: it.itemId, itemType: Util.toText(it.itemType), title: it.title, subtitle: it.episode, start: start }
    end if
end sub

' ---------------------------------------------------------------- backdrop crossfade

sub showBackdrop(uri as string)
    if uri = "" or uri = m.wantBackdrop then return
    m.wantBackdrop = uri
    back = m.bdA
    if m.front <> invalid and m.front.isSameNode(m.bdA) then back = m.bdB
    if back.uri = uri and back.loadStatus = "ready"
        crossfadeTo(back)
    else
        back.uri = uri
    end if
end sub

sub onBackdropLoaded(ev as object)
    p = ev.getRoSGNode()
    if ev.getData() = "ready"
        Clock.startupMark("first backdrop loaded")
        m.global.startupDone = true
    end if
    if ev.getData() = "ready" and p.uri = m.wantBackdrop and (m.front = invalid or not m.front.isSameNode(p)) then crossfadeTo(p)
end sub

sub crossfadeTo(p as object)
    m.xfade.control = "stop"
    ia = m.top.findNode("xfadeA")
    ib = m.top.findNode("xfadeB")
    if p.isSameNode(m.bdA)
        ia.keyValue = [m.bdA.opacity, 1.0]
        ib.keyValue = [m.bdB.opacity, 0.0]
    else
        ia.keyValue = [m.bdA.opacity, 0.0]
        ib.keyValue = [m.bdB.opacity, 1.0]
    end if
    m.front = p
    m.xfade.control = "start"
end sub

' ---------------------------------------------------------------- focus areas

sub animateTo(rowsY as integer, heroOp as float, infoOp as float, navOp as float, bdOp as float, rowsBgOp as float)
    m.slide.control = "stop"
    cur = m.rows.translation
    m.top.findNode("rowsMove").keyValue = [[m.rowsX, cur[1]], [m.rowsX, rowsY]]
    m.top.findNode("heroFadeI").keyValue = [m.top.findNode("hero").opacity, heroOp]
    m.top.findNode("infoFadeI").keyValue = [m.top.findNode("info").opacity, infoOp]
    ' (the sidebar stays, as on the Mac: callers pass 1.0)
    m.top.findNode("navFadeI").keyValue = [m.navs.opacity, navOp]
    m.top.findNode("bdDimI").keyValue = [m.top.findNode("bdLayer").opacity, bdOp]
    m.top.findNode("rowsBgI").keyValue = [m.top.findNode("rowsBg").opacity, rowsBgOp]
    m.slide.control = "start"
end sub

sub enterHero(animate = true as boolean, takeFocus = true as boolean)
    if m.heroes.count() = 0
        enterRows(animate, takeFocus)
        return
    end if
    m.state = "hero"
    m.btn = 0
    ' the first row (Continue Watching) under the hero again, as on the Mac
    f = m.rows.rowItemFocused
    if m.rows.content <> invalid and m.rows.content.getChildCount() > 0 and f <> invalid and f.count() >= 2 and f[0] <> 0 then m.rows.jumpToRowItem = [0, 0]
    ' (a node of its own: setFocus on the screen itself doesn't take the focus back from the rows)
    if takeFocus then m.top.findNode("heroKeys").setFocus(true)
    goTop(animate)
    showBackdrop(m.heroes[m.heroIndex].backdrop)
    paintButtons()
    if not takeFocus then return
    startHeroTimer()
    speakHero(true)
end sub

' Audio Guide: the hero's focused button, with the title first when the hero (or its title) was just reached
sub speakHero(withTitle as boolean)
    if not Speak.isOn() or m.heroes.count() = 0 then return
    it = m.heroes[m.heroIndex]
    names = ["Play", "Add to Favorites", "More Information"]
    if it.itemType = "Series" then names[0] = "Open"
    if it.favorite then names[1] = "Remove from Favorites"
    text = Speak.button(names[m.btn]) + Speak.position(m.btn, 3)
    if withTitle then text = Speak.clean(it.title + ", " + it.heroMeta) + ". " + text
    Speak.say(text)
end sub

' The sidebar stays while the rows are up (as on the Mac); the top bar makes room for them
function navInRows() as float
    if m.side then return 1.0
    return 0.0
end function

sub enterNav()
    if m.state <> "nav" then m.navReturn = m.state
    m.state = "nav"
    m.nav.setFocus(true)
    if m.side
        m.heroTimer.control = "stop"
    else
        ' the top bar sits over the hero
        goTop(true)
        if m.heroes.count() > 0 then showBackdrop(m.heroes[m.heroIndex].backdrop)
    end if
    paintButtons()
end sub

sub leaveNav()
    if not m.side and m.heroes.count() > 0
        enterHero()
        return
    end if
    if m.navReturn = "error" and m.errorPanel.visible
        m.state = "error"
        m.errorPanel.setFocus(true)
    else if m.navReturn = "rows" and m.rows.visible
        m.state = "rows"
        m.rows.setFocus(true)
    else
        m.state = "hero"
        m.top.findNode("heroKeys").setFocus(true)
        startHeroTimer()
        speakHero(true)
    end if
    paintButtons()
end sub

' Hero and nav: rows peek at the bottom, full backdrop, nav visible
sub goTop(animate as boolean)
    rowsY = 770
    if m.heroes.count() = 0 then rowsY = 400
    if animate
        animateTo(rowsY, 1.0, 0.0, 1.0, 1.0, 0.0)
    else
        m.rows.translation = [m.rowsX, rowsY]
        m.top.findNode("hero").opacity = 1.0
        m.top.findNode("info").opacity = 0.0
        m.navs.opacity = 1.0
        m.top.findNode("bdLayer").opacity = 1.0
        m.top.findNode("rowsBg").opacity = 0.0
        if m.heroes.count() = 0 then m.top.findNode("rowsBg").opacity = 1.0
    end if
end sub

' Rows: they slide up, the hero fades, the backdrop dims and follows the focused card
sub enterRows(animate = true as boolean, takeFocus = true as boolean)
    m.state = "rows"
    m.spokenRow = -1
    m.heroTimer.control = "stop"
    if takeFocus then m.rows.setFocus(true)
    if animate
        animateTo(400, 0.0, 1.0, navInRows(), 0.6, 1.0)
    else
        m.rows.translation = [m.rowsX, 400]
        m.top.findNode("hero").opacity = 0.0
        m.top.findNode("info").opacity = 1.0
        m.navs.opacity = navInRows()
        m.top.findNode("bdLayer").opacity = 0.6
        m.top.findNode("rowsBg").opacity = 1.0
    end if
    paintButtons()
    if takeFocus then onItemFocused()
end sub

sub onNavChosen(ev as object)
    id = ev.getData().id
    if id = "more"
        showNavMore()
        return
    end if
    if id = "home"
        ' (NV-5) Home chosen again: the hero rotates again
        m.heroHeld = false
        if m.heroes.count() > 0
            enterHero()
        else
            leaveNav()
        end if
    else
        ' the page opens over the home; coming back lands where Left was pressed
        leaveNav()
    end if
    openNavPage(id)
end sub

' (v1.5) The top bar's More entry: the entries that didn't fit, as a list (OK opens one, Back closes)
sub showNavMore()
    o = []
    hidden = m.nav.overflow
    if type(hidden) = "roArray"
        for each it in hidden
            if Util.isAA(it) and Util.toText(it.id) <> "" then o.push({ id: Util.toText(it.id), label: Util.toText(it.label) })
        end for
    end if
    if o.count() = 0 then return
    p = createObject("roSGNode", "Picker")
    p.purpose = "navMore"
    p.title = "More"
    p.options = o
    p.observeField("chosen", "onNavMoreChosen")
    p.observeField("cancelled", "closeNavMore")
    m.top.appendChild(p)
    m.picker = p
    p.setFocus(true)
end sub

sub closeNavMore()
    if m.picker <> invalid
        m.picker.unobserveField("chosen")
        m.picker.unobserveField("cancelled")
        m.top.removeChild(m.picker)
        m.picker = invalid
    end if
    restoreFocus()
end sub

sub onNavMoreChosen(ev as object)
    id = Util.toText(ev.getData().id)
    closeNavMore()
    if id = "home"
        m.heroHeld = false
        if m.heroes.count() > 0 then enterHero() else leaveNav()
        return
    end if
    leaveNav()
    openNavPage(id)
end sub

' The page of a menu entry (MainScene opens it over Home)
sub openNavPage(id as string)
    if id = "search"
        m.top.action = { id: "search" }
    else if id = "settings" or id = "favorites" or id = "recent" or id = "nowplaying" or id = "profile"
        m.top.action = { id: id }
    else if id.startsWith("lib:")
        l = m.libraries[id.mid(4).toInt()]
        m.top.action = { id: "open", itemId: l.id, itemType: l.itemType, collectionType: l.collectionType, title: l.title }
    end if
end sub

' ---------------------------------------------------------------- rows

function focusedItem() as dynamic
    f = m.rows.rowItemFocused
    if f = invalid or f.count() < 2 or m.rows.content = invalid then return invalid
    row = m.rows.content.getChild(f[0])
    if row = invalid then return invalid
    return row.getChild(f[1])
end function

sub onItemFocused()
    if m.state <> "rows" then return
    it = focusedItem()
    if it = invalid then return
    if isSeeAllCard(it)
        focusSeeAll()
        return
    end if
    m.top.findNode("title").text = it.title
    maybeShowHint()
    if Speak.isOn()
        ' (the row's name when the focus moves to another row)
        text = Speak.card(it)
        f = m.rows.rowItemFocused
        if f[0] <> m.spokenRow
            m.spokenRow = f[0]
            text = focusedRowTitle() + ". " + text
        end if
        Speak.say(text)
    end if
    meta = it.heroMeta
    if it.episode <> "" then meta = it.episode
    m.top.findNode("meta").text = meta
    lines = Util.wrapLines(it.overview, 88, 3)
    for i = 0 to 2
        line = ""
        if i < lines.count() then line = lines[i]
        m.top.findNode("ov" + i.toStr()).text = line
    end for
    ' The backdrop follows only once the focus rests, so scrolling doesn't load every image
    m.pendingBackdrop = it.backdrop
    m.backdropTimer.control = "stop"
    m.backdropTimer.control = "start"
end sub

sub onBackdropTimer()
    if m.state = "rows" then showBackdrop(m.pendingBackdrop)
end sub

sub onItemSelected()
    it = focusedItem()
    if it = invalid then return
    ' (v1.6 M-2) the row's See All card: the row's whole list
    if isSeeAllCard(it)
        m.top.action = { id: "seeall", preset: it.seeAll }
        return
    end if
    m.top.action = openAction(it)
end sub

' (v1.1) Upcoming cards haven't aired: they open their series page, and have no Play or Mark as watched
function isUpcomingCard(it as dynamic) as boolean
    return it <> invalid and it.hasField("upcoming") and it.upcoming = true
end function

function openAction(it as object) as object
    ' (v1.2 SP-12) preview: what the details page draws at once (Home rows have every field)
    if isUpcomingCard(it) and Util.toText(it.seriesId) <> "" then return { id: "open", itemId: it.seriesId, itemType: "Series", collectionType: "", title: it.title, preview: QuickPlay.seriesPreviewOfCard(it) }
    return { id: "open", itemId: it.itemId, itemType: it.itemType, collectionType: it.collectionType, title: it.title, preview: QuickPlay.previewOfCard(it, true) }
end function

' ---------------------------------------------------------------- keys

sub onFocusChanged()
    ' Hidden under another screen (details, player, a dialog): no hero rotation, backdrop loads or session
    ' polling until Home has the focus again
    if not m.top.isInFocusChain()
        if not m.timersPaused
            m.timersPaused = true
            m.heroTimer.control = "stop"
            m.sessionsTimer.control = "stop"
            m.backdropTimer.control = "stop"
            m.bannerTick.control = "stop"
        end if
        return
    end if
    if m.timersPaused
        m.timersPaused = false
        ' (NV-5) back on Home from another page: the hero rotates again
        m.heroHeld = false
        if m.rows.visible
            loadSessions()
            m.sessionsTimer.control = "start"
            ' (a refresh missed while hidden happens at the first check)
            startBannerTick()
        end if
        if m.state = "hero" then startHeroTimer()
    end if
    if not m.top.hasFocus() then return
    if m.picker <> invalid
        m.picker.setFocus(true)
    else if m.state = "rows" and m.rows.visible
        m.rows.setFocus(true)
        ' (back on Home: say again where the focus is)
        m.spokenRow = -1
        onItemFocused()
    else if m.state = "nav"
        m.nav.setFocus(true)
    else if m.state = "error" and m.errorPanel.visible
        m.errorPanel.setFocus(true)
    else if m.state = "hero"
        m.top.findNode("heroKeys").setFocus(true)
        paintButtons()
        speakHero(true)
    end if
end sub

' Instant Resume: the app went to the background / came back. Back in front, the timers start again as
' when Home gets the focus back (only if Home is the page on top).
sub onSuspended()
    if m.top.suspended
        m.timersPaused = true
        m.heroTimer.control = "stop"
        m.sessionsTimer.control = "stop"
        m.backdropTimer.control = "stop"
        m.watchdog.control = "stop"
        m.bannerTick.control = "stop"
    else if m.top.isInFocusChain()
        onFocusChanged()
    end if
end sub

' U-5: the "* Options" hint the first time a card takes the focus, for a profile that has never pressed *
sub maybeShowHint()
    if m.hintShown then return
    m.hintShown = true
    if m.wantHint = invalid then m.wantHint = Hints.optionsHintWanted(m.top.server)
    if m.wantHint then m.hintBar.show = true
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    ' (NV-5) any key that reaches Home (the hero, the end of a row, the sidebar edge) stops the rotation
    if m.state = "hero" or m.state = "rows" then holdHero()
    if key = "options"
        ' (* used once: no more hint for this profile)
        if m.wantHint = invalid or m.wantHint = true
            Hints.optionsHintDone(m.top.server)
            m.wantHint = false
        end if
        m.hintBar.show = false
        ' on a card: what to do with that title; elsewhere the app options
        if m.state = "rows" and isSeeAllCard(focusedItem())
            ' (v1.6 M-2: nothing to do with the See All card)
        else if m.state = "rows" and focusedItem() <> invalid
            itemMenu(focusedItem())
        else
            showOptions()
        end if
        return true
    end if
    ' (v1.1 U-1) Play on a card or the hero: play it (a series its next episode) without opening its page
    if key = "play"
        card = invalid
        if m.state = "rows" then card = focusedItem()
        if m.state = "hero" and m.heroes.count() > 0 then card = m.heroes[m.heroIndex]
        a = QuickPlay.cardAction(card)
        if a <> invalid then m.top.action = a
        ' (BG-6) an Upcoming card that hasn't aired: say why nothing plays, as the details page does
        if a = invalid and isUpcomingCard(card) then Toasts.notify("This episode hasn't aired yet", "info")
        return a <> invalid or isUpcomingCard(card)
    end if
    if m.state = "hero"
        if key = "left"
            if m.btn > 0
                m.btn = m.btn - 1
                paintButtons()
                speakHero(false)
            else if m.side
                enterNav()
            else
                showHero(m.heroIndex - 1)
                speakHero(true)
            end if
            return true
        else if key = "rewind" or key = "replay"
            showHero(m.heroIndex - 1)
            speakHero(true)
            return true
        else if key = "fastforward"
            showHero(m.heroIndex + 1)
            speakHero(true)
            return true
        else if key = "right"
            if m.btn < 2
                m.btn = m.btn + 1
                paintButtons()
                speakHero(false)
            else
                m.btn = 0
                showHero(m.heroIndex + 1)
                paintButtons()
                speakHero(true)
            end if
            return true
        else if key = "up"
            if not m.side then enterNav()
            return true
        else if key = "down"
            if m.rows.visible then enterRows()
            return true
        else if key = "OK"
            useButton()
            return true
        end if
    else if m.state = "nav"
        ' no hero: Back from the rows comes here, so a second Back must leave the app instead of going round
        if key = "back" and (m.heroes.count() = 0 or m.navReturn = "error") then return false
        if (m.side and key = "right") or (not m.side and key = "down") or key = "back"
            leaveNav()
            return true
        end if
    else if m.state = "rows"
        ' (NV-13) Rewind / Fast Forward: one screen of cards back / on along the row
        if key = "rewind" or key = "fastforward"
            pageRow(key = "fastforward")
            return true
        end if
        if key = "left" and m.side
            ' (only reaches here at the first card of a row)
            enterNav()
            return true
        else if key = "up" or key = "back"
            ' Back from a lower row or a scrolled row: the top first (the hero, or the first card when there is
            ' no hero), then the sidebar / top bar; only Back from there leaves the app (MainScene)
            f = m.rows.rowItemFocused
            if key = "back" and m.heroes.count() = 0 and f <> invalid and f.count() >= 2 and (f[0] > 0 or f[1] > 0)
                m.rows.jumpToRowItem = [0, 0]
                return true
            end if
            if m.heroes.count() > 0
                enterHero()
            else
                enterNav()
            end if
            return true
        end if
    else if m.state = "error"
        ' the panel keeps Left / Right between its buttons; past the first one (or Up with the top bar) the nav
        if (key = "left" and m.side) or (key = "up" and not m.side)
            enterNav()
            return true
        end if
    end if
    return false
end function

' (NV-13) Jump one screen of cards along the focused row (the RowList keeps Left / Right one card at a time)
sub pageRow(forward as boolean)
    f = m.rows.rowItemFocused
    if f = invalid or f.count() < 2 or m.rows.content = invalid then return
    row = m.rows.content.getChild(f[0])
    if row = invalid then return
    dir = -1
    if forward then dir = 1
    col = NavUtil.pageColumn(f[1], row.getChildCount(), Int(m.rows.itemSize[0]), NavUtil.rowCardWidth(m.rows.rowItemSize, f[0]), dir)
    if col >= 0 and col <> f[1] then m.rows.jumpToRowItem = [f[0], col]
end sub

' ---------------------------------------------------------------- favourite (hero +)

sub toggleFavourite(it as object)
    method = "POST"
    if it.favorite then method = "DELETE"
    send(method, "/Users/" + Util.toText(m.top.server.userId) + "/FavoriteItems/" + it.itemId, { kind: "fav", method: method, newRoute: false, itemId: it.itemId, name: Util.toText(it.title) })
end sub

sub send(method as string, path as string, tag as object, body = "" as string)
    t = createObject("roSGNode", "ApiTask")
    t.request = { method: method, url: Util.toText(m.top.server.url) + path, headers: Api.headers(m.top.server, true), body: body, tag: tag, timeout: 15000 }
    t.observeField("response", "onFavResponse")
    m.pending.push(t)
    t.control = "RUN"
end sub

' ---------------------------------------------------------------- * on a card

sub itemMenu(it as object)
    m.menuItem = it
    o = []
    kind = it.itemType
    if kind <> "Series" and not isFolderKind(kind) and not isUpcomingCard(it)
        if it.resumeAt > 30
            o.push({ id: "resume", label: "Resume from " + clockText(it.resumeAt) })
            o.push({ id: "start", label: "Play from the Beginning" })
        else
            o.push({ id: "start", label: "Play" })
        end if
    end if
    if not isFolderKind(kind)
        if isUpcomingCard(it)
            ' (not aired yet: nothing to mark)
        else if it.played
            o.push({ id: "unwatched", label: "Mark as Unwatched" })
        else
            o.push({ id: "watched", label: "Mark as Watched" })
        end if
        ' (only the row's own cards: the same title elsewhere on Home keeps the plain menu)
        if it.resumeAt > 0 and focusedRowTitle() = "Continue Watching" then o.push({ id: "unresume", label: "Remove from Continue Watching" })
        if it.favorite
            o.push({ id: "fav", label: "Remove from Favorites" })
        else
            o.push({ id: "fav", label: "Add to Favorites" })
        end if
    end if
    o.push({ id: "open", label: "Details" })
    o.push({ id: "more", label: "More Options..." })
    title = it.title
    if it.episode <> "" then title = it.title + "  ·  " + it.episode
    p = createObject("roSGNode", "Picker")
    p.purpose = "item"
    p.title = title
    p.options = o
    p.observeField("chosen", "onItemChosen")
    p.observeField("cancelled", "closeItemMenu")
    m.top.appendChild(p)
    m.picker = p
    p.setFocus(true)
end sub

sub closeItemMenu()
    if m.picker <> invalid
        m.picker.unobserveField("chosen")
        m.picker.unobserveField("cancelled")
        m.top.removeChild(m.picker)
        m.picker = invalid
    end if
    restoreFocus()
end sub

sub onItemChosen(ev as object)
    id = ev.getData().id
    it = m.menuItem
    closeItemMenu()
    if it = invalid then return
    uid = Util.toText(m.top.server.userId)
    if id = "resume" or id = "start"
        start = 0.0
        if id = "resume" then start = it.resumeAt
        m.top.action = { id: "play", itemId: it.itemId, itemType: Util.toText(it.itemType), title: it.title, subtitle: it.episode, start: start }
    else if id = "watched" or id = "unwatched"
        method = "DELETE"
        if id = "watched" then method = "POST"
        send(method, "/Users/" + uid + "/PlayedItems/" + it.itemId, { kind: "watched", method: method, newRoute: false, itemId: it.itemId, name: Util.toText(it.title) })
    else if id = "fav"
        toggleFavourite(it)
    else if id = "unresume"
        removeFromResume(it)
    else if id = "open"
        m.top.action = openAction(it)
    else if id = "more"
        showOptions()
    end if
end sub

sub onFavResponse(ev as object)
    t = ev.getRoSGNode()
    for i = 0 to m.pending.count() - 1
        if m.pending[i].isSameNode(t)
            m.pending.delete(i)
            exit for
        end if
    end for
    r = ev.getData()
    if r.tag.kind = "unresume"
        onUnresume(r)
        return
    end if
    if r.tag.kind = "watched"
        if r.code = 404 and not r.tag.newRoute
            send(r.tag.method, "/UserPlayedItems/" + r.tag.itemId + "?userId=" + Util.toText(m.top.server.userId), { kind: "watched", method: r.tag.method, newRoute: true, itemId: r.tag.itemId, name: Util.toText(r.tag.name) })
        else if r.code >= 200 and r.code < 300
            ' Continue Watching / Next Up and the checks change: reload the rows in place
            Toasts.notify(Toasts.watchedText(Util.toText(r.tag.name), r.tag.method = "POST"), "check")
            m.top.reload = true
        else
            Toasts.notify(Toasts.failedText("change the watched state"), "info")
        end if
        return
    end if
    if r.code = 404 and not r.tag.newRoute
        send(r.tag.method, "/UserFavoriteItems/" + r.tag.itemId + "?userId=" + Util.toText(m.top.server.userId), { kind: "fav", method: r.tag.method, newRoute: true, itemId: r.tag.itemId, name: Util.toText(r.tag.name) })
        return
    end if
    if r.code < 200 or r.code >= 300 then Toasts.notify(Toasts.failedText("update Favorites"), "info")
    if r.code >= 200 and r.code < 300
        Toasts.notify(Toasts.favoriteText(Util.toText(r.tag.name), r.tag.method = "POST"), "heart")
        for each h in m.heroes
            if h.itemId = r.tag.itemId then h.favorite = r.tag.method = "POST"
        end for
        paintButtons()
        ' the Favourites row and the hearts on the cards change too (also for + on the hero); the reload keeps
        ' the focus and the hero shown
        m.top.reload = true
    end if
end sub

' ---------------------------------------------------------------- remove from Continue Watching

' The title of the row with the focused card ("" when none)
function focusedRowTitle() as string
    f = m.rows.rowItemFocused
    if f = invalid or f.count() < 2 or m.rows.content = invalid then return ""
    row = m.rows.content.getChild(f[0])
    if row = invalid then return ""
    return Util.toText(row.title)
end function

' Emby 4.8+ hides a title from Resume without touching its position (HideFromResume). Otherwise the saved
' position goes back to 0, which takes it off the row on both servers: Jellyfin 10.9+ /UserItems/{id}/UserData,
' the older /Users/{u}/Items/{id}/UserData route. Played and favourite are sent along, so a server that
' replaces the whole record keeps them. The next route is tried when one is missing (404 / 405).
sub removeFromResume(it as object)
    uid = Util.toText(m.top.server.userId)
    q = chr(34)
    body = "{" + q + "PlaybackPositionTicks" + q + ":0," + q + "Played" + q + ":" + Util.toText(it.played = true) + "," + q + "IsFavorite" + q + ":" + Util.toText(it.favorite = true) + "}"
    steps = []
    if not Servers.isJellyfin(m.top.server) then steps.push({ method: "POST", path: "/Users/" + uid + "/Items/" + it.itemId + "/HideFromResume?Hide=true", body: "" })
    if Servers.isJellyfin(m.top.server) then steps.push({ method: "POST", path: "/UserItems/" + it.itemId + "/UserData?userId=" + uid, body: body })
    steps.push({ method: "POST", path: "/Users/" + uid + "/Items/" + it.itemId + "/UserData", body: body })
    unresumeStep({ kind: "unresume", itemId: it.itemId, steps: steps, at: 0, name: Util.toText(it.title) })
end sub

sub unresumeStep(tag as object)
    st = tag.steps[tag.at]
    print "Cove: remove from Continue Watching: "; st.method; " "; st.path.split("?")[0]
    send(st.method, st.path, tag, st.body)
end sub

sub onUnresume(r as object)
    print "Cove:   -> "; r.code
    tag = r.tag
    if r.code >= 200 and r.code < 300
        ' the row reloads in place (the focus stays on the same place in it)
        Toasts.notify("Removed " + Toasts.quoted(Util.toText(tag.name)) + " from Continue Watching", "check")
        m.top.reload = true
        return
    end if
    if (r.code = 404 or r.code = 405) and tag.at + 1 < tag.steps.count()
        tag.at = tag.at + 1
        unresumeStep(tag)
        return
    end if
    ' (the card stays: the row shows the server's state)
    print "Cove: remove from Continue Watching failed "; r.code
    Toasts.notify(Toasts.failedText("remove it from Continue Watching"), "info")
end sub

' ---------------------------------------------------------------- * options

sub showOptions()
    d = createObject("roSGNode", "StandardMessageDialog")
    d.title = Util.toText(m.top.server.name)
    d.message = ["Signed in as " + Util.toText(m.top.server.userName) + "  ·  " + Servers.typeName(m.top.server) + " " + Util.toText(m.top.server.version)]
    d.buttons = ["Search", "Reload", "Switch Server", "Sign Out", "Settings", "Cancel"]
    d.observeField("buttonSelected", "onOptionsButton")
    d.observeField("wasClosed", "onOptionsClosed")
    m.top.getScene().dialog = d
end sub

sub onOptionsButton(ev as object)
    d = ev.getRoSGNode()
    b = d.buttonSelected
    d.unobserveField("buttonSelected")
    d.unobserveField("wasClosed")
    d.close = true
    ' (Reload: the state first, so the focus doesn't go to the rows that are about to be hidden)
    if b = 1 then m.state = "loading"
    restoreFocus()
    if b = 0
        m.top.action = { id: "search" }
    else if b = 1
        m.rows.visible = false
        load()
    else if b = 2
        m.top.action = { id: "switch" }
    else if b = 3
        m.top.action = { id: "signout" }
    else if b = 4
        m.top.action = { id: "settings" }
    end if
end sub

sub onOptionsClosed(ev as object)
    d = ev.getRoSGNode()
    d.unobserveField("buttonSelected")
    d.unobserveField("wasClosed")
    restoreFocus()
end sub

sub restoreFocus()
    if m.picker <> invalid
        m.picker.setFocus(true)
    else if m.state = "rows"
        m.rows.setFocus(true)
    else if m.state = "nav"
        m.nav.setFocus(true)
    else if m.state = "error" and m.errorPanel.visible
        m.errorPanel.setFocus(true)
    else
        m.top.findNode("heroKeys").setFocus(true)
    end if
end sub

' "1:02:03" / "4:05" (as Playback.clock; Home doesn't import Playback, which with DeviceCaps is ~25 KB that Roku
' compiled before Home could start, v1.2)
function clockText(secs as float) as string
    s = Int(secs)
    h = s \ 3600
    mm = (s mod 3600) \ 60
    ss = s mod 60
    out = mm.toStr() + ":"
    if h > 0 then out = h.toStr() + ":" + Right("0" + mm.toStr(), 2) + ":"
    return out + Right("0" + ss.toStr(), 2)
end function

' Per row: 16:9 cards for Continue Watching / Next Up, My Media's library tiles, 2:3 posters with title and year otherwise
' (tiles include an 18 px margin around each card for its focus zoom and ring: see PosterItem)
sub sizeRows(content as object)
    heights = []
    sizes = []
    for i = 0 to content.getChildCount() - 1
        row = content.getChild(i)
        if row.hasField("myMedia") and row.myMedia
            ' (v1.5) My Media: 360 x 202 library tiles with the name under them
            sizes.push([396, 290])
            heights.push(290)
        else if row.landscape
            sizes.push([396, 246])
            heights.push(246)
        else
            sizes.push([276, 466])
            heights.push(466)
        end if
    end for
    m.rows.rowHeights = heights
    m.rows.rowItemSize = sizes
end sub

' (v1.2) HomeTask put a late row (Upcoming) into the rows on screen (~0.2 s after them, while the banner
' has the focus): their sizes again
sub onRowsAdded(ev as object)
    if m.task = invalid or not ev.getRoSGNode().isSameNode(m.task) then return
    content = m.rows.content
    if content = invalid then return
    sizeRows(content)
    m.partialShown = false
    Clock.startupMark("home late row added")
end sub

' ---------------------------------------------------------------- v1.6 HOME

' (v1.6 M-2) A row's last card, "See All" (HomeTask.addSeeAll)
function isSeeAllCard(it as dynamic) as boolean
    return it <> invalid and it.hasField("kind") and it.kind = "seeall"
end function

' (v1.6 M-2) The See All card has the focus: the text above the rows names the row, the backdrop stays
sub focusSeeAll()
    row = focusedRowTitle()
    m.top.findNode("title").text = "See All"
    m.top.findNode("meta").text = row
    for i = 0 to 2
        m.top.findNode("ov" + i.toStr()).text = ""
    end for
    m.backdropTimer.control = "stop"
    if Speak.isOn()
        f = m.rows.rowItemFocused
        text = "See All, " + row + ", button"
        if f[0] <> m.spokenRow then m.spokenRow = f[0]
        Speak.say(text)
    end if
end sub
