import "pkg:/source/Util.bs"
import "pkg:/source/Servers.bs"
import "pkg:/source/Api.bs"
import "pkg:/source/Prefs.bs"
import "pkg:/source/Playback.bs"

sub init()
    t = m.global.theme
    m.rows = m.top.findNode("rows")
    m.status = m.top.findNode("status")
    ' Sidebar or top bar (Settings → General → Navigation)
    m.side = Prefs.navStyle() <> "topbar"
    m.navs = m.top.findNode("navs")
    if m.side
        m.nav = m.top.findNode("side")
        m.rowsX = 150
    else
        m.nav = m.top.findNode("top")
        m.nav.labels = Prefs.topBarLabels()
        m.rowsX = 78
        m.top.findNode("hero").translation = [0, 0]
        m.top.findNode("info").translation = [96, 96]
        m.top.findNode("status").translation = [96, 520]
        m.top.findNode("rows").itemSize = [1842, 466]
    end if
    m.nav.visible = true
    m.bdA = m.top.findNode("bdA")
    m.bdB = m.top.findNode("bdB")
    m.heroLogo = m.top.findNode("heroLogo")
    m.top.findNode("scrimBottom").uri = t.scrimBottom
    m.top.findNode("rowsFade").uri = t.fade
    m.top.findNode("rowsSolid").color = t.bg
    m.backdropTimer = m.top.findNode("backdropTimer")
    m.heroTimer = m.top.findNode("heroTimer")
    m.watchdog = m.top.findNode("watchdog")
    m.slide = m.top.findNode("slide")
    m.xfade = m.top.findNode("xfade")
    m.backdropTimer.observeField("fire", "onBackdropTimer")
    m.heroTimer.observeField("fire", "onHeroTimer")
    m.watchdog.observeField("fire", "onWatchdog")
    m.bdA.observeField("loadStatus", "onBackdropLoaded")
    m.bdB.observeField("loadStatus", "onBackdropLoaded")
    m.heroLogo.observeField("loadStatus", "onLogoLoaded")
    m.rows.observeField("rowItemFocused", "onItemFocused")
    m.rows.observeField("rowItemSelected", "onItemSelected")
    m.nav.observeField("chosen", "onNavChosen")
    m.top.observeField("focusedChild", "onFocusChanged")
    m.task = invalid
    m.pending = []
    m.heroes = []
    m.heroIndex = 0
    m.btn = 0
    m.state = "loading"
    m.front = invalid         ' the backdrop Poster on screen
    m.wantBackdrop = ""
    m.pendingBackdrop = ""
    m.libraries = []
    m.nowPlaying = 0
    m.navReturn = "hero"
    m.sessionsTimer = m.top.findNode("sessionsTimer")
    m.sessionsTimer.observeField("fire", "loadSessions")
    buildNav()
    m.top.findNode("hero").visible = false
    m.picker = invalid
    m.menuItem = invalid
    m.timersPaused = false
end sub

' ---------------------------------------------------------------- loading

sub load()
    s = m.top.server
    if m.reloading <> true
        m.status.text = "Loading your libraries..."
        m.status.visible = true
    end if
    ' a reload while one still runs: drop the older task, its late answer must not be read as this one's
    if m.task <> invalid
        m.task.unobserveField("content")
        m.task.unobserveField("error")
        m.task.unobserveField("authFailed")
        m.task.control = "stop"
    end if
    m.task = createObject("roSGNode", "HomeTask")
    m.task.server = s
    m.task.observeField("content", "onContent")
    m.task.observeField("error", "onError")
    m.task.observeField("authFailed", "onAuthFailed")
    m.task.control = "RUN"
    m.watchdog.control = "start"
end sub

sub onWatchdog()
    if m.status.visible and not m.rows.visible then m.status.text = "The server is taking too long to answer. Press * and choose Reload."
end sub

' Reload after playback, keeping the screen as it is until the new rows arrive
sub onReload()
    m.reloading = true
    load()
end sub

sub onContent(ev as object)
    if m.task = invalid or not ev.getRoSGNode().isSameNode(m.task) then return
    content = ev.getData()
    if content = invalid then return
    m.watchdog.control = "stop"
    ' Per row: 16:9 cards for Continue Watching / Next Up / Libraries, 2:3 posters with title and year otherwise
    heights = []
    sizes = []
    for i = 0 to content.getChildCount() - 1
        ' (tiles include an 18 px margin around each card for its focus zoom and ring: see PosterItem)
        if content.getChild(i).landscape
            sizes.push([396, 246])
            heights.push(246)
        else
            sizes.push([276, 466])
            heights.push(466)
        end if
    end for
    m.rows.rowHeights = heights
    m.rows.rowItemSize = sizes
    wasReload = m.reloading = true
    m.reloading = false
    keep = m.rows.rowItemFocused
    m.rows.content = content
    if wasReload and keep <> invalid and keep.count() >= 2 and keep[0] < content.getChildCount()
        r = content.getChild(keep[0])
        col = keep[1]
        if col >= r.getChildCount() then col = r.getChildCount() - 1
        if col >= 0 then m.rows.jumpToRowItem = [keep[0], col]
    end if
    m.rows.visible = true
    m.status.visible = false
    buildNav()
    loadSessions()
    ' (a reload can answer while another screen is on top: polling starts again when Home is back)
    if m.top.isInFocusChain() then m.sessionsTimer.control = "start"
    buildHeroes(content)
    if not wasReload or m.state = "loading"
        if m.heroes.count() > 0
            enterHero(false)
        else
            enterRows(false)
        end if
    end if
end sub

sub onError(ev as object)
    if m.task = invalid or not ev.getRoSGNode().isSameNode(m.task) then return
    m.watchdog.control = "stop"
    m.status.text = Util.toText(ev.getData()) + "   Press * for options."
end sub

' A 401 on one list: check the sign-in itself before asking to sign in again (a single list can refuse
' for other reasons, e.g. a library the user may not see)
sub onAuthFailed(ev as object)
    if m.task = invalid or not ev.getRoSGNode().isSameNode(m.task) or not ev.getData() then return
    t = createObject("roSGNode", "ApiTask")
    t.request = { method: "GET", url: Util.toText(m.top.server.url) + "/Users/" + Util.toText(m.top.server.userId), headers: Api.headers(m.top.server, true), body: "", tag: { kind: "authCheck" }, timeout: 15000 }
    t.observeField("response", "onAuthCheck")
    m.pending.push(t)
    t.control = "RUN"
end sub

sub onAuthCheck(ev as object)
    r = ev.getData()
    print "Cove: sign-in check -> "; r.code
    if r.code = 401 then m.top.action = { id: "expired" }
end sub

' The sidebar, as on the Mac: Home, Search, Favorites, Now Playing (with the count), then Library: Recently Added
' and the libraries, then Settings
sub buildNav()
    items = [
        { id: "home", label: "Home", icon: "home" },
        { id: "search", label: "Search", icon: "search" }
    ]
    ' Settings → Libraries: Favorites / Now Playing shown; General: Recently Added
    if Prefs.showFavorites() then items.push({ id: "favorites", label: "Favorites", icon: "heart" })
    if Prefs.showNowPlaying() then items.push({ id: "nowplaying", label: "Now Playing", icon: "nowplaying", badge: m.nowPlaying })
    if m.side then items.push({ header: true, label: "Library" })
    if Prefs.showRecent() then items.push({ id: "recent", label: "Recently Added", icon: "clock" })
    m.libraries = []
    libs = invalid
    if m.task <> invalid then libs = m.task.libraries
    if libs <> invalid
        for i = 0 to libs.count() - 1
            m.libraries.push(libs[i])
            ' (hidden from the sidebar in Settings → Libraries)
            if libs[i].nav <> false
                ct = Util.toText(libs[i].collectionType)
                ic = "folder"
                if ct = "movies" then ic = "film"
                if ct = "tvshows" then ic = "tv"
                items.push({ id: "lib:" + i.toStr(), label: Util.toText(libs[i].title), icon: ic })
            end if
        end for
    end if
    if m.side then items.push({ header: true, label: "" })
    items.push({ id: "settings", label: "Settings", icon: "gear" })
    m.nav.items = items
end sub

' How many are playing on the server right now (the Now Playing badge)
sub loadSessions()
    t = createObject("roSGNode", "ApiTask")
    t.request = { method: "GET", url: Util.toText(m.top.server.url) + "/Sessions?ActiveWithinSeconds=960", headers: Api.headers(m.top.server, true), body: "", tag: { kind: "sessions" }, timeout: 15000 }
    t.observeField("response", "onSessions")
    m.sessionsTask = t
    t.control = "RUN"
end sub

sub onSessions(ev as object)
    r = ev.getData()
    n = 0
    if r.code = 200 and type(r.json) = "roArray"
        for each s in r.json
            if s.NowPlayingItem <> invalid then n = n + 1
        end for
    end if
    if n <> m.nowPlaying
        m.nowPlaying = n
        buildNav()
    end if
end sub

' The hero shows up to 8 titles: the first two with a backdrop from each row, as on the Mac
sub buildHeroes(content as object)
    keep = invalid
    if m.heroes.count() > 0 then keep = m.heroes[m.heroIndex].itemId
    m.heroes = []
    seen = {}
    for i = 0 to content.getChildCount() - 1
        row = content.getChild(i)
        taken = 0
        for j = 0 to row.getChildCount() - 1
            it = row.getChild(j)
            if taken < 2 and m.heroes.count() < 8 and it.backdrop <> "" and not isFolderKind(it.itemType) and not seen.doesExist(it.itemId)
                seen[it.itemId] = true
                m.heroes.push(it)
                taken = taken + 1
            end if
        end for
    end for
    m.heroIndex = 0
    for i = 0 to m.heroes.count() - 1
        if m.heroes[i].itemId = keep then m.heroIndex = i
    end for
    buildDots()
    m.top.findNode("hero").visible = m.heroes.count() > 0
    if m.heroes.count() > 0 then showHero(m.heroIndex)
end sub

function isFolderKind(t as string) as boolean
    return t = "CollectionFolder" or t = "UserView" or t = "Folder" or t = "BoxSet" or t = "Playlist"
end function

' ---------------------------------------------------------------- hero

sub buildDots()
    dots = m.top.findNode("dots")
    dots.removeChildrenIndex(dots.getChildCount(), 0)
    n = m.heroes.count()
    if n < 2 then return
    ' centred over the page (right of the sidebar; the hero group is moved 80 px right)
    x = Int((1808 - (n * 10 + (n - 1) * 14)) / 2) + 112 - 80
    if not m.side then x = Int((1920 - (n * 10 + (n - 1) * 14)) / 2)
    for i = 0 to n - 1
        d = dots.createChild("Poster")
        d.uri = "pkg:/images/ui/dot_10.png"
        d.width = 10
        d.height = 10
        d.translation = [x + i * 24, 0]
    end for
end sub

sub showHero(i as integer)
    n = m.heroes.count()
    if n = 0 then return
    m.heroIndex = (i + n) mod n
    it = m.heroes[m.heroIndex]
    dots = m.top.findNode("dots")
    for k = 0 to dots.getChildCount() - 1
        dots.getChild(k).opacity = 0.4
        if k = m.heroIndex then dots.getChild(k).opacity = 1.0
    end for
    m.top.findNode("heroTitle").text = it.title
    m.top.findNode("heroMeta").text = it.heroMeta
    lines = Util.wrapLines(it.overview, 58, 3)
    for k = 0 to 2
        line = ""
        if k < lines.count() then line = lines[k]
        m.top.findNode("hov" + k.toStr()).text = line
    end for
    m.lines = lines.count()
    chip = m.top.findNode("chipText")
    chip.text = it.chip
    m.top.findNode("chipBg").width = it.chip.len() * 14 + 28
    m.top.findNode("chip").visible = it.chip <> ""
    label = "Play"
    if it.resumeAt > 30 then label = "Resume"
    m.top.findNode("playLabel").text = label
    ' title text until the logo has loaded
    m.logoReady = false
    m.heroLogo.visible = false
    m.top.findNode("heroTitle").visible = true
    m.heroLogo.uri = it.logo
    layoutHero()
    paintButtons()
    if m.state = "hero" or m.state = "nav" then showBackdrop(it.backdrop)
end sub

' Bottom-anchored: buttons end at y=880, overview above them, then details, then logo or title, then the chip
sub layoutHero()
    btnY = 640
    m.top.findNode("buttons").translation = [96, btnY]
    ovY = btnY - 30 - m.lines * 38
    m.top.findNode("heroOv").translation = [96, ovY]
    metaY = ovY - 50
    m.top.findNode("heroMeta").translation = [96, metaY]
    topY = metaY - 104
    m.top.findNode("heroTitle").translation = [96, topY]
    if m.logoReady
        topY = metaY - 16 - m.heroLogo.height
        m.heroLogo.translation = [96, topY]
    end if
    m.top.findNode("chip").translation = [96, topY - 50]
end sub

' Fit the logo into 630 x 135, keeping its proportions, aligned bottom-left
sub onLogoLoaded()
    if m.heroLogo.loadStatus <> "ready" then return
    bw = m.heroLogo.bitmapWidth
    bh = m.heroLogo.bitmapHeight
    if bw <= 0 or bh <= 0 then return
    s = 630 / bw
    if 135 / bh < s then s = 135 / bh
    m.heroLogo.width = Int(bw * s)
    m.heroLogo.height = Int(bh * s)
    m.logoReady = true
    m.heroLogo.visible = true
    m.top.findNode("heroTitle").visible = false
    layoutHero()
end sub

sub paintButtons()
    focused = m.state = "hero"
    it = invalid
    if m.heroes.count() > 0 then it = m.heroes[m.heroIndex]
    play = m.top.findNode("btnPlay")
    play.scaleRotateCenter = [127, 34]
    s = 1.0
    if focused and m.btn = 0 then s = 1.06
    play.scale = [s, s]
    m.top.findNode("playRing").visible = focused and m.btn = 0
    paintCircle("fav", focused and m.btn = 1)
    paintCircle("info", focused and m.btn = 2)
    favIcon = m.top.findNode("favIcon")
    favIcon.uri = "pkg:/images/ui/icon_plus_28.png"
    if it <> invalid and it.favorite then favIcon.uri = "pkg:/images/ui/icon_check_28.png"
end sub

sub paintCircle(name as string, isFocused as boolean)
    bg = m.top.findNode(name + "Bg")
    icon = m.top.findNode(name + "Icon")
    g = m.top.findNode("btn" + UCase(name.left(1)) + name.mid(1))
    g.scaleRotateCenter = [34, 34]
    if isFocused
        bg.uri = "pkg:/images/ui/white_circle_69.png"
        icon.blendColor = "0x000000FF"
        g.scale = [1.06, 1.06]
    else
        bg.uri = "pkg:/images/ui/glass_circle_69.png"
        icon.blendColor = "0xFFFFFFFF"
        g.scale = [1.0, 1.0]
    end if
end sub

sub onHeroTimer()
    if (m.state = "hero" or m.state = "nav") and m.heroes.count() > 1 then showHero(m.heroIndex + 1)
end sub

sub useButton()
    it = m.heroes[m.heroIndex]
    if m.btn = 1
        toggleFavourite(it)
    else if m.btn = 2 or it.itemType = "Series"
        m.top.action = { id: "open", itemId: it.itemId, itemType: it.itemType, collectionType: it.collectionType, title: it.title }
    else
        start = 0.0
        if it.resumeAt > 30 then start = it.resumeAt
        m.top.action = { id: "play", itemId: it.itemId, title: it.title, subtitle: it.episode, start: start }
    end if
end sub

' ---------------------------------------------------------------- backdrop crossfade

sub showBackdrop(uri as string)
    if uri = "" or uri = m.wantBackdrop then return
    m.wantBackdrop = uri
    back = m.bdA
    if m.front <> invalid and m.front.isSameNode(m.bdA) then back = m.bdB
    if back.uri = uri and back.loadStatus = "ready"
        crossfadeTo(back)
    else
        back.uri = uri
    end if
end sub

sub onBackdropLoaded(ev as object)
    p = ev.getRoSGNode()
    if ev.getData() = "ready" and p.uri = m.wantBackdrop and (m.front = invalid or not m.front.isSameNode(p)) then crossfadeTo(p)
end sub

sub crossfadeTo(p as object)
    m.xfade.control = "stop"
    ia = m.top.findNode("xfadeA")
    ib = m.top.findNode("xfadeB")
    if p.isSameNode(m.bdA)
        ia.keyValue = [m.bdA.opacity, 1.0]
        ib.keyValue = [m.bdB.opacity, 0.0]
    else
        ia.keyValue = [m.bdA.opacity, 0.0]
        ib.keyValue = [m.bdB.opacity, 1.0]
    end if
    m.front = p
    m.xfade.control = "start"
end sub

' ---------------------------------------------------------------- focus areas

sub animateTo(rowsY as integer, heroOp as float, infoOp as float, navOp as float, bdOp as float, rowsBgOp as float)
    m.slide.control = "stop"
    cur = m.rows.translation
    m.top.findNode("rowsMove").keyValue = [[m.rowsX, cur[1]], [m.rowsX, rowsY]]
    m.top.findNode("heroFadeI").keyValue = [m.top.findNode("hero").opacity, heroOp]
    m.top.findNode("infoFadeI").keyValue = [m.top.findNode("info").opacity, infoOp]
    ' (the sidebar stays, as on the Mac: callers pass 1.0)
    m.top.findNode("navFadeI").keyValue = [m.navs.opacity, navOp]
    m.top.findNode("bdDimI").keyValue = [m.top.findNode("bdLayer").opacity, bdOp]
    m.top.findNode("rowsBgI").keyValue = [m.top.findNode("rowsBg").opacity, rowsBgOp]
    m.slide.control = "start"
end sub

sub enterHero(animate = true as boolean)
    if m.heroes.count() = 0
        enterRows(animate)
        return
    end if
    m.state = "hero"
    m.btn = 0
    ' the first row (Continue Watching) under the hero again, as on the Mac
    f = m.rows.rowItemFocused
    if m.rows.content <> invalid and m.rows.content.getChildCount() > 0 and f <> invalid and f.count() >= 2 and f[0] <> 0 then m.rows.jumpToRowItem = [0, 0]
    ' (a node of its own: setFocus on the screen itself doesn't take the focus back from the rows)
    m.top.findNode("heroKeys").setFocus(true)
    goTop(animate)
    showBackdrop(m.heroes[m.heroIndex].backdrop)
    m.heroTimer.control = "start"
    paintButtons()
end sub

' The sidebar stays while the rows are up (as on the Mac); the top bar makes room for them
function navInRows() as float
    if m.side then return 1.0
    return 0.0
end function

sub enterNav()
    if m.state <> "nav" then m.navReturn = m.state
    m.state = "nav"
    m.nav.setFocus(true)
    if m.side
        m.heroTimer.control = "stop"
    else
        ' the top bar sits over the hero
        goTop(true)
        if m.heroes.count() > 0 then showBackdrop(m.heroes[m.heroIndex].backdrop)
    end if
    paintButtons()
end sub

sub leaveNav()
    if not m.side and m.heroes.count() > 0
        enterHero()
        return
    end if
    if m.navReturn = "rows" and m.rows.visible
        m.state = "rows"
        m.rows.setFocus(true)
    else
        m.state = "hero"
        m.top.findNode("heroKeys").setFocus(true)
        m.heroTimer.control = "start"
    end if
    paintButtons()
end sub

' Hero and nav: rows peek at the bottom, full backdrop, nav visible
sub goTop(animate as boolean)
    rowsY = 770
    if m.heroes.count() = 0 then rowsY = 400
    if animate
        animateTo(rowsY, 1.0, 0.0, 1.0, 1.0, 0.0)
    else
        m.rows.translation = [m.rowsX, rowsY]
        m.top.findNode("hero").opacity = 1.0
        m.top.findNode("info").opacity = 0.0
        m.navs.opacity = 1.0
        m.top.findNode("bdLayer").opacity = 1.0
        m.top.findNode("rowsBg").opacity = 0.0
        if m.heroes.count() = 0 then m.top.findNode("rowsBg").opacity = 1.0
    end if
end sub

' Rows: they slide up, the hero fades, the backdrop dims and follows the focused card
sub enterRows(animate = true as boolean)
    m.state = "rows"
    m.heroTimer.control = "stop"
    m.rows.setFocus(true)
    if animate
        animateTo(400, 0.0, 1.0, navInRows(), 0.6, 1.0)
    else
        m.rows.translation = [m.rowsX, 400]
        m.top.findNode("hero").opacity = 0.0
        m.top.findNode("info").opacity = 1.0
        m.navs.opacity = navInRows()
        m.top.findNode("bdLayer").opacity = 0.6
        m.top.findNode("rowsBg").opacity = 1.0
    end if
    paintButtons()
    onItemFocused()
end sub

sub onNavChosen(ev as object)
    id = ev.getData().id
    if id = "home"
        if m.heroes.count() > 0
            enterHero()
        else
            leaveNav()
        end if
    else
        ' the page opens over the home; coming back lands where Left was pressed
        leaveNav()
    end if
    if id = "search"
        m.top.action = { id: "search" }
    else if id = "settings" or id = "favorites" or id = "recent" or id = "nowplaying"
        m.top.action = { id: id }
    else if id.startsWith("lib:")
        l = m.libraries[id.mid(4).toInt()]
        m.top.action = { id: "open", itemId: l.id, itemType: l.itemType, collectionType: l.collectionType, title: l.title }
    end if
end sub

' ---------------------------------------------------------------- rows

function focusedItem() as dynamic
    f = m.rows.rowItemFocused
    if f = invalid or f.count() < 2 or m.rows.content = invalid then return invalid
    row = m.rows.content.getChild(f[0])
    if row = invalid then return invalid
    return row.getChild(f[1])
end function

sub onItemFocused()
    if m.state <> "rows" then return
    it = focusedItem()
    if it = invalid then return
    m.top.findNode("title").text = it.title
    meta = it.heroMeta
    if it.episode <> "" then meta = it.episode
    m.top.findNode("meta").text = meta
    lines = Util.wrapLines(it.overview, 88, 3)
    for i = 0 to 2
        line = ""
        if i < lines.count() then line = lines[i]
        m.top.findNode("ov" + i.toStr()).text = line
    end for
    ' The backdrop follows only once the focus rests, so scrolling doesn't load every image
    m.pendingBackdrop = it.backdrop
    m.backdropTimer.control = "stop"
    m.backdropTimer.control = "start"
end sub

sub onBackdropTimer()
    if m.state = "rows" then showBackdrop(m.pendingBackdrop)
end sub

sub onItemSelected()
    it = focusedItem()
    if it <> invalid then m.top.action = { id: "open", itemId: it.itemId, itemType: it.itemType, collectionType: it.collectionType, title: it.title }
end sub

' ---------------------------------------------------------------- keys

sub onFocusChanged()
    ' Hidden under another screen (details, player, a dialog): no hero rotation, backdrop loads or session
    ' polling until Home has the focus again
    if not m.top.isInFocusChain()
        if not m.timersPaused
            m.timersPaused = true
            m.heroTimer.control = "stop"
            m.sessionsTimer.control = "stop"
            m.backdropTimer.control = "stop"
        end if
        return
    end if
    if m.timersPaused
        m.timersPaused = false
        if m.rows.visible
            loadSessions()
            m.sessionsTimer.control = "start"
        end if
        if m.state = "hero" then m.heroTimer.control = "start"
    end if
    if not m.top.hasFocus() then return
    if m.picker <> invalid
        m.picker.setFocus(true)
    else if m.state = "rows" and m.rows.visible
        m.rows.setFocus(true)
    else if m.state = "nav"
        m.nav.setFocus(true)
    else if m.state = "hero"
        m.top.findNode("heroKeys").setFocus(true)
        paintButtons()
    end if
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if key = "options"
        ' on a card: what to do with that title; elsewhere the app options
        if m.state = "rows" and focusedItem() <> invalid
            itemMenu(focusedItem())
        else
            showOptions()
        end if
        return true
    end if
    if m.state = "hero"
        m.heroTimer.control = "stop"
        m.heroTimer.control = "start"
        if key = "left"
            if m.btn > 0
                m.btn = m.btn - 1
                paintButtons()
            else if m.side
                enterNav()
            else
                showHero(m.heroIndex - 1)
            end if
            return true
        else if key = "rewind" or key = "replay"
            showHero(m.heroIndex - 1)
            return true
        else if key = "fastforward"
            showHero(m.heroIndex + 1)
            return true
        else if key = "right"
            if m.btn < 2
                m.btn = m.btn + 1
                paintButtons()
            else
                m.btn = 0
                showHero(m.heroIndex + 1)
            end if
            return true
        else if key = "up"
            if not m.side then enterNav()
            return true
        else if key = "down"
            if m.rows.visible then enterRows()
            return true
        else if key = "OK"
            useButton()
            return true
        end if
    else if m.state = "nav"
        ' no hero: Back from the rows comes here, so a second Back must leave the app instead of going round
        if key = "back" and m.heroes.count() = 0 then return false
        if (m.side and key = "right") or (not m.side and key = "down") or key = "back"
            leaveNav()
            return true
        end if
    else if m.state = "rows"
        if key = "left" and m.side
            ' (only reaches here at the first card of a row)
            enterNav()
            return true
        else if key = "up" or key = "back"
            if m.heroes.count() > 0
                enterHero()
            else
                enterNav()
            end if
            return true
        end if
    end if
    return false
end function

' ---------------------------------------------------------------- favourite (hero +)

sub toggleFavourite(it as object)
    method = "POST"
    if it.favorite then method = "DELETE"
    send(method, "/Users/" + Util.toText(m.top.server.userId) + "/FavoriteItems/" + it.itemId, { kind: "fav", method: method, newRoute: false, itemId: it.itemId })
end sub

sub send(method as string, path as string, tag as object)
    t = createObject("roSGNode", "ApiTask")
    t.request = { method: method, url: Util.toText(m.top.server.url) + path, headers: Api.headers(m.top.server, true), body: "", tag: tag, timeout: 15000 }
    t.observeField("response", "onFavResponse")
    m.pending.push(t)
    t.control = "RUN"
end sub

' ---------------------------------------------------------------- * on a card

sub itemMenu(it as object)
    m.menuItem = it
    o = []
    kind = it.itemType
    if kind <> "Series" and not isFolderKind(kind)
        if it.resumeAt > 30
            o.push({ id: "resume", label: "Resume from " + Playback.clock(it.resumeAt) })
            o.push({ id: "start", label: "Play from the beginning" })
        else
            o.push({ id: "start", label: "Play" })
        end if
    end if
    if not isFolderKind(kind)
        if it.played
            o.push({ id: "unwatched", label: "Mark as unwatched" })
        else
            o.push({ id: "watched", label: "Mark as watched" })
        end if
        if it.favorite
            o.push({ id: "fav", label: "Remove from favourites" })
        else
            o.push({ id: "fav", label: "Add to favourites" })
        end if
    end if
    o.push({ id: "open", label: "Details" })
    o.push({ id: "more", label: "More options..." })
    title = it.title
    if it.episode <> "" then title = it.title + "  ·  " + it.episode
    p = createObject("roSGNode", "Picker")
    p.purpose = "item"
    p.title = title
    p.options = o
    p.observeField("chosen", "onItemChosen")
    p.observeField("cancelled", "closeItemMenu")
    m.top.appendChild(p)
    m.picker = p
    p.setFocus(true)
end sub

sub closeItemMenu()
    if m.picker <> invalid
        m.picker.unobserveField("chosen")
        m.picker.unobserveField("cancelled")
        m.top.removeChild(m.picker)
        m.picker = invalid
    end if
    restoreFocus()
end sub

sub onItemChosen(ev as object)
    id = ev.getData().id
    it = m.menuItem
    closeItemMenu()
    if it = invalid then return
    uid = Util.toText(m.top.server.userId)
    if id = "resume" or id = "start"
        start = 0.0
        if id = "resume" then start = it.resumeAt
        m.top.action = { id: "play", itemId: it.itemId, title: it.title, subtitle: it.episode, start: start }
    else if id = "watched" or id = "unwatched"
        method = "DELETE"
        if id = "watched" then method = "POST"
        send(method, "/Users/" + uid + "/PlayedItems/" + it.itemId, { kind: "watched", method: method, newRoute: false, itemId: it.itemId })
    else if id = "fav"
        toggleFavourite(it)
    else if id = "open"
        m.top.action = { id: "open", itemId: it.itemId, itemType: it.itemType, collectionType: it.collectionType, title: it.title }
    else if id = "more"
        showOptions()
    end if
end sub

sub onFavResponse(ev as object)
    t = ev.getRoSGNode()
    for i = 0 to m.pending.count() - 1
        if m.pending[i].isSameNode(t)
            m.pending.delete(i)
            exit for
        end if
    end for
    r = ev.getData()
    if r.tag.kind = "watched"
        if r.code = 404 and not r.tag.newRoute
            send(r.tag.method, "/UserPlayedItems/" + r.tag.itemId + "?userId=" + Util.toText(m.top.server.userId), { kind: "watched", method: r.tag.method, newRoute: true, itemId: r.tag.itemId })
        else if r.code >= 200 and r.code < 300
            ' Continue Watching / Next Up and the checks change: reload the rows in place
            m.top.reload = true
        end if
        return
    end if
    if r.code = 404 and not r.tag.newRoute
        send(r.tag.method, "/UserFavoriteItems/" + r.tag.itemId + "?userId=" + Util.toText(m.top.server.userId), { kind: "fav", method: r.tag.method, newRoute: true, itemId: r.tag.itemId })
        return
    end if
    if r.code >= 200 and r.code < 300
        for each h in m.heroes
            if h.itemId = r.tag.itemId then h.favorite = r.tag.method = "POST"
        end for
        paintButtons()
        ' the Favourites row and the hearts on the cards change too (also for + on the hero); the reload keeps
        ' the focus and the hero shown
        m.top.reload = true
    end if
end sub

' ---------------------------------------------------------------- * options

sub showOptions()
    d = createObject("roSGNode", "StandardMessageDialog")
    d.title = Util.toText(m.top.server.name)
    d.message = ["Signed in as " + Util.toText(m.top.server.userName) + "  ·  " + Servers.typeName(m.top.server) + " " + Util.toText(m.top.server.version)]
    d.buttons = ["Search", "Reload", "Switch server", "Sign out", "Settings", "Cancel"]
    d.observeField("buttonSelected", "onOptionsButton")
    d.observeField("wasClosed", "onOptionsClosed")
    m.top.getScene().dialog = d
end sub

sub onOptionsButton(ev as object)
    d = ev.getRoSGNode()
    b = d.buttonSelected
    d.unobserveField("buttonSelected")
    d.unobserveField("wasClosed")
    d.close = true
    ' (Reload: the state first, so the focus doesn't go to the rows that are about to be hidden)
    if b = 1 then m.state = "loading"
    restoreFocus()
    if b = 0
        m.top.action = { id: "search" }
    else if b = 1
        m.rows.visible = false
        load()
    else if b = 2
        m.top.action = { id: "switch" }
    else if b = 3
        m.top.action = { id: "signout" }
    else if b = 4
        m.top.action = { id: "settings" }
    end if
end sub

sub onOptionsClosed(ev as object)
    d = ev.getRoSGNode()
    d.unobserveField("buttonSelected")
    d.unobserveField("wasClosed")
    restoreFocus()
end sub

sub restoreFocus()
    if m.picker <> invalid
        m.picker.setFocus(true)
    else if m.state = "rows"
        m.rows.setFocus(true)
    else if m.state = "nav"
        m.nav.setFocus(true)
    else
        m.top.findNode("heroKeys").setFocus(true)
    end if
end sub
