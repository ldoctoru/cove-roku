<?xml version="1.0" encoding="utf-8" ?>
<!-- A card in a row or grid, (v1.5 flat) clean artwork, Apple TV / Emby style: the rounded image
     (r12 corner mask in the page colour) with no edge, sheen, shadow or glow; focus = a plain white 4 px ring
     4 px outside the card (round for people), no zoom; white watched disc / unwatched count, white heart for
     favourites; Continue Watching and episode cards carry the resume ring instead of a progress bar.
     Poster cards (2:3) have title and year under the image; landscape cards (16:9, content.landscape)
     carry the title, episode and "42m left" over a dark fade inside the image. -->
<component name="PosterItem" extends="Group">
    <script type="text/brightscript" uri="PosterItem.bs" />
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="width" type="float" onChange="onSize" />
        <field id="height" type="float" onChange="onSize" />
        <field id="focusPercent" type="float" onChange="onFocus" />
        <field id="rowFocusPercent" type="float" value="1.0" onChange="onFocus" />
        <field id="rowListHasFocus" type="boolean" onChange="onFocus" />
        <field id="gridHasFocus" type="boolean" onChange="onFocus" />
    </interface>
    <children>
        <Group id="card">
            <Rectangle id="ph" />
            <Label id="initials" horizAlign="center" vertAlign="center" color="0xFFFFFF40">
                <Font role="font" uri="font:BoldSystemFontFile" size="48" />
            </Label>
            <Poster id="image" loadDisplayMode="scaleToZoom" />
            <Poster id="scrim" uri="pkg:/images/ui/scrim_card.png" visible="false" />
            <!-- (v1.4) wide cards: "S3:E3  ·  42m left" at the top left, as on the Mac -->
            <Label id="overTopShadow" color="0x00000099" visible="false">
                <Font role="font" uri="font:BoldSystemFontFile" size="24" />
            </Label>
            <Label id="overTop" color="0xFFFFFFFF" visible="false">
                <Font role="font" uri="font:BoldSystemFontFile" size="24" />
            </Label>
            <Label id="overTitle" color="0xFFFFFFFF" visible="false">
                <Font role="font" uri="font:BoldSystemFontFile" size="26" />
            </Label>
            <Label id="overSub" color="0xFFFFFFD9" visible="false">
                <Font role="font" uri="font:MediumSystemFontFile" size="24" />
            </Label>
            <Rectangle id="miniTrack" height="6" color="0xFFFFFF59" visible="false" />
            <Rectangle id="miniFill" height="6" color="0xFFFFFFFF" visible="false" />
            <Label id="miniLeft" color="0xFFFFFFFF" visible="false">
                <Font role="font" uri="font:MediumSystemFontFile" size="24" />
            </Label>
            <!-- episode card (series page): EPISODE n, name, 3-line overview, check / progress + runtime -->
            <Group id="ep" visible="false">
                <Label id="epEyebrow" color="0xFFFFFFCC">
                    <Font role="font" uri="font:MediumSystemFontFile" size="24" />
                </Label>
                <Label id="epTitle" color="0xFFFFFFFF">
                    <Font role="font" uri="font:BoldSystemFontFile" size="26" />
                </Label>
                <Label id="epOv0" color="0xFFFFFFE0"><Font role="font" uri="font:MediumSystemFontFile" size="24" /></Label>
                <Label id="epOv1" color="0xFFFFFFE0"><Font role="font" uri="font:MediumSystemFontFile" size="24" /></Label>
                <Label id="epOv2" color="0xFFFFFFE0"><Font role="font" uri="font:MediumSystemFontFile" size="24" /></Label>
                <Poster id="epCheck" uri="pkg:/images/ui/icon_check_28.png" width="20" height="20" />
                <Rectangle id="epTrack" width="64" height="6" color="0xFFFFFF59" />
                <Rectangle id="epFill" height="6" color="0xFFFFFFFF" />
                <Label id="epFoot" color="0xFFFFFFFF">
                    <Font role="font" uri="font:MediumSystemFontFile" size="24" />
                </Label>
            </Group>
            <Rectangle id="barTrack" height="6" color="0x00000080" visible="false" />
            <Rectangle id="barFill" height="6" visible="false" />
            <!-- (v1.4 R4) the resume ring: a flat dark disc, the white arc from 12 o'clock, a play glyph -->
            <Group id="resume" visible="false">
                <Poster id="resumeBg" uri="pkg:/images/ui/white_circle_69.png" blendColor="0x1C1C1CFF" opacity="0.8" />
                <Poster id="resumeTrack" uri="pkg:/images/ui/load_track.png" />
                <Poster id="resumeArc" />
                <Poster id="resumePlay" uri="pkg:/images/ui/icon_play_28.png" />
            </Group>
            <Poster id="mask" />
            <Poster id="heart" uri="pkg:/images/ui/icon_heart_28.png" width="28" height="28" visible="false" />
            <Poster id="badge" visible="false" />
            <Poster id="badgeIcon" uri="pkg:/images/ui/icon_check_28.png" width="22" height="22" visible="false" />
            <Label id="badgeText" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" visible="false">
                <Font role="font" uri="font:BoldSystemFontFile" size="24" />
            </Label>
            <Poster id="ring" uri="pkg:/images/ui/focus_ring_r18.9.png" opacity="0" />
        </Group>
        <!-- (v1.1.1 VD-8) title 26 Bold over a smaller, dimmer year (24 Medium; v1.4: Glass3D 92 % / 62 %) -->
        <Label id="title" horizAlign="center" color="0xFFFFFFEB">
            <Font role="font" uri="font:BoldSystemFontFile" size="26" />
        </Label>
        <Label id="name2" horizAlign="center" color="0xFFFFFFEB" visible="false">
            <Font role="font" uri="font:BoldSystemFontFile" size="24" />
        </Label>
        <Label id="year" horizAlign="center" color="0xFFFFFF9E">
            <Font role="font" uri="font:MediumSystemFontFile" size="24" />
        </Label>
    </children>
</component>
