<?xml version="1.0" encoding="utf-8" ?>
<!-- One tile in a home row: image (decoded at tile size to save memory), resume bar, title and a second line. -->
<component name="PosterItem" extends="Group">
    <script type="text/brightscript" uri="PosterItem.bs" />
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="width" type="float" onChange="onSize" />
        <field id="height" type="float" onChange="onSize" />
        <field id="focusPercent" type="float" onChange="onFocus" />
        <field id="rowListHasFocus" type="boolean" onChange="onFocus" />
    </interface>
    <children>
        <Rectangle id="frame" color="0x1C2030FF" />
        <Poster id="image" loadDisplayMode="scaleToZoom" />
        <Label id="initials" horizAlign="center" vertAlign="center" color="0x5A6070FF">
            <Font role="font" uri="font:BoldSystemFontFile" size="34" />
        </Label>
        <Rectangle id="barBack" color="0x00000099" visible="false" />
        <Rectangle id="bar" color="0xE50914FF" visible="false" />
        <Label id="title" color="0xC8CCD8FF">
            <Font role="font" uri="font:MediumSystemFontFile" size="24" />
        </Label>
        <Label id="line2" color="0x7A8090FF">
            <Font role="font" uri="font:SmallSystemFontFile" size="20" />
        </Label>
    </children>
</component>
