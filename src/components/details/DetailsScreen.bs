import "pkg:/source/Util.bs"
import "pkg:/source/Prefs.bs"
import "pkg:/source/Api.bs"
import "pkg:/source/Items.bs"
import "pkg:/source/Playback.bs"
import "pkg:/source/Tracks.bs"
import "pkg:/source/Subs.bs"
import "pkg:/source/MediaInfo.bs"
import "pkg:/source/Ratings.bs"
import "pkg:/source/Speak.bs"
import "pkg:/source/Toasts.bs"
import "pkg:/source/NavUtil.bs"
import "pkg:/source/QuickPlay.bs"
import "pkg:/source/HomeLayout.bs"
import "pkg:/source/Servers.bs"
import "pkg:/source/DetailsHead.bs"
import "pkg:/source/ThemeMusic.bs"
import "pkg:/source/Log.bs"

sub init()
    ' (v1.2) "Cove: details <ms> header / item answered / rows ready": from the screen's creation (MainScene
    ' creates and pushes it in one go)
    m.pushClock = createObject("roTimespan")
    m.headerTimed = false
    m.itemTimed = false
    m.previewShown = false
    m.previewBackdrop = ""
    m.previewLogo = ""
    m.focusEpisodes = false
    m.userAudioAsked = false
    t = m.global.theme
    m.rows = m.top.findNode("rows")
    m.lower = m.top.findNode("lower")
    m.seasonBar = m.top.findNode("seasonBar")
    m.barIds = []
    m.barIdx = 0
    m.subLangs = []         ' [{ code, label }] subtitle languages of the series (from one episode)
    m.streamsFor = ""
    m.status = m.top.findNode("status")
    m.logo = m.top.findNode("logo")
    m.btnGroup = m.top.findNode("buttons")
    m.btnKeys = m.top.findNode("btnKeys")
    ' (SC-9) a failed page load: the message with Try Again, as on the other screens
    m.errorPanel = m.top.findNode("errorPanel")
    m.errorPanel.buttons = [{ id: "retry", label: "Try Again" }]
    m.errorPanel.observeField("chosen", "onErrorChosen")
    m.slide = m.top.findNode("slide")
    m.top.findNode("scrimBottom").uri = t.scrimBottom
    m.top.findNode("rowsFade").uri = t.fade
    m.top.findNode("rowsSolid").color = t.bg
    m.logo.observeField("loadStatus", "onLogoLoaded")
    m.rows.observeField("rowItemSelected", "onRowSelected")
    m.top.observeField("focusedChild", "onFocusChanged")
    m.item = invalid
    m.pending = []
    m.tracks = invalid
    m.opts = Playback.options()
    m.picker = invalid
    m.isFav = false
    m.btns = []
    m.btnSig = ""
    m.btn = 0
    m.focusPlay = true
    m.state = "buttons"
    m.logoReady = false
    m.lines = 0
    ' rows below the header
    m.seasonList = []
    m.seasonIndex = -1
    m.seasonByUser = false
    m.episodeList = []
    m.shownEps = []         ' the episodes in the row: unwatched only unless "Show all" (Mac shownEpisodes)
    m.showAllEps = false
    m.episodesSeason = -1   ' the season whose episodes m.episodeList holds
    m.castList = []
    m.similarList = []
    m.nextUp = invalid
    m.seasonGen = 0
    m.jumpToEpisodes = false
    m.about = m.top.findNode("about")
    m.hasAbout = false
    m.ovMore = false        ' the description is cut: Up from the buttons reaches "MORE"
    m.ovWidth = 0
    m.textPanel = invalid   ' the whole description, while open
    m.covered = false       ' (SC5-12) hidden under another screen since the last focus
    m.trailers = []         ' trailers stored on the server with this title (LocalTrailers)
    m.extrasList = []       ' (v1.0 F-9) extras / special features (behind the scenes, deleted scenes, ...)
    m.seriesPlay = invalid  ' (v1.0 F-17) the Play All / Shuffle request waiting for its episodes
    m.boxList = []          ' a collection's titles, in release order
    m.includedList = []     ' the collections this title is in ("Included In")
    m.tags = []             ' (v1.1) the genre / studio pills in About: [{ kind, id, name }]
    m.tagIdx = 0
    ' Audio Guide: what was said last (a redraw that doesn't move the focus says nothing), the title it was for
    m.spokenKey = ""
    m.spokenItem = ""
    m.spokenRow = -1
    m.rows.observeField("rowItemFocused", "onRowFocusedSpeak")
    ' (v1.1.1 SP-10) a series page waits a moment for Next Up before loading a season's episodes
    m.nextUpPending = false
    m.seasonWaiting = false
    m.seasonWait = m.top.findNode("seasonWait")
    m.seasonWait.observeField("fire", "onSeasonWait")
    ' (v1.2 SP-9) each list's cards, built once when it arrives; one rebuild per burst of answers
    m.rowNodes = {}
    m.rowGens = {}
    m.rowGen = 0
    m.rowsSig = ""
    m.rowBuilds = 0
    m.epNodeById = {}
    m.epDesc = invalid
    m.rowWait = {}
    m.rowsTimed = false
    m.rowsTimer = m.top.findNode("rowsTimer")
    m.rowsTimer.observeField("fire", "onRowsTimer")
    ' (v1.5 details) the Emby-style header: artwork left, a column on the right
    m.col = m.top.findNode("col")
    m.artImg = m.top.findNode("artImg")
    m.artLow = m.top.findNode("artLow")
    m.top.findNode("artBg").blendColor = skeletonColor()
    m.top.findNode("artMask").uri = t.maskPoster
    m.previewArt = ""
    m.restY = 900           ' where the rows below rest while the header has the focus
    m.headType = ""
    setGeometry("Movie")
    m.hasMedia = false
    m.mediaPills = []       ' [{ id, bg, lbl, chev, speech }] the Audio / Subtitles (/ Video) pills
    m.mediaIdx = 0
    m.menu = invalid        ' the open DetailsMenu (track list, ⋯ More and its lists)
    m.menuBack = "buttons"  ' where the focus goes when it closes
    m.isAdmin = false
    m.btnY = 0
    m.layoutTimed = false
    m.kbFor = ""
    m.kbTimer = m.top.findNode("kbTimer")
    m.kbTimer.observeField("fire", "focusKeyboard")
    Speak.mute([m.rows, m.btnKeys])
    ' (v1.7 DIAG M-7) theme song
    initThemeSong()
end sub

' (v1.5 details) Artwork and column sizes for a kind of title: films, series and collections show the tall
' poster (420 x 630), episodes their 16:9 still (640 x 360); the column starts 56 px right of it
sub setGeometry(t as string)
    m.headType = t
    m.wideArt = t = "Episode"
    if m.wideArt
        m.artW = 640
        m.artH = 360
        m.logoH = 120
    else
        m.artW = 420
        m.artH = 630
        m.logoH = 150
    end if
    m.colX = 96 + m.artW + 56
    ' (v1.5, Liviu) no small poster or still on any details page, only the big backdrop behind it; the text
    ' column starts at the safe edge
    ' (episodes too, after Liviu's second photo: no still either)
    m.top.findNode("art").visible = false
    m.colX = 96
    m.colW = 1824 - m.colX
    m.ovLimit = m.colW - 40
    if m.ovLimit > 1200 then m.ovLimit = 1200
    for each n in ["artBg", "artLow", "artImg", "artMask"]
        p = m.top.findNode(n)
        p.width = m.artW
        p.height = m.artH
    end for
    m.artImg.loadWidth = m.artW
    m.artImg.loadHeight = m.artH
    m.col.translation = [m.colX, 110]
    m.top.findNode("title").width = m.colW
    m.top.findNode("title").height = m.logoH
    m.top.findNode("epLine").width = m.colW
    m.top.findNode("tagline").width = m.colW
    for i = 0 to 2
        m.top.findNode("ov" + i.toStr()).width = m.ovLimit + 20
    end for
end sub

' ---------------------------------------------------------------- loading

' (SC-11) Back on this series page from "Go to Season": that season, the focus on its episodes
sub onOpenSeason()
    id = Util.toText(m.top.openSeason)
    if id = "" or m.item = invalid then return
    k = seasonIndexOf(id)
    if k < 0 then return
    m.focusEpisodes = true
    if k = m.seasonIndex
        enterRows()
        m.focusEpisodes = false
        return
    end if
    selectSeason(k, true)
end sub

function itemPath() as string
    return "/Users/" + Util.toText(m.top.server.userId) + "/Items/" + m.top.itemId + "?Fields=Overview,People,Genres,MediaSources,MediaStreams,Chapters,Trickplay,Taglines,Studios,DateCreated,Path,ProviderIds&EnableImageTypes=Primary,Backdrop,Thumb,Logo"
end function

sub load()
    m.status.text = "Loading..."
    ' (v1.2 SP-12) the card's preview: the header at once, the buttons as placeholder pills
    if m.item = invalid and not m.previewShown and Util.isAA(m.top.preview) then showPreview(m.top.preview)
    get(itemPath(), { kind: "item" })
end sub

' (v1.2) one "Cove: details <ms> <what>" line, ms since the screen was created
sub detailsMark(what as string)
    Log.line("Cove: details " + Util.toText(m.pushClock.totalMilliseconds()) + " " + Util.toText(what))
end sub

' (v1.2 SP-12) The header from the card that opened the page: backdrop, artwork, logo or title, the meta line and
' the description, at the positions showItem uses, so nothing jumps when the item answers. (v1.5 details) The
' column's slots are fixed per kind of title (the logo box, the media line for playable titles, the buttons), so
' the item's answer fills them in place.
sub showPreview(p as object)
    srv = m.top.server
    m.previewShown = true
    m.status.text = ""
    t = Util.toText(p.itemType)
    id = Util.toText(m.top.itemId)
    setGeometry(t)
    m.hasMedia = DetailsHead.hasMediaLine(t)
    ' (slim lists carry no artwork tags: the title's own picture without a tag; showItem keeps the same URL
    ' when the title has one, so the texture isn't loaded twice)
    bd = Util.toText(p.backdrop)
    lg = Util.toText(p.logo)
    if t = "Episode" then lg = Util.toText(p.seriesLogo)
    art = ""
    if previewGuessesArt(t) and id <> ""
        if bd = "" then bd = Util.toText(srv.url) + "/Items/" + id + "/Images/Backdrop/0?maxWidth=1280&quality=85"
        if lg = "" then lg = Util.toText(srv.url) + "/Items/" + id + "/Images/Logo?maxWidth=700&quality=85"
        art = Util.toText(srv.url) + "/Items/" + id + "/Images/Primary?maxWidth=" + m.artW.toStr() + "&quality=85"
    end if
    ' the card's own picture (already loaded) under the full-size one: a poster card for a tall poster, a wide card
    ' for an episode's still
    low = Util.toText(p.image)
    if low <> "" and Util.flag(p, "imageWide") <> m.wideArt then low = ""
    m.artLow.uri = low
    m.previewArt = art
    m.artImg.uri = art
    m.previewBackdrop = bd
    m.previewLogo = lg
    m.top.findNode("backdrop").uri = bd
    title = Util.toText(p.title)
    if t = "Episode" and Util.toText(p.seriesName) <> "" then title = Util.toText(p.seriesName)
    m.top.findNode("title").text = title
    m.top.findNode("title").visible = true
    m.top.findNode("miniTitle").text = Util.toText(p.title)
    m.logoReady = false
    m.logo.visible = false
    m.logo.uri = lg
    m.top.findNode("epLine").text = Util.toText(p.epLine)
    ' the meta line where the info line goes (an episode's card line repeats "S4:E2 · Name": nothing until the item
    ' answers, the line above has them)
    metaText = Util.toText(p.meta)
    if t = "Episode" then metaText = ""
    drawInfoRow([{ kind: "text", text: metaText }])
    drawBadges([])
    drawMediaSkeleton()
    ov = Util.toText(p.overview)
    lines = wrapOverview(ov, 3)
    if Util.flag(p, "full") and ov = "" and Items.hidesSpoilers({ Type: t, UserData: { Played: Util.flag(p, "played") } }) then lines = ["Description hidden until you watch this episode."]
    skeletonLines = 0
    ' (a slim list has no description: three placeholder bars, the common length)
    if not Util.flag(p, "full") and ov = "" then skeletonLines = 3
    m.lines = lines.count()
    if skeletonLines > 0 then m.lines = skeletonLines
    for i = 0 to 2
        line = ""
        if i < lines.count() then line = lines[i]
        m.top.findNode("ov" + i.toStr()).text = line
    end for
    drawOverviewSkeleton(skeletonLines)
    m.ovMore = false
    m.top.findNode("ovMore").visible = false
    m.ovWidth = 0
    m.top.findNode("tagline").text = ""
    ' (the card's progress: the line under the buttons is there at once)
    showProgress(Util.toNumber(p.progress), "")
    setCredit("")
    layoutHeader()
    drawButtons()
    m.headerTimed = true
    detailsMark("header (from the card)")
end sub

' Titles whose own backdrop / logo the preview may ask for without a tag (an episode's come from its series)
function previewGuessesArt(t as string) as boolean
    return t = "Movie" or t = "Series" or t = "BoxSet" or t = "Video" or t = "MusicVideo"
end function

' (SP-12) Placeholder bars in the description's lines (0 removes them)
sub drawOverviewSkeleton(count as integer)
    g = m.top.findNode("ovSkel")
    g.removeChildrenIndex(g.getChildCount(), 0)
    widths = [940, 860, 560]
    for i = 0 to count - 1
        bar = g.createChild("Poster")
        bar.uri = "pkg:/images/ui/white_pill.9.png"
        bar.blendColor = skeletonColor()
        bar.width = widths[i]
        bar.height = 22
        bar.translation = [0, i * 38 + 8]
    end for
end sub

function skeletonColor() as string
    c = Util.toText(m.global.theme.placeholder)
    if c = "" then c = "0x262626FF"
    return c
end function

' (SP-12) The button row before the item answers: the Play pill and three round buttons as plain shapes
sub drawButtonSkeleton()
    m.btnGroup.removeChildrenIndex(m.btnGroup.getChildCount(), 0)
    m.btnSig = ""
    m.btnGroup.translation = [0, m.btnY]
    if not m.previewShown then return
    col = skeletonColor()
    pill = m.btnGroup.createChild("Poster")
    pill.uri = "pkg:/images/ui/white_pill.9.png"
    pill.blendColor = col
    pill.width = 255
    pill.height = 69
    x = 255 + 21
    ' (v1.5 details: Watched, Favorite, More)
    for i = 0 to 2
        c = m.btnGroup.createChild("Poster")
        c.uri = "pkg:/images/ui/white_circle_69.png"
        c.blendColor = col
        c.width = 69
        c.height = 69
        c.translation = [x, 0]
        x = x + 69 + 18
    end for
end sub

' After playback: reload so Resume and the episodes show the new position
sub onRefresh()
    m.top.stale = false
    if m.item = invalid then return
    m.focusPlay = true
    get(itemPath(), { kind: "item" })
    if Util.toText(m.item.Type) = "Series"
        m.nextUpPending = true
        loadNextUp()
        if m.seasonIndex >= 0
            if m.seasonByUser
                loadEpisodes(m.seasonIndex)
            else
                ' (v1.2 SP-10) after playback Next Up may be in the next season: wait for it (at most 0.8 s) and
                ' load that season's episodes once, instead of this season's and then the other
                m.seasonWaiting = true
                m.seasonWait.control = "stop"
                m.seasonWait.control = "start"
            end if
        end if
        reloadSeasonCounts()
    end if
    if Util.toText(m.item.Type) = "BoxSet" then loadBoxItems()
end sub

sub get(path as string, tag as object)
    send("GET", path, tag)
end sub

sub send(method as string, path as string, tag as object)
    t = createObject("roSGNode", "ApiTask")
    t.request = { method: method, url: Util.toText(m.top.server.url) + path, headers: Api.headers(m.top.server, true), body: "", tag: tag, timeout: 20000 }
    t.observeField("response", "onResponse")
    m.pending.push(t)
    t.control = "RUN"
end sub

sub onResponse(ev as object)
    t = ev.getRoSGNode()
    for i = 0 to m.pending.count() - 1
        if m.pending[i].isSameNode(t)
            m.pending.delete(i)
            exit for
        end if
    end for
    r = ev.getData()
    k = r.tag.kind
    if k = "item" and not m.itemTimed
        m.itemTimed = true
        detailsMark("item answered (" + Util.toText(r.code) + ")")
    end if
    if k = "fav"
        onFavourite(r)
        return
    else if k = "watched"
        onWatched(r)
        return
    else if k = "trailers"
        onTrailers(r)
        return
    else if k = "seriesRating"
        ' (v0.9.1) the series' rating for an unrated episode; a failed answer keeps the title hidden
        if r.code = 200 then Ratings.rememberSeries(m.top.server, [Util.toText(r.tag.seriesId)], r.json)
        if Util.isAA(r.tag.item) then onItemRated(r.tag.item)
    else if k = "extras"
        onExtras(r)
        return
    else if k = "seriesPlay"
        onSeriesPlay(r)
        return
    else if k = "userAudio"
        onUserAudio(r)
        return
    else if k = "lists"
        onLists(r)
        return
    else if k = "listAdd"
        onListAdd(r)
        return
    else if k = "refreshMeta"
        onRefreshMeta(r)
        return
    else if k = "themeSongs"
        ' (v1.7 DIAG M-7)
        onThemeSongs(r)
        return
    end if
    if r.code <> 200 or r.json = invalid
        ' (SP-10) no Next Up: a season waiting for it loads now
        if k = "nextUp" then onNextUp(invalid)
        ' (SP-9) a failed list still counts as answered for "rows ready"
        if k = "similar" or k = "boxItems" or k = "includedIn" or k = "seasons" or k = "episodes" then rowAnswered(k)
        if k = "item"
            if m.item = invalid
                showLoadError("Couldn't load this title. " + Api.describeFailure(r))
            else
                ' (a refresh: the page stays as it is)
                Log.line("Cove: details refresh failed -> " + Util.toText(r.code))
            end if
        end if
        return
    end if
    if k = "item" and Ratings.seriesUnknown(m.top.server, r.json)
        ' (v0.9.1: an episode without its own rating, under a limit: its series' rating first)
        sid = Util.toText(r.json.SeriesId)
        send("GET", Ratings.seriesPath(m.top.server, [sid]), { kind: "seriesRating", seriesId: sid, item: r.json })
    else if k = "item"
        onItemRated(r.json)
    else if k = "seasons"
        onSeasons(r.json)
    else if k = "episodes" and r.tag.gen = m.seasonGen
        onEpisodes(r.json)
    else if k = "nextUp"
        onNextUp(r.json)
    else if k = "epStreams"
        onEpisodeStreams(r.json)
    else if k = "similar"
        m.similarList = Ratings.keep(m.top.server, listOf(r.json))
        setRowNodes("similar", m.similarList)
        rowAnswered("similar")
    else if k = "seasonCounts"
        onSeasonCounts(r.json)
    else if k = "boxItems"
        m.boxList = Ratings.keep(m.top.server, listOf(r.json))
        Log.line("Cove: collection titles -> " + Util.toText(m.boxList.count()))
        setRowNodes("box", m.boxList)
        buildButtons()
        rowAnswered("boxItems")
    else if k = "includedIn"
        list = listOf(r.json)
        ' (a long answer means the server ignored the filter and sent every collection: show none, as the Mac)
        if list.count() > 10 then list = []
        ' (v0.9.1: collections above the profile's rating limit stay away too)
        m.includedList = Ratings.keep(m.top.server, list)
        setRowNodes("included", m.includedList)
        rowAnswered("includedIn")
    end if
end sub

' (SC-9) The page couldn't load: the message and Try Again instead of an empty page
sub showLoadError(text as string)
    m.status.text = ""
    ' (SP-12: no placeholder pills behind the error)
    m.previewShown = false
    drawButtonSkeleton()
    drawOverviewSkeleton(0)
    m.errorPanel.message = text
    m.errorPanel.index = 0
    m.errorPanel.visible = true
    m.state = "error"
    if m.top.isInFocusChain() and m.picker = invalid then m.errorPanel.setFocus(true)
end sub

sub onErrorChosen(ev as object)
    if Util.toText(ev.getData().id) <> "retry" then return
    m.errorPanel.visible = false
    m.state = "buttons"
    m.btnKeys.setFocus(true)
    load()
end sub

' The title, or the rating-limit message when the profile may not see it
sub onItemRated(it as object)
    if Ratings.allowed(m.top.server, it)
        showItem(it)
    else
        ' (v0.9.0: above the profile's rating limit, e.g. reached from a link or a collection)
        m.status.text = "This title is above this profile's rating limit (" + Util.toText(m.top.server.maxRating) + ")."
    end if
end sub

function listOf(json as dynamic) as object
    if type(json) = "roArray" then return json
    if json <> invalid and GetInterface(json, "ifAssociativeArray") <> invalid and type(json.Items) = "roArray" then return json.Items
    return []
end function

' ---------------------------------------------------------------- header

sub showItem(it as object)
    if m.item = invalid or Util.toText(m.item.Id) <> Util.toText(it.Id) then m.focusPlay = true
    first = m.item = invalid
    m.item = it
    srv = m.top.server
    m.status.text = ""
    if m.errorPanel.visible
        m.errorPanel.visible = false
        if m.state = "error" then m.state = "buttons"
    end if
    t = Util.toText(it.Type)
    if t <> m.headType then setGeometry(t)
    m.hasMedia = DetailsHead.hasMediaLine(t)
    m.isFav = Util.flag(it.UserData, "IsFavorite")
    bdUrl = Items.backdrop(srv, it, 1280)
    ' (SP-12) the preview's picture is this title's own (untagged or the same URL): keep it, no second load
    if m.previewBackdrop <> "" and bdUrl <> "" then bdUrl = m.previewBackdrop
    if m.top.findNode("backdrop").uri <> bdUrl then m.top.findNode("backdrop").uri = bdUrl
    ' (v1.5 details) the artwork: the poster (films, series, collections) or the episode's still
    artUrl = ""
    if m.wideArt
        artUrl = Items.landscape(srv, it, m.artW)
    else
        artUrl = Items.imageUrl(srv, Util.toText(it.Id), "Primary", Items.tagOf(it.ImageTags, "Primary"), m.artW)
        if m.previewArt <> "" and artUrl <> "" then artUrl = m.previewArt
    end if
    if m.artImg.uri <> artUrl then m.artImg.uri = artUrl
    ' the logo (an episode: its series' logo, with "S2:E7 - Name" under it), else the name as text
    title = Util.toText(it.Name)
    if t = "Episode" and Util.toText(it.SeriesName) <> "" then title = Util.toText(it.SeriesName)
    logoUrl = Items.logo(srv, it, 700)
    if m.previewLogo <> "" and logoUrl <> "" then logoUrl = m.previewLogo
    m.top.findNode("title").text = title
    m.top.findNode("miniTitle").text = Util.toText(it.Name)
    m.top.findNode("epLine").text = ""
    if t = "Episode" then m.top.findNode("epLine").text = DetailsHead.episodeLine(it)
    if logoUrl <> m.logo.uri
        m.logoReady = false
        m.logo.visible = false
        m.top.findNode("title").visible = true
        m.logo.uri = logoUrl
    end if
    segs = DetailsHead.infoSegments(it, Items.endsAt(it), MediaInfo.dateText(it.PremiereDate, false))
    drawInfoRow(segs)
    drawBadges(segs)
    m.top.findNode("tagline").text = DetailsHead.taglineOf(it)
    lines = wrapOverview(Util.toText(it.Overview), 3)
    ' Settings → Hide spoilers: no description until the episode is watched
    if Items.hidesSpoilers(it) and Util.toText(it.Overview) <> "" then lines = ["Description hidden until you watch this episode."]
    m.lines = lines.count()
    for i = 0 to 2
        line = ""
        if i < lines.count() then line = lines[i]
        m.top.findNode("ov" + i.toStr()).text = line
    end for
    if first then drawOverviewSkeleton(0)
    placeMore(it, lines)
    setCredit(DetailsHead.creditLine(it))
    showAbout(it)
    ' audio / subtitles / quality for this playback (chosen once, kept on refresh)
    if t <> "Series" and t <> "BoxSet" and (first or m.tracks = invalid)
        m.versions = Tracks.versions(it)
        m.tracks = Tracks.fromItem(it, m.opts.sourceId)
        m.opts.defaultAudio = Tracks.defaultAudio(m.tracks)
        m.opts.startAudio = startAudioHere()
        s = Tracks.defaultSub(m.tracks, "")
        ' Settings → Always load my subtitle language (the Subtitles pill then shows it)
        if Prefs.subAlways()
            a = Tracks.subForLanguage(m.tracks, Prefs.subLang())
            if a >= 0 then s = a
        end if
        ' (none chosen yet and the Roku's captions On: a text subtitle in the language, as the player does)
        if s < 0 and Subs.rokuMode() = "On"
            a = Tracks.subForLanguage(m.tracks, Subs.rokuLanguage())
            if a >= 0 and Tracks.findSub(m.tracks, a).isText then s = a
        end if
        if s >= 0
            m.opts.sub = s
            m.opts.burn = not Tracks.findSub(m.tracks, s).isText
        end if
    end if
    ' (BG-4) the account's settings (once per page): the audio language, so the Audio pill shows the track the
    ' player will start with even before the first playback, and (v1.5) whether the user is an administrator
    ' (⋯ More → Refresh Metadata)
    if not m.userAudioAsked
        m.userAudioAsked = true
        get("/Users/" + Util.toText(m.top.server.userId), { kind: "userAudio" })
    end if
    buildMediaRow()
    showProgress(DetailsHead.playedPart(it), DetailsHead.remainingLabel(it))
    if first
        m.castList = []
        if type(it.People) = "roArray"
            for each p in it.People
                k = Util.toText(p.Type)
                if (k = "Actor" or k = "Director" or k = "Writer" or k = "GuestStar") and m.castList.count() < 20 then m.castList.push(p)
            end for
        end if
        setRowNodes("cast", m.castList)
        ' (SP-9) the first answers "rows ready" waits for (extras: loadExtras adds itself when it asks)
        m.rowWait["similar"] = true
        if t = "Series" then m.rowWait["seasons"] = true
        if t = "BoxSet" then m.rowWait["boxItems"] = true
        if t <> "BoxSet" and t <> "Episode" then m.rowWait["includedIn"] = true
        if t = "Series"
            ' (SC5-5) the series' own rating, cached before any episode list: an unrated episode inherits it, so a
            ' limited profile's Play All / Shuffle / episode rows don't drop (or show) them for want of it
            if Ratings.limitOf(srv) > 0 then Ratings.rememberSeries(srv, [Util.toText(it.Id)], [it])
            get("/Shows/" + Util.toText(it.Id) + "/Seasons?UserId=" + Util.toText(srv.userId) + "&" + Items.fields(), { kind: "seasons" })
            ' (SP-10) the seasons wait for this answer
            m.nextUpPending = true
            loadNextUp()
        end if
        get("/Items/" + Util.toText(it.Id) + "/Similar?UserId=" + Util.toText(srv.userId) + "&Limit=12&" + Items.fields(), { kind: "similar" })
        loadTrailers(it)
        loadExtras(it)
        if t = "BoxSet" then loadBoxItems()
        if t <> "BoxSet" and t <> "Episode" then loadIncludedIn(it)
    end if
    buildButtons()
    layoutHeader()
    if first and not m.headerTimed
        m.headerTimed = true
        detailsMark("header")
    end if
    if first and not m.layoutTimed
        m.layoutTimed = true
        Log.line("Cove: details layout " + Util.toText(t) + " " + Util.toText(m.pushClock.totalMilliseconds()) + " ms")
    end if
    rebuildRows()
    if first and m.top.isInFocusChain() then enterButtons(false)
    ' (v1.7 DIAG M-7) the theme song, a moment after the page settles
    if first then queueThemeSong()
end sub

' (v1.5 details) The info line, left to right with 24 px gaps: ★ 8.4, tomato 96%, year (episodes: air date),
' runtime, the rating in an outlined box, genres, "Ends at 12:53 AM" (DetailsHead.infoSegments)
sub drawInfoRow(segs as object)
    g = m.top.findNode("infoRow")
    g.removeChildrenIndex(g.getChildCount(), 0)
    x = 0
    for each s in segs
        if s.kind = "star"
            ic = g.createChild("Poster")
            ic.uri = "pkg:/images/ui/icon_star_28.png"
            ic.width = 24
            ic.height = 24
            ic.translation = [x, 8]
            ic.blendColor = "0xFFD60AFF"
            x = x + 30
        else if s.kind = "critic"
            ic = g.createChild("Poster")
            ic.uri = criticIcon(Util.flag(s, "fresh"))
            ic.width = 28
            ic.height = 28
            ic.translation = [x, 6]
            x = x + 34
        end if
        lbl = infoLabel(g, Util.toText(s.text), s.kind = "rating")
        w = Int(lbl.boundingRect().width)
        if s.kind = "rating"
            frame = g.createChild("Poster")
            frame.uri = "pkg:/images/ui/outline_box_r6.9.png"
            frame.width = w + 20
            frame.height = 32
            frame.translation = [x, 4]
            lbl.translation = [x + 10, 0]
            x = x + w + 20 + 24
        else
            lbl.translation = [x, 0]
            x = x + w + 24
        end if
    end for
end sub

function infoLabel(g as object, text as string, bold as boolean) as object
    lbl = g.createChild("Label")
    f = createObject("roSGNode", "Font")
    f.uri = "font:MediumSystemFontFile"
    f.size = 26
    if bold
        f.uri = "font:BoldSystemFontFile"
        f.size = 22
    end if
    lbl.font = f
    lbl.height = 40
    lbl.vertAlign = "center"
    lbl.color = "0xFFFFFFEB"
    lbl.text = text
    return lbl
end function

function criticIcon(fresh as boolean) as string
    if fresh then return "pkg:/images/ui/icon_critic_fresh_56.png"
    return "pkg:/images/ui/icon_critic_rotten_56.png"
end function

' (v1.5 details) Emby's score badges down the poster's right edge (films and series): a dark capsule per score
' the server gives (★ community rating, the critics' tomato), the icon over the number
sub drawBadges(segs as object)
    g = m.top.findNode("badges")
    g.removeChildrenIndex(g.getChildCount(), 0)
    if m.wideArt or (m.headType <> "Movie" and m.headType <> "Series") then return
    bw = 66
    bh = 94
    x = m.artW - 14 - bw
    y = 14
    for each s in segs
        if s.kind = "star" or s.kind = "critic"
            cap = g.createChild("Poster")
            cap.uri = "pkg:/images/ui/white_rr12.9.png"
            cap.blendColor = "0x000000FF"
            cap.opacity = 0.62
            cap.width = bw
            cap.height = bh
            cap.translation = [x, y]
            ic = g.createChild("Poster")
            ic.width = 32
            ic.height = 32
            ic.translation = [x + 17, y + 12]
            if s.kind = "star"
                ic.uri = "pkg:/images/ui/icon_star_28.png"
                ic.blendColor = "0xFFD60AFF"
            else
                ic.uri = criticIcon(Util.flag(s, "fresh"))
            end if
            num = g.createChild("Label")
            f = createObject("roSGNode", "Font")
            f.uri = "font:BoldSystemFontFile"
            f.size = 26
            num.font = f
            num.text = Util.toText(s.text).replace("%", "")
            num.color = "0xFFFFFFFF"
            num.width = bw
            num.height = 40
            num.horizAlign = "center"
            num.vertAlign = "center"
            num.translation = [x, y + 48]
            y = y + bh + 12
        end if
    end for
end sub

' (v1.5 details) The progress line under the buttons when started: the played part green (as the Continue
' Watching ring), the rest 25 % white, then "2h 27m remaining"
sub showProgress(part as float, remainText as string)
    row = m.top.findNode("progressRow")
    on = part > 0.005 and part < 0.995
    row.visible = on
    if not on then return
    m.top.findNode("progFill").width = Int(320 * part + 0.5)
    m.top.findNode("progText").text = remainText
end sub

' "Director: Name" (the name in bold white after a grey label); "" hides it
sub setCredit(text as string)
    k = m.top.findNode("creditKey")
    n = m.top.findNode("creditName")
    at = text.instr(": ")
    if at < 0
        k.text = ""
        n.text = ""
        return
    end if
    k.text = text.left(at + 1)
    n.text = text.mid(at + 2)
    n.translation = [Int(k.boundingRect().width) + 10, 0]
end sub

' (v1.5 details) The right column, top to bottom (Emby): the logo box (logo or title, bottom-aligned), the
' episode's "S2:E7 - Name", the info line, the media line (playable titles), the buttons, the progress line (when
' started), the bold tagline, the description and Director. The logo box and the media line keep their height
' while their content loads, so the preview's header doesn't move when the item answers.
sub layoutHeader()
    m.top.findNode("title").translation = [0, 0]
    if m.logoReady then m.logo.translation = [0, m.logoH - m.logo.height]
    y = m.logoH + 8
    ep = m.top.findNode("epLine")
    ep.visible = m.wideArt
    if m.wideArt
        ep.translation = [0, y]
        y = y + 50
    end if
    m.top.findNode("infoRow").translation = [0, y]
    y = y + 54
    mr = m.top.findNode("mediaRow")
    mr.visible = m.hasMedia
    if m.hasMedia
        mr.translation = [0, y]
        y = y + 52 + 20
    end if
    m.btnY = y
    m.btnGroup.translation = [m.btnGroup.translation[0], y]
    y = y + 69 + 24
    pr = m.top.findNode("progressRow")
    if pr.visible
        pr.translation = [0, y]
        y = y + 28 + 18
    end if
    tl = m.top.findNode("tagline")
    if tl.text <> ""
        tl.translation = [0, y]
        y = y + 46
    end if
    m.top.findNode("ov").translation = [0, y]
    hl = m.top.findNode("ovFocus")
    hl.translation = [-24, y - 12]
    hl.width = m.ovWidth + 48
    hl.height = m.lines * 38 + 22
    y = y + m.lines * 38 + 14
    m.top.findNode("credit").translation = [0, y]
end sub

' ---------------------------------------------------------------- the whole description

' (v1.4 VD-21) The description in lines of up to 980 px, measured with the hidden ovMeasure label (the same
' font), instead of 72 characters; a cut text ends in "..." with room left for MORE
function wrapOverview(text as string, maxLines as integer) as object
    meas = m.top.findNode("ovMeasure")
    limit = m.ovLimit
    lines = []
    words = text.replace(chr(13), " ").replace(chr(10), " ").split(" ")
    line = ""
    cut = false
    for each w in words
        if w <> ""
            candidate = w
            if line <> "" then candidate = line + " " + w
            meas.text = candidate
            if line = "" or meas.boundingRect().width <= limit
                line = candidate
            else
                lines.push(line)
                line = w
                if lines.count() = maxLines
                    cut = true
                    exit for
                end if
            end if
        end if
    end for
    if not cut
        if line <> "" then lines.push(line)
        return lines
    end if
    ' (shorten the last line word by word until it fits with "..." and MORE)
    parts = lines[maxLines - 1].split(" ")
    last = ""
    while parts.count() > 0
        last = Util.join(parts, " ")
        meas.text = last + "..."
        if meas.boundingRect().width <= limit - 110 then exit while
        parts.pop()
    end while
    lines[maxLines - 1] = last + "..."
    return lines
end function

' A description longer than the three lines ends in "... MORE"; Up from the buttons highlights it and OK opens
' the whole text in a panel (Cove for macOS shows it all in the header, which a TV page has no room for)
sub placeMore(it as object, lines as object)
    full = Util.toText(it.Overview).trim()
    m.ovMore = false
    if full <> "" and not Items.hidesSpoilers(it) and lines.count() = 3 then m.ovMore = wrapOverview(full, 4).count() > 3
    more = m.top.findNode("ovMore")
    more.visible = m.ovMore
    m.ovWidth = 0
    meas = m.top.findNode("ovMeasure")
    for i = 0 to lines.count() - 1
        meas.text = lines[i]
        w = meas.boundingRect().width
        if w > m.ovWidth then m.ovWidth = w
    end for
    if m.ovMore
        x = Int(meas.boundingRect().width) + 14
        if x > m.ovLimit then x = m.ovLimit
        more.translation = [x, 76 + 2]
        if x + 76 > m.ovWidth then m.ovWidth = x + 76
    end if
    if not m.ovMore and m.state = "overview" then m.state = "buttons"
end sub

sub drawOverviewFocus()
    on = m.state = "overview" and m.textPanel = invalid
    m.top.findNode("ovFocus").visible = on
    if on and m.spokenKey <> "overview"
        m.spokenKey = "overview"
        Speak.say(Speak.button("Read More"))
    end if
    more = m.top.findNode("ovMore")
    if on
        more.color = "0xFFFFFFFF"
    else
        more.color = "0xFFFFFFCC"
    end if
end sub

sub enterOverview()
    m.state = "overview"
    m.btnKeys.setFocus(true)
    drawButtons()
end sub

sub openFullText()
    if m.item = invalid or m.textPanel <> invalid then return
    p = createObject("roSGNode", "TextPanel")
    p.heading = Util.toText(m.item.Name)
    p.text = Util.toText(m.item.Overview)
    p.observeField("closed", "onTextClosed")
    m.top.appendChild(p)
    m.textPanel = p
    drawOverviewFocus()
    p.setFocus(true)
end sub

sub onTextClosed()
    if m.textPanel <> invalid
        m.textPanel.unobserveField("closed")
        m.top.removeChild(m.textPanel)
        m.textPanel = invalid
    end if
    enterOverview()
end sub

sub onLogoLoaded()
    if m.logo.loadStatus <> "ready" then return
    bw = m.logo.bitmapWidth
    bh = m.logo.bitmapHeight
    if bw <= 0 or bh <= 0 then return
    s = 620 / bw
    if m.logoH / bh < s then s = m.logoH / bh
    m.logo.width = Int(bw * s)
    m.logo.height = Int(bh * s)
    m.logoReady = true
    m.logo.visible = true
    m.top.findNode("title").visible = false
    layoutHeader()
end sub

' ---------------------------------------------------------------- buttons

' (v1.5 details) Emby's row: Resume / Play (the stronger pill), From Beginning (when started), Trailer (stored
' trailers), then round ✓ Watched, ♡ Favorite and ⋯ More. A series: Play / Resume S:E, Play All, Shuffle.
' (Go to Series / Season of an episode and the quality / version choices moved into ⋯ More.)
sub buildButtons()
    it = m.item
    t = Util.toText(it.Type)
    ' (SC-8) the focused button by id: a trailer or collection answer inserts buttons before it
    prevId = ""
    if m.btn >= 0 and m.btn < m.btns.count() then prevId = Util.toText(m.btns[m.btn].id)
    target = playTarget()
    resumeAt = 0.0
    if target <> invalid then resumeAt = Items.resumeAt(target)
    started = resumeAt > 30
    label = "Play"
    if started then label = "Resume"
    if t = "Series" and target <> invalid
        chip = "S" + Util.toText(target.ParentIndexNumber) + ":E" + Util.toText(target.IndexNumber)
        label = label + " " + chip
    else if t = "BoxSet" and target <> invalid
        ' a collection: which of its titles ("Play Alien", "Resume Aliens")
        n = Util.toText(target.Name)
        if n.len() > 28 then n = n.left(26) + "..."
        label = label + " " + n
        ' (v1.6 M-1) from its first film: Play Collection (the films then follow one another either way)
        if not started and Playback.collectionQueue(m.boxList, Util.toText(target.Id)).index = 0 then label = "Play Collection"
    end if
    btns = []
    for each id in DetailsHead.headerButtonIds(t, started, target <> invalid, m.trailers.count())
        if id = "play"
            btns.push({ id: id, pill: true, label: label })
        else if id = "restart"
            btns.push({ id: id, text: "From Beginning", icon: "play" })
        else if id = "trailer"
            btns.push({ id: id, text: "Trailer", icon: "film" })
        else if id = "playall"
            btns.push({ id: id, text: "Play All" })
        else if id = "shuffle"
            btns.push({ id: id, text: "Shuffle" })
        else if id = "watched"
            ' a check; filled (a white disc with the check cut out) once watched (a series: every episode)
            watchIcon = "check"
            if Util.flag(it.UserData, "Played") then watchIcon = "checkcf"
            btns.push({ id: id, icon: watchIcon })
        else if id = "fav"
            favIcon = "hearto"
            if m.isFav then favIcon = "heart"
            btns.push({ id: id, icon: favIcon })
        else if id = "more"
            btns.push({ id: id, icon: "dt_more" })
        end if
    end for
    m.btns = btns
    ' (v1.5, Liviu) a newly shown or refreshed page focuses Play; a toggle (✓, ♡) keeps its own focus.
    ' (SC5-1) a series / collection has no Play until Next Up or its titles answer: keep the flag until it exists
    bf = NavUtil.buttonFocus(btns, prevId, m.focusPlay = true)
    prevId = bf.id
    m.focusPlay = bf.focusPlay
    at = NavUtil.indexOfId(btns, prevId)
    if at >= 0
        m.btn = at
    else if m.btn >= btns.count()
        m.btn = 0
    end if
    drawButtons()
end sub

' What Play acts on: the title itself, a series' next episode, a collection's first title not watched yet
function playTarget() as dynamic
    t = Util.toText(m.item.Type)
    if t = "Series" then return seriesTarget()
    if t = "BoxSet" then return boxTarget()
    return m.item
end function

' A collection: the first title (in release order) not watched yet, else the first; only playable ones
' (a series or a nested collection in it opens from the row instead)
function boxTarget() as dynamic
    firstPlayable = invalid
    for each c in m.boxList
        k = Util.toText(c.Type)
        if k = "Movie" or k = "Episode" or k = "Video" or k = "MusicVideo"
            if firstPlayable = invalid then firstPlayable = c
            if not Util.flag(c.UserData, "Played") then return c
        end if
    end for
    return firstPlayable
end function

' The series' episode to play: the next one to watch, else the first of the loaded season
function seriesTarget() as dynamic
    if m.nextUp <> invalid then return m.nextUp
    if m.episodeList.count() > 0 then return m.episodeList[0]
    return invalid
end function

sub drawButtons()
    if m.item = invalid
        drawButtonSkeleton()
        return
    end if
    ' (v1.4 VD-18) the Glass3D buttons are built once per button set; a focus change only repaints them
    sig = ""
    for each b in m.btns
        sig = sig + Util.toText(b.id) + "|" + Util.toText(b.label) + "|" + Util.toText(b.icon) + "|" + Util.toText(b.text) + ";"
    end for
    if sig <> m.btnSig or m.btnGroup.getChildCount() <> m.btns.count()
        m.btnSig = sig
        buildButtonNodes()
    end if
    focused = m.state = "buttons" and m.picker = invalid and m.menu = invalid
    focusLeft = 0
    focusRight = 0
    for i = 0 to m.btns.count() - 1
        g = m.btnGroup.getChild(i)
        g.focused = focused and i = m.btn
        if i = m.btn
            focusLeft = g.translation[0]
            focusRight = focusLeft + g.buttonWidth + 18
        end if
    end for
    ' (SC-17) a long row moves left so the focused button stays on screen (the column's width, safe edge 1824)
    m.btnGroup.translation = [NavUtil.buttonShift(focusLeft, focusRight, m.colW), m.btnY]
    drawOverviewFocus()
    paintMedia()
    if focused then speakButton()
end sub

' Play / Resume (the stronger flat pill, VD-10 measured width), text pills and flat circles, 18 px apart (21 after Play)
sub buildButtonNodes()
    m.btnGroup.removeChildrenIndex(m.btnGroup.getChildCount(), 0)
    x = 0
    for i = 0 to m.btns.count() - 1
        b = m.btns[i]
        g = m.btnGroup.createChild("GlassButton")
        if b.pill <> invalid
            g.style = "accent"
            g.icon = "pkg:/images/ui/icon_play_28.png"
            g.minWidth = 220
            g.text = b.label
        else if b.text <> invalid
            g.style = "glass"
            g.textSize = 26
            if b.icon <> invalid then g.icon = "pkg:/images/ui/icon_" + b.icon + "_28.png"
            g.text = b.text
        else
            g.style = "circle"
            g.icon = "pkg:/images/ui/icon_" + b.icon + "_28.png"
        end if
        g.translation = [x, 0]
        gap = 18
        if b.pill <> invalid then gap = 21
        x = x + g.buttonWidth + gap
    end for
end sub

' Audio Guide: the spoken name of a header button
function buttonSpeech(b as object) as string
    id = b.id
    if b.label <> invalid then return b.label
    if b.text <> invalid then return b.text
    if id = "fav" and m.isFav then return "Remove from Favorites"
    if id = "fav" then return "Add to Favorites"
    if id = "watched" and Util.flag(m.item.UserData, "Played") then return "Mark Unplayed"
    if id = "watched" then return "Mark Played"
    if id = "more" then return "More"
    return id
end function

' The focused header button; the title first when the page was just opened
sub speakButton()
    if not Speak.isOn() or m.item = invalid or m.btn >= m.btns.count() then return
    label = buttonSpeech(m.btns[m.btn])
    key = "b" + m.btn.toStr() + label
    if key = m.spokenKey then return
    m.spokenKey = key
    text = Speak.button(label) + Speak.position(m.btn, m.btns.count())
    id = Util.toText(m.item.Id)
    if id <> m.spokenItem
        m.spokenItem = id
        name = Util.toText(m.item.Name)
        if Util.toText(m.item.Type) = "Episode" then name = Util.toText(m.item.SeriesName) + ", season " + Util.toText(m.item.ParentIndexNumber) + " episode " + Util.toText(m.item.IndexNumber) + ", " + name
        text = Speak.clean(name) + ". " + text
    end if
    Speak.say(text)
end sub

' A card in the rows below (episodes, cast, more like this); the row's name when the row changes
sub onRowFocusedSpeak()
    if m.state <> "rows" or not Speak.isOn() then return
    f = m.rows.rowItemFocused
    if f = invalid or f.count() < 2 or m.rows.content = invalid then return
    row = m.rows.content.getChild(f[0])
    if row = invalid then return
    c = row.getChild(f[1])
    if c = invalid then return
    m.spokenKey = "rows"
    text = Speak.card(c)
    if f[0] <> m.spokenRow
        m.spokenRow = f[0]
        text = Util.toText(row.title) + ". " + text
    end if
    Speak.say(text + Speak.position(f[1], row.getChildCount()))
end sub

sub useButton()
    if m.btn >= m.btns.count() then return
    id = m.btns[m.btn].id
    if id = "play"
        target = playTarget()
        if target = invalid then return
        start = Items.resumeAt(target)
        if start <= 30 then start = 0
        if Util.toText(m.item.Type) = "BoxSet"
            requestCollectionPlay(target, start)
        else
            requestPlay(target, start)
        end if
    else if id = "restart"
        target = playTarget()
        if target <> invalid and Util.toText(m.item.Type) = "BoxSet"
            requestCollectionPlay(target, 0)
        else if target <> invalid
            requestPlay(target, 0)
        end if
    else if id = "fav"
        toggleFavourite()
    else if id = "watched"
        toggleWatched()
    else if id = "more"
        openMoreMenu()
    else if id = "trailer"
        if m.trailers.count() = 1
            playTrailer(0)
        else
            o = []
            for i = 0 to m.trailers.count() - 1
                o.push({ id: i.toStr(), label: trailerName(i) })
            end for
            openPicker("trailer", "Trailers", o, "")
        end if
    else if id = "playall"
        playAllMenu()
    else if id = "shuffle"
        loadSeriesPlay("shuffle")
    end if
end sub

sub requestPlay(it as object, start as float)
    ' (v1.1) an episode that hasn't aired yet: nothing to play
    if QuickPlay.isUnaired(it, QuickPlay.nowStamp())
        Toasts.notify("This episode hasn't aired yet", "info")
        return
    end if
    sub_ = ""
    if Util.toText(it.Type) = "Episode" then sub_ = Items.episodeLabel(it)
    title = Util.toText(it.Name)
    if Util.toText(it.Type) = "Episode" then title = Util.toText(it.SeriesName)
    p = { id: Util.toText(it.Id), title: title, subtitle: sub_, start: start }
    ' Choices from this page apply to this movie / episode (other episodes use the defaults)
    if m.item <> invalid and Util.toText(it.Id) = Util.toText(m.item.Id) and Util.toText(m.item.Type) <> "Series"
        p.options = m.opts
        ' (v1.2 SP-13b) the item JSON loaded here (streams, chapters, trickplay): the player skips its own request
        info = Playback.playerInfoOf(m.item)
        if info <> invalid then p.info = info
    end if
    m.top.play = p
end sub

' (v1.6 M-1) Play Collection: the target film, then the collection's next films back to back (the player's
' queue; the list is the page's, already rating-filtered and in the collection's order)
sub requestCollectionPlay(target as object, start as float)
    cq = Playback.collectionQueue(m.boxList, Util.toText(target.Id))
    if cq.index < 0
        requestPlay(target, start)
        return
    end if
    title = Util.toText(target.Name)
    p = { id: Util.toText(target.Id), title: title, subtitle: "", start: start, queue: cq.queue }
    p.collection = { id: Util.toText(m.item.Id), name: Util.toText(m.item.Name), index: cq.index, count: cq.count }
    Log.line("Cove: details play collection film " + Util.toText(cq.index + 1) + " of " + Util.toText(cq.count) + ", " + Util.toText(cq.queue.count()) + " queued")
    m.top.play = p
end sub

' ---------------------------------------------------------------- collections (Mac boxGrid, includedInSection)

' A collection's titles in release order, oldest first (a film series reads in the order it came out)
sub loadBoxItems()
    srv = m.top.server
    get("/Users/" + Util.toText(srv.userId) + "/Items?ParentId=" + Util.toText(m.item.Id) + "&SortBy=" + Playback.collectionSortBy(m.item.DisplayOrder) + "&SortOrder=Ascending&" + Items.fields(), { kind: "boxItems" })
end sub

' The collections a movie or show is in. Jellyfin has its own call (newer servers; older ones answer with an
' error, so the row stays away); Emby filters BoxSets with ListItemIds.
sub loadIncludedIn(it as object)
    srv = m.top.server
    id = Util.toText(it.Id)
    if Util.toText(srv.type) = "jellyfin"
        get("/Items/" + id + "/Collections?userId=" + Util.toText(srv.userId) + "&" + Items.fields(), { kind: "includedIn" })
    else
        get("/Users/" + Util.toText(srv.userId) + "/Items?Recursive=true&IncludeItemTypes=BoxSet&ListItemIds=" + id + "&" + Items.fields(), { kind: "includedIn" })
    end if
end sub

' ---------------------------------------------------------------- trailers (stored on the server)

' GET /Users/{id}/Items/{item}/LocalTrailers (Jellyfin 10.9+: /Items/{item}/LocalTrailers?userId=). Asked when
' the server says the title has some, or doesn't say (LocalTrailerCount isn't sent by every server version).
sub loadTrailers(it as object)
    m.trailers = []
    t = Util.toText(it.Type)
    if t = "BoxSet" or t = "Person" then return
    if it.LocalTrailerCount <> invalid and Util.toNumber(it.LocalTrailerCount) <= 0 then return
    ' (v1.1.1 SP-11) straight to the route that answered before on this server
    if Api.knownRoute(m.top.server, "trailers") = "new"
        get("/Items/" + Util.toText(it.Id) + "/LocalTrailers?userId=" + Util.toText(m.top.server.userId), { kind: "trailers", itemId: Util.toText(it.Id), newRoute: true })
        return
    end if
    get("/Users/" + Util.toText(m.top.server.userId) + "/Items/" + Util.toText(it.Id) + "/LocalTrailers", { kind: "trailers", itemId: Util.toText(it.Id), newRoute: false })
end sub

sub onTrailers(r as object)
    if m.item = invalid or r.tag.itemId <> Util.toText(m.item.Id) then return
    if (r.code = 404 or r.code = 405) and not r.tag.newRoute
        get("/Items/" + r.tag.itemId + "/LocalTrailers?userId=" + Util.toText(m.top.server.userId), { kind: "trailers", itemId: r.tag.itemId, newRoute: true })
        return
    end if
    if r.code <> 200 then return
    Api.rememberRoute(m.top.server, "trailers", r.tag.newRoute = true)
    list = []
    for each tr in listOf(r.json)
        if Util.isAA(tr) and Util.toText(tr.Id) <> "" then list.push(tr)
    end for
    Log.line("Cove: local trailers -> " + Util.toText(list.count()))
    m.trailers = list
    buildButtons()
end sub

function trailerName(i as integer) as string
    n = Util.toText(m.trailers[i].Name)
    if n = "" or n = Util.toText(m.item.Name) then n = "Trailer " + (i + 1).toStr()
    return n
end function

' In the Cove player like any video; the title itself isn't touched (no resume point, not marked watched, no Up next)
sub playTrailer(i as integer)
    if i < 0 or i >= m.trailers.count() then return
    tr = m.trailers[i]
    sub_ = "Trailer"
    if m.trailers.count() > 1 then sub_ = trailerName(i)
    m.top.play = { id: Util.toText(tr.Id), title: Util.toText(m.item.Name), subtitle: sub_, start: 0, trailer: true }
end sub

' ---------------------------------------------------------------- extras (v1.0 F-9)

' GET /Users/{id}/Items/{item}/SpecialFeatures (Emby, Jellyfin up to 10.8); Jellyfin 10.9+:
' /Items/{item}/SpecialFeatures?userId=. Skipped when the server says there are none (SpecialFeatureCount).
sub loadExtras(it as object)
    m.extrasList = []
    t = Util.toText(it.Type)
    if t = "BoxSet" or t = "Person" then return
    if it.SpecialFeatureCount <> invalid and Util.toNumber(it.SpecialFeatureCount) <= 0 then return
    if not m.rowsTimed then m.rowWait["extras"] = true
    if Api.knownRoute(m.top.server, "extras") = "new"
        get("/Items/" + Util.toText(it.Id) + "/SpecialFeatures?userId=" + Util.toText(m.top.server.userId), { kind: "extras", itemId: Util.toText(it.Id), newRoute: true })
        return
    end if
    get("/Users/" + Util.toText(m.top.server.userId) + "/Items/" + Util.toText(it.Id) + "/SpecialFeatures", { kind: "extras", itemId: Util.toText(it.Id), newRoute: false })
end sub

sub onExtras(r as object)
    if m.item = invalid or r.tag.itemId <> Util.toText(m.item.Id) then return
    if (r.code = 404 or r.code = 405) and not r.tag.newRoute
        get("/Items/" + r.tag.itemId + "/SpecialFeatures?userId=" + Util.toText(m.top.server.userId), { kind: "extras", itemId: r.tag.itemId, newRoute: true })
        return
    end if
    if r.code <> 200
        rowAnswered("extras")
        return
    end if
    Api.rememberRoute(m.top.server, "extras", r.tag.newRoute = true)
    list = []
    ' (the profile's rating limit applies to extras too)
    for each x in Ratings.keep(m.top.server, listOf(r.json))
        if Util.isAA(x) and Util.toText(x.Id) <> "" and list.count() < 30 then list.push(x)
    end for
    Log.line("Cove: extras -> " + Util.toText(list.count()))
    m.extrasList = list
    setRowNodes("extras", m.extrasList)
    rowAnswered("extras")
end sub

' "BehindTheScenes" → "Behind the Scenes"; "" when the server doesn't say
function extraKind(x as object) as string
    k = Util.toText(x.ExtraType)
    names = { "BehindTheScenes": "Behind the Scenes", "DeletedScene": "Deleted Scene", "Featurette": "Featurette", "Interview": "Interview", "Scene": "Scene", "Short": "Short", "Sample": "Sample", "Trailer": "Trailer", "ThemeVideo": "Theme Video", "Clip": "Clip", "Unknown": "" }
    for each n in names
        if LCase(n) = LCase(k) then return names[n]
    end for
    return k
end function

' In the Cove player like a trailer: the film itself isn't touched (no resume point, not marked watched)
sub playExtra(i as integer)
    if i < 0 or i >= m.extrasList.count() then return
    x = m.extrasList[i]
    sub_ = Util.toText(x.Name)
    if sub_ = "" then sub_ = extraKind(x)
    m.top.play = { id: Util.toText(x.Id), title: Util.toText(m.item.Name), subtitle: sub_, start: 0, trailer: true }
end sub

' ---------------------------------------------------------------- series Play All / Shuffle (v1.0 F-17)

' Play All: from S1:E1, or from the next unwatched episode when the series was started
sub playAllMenu()
    nu = m.nextUp
    if nu <> invalid and not (Util.toNumber(nu.ParentIndexNumber) = 1 and Util.toNumber(nu.IndexNumber) = 1)
        o = [{ id: "first", label: "From the Beginning (S1:E1)" }]
        o.push({ id: "next", label: "From the Next Unwatched (S" + Util.toText(nu.ParentIndexNumber) + ":E" + Util.toText(nu.IndexNumber) + ")" })
        openPicker("playall", "Play All", o, "")
        m.picker.wide = true
        return
    end if
    loadSeriesPlay("first")
end sub

' The series' episodes: in order (Play All from the start; the player goes on through the series with
' Up Next), or random (Shuffle, as the library Shuffle: a queue for the player). Rating limit applies.
sub loadSeriesPlay(mode as string)
    if m.item = invalid or m.seriesPlay <> invalid then return
    srv = m.top.server
    uid = Util.toText(srv.userId)
    sid = Util.toText(m.item.Id)
    m.seriesPlay = mode
    m.status.text = "Getting the episodes..."
    if mode = "shuffle"
        path = "/Users/" + uid + "/Items?ParentId=" + sid + "&Recursive=true&IncludeItemTypes=Episode&SortBy=Random&Limit=100&Fields=PrimaryImageAspectRatio&EnableUserData=false&ImageTypeLimit=1&EnableImageTypes=Primary,Backdrop,Thumb"
        get(Ratings.withLimit(srv, path), { kind: "seriesPlay", mode: mode, itemId: sid })
    else
        get(Ratings.withLimit(srv, "/Shows/" + sid + "/Episodes?UserId=" + uid + "&" + Items.fields()), { kind: "seriesPlay", mode: mode, itemId: sid })
    end if
end sub

sub onSeriesPlay(r as object)
    m.seriesPlay = invalid
    m.status.text = ""
    if m.item = invalid or r.tag.itemId <> Util.toText(m.item.Id) then return
    if r.code <> 200
        Log.line("Cove: series play failed: " + Util.toText(Api.describeFailure(r)))
        Toasts.notify(Toasts.failedText("get the episodes"), "info")
        return
    end if
    eps = []
    specials = []
    for each e in Ratings.keep(m.top.server, listOf(r.json))
        if Util.isAA(e) and Util.toText(e.Id) <> ""
            ' (specials, season 0, only when there is nothing else)
            if Util.toNumber(e.ParentIndexNumber) = 0
                specials.push(e)
            else
                eps.push(e)
            end if
        end if
    end for
    if eps.count() = 0 then eps = specials
    Log.line("Cove: series " + Util.toText(r.tag.mode) + " -> " + Util.toText(eps.count()) + " episodes")
    if eps.count() = 0
        Toasts.notify("No episodes to play", "info")
        return
    end if
    if r.tag.mode = "first"
        requestPlay(eps[0], 0)
        return
    end if
    ' Shuffle: the first plays, the others follow as the player's queue (trimmed: it rides in a node field)
    keep = ["Id", "Name", "Type", "SeriesName", "SeriesId", "ParentIndexNumber", "IndexNumber", "ImageTags", "BackdropImageTags", "ParentBackdropItemId", "ParentBackdropImageTags", "ParentThumbItemId", "ParentThumbImageTag", "SeriesPrimaryImageTag"]
    rest = []
    for i = 1 to eps.count() - 1
        o = {}
        for each k in keep
            if eps[i][k] <> invalid then o[k] = eps[i][k]
        end for
        rest.push(o)
    end for
    head = eps[0]
    m.top.play = { id: Util.toText(head.Id), title: Util.toText(m.item.Name), subtitle: Items.episodeLabel(head), start: 0.0, queue: rest }
end sub

' ---------------------------------------------------------------- favourite

' POST / DELETE /Users/{id}/FavoriteItems/{item} (Jellyfin 10.9+: /UserFavoriteItems/{item})
sub toggleFavourite()
    if m.item = invalid then return
    method = "POST"
    if m.isFav then method = "DELETE"
    send(method, "/Users/" + Util.toText(m.top.server.userId) + "/FavoriteItems/" + Util.toText(m.item.Id), { kind: "fav", method: method, newRoute: false })
end sub

sub onFavourite(r as object)
    if r.code = 404 and not r.tag.newRoute
        send(r.tag.method, "/UserFavoriteItems/" + Util.toText(m.item.Id) + "?userId=" + Util.toText(m.top.server.userId), { kind: "fav", method: r.tag.method, newRoute: true })
        return
    end if
    if r.code >= 200 and r.code < 300
        m.isFav = r.tag.method = "POST"
        if m.item.UserData = invalid then m.item.UserData = {}
        m.item.UserData.IsFavorite = m.isFav
        m.top.changed = true
        ' (SC5-10) Play focused after a toggle that worked (a failed one leaves the focus and the flag alone)
        m.focusPlay = true
        buildButtons()
        Toasts.notify(Toasts.favoriteText(Util.toText(m.item.Name), m.isFav), "heart")
    else
        Log.line("Cove: favourite failed: " + Util.toText(Api.describeFailure(r)))
        Toasts.notify(Toasts.failedText("update Favorites"), "info")
    end if
end sub

' POST / DELETE /Users/{id}/PlayedItems/{item} (Jellyfin 10.9+: /UserPlayedItems/{item}); then reload
' * on an episode card: resume / from the beginning / watched / its own page
sub episodeMenu()
    f = m.rows.rowItemFocused
    if f = invalid or f.count() < 2 or m.rows.content = invalid then return
    row = m.rows.content.getChild(f[0])
    if row = invalid or row.rowKind <> "episodes" or f[1] >= m.shownEps.count() then return
    e = m.shownEps[f[1]]
    m.menuEp = e
    o = []
    at = Items.resumeAt(e)
    if at > 30 then o.push({ id: "resume", label: "Resume from " + Playback.clock(at) })
    o.push({ id: "start", label: "Play from the Beginning" })
    if Util.flag(e.UserData, "Played")
        o.push({ id: "unwatched", label: "Mark as Unwatched" })
    else
        o.push({ id: "watched", label: "Mark as Watched" })
    end if
    o.push({ id: "page", label: "Episode Details" })
    openPicker("epmenu", Items.episodeLabel(e), o, "")
end sub

sub toggleWatched()
    if m.item = invalid then return
    markPlayed(Util.toText(m.item.Id), not Util.flag(m.item.UserData, "Played"), Util.toText(m.item.Name))
end sub

sub markPlayed(itemId as string, played as boolean, name = "" as string)
    method = "DELETE"
    if played then method = "POST"
    send(method, "/Users/" + Util.toText(m.top.server.userId) + "/PlayedItems/" + itemId, { kind: "watched", method: method, newRoute: false, itemId: itemId, name: name })
end sub

sub onWatched(r as object)
    if r.code = 404 and not r.tag.newRoute
        send(r.tag.method, "/UserPlayedItems/" + r.tag.itemId + "?userId=" + Util.toText(m.top.server.userId), { kind: "watched", method: r.tag.method, newRoute: true, itemId: r.tag.itemId, name: Util.toText(r.tag.name) })
        return
    end if
    if r.code >= 200 and r.code < 300
        m.top.changed = true
        ' (SC5-10) the page's own ✓ worked: Play focused after the refresh (an episode marked from a row keeps
        ' its focus)
        if m.item <> invalid and Util.toText(r.tag.itemId) = Util.toText(m.item.Id) then m.focusPlay = true
        onRefresh()
        m.status.text = ""
        name = Util.toText(r.tag.name)
        if name = "" and m.item <> invalid then name = Util.toText(m.item.Name)
        Toasts.notify(Toasts.watchedText(name, r.tag.method = "POST"), "check")
    else
        Log.line("Cove: watched change failed: " + Util.toText(Api.describeFailure(r)))
        Toasts.notify(Toasts.failedText("change the watched state"), "info")
    end if
end sub

' ---------------------------------------------------------------- audio, subtitles, quality

function effectiveAudio() as integer
    if m.opts.audio >= 0 then return m.opts.audio
    ' (v1.1) the track the player will start with (series language, account language, no commentary)
    if m.opts.startAudio <> invalid and m.opts.startAudio >= 0 then return m.opts.startAudio
    return m.opts.defaultAudio
end function

' (BG-4) GET /Users/{id}: the account's audio preference for the session (a failure counts as "none", as in the
' player), then the start track again
sub onUserAudio(r as object)
    json = invalid
    if r.code = 200 then json = r.json
    if r.code <> 200 then Log.line("Cove: user settings -> " + Util.toText(r.code))
    if Tracks.serverAudioPref(m.top.server) = invalid then Tracks.rememberServerAudio(m.top.server, json)
    ' (v1.5 details) ⋯ More → Refresh Metadata for administrators only; (v1.5.2 CS-1) not under a kids limit
    m.isAdmin = Ratings.effectiveAdmin(m.top.server, DetailsHead.isAdminUser(json))
    if m.item = invalid or m.tracks = invalid then return
    t = Util.toText(m.item.Type)
    if t = "Series" or t = "BoxSet" then return
    m.opts.startAudio = startAudioHere()
    ' (the Audio pill shows the track the player will start with)
    if m.opts.audio < 0 then buildMediaRow()
end sub

' (v1.1) What the player picks when no audio is chosen here (PlayerScreen chooseStartAudio)
function startAudioHere() as integer
    seriesLang = Prefs.seriesAudioLang(Util.toText(m.item.SeriesId))
    return Tracks.startAudio(m.tracks, Tracks.wantedAudio(m.tracks, seriesLang, Tracks.serverAudioPref(m.top.server)))
end function

' ---------------------------------------------------------------- (v1.5 details) the media line

' Placeholder pills where the media line goes, until the item answers (playable titles only)
sub drawMediaSkeleton()
    g = m.top.findNode("mediaRow")
    g.removeChildrenIndex(g.getChildCount(), 0)
    m.mediaPills = []
    if not m.hasMedia then return
    x = 0
    for each w in [220, 360, 300]
        bar = g.createChild("Poster")
        bar.uri = "pkg:/images/ui/white_pill.9.png"
        bar.blendColor = skeletonColor()
        bar.width = w
        bar.height = 40
        bar.translation = [x, 6]
        x = x + w + 28
    end for
end sub

' "Video 1080p H264   Audio [English EAC3 5.1 (Default) ⌄]   Subtitles [Romanian (SRT) ⌄]": a grey name, then the
' value as plain text or, when there is a choice, a flat pill with a chevron (OK opens the list in place). Audio is a
' pill with two or more tracks, Subtitles whenever the file has any (Off is a choice), Video when there are several
' versions (files). Track names are shortened until the line fits the column.
sub buildMediaRow()
    g = m.top.findNode("mediaRow")
    g.removeChildrenIndex(g.getChildCount(), 0)
    m.mediaPills = []
    if not m.hasMedia or m.item = invalid or m.tracks = invalid then return
    for each maxChars in [32, 24, 16]
        g.removeChildrenIndex(g.getChildCount(), 0)
        m.mediaPills = []
        x = mediaParts(g, maxChars)
        if x <= m.colW then exit for
    end for
    if m.mediaIdx >= m.mediaPills.count() then m.mediaIdx = 0
    if m.state = "media" and m.mediaPills.count() = 0 then m.state = "buttons"
    paintMedia()
end sub

' Builds the line's parts into g; returns its width
function mediaParts(g as object, maxChars as integer) as integer
    x = 0
    src = MediaInfo.findSource(m.item, Util.toText(m.opts.sourceId))
    vt = DetailsHead.videoLabel(src)
    multiVersion = m.versions <> invalid and m.versions.count() > 1
    if vt = "" and multiVersion then vt = Tracks.versionLabel(m.versions, m.opts.sourceId)
    if vt <> "" then x = mediaPart(g, x, "video", "Video", vt, multiVersion)
    if m.tracks.audio.count() > 0
        at = DetailsHead.trackPill(Tracks.audioLabel(m.tracks, effectiveAudio()), maxChars)
        x = mediaPart(g, x, "audio", "Audio", at, m.tracks.audio.count() > 1)
    end if
    if m.tracks.subs.count() > 0
        st = DetailsHead.trackPill(Tracks.subLabel(m.tracks, m.opts.sub), maxChars)
        x = mediaPart(g, x, "subs", "Subtitles", st, true)
    end if
    return x - 36
end function

function mediaPart(g as object, x as integer, id as string, name as string, value as string, isPill as boolean) as integer
    nameLbl = g.createChild("Label")
    nameLbl.font = mediaFont()
    nameLbl.text = name
    nameLbl.color = "0xFFFFFF9E"
    nameLbl.height = 52
    nameLbl.vertAlign = "center"
    nameLbl.translation = [x, 0]
    x = x + Int(nameLbl.boundingRect().width) + 14
    valueLbl = g.createChild("Label")
    valueLbl.font = mediaFont()
    valueLbl.text = value
    valueLbl.color = "0xFFFFFFEB"
    valueLbl.height = 52
    valueLbl.vertAlign = "center"
    tw = Int(valueLbl.boundingRect().width)
    if not isPill
        valueLbl.translation = [x, 0]
        return x + tw + 36
    end if
    w = 22 + tw + 12 + 24 + 18
    ' (the pill goes under the text: inserted just before it)
    bg = createObject("roSGNode", "Poster")
    bg.uri = "pkg:/images/ui/flat_pill_52.9.png"
    bg.width = w
    bg.height = 52
    bg.translation = [x, 0]
    g.insertChild(bg, g.getChildCount() - 1)
    valueLbl.translation = [x + 22, 0]
    chev = g.createChild("Poster")
    chev.uri = "pkg:/images/ui/icon_chevron_28.png"
    chev.width = 24
    chev.height = 24
    chev.translation = [x + 22 + tw + 12, 14]
    m.mediaPills.push({ id: id, bg: bg, lbl: valueLbl, chev: chev, x: x, w: w, speech: name + ", " + value })
    return x + w + 36
end function

function mediaFont() as object
    f = createObject("roSGNode", "Font")
    f.uri = "font:MediumSystemFontFile"
    f.size = 24
    return f
end function

' Focus on the media line: the focused pill solid white with dark text and chevron, the others the faint fill
sub paintMedia()
    focused = m.state = "media" and m.picker = invalid and m.menu = invalid
    for i = 0 to m.mediaPills.count() - 1
        p = m.mediaPills[i]
        on = focused and i = m.mediaIdx
        if on
            p.bg.opacity = 1.0
            p.lbl.color = m.global.theme.onFocus
            p.chev.blendColor = m.global.theme.onFocus
        else
            p.bg.opacity = 0.12
            p.lbl.color = "0xFFFFFFEB"
            p.chev.blendColor = "0xFFFFFFFF"
        end if
    end for
    if focused and m.mediaIdx < m.mediaPills.count() and Speak.isOn()
        key = "m" + m.mediaIdx.toStr() + m.mediaPills[m.mediaIdx].speech
        if key <> m.spokenKey
            m.spokenKey = key
            Speak.say(Speak.clean(m.mediaPills[m.mediaIdx].speech) + ", menu, button" + Speak.position(m.mediaIdx, m.mediaPills.count()))
        end if
    end if
end sub

sub enterMedia()
    if m.mediaPills.count() = 0 then return
    m.state = "media"
    if m.mediaIdx >= m.mediaPills.count() then m.mediaIdx = 0
    m.btnKeys.setFocus(true)
    drawButtons()
end sub

' OK on a pill: its list in place, under the pill
sub openTrackList(id as string)
    anchor = [m.colX, 110]
    for each p in m.mediaPills
        if p.id = id then anchor = [m.colX + p.x, 110 + m.top.findNode("mediaRow").translation[1] + 60]
    end for
    m.menuBack = "media"
    if id = "audio"
        o = []
        cur = effectiveAudio()
        for each a in m.tracks.audio
            o.push({ id: a.index.toStr(), label: a.label, checked: a.index = cur })
        end for
        openMenu("audio", "Audio", o, cur.toStr(), anchor, invalid, 620)
    else if id = "subs"
        o = [{ id: "-1", label: "Off", checked: m.opts.sub < 0 }]
        for each s in m.tracks.subs
            o.push({ id: s.index.toStr(), label: s.label, checked: s.index = m.opts.sub })
        end for
        openMenu("subs", "Subtitles", o, m.opts.sub.toStr(), anchor, invalid, 720)
    else if id = "video"
        openVersionList(anchor)
    end if
end sub

sub openVersionList(anchor as object)
    if m.versions = invalid or m.versions.count() < 2 then return
    cur = m.opts.sourceId
    if cur = "" then cur = m.versions[0].id
    o = []
    for each v in m.versions
        o.push({ id: v.id, label: v.label, checked: v.id = cur })
    end for
    openMenu("version", "Version", o, cur, anchor, invalid, 720)
end sub

sub openQualityList(anchor as object)
    o = []
    cur = m.opts.maxBitrate.toStr()
    for each q in Tracks.qualities()
        o.push({ id: q.id, label: q.label, checked: q.id = cur })
    end for
    openMenu("quality", "Quality", o, cur, anchor, invalid, 560)
end sub

' A choice from a track list, kept for this playback (as the old CC menu's choice): the player gets it in options
sub applyTrackChoice(purpose as string, id as string)
    if purpose = "version"
        ' another file: its own audio and subtitle tracks, back to their defaults
        m.opts.sourceId = id
        m.tracks = Tracks.fromItem(m.item, id)
        m.opts.audio = -1
        m.opts.sub = -1
        m.opts.burn = false
        m.opts.defaultAudio = Tracks.defaultAudio(m.tracks)
        m.opts.startAudio = startAudioHere()
        s = Tracks.defaultSub(m.tracks, "")
        if s >= 0
            m.opts.sub = s
            m.opts.burn = not Tracks.findSub(m.tracks, s).isText
        end if
        showAbout(m.item)
    else if purpose = "audio"
        m.opts.audio = id.toInt()
    else if purpose = "subs"
        v = id.toInt()
        s = Tracks.findSub(m.tracks, v)
        m.opts.subPicked = true
        m.opts.sub = v
        m.opts.burn = s <> invalid and not s.isText
    else if purpose = "quality"
        m.opts.maxBitrate = id.toInt()
        Toasts.notify("Quality: " + Tracks.qualityLabel(m.opts.maxBitrate), "check")
    end if
    Log.line("Cove: details " + Util.toText(purpose) + " -> " + Util.toText(id))
    buildMediaRow()
    layoutHeader()
end sub

' ---------------------------------------------------------------- (v1.5 details) menus in place (DetailsMenu)

sub openMenu(purpose as string, title as string, options as object, selectedId as string, anchor as object, heading as dynamic, width as integer)
    closeMenu()
    p = createObject("roSGNode", "DetailsMenu")
    p.purpose = purpose
    p.title = title
    p.panelWidth = width
    p.anchor = anchor
    if heading <> invalid then p.heading = heading
    p.selectedId = selectedId
    p.options = options
    p.observeField("chosen", "onMenuChosen")
    p.observeField("cancelled", "onMenuCancelled")
    m.top.appendChild(p)
    m.menu = p
    paintMedia()
    drawButtons()
    p.setFocus(true)
end sub

sub closeMenu()
    if m.menu <> invalid
        m.menu.unobserveField("chosen")
        m.menu.unobserveField("cancelled")
        m.top.removeChild(m.menu)
        m.menu = invalid
        m.spokenKey = ""
    end if
end sub

' Back to the pill or button the menu came from
sub leaveMenu()
    closeMenu()
    if m.menuBack = "media" and m.mediaPills.count() > 0
        enterMedia()
    else
        focusPlayButton()
    end if
end sub

sub onMenuCancelled()
    leaveMenu()
end sub

sub onMenuChosen(ev as object)
    c = ev.getData()
    purpose = Util.toText(c.purpose)
    id = Util.toText(c.id)
    if purpose = "audio" or purpose = "subs" or purpose = "version" or purpose = "quality"
        leaveMenu()
        applyTrackChoice(purpose, id)
        return
    end if
    if purpose = "more"
        useMore(id)
        return
    end if
    if purpose = "coll" or purpose = "list"
        leaveMenu()
        addToList(purpose, id)
        return
    end if
    if purpose = "gocoll"
        leaveMenu()
        for each b in m.includedList
            if Util.toText(b.Id) = id then m.top.openItem = { id: "open", itemId: id, itemType: Util.toText(b.Type), collectionType: "", title: Util.toText(b.Name) }
        end for
        return
    end if
    leaveMenu()
end sub

' ---------------------------------------------------------------- (v1.5 details) ⋯ More

' The panel next to the ⋯ button: a small poster, the title and the year, then Emby's entries that make sense on a
' TV (DetailsHead.moreEntries: no Download, Convert, Edit, Identify or Delete)
sub openMoreMenu()
    if m.item = invalid then return
    it = m.item
    t = Util.toText(it.Type)
    seasonTitle = Util.toText(it.SeasonName)
    if seasonTitle = "" and it.ParentIndexNumber <> invalid then seasonTitle = "Season " + Util.toText(it.ParentIndexNumber)
    entries = DetailsHead.moreEntries({ itemType: t, isFav: m.isFav, played: Util.flag(it.UserData, "Played"), isAdmin: m.isAdmin, collections: m.includedList.count(), versions: versionCount(), hasSeries: Util.toText(it.SeriesId) <> "", hasSeason: Util.toText(it.SeasonId) <> "" and seasonTitle <> "", seasonLabel: NavUtil.seasonButtonText(seasonTitle, it.ParentIndexNumber).replace("Go to ", "") })
    o = []
    for each e in entries
        label = e.label
        if e.id = "quality" then label = "Quality: " + Tracks.qualityLabel(m.opts.maxBitrate)
        if e.id = "version" then label = "Version: " + Tracks.versionLabel(m.versions, m.opts.sourceId)
        o.push({ id: e.id, label: label, icon: moreIcon(e.icon), divider: Util.flag(e, "divider") })
    end for
    sub_ = Util.toText(it.ProductionYear)
    if t = "Episode"
        sub_ = Util.toText(it.SeriesName)
        ep = DetailsHead.episodeLine(it)
        if ep <> "" then sub_ = ep
    end if
    title = Util.toText(it.Name)
    if t = "Episode" and Util.toText(it.SeriesName) <> "" then title = Util.toText(it.SeriesName)
    heading = { poster: Items.poster(m.top.server, it, 140), title: title, sub: sub_ }
    m.menuBack = "buttons"
    openMenu("more", "More", o, "", moreAnchor(), heading, 560)
end sub

function versionCount() as integer
    if m.versions = invalid then return 0
    return m.versions.count()
end function

function moreIcon(name as string) as string
    if name = "listadd" or name = "refresh" or name = "folder" or name = "tv" or name = "quality" then return "pkg:/images/ui/icon_dt_" + name + "_28.png"
    return "pkg:/images/ui/icon_" + name + "_28.png"
end function

' Under the ⋯ button, its left edge at the button's (moved left / up by the menu when it would leave the screen)
function moreAnchor() as object
    i = NavUtil.indexOfId(m.btns, "more")
    x = m.colX
    if i >= 0 and i < m.btnGroup.getChildCount() then x = m.colX + m.btnGroup.translation[0] + m.btnGroup.getChild(i).translation[0]
    return [x, 110 + m.btnY + 69 + 12]
end function

sub useMore(id as string)
    it = m.item
    if id = "fav"
        leaveMenu()
        toggleFavourite()
    else if id = "watched"
        leaveMenu()
        toggleWatched()
    else if id = "info"
        leaveMenu()
        openPlaybackInfo()
    else if id = "quality"
        openQualityList(moreAnchor())
    else if id = "version"
        openVersionList(moreAnchor())
    else if id = "addcoll"
        closeMenu()
        m.status.text = "Getting your collections..."
        get("/Users/" + Util.toText(m.top.server.userId) + "/Items?IncludeItemTypes=BoxSet&Recursive=true&SortBy=SortName&SortOrder=Ascending&Fields=ProductionYear&EnableImageTypes=Primary&ImageTypeLimit=1&Limit=300" + Items.noCount(), { kind: "lists", which: "coll", itemId: Util.toText(it.Id) })
        ' (SC5-9) ⋯ closed: Play focused while the list loads (and when it fails)
        focusPlayButton()
    else if id = "addlist"
        closeMenu()
        m.status.text = "Getting your playlists..."
        get("/Users/" + Util.toText(m.top.server.userId) + "/Items?IncludeItemTypes=Playlist&Recursive=true&SortBy=SortName&SortOrder=Ascending&Limit=300" + Items.noCount(), { kind: "lists", which: "list", itemId: Util.toText(it.Id) })
        ' (SC5-9) ⋯ closed: Play focused while the list loads (and when it fails)
        focusPlayButton()
    else if id = "gocoll"
        if m.includedList.count() = 1
            leaveMenu()
            b = m.includedList[0]
            m.top.openItem = { id: "open", itemId: Util.toText(b.Id), itemType: Util.toText(b.Type), collectionType: "", title: Util.toText(b.Name) }
        else
            o = []
            for each b in m.includedList
                o.push({ id: Util.toText(b.Id), label: Util.toText(b.Name), icon: moreIcon("folder") })
            end for
            openMenu("gocoll", "Collections", o, "", moreAnchor(), invalid, 560)
        end if
    else if id = "series" or id = "season"
        leaveMenu()
        o = { itemId: Util.toText(it.SeriesId), itemType: "Series", title: Util.toText(it.SeriesName) }
        if id = "season" then o.seasonId = Util.toText(it.SeasonId)
        m.top.openItem = o
    else if id = "refresh"
        leaveMenu()
        send("POST", DetailsHead.refreshPath(Util.toText(it.Id)), { kind: "refreshMeta", name: Util.toText(it.Name) })
    else
        leaveMenu()
    end if
end sub

' The user's collections or playlists answered: New ... first, then each one (OK adds the title to it)
sub onLists(r as object)
    m.status.text = ""
    if m.item = invalid or Util.toText(r.tag.itemId) <> Util.toText(m.item.Id) then return
    which = Util.toText(r.tag.which)
    ' (SC5-9) the page is covered (a person, a title, the player): the list doesn't open over it
    if not m.top.isInFocusChain() or m.picker <> invalid or m.menu <> invalid or m.textPanel <> invalid
        Log.line("Cove: lists (" + Util.toText(which) + ") answered while the page is covered or busy: dropped")
        return
    end if
    if r.code <> 200
        Log.line("Cove: lists (" + Util.toText(which) + ") failed: " + Util.toText(Api.describeFailure(r)))
        Toasts.notify(Toasts.failedText("get the list"), "info")
        return
    end if
    title = "Add to Collection"
    newLabel = "New Collection..."
    if which = "list"
        title = "Add to Playlist"
        newLabel = "New Playlist..."
    end if
    o = [{ id: "new", label: newLabel, icon: "pkg:/images/ui/icon_plus_28.png" }]
    m.listNames = {}
    first = true
    for each x in listOf(r.json)
        xid = Util.toText(Util.field(x, "Id"))
        if xid <> "" and xid <> Util.toText(m.item.Id)
            n = Util.toText(Util.field(x, "Name"))
            m.listNames[xid] = n
            o.push({ id: xid, label: n, divider: first })
            first = false
        end if
    end for
    Log.line("Cove: " + Util.toText(which) + " lists -> " + Util.toText(o.count() - 1))
    m.menuBack = "buttons"
    openMenu(which, title, o, "", moreAnchor(), invalid, 620)
end sub

' A collection / playlist was picked: add the title (New: the name from the keyboard first)
sub addToList(which as string, id as string)
    if m.item = invalid then return
    itemId = Util.toText(m.item.Id)
    uid = Util.toText(m.top.server.userId)
    if id = "new"
        title = "New Collection"
        if which = "list" then title = "New Playlist"
        askListName(which, title)
        return
    end if
    name = ""
    if m.listNames <> invalid and m.listNames[id] <> invalid then name = m.listNames[id]
    if which = "coll"
        send("POST", DetailsHead.addToCollectionPath(id, itemId), { kind: "listAdd", which: which, name: name })
    else
        send("POST", DetailsHead.addToPlaylistPath(id, itemId, uid), { kind: "listAdd", which: which, name: name })
    end if
end sub

' The Roku keyboard for a new collection's / playlist's name
sub askListName(which as string, title as string)
    m.kbFor = which
    d = createObject("roSGNode", "StandardKeyboardDialog")
    d.title = title
    d.message = ["The name of the new " + LCase(title.replace("New ", "")) + "."]
    d.text = ""
    d.buttons = ["OK", "Cancel"]
    d.observeField("buttonSelected", "onListNameButton")
    d.observeField("wasClosed", "onListNameClosed")
    m.top.getScene().dialog = d
    m.kbTimer.control = "start"
end sub

sub focusKeyboard()
    d = m.top.getScene().dialog
    if d <> invalid then d.setFocus(true)
end sub

sub onListNameButton()
    d = m.top.getScene().dialog
    if d = invalid then return
    ok = d.buttonSelected = 0
    text = Util.toText(d.text).trim()
    d.unobserveField("buttonSelected")
    d.unobserveField("wasClosed")
    d.close = true
    enterButtons(false)
    if not ok or text = "" or m.item = invalid then return
    itemId = Util.toText(m.item.Id)
    if m.kbFor = "coll"
        send("POST", DetailsHead.newCollectionPath(text, itemId), { kind: "listAdd", which: "coll", name: text, created: true })
    else
        send("POST", DetailsHead.newPlaylistPath(text, itemId, Util.toText(m.top.server.userId)), { kind: "listAdd", which: "list", name: text, created: true })
    end if
end sub

sub onListNameClosed()
    d = m.top.getScene().dialog
    if d <> invalid
        d.unobserveField("buttonSelected")
        d.unobserveField("wasClosed")
    end if
    enterButtons(false)
end sub

sub onListAdd(r as object)
    which = Util.toText(r.tag.which)
    kindWord = "collection"
    if which = "list" then kindWord = "playlist"
    if r.code >= 200 and r.code < 300
        name = Util.toText(r.tag.name)
        if Util.flag(r.tag, "created")
            Toasts.notify("Created " + kindWord + " " + Toasts.quoted(name), "check")
        else
            Toasts.notify("Added to " + Toasts.quoted(name), "check")
        end if
        m.top.changed = true
        ' (Included In and ⋯ More → Go to Collection follow)
        if which = "coll" and m.item <> invalid and Util.toText(m.item.Type) <> "Episode" then loadIncludedIn(m.item)
    else
        Log.line("Cove: add to " + Util.toText(kindWord) + " failed: " + Util.toText(Api.describeFailure(r)))
        Toasts.notify(Toasts.failedText("add it to the " + kindWord), "info")
    end if
end sub

sub onRefreshMeta(r as object)
    if r.code >= 200 and r.code < 300
        Toasts.notify("Refreshing metadata for " + Toasts.quoted(Util.toText(r.tag.name)), "check")
    else
        Log.line("Cove: refresh metadata failed: " + Util.toText(Api.describeFailure(r)))
        Toasts.notify(Toasts.failedText("refresh the metadata"), "info")
    end if
end sub

' ⋯ More → Playback Info: the file, its container and every track, and what this playback will use
sub openPlaybackInfo()
    if m.item = invalid or m.textPanel <> invalid then return
    src = MediaInfo.findSource(m.item, Util.toText(m.opts.sourceId))
    lines = []
    if src = invalid
        lines.push("The server sent no media information for this title.")
    else
        path = Util.toText(src.Path)
        if path = "" then path = Util.toText(m.item.Path)
        if path <> "" then lines.push("File: " + path)
        fl = []
        if Util.toText(src.Container) <> "" then fl.push(UCase(Util.toText(src.Container)))
        sz = MediaInfo.sizeText(src.Size)
        if sz <> "" then fl.push(sz)
        br = MediaInfo.rateText(src.Bitrate)
        if br <> "" then fl.push(br)
        if fl.count() > 0 then lines.push("Container: " + Util.join(fl, " · "))
        for each v in MediaInfo.streamsOfType(src, "Video")
            lines.push("Video: " + MediaInfo.videoLine(v))
        end for
        for each a in MediaInfo.streamsOfType(src, "Audio")
            lines.push("Audio: " + MediaInfo.trackLine(a))
        end for
        for each s in MediaInfo.streamsOfType(src, "Subtitle")
            lines.push("Subtitles: " + MediaInfo.trackLine(s))
        end for
    end if
    if m.tracks <> invalid
        lines.push("This playback: audio " + Tracks.audioLabel(m.tracks, effectiveAudio()) + ", subtitles " + Tracks.subLabel(m.tracks, m.opts.sub) + ", quality " + Tracks.qualityLabel(m.opts.maxBitrate))
    end if
    p = createObject("roSGNode", "TextPanel")
    p.heading = "Playback Info"
    p.text = Util.join(lines, chr(10))
    p.observeField("closed", "onInfoClosed")
    m.top.appendChild(p)
    m.textPanel = p
    p.setFocus(true)
end sub

sub onInfoClosed()
    if m.textPanel <> invalid
        m.textPanel.unobserveField("closed")
        m.top.removeChild(m.textPanel)
        m.textPanel = invalid
    end if
    enterButtons(false)
end sub

sub openPicker(purpose as string, title as string, options as object, selectedId as string)
    closePicker()
    p = createObject("roSGNode", "Picker")
    p.purpose = purpose
    p.title = title
    p.selectedId = selectedId
    p.options = options
    p.observeField("chosen", "onPicked")
    p.observeField("cancelled", "onPickerCancelled")
    m.top.appendChild(p)
    m.picker = p
    p.setFocus(true)
end sub

sub closePicker()
    if m.picker <> invalid
        m.picker.unobserveField("chosen")
        m.picker.unobserveField("cancelled")
        m.top.removeChild(m.picker)
        m.picker = invalid
        ' (Audio Guide: the focus is said again where it lands)
        m.spokenKey = ""
    end if
end sub

sub onPickerCancelled()
    p = m.picker
    closePicker()
    if p <> invalid and (p.purpose = "season" or p.purpose = "slang" or p.purpose = "seasonmenu")
        enterSeason()
    else if p <> invalid and p.purpose = "epmenu"
        m.state = "rows"
        m.rows.setFocus(true)
    else
        focusPlayButton()
    end if
end sub

sub onPicked(ev as object)
    c = ev.getData()
    if c.purpose = "epmenu"
        e = m.menuEp
        closePicker()
        m.state = "rows"
        m.rows.setFocus(true)
        if e = invalid then return
        if c.id = "resume"
            requestPlay(e, Items.resumeAt(e))
        else if c.id = "start"
            requestPlay(e, 0)
        else if c.id = "watched" or c.id = "unwatched"
            markPlayed(Util.toText(e.Id), c.id = "watched", Util.toText(e.Name))
        else if c.id = "page"
            m.top.openItem = { id: "open", itemId: Util.toText(e.Id), itemType: "Episode", collectionType: "", title: Util.toText(e.Name) }
        end if
        return
    end if
    if c.purpose = "trailer"
        closePicker()
        enterButtons(false)
        playTrailer(c.id.toInt())
        return
    end if
    if c.purpose = "playall"
        closePicker()
        enterButtons(false)
        if c.id = "next" and m.nextUp <> invalid
            start = Items.resumeAt(m.nextUp)
            if start <= 30 then start = 0
            requestPlay(m.nextUp, start)
        else
            loadSeriesPlay("first")
        end if
        return
    end if
    if c.purpose = "seasonmenu"
        closePicker()
        enterSeason()
        useSeasonMenu(c.id)
        return
    end if
    if c.purpose = "season"
        closePicker()
        selectSeason(c.id.toInt(), true)
        m.jumpToEpisodes = false
        enterSeason()
    else if c.purpose = "slang"
        Prefs.setSeriesSubLang(subPrefKey(), c.id)
        closePicker()
        enterSeason()
    end if
end sub

' ---------------------------------------------------------------- series: seasons, episodes, next up

sub loadNextUp()
    srv = m.top.server
    ' (BG-5) Settings → Home → Include rewatching (Jellyfin), as Home's Next Up row; no date cutoff here
    nuq = HomeLayout.nextUpQuery(Servers.isJellyfin(srv), Prefs.nextUpRewatch(), "")
    ' (SC5-5) the profile's rating limit on every episode query of the page
    get(Ratings.withLimit(srv, "/Shows/NextUp?SeriesId=" + Util.toText(m.item.Id) + "&UserId=" + Util.toText(srv.userId) + "&Limit=1" + nuq + "&" + Items.fields()), { kind: "nextUp" })
end sub

sub onNextUp(json as dynamic)
    m.nextUpPending = false
    ' (SC5-5) an episode above the limit (a TV-MA special in a TV-PG show) isn't offered as Play
    list = Ratings.keep(m.top.server, listOf(json))
    m.nextUp = invalid
    if list.count() > 0 then m.nextUp = list[0]
    buildButtons()
    ' (SP-10) the seasons came first and waited: one season load, on the Next Up season
    if m.seasonWaiting
        m.seasonWaiting = false
        m.seasonWait.control = "stop"
        if not m.seasonByUser
            detailsMark("Next Up answered, episodes of season index " + defaultSeasonIndex().toStr())
            selectSeason(defaultSeasonIndex(), false)
        end if
        return
    end if
    ' open on the season of the next episode, unless the user picked one
    if m.nextUp <> invalid and not m.seasonByUser and m.seasonList.count() > 0
        i = seasonIndexOf(Util.toText(m.nextUp.SeasonId))
        if i >= 0 and i <> m.seasonIndex then selectSeason(i, false)
    end if
end sub

function seasonIndexOf(id as string) as integer
    for i = 0 to m.seasonList.count() - 1
        if Util.toText(m.seasonList[i].Id) = id then return i
    end for
    return -1
end function

sub onSeasons(json as object)
    m.seasonList = listOf(json)
    ' (SP-9) "rows ready" now waits for the episodes instead
    if m.seasonList.count() > 0 and not m.rowsTimed then m.rowWait["episodes"] = true
    if m.rowWait.doesExist("seasons") then m.rowWait.delete("seasons")
    if m.seasonList.count() = 0
        rebuildRows()
        return
    end if
    i = defaultSeasonIndex()
    ' opened with "Go to Season": that season, with the focus on its episodes
    if m.top.seasonId <> ""
        k = seasonIndexOf(m.top.seasonId)
        if k >= 0
            m.focusEpisodes = true
            selectSeason(k, true)
            return
        end if
    end if
    ' (v1.1.1 SP-10) Next Up still on its way: wait for it (at most 0.8 s) instead of loading season 1 first
    if m.nextUpPending and m.nextUp = invalid and not m.seasonByUser
        m.seasonWaiting = true
        m.seasonWait.control = "start"
        return
    end if
    selectSeason(i, false)
end sub

' The season to open: the Next Up episode's, else the first
function defaultSeasonIndex() as integer
    if m.nextUp <> invalid
        k = seasonIndexOf(Util.toText(m.nextUp.SeasonId))
        if k >= 0 then return k
    end if
    return 0
end function

' (SP-10) Next Up didn't answer in time: the first season now (onNextUp still moves to its season later)
sub onSeasonWait()
    if not m.seasonWaiting then return
    m.seasonWaiting = false
    if not m.seasonByUser and m.seasonList.count() > 0
        detailsMark("Next Up late (0.8 s), episodes of season index " + defaultSeasonIndex().toStr())
        selectSeason(defaultSeasonIndex(), false)
    end if
end sub

sub selectSeason(i as integer, byUser as boolean)
    if i <> m.seasonIndex then m.showAllEps = false
    m.seasonIndex = i
    if byUser then m.seasonByUser = true
    m.jumpToEpisodes = byUser
    loadEpisodes(i)
    rebuildRows()
end sub

sub loadEpisodes(index as integer)
    if index < 0 or index >= m.seasonList.count() then return
    m.seasonGen = m.seasonGen + 1
    s = m.seasonList[index]
    srv = m.top.server
    get(Ratings.withLimit(srv, "/Shows/" + Util.toText(m.item.Id) + "/Episodes?SeasonId=" + Util.toText(s.Id) + "&UserId=" + Util.toText(srv.userId) + "&" + Items.fields()), { kind: "episodes", gen: m.seasonGen })
end sub

sub onEpisodes(json as object)
    ' (SC5-5) the season row follows the profile's limit, as Play All does
    m.episodeList = Ratings.keep(m.top.server, listOf(json))
    m.episodesSeason = m.seasonIndex
    buildEpisodeNodes()
    if m.rowWait.doesExist("episodes") then m.rowWait.delete("episodes")
    target = seriesTarget()
    if target <> invalid then loadEpisodeStreams(target)
    if m.nextUp = invalid then buildButtons()
    rebuildRows()
end sub

' ---------------------------------------------------------------- rows

' Rows in order: the chosen season's episodes (series; the season pill above it picks the season),
' Cast & Crew, More Like This. Rebuilt when data arrives; the focus stays on the same row and item.
' (v1.2 SP-9) Answers only ask for a rebuild: one runs 0.05 s after the last of a burst (rowsTimer), and it
' reuses each list's nodes, built once when the list arrived (setRowNodes), instead of making them again.
sub rebuildRows()
    m.rowsTimer.control = "stop"
    m.rowsTimer.control = "start"
end sub

sub onRowsTimer()
    rebuildRowsNow()
end sub

' (SP-9) A list's cards, built once: kind = "box", "extras", "cast", "included", "similar"
sub setRowNodes(kind as string, list as object)
    srv = m.top.server
    nodes = []
    for each x in list
        if kind = "cast"
            nodes.push(Items.personNode(srv, x))
        else if kind = "extras"
            n = Items.node(srv, x, true)
            n.title = Util.toText(x.Name)
            n.episode = extraKind(x)
            rt = ""
            if x.RunTimeTicks <> invalid then rt = Int(x.RunTimeTicks / 600000000).toStr() + "m"
            n.addFields({ kind: "episode", runtime: rt })
            n.overview = ""
            nodes.push(n)
        else
            nodes.push(Items.node(srv, x, false))
        end if
    end for
    m.rowNodes[kind] = nodes
    m.rowGen = m.rowGen + 1
    m.rowGens[kind] = m.rowGen
end sub

' (SP-9) The season's episode cards, built once per answer (and again only if the description setting changed)
sub buildEpisodeNodes()
    srv = m.top.server
    m.epDesc = Prefs.showEpisodeDescription()
    m.epNodeById = {}
    for each e in m.episodeList
        n = Items.node(srv, e, true)
        n.title = Util.toText(e.Name)
        n.episode = "Episode " + Util.toText(e.IndexNumber)
        rt = ""
        if e.RunTimeTicks <> invalid then rt = Int(e.RunTimeTicks / 600000000).toStr() + "m"
        n.addFields({ kind: "episode", runtime: rt })
        ' Settings → Libraries → Show episode descriptions
        if not m.epDesc then n.overview = ""
        m.epNodeById[Util.toText(e.Id)] = n
    end for
    m.rowGen = m.rowGen + 1
    m.rowGens["episodes"] = m.rowGen
end sub

' (SP-9) Which first answers the page still waits for before "rows ready" (once per page)
sub rowAnswered(kind as string)
    if m.rowWait.doesExist(kind) then m.rowWait.delete(kind)
    rebuildRows()
end sub

sub rebuildRowsNow()
    m.rowsTimer.control = "stop"
    if m.item = invalid then return
    buildRowsContent()
    if not m.rowsTimed and m.rowWait.count() = 0
        m.rowsTimed = true
        n = 0
        if m.rows.content <> invalid and m.rows.visible then n = m.rows.content.getChildCount()
        detailsMark("rows ready (" + n.toStr() + " rows, " + m.rowBuilds.toStr() + " builds)")
    end if
end sub

sub buildRowsContent()
    keepKind = ""
    keepItem = 0
    f = m.rows.rowItemFocused
    ' (rowItemFocused is an empty array until the list has content)
    if f <> invalid and f.count() >= 2 and m.rows.content <> invalid
        r = m.rows.content.getChild(f[0])
        if r <> invalid
            keepKind = r.rowKind
            keepItem = f[1]
        end if
    end if
    if m.epDesc <> invalid and m.epDesc <> Prefs.showEpisodeDescription() then buildEpisodeNodes()
    m.shownEps = shownEpisodes()
    specs = []
    if m.shownEps.count() > 0
        eps = []
        for each e in m.shownEps
            n = m.epNodeById[Util.toText(e.Id)]
            if n <> invalid then eps.push(n)
        end for
        if eps.count() > 0 then specs.push({ kind: "episodes", title: "", nodes: eps, size: [516, 426], label: false })
    end if
    ' a collection: its titles, in release order
    addRowSpec(specs, "box", "In This Collection", [276, 466])
    ' (v1.0 F-9) extras, as landscape cards like the episodes
    addRowSpec(specs, "extras", "Extras", [516, 426])
    ' Settings → Libraries → Cast & Crew: Normal / Large
    castSize = [180, 296]
    if Prefs.castLarge() then castSize = [236, 356]
    addRowSpec(specs, "cast", "Cast & Crew", castSize)
    addRowSpec(specs, "included", "Included In", [276, 466])
    addRowSpec(specs, "similar", "More Like This", [276, 466])
    ' the season / subtitle pills sit above the episodes, like the Mac's "Season 1 ⌃" header
    hasBar = Util.toText(m.item.Type) = "Series" and m.seasonList.count() > 0
    m.seasonBar.visible = hasBar
    if hasBar
        m.rows.translation = [0, 84]
        drawSeasonBar()
    else
        m.rows.translation = [0, 0]
    end if
    if specs.count() = 0
        m.rows.visible = false
        m.rowsSig = ""
        return
    end if
    ' (SP-9) the same rows with the same cards: nothing to rebuild (the focus stays where it is)
    sig = ""
    for each sp in specs
        g = m.rowGens[sp.kind]
        if g = invalid then g = 0
        sig = sig + sp.kind + ":" + g.toStr() + ":" + sp.nodes.count().toStr() + ":" + sp.size[0].toStr() + ";"
    end for
    if sig = m.rowsSig and not m.jumpToEpisodes and m.focusEpisodes <> true and m.rows.visible then return
    m.rowsSig = sig
    m.rowBuilds = m.rowBuilds + 1
    ' (a node has one parent: take the cards out of the rows on screen before they go into the new ones)
    old = m.rows.content
    if old <> invalid
        for i = 0 to old.getChildCount() - 1
            orow = old.getChild(i)
            orow.removeChildrenIndex(orow.getChildCount(), 0)
        end for
    end if
    root = createObject("roSGNode", "ContentNode")
    sizes = []
    heights = []
    labels = []
    for each sp in specs
        row = newRow(root, sp.title, sp.kind)
        row.appendChildren(sp.nodes)
        sizes.push(sp.size)
        heights.push(sp.size[1])
        labels.push(sp.label)
    end for
    m.rows.rowItemSize = sizes
    m.rows.rowHeights = heights
    m.rows.showRowLabel = labels
    m.rows.content = root
    m.rows.visible = true
    ' keep the place, or go to the first episode after a season was chosen
    target = -1
    item = 0
    for i = 0 to root.getChildCount() - 1
        k = root.getChild(i).rowKind
        if m.jumpToEpisodes and k = "episodes"
            target = i
            item = 0
        else if not m.jumpToEpisodes and k = keepKind and target < 0
            target = i
            item = keepItem
            if item >= root.getChild(i).getChildCount() then item = root.getChild(i).getChildCount() - 1
        end if
    end for
    if m.jumpToEpisodes and target >= 0 then m.jumpToEpisodes = false
    ' (Go to Season: the focus goes to that season's episodes once they are there)
    if m.focusEpisodes = true and target >= 0 and rowsMayTakeFocus()
        if root.getChild(target).rowKind = "episodes" and root.getChild(target).getChildCount() > 0
            m.focusEpisodes = false
            enterRows()
        end if
    end if
    if target >= 0 then m.rows.jumpToRowItem = [target, item]
    ' (SC5-3) a late row (More Like This, Extras, Included In) never takes the keys from a page or player on
    ' top, nor from an open picker / menu / text panel on this page
    if m.state = "rows" and rowsMayTakeFocus() then m.rows.setFocus(true)
end sub

' (SC5-3) This page is on top and no overlay of its own holds the keys
function rowsMayTakeFocus() as boolean
    if m.picker <> invalid or m.menu <> invalid or m.textPanel <> invalid then return false
    return m.top.isInFocusChain()
end function

' (SP-9) A row from a list's cached cards, when it has any
sub addRowSpec(specs as object, kind as string, title as string, size as object)
    nodes = m.rowNodes[kind]
    if nodes = invalid or nodes.count() = 0 then return
    specs.push({ kind: kind, title: title, nodes: nodes, size: size, label: true })
end sub

' ---------------------------------------------------------------- season / subtitle pills (series)

function seasonName() as string
    if m.seasonIndex >= 0 and m.seasonIndex < m.seasonList.count() then return Util.toText(m.seasonList[m.seasonIndex].Name)
    return "Season"
end function

function subPrefKey() as string
    return Util.toText(m.item.Id)
end function

function displayLang(code as string) as string
    for each l in Prefs.languages()
        if LCase(l.name) = LCase(code) then return l.name
    end for
    return code
end function

function subPrefLabel() as string
    pref = Prefs.seriesSubLang(subPrefKey())
    ' Automatic follows Settings → Always load my subtitle language
    if pref = "" and Prefs.subAlways() then return displayLang(Prefs.subLang())
    if pref = "" and Subs.rokuMode() = "On" then return displayLang(Subs.rokuLanguage())
    if pref = "" then return "Automatic"
    if pref = "off" then return "Off"
    for each l in m.subLangs
        if l.code = pref then return l.label
    end for
    return UCase(pref)
end function

' "Season 6  v" on the left; "Subtitles  Romanian  v" on the right (when the episodes have subtitles)
sub drawSeasonBar()
    b = m.seasonBar
    b.removeChildrenIndex(b.getChildCount(), 0)
    ids = ["season"]
    texts = [seasonName()]
    if canFilterWatched()
        ids.push("filter")
        if m.showAllEps
            texts.push("Hide Watched")
        else
            texts.push("Show All")
        end if
    end if
    if m.subLangs.count() > 0
        ids.push("slang")
        texts.push("Subtitles:  " + subPrefLabel())
    end if
    m.barIds = ids
    if m.barIdx >= ids.count() then m.barIdx = 0
    focused = m.state = "season" and m.picker = invalid
    leftX = 0
    for i = 0 to ids.count() - 1
        isFocus = focused and i = m.barIdx
        g = b.createChild("Group")
        bold = i = 0
        isFilter = ids[i] = "filter"
        size = 36
        if not bold then size = 26
        l = g.createChild("Label")
        f = createObject("roSGNode", "Font")
        f.uri = "font:BoldSystemFontFile"
        if not bold then f.uri = "font:MediumSystemFontFile"
        f.size = size
        l.font = f
        l.text = texts[i]
        l.height = 60
        l.vertAlign = "center"
        tw = l.boundingRect().width
        w = tw + 80
        if isFilter then w = tw + 52
        bg = createObject("roSGNode", "Poster")
        bg.width = w
        bg.height = 60
        ' (v1.5 flat) a flat pill (controlFill); focused = solid white with dark text (no fog, ring or zoom)
        bg.uri = "pkg:/images/ui/flat_pill_60.9.png"
        bg.opacity = 0.12
        l.color = "0xFFFFFFFF"
        if not bold and not isFocus then l.color = "0xFFFFFFD9"
        if isFocus
            bg.opacity = 1.0
            l.color = m.global.theme.onFocus
        end if
        g.insertChild(bg, 0)
        l.translation = [26, 0]
        if ids[i] = "season" then w = addSeasonBadge(g, tw, w)
        bg.width = w
        if not isFilter
            ch = g.createChild("Poster")
            ch.uri = "pkg:/images/ui/icon_chevron_28.png"
            ch.width = 24
            ch.height = 24
            ch.translation = [w - 46, 18]
            ch.blendColor = l.color
        end if
        ' the season (and the watched filter) from the left, the subtitle language on the right
        if ids[i] = "slang"
            g.translation = [1806 - w, 0]
        else
            g.translation = [leftX, 0]
            leftX = leftX + w + 18
        end if
    end for
    if focused and Speak.isOn()
        text = texts[m.barIdx]
        if ids[m.barIdx] = "season"
            text = Speak.clean(text + unwatchedSuffix(m.seasonIndex)) + ", choose a season"
        else if ids[m.barIdx] = "slang"
            text = "Subtitles for this series: " + subPrefLabel() + ", menu"
        end if
        key = "s" + m.barIdx.toStr() + text
        if key <> m.spokenKey
            m.spokenKey = key
            Speak.say(Speak.button(text) + Speak.position(m.barIdx, ids.count()))
        end if
    end if
end sub

sub useBar()
    id = m.barIds[m.barIdx]
    if id = "filter"
        m.showAllEps = not m.showAllEps
        Log.line("Cove: season episodes, show all = " + Util.toText(m.showAllEps))
        rebuildRowsNow()
        return
    end if
    if id = "season"
        o = []
        for i = 0 to m.seasonList.count() - 1
            o.push({ id: i.toStr(), label: Util.toText(m.seasonList[i].Name) + unwatchedSuffix(i) })
        end for
        openPicker("season", "Seasons", o, m.seasonIndex.toStr())
    else
        pref = Prefs.seriesSubLang(subPrefKey())
        auto = "Automatic (forced subtitles only)"
        if Prefs.subAlways()
            auto = "Automatic (" + displayLang(Prefs.subLang()) + ", from Settings)"
        else if Subs.rokuMode() = "On"
            auto = "Automatic (" + displayLang(Subs.rokuLanguage()) + ", Roku captions on)"
        end if
        o = [{ id: "", label: auto }, { id: "off", label: "Off" }]
        for each l in m.subLangs
            o.push({ id: l.code, label: l.label })
        end for
        openPicker("slang", "Subtitles for this series", o, pref)
        ' (SC-16: "Automatic (Portuguese (Brazil), Roku captions on)" needs the wide panel)
        m.picker.wide = true
    end if
end sub

' The series' subtitle languages, read from one of its episodes
sub loadEpisodeStreams(ep as dynamic)
    if ep = invalid or Util.toText(ep.Id) = m.streamsFor then return
    m.streamsFor = Util.toText(ep.Id)
    get("/Users/" + Util.toText(m.top.server.userId) + "/Items/" + m.streamsFor + "?Fields=MediaStreams,MediaSources", { kind: "epStreams" })
end sub

sub onEpisodeStreams(json as object)
    tr = Tracks.fromItem(json)
    seen = {}
    langs = []
    for each s in tr.subs
        code = s.language
        if code <> "" and not seen.doesExist(code)
            seen[code] = true
            label = s.label
            cut = label.instr(" (")
            if cut > 0 then label = label.left(cut)
            label = label.replace("  (burned in)", "")
            langs.push({ code: code, label: label })
        end if
    end for
    m.subLangs = langs
    if m.seasonBar.visible then drawSeasonBar()
end sub

' ---------------------------------------------------------------- season counts, mark season watched

' Unwatched episodes of a season: counted from the loaded episodes for the chosen one (fresh after a change),
' otherwise the server's UserData.UnplayedItemCount; -1 when unknown
function unwatchedIn(index as integer) as integer
    if index < 0 or index >= m.seasonList.count() then return -1
    if index = m.seasonIndex and index = m.episodesSeason and m.episodeList.count() > 0
        n = 0
        for each e in m.episodeList
            if not Util.flag(e.UserData, "Played") then n = n + 1
        end for
        return n
    end if
    ud = m.seasonList[index].UserData
    if ud = invalid or ud.UnplayedItemCount = invalid then return -1
    return Int(ud.UnplayedItemCount)
end function

function unwatchedSuffix(index as integer) as string
    n = unwatchedIn(index)
    if n < 0 then return ""
    if n = 0 then return "  ·  watched"
    return "  ·  " + n.toStr() + " unwatched"
end function

' The Mac's CountBadge after the season name: the unwatched count in a capsule, a check when all are watched.
' Widens the pill (returns the new width).
function addSeasonBadge(g as object, textW as integer, w as integer) as integer
    n = unwatchedIn(m.seasonIndex)
    if n < 0 then return w
    x = 26 + textW + 14
    if n = 0
        bg = g.createChild("Poster")
        bg.uri = "pkg:/images/ui/badge_circle.png"
        bg.width = 36
        bg.height = 36
        bg.translation = [x, 12]
        ic = g.createChild("Poster")
        ic.uri = "pkg:/images/ui/icon_check_28.png"
        ic.width = 22
        ic.height = 22
        ic.translation = [x + 7, 19]
        return w + 50
    end if
    t = n.toStr()
    if n > 99 then t = "99+"
    bw = 36 + (t.len() - 1) * 15
    bg = g.createChild("Poster")
    bg.uri = "pkg:/images/ui/badge_capsule.9.png"
    bg.width = bw
    bg.height = 36
    bg.translation = [x, 12]
    lab = g.createChild("Label")
    f = createObject("roSGNode", "Font")
    f.uri = "font:BoldSystemFontFile"
    f.size = 24
    lab.font = f
    lab.text = t
    lab.color = "0xFFFFFFFF"
    lab.width = bw
    lab.height = 36
    lab.horizAlign = "center"
    lab.vertAlign = "center"
    lab.translation = [x, 12]
    ' the pill's background is the first child: widen it too
    g.getChild(0).width = w + bw + 14
    return w + bw + 14
end function

' After a change (or playback): the seasons again, only for their counts
sub reloadSeasonCounts()
    if m.item = invalid or m.seasonList.count() = 0 then return
    get("/Shows/" + Util.toText(m.item.Id) + "/Seasons?UserId=" + Util.toText(m.top.server.userId) + "&" + Items.fields(), { kind: "seasonCounts" })
end sub

sub onSeasonCounts(json as dynamic)
    list = listOf(json)
    if list.count() <> m.seasonList.count() then return
    for i = 0 to list.count() - 1
        if Util.toText(list[i].Id) <> Util.toText(m.seasonList[i].Id) then return
    end for
    m.seasonList = list
    if m.seasonBar.visible then drawSeasonBar()
end sub

' * on the season bar: mark the whole season watched / unwatched (Played on the season id, as on the Mac)
sub seasonMenu()
    if m.seasonIndex < 0 or m.seasonIndex >= m.seasonList.count() then return
    n = unwatchedIn(m.seasonIndex)
    o = []
    if n <> 0 then o.push({ id: "swatched", label: "Mark Season as Watched" })
    total = m.episodeList.count()
    if n < 0 or total = 0 or n < total then o.push({ id: "sunwatched", label: "Mark Season as Unwatched" })
    openPicker("seasonmenu", seasonName(), o, "")
end sub

sub useSeasonMenu(id as string)
    if m.seasonIndex < 0 or m.seasonIndex >= m.seasonList.count() then return
    sid = Util.toText(m.seasonList[m.seasonIndex].Id)
    Log.line("Cove: mark season " + Util.toText(sid) + " " + Util.toText(id))
    if id = "swatched"
        markPlayed(sid, true, seasonName())
    else if id = "sunwatched"
        markPlayed(sid, false, seasonName())
    end if
end sub

' The season has both watched and unwatched episodes, so "hide watched" makes sense (Mac canFilterWatched)
function canFilterWatched() as boolean
    open = 0
    for each e in m.episodeList
        if not Util.flag(e.UserData, "Played") then open = open + 1
    end for
    return open > 0 and open < m.episodeList.count()
end function

' Unwatched episodes only, unless the season is all watched / all unwatched or "Show all" is on
function shownEpisodes() as object
    if not canFilterWatched() or m.showAllEps then return m.episodeList
    out = []
    for each e in m.episodeList
        if not Util.flag(e.UserData, "Played") then out.push(e)
    end for
    return out
end function

function newRow(root as object, title as string, kind as string) as object
    row = root.createChild("ContentNode")
    row.title = title
    row.addFields({ rowKind: kind })
    return row
end function

sub onRowSelected()
    s = m.rows.rowItemSelected
    if s = invalid or s.count() < 2 or m.rows.content = invalid then return
    row = m.rows.content.getChild(s[0])
    if row = invalid then return
    k = row.rowKind
    i = s[1]
    if k = "episodes" and i < m.shownEps.count()
        e = m.shownEps[i]
        start = Items.resumeAt(e)
        if start <= 30 then start = 0
        requestPlay(e, start)
    else if k = "extras" and i < m.extrasList.count()
        playExtra(i)
    else if k = "cast" and i < m.castList.count()
        pp = m.castList[i]
        m.top.openItem = { id: "open", itemId: Util.toText(pp.Id), itemType: "Person", collectionType: "", title: Util.toText(pp.Name) }
    else if (k = "box" and i < m.boxList.count()) or (k = "included" and i < m.includedList.count())
        if k = "box"
            b = m.boxList[i]
        else
            b = m.includedList[i]
        end if
        m.top.openItem = { id: "open", itemId: Util.toText(b.Id), itemType: Util.toText(b.Type), collectionType: "", title: Util.toText(b.Name), seriesId: Util.toText(b.SeriesId), seriesName: Util.toText(b.SeriesName), preview: QuickPlay.previewOfCard(row.getChild(i), true) }
    else if k = "similar" and i < m.similarList.count()
        it = m.similarList[i]
        ' (v1.2 SP-12) the card's preview: the next page's header at once
        m.top.openItem = { id: "open", itemId: Util.toText(it.Id), itemType: Util.toText(it.Type), collectionType: "", title: Util.toText(it.Name), preview: QuickPlay.previewOfCard(row.getChild(i), true) }
    end if
end sub

' ---------------------------------------------------------------- focus areas

sub animate(rowsY as integer, headerOp as float, miniOp as float, bgOp as float)
    m.slide.control = "stop"
    m.top.findNode("rowsMove").keyValue = [m.lower.translation, [78, rowsY]]
    m.top.findNode("headerFade").keyValue = [m.top.findNode("header").opacity, headerOp]
    m.top.findNode("miniFade").keyValue = [m.top.findNode("miniTitle").opacity, miniOp]
    m.top.findNode("bgFade").keyValue = [m.top.findNode("rowsBg").opacity, bgOp]
    m.slide.control = "start"
end sub

sub enterButtons(slideBack = true as boolean)
    m.state = "buttons"
    hideAbout()
    m.btnKeys.setFocus(true)
    if slideBack then animate(m.restY, 1.0, 0.0, 0.0)
    drawButtons()
    if m.seasonBar.visible then drawSeasonBar()
end sub

' Down from the header (buttons, or the description under them): the season pills, the rows, or About
sub leaveHeaderDown()
    if m.seasonBar.visible
        enterSeason()
    else if m.rows.visible
        enterRows()
    else
        enterAbout()
    end if
end sub

sub enterSeason()
    m.state = "season"
    hideAbout()
    m.btnKeys.setFocus(true)
    animate(150, 0.0, 1.0, 1.0)
    drawButtons()
    drawSeasonBar()
end sub

sub enterRows()
    if not m.rows.visible then return
    m.state = "rows"
    hideAbout()
    m.rows.setFocus(true)
    animate(150, 0.0, 1.0, 1.0)
    drawButtons()
    if m.seasonBar.visible then drawSeasonBar()
    m.spokenRow = -1
    onRowFocusedSpeak()
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press or m.picker <> invalid or m.menu <> invalid or m.textPanel <> invalid then return false
    ' (v1.1 U-1) Play: the focused card below, or this title's Play button anywhere else on the page
    if key = "play"
        playKey()
        return true
    end if
    ' (v1.5 details) the description sits under the buttons: Down from them reaches "More" when it is cut
    if m.state = "overview"
        if key = "OK"
            openFullText()
        else if key = "up" or key = "back"
            enterButtons(false)
        else if key = "down"
            leaveHeaderDown()
        end if
        return true
    end if
    ' (v1.5 details) the media line above the buttons: Left / Right along its pills, OK opens the list in place
    if m.state = "media"
        if key = "left" and m.mediaIdx > 0
            m.mediaIdx = m.mediaIdx - 1
            paintMedia()
        else if key = "right" and m.mediaIdx < m.mediaPills.count() - 1
            m.mediaIdx = m.mediaIdx + 1
            paintMedia()
        else if key = "OK" and m.mediaIdx < m.mediaPills.count()
            openTrackList(m.mediaPills[m.mediaIdx].id)
        else if key = "down" or key = "back"
            enterButtons(false)
        end if
        return true
    end if
    if m.state = "buttons"
        if key = "up"
            enterMedia()
            return true
        end if
        if key = "down" and m.ovMore
            enterOverview()
            return true
        end if
        if key = "left" and m.btn > 0
            m.btn = m.btn - 1
            drawButtons()
            return true
        else if key = "right" and m.btn < m.btns.count() - 1
            m.btn = m.btn + 1
            drawButtons()
            return true
        else if key = "OK"
            useButton()
            return true
        else if key = "down"
            leaveHeaderDown()
            return true
        else if key = "left" or key = "right" or key = "up"
            return true
        end if
    else if m.state = "season"
        if key = "left" and m.barIdx > 0
            m.barIdx = m.barIdx - 1
            drawSeasonBar()
        else if key = "right" and m.barIdx < m.barIds.count() - 1
            m.barIdx = m.barIdx + 1
            drawSeasonBar()
        else if key = "OK"
            useBar()
        else if key = "options"
            seasonMenu()
        else if key = "down"
            if m.rows.visible
                enterRows()
            else
                enterAbout()
            end if
        else if key = "up" or key = "back"
            enterButtons()
        end if
        return true
    else if m.state = "about"
        if key = "left" and m.tagIdx > 0
            m.tagIdx = m.tagIdx - 1
            drawTags()
        else if key = "right" and m.tagIdx < m.tags.count() - 1
            m.tagIdx = m.tagIdx + 1
            drawTags()
        else if key = "OK"
            openTag()
        else if key = "down" and tagGroupStart(1) >= 0
            m.tagIdx = tagGroupStart(1)
            drawTags()
        else if key = "up" and tagGroupStart(-1) >= 0
            m.tagIdx = tagGroupStart(-1)
            drawTags()
        else if key = "up"
            leaveAbout()
        else if key = "back"
            enterButtons()
        end if
        return true
    else if m.state = "rows"
        if key = "options"
            episodeMenu()
            return true
        end if
        ' (v1.1.1 NV-13) Rewind / Fast Forward: one screen of cards back / on along the row
        if key = "rewind" or key = "fastforward"
            pageRow(key = "fastforward")
            return true
        end if
        if key = "down"
            ' (reaches here only from the last row)
            enterAbout()
            return true
        else if key = "up" and m.seasonBar.visible
            enterSeason()
            return true
        else if key = "up" or key = "back"
            enterButtons()
            return true
        end if
    end if
    ' (v1.7 DIAG M-7) Back leaves the page
    if key = "back" then stopThemeSong("back")
    return false
end function

' (NV-13) Jump one screen of cards along the focused row
sub pageRow(forward as boolean)
    f = m.rows.rowItemFocused
    if f = invalid or f.count() < 2 or m.rows.content = invalid then return
    row = m.rows.content.getChild(f[0])
    if row = invalid then return
    dir = -1
    if forward then dir = 1
    col = NavUtil.pageColumn(f[1], row.getChildCount(), Int(m.rows.itemSize[0]), NavUtil.rowCardWidth(m.rows.rowItemSize, f[0]), dir)
    if col >= 0 and col <> f[1] then m.rows.jumpToRowItem = [f[0], col]
end sub

' (v1.1 U-1) The Play key: an episode or extra plays as with OK; a title in More Like This / In This Collection /
' Included In plays without opening its page (MainScene picks the episode or film); elsewhere the Play button
sub playKey()
    if m.item = invalid or m.state = "error" then return
    if m.state = "rows"
        f = m.rows.rowItemFocused
        if f = invalid or f.count() < 2 or m.rows.content = invalid then return
        row = m.rows.content.getChild(f[0])
        if row = invalid then return
        k = row.rowKind
        i = f[1]
        if k = "episodes" and i < m.shownEps.count()
            e = m.shownEps[i]
            start = Items.resumeAt(e)
            if start <= 30 then start = 0
            requestPlay(e, start)
        else if k = "extras"
            playExtra(i)
        else if k = "box" or k = "included" or k = "similar"
            a = QuickPlay.cardAction(row.getChild(i))
            if a <> invalid then m.top.openItem = a
        end if
        return
    end if
    if NavUtil.indexOfId(m.btns, "play") < 0 then return
    target = playTarget()
    if target = invalid then return
    start = Items.resumeAt(target)
    if start <= 30 then start = 0
    requestPlay(target, start)
end sub

sub onFocusChanged()
    ' (SC5-12) covered by another screen (MainScene hides a page before it pushes the next one)
    if not m.top.visible and not m.top.isInFocusChain() then m.covered = true
    ' (v1.7 DIAG M-7) the page left (popped, covered, a dialog over it): the theme song stops
    if not m.top.isInFocusChain() then stopThemeSong("page left")
    if not m.top.hasFocus() then return
    ' (SC5-12) back from another screen: a menu or picker left open under it is stale, Play gets the focus
    if m.covered = true
        m.covered = false
        if m.picker <> invalid or m.menu <> invalid
            Log.line("Cove: details back on top: closing a stale menu / picker")
            closePicker()
            closeMenu()
        end if
    end if
    ' (SC-1) something was played or changed on a page above: Resume, Next Up, the episodes' progress and the
    ' season counts again
    if m.top.stale then onRefresh()
    ' (back on this page: say again where the focus is)
    m.spokenKey = ""
    if m.picker <> invalid
        m.picker.setFocus(true)
    else if m.menu <> invalid
        m.menu.setFocus(true)
    else if m.textPanel <> invalid
        m.textPanel.setFocus(true)
    else if m.state = "error" and m.errorPanel.visible
        m.errorPanel.setFocus(true)
    else
        ' (v1.5, Liviu: "always focus on Play") back on this page from the player, a title, a person or a
        ' library: the buttons, with Play focused (the rows slide back down)
        focusPlayButton()
    end if
    ' (v1.7 DIAG M-7) back on this page: the theme song again (from the start)
    queueThemeSong()
end sub

sub focusPlayButton()
    at = NavUtil.indexOfId(m.btns, "play")
    if at >= 0 then m.btn = at
    m.focusPlay = at < 0
    ' (SC5-4) also from the season bar (header faded, rows slid up), e.g. after ▶ played from there
    enterButtons(NavUtil.headerSlidesBack(m.state))
end sub

' ---------------------------------------------------------------- About (Cove for macOS: aboutSection, mediaInfo)

' Down from the last row (or from the buttons / season bar when there are no rows): the rows slide away
' and the About panel shows tagline, genres, studios, dates and the file's media info
sub showAbout(it as object)
    left_ = []
    tg = it.Taglines
    if type(tg) = "roArray" and tg.count() > 0 and Util.toText(tg[0]) <> "" then left_.push({ k: "Tagline", v: Util.toText(tg[0]) })
    ' (v1.1) genres and studios / networks as pills: OK opens their titles (MainScene → LibraryScreen)
    m.tags = aboutTags(it)
    genreNames = []
    studioNames = []
    for each tg_ in m.tags
        if tg_.kind = "Genre" then genreNames.push(tg_.name)
        if tg_.kind = "Studio" then studioNames.push(tg_.name)
    end for
    if genreNames.count() > 0 then left_.push({ k: "Genres", pills: genreNames })
    if studioNames.count() > 0 then left_.push({ k: "Studios", pills: studioNames })
    if m.tagIdx >= m.tags.count() then m.tagIdx = 0
    rd = MediaInfo.dateText(it.PremiereDate, false)
    if rd <> "" then left_.push({ k: "Release Date", v: rd })
    if it.UserData <> invalid
        lp = MediaInfo.dateText(it.UserData.LastPlayedDate, true)
        if lp <> "" then left_.push({ k: "Date Last Played", v: lp })
    end if
    added = MediaInfo.dateText(it.DateCreated, true)
    if added <> "" then left_.push({ k: "Date Added", v: added })
    right_ = []
    if Util.toText(it.Type) <> "Series"
        src = MediaInfo.findSource(it, Util.toText(m.opts.sourceId))
        if src <> invalid
            path = Util.toText(src.Path)
            if path = "" then path = Util.toText(it.Path)
            if path <> "" then right_.push({ k: "File", v: path })
            fl = []
            if Util.toText(src.Container) <> "" then fl.push(UCase(Util.toText(src.Container)))
            sz = MediaInfo.sizeText(src.Size)
            if sz <> "" then fl.push(sz)
            br = MediaInfo.rateText(src.Bitrate)
            if br <> "" then fl.push(br)
            if fl.count() > 0 then right_.push({ k: "Container", v: Util.join(fl, " · ") })
            vids = MediaInfo.streamsOfType(src, "Video")
            if vids.count() > 0 then right_.push({ k: "Video", v: MediaInfo.videoLine(vids[0]) })
            auds = MediaInfo.streamsOfType(src, "Audio")
            if auds.count() > 0 then right_.push({ k: "Audio", v: trackLines(auds, 4) })
            subStreams = MediaInfo.streamsOfType(src, "Subtitle")
            if subStreams.count() > 0 then right_.push({ k: "Subtitles", v: trackLines(subStreams, 4) })
        end if
    end if
    m.hasAbout = left_.count() > 0 or right_.count() > 0
    m.about.info = { left: left_, right: right_ }
end sub

' The genre and studio pills: [{ kind: "Genre" / "Studio", id, name }], genres first (at most 8 each). The id is
' the server's (GenreItems / Studios[].Id); without one the name is the filter.
function aboutTags(it as object) as object
    out = []
    seen = {}
    gi = it.GenreItems
    if type(gi) = "roArray"
        for each g in gi
            n = Util.toText(Util.field(g, "Name"))
            if n <> "" and not seen.doesExist("g" + n) and out.count() < 8
                seen["g" + n] = true
                out.push({ kind: "Genre", id: Util.toText(Util.field(g, "Id")), name: n })
            end if
        end for
    end if
    if type(it.Genres) = "roArray"
        for each g in it.Genres
            n = Util.toText(g)
            if n <> "" and not seen.doesExist("g" + n) and out.count() < 8
                seen["g" + n] = true
                out.push({ kind: "Genre", id: "", name: n })
            end if
        end for
    end if
    studios = 0
    if type(it.Studios) = "roArray"
        for each st in it.Studios
            n = Util.toText(Util.field(st, "Name"))
            if n <> "" and not seen.doesExist("s" + n) and studios < 8
                seen["s" + n] = true
                studios = studios + 1
                out.push({ kind: "Studio", id: Util.toText(Util.field(st, "Id")), name: n })
            end if
        end for
    end if
    return out
end function

' What a genre / studio page lists: this title's kind (films for a film, shows for a show or episode)
function tagTypes() as string
    t = Util.toText(m.item.Type)
    if t = "Movie" or t = "BoxSet" then return "Movie"
    if t = "Series" or t = "Season" or t = "Episode" then return "Series"
    return "Movie,Series"
end function

' The focused pill in About (white) and its speech: "Comedy, genre, button, 1 of 4"
sub drawTags(queued = false as boolean)
    focused = m.state = "about" and m.picker = invalid and m.tags.count() > 0
    idx = -1
    if focused then idx = m.tagIdx
    if m.about.focusIndex <> idx then m.about.focusIndex = idx
    if not focused or not Speak.isOn() then return
    tg_ = m.tags[m.tagIdx]
    kindWord = "genre"
    if tg_.kind = "Studio" then kindWord = "studio"
    key = "t" + m.tagIdx.toStr()
    if key = m.spokenKey then return
    m.spokenKey = key
    Speak.say(Speak.button(Speak.clean(tg_.name) + ", " + kindWord) + Speak.position(m.tagIdx, m.tags.count()), not queued)
end sub

' Down / Up in About: the first pill of the next / previous group (genres, studios)
function tagGroupStart(dirn as integer) as integer
    if m.tags.count() = 0 then return -1
    cur = m.tags[m.tagIdx].kind
    if dirn > 0
        for i = m.tagIdx + 1 to m.tags.count() - 1
            if m.tags[i].kind <> cur then return i
        end for
    else
        for i = m.tagIdx - 1 to 0 step -1
            if m.tags[i].kind <> cur
                ' (the first pill of that group)
                k = m.tags[i].kind
                while i > 0 and m.tags[i - 1].kind = k
                    i = i - 1
                end while
                return i
            end if
        end for
    end if
    return -1
end function

' OK on a pill: that genre's / studio's titles across the libraries, as a library page
sub openTag()
    if m.tagIdx < 0 or m.tagIdx >= m.tags.count() then return
    tg_ = m.tags[m.tagIdx]
    Log.line("Cove: open " + Util.toText(tg_.kind) + " " + Util.toText(tg_.name))
    m.top.openItem = { id: "open", itemId: tg_.id, itemType: tg_.kind, collectionType: "", title: tg_.name, tagTypes: tagTypes() }
end sub

' One line per track, at most max (the last one says how many more)
function trackLines(list as object, max as integer) as object
    out = []
    for i = 0 to list.count() - 1
        if i = max - 1 and list.count() > max
            out.push("+ " + (list.count() - i).toStr() + " more")
            exit for
        end if
        out.push(MediaInfo.trackLine(list[i]))
    end for
    return out
end function

sub enterAbout()
    if not m.hasAbout then return
    m.state = "about"
    m.btnKeys.setFocus(true)
    ' the rows slide up out of view, About fades in under the small title
    animate(-1200, 0.0, 1.0, 1.0)
    fadeAbout(1.0)
    drawButtons()
    if m.seasonBar.visible then drawSeasonBar()
    m.tagIdx = 0
    if Speak.isOn()
        m.spokenKey = "about"
        Speak.say("About. " + Speak.labelsOf(m.about))
    end if
    ' (the first genre pill takes the focus; its speech follows the About text)
    drawTags(true)
end sub

sub leaveAbout()
    if m.rows.visible
        enterRows()
    else if m.seasonBar.visible
        enterSeason()
    else
        enterButtons()
    end if
end sub

sub hideAbout()
    if m.about.focusIndex <> -1 then m.about.focusIndex = -1
    if m.about.opacity > 0 then fadeAbout(0.0)
end sub

sub fadeAbout(target as float)
    a = m.top.findNode("aboutAnim")
    a.control = "stop"
    m.top.findNode("aboutFade").keyValue = [m.about.opacity, target]
    a.control = "start"
end sub

' ---------------------------------------------------------------- v1.7 LIVE

' (M-5) The server said this profile's watched state or progress changed (another device): the header (Resume,
' the check) and Next Up again, without moving the focus (the buttons keep the focused one by id); the episode
' rows refresh when the page is shown again
sub onLiveRefresh()
    if m.item = invalid or not m.top.isInFocusChain() then return
    get(itemPath(), { kind: "item" })
    if Util.toText(m.item.Type) = "Series"
        m.nextUpPending = true
        loadNextUp()
        reloadSeasonCounts()
    end if
end sub

' ---------------------------------------------------------------- v1.7 DIAG (M-7 theme songs)

' One Audio node per page, made when the first song plays. Started 1 s after the page settles (first answer,
' or back on top), only while the page has the focus, never while the Audio Guide is on. Stopped on Play (the
' page's own "play" field), when another page opens ("openItem"), when the page loses the focus (popped,
' covered, a dialog), on Back and on suspend. Coming back to the page plays it again from the start, unless it
' already played to its end on this page (or the title has none).
sub initThemeSong()
    m.tmAudio = invalid
    m.tmSong = ""           ' the song id found for m.tmFor ("" = not asked yet or none)
    m.tmFor = ""            ' the title the song (or "none") is for
    m.tmDone = false        ' played to the end, or none on the server: not again on this page
    m.tmAsked = false
    m.tmTimer = createObject("roSGNode", "Timer")
    m.tmTimer.duration = 1.0
    m.tmTimer.repeat = false
    m.tmTimer.observeField("fire", "onThemeTimer")
    m.top.appendChild(m.tmTimer)
    m.top.observeField("play", "onThemeLeave")
    m.top.observeField("openItem", "onThemeLeave")
end sub

' The theme song for the title on screen, if Settings asks for one here
function themeWanted() as boolean
    if m.item = invalid or m.top.server = invalid then return false
    if m.top.hasField("suspended") and m.top.suspended = true then return false
    return ThemeMusic.playsFor(ThemeMusic.choice(), Util.toText(m.item.Type), Speak.isOn())
end function

sub queueThemeSong()
    if m.tmTimer = invalid or not themeWanted() then return
    id = Util.toText(m.item.Id)
    if m.tmFor = id and m.tmDone then return
    if themePlaying() then return
    m.tmTimer.control = "stop"
    m.tmTimer.control = "start"
end sub

sub onThemeTimer()
    if not themeWanted() or not m.top.isInFocusChain() or not m.top.visible then return
    id = Util.toText(m.item.Id)
    if m.tmFor = id and m.tmSong <> ""
        startThemeAudio()
    else if m.tmFor <> id or not m.tmAsked
        m.tmFor = id
        m.tmSong = ""
        m.tmDone = false
        m.tmAsked = true
        get(ThemeMusic.songsPath(m.top.server, id), { kind: "themeSongs", itemId: id })
    end if
end sub

sub onThemeSongs(r as object)
    ' (a late answer for another title, or after the page was left, is dropped)
    if m.item = invalid or Util.toText(r.tag.itemId) <> Util.toText(m.item.Id) or m.tmFor <> Util.toText(r.tag.itemId) then return
    if r.code <> 200
        Log.line("Cove: theme " + m.tmFor + " list failed -> " + Util.toText(r.code))
        m.tmAsked = false
        return
    end if
    m.tmSong = ThemeMusic.firstSongId(r.json)
    if m.tmSong = ""
        Log.line("Cove: theme " + m.tmFor + " none on the server")
        m.tmDone = true
        return
    end if
    if not themeWanted() or not m.top.isInFocusChain() or not m.top.visible then return
    startThemeAudio()
end sub

sub startThemeAudio()
    if m.tmSong = "" or themePlaying() then return
    st = ThemeMusic.stream(m.top.server, m.tmSong)
    c = createObject("roSGNode", "ContentNode")
    c.url = st.url
    c.streamFormat = "mp3"
    if st.headers.count() > 0 then c.HttpHeaders = st.headers
    if m.tmAudio = invalid
        m.tmAudio = createObject("roSGNode", "Audio")
        m.tmAudio.observeField("state", "onThemeState")
        m.top.appendChild(m.tmAudio)
    end if
    m.tmAudio.loop = false
    m.tmAudio.content = c
    m.tmAudio.control = "play"
    Log.line("Cove: theme " + m.tmFor + " start (song " + m.tmSong + ")")
end sub

function themePlaying() as boolean
    if m.tmAudio = invalid then return false
    st = m.tmAudio.state
    return st = "playing" or st = "buffering" or st = "paused"
end function

sub onThemeState()
    if m.tmAudio = invalid then return
    st = m.tmAudio.state
    if st = "finished"
        m.tmDone = true
        Log.line("Cove: theme " + m.tmFor + " stop (finished)")
    else if st = "error"
        m.tmDone = true
        Log.line("Cove: theme " + m.tmFor + " stop (error " + Util.toText(m.tmAudio.errorCode) + ": " + Util.redact(Util.toText(m.tmAudio.errorMsg)) + ")")
    end if
end sub

sub stopThemeSong(why as string)
    if m.tmTimer <> invalid then m.tmTimer.control = "stop"
    if not themePlaying() then return
    m.tmAudio.control = "stop"
    Log.line("Cove: theme " + m.tmFor + " stop (" + why + ")")
end sub

sub onThemeLeave(ev as object)
    stopThemeSong(ev.getField())
end sub

' (Instant Resume: MainScene sets "suspended" on every page; back from the background the page plays it
' again when it is on top)
sub onThemeSuspended()
    if m.top.suspended = true
        stopThemeSong("suspend")
    else if m.top.isInFocusChain()
        queueThemeSong()
    end if
end sub
