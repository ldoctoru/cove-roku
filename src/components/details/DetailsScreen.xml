<?xml version="1.0" encoding="utf-8" ?>
<!-- A movie, episode or series, laid out like Emby's details page (v1.5), flat and accent-free.
     Full-screen darkened backdrop; left: the poster (films, series, collections) with rating badges, or the
     episode's 16:9 still; right: logo or title, the info line (★ · tomato · year · runtime · rating · genres ·
     Ends at), the media line (Video · Audio ⌄ · Subtitles ⌄, chosen in place), the buttons (Resume / Play,
     From Beginning, Trailer, ✓ Watched, ♡ Favorite, ⋯ More), the progress line, tagline, description, Director.
     Below (Down): rows of seasons and episodes (series) or the collection's titles (BoxSet), cast, Included In
     and More Like This; below the last row About
     (tagline, genres, studios, dates, media info).
     "play" asks MainScene to start the player, "openItem" to open another title. -->
<component name="DetailsScreen" extends="Group">
    <script type="text/brightscript" uri="DetailsScreen.bs" />
    <interface>
        <field id="screenId" type="string" value="details" />
        <field id="server" type="assocarray" />
        <!-- (a series opened with "Go to Season": set before itemId) -->
        <field id="seasonId" type="string" />
        <!-- (v1.2 SP-12) from the card that opened the page, set before itemId: { itemType, title, eyebrow,
             backdrop, logo, overview, meta, played, full }; the header is drawn from it at once -->
        <field id="preview" type="assocarray" />
        <field id="itemId" type="string" onChange="load" />
        <field id="refresh" type="boolean" alwaysNotify="true" onChange="onRefresh" />
        <!-- (v1.7 LIVE M-5) watched state / progress changed on another device while this page is on top -->
        <field id="liveRefresh" type="boolean" alwaysNotify="true" onChange="onLiveRefresh" />
        <field id="play" type="assocarray" alwaysNotify="true" />
        <field id="openItem" type="assocarray" alwaysNotify="true" />
        <field id="changed" type="boolean" alwaysNotify="true" />
        <!-- (SC-1) set by MainScene after playback or a change elsewhere: reloads when it has the focus again -->
        <field id="stale" type="boolean" value="false" />
        <!-- (v1.7 DIAG M-7) set by MainScene on Instant Resume (customSuspend / customResume): the theme song stops -->
        <field id="suspended" type="boolean" onChange="onThemeSuspended" />
        <!-- (SC-11) a series page already open, asked for again with "Go to Season": that season -->
        <field id="openSeason" type="string" alwaysNotify="true" onChange="onOpenSeason" />
    </interface>
    <children>
        <Poster id="backdrop" width="1920" height="1080" loadWidth="1280" loadHeight="720" loadDisplayMode="scaleToZoom" />
        <Poster id="scrimLeft" uri="pkg:/images/ui/scrim_left.png" width="1920" height="1080" />
        <Poster id="scrimBottom" width="1920" height="1080" />
        <Group id="rowsBg" opacity="0">
            <Poster uri="pkg:/images/ui/scrim_top.png" width="1920" height="300" />
            <Poster id="rowsFade" width="1920" height="140" translation="[0,120]" />
            <Rectangle id="rowsSolid" width="1920" height="820" translation="[0,260]" />
        </Group>

        <Group id="header">
            <!-- a dark side on the right, for bright pictures -->
            <Poster uri="pkg:/images/ui/scrim_right.png" width="900" height="1080" translation="[1020,0]" />
            <!-- (v1.5 details) Emby's layout: the artwork on the left (films / series: the tall poster with the
                 rating badges down its right edge; episodes: the 16:9 still), rounded 12 -->
            <Group id="art" translation="[96,110]">
                <Poster id="artBg" uri="pkg:/images/ui/white_r12.9.png" width="420" height="630" />
                <!-- the card's picture (already loaded) while the full-size one loads above it -->
                <Poster id="artLow" width="420" height="630" loadDisplayMode="scaleToZoom" />
                <Poster id="artImg" width="420" height="630" loadDisplayMode="scaleToZoom" loadWidth="420" loadHeight="630" />
                <Poster id="artMask" width="420" height="630" />
                <Group id="badges" />
            </Group>
            <!-- the right column, top to bottom: logo or title, (episodes) S:E - name, info line, media line,
                 buttons, progress, tagline, description, Director -->
            <Group id="col" translation="[572,110]">
                <Poster id="logo" loadDisplayMode="scaleToFit" loadWidth="620" loadHeight="150" visible="false" />
                <Label id="title" width="1250" height="150" vertAlign="bottom" color="0xFFFFFFFF">
                    <Font role="font" uri="font:BoldSystemFontFile" size="64" />
                </Label>
                <Label id="epLine" width="1000" height="44" color="0xFFFFFFEB" visible="false">
                    <Font role="font" uri="font:BoldSystemFontFile" size="30" />
                </Label>
                <Group id="infoRow" />
                <Group id="mediaRow" />
                <Group id="buttons" />
                <!-- (when started) the played part in the Continue Watching green, the rest 25 % white -->
                <Group id="progressRow" visible="false">
                    <Rectangle id="progTrack" width="320" height="6" translation="[0,11]" color="0xFFFFFF40" />
                    <Rectangle id="progFill" width="0" height="6" translation="[0,11]" color="0x52B54BFF" />
                    <Label id="progText" height="28" translation="[344,0]" color="0xFFFFFF9E">
                        <Font role="font" uri="font:MediumSystemFontFile" size="24" />
                    </Label>
                </Group>
                <Label id="tagline" width="1200" height="40" color="0xFFFFFFEB">
                    <Font role="font" uri="font:BoldSystemFontFile" size="28" />
                </Label>
                <!-- Down from the buttons when the description is cut: a faint highlight, OK opens the whole text -->
                <Poster id="ovFocus" uri="pkg:/images/ui/sel_pill.9.png" visible="false" />
                <Label id="ovMeasure" height="38" opacity="0"><Font role="font" uri="font:MediumSystemFontFile" size="26" /></Label>
                <Group id="ov">
                    <!-- (SP-12) placeholder bars where the description goes, until the item answers -->
                    <Group id="ovSkel" />
                    <Label id="ovMore" text="More" height="38" color="0xFFFFFFCC" visible="false"><Font role="font" uri="font:BoldSystemFontFile" size="24" /></Label>
                    <Label id="ov0" width="1200" height="38" color="0xFFFFFFD9"><Font role="font" uri="font:MediumSystemFontFile" size="26" /></Label>
                    <Label id="ov1" width="1200" height="38" translation="[0,38]" color="0xFFFFFFD9"><Font role="font" uri="font:MediumSystemFontFile" size="26" /></Label>
                    <Label id="ov2" width="1200" height="38" translation="[0,76]" color="0xFFFFFFD9"><Font role="font" uri="font:MediumSystemFontFile" size="26" /></Label>
                </Group>
                <Group id="credit">
                    <Label id="creditKey" height="36" color="0xFFFFFF9E"><Font role="font" uri="font:MediumSystemFontFile" size="24" /></Label>
                    <Label id="creditName" height="36" color="0xFFFFFFEB"><Font role="font" uri="font:BoldSystemFontFile" size="24" /></Label>
                </Group>
            </Group>
        </Group>

        <!-- shown at the top while the rows are focused -->
        <Label id="miniTitle" width="1500" height="64" translation="[96,60]" color="0xFFFFFFFF" opacity="0">
            <Font role="font" uri="font:BoldSystemFontFile" size="48" />
        </Label>

        <!-- below the header: the season / subtitle pills (series) and the rows; slides up as one -->
        <Group id="lower" translation="[78,900]">
            <Group id="seasonBar" translation="[18,0]" visible="false" />
            <RowList id="rows" translation="[0,0]" itemComponentName="PosterItem" numRows="3"
                     itemSize="[1842,466]" rowHeights="[466]" rowItemSize="[[276,466]]" rowItemSpacing="[[0,0]]"
                     itemSpacing="[0,44]" showRowLabel="[true]" rowLabelOffset="[[18,0]]" rowLabelColor="0xFFFFFFFF"
                     focusXOffset="[0]" rowFocusAnimationStyle="floatingFocus" vertFocusAnimationStyle="fixedFocus"
                     drawFocusFeedback="false" visible="false">
                <Font role="rowLabelFont" uri="font:BoldSystemFontFile" size="34" />
            </RowList>
        </Group>

        <!-- About (Down from the last row): tagline, genres, studios, dates, media info -->
        <AboutPanel id="about" translation="[96,170]" opacity="0" />

        <!-- holds the focus while the buttons are active (keys reach onKeyEvent) -->
        <Group id="btnKeys" focusable="true" />

        <Label id="status" width="1728" height="44" translation="[96,1010]" color="0xFFFFFFCC">
            <Font role="font" uri="font:MediumSystemFontFile" size="28" />
        </Label>
        <!-- (SC-9) a failed page load: the message and Try Again -->
        <ErrorPanel id="errorPanel" translation="[96,420]" width="1728" visible="false" />
        <Animation id="slide" duration="0.3" easeFunction="outCubic">
            <Vector2DFieldInterpolator id="rowsMove" key="[0.0, 1.0]" fieldToInterp="lower.translation" />
            <FloatFieldInterpolator id="headerFade" key="[0.0, 1.0]" fieldToInterp="header.opacity" />
            <FloatFieldInterpolator id="miniFade" key="[0.0, 1.0]" fieldToInterp="miniTitle.opacity" />
            <FloatFieldInterpolator id="bgFade" key="[0.0, 1.0]" fieldToInterp="rowsBg.opacity" />
        </Animation>
        <Animation id="aboutAnim" duration="0.3" easeFunction="linear">
            <FloatFieldInterpolator id="aboutFade" key="[0.0, 1.0]" fieldToInterp="about.opacity" />
        </Animation>
        <!-- (v1.1.1 SP-10) how long a series page waits for Next Up before opening the first season -->
        <Timer id="seasonWait" duration="0.8" repeat="false" />
        <!-- (v1.2 SP-9) the rows are rebuilt once, this long after the last answer of a burst -->
        <Timer id="rowsTimer" duration="0.05" repeat="false" />
        <!-- (v1.5 details) the name keyboard sometimes opens without the focus: given again after this -->
        <Timer id="kbTimer" duration="0.4" repeat="false" />
    </children>
</component>
