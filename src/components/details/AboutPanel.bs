import "pkg:/source/Util.bs"

sub init()
    m.leftCol = m.top.findNode("leftCol")
    m.rightCol = m.top.findNode("rightCol")
end sub

sub onInfo()
    inf = m.top.info
    if inf = invalid then return
    m.pillAt = 0
    fillColumn(m.leftCol, inf.left, 820)
    fillColumn(m.rightCol, inf.right, 824)
    m.top.findNode("mediaTitle").visible = type(inf.right) = "roArray" and inf.right.count() > 0
end sub

' Each row: its name in bold, the text under it in grey (as on the Mac), wrapped by hand
sub fillColumn(col as object, rows as dynamic, w as integer)
    col.removeChildrenIndex(col.getChildCount(), 0)
    if type(rows) <> "roArray" then return
    chars = Int(w / 14)
    y = 0
    for each r in rows
        addText(col, Util.toText(r.k), 0, y, w, "0xFFFFFFFF", true)
        y = y + 34
        if type(r.pills) = "roArray"
            ' (v1.1) genres / studios as pills: OK opens a page with that genre's or studio's titles
            ' (BG-2: an if/else, not `continue for`, which needs Roku OS 11.5+)
            y = addPills(col, r.pills, y, w) + 18
        else
            lines = []
            if type(r.v) = "roArray"
                for each one in r.v
                    cut = Util.wrapLines(Util.toText(one), chars, 1)
                    if cut.count() > 0 then lines.push(cut[0])
                end for
            else
                lines = Util.wrapLines(Util.toText(r.v), chars, 2)
            end if
            for each line in lines
                addText(col, line, 0, y, w, "0xFFFFFFCC", false)
                y = y + 32
            end for
            y = y + 18
        end if
    end for
end sub

sub addText(col as object, text as string, x as integer, y as integer, w as integer, color as string, bold as boolean)
    lab = col.createChild("Label")
    f = createObject("roSGNode", "Font")
    f.uri = "font:MediumSystemFontFile"
    if bold then f.uri = "font:BoldSystemFontFile"
    f.size = 24
    lab.font = f
    lab.color = color
    lab.width = w
    lab.height = 32
    lab.translation = [x, y]
    lab.text = text
end sub

' A row of pills that wraps at w; the one at focusIndex (counted across all pill rows) is white. Returns the
' y under the last line.
function addPills(col as object, names as object, y as integer, w as integer) as integer
    x = 0
    focusAt = Util.toNumber(m.top.focusIndex)
    for each n in names
        g = col.createChild("Group")
        bg = g.createChild("Poster")
        lab = g.createChild("Label")
        f = createObject("roSGNode", "Font")
        f.uri = "font:MediumSystemFontFile"
        f.size = 24
        lab.font = f
        lab.text = Util.toText(n)
        lab.height = 46
        lab.vertAlign = "center"
        lab.translation = [20, 0]
        pw = lab.boundingRect().width + 40
        if x > 0 and x + pw > w
            x = 0
            y = y + 58
        end if
        bg.width = pw
        bg.height = 46
        ' (v1.5 flat) a flat pill (controlFill); focused = solid white with dark text
        bg.uri = "pkg:/images/ui/flat_pill_44.9.png"
        if m.pillAt = focusAt
            bg.opacity = 1.0
            lab.color = m.global.theme.onFocus
        else
            bg.opacity = 0.12
            lab.color = "0xFFFFFFEB"
        end if
        g.translation = [x, y]
        x = x + pw + 12
        m.pillAt = m.pillAt + 1
    end for
    return y + 46
end function
