import "pkg:/source/Util.bs"
import "pkg:/source/Api.bs"
import "pkg:/source/Items.bs"
import "pkg:/source/Playback.bs"
import "pkg:/source/Speak.bs"
import "pkg:/source/Ratings.bs"
import "pkg:/source/NavUtil.bs"
import "pkg:/source/Log.bs"

sub init()
    m.top.findNode("bg").color = m.global.theme.bg
    m.grid = m.top.findNode("grid")
    m.status = m.top.findNode("status")
    m.timer = m.top.findNode("timer")
    m.timer.observeField("fire", "refresh")
    m.grid.observeField("itemSelected", "onSelected")
    m.top.observeField("focusedChild", "onFocusChanged")
    m.grid.content = createObject("roSGNode", "ContentNode")
    m.task = invalid
    ' Audio Guide: the list is rebuilt every 5 s, so Cove says a card only when the focus moves to another one
    m.spokenKey = ""
    m.grid.observeField("itemFocused", "onCardFocused")
    Speak.mute([m.grid])
    ' (v1.7 LIVE M-5) the server's own pushes over the live connection (LiveTask): the polling waits while they come
    m.liveAt = 0
    if m.global.hasField("liveSessions") then m.global.observeField("liveSessions", "onLiveSessions")
end sub

sub onCardFocused()
    if not Speak.isOn() or not m.grid.isInFocusChain() or m.grid.content = invalid then return
    c = m.grid.content.getChild(m.grid.itemFocused)
    if c = invalid then return
    key = Util.toText(c.itemId) + Util.toText(c.who) + Util.toText(c.where)
    if key = m.spokenKey then return
    m.spokenKey = key
    parts = [Util.toText(c.title), Util.toText(c.line2), Util.toText(c.who) + " on " + Util.toText(c.where)]
    if c.paused = true then parts.push("paused")
    if Util.toText(c.method) <> "" then parts.push(Util.toText(c.method))
    Speak.say(Speak.clean(Util.join(parts, ", ")) + Speak.position(m.grid.itemFocused, m.grid.content.getChildCount()))
end sub

sub refresh()
    if m.top.server = invalid then return
    wantLive(m.top.isInFocusChain() and not m.top.suspended)
    ' (v1.7 LIVE) the live connection pushed the list in the last 20 s: no request this round
    if m.liveAt > 0 and nowSecs() - m.liveAt < 20
        m.timer.control = "start"
        return
    end if
    t = createObject("roSGNode", "ApiTask")
    t.request = { method: "GET", url: Util.toText(m.top.server.url) + "/Sessions?ActiveWithinSeconds=960", headers: Api.headers(m.top.server, true), body: "", tag: { kind: "sessions" }, timeout: 15000 }
    t.observeField("response", "onSessions")
    m.task = t
    t.control = "RUN"
    m.timer.control = "start"
end sub

sub onSessions(ev as object)
    r = ev.getData()
    if r.code <> 200 or type(r.json) <> "roArray"
        if m.grid.content.getChildCount() = 0
            m.status.text = "Couldn't load what's playing. " + Api.describeFailure(r)
            m.status.visible = true
        end if
        return
    end if
    showSessions(r.json)
end sub

' The cards for a session list (GET /Sessions, or the live connection's Sessions message)
sub showSessions(sessions as object)
    srv = m.top.server
    list = []
    for each s in sessions
        ' (v0.9.1: a profile with a rating limit doesn't see titles above it, or unrated episodes of unknown series)
        if Util.isAA(s) and Util.isAA(s.NowPlayingItem) and Ratings.allowed(srv, s.NowPlayingItem) then list.push(s)
    end for
    list.sortBy("UserName")
    root = createObject("roSGNode", "ContentNode")
    for each s in list
        it = s.NowPlayingItem
        c = root.createChild("ContentNode")
        c.addFields({ itemId: "", itemType: "", line2: "", who: "", where: "", pos: "", frac: 0.0, paused: false, method: "" })
        c.itemId = Util.toText(it.Id)
        c.itemType = Util.toText(it.Type)
        name = Util.toText(it.Name)
        if Util.toText(it.SeriesName) <> ""
            c.title = Util.toText(it.SeriesName)
            c.line2 = "S" + Util.toText(it.ParentIndexNumber) + ":E" + Util.toText(it.IndexNumber) + "  ·  " + name
            if Util.toText(it.SeriesId) <> "" then c.itemId = Util.toText(it.Id)
        else
            c.title = name
            if Util.toText(it.ProductionYear) <> "" then c.line2 = Util.toText(it.ProductionYear)
        end if
        posterId = Util.toText(it.SeriesId)
        if posterId = "" then posterId = Util.toText(it.Id)
        c.hdPosterUrl = Items.imageUrl(srv, posterId, "Primary", "", 160)
        c.who = Util.toText(s.UserName)
        dev = Util.toText(s.DeviceName)
        if Util.toText(s.Client) <> "" then dev = dev + "  ·  " + Util.toText(s.Client)
        c.where = dev
        st = s.PlayState
        posSec = 0.0
        if st <> invalid
            posSec = Playback.seconds(st.PositionTicks)
            c.paused = Util.flag(st, "IsPaused")
            pm = Util.toText(st.PlayMethod)
            if pm = "Transcode"
                c.method = "Converting"
            else if pm = "DirectStream"
                c.method = "Direct stream"
            else if pm <> ""
                c.method = "Direct play"
            end if
        end if
        dur = Playback.seconds(it.RunTimeTicks)
        c.pos = Playback.clock(posSec)
        if dur > 0
            c.pos = c.pos + " / " + Playback.clock(dur)
            c.frac = posSec / dur
        end if
    end for
    ' keep the focus where it was
    keep = m.grid.itemFocused
    m.grid.content = root
    n = root.getChildCount()
    ' (SC-12: when the last session ends, the one before it rather than the first card)
    if keep >= 0 then keep = NavUtil.clampIndex(keep, n)
    if keep >= 0 then m.grid.jumpToItem = keep
    m.status.visible = n = 0
    m.status.text = "Nothing is playing right now."
    m.top.findNode("count").text = ""
    if n > 0 then m.top.findNode("count").text = n.toStr() + " active"
    if n > 0 and m.top.isInFocusChain() and not m.grid.hasFocus() then m.grid.setFocus(true)
end sub

sub onSelected()
    c = m.grid.content.getChild(m.grid.itemSelected)
    if c <> invalid then m.top.action = { id: "open", itemId: c.itemId, itemType: c.itemType, collectionType: "", title: c.title }
end sub

sub onFocusChanged()
    if not m.top.isInFocusChain()
        m.timer.control = "stop"
        wantLive(false)
    end if
    if m.top.hasFocus()
        refresh()
        if m.grid.content <> invalid and m.grid.content.getChildCount() > 0
            m.grid.setFocus(true)
            m.spokenKey = ""
            onCardFocused()
        end if
    end if
end sub

sub onSuspended()
    if m.top.suspended
        m.timer.control = "stop"
        wantLive(false)
    else if m.top.isInFocusChain()
        refresh()
    end if
end sub

' ---------------------------------------------------------------- v1.7 LIVE

' (M-5) While this page is on top the live connection asks the server to push the session list (SessionsStart);
' LiveTask follows m.global.liveWantSessions
sub wantLive(isOn as boolean)
    if m.global.hasField("liveWantSessions") and m.global.liveWantSessions <> isOn then m.global.liveWantSessions = isOn
end sub

sub onLiveSessions()
    d = m.global.liveSessions
    srv = m.top.server
    if not Util.isAA(d) or srv = invalid or type(d.list) <> "roArray" then return
    if Util.toText(d.serverId) <> Util.toText(srv.id) or Util.toText(d.userId) <> Util.toText(srv.userId) then return
    if not m.top.isInFocusChain() or m.top.suspended then return
    if m.liveAt = 0 then Log.line("Cove: now playing live (pushed by the server)")
    m.liveAt = nowSecs()
    showSessions(d.list)
end sub

function nowSecs() as integer
    return createObject("roDateTime").asSeconds()
end function
