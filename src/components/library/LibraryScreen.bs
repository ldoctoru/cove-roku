import "pkg:/source/Util.bs"
import "pkg:/source/Items.bs"
import "pkg:/source/Prefs.bs"

sub init()
    m.grid = m.top.findNode("grid")
    m.status = m.top.findNode("status")
    m.grid.observeField("itemFocused", "onFocused")
    m.grid.observeField("itemSelected", "onSelected")
    m.top.observeField("focusedChild", "onFocusChanged")
    m.sort = "name"
    m.show = "all"          ' all / unwatched / watched / favourites
    m.genre = ""
    m.letter = ""
    m.tab = "main"        ' main / collections (movie libraries)
    m.defSort = "name"     ' the Settings → Libraries defaults (saveFilters keeps only changes from them)
    m.defShow = "all"
    m.genres = []
    m.inBar = false
    m.barIdx = 0
    m.barIds = []
    m.total = 0
    m.loading = false
    m.gen = 0
    m.task = invalid
    m.picker = invalid
    m.shuffleTask = invalid
    m.keepIndex = -1        ' refresh: the card to focus again once the first page is back
    ' (the grid gets focus as soon as the screen is shown, before the library is set: never leave it without content)
    m.grid.content = createObject("roSGNode", "ContentNode")
end sub

sub onLibrary()
    m.top.findNode("title").text = Util.toText(m.top.library.title)
    ' Recently Added: newest first (as on the Mac); a library opens with its Settings → Libraries sort and filter
    if feed() = "recent"
        m.sort = "added"
    else if Util.toText(m.top.library.id) <> ""
        lp = Prefs.library(Util.toText(m.top.library.id))
        sortMap = { name: "name", latest: "added", release: "year", top: "rating" }
        if sortMap.doesExist(lp.sort) then m.sort = sortMap[lp.sort]
        if lp.show = "unwatched" or lp.show = "watched" then m.show = lp.show
        ' then what was chosen here last time (Mac LibraryView lf-<id>): sort, show, genre, A–Z
        m.defSort = m.sort
        m.defShow = m.show
        saved = Prefs.libFilters(Util.toText(m.top.library.id))
        if saved <> invalid
            sv = Util.toText(saved.s)
            if sv = "name" or sv = "added" or sv = "year" or sv = "rating" then m.sort = sv
            sv = Util.toText(saved.w)
            if sv = "all" or sv = "unwatched" or sv = "watched" or sv = "favourites" then m.show = sv
            m.genre = Util.toText(saved.g)
            m.letter = Util.toText(saved.l)
            print "Cove: library filters kept: "; m.sort; " / "; m.show; " / "; m.genre; " / "; m.letter
        end if
    end if
    drawBar()
    reload()
    loadGenres()
end sub

' The page's choices for the next visit (only what differs from the Settings → Libraries defaults)
sub saveFilters()
    libId = Util.toText(m.top.library.id)
    if feed() <> "" or libId = "" then return
    f = { g: m.genre, l: m.letter }
    if m.sort <> m.defSort then f.s = m.sort
    if m.show <> m.defShow then f.w = m.show
    Prefs.setLibFilters(libId, f)
end sub

sub reload()
    m.gen = m.gen + 1
    m.total = 0
    m.grid.content = createObject("roSGNode", "ContentNode")
    m.status.text = "Loading..."
    m.status.visible = true
    loadPage(0, 60)
end sub

' Back on this page after a favourite / watched change or playback (MainScene sets "stale"): load it again,
' keeping the grid on screen until the new items arrive and the focus on the same card
sub onRefresh()
    if m.top.library = invalid or m.top.server = invalid then return
    m.gen = m.gen + 1
    m.keepIndex = m.grid.itemFocused
    ' (enough items in one request to reach the focused card)
    limit = 60
    if m.keepIndex >= 40 then limit = (Int((m.keepIndex + 21) / 60) + 1) * 60
    loadPage(0, limit)
end sub

function sortQuery() as string
    if m.sort = "added" then return "SortBy=DateCreated,SortName&SortOrder=Descending"
    if m.sort = "year" then return "SortBy=ProductionYear,PremiereDate,SortName&SortOrder=Descending"
    if m.sort = "rating" then return "SortBy=CommunityRating,SortName&SortOrder=Descending"
    return "SortBy=SortName&SortOrder=Ascending"
end function

function sortLabel() as string
    if m.sort = "added" then return "Date added"
    if m.sort = "year" then return "Year"
    if m.sort = "rating" then return "Rating"
    return "Name"
end function

function showLabel() as string
    if m.show = "unwatched" then return "Unwatched"
    if m.show = "watched" then return "Watched"
    if m.show = "favourites" then return "Favourites"
    return "All"
end function

' "" for a library; "favorites" / "recent" for the sidebar pages of the same name (no parent library)
function feed() as string
    l = m.top.library
    if l = invalid or l.feed = invalid then return ""
    return Util.toText(l.feed)
end function

function filterQuery() as string
    q = ""
    flags = []
    if m.show = "unwatched" then flags.push("IsUnplayed")
    if m.show = "watched" then flags.push("IsPlayed")
    if m.show = "favourites" or feed() = "favorites" then flags.push("IsFavorite")   ' (once, also on Favorites)
    if flags.count() > 0 then q = q + "&Filters=" + Util.join(flags, ",")
    if m.genre <> "" then q = q + "&Genres=" + m.genre.encodeUriComponent()
    if m.letter = "#"
        q = q + "&NameLessThan=A"
    else if m.letter <> ""
        q = q + "&NameStartsWith=" + m.letter
    end if
    return q
end function

' A filter the user picked (the Favorites page's own IsFavorite doesn't count)
function userFiltered() as boolean
    return m.show <> "all" or m.genre <> "" or m.letter <> ""
end function

' The library's genres for the Genre pill
sub loadGenres()
    lib = m.top.library
    uid = Util.toText(m.top.server.userId)
    q = "UserId=" + uid + "&SortBy=SortName&Recursive=true"
    if Util.toText(lib.id) <> "" then q = q + "&ParentId=" + Util.toText(lib.id)
    types = Items.typesFor(Util.toText(lib.collectionType))
    if types <> "" then q = q + "&IncludeItemTypes=" + types
    t = createObject("roSGNode", "ItemsTask")
    t.server = m.top.server
    t.path = "/Genres?" + q
    t.fallback = ""
    t.kind = "names"
    t.observeField("result", "onGenres")
    m.genreTask = t
    t.control = "RUN"
end sub

sub onGenres(ev as object)
    m.genres = ev.getData().names
    drawBar()
end sub

' ---------------------------------------------------------------- pills: Sort, Genre, A-Z, Show

sub drawBar()
    b = m.top.findNode("bar")
    b.removeChildrenIndex(b.getChildCount(), 0)
    ids = []
    texts = []
    ' Movie libraries: the Mac's tabs <library> | Collections (its box sets)
    if hasTabs()
        ids.push("tab:main")
        texts.push(Util.toText(m.top.library.title))
        ids.push("tab:collections")
        texts.push("Collections")
    end if
    ' Shuffle (Mac library controls): random unwatched titles / episodes, back to back
    if canShuffle()
        ids.push("shuffle")
        texts.push("Shuffle")
    end if
    ids.push("sort")
    texts.push("Sort: " + sortLabel())
    if m.genres.count() > 0
        ids.push("genre")
        g = "All"
        if m.genre <> "" then g = m.genre
        texts.push("Genre: " + g)
    end if
    ids.push("letter")
    l = "All"
    if m.letter <> "" then l = m.letter
    texts.push("A–Z: " + l)
    ids.push("show")
    texts.push("Show: " + showLabel())
    m.barIds = ids
    if m.barIdx >= ids.count() then m.barIdx = ids.count() - 1
    x = 0
    focused = m.inBar and m.picker = invalid
    for i = 0 to ids.count() - 1
        isFocus = focused and i = m.barIdx
        active = (ids[i] = "genre" and m.genre <> "") or (ids[i] = "letter" and m.letter <> "") or (ids[i] = "show" and m.show <> "all") or (ids[i] = "sort" and m.sort <> "name")
        g = b.createChild("Group")
        bg = g.createChild("Poster")
        lab = g.createChild("Label")
        f = createObject("roSGNode", "Font")
        f.uri = "font:MediumSystemFontFile"
        f.size = 26
        lab.font = f
        lab.text = texts[i]
        lab.height = 52
        lab.vertAlign = "center"
        lab.translation = [24, 0]
        isTab = ids[i].startsWith("tab:")
        w = lab.boundingRect().width + 84
        ' (an action or a tab, not a choice: no chevron)
        if ids[i] = "shuffle" or isTab then w = lab.boundingRect().width + 48
        bg.width = w
        bg.height = 52
        ch = g.createChild("Poster")
        ch.uri = "pkg:/images/ui/icon_chevron_28.png"
        ch.width = 22
        ch.height = 22
        ch.translation = [w - 44, 15]
        ch.visible = ids[i] <> "shuffle" and not isTab
        if isFocus
            bg.uri = "pkg:/images/ui/white_pill.9.png"
            lab.color = "0x000000FF"
        else if isTab
            ' tabs sit together in one glass capsule (drawn below), the chosen one lit as on the Mac
            bg.uri = ""
            lab.color = "0xFFFFFF99"
            if ids[i] = "tab:" + m.tab
                bg.uri = "pkg:/images/ui/sel_pill.9.png"
                lab.color = "0xFFFFFFFF"
            end if
        else
            bg.uri = "pkg:/images/ui/glass_pill.9.png"
            lab.color = "0xFFFFFFD9"
            if active then lab.color = m.global.theme.accent
        end if
        ch.blendColor = lab.color
        if isTab and x = 0 then x = 6
        g.translation = [x, 0]
        x = x + w + 16
        if isTab
            x = x - 12
            if i + 1 >= ids.count() or not ids[i + 1].startsWith("tab:")
                ' the capsule behind the tabs, then the usual gap
                cap = createObject("roSGNode", "Poster")
                cap.uri = "pkg:/images/ui/glass_pill.9.png"
                cap.width = x + 2
                cap.height = 64
                cap.translation = [0, -6]
                b.insertChild(cap, 0)
                x = x + 2 + 22
            end if
        end if
    end for
end sub

' Movie libraries have the Collections tab (the Mac's LibraryView tabs)
function hasTabs() as boolean
    return feed() = "" and LCase(Util.toText(m.top.library.collectionType)) = "movies"
end function

sub enterBar()
    m.inBar = true
    m.top.findNode("barKeys").setFocus(true)
    drawBar()
end sub

sub leaveBar()
    m.inBar = false
    drawBar()
    if m.grid.content <> invalid and m.grid.content.getChildCount() > 0
        m.grid.setFocus(true)
    else
        m.top.setFocus(true)
    end if
end sub

sub useBar()
    id = m.barIds[m.barIdx]
    if id.startsWith("tab:")
        tabId = id.mid(4)
        if tabId <> m.tab
            m.tab = tabId
            drawBar()
            reload()
        end if
    else if id = "shuffle"
        startShuffle()
    else if id = "sort"
        openPicker("sort", "Sort by", [{ id: "name", label: "Name" }, { id: "added", label: "Date added" }, { id: "year", label: "Year" }, { id: "rating", label: "Rating" }], m.sort)
    else if id = "genre"
        o = [{ id: "", label: "All genres" }]
        for each g in m.genres
            o.push({ id: g, label: g })
        end for
        openPicker("genre", "Genre", o, m.genre)
    else if id = "letter"
        o = [{ id: "", label: "All" }, { id: "#", label: "#  (numbers and symbols)" }]
        for i = 65 to 90
            o.push({ id: chr(i), label: chr(i) })
        end for
        openPicker("letter", "Starts with", o, m.letter)
    else if id = "show"
        o = [{ id: "all", label: "All" }, { id: "unwatched", label: "Unwatched" }, { id: "watched", label: "Watched" }]
        ' (everything on the Favorites page is one already)
        if feed() <> "favorites" then o.push({ id: "favourites", label: "Favourites" })
        openPicker("show", "Show", o, m.show)
    end if
end sub

' ---------------------------------------------------------------- Shuffle

' A real library (not Favorites / Recently Added)
function canShuffle() as boolean
    return feed() = "" and Util.toText(m.top.library.id) <> "" and m.tab <> "collections"
end function

' Random titles of this library (with its Genre and Show choice) into the player as a queue
sub startShuffle()
    if m.shuffleTask <> invalid then return
    lib = m.top.library
    t = createObject("roSGNode", "ShuffleTask")
    t.server = m.top.server
    t.query = { libraryId: Util.toText(lib.id), collectionType: Util.toText(lib.collectionType), itemType: Util.toText(lib.itemType), genre: m.genre, show: m.show }
    t.observeField("result", "onShuffle")
    t.observeField("error", "onShuffleError")
    m.shuffleTask = t
    m.top.findNode("info").text = "Shuffling..."
    t.control = "RUN"
end sub

sub onShuffle(ev as object)
    m.shuffleTask = invalid
    updateInfo()
    list = ev.getData().queue
    if type(list) <> "roArray" or list.count() = 0
        m.top.findNode("info").text = "Nothing to shuffle here."
        return
    end if
    head = list[0]
    rest = []
    for i = 1 to list.count() - 1
        rest.push(list[i])
    end for
    title = Util.toText(head.Name)
    subtitle = ""
    if Util.toText(head.Type) = "Episode"
        title = Util.toText(head.SeriesName)
        subtitle = Items.episodeLabel(head)
    end if
    print "Cove: shuffle plays "; list.count(); " titles"
    m.top.action = { id: "play", itemId: Util.toText(head.Id), title: title, subtitle: subtitle, start: 0.0, queue: rest }
end sub

sub onShuffleError(ev as object)
    m.shuffleTask = invalid
    m.top.findNode("info").text = ev.getData()
end sub

sub loadPage(startIndex as integer, limit as integer)
    lib = m.top.library
    uid = Util.toText(m.top.server.userId)
    types = Items.typesFor(Util.toText(lib.collectionType))
    ' the Collections tab: the box sets with titles from this library (as the Mac asks for them)
    if m.tab = "collections" then types = "BoxSet"
    q = sortQuery() + "&StartIndex=" + startIndex.toStr() + "&Limit=" + limit.toStr() + "&" + Items.fields()
    if Util.toText(lib.id) <> "" then q = "ParentId=" + Util.toText(lib.id) + "&" + q
    ' A library: everything of its kind inside it; a folder / collection: just what it contains
    if feed() = "favorites"
        q = q + "&Recursive=true&IncludeItemTypes=Movie,Series,Episode,Video,BoxSet"
    else if feed() = "recent"
        q = q + "&Recursive=true&IncludeItemTypes=Movie,Series"
    else if types <> ""
        q = q + "&Recursive=true&IncludeItemTypes=" + types
    else if Util.toText(lib.itemType) = "CollectionFolder" or Util.toText(lib.itemType) = "UserView"
        q = q + "&Recursive=true&IncludeItemTypes=Movie,Series,Video"
    end if
    q = q + filterQuery()
    m.loading = true
    t = createObject("roSGNode", "ItemsTask")
    t.server = m.top.server
    t.path = "/Users/" + uid + "/Items?" + q
    t.fallback = "/Items?userId=" + uid + "&" + q
    t.startIndex = startIndex
    t.gen = m.gen
    t.observeField("result", "onPage")
    t.observeField("error", "onError")
    m.task = t
    t.control = "RUN"
end sub

sub onPage(ev as object)
    r = ev.getData()
    if r.gen <> m.gen then return
    m.loading = false
    m.total = r.total
    holder = r.nodes
    ' (a refresh replaces what was shown only now, so the grid doesn't go blank while it loads)
    if r.startIndex = 0 then m.grid.content = createObject("roSGNode", "ContentNode")
    nodes = []
    for i = 0 to holder.getChildCount() - 1
        nodes.push(holder.getChild(i))
    end for
    m.grid.content.appendChildren(nodes)
    count = m.grid.content.getChildCount()
    if count = 0
        m.status.text = "Nothing here."
        if feed() = "favorites" then m.status.text = "No favorites yet. Add titles with the heart on their page, or * on a card on Home."
        if m.tab = "collections" then m.status.text = "No collections in this library."
        if userFiltered() then m.status.text = "Nothing matches these filters. Press Up to change them."
        m.status.visible = true
    else
        m.status.visible = false
        if r.startIndex = 0 and m.top.isInFocusChain() and not m.inBar then m.grid.setFocus(true)
        if r.startIndex = 0 and m.keepIndex > 0
            k = m.keepIndex
            if k > count - 1 then k = count - 1
            m.grid.jumpToItem = k
        end if
    end if
    m.keepIndex = -1
    updateInfo()
end sub

sub onError(ev as object)
    ' (the answer to a page of an earlier sort / filter: the current request is still running)
    if ev.getRoSGNode().gen <> m.gen then return
    m.keepIndex = -1
    m.loading = false
    m.status.text = ev.getData()
    m.status.visible = true
end sub

sub updateInfo()
    s = m.total.toStr() + " titles"
    if m.total = 1 then s = "1 title"
    if m.tab = "collections"
        s = m.total.toStr() + " collections"
        if m.total = 1 then s = "1 collection"
    end if
    if filterQuery() <> "" and feed() = "" then s = s + "   ·   filtered"
    m.top.findNode("info").text = s
end sub

' Near the end of what's loaded: fetch the next 60
sub onFocused()
    if m.grid.content = invalid or m.top.library = invalid then return
    count = m.grid.content.getChildCount()
    if not m.loading and count < m.total and m.grid.itemFocused >= count - 21 then loadPage(count, 60)
end sub

sub onSelected()
    if m.grid.content = invalid then return
    it = m.grid.content.getChild(m.grid.itemSelected)
    if it <> invalid then m.top.action = { id: "open", itemId: it.itemId, itemType: it.itemType, collectionType: it.collectionType, title: it.title }
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press or m.picker <> invalid then return false
    if m.inBar
        if key = "left" and m.barIdx > 0
            m.barIdx = m.barIdx - 1
            drawBar()
        else if key = "right" and m.barIdx < m.barIds.count() - 1
            m.barIdx = m.barIdx + 1
            drawBar()
        else if key = "OK"
            useBar()
        else if key = "down"
            leaveBar()
        else if key = "back"
            return false
        end if
        return true
    end if
    ' Up from the top row of the grid, or *: the filter pills
    if key = "up" or key = "options"
        enterBar()
        return true
    end if
    return false
end function

sub openPicker(purpose as string, title as string, options as object, selectedId as string)
    p = createObject("roSGNode", "Picker")
    p.purpose = purpose
    p.title = title
    p.selectedId = selectedId
    p.options = options
    p.observeField("chosen", "onPicked")
    p.observeField("cancelled", "closePicker")
    m.top.appendChild(p)
    m.picker = p
    p.setFocus(true)
end sub

sub closePicker()
    if m.picker <> invalid
        m.picker.unobserveField("chosen")
        m.picker.unobserveField("cancelled")
        m.top.removeChild(m.picker)
        m.picker = invalid
    end if
    if m.inBar
        m.top.findNode("barKeys").setFocus(true)
    else
        m.top.setFocus(true)
    end if
    drawBar()
end sub

sub onPicked(ev as object)
    id = ev.getData().id
    purpose = m.picker.purpose
    closePicker()
    if purpose = "sort"
        m.sort = id
    else if purpose = "genre"
        m.genre = id
    else if purpose = "letter"
        m.letter = id
    else if purpose = "show"
        m.show = id
    end if
    saveFilters()
    drawBar()
    reload()
end sub

sub onFocusChanged()
    if m.top.stale and m.top.isInFocusChain()
        m.top.stale = false
        onRefresh()
    end if
    if not m.top.hasFocus() then return
    if m.picker <> invalid
        m.picker.setFocus(true)
    else if not m.inBar and m.grid.content <> invalid and m.grid.content.getChildCount() > 0
        m.grid.setFocus(true)
    end if
end sub
