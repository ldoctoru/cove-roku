import "pkg:/source/Util.bs"
import "pkg:/source/QuickPlay.bs"
import "pkg:/source/Items.bs"
import "pkg:/source/Prefs.bs"
import "pkg:/source/Speak.bs"
import "pkg:/source/Toasts.bs"
import "pkg:/source/LibGrid.bs"

sub init()
    m.grid = m.top.findNode("grid")
    m.status = m.top.findNode("status")
    m.errorPanel = m.top.findNode("errorPanel")
    m.errorPanel.observeField("chosen", "onErrorChosen")
    m.skeleton = m.top.findNode("skeleton")
    m.grid.observeField("itemFocused", "onFocused")
    ' (v1.5) faint backdrop of the focused title (bottom fade into the page colour)
    t = m.global.theme
    m.bdFront = m.top.findNode("bdA")
    m.bdBack = m.top.findNode("bdB")
    m.bdUrl = ""
    m.bdPending = ""
    m.top.findNode("bdScrim").uri = t.scrimBottom
    m.top.findNode("bdShade").color = Util.toText(t.bg).left(8) + "66"
    m.bdTimer = m.top.findNode("bdTimer")
    m.bdTimer.observeField("fire", "onBackdropTimer")
    m.bdFront.observeField("loadStatus", "onBackdropLoaded")
    m.grid.observeField("itemSelected", "onSelected")
    m.top.observeField("focusedChild", "onFocusChanged")
    m.sort = "name"
    m.order = ""          ' (v1.1 P-4) "" = the sort's own direction (Name A to Z, the others newest / highest first), "asc" / "desc"
    m.show = "all"          ' all / unwatched / watched / favourites
    m.genre = ""
    m.letter = ""
    m.tab = "main"        ' main / collections (movie libraries)
    m.defSort = "name"     ' the Settings → Libraries defaults (saveFilters keeps only changes from them)
    m.defShow = "all"
    m.genres = []
    m.inBar = false
    m.barIdx = 0
    m.barIds = []
    m.total = 0
    m.nextStart = 0         ' the server offset of the next page (R-3)
    m.loading = false
    m.gen = 0
    m.task = invalid
    m.picker = invalid
    m.shuffleTask = invalid
    m.keepIndex = -1        ' refresh: the card to focus again once the first page is back
    m.phCount = 0           ' (SP-6) placeholder cards at the end of the grid while the next page loads
    ' (v1.2 NV-14) the card this page was left on, kept for the session (m.global.libPositions, not the registry)
    m.restoring = false
    m.restoreId = ""
    m.restoreClock = createObject("roTimespan")
    m.posTimer = m.top.findNode("posTimer")
    m.posTimer.observeField("fire", "rememberPosition")
    m.wasShown = false
    ' (NV page keys) Rewind / Fast Forward: presses in a row speed up; the letter shows after a jump
    m.jumpClock = createObject("roTimespan")
    m.jumpStreak = 0
    m.jumpForward = true
    m.lastFocus = 0
    m.letterBox = m.top.findNode("letterBox")
    m.letterTimer = m.top.findNode("letterTimer")
    m.letterTimer.observeField("fire", "hideLetter")
    ' (the grid gets focus as soon as the screen is shown, before the library is set: never leave it without content)
    m.grid.content = createObject("roSGNode", "ContentNode")
    ' Audio Guide: Cove says the cards and the pills itself (the last pill said, so a redraw stays quiet)
    m.spokenKey = ""
    Speak.mute([m.grid, m.top.findNode("barKeys")])
end sub

sub onLibrary()
    m.top.findNode("title").text = Util.toText(m.top.library.title)
    layoutHeader()
    ' Recently Added: newest first (as on the Mac); a library opens with its Settings → Libraries sort and filter
    if feed() = "recent"
        m.sort = "added"
    else if Util.toText(m.top.library.id) <> ""
        lp = Prefs.library(Util.toText(m.top.library.id))
        sortMap = { name: "name", latest: "added", release: "year", top: "rating" }
        if sortMap.doesExist(lp.sort) then m.sort = sortMap[lp.sort]
        if lp.show = "unwatched" or lp.show = "watched" then m.show = lp.show
        ' then what was chosen here last time (Mac LibraryView lf-<id>): sort, show, genre, A–Z
        m.defSort = m.sort
        m.defShow = m.show
        saved = Prefs.libFilters(Util.toText(m.top.library.id))
        if saved <> invalid
            sv = Util.toText(saved.s)
            if sv = "name" or sv = "added" or sv = "year" or sv = "rating" then m.sort = sv
            sv = Util.toText(saved.o)
            if sv = "a" then m.order = "asc"
            if sv = "d" then m.order = "desc"
            sv = Util.toText(saved.w)
            if sv = "all" or sv = "unwatched" or sv = "watched" or sv = "favourites" then m.show = sv
            m.genre = Util.toText(saved.g)
            m.letter = Util.toText(saved.l)
            print "Cove: library filters kept: "; m.sort; " "; m.order; " / "; m.show; " / "; m.genre; " / "; m.letter
        end if
    end if
    drawBar()
    m.restoreClock.Mark()
    findPosition()
    reload(m.restoring)
    ' (a genre / studio page: no Genre pill of its own)
    if feed() <> "tag" then loadGenres()
end sub

' (VD-1) The info line right after the title, on the same line (the title is cut at 1000 px)
sub layoutHeader()
    t = m.top.findNode("title")
    t.width = 0
    w = Int(t.boundingRect().width) + 4
    if w > 1000 then w = 1000
    ' (a fixed width and height, so vertAlign="bottom" lines the title up with the info line)
    t.width = w
    m.top.findNode("info").translation = [172 + Int(w) + 28, 30]
end sub

' ---------------------------------------------------------------- (v1.2 NV-14) position for the session

' This page with its current tab, sort and filters, as the key of m.global.libPositions
function positionKeyNow() as string
    if m.top.library = invalid or m.top.server = invalid then return ""
    lib = m.top.library
    scope = Util.toText(lib.id)
    if feed() <> "" then scope = feed() + ":" + Util.toText(lib.tagKind) + ":" + Util.toText(lib.tagId) + ":" + Util.toText(lib.tagName)
    return LibGrid.positionKey(Util.toText(m.top.server.url), Util.toText(m.top.server.userId), scope, m.tab, m.sort, m.order, m.show, m.genre, m.letter)
end function

' Opening the page: the card it was left on this session with the same sort and filters (keepIndex for onPage)
sub findPosition()
    m.restoring = false
    m.restoreId = ""
    if not m.global.hasField("libPositions") then return
    kept = m.global.libPositions
    k = positionKeyNow()
    if not Util.isAA(kept) or k = "" or not Util.isAA(kept[k]) then return
    i = Util.toNumber(kept[k].i)
    if i <= 0 then return
    m.keepIndex = Int(i)
    m.restoreId = Util.toText(kept[k].id)
    m.restoring = true
end sub

' The focused card for this page's key (on a 0.5 s rest of the focus and when the page loses the focus)
sub rememberPosition()
    if m.grid.content = invalid or realCount() = 0 or m.restoring then return
    f = m.grid.itemFocused
    c = m.grid.content.getChild(f)
    if f < 0 or c = invalid or isPlaceholder(c) then return
    k = positionKeyNow()
    if k = "" then return
    if not m.global.hasField("libPositions") then m.global.addFields({ libPositions: {} })
    kept = m.global.libPositions
    if not Util.isAA(kept) then kept = {}
    old = kept[k]
    if Util.isAA(old) and Util.toNumber(old.i) = f then return
    ' (kept small: cleared when it grows past 32 pages)
    if kept.count() >= 32 and not kept.doesExist(k) then kept = {}
    kept[k] = { i: f, id: Util.toText(c.itemId) }
    m.global.libPositions = kept
end sub

' The card to land on once the first request is in: the remembered title (it may have moved a little when titles
' were added), else the remembered index, else the last loaded card with a toast. Prints the timing line.
function restoredIndex(count as integer) as integer
    k = LibGrid.restoreTarget(m.keepIndex, count)
    content = m.grid.content
    if m.restoreId <> "" and k >= 0
        c = content.getChild(k)
        if c = invalid or Util.toText(c.itemId) <> m.restoreId
            for i = 0 to count - 1
                c = content.getChild(i)
                if c <> invalid and Util.toText(c.itemId) = m.restoreId
                    k = i
                    exit for
                end if
            end for
        end if
    end if
    if k >= 0 and m.keepIndex > count - 1 and count < m.total
        ' (past what one request may load: the nearest loaded titles instead of a long wait)
        Toasts.notify("Back near where you were", "info")
    end if
    print "Cove: library "; m.restoreClock.TotalMilliseconds(); " restored at "; k
    return k
end function

' The page's choices for the next visit (only what differs from the Settings → Libraries defaults)
sub saveFilters()
    libId = Util.toText(m.top.library.id)
    if feed() <> "" or libId = "" then return
    f = { g: m.genre, l: m.letter }
    if m.sort <> m.defSort then f.s = m.sort
    if m.show <> m.defShow then f.w = m.show
    if m.order = "asc" then f.o = "a"
    if m.order = "desc" then f.o = "d"
    Prefs.setLibFilters(libId, f)
end sub

sub reload(restore = false as boolean)
    m.gen = m.gen + 1
    firstLimit = LibGrid.firstPage()
    ' (v1.2 NV-14) back on a remembered card: one request that reaches it (36 + 96 ..., at most restoreCap);
    ' any other reload (a new sort or filter, Try Again) starts at the top
    m.restoring = restore and m.keepIndex > 0
    if m.restoring
        firstLimit = LibGrid.restoreLimit(m.keepIndex, LibGrid.restoreCap())
    else
        m.keepIndex = -1
    end if
    m.total = 0
    m.nextStart = 0
    m.grid.content = createObject("roSGNode", "ContentNode")
    m.phCount = 0
    m.lastFocus = 0
    hideLetter()
    m.status.text = "Loading..."
    ' (U-7: placeholder cards instead of the text)
    m.status.visible = false
    m.skeleton.active = true
    hidePanel()
    ' (v1.1.1 SP-6: a small first page paints sooner; the next 96 are asked for as soon as it is in)
    loadPage(0, firstLimit)
end sub

' Back on this page after a favourite / watched change or playback (MainScene sets "stale"): load it again,
' keeping the grid on screen until the new items arrive and the focus on the same card
sub onRefresh()
    if m.top.library = invalid or m.top.server = invalid then return
    m.gen = m.gen + 1
    m.keepIndex = m.grid.itemFocused
    ' (enough items in one request to reach the focused card)
    limit = 60
    if m.keepIndex >= 40 then limit = (Int((m.keepIndex + 21) / 60) + 1) * 60
    loadPage(0, limit)
end sub

function sortQuery() as string
    dir = "Ascending"
    if sortDescending() then dir = "Descending"
    if m.sort = "added" then return "SortBy=DateCreated,SortName&SortOrder=" + dir
    if m.sort = "year" then return "SortBy=ProductionYear,PremiereDate,SortName&SortOrder=" + dir
    if m.sort = "rating" then return "SortBy=CommunityRating,SortName&SortOrder=" + dir
    return "SortBy=SortName&SortOrder=" + dir
end function

' (v1.1 P-4, Mac "Order") The direction: the chosen one, else the sort's own (Name A to Z, the others descending)
function sortDescending() as boolean
    if m.order = "asc" then return false
    if m.order = "desc" then return true
    return m.sort <> "name"
end function

' The Order pill: "Ascending" / "Descending", as on the Mac
function orderLabel() as string
    if sortDescending() then return "Descending"
    return "Ascending"
end function

' OK on the Order pill: the other direction ("" again when that is the sort's own, so nothing extra is saved)
sub toggleOrder()
    wantDesc = not sortDescending()
    m.order = "asc"
    if wantDesc then m.order = "desc"
    if wantDesc = (m.sort <> "name") then m.order = ""
    print "Cove: library order "; orderLabel()
    m.spokenKey = ""
    saveFilters()
    drawBar()
    reload()
end sub

function sortLabel() as string
    if m.sort = "added" then return "Date Added"
    if m.sort = "year" then return "Year"
    if m.sort = "rating" then return "Rating"
    return "Name"
end function

function showLabel() as string
    if m.show = "unwatched" then return "Unwatched"
    if m.show = "watched" then return "Watched"
    if m.show = "favourites" then return "Favorites"
    return "All"
end function

' "" for a library; "favorites" / "recent" for the sidebar pages of the same name (no parent library)
function feed() as string
    l = m.top.library
    if l = invalid or l.feed = invalid then return ""
    return Util.toText(l.feed)
end function

function filterQuery() as string
    q = ""
    flags = []
    if m.show = "unwatched" then flags.push("IsUnplayed")
    if m.show = "watched" then flags.push("IsPlayed")
    if m.show = "favourites" or feed() = "favorites" then flags.push("IsFavorite")   ' (once, also on Favorites)
    if flags.count() > 0 then q = q + "&Filters=" + Util.join(flags, ",")
    if m.genre <> "" then q = q + "&Genres=" + m.genre.encodeUriComponent()
    if m.letter = "#"
        q = q + "&NameLessThan=A"
    else if m.letter <> ""
        q = q + "&NameStartsWith=" + m.letter
    end if
    return q
end function

' (v1.1) A genre / studio page (from the pills on a details page): GenreIds / StudioIds on both Emby and
' Jellyfin; without an id the name (Genres= / Studios=, "|" separates several names, so it is dropped)
function tagQuery(lib as object) as string
    id = Util.toText(lib.tagId)
    name = Util.toText(lib.tagName).replace("|", " ")
    if Util.toText(lib.tagKind) = "Studio"
        if Util.isSafeId(id, false) then return "&StudioIds=" + id
        return "&Studios=" + name.encodeUriComponent()
    end if
    if Util.isSafeId(id, false) then return "&GenreIds=" + id
    return "&Genres=" + name.encodeUriComponent()
end function

function tagTypesOf(lib as object) as string
    t = Util.toText(lib.tagTypes)
    if t = "Movie" or t = "Series" then return t
    return "Movie,Series"
end function

' A filter the user picked (the Favorites page's own IsFavorite doesn't count)
function userFiltered() as boolean
    return m.show <> "all" or m.genre <> "" or m.letter <> ""
end function

' The library's genres for the Genre pill (v1.1.1 SP-20: names only, no images / user data / count, and kept
' for the session per server, user and library, so opening the library again asks nothing)
sub loadGenres()
    lib = m.top.library
    uid = Util.toText(m.top.server.userId)
    q = "UserId=" + uid + "&SortBy=SortName&Recursive=true&EnableImages=false&EnableUserData=false" + Items.noCount()
    if Util.toText(lib.id) <> "" then q = q + "&ParentId=" + Util.toText(lib.id)
    types = Items.typesFor(Util.toText(lib.collectionType))
    if types <> "" then q = q + "&IncludeItemTypes=" + types
    m.genreKey = Util.toText(m.top.server.url) + "|" + uid + "|" + Util.toText(lib.id) + "|" + types
    cache = invalid
    if m.global.hasField("genreCache") then cache = m.global.genreCache
    if Util.isAA(cache) and type(cache[m.genreKey]) = "roArray"
        m.genres = cache[m.genreKey]
        print "Cove: library genres from the session cache ("; m.genres.count(); ")"
        drawBar()
        return
    end if
    t = createObject("roSGNode", "ItemsTask")
    t.server = m.top.server
    t.path = "/Genres?" + q
    t.fallback = ""
    t.kind = "names"
    t.observeField("result", "onGenres")
    m.genreTask = t
    t.control = "RUN"
end sub

sub onGenres(ev as object)
    m.genres = ev.getData().names
    if type(m.genres) <> "roArray" then m.genres = []
    ' (kept small: a few libraries per server, cleared when it grows past 24)
    if not m.global.hasField("genreCache") then m.global.addFields({ genreCache: {} })
    cache = m.global.genreCache
    if not Util.isAA(cache) or cache.count() >= 24 then cache = {}
    cache[m.genreKey] = m.genres
    m.global.genreCache = cache
    drawBar()
end sub

' ---------------------------------------------------------------- pills: Sort, Genre, A-Z, Show

sub drawBar()
    b = m.top.findNode("bar")
    b.removeChildrenIndex(b.getChildCount(), 0)
    ids = []
    texts = []
    ' Movie libraries: the Mac's tabs <library> | Collections (its box sets)
    if hasTabs()
        ids.push("tab:main")
        texts.push(Util.toText(m.top.library.title))
        ids.push("tab:collections")
        texts.push("Collections")
    end if
    ' Shuffle (Mac library controls): random unwatched titles / episodes, back to back
    if canShuffle()
        ids.push("shuffle")
        texts.push("Shuffle")
    end if
    ids.push("sort")
    texts.push("Sort: " + sortLabel())
    ids.push("order")
    texts.push("Order: " + orderLabel())
    if m.genres.count() > 0
        ids.push("genre")
        g = "All"
        if m.genre <> "" then g = m.genre
        texts.push("Genre: " + g)
    end if
    ids.push("letter")
    l = "All"
    if m.letter <> "" then l = m.letter
    texts.push("A-Z: " + l)
    ids.push("show")
    texts.push("Show: " + showLabel())
    m.barIds = ids
    if m.barIdx >= ids.count() then m.barIdx = ids.count() - 1
    x = 0
    focused = m.inBar and m.picker = invalid
    for i = 0 to ids.count() - 1
        isFocus = focused and i = m.barIdx
        active = (ids[i] = "genre" and m.genre <> "") or (ids[i] = "letter" and m.letter <> "") or (ids[i] = "show" and m.show <> "all") or (ids[i] = "sort" and m.sort <> "name") or (ids[i] = "order" and m.order <> "")
        g = b.createChild("Group")
        bg = g.createChild("Poster")
        lab = g.createChild("Label")
        f = createObject("roSGNode", "Font")
        f.uri = "font:MediumSystemFontFile"
        f.size = 26
        lab.font = f
        lab.text = texts[i]
        lab.height = 52
        lab.vertAlign = "center"
        lab.translation = [24, 0]
        isTab = ids[i].startsWith("tab:")
        ' (v1.1.1 VD-23) an active filter: white text and a white dot before the label (v1.5: no accent; the
        ' dot keeps its dark edge so it reads on the focused white pill too)
        dotW = 0
        if active and not isTab then dotW = 16
        w = lab.boundingRect().width + 84 + dotW
        ' (an action or a tab, not a choice: no chevron)
        if ids[i] = "shuffle" or ids[i] = "order" or isTab then w = lab.boundingRect().width + 48 + dotW
        if dotW > 0
            lab.translation = [24 + dotW, 0]
            edge = g.createChild("Poster")
            edge.uri = "pkg:/images/ui/dot_10.png"
            edge.blendColor = "0x000000CC"
            edge.width = 12
            edge.height = 12
            edge.translation = [19, 20]
            dot = g.createChild("Poster")
            dot.uri = "pkg:/images/ui/dot_10.png"
            dot.blendColor = "0xFFFFFFFF"
            if isFocus then dot.blendColor = m.global.theme.onFocus
            dot.width = 8
            dot.height = 8
            dot.translation = [21, 22]
        end if
        bg.width = w
        bg.height = 52
        ch = g.createChild("Poster")
        ch.uri = "pkg:/images/ui/icon_chevron_28.png"
        ch.width = 22
        ch.height = 22
        ch.translation = [w - 44, 15]
        ch.visible = ids[i] <> "shuffle" and ids[i] <> "order" and not isTab
        ' (v1.5 flat) flat pills: controlFill at rest (an active filter or the chosen tab 22 %), focused =
        ' solid white with dark text; no glass, fog or ring
        bg.uri = "pkg:/images/ui/flat_pill_52.9.png"
        bg.opacity = 0.12
        if isFocus
            bg.opacity = 1.0
            lab.color = m.global.theme.onFocus
        else if isTab
            ' tabs sit together in one faint capsule (drawn below), the chosen one lit as on the Mac
            bg.uri = ""
            lab.color = "0xFFFFFFCC"
            if ids[i] = "tab:" + m.tab
                bg.uri = "pkg:/images/ui/flat_pill_52.9.png"
                bg.opacity = 0.22
                lab.color = "0xFFFFFFFF"
            end if
        else
            lab.color = "0xFFFFFFEB"
            if active
                bg.opacity = 0.22
                lab.color = "0xFFFFFFFF"
            end if
        end if
        ch.blendColor = lab.color
        if isTab and x = 0 then x = 6
        g.translation = [x, 0]
        x = x + w + 16
        if isTab
            x = x - 12
            if i + 1 >= ids.count() or not ids[i + 1].startsWith("tab:")
                ' the capsule behind the tabs, then the usual gap
                cap = createObject("roSGNode", "Poster")
                cap.uri = "pkg:/images/ui/flat_pill_60.9.png"
                cap.opacity = 0.08
                cap.width = x + 2
                cap.height = 64
                cap.translation = [0, -6]
                b.insertChild(cap, 0)
                x = x + 2 + 22
            end if
        end if
    end for
    if focused then speakBar(texts)
end sub

' Audio Guide: the focused pill, "Sort: Name, menu button, 2 of 6"; the library's name first on the way in
sub speakBar(texts as object)
    if not Speak.isOn() or m.barIdx >= texts.count() then return
    id = m.barIds[m.barIdx]
    text = texts[m.barIdx]
    if id = "letter"
        text = "Starts with: " + text.mid(5)
    else if id.startsWith("tab:")
        text = text + ", tab"
        if id = "tab:" + m.tab then text = text + ", selected"
    else if id = "order"
        text = "Sort order: " + orderLabel() + ", press OK to reverse"
    else if id <> "shuffle"
        text = text + ", menu"
    end if
    key = m.barIdx.toStr() + text
    if key = m.spokenKey then return
    first = m.spokenKey = ""
    m.spokenKey = key
    text = Speak.button(text) + Speak.position(m.barIdx, texts.count())
    if first then text = Util.toText(m.top.library.title) + ", filters. " + text
    Speak.say(text)
end sub

' Movie libraries have the Collections tab (the Mac's LibraryView tabs)
function hasTabs() as boolean
    return feed() = "" and LCase(Util.toText(m.top.library.collectionType)) = "movies"
end function

sub enterBar()
    m.inBar = true
    m.spokenKey = ""
    m.top.findNode("barKeys").setFocus(true)
    drawBar()
end sub

sub leaveBar()
    m.inBar = false
    drawBar()
    if m.grid.content <> invalid and m.grid.content.getChildCount() > 0
        m.grid.setFocus(true)
    else if m.errorPanel.visible
        m.errorPanel.setFocus(true)
    else
        m.top.setFocus(true)
    end if
end sub

sub useBar()
    id = m.barIds[m.barIdx]
    if id.startsWith("tab:")
        tabId = id.mid(4)
        if tabId <> m.tab
            m.tab = tabId
            drawBar()
            reload()
        end if
    else if id = "shuffle"
        startShuffle()
    else if id = "order"
        toggleOrder()
    else if id = "sort"
        openPicker("sort", "Sort by", [{ id: "name", label: "Name" }, { id: "added", label: "Date Added" }, { id: "year", label: "Year" }, { id: "rating", label: "Rating" }], m.sort)
    else if id = "genre"
        o = [{ id: "", label: "All Genres" }]
        for each g in m.genres
            o.push({ id: g, label: g })
        end for
        openPicker("genre", "Genre", o, m.genre)
    else if id = "letter"
        o = [{ id: "", label: "All" }, { id: "#", label: "#  (numbers and symbols)" }]
        for i = 65 to 90
            o.push({ id: chr(i), label: chr(i) })
        end for
        openPicker("letter", "Starts with", o, m.letter)
    else if id = "show"
        o = [{ id: "all", label: "All" }, { id: "unwatched", label: "Unwatched" }, { id: "watched", label: "Watched" }]
        ' (everything on the Favorites page is one already)
        if feed() <> "favorites" then o.push({ id: "favourites", label: "Favorites" })
        openPicker("show", "Show", o, m.show)
    end if
end sub

' ---------------------------------------------------------------- Shuffle

' A real library (not Favorites / Recently Added)
function canShuffle() as boolean
    return feed() = "" and Util.toText(m.top.library.id) <> "" and m.tab <> "collections"
end function

' Random titles of this library (with its Genre and Show choice) into the player as a queue
sub startShuffle()
    if m.shuffleTask <> invalid then return
    lib = m.top.library
    t = createObject("roSGNode", "ShuffleTask")
    t.server = m.top.server
    t.query = { libraryId: Util.toText(lib.id), collectionType: Util.toText(lib.collectionType), itemType: Util.toText(lib.itemType), genre: m.genre, show: m.show }
    t.observeField("result", "onShuffle")
    t.observeField("error", "onShuffleError")
    m.shuffleTask = t
    m.top.findNode("info").text = "Shuffling..."
    t.control = "RUN"
end sub

sub onShuffle(ev as object)
    m.shuffleTask = invalid
    updateInfo()
    list = ev.getData().queue
    if type(list) <> "roArray" or list.count() = 0
        m.top.findNode("info").text = "Nothing to shuffle here."
        return
    end if
    head = list[0]
    rest = []
    for i = 1 to list.count() - 1
        rest.push(list[i])
    end for
    title = Util.toText(head.Name)
    subtitle = ""
    if Util.toText(head.Type) = "Episode"
        title = Util.toText(head.SeriesName)
        subtitle = Items.episodeLabel(head)
    end if
    print "Cove: shuffle plays "; list.count(); " titles"
    m.top.action = { id: "play", itemId: Util.toText(head.Id), title: title, subtitle: subtitle, start: 0.0, queue: rest }
end sub

sub onShuffleError(ev as object)
    m.shuffleTask = invalid
    m.top.findNode("info").text = ev.getData()
end sub

sub loadPage(startIndex as integer, limit as integer)
    lib = m.top.library
    uid = Util.toText(m.top.server.userId)
    types = Items.typesFor(Util.toText(lib.collectionType))
    ' the Collections tab: the box sets with titles from this library (as the Mac asks for them)
    if m.tab = "collections" then types = "BoxSet"
    ' (v1.1.1 SP-7: the slim card fields; the total only with the first page, the next pages keep it)
    ' (v1.5) plus the Backdrop tag, for the faint backdrop of the focused title
    q = sortQuery() + "&StartIndex=" + startIndex.toStr() + "&Limit=" + limit.toStr() + "&" + Items.slimFields(false).replace("EnableImageTypes=Primary", "EnableImageTypes=Primary,Backdrop")
    if startIndex > 0 then q = q + Items.noCount()
    if Util.toText(lib.id) <> "" then q = "ParentId=" + Util.toText(lib.id) + "&" + q
    ' A library: everything of its kind inside it; a folder / collection: just what it contains
    if feed() = "tag"
        q = q + "&Recursive=true&IncludeItemTypes=" + tagTypesOf(lib) + tagQuery(lib)
    else if feed() = "favorites"
        q = q + "&Recursive=true&IncludeItemTypes=Movie,Series,Episode,Video,BoxSet"
    else if feed() = "recent"
        q = q + "&Recursive=true&IncludeItemTypes=Movie,Series"
    else if types <> ""
        q = q + "&Recursive=true&IncludeItemTypes=" + types
    else if Util.toText(lib.itemType) = "CollectionFolder" or Util.toText(lib.itemType) = "UserView"
        q = q + "&Recursive=true&IncludeItemTypes=Movie,Series,Video"
    end if
    q = q + filterQuery()
    m.loading = true
    t = createObject("roSGNode", "ItemsTask")
    t.server = m.top.server
    t.path = "/Users/" + uid + "/Items?" + q
    t.fallback = "/Items?userId=" + uid + "&" + q
    t.startIndex = startIndex
    t.gen = m.gen
    t.observeField("result", "onPage")
    t.observeField("error", "onError")
    m.task = t
    t.control = "RUN"
    if startIndex > 0 then addPlaceholders()
end sub

' The cards loaded so far, without the placeholders at the end
function realCount() as integer
    if m.grid.content = invalid then return 0
    n = m.grid.content.getChildCount() - m.phCount
    if n < 0 then n = 0
    return n
end function

' (SP-6) Skeleton cards after the last loaded one while the next page loads: the rest of the row plus a row,
' so scrolling into the end shows that more is coming instead of stopping dead
sub addPlaceholders()
    content = m.grid.content
    if content = invalid or m.phCount > 0 or content.getChildCount() = 0 then return
    n = LibGrid.placeholderCount(content.getChildCount(), LibGrid.cols())
    nodes = []
    for i = 1 to n
        c = createObject("roSGNode", "ContentNode")
        c.addFields({ kind: "placeholder", itemId: "", itemType: "", landscape: false })
        nodes.push(c)
    end for
    content.appendChildren(nodes)
    m.phCount = n
end sub

sub removePlaceholders()
    if m.phCount <= 0 or m.grid.content = invalid then return
    m.grid.content.removeChildrenIndex(m.phCount, realCount())
    m.phCount = 0
end sub

sub onPage(ev as object)
    r = ev.getData()
    if r.gen <> m.gen then return
    m.loading = false
    m.skeleton.active = false
    ' (later pages are asked without the count: the first page's total stays)
    if r.startIndex = 0 then m.total = r.total
    ' (R-3: the next page starts at the server's offset; the rating limit may have dropped titles from this one)
    served = Util.toNumber(r.served)
    m.nextStart = r.startIndex + served
    if served = 0 then m.nextStart = m.total
    holder = r.nodes
    ' (a refresh replaces what was shown only now, so the grid doesn't go blank while it loads)
    if r.startIndex = 0
        m.grid.content = createObject("roSGNode", "ContentNode")
        m.phCount = 0
    end if
    nodes = []
    for i = 0 to holder.getChildCount() - 1
        nodes.push(holder.getChild(i))
    end for
    ' (SP-6) the new cards take the placeholders' places first, so a focus resting on one stays put
    content = m.grid.content
    firstPh = realCount()
    used = 0
    while used < nodes.count() and used < m.phCount
        content.replaceChild(nodes[used], firstPh + used)
        used = used + 1
    end while
    if used < m.phCount then content.removeChildrenIndex(m.phCount - used, firstPh + used)
    m.phCount = 0
    if used < nodes.count()
        rest = []
        for i = used to nodes.count() - 1
            rest.push(nodes[i])
        end for
        content.appendChildren(rest)
    end if
    count = content.getChildCount()
    if count = 0
        ' (v1.1.1 VD-20: an empty page looks unlike a failed one: a glyph, a title and a hint)
        noun = kindNoun()
        title = "Nothing here yet"
        detail = "This library has no " + noun + "."
        if feed() = "favorites"
            title = "No favorites yet"
            detail = "Add titles with the heart on their page, or with * on a card on Home."
        end if
        if m.tab = "collections"
            title = "No collections in this library"
            detail = "Collections appear here once the server groups titles into them."
        end if
        buttons = [{ id: "retry", label: "Try Again" }]
        if userFiltered()
            ' (U-8: one press back to everything)
            title = "Nothing matches these filters"
            detail = "Clear the filters to see everything."
            if m.show = "unwatched" and m.genre = "" and m.letter = ""
                title = "No unwatched " + noun
                detail = "Change Show to All to see watched titles too."
            end if
            buttons = [{ id: "clear", label: "Clear Filters" }, { id: "filters", label: "Change Filters" }]
        end if
        showEmpty(title, detail, buttons)
    else
        m.status.visible = false
        hidePanel()
        if r.startIndex = 0 and m.top.isInFocusChain() and not m.inBar then m.grid.setFocus(true)
        if r.startIndex = 0 then m.lastFocus = 0
        if r.startIndex = 0 and m.keepIndex > 0
            k = m.keepIndex
            if k > count - 1 then k = count - 1
            if m.restoring then k = restoredIndex(count)
            ' (a refresh back to the same card is not a page jump: no letter)
            m.lastFocus = k
            m.grid.jumpToItem = k
        end if
    end if
    m.keepIndex = -1
    m.restoring = false
    updateInfo()
    ' (a page thinned out by the rating limit: keep going while the focus is still near the end)
    if count > 0 then pageMore(count)
end sub

sub onError(ev as object)
    ' (the answer to a page of an earlier sort / filter: the current request is still running)
    if ev.getRoSGNode().gen <> m.gen then return
    m.keepIndex = -1
    m.restoring = false
    m.loading = false
    m.skeleton.active = false
    removePlaceholders()
    ' (a refresh or the next page failed while titles are shown: keep them)
    if m.grid.content <> invalid and m.grid.content.getChildCount() > 0
        if m.top.isInFocusChain() then Toasts.notify("Couldn't load more titles. " + Util.toText(ev.getData()), "info")
        return
    end if
    showPanel(Util.toText(ev.getData()), "error", [{ id: "retry", label: "Try Again" }, { id: "switch", label: "Switch Server" }, { id: "settings", label: "Settings" }])
end sub

' ---------------------------------------------------------------- error / empty panel

' What the page lists, for the empty-page lines: "movies", "shows", "collections", "titles"
function kindNoun() as string
    if m.tab = "collections" then return "collections"
    ct = LCase(Util.toText(m.top.library.collectionType))
    if feed() = "" and ct = "movies" then return "movies"
    if feed() = "" and ct = "tvshows" then return "shows"
    return "titles"
end function

' (VD-20) The empty-page glyph: heart on Favorites, film for movies, tv for shows, folder otherwise
function emptyGlyph() as string
    if feed() = "favorites" then return "heart"
    if m.tab = "collections" then return "folder"
    ct = LCase(Util.toText(m.top.library.collectionType))
    if ct = "movies" then return "film"
    if ct = "tvshows" then return "tv"
    return "folder"
end function

sub showEmpty(title as string, detail as string, buttons as object)
    m.errorPanel.detail = detail
    m.errorPanel.glyph = emptyGlyph()
    showPanel(title, "info", buttons)
end sub

sub showPanel(text as string, icon as string, buttons as object)
    m.status.visible = false
    ' (an error keeps the small icon; showEmpty sets the glyph after this reset)
    if icon = "error"
        m.errorPanel.glyph = ""
        m.errorPanel.detail = ""
    end if
    m.errorPanel.icon = icon
    m.errorPanel.buttons = buttons
    m.errorPanel.message = text
    m.errorPanel.index = 0
    m.errorPanel.visible = true
    if m.top.isInFocusChain() and not m.inBar and m.picker = invalid then m.errorPanel.setFocus(true)
end sub

sub hidePanel()
    if not m.errorPanel.visible then return
    hadFocus = m.errorPanel.isInFocusChain()
    m.errorPanel.visible = false
    if hadFocus then m.top.setFocus(true)
end sub

sub onErrorChosen(ev as object)
    id = ev.getData().id
    if id = "retry"
        reload()
    else if id = "clear"
        m.show = "all"
        m.genre = ""
        m.letter = ""
        saveFilters()
        drawBar()
        reload()
    else if id = "filters"
        enterBar()
    else if id = "switch" or id = "settings"
        m.top.action = { id: id }
    end if
end sub

sub updateInfo()
    s = m.total.toStr() + " titles"
    if m.total = 1 then s = "1 title"
    if m.tab = "collections"
        s = m.total.toStr() + " collections"
        if m.total = 1 then s = "1 collection"
    end if
    if filterQuery() <> "" and feed() = "" then s = s + "   ·   filtered"
    m.top.findNode("info").text = s
end sub

' Near the end of what's loaded: fetch the next page
sub onFocused()
    if m.grid.content = invalid or m.top.library = invalid then return
    count = realCount()
    ' (a jump of a screen or more, by our page keys or the grid's own: the letter of where it landed)
    f = m.grid.itemFocused
    jump = f - m.lastFocus
    if jump < 0 then jump = -jump
    m.lastFocus = f
    if jump >= LibGrid.cols() * 2 then showLetter(f)
    queueBackdrop(f)
    ' (v1.2 NV-14) kept once the focus rests (a removed page's timer stops, so this also covers Back)
    if not m.restoring and m.grid.isInFocusChain()
        m.posTimer.control = "stop"
        m.posTimer.control = "start"
    end if
    if not m.inBar and m.picker = invalid and m.grid.isInFocusChain() and Speak.isOn()
        c = m.grid.content.getChild(m.grid.itemFocused)
        if c <> invalid and isPlaceholder(c)
            Speak.say("Loading")
        else if c <> invalid
            Speak.say(Speak.card(c) + Speak.position(m.grid.itemFocused, m.total))
        end if
    end if
    pageMore(count)
end sub

function isPlaceholder(c as dynamic) as boolean
    return c <> invalid and c.hasField("kind") and c.kind = "placeholder"
end function

' (SP-6) The next 96 from the server's offset (m.nextStart), not from the number of cards shown, once the
' focus is within 8 rows of the end (holding Down no longer runs into the end before the page is in)
sub pageMore(count as integer)
    if not m.loading and m.nextStart < m.total and LibGrid.needsMore(m.grid.itemFocused, count, LibGrid.cols()) then loadPage(m.nextStart, LibGrid.nextPage())
end sub

sub onSelected()
    if m.grid.content = invalid then return
    it = m.grid.content.getChild(m.grid.itemSelected)
    if isPlaceholder(it) then return
    ' (v1.2 SP-12) preview: the details page draws its header at once
    if it <> invalid then m.top.action = { id: "open", itemId: it.itemId, itemType: it.itemType, collectionType: it.collectionType, title: it.title, preview: QuickPlay.previewOfCard(it, false) }
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press or m.picker <> invalid then return false
    if m.inBar
        if key = "left" and m.barIdx > 0
            m.barIdx = m.barIdx - 1
            drawBar()
        else if key = "right" and m.barIdx < m.barIds.count() - 1
            m.barIdx = m.barIdx + 1
            drawBar()
        else if key = "OK"
            useBar()
        else if key = "down"
            leaveBar()
        else if key = "back"
            return false
        end if
        return true
    end if
    ' (NV page keys) Rewind / Fast Forward: a screen back / on, faster while pressed again and again
    if key = "rewind" or key = "fastforward"
        if m.grid.isInFocusChain() then pageJump(key = "fastforward")
        return true
    end if
    ' (v1.1 U-1) Play on a card: play it (a series its next episode) without opening its page
    if key = "play"
        a = invalid
        if m.grid.isInFocusChain() and m.grid.content <> invalid then a = QuickPlay.cardAction(m.grid.content.getChild(m.grid.itemFocused))
        if a <> invalid then m.top.action = a
        return a <> invalid
    end if
    ' Up from the top row of the grid, or *: the filter pills
    if key = "up" or key = "options"
        enterBar()
        return true
    end if
    return false
end function

' A screen (14 cards) back or on in the same column; presses less than 0.45 s apart in the same direction
' make it 2 and then 4 screens. Past the loaded cards it stops at the last one while the next page loads.
sub pageJump(forward as boolean)
    if m.grid.content = invalid then return
    gap = m.jumpClock.TotalMilliseconds()
    m.jumpClock.Mark()
    if gap < 450 and forward = m.jumpForward
        m.jumpStreak = m.jumpStreak + 1
    else
        m.jumpStreak = 0
    end if
    m.jumpForward = forward
    size = LibGrid.jumpSize(m.jumpStreak, LibGrid.cols() * 2)
    target = LibGrid.jumpTarget(m.grid.itemFocused, realCount(), size, forward)
    if target >= 0 then m.grid.jumpToItem = target
end sub

' The big letter of the focused title for 1 s (Name sort only)
sub showLetter(index as integer)
    if m.sort <> "name" or m.grid.content = invalid then return
    c = m.grid.content.getChild(index)
    if c = invalid or isPlaceholder(c) then return
    ch = ""
    if c.hasField("letter") then ch = Util.toText(c.letter)
    if ch = "" then ch = Items.letterOf("", Util.toText(c.title))
    if ch = "" then return
    m.top.findNode("letterText").text = ch
    m.letterBox.visible = true
    m.letterTimer.control = "stop"
    m.letterTimer.control = "start"
end sub

sub hideLetter()
    m.letterBox.visible = false
end sub

sub openPicker(purpose as string, title as string, options as object, selectedId as string)
    p = createObject("roSGNode", "Picker")
    p.purpose = purpose
    p.title = title
    p.selectedId = selectedId
    p.options = options
    p.observeField("chosen", "onPicked")
    p.observeField("cancelled", "closePicker")
    m.top.appendChild(p)
    m.picker = p
    p.setFocus(true)
end sub

sub closePicker()
    if m.picker <> invalid
        m.picker.unobserveField("chosen")
        m.picker.unobserveField("cancelled")
        m.top.removeChild(m.picker)
        m.picker = invalid
    end if
    m.spokenKey = ""
    if m.inBar
        m.top.findNode("barKeys").setFocus(true)
    else
        m.top.setFocus(true)
    end if
    drawBar()
end sub

sub onPicked(ev as object)
    id = ev.getData().id
    purpose = m.picker.purpose
    closePicker()
    if purpose = "sort"
        ' (another sort: its own direction again)
        if id <> m.sort then m.order = ""
        m.sort = id
    else if purpose = "genre"
        m.genre = id
    else if purpose = "letter"
        m.letter = id
    else if purpose = "show"
        m.show = id
    end if
    saveFilters()
    drawBar()
    reload()
end sub

' (v1.5) The backdrop follows the focused card once the focus rests (no loads while scrolling fast)
sub queueBackdrop(index as integer)
    url = ""
    if m.grid.content <> invalid and index >= 0 and index < m.grid.content.getChildCount()
        c = m.grid.content.getChild(index)
        if c <> invalid and c.hasField("backdrop") then url = Util.toText(c.backdrop)
    end if
    if url = "" or url = m.bdUrl then return
    m.bdPending = url
    m.bdTimer.control = "stop"
    m.bdTimer.control = "start"
end sub

sub onBackdropTimer()
    if m.bdPending = "" or m.bdPending = m.bdUrl then return
    ' the new picture goes into the hidden poster; it fades in once loaded, the old one fades out
    tmp = m.bdFront
    m.bdFront = m.bdBack
    m.bdBack = tmp
    m.bdFront.unobserveField("loadStatus")
    m.bdBack.unobserveField("loadStatus")
    m.bdFront.observeField("loadStatus", "onBackdropLoaded")
    m.bdUrl = m.bdPending
    m.bdFront.uri = m.bdUrl
    if m.bdFront.loadStatus = "ready" then onBackdropLoaded()
end sub

sub onBackdropLoaded()
    if m.bdFront.loadStatus <> "ready" then return
    a = m.top.findNode("bdFade")
    a.control = "stop"
    m.top.findNode("bdIn").fieldToInterp = m.bdFront.id + ".opacity"
    m.top.findNode("bdIn").keyValue = [m.bdFront.opacity, 0.4]
    m.top.findNode("bdOut").fieldToInterp = m.bdBack.id + ".opacity"
    m.top.findNode("bdOut").keyValue = [m.bdBack.opacity, 0.0]
    a.control = "start"
end sub

sub onFocusChanged()
    ' (v1.2 NV-14) leaving the page (details on top, Back, Home): keep the focused card for the session
    inChain = m.top.isInFocusChain()
    if m.wasShown and not inChain then rememberPosition()
    m.wasShown = inChain
    if m.top.stale and m.top.isInFocusChain()
        m.top.stale = false
        onRefresh()
    end if
    if not m.top.hasFocus() then return
    if m.picker <> invalid
        m.picker.setFocus(true)
    else if not m.inBar and m.grid.content <> invalid and m.grid.content.getChildCount() > 0
        m.grid.setFocus(true)
        ' (back on this page: the focused card again)
        onFocused()
    else if not m.inBar and m.errorPanel.visible
        m.errorPanel.setFocus(true)
    end if
end sub
