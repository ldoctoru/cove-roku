import "pkg:/source/Util.bs"
import "pkg:/source/Items.bs"

sub init()
    m.grid = m.top.findNode("grid")
    m.status = m.top.findNode("status")
    m.grid.observeField("itemFocused", "onFocused")
    m.grid.observeField("itemSelected", "onSelected")
    m.top.observeField("focusedChild", "onFocusChanged")
    m.sort = "name"
    m.show = "all"          ' all / unwatched / watched / favourites
    m.genre = ""
    m.letter = ""
    m.genres = []
    m.inBar = false
    m.barIdx = 0
    m.barIds = []
    m.total = 0
    m.loading = false
    m.gen = 0
    m.task = invalid
    m.picker = invalid
    ' (the grid gets focus as soon as the screen is shown, before the library is set: never leave it without content)
    m.grid.content = createObject("roSGNode", "ContentNode")
end sub

sub onLibrary()
    m.top.findNode("title").text = Util.toText(m.top.library.title)
    drawBar()
    reload()
    loadGenres()
end sub

sub reload()
    m.gen = m.gen + 1
    m.total = 0
    m.grid.content = createObject("roSGNode", "ContentNode")
    m.status.text = "Loading..."
    m.status.visible = true
    loadPage(0)
end sub

function sortQuery() as string
    if m.sort = "added" then return "SortBy=DateCreated,SortName&SortOrder=Descending"
    if m.sort = "year" then return "SortBy=ProductionYear,PremiereDate,SortName&SortOrder=Descending"
    if m.sort = "rating" then return "SortBy=CommunityRating,SortName&SortOrder=Descending"
    return "SortBy=SortName&SortOrder=Ascending"
end function

function sortLabel() as string
    if m.sort = "added" then return "Date added"
    if m.sort = "year" then return "Year"
    if m.sort = "rating" then return "Rating"
    return "Name"
end function

function showLabel() as string
    if m.show = "unwatched" then return "Unwatched"
    if m.show = "watched" then return "Watched"
    if m.show = "favourites" then return "Favourites"
    return "All"
end function

function filterQuery() as string
    q = ""
    if m.show = "unwatched" then q = q + "&Filters=IsUnplayed"
    if m.show = "watched" then q = q + "&Filters=IsPlayed"
    if m.show = "favourites" then q = q + "&Filters=IsFavorite"
    if m.genre <> "" then q = q + "&Genres=" + m.genre.encodeUriComponent()
    if m.letter = "#"
        q = q + "&NameLessThan=A"
    else if m.letter <> ""
        q = q + "&NameStartsWith=" + m.letter
    end if
    return q
end function

' The library's genres for the Genre pill
sub loadGenres()
    lib = m.top.library
    uid = Util.toText(m.top.server.userId)
    q = "ParentId=" + Util.toText(lib.id) + "&UserId=" + uid + "&SortBy=SortName&Recursive=true"
    types = Items.typesFor(Util.toText(lib.collectionType))
    if types <> "" then q = q + "&IncludeItemTypes=" + types
    t = createObject("roSGNode", "ItemsTask")
    t.server = m.top.server
    t.path = "/Genres?" + q
    t.fallback = ""
    t.kind = "names"
    t.observeField("result", "onGenres")
    m.genreTask = t
    t.control = "RUN"
end sub

sub onGenres(ev as object)
    m.genres = ev.getData().names
    drawBar()
end sub

' ---------------------------------------------------------------- pills: Sort, Genre, A-Z, Show

sub drawBar()
    b = m.top.findNode("bar")
    b.removeChildrenIndex(b.getChildCount(), 0)
    ids = ["sort"]
    texts = ["Sort: " + sortLabel()]
    if m.genres.count() > 0
        ids.push("genre")
        g = "All"
        if m.genre <> "" then g = m.genre
        texts.push("Genre: " + g)
    end if
    ids.push("letter")
    l = "All"
    if m.letter <> "" then l = m.letter
    texts.push("A–Z: " + l)
    ids.push("show")
    texts.push("Show: " + showLabel())
    m.barIds = ids
    if m.barIdx >= ids.count() then m.barIdx = ids.count() - 1
    x = 0
    focused = m.inBar and m.picker = invalid
    for i = 0 to ids.count() - 1
        isFocus = focused and i = m.barIdx
        active = (ids[i] = "genre" and m.genre <> "") or (ids[i] = "letter" and m.letter <> "") or (ids[i] = "show" and m.show <> "all") or (ids[i] = "sort" and m.sort <> "name")
        g = b.createChild("Group")
        bg = g.createChild("Poster")
        lab = g.createChild("Label")
        f = createObject("roSGNode", "Font")
        f.uri = "font:MediumSystemFontFile"
        f.size = 26
        lab.font = f
        lab.text = texts[i]
        lab.height = 52
        lab.vertAlign = "center"
        lab.translation = [24, 0]
        w = lab.boundingRect().width + 84
        bg.width = w
        bg.height = 52
        ch = g.createChild("Poster")
        ch.uri = "pkg:/images/ui/icon_chevron_28.png"
        ch.width = 22
        ch.height = 22
        ch.translation = [w - 44, 15]
        if isFocus
            bg.uri = "pkg:/images/ui/white_pill.9.png"
            lab.color = "0x000000FF"
        else
            bg.uri = "pkg:/images/ui/glass_pill.9.png"
            lab.color = "0xFFFFFFD9"
            if active then lab.color = m.global.theme.accent
        end if
        ch.blendColor = lab.color
        g.translation = [x, 0]
        x = x + w + 16
    end for
end sub

sub enterBar()
    m.inBar = true
    m.top.setFocus(true)
    drawBar()
end sub

sub leaveBar()
    m.inBar = false
    drawBar()
    if m.grid.content <> invalid and m.grid.content.getChildCount() > 0
        m.grid.setFocus(true)
    else
        m.top.setFocus(true)
    end if
end sub

sub useBar()
    id = m.barIds[m.barIdx]
    if id = "sort"
        openPicker("sort", "Sort by", [{ id: "name", label: "Name" }, { id: "added", label: "Date added" }, { id: "year", label: "Year" }, { id: "rating", label: "Rating" }], m.sort)
    else if id = "genre"
        o = [{ id: "", label: "All genres" }]
        for each g in m.genres
            o.push({ id: g, label: g })
        end for
        openPicker("genre", "Genre", o, m.genre)
    else if id = "letter"
        o = [{ id: "", label: "All" }, { id: "#", label: "#  (numbers and symbols)" }]
        for i = 65 to 90
            o.push({ id: chr(i), label: chr(i) })
        end for
        openPicker("letter", "Starts with", o, m.letter)
    else if id = "show"
        openPicker("show", "Show", [{ id: "all", label: "All" }, { id: "unwatched", label: "Unwatched" }, { id: "watched", label: "Watched" }, { id: "favourites", label: "Favourites" }], m.show)
    end if
end sub

sub loadPage(startIndex as integer)
    lib = m.top.library
    uid = Util.toText(m.top.server.userId)
    types = Items.typesFor(Util.toText(lib.collectionType))
    q = "ParentId=" + Util.toText(lib.id) + "&" + sortQuery() + "&StartIndex=" + startIndex.toStr() + "&Limit=60&" + Items.fields()
    ' A library: everything of its kind inside it; a folder / collection: just what it contains
    if types <> ""
        q = q + "&Recursive=true&IncludeItemTypes=" + types
    else if Util.toText(lib.itemType) = "CollectionFolder" or Util.toText(lib.itemType) = "UserView"
        q = q + "&Recursive=true&IncludeItemTypes=Movie,Series,Video"
    end if
    q = q + filterQuery()
    m.loading = true
    t = createObject("roSGNode", "ItemsTask")
    t.server = m.top.server
    t.path = "/Users/" + uid + "/Items?" + q
    t.fallback = "/Items?userId=" + uid + "&" + q
    t.startIndex = startIndex
    t.gen = m.gen
    t.observeField("result", "onPage")
    t.observeField("error", "onError")
    m.task = t
    t.control = "RUN"
end sub

sub onPage(ev as object)
    r = ev.getData()
    if r.gen <> m.gen then return
    m.loading = false
    m.total = r.total
    holder = r.nodes
    nodes = []
    for i = 0 to holder.getChildCount() - 1
        nodes.push(holder.getChild(i))
    end for
    m.grid.content.appendChildren(nodes)
    count = m.grid.content.getChildCount()
    if count = 0
        m.status.text = "Nothing here."
        if filterQuery() <> "" then m.status.text = "Nothing matches these filters. Press Up to change them."
        m.status.visible = true
    else
        m.status.visible = false
        if r.startIndex = 0 and m.top.isInFocusChain() and not m.inBar then m.grid.setFocus(true)
    end if
    updateInfo()
end sub

sub onError(ev as object)
    m.loading = false
    m.status.text = ev.getData()
    m.status.visible = true
end sub

sub updateInfo()
    s = m.total.toStr() + " titles"
    if m.total = 1 then s = "1 title"
    if filterQuery() <> "" then s = s + "   ·   filtered"
    m.top.findNode("info").text = s
end sub

' Near the end of what's loaded: fetch the next 60
sub onFocused()
    if m.grid.content = invalid or m.top.library = invalid then return
    count = m.grid.content.getChildCount()
    if not m.loading and count < m.total and m.grid.itemFocused >= count - 21 then loadPage(count)
end sub

sub onSelected()
    if m.grid.content = invalid then return
    it = m.grid.content.getChild(m.grid.itemSelected)
    if it <> invalid then m.top.action = { id: "open", itemId: it.itemId, itemType: it.itemType, collectionType: it.collectionType, title: it.title }
end sub

function onKeyEvent(key as string, press as boolean) as boolean
    if not press or m.picker <> invalid then return false
    if m.inBar
        if key = "left" and m.barIdx > 0
            m.barIdx = m.barIdx - 1
            drawBar()
        else if key = "right" and m.barIdx < m.barIds.count() - 1
            m.barIdx = m.barIdx + 1
            drawBar()
        else if key = "OK"
            useBar()
        else if key = "down"
            leaveBar()
        else if key = "back"
            return false
        end if
        return true
    end if
    ' Up from the top row of the grid, or *: the filter pills
    if key = "up" or key = "options"
        enterBar()
        return true
    end if
    return false
end function

sub openPicker(purpose as string, title as string, options as object, selectedId as string)
    p = createObject("roSGNode", "Picker")
    p.purpose = purpose
    p.title = title
    p.selectedId = selectedId
    p.options = options
    p.observeField("chosen", "onPicked")
    p.observeField("cancelled", "closePicker")
    m.top.appendChild(p)
    m.picker = p
    p.setFocus(true)
end sub

sub closePicker()
    if m.picker <> invalid
        m.picker.unobserveField("chosen")
        m.picker.unobserveField("cancelled")
        m.top.removeChild(m.picker)
        m.picker = invalid
    end if
    m.top.setFocus(true)
    drawBar()
end sub

sub onPicked(ev as object)
    id = ev.getData().id
    purpose = m.picker.purpose
    closePicker()
    if purpose = "sort"
        m.sort = id
    else if purpose = "genre"
        m.genre = id
    else if purpose = "letter"
        m.letter = id
    else if purpose = "show"
        m.show = id
    end if
    drawBar()
    reload()
end sub

sub onFocusChanged()
    if not m.top.hasFocus() then return
    if m.picker <> invalid
        m.picker.setFocus(true)
    else if not m.inBar and m.grid.content <> invalid and m.grid.content.getChildCount() > 0
        m.grid.setFocus(true)
    end if
end sub
