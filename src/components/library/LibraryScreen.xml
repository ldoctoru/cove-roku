<?xml version="1.0" encoding="utf-8" ?>
<!-- A whole library (or a collection / folder) as a poster grid, loaded 60 at a time as you scroll.
     A bar of pills above it (Up from the top row, or *): Sort, Genre, A-Z, Show (all / unwatched / watched /
     favourites); OK opens the choices in the side panel. "action" = { id: "open", ... } like the home. -->
<component name="LibraryScreen" extends="Group">
    <script type="text/brightscript" uri="LibraryScreen.bs" />
    <interface>
        <field id="screenId" type="string" value="library" />
        <field id="server" type="assocarray" />
        <!-- { id, title, itemType, collectionType } -->
        <field id="library" type="assocarray" onChange="onLibrary" />
        <field id="action" type="assocarray" alwaysNotify="true" />
    </interface>
    <children>
        <Poster id="logo" uri="pkg:/images/logo.png" width="64" height="64" translation="[100,48]" />
        <Label id="title" width="1200" height="60" translation="[180,40]" color="0xFFFFFFFF">
            <Font role="font" uri="font:BoldSystemFontFile" size="44" />
        </Label>
        <Label id="info" width="1200" height="40" translation="[180,96]" color="0xFFFFFF8C">
            <Font role="font" uri="font:MediumSystemFontFile" size="26" />
        </Label>
        <Group id="bar" translation="[96,160]" />
        <!-- holds the focus while the pills are active (the grid then drops its focus ring) -->
        <Group id="barKeys" focusable="true" />
        <MarkupGrid id="grid" translation="[78,224]" itemComponentName="PosterItem" itemSize="[276,466]"
                    itemSpacing="[0,4]" numColumns="6" numRows="2" vertFocusAnimationStyle="fixedFocus"
                    drawFocusFeedback="false" />
        <Label id="status" width="1720" height="44" translation="[100,520]" color="0xFFFFFFB3" text="Loading...">
            <Font role="font" uri="font:MediumSystemFontFile" size="32" />
        </Label>
    </children>
</component>
