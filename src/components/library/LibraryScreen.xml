<?xml version="1.0" encoding="utf-8" ?>
<!-- A whole library (or a collection / folder) as a poster grid, 7 x 2 cards on screen (v1.1.1 VD-1), loaded
     36 first and then 96 at a time as you scroll (SP-6). Rewind / Fast Forward jump a screen (NV page keys).
     A bar of pills above it (Up from the top row, or *): Sort, Genre, A-Z, Show (all / unwatched / watched /
     favourites); OK opens the choices in the side panel. "action" = { id: "open", ... } like the home. -->
<component name="LibraryScreen" extends="Group">
    <script type="text/brightscript" uri="LibraryScreen.bs" />
    <interface>
        <field id="screenId" type="string" value="library" />
        <field id="server" type="assocarray" />
        <!-- { id, title, itemType, collectionType } -->
        <field id="library" type="assocarray" onChange="onLibrary" />
        <field id="action" type="assocarray" alwaysNotify="true" />
        <!-- set by MainScene after a change on Details or playback: the page reloads when it is shown again -->
        <field id="stale" type="boolean" value="false" />
    </interface>
    <children>
        <!-- (VD-1) header in one line: logo, title, and the info line after the title on its baseline -->
        <Poster id="logo" uri="pkg:/images/logo.png" width="56" height="56" translation="[96,36]" />
        <Label id="title" height="60" translation="[172,34]" vertAlign="bottom" color="0xFFFFFFFF">
            <Font role="font" uri="font:BoldSystemFontFile" size="44" />
        </Label>
        <Label id="info" width="900" height="60" translation="[600,30]" vertAlign="bottom" color="0xFFFFFFCC">
            <Font role="font" uri="font:MediumSystemFontFile" size="26" />
        </Label>
        <Group id="bar" translation="[96,116]" />
        <!-- holds the focus while the pills are active (the grid then drops its focus ring) -->
        <Group id="barKeys" focusable="true" />
        <!-- (VD-1, v1.1.2) cards 196 x 294 in 232 x 432 tiles (18 px pad for the focus zoom) 22 px apart: x 96
             to 1816. Titles take up to two lines (PosterItem.placeText); the second row's year ends at y 1024 at
             most (focused, two-line title), inside action-safe (1026) -->
        <MarkupGrid id="grid" translation="[78,168]" itemComponentName="PosterItem" itemSize="[232,432]"
                    itemSpacing="[22,0]" numColumns="7" numRows="2" vertFocusAnimationStyle="fixedFocus"
                    drawFocusFeedback="false" />
        <Label id="status" width="1720" height="44" translation="[100,520]" color="0xFFFFFFCC" text="Loading...">
            <Font role="font" uri="font:MediumSystemFontFile" size="32" />
        </Label>
        <!-- placeholder cards while the first page loads -->
        <Skeleton id="skeleton" translation="[96,186]" rows="2" cols="7" cardW="196" cardH="294" stepX="254" stepY="432" />
        <!-- (NV page keys) the first letter of the focused title after a page jump with the Name sort, for 1 s -->
        <Group id="letterBox" translation="[840,480]" visible="false">
            <Poster uri="pkg:/images/ui/panel_dark_r18.9.png" width="240" height="240" />
            <Label id="letterText" width="240" height="240" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" text="A">
                <Font role="font" uri="font:BoldSystemFontFile" size="160" />
            </Label>
        </Group>
        <Timer id="letterTimer" duration="1.0" repeat="false" />
        <!-- (v1.2 NV-14) the focused card is kept for the session once the focus rests -->
        <Timer id="posTimer" duration="0.5" repeat="false" />
        <!-- the load failed or nothing to show: Try Again / Clear Filters / ... (Up still reaches the pills) -->
        <ErrorPanel id="errorPanel" translation="[100,340]" width="1720" visible="false" />
    </children>
</component>
