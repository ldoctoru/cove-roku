<?xml version="1.0" encoding="utf-8" ?>
<!-- Settings (v1.5), in the Cove for Mac format and flat: a row of tabs across the top (an icon over each label:
     General, Home, Libraries, Subtitles, Playback, Connect, Profiles, Remote, About; no page title), a thin line,
     and under it the selected tab's settings in sections: a small grey caps heading, flat rows with the label on
     the left and the value on the right (› for a choice or a sub-list, a flat switch for on / off), grey help
     notes under a group. Focus = a solid white row (or tab) with dark text; no zoom, glow, shadow or accent.
     Left / Right on the tabs switch tab (its settings show at once), Down enters the settings, Up from the
     first row goes back to the tabs, OK on a choice opens a small flat list with a check on the current value,
     Back closes a list / sub-list, then returns to the tabs, and on the tabs closes Settings.
     The page model is in SettingsPages.bs; drawing, keys and actions in SettingsScreen.bs. A tab's nodes are
     built when it shows (or after a change); a focus move only repaints the two rows involved.
     Every change is saved at once. "themeChanged" fires when something on Home must be rebuilt; "action" asks
     MainScene to switch server ({ id: "connect", serverId }), sign out ({ id: "signout" }) or add one
     ({ id: "switch" }), and so on (see SettingsScreen.bs). -->
<component name="SettingsScreen" extends="Group">
    <script type="text/brightscript" uri="SettingsScreen.bs" />
    <script type="text/brightscript" uri="SettingsPages.bs" />
    <interface>
        <field id="screenId" type="string" value="settings" />
        <field id="server" type="assocarray" />
        <field id="themeChanged" type="boolean" alwaysNotify="true" />
        <field id="action" type="assocarray" alwaysNotify="true" />
    </interface>
    <children>
        <Rectangle id="bg" width="1920" height="1080" color="0x000000FF" />
        <Group id="tabs" translation="[0,36]" />
        <Rectangle id="line" translation="[0,162]" width="1920" height="2" color="0xFFFFFF1F" />
        <Group id="clip" translation="[0,176]" clippingRect="[0,0,1920,904]">
            <Group id="list" />
        </Group>
        <Group id="preview" translation="[1260,246]" />
        <Group id="popLayer" visible="false">
            <Rectangle id="popShade" width="1920" height="1080" color="0x00000099" />
            <Poster id="popPanel" uri="pkg:/images/ui/set_r12.9.png" blendColor="0x2C2C2EFF" />
            <Label id="popTitle" height="44" vertAlign="center" color="0xFFFFFF9E" text="Choose" />
            <Group id="popClip">
                <Group id="popList" />
            </Group>
        </Group>
        <Group id="keys" focusable="true" />
        <Timer id="kbTimer" duration="0.4" repeat="false" />
    </children>
</component>
