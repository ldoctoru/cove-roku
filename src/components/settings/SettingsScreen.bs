import "pkg:/source/Subs.bs"
import "pkg:/source/Util.bs"
import "pkg:/source/Api.bs"
import "pkg:/source/Theme.bs"
import "pkg:/source/Prefs.bs"
import "pkg:/source/Tracks.bs"
import "pkg:/source/Servers.bs"
import "pkg:/source/DeviceCaps.bs"
import "pkg:/source/Ratings.bs"
import "pkg:/source/Speak.bs"
import "pkg:/source/HomeLayout.bs"
import "pkg:/source/Toasts.bs"
import "pkg:/source/NavPrefs.bs"
import "pkg:/source/SetRows.bs"

' (v1.5) Settings in the Cove for Mac format (SettingsPages.bs builds each tab's rows), drawn here, flat.
' Layout (1920 x 1080): 9 tabs of 150 x 108 across the top (y 36), a line at y 162, then the tab's rows in a
' 904 px window from y 176 that follows the focus: x 260-1660 (Subtitles: 260-1160, the live preview at 1260).
' Focus zones: "tabs" (Left / Right switch tab), "content" (the rows), "pop" (a choice's small list).

sub init()
    m.bgRect = m.top.findNode("bg")
    m.tabsGroup = m.top.findNode("tabs")
    m.lineRect = m.top.findNode("line")
    m.preview = m.top.findNode("preview")
    m.list = m.top.findNode("list")
    m.keys = m.top.findNode("keys")
    m.popLayer = m.top.findNode("popLayer")
    m.popPanel = m.top.findNode("popPanel")
    m.popTitle = m.top.findNode("popTitle")
    m.popClip = m.top.findNode("popClip")
    m.popList = m.top.findNode("popList")
    m.kbTimer = m.top.findNode("kbTimer")
    m.kbTimer.observeField("fire", "focusKeyboard")
    ' fonts, made once and shared by every row
    m.fRow = mkFont(false, 28)
    m.fValue = mkFont(false, 28)
    m.fSub = mkFont(false, 24)
    m.fHead = mkFont(true, 22)
    m.fCols = mkFont(true, 20)
    m.fTab = mkFont(false, 24)
    m.popTitle.font = m.fHead
    ' (v0.9.1) the profile PIN steps (components/profiles/PinFlow): parent PIN, profile PIN, new PIN
    m.pinFlow = createObject("roSGNode", "PinFlow")
    m.pinFlow.focusBack = m.keys
    m.pinFlow.observeField("result", "onPinResult")
    m.top.appendChild(m.pinFlow)
    m.tabList = settingsTabs()
    m.tab = 0
    m.zone = "tabs"
    ' the page stack inside the tab: { id, focus (index among the focusable rows), key (the focused row's key),
    ' top (scroll), order (General → Top Bar / Sidebar: the Change Order mode) }
    m.stack = [newEntry(m.tabList[0].id)]
    m.pop = invalid
    m.rows = []
    m.nodes = []
    m.focusables = []
    m.focus = -1
    m.moving = ""
    m.libs = []
    m.libTask = invalid
    m.renameFor = ""
    m.libError = ""
    m.libsLoaded = false
    m.autoTabs = false
    m.menuLib = ""
    m.menuServer = ""
    m.menuProfile = ""
    m.tasksHolder = invalid     ' (SC-13) the scene's "tasks" group, for sign-out requests
    info = createObject("roAppInfo")
    m.version = info.getVersion()
    m.device = ""
    m.caps = {}
    try
        m.caps = DeviceCaps.get()
        m.device = DeviceCaps.deviceLine(m.caps)
    catch e
        print "Cove: settings device line failed "; e.message
        m.device = ""
    end try
    m.top.observeField("focusedChild", "onFocusChanged")
    m.top.observeField("server", "onServer")
    ' Audio Guide: what was said last (a rebuild that doesn't move the focus says nothing), the page and section
    m.spokenKey = ""
    m.spokenHead = ""
    m.spokenPage = ""
    Speak.mute([m.keys])
    makeTabs()
    draw()
end sub

function newEntry(id as string) as object
    return { id: id, focus: 0, key: "", top: 0, order: false }
end function

' The server's libraries (Libraries, Home rows, top bar and sidebar lists)
sub onServer()
    srv = m.top.server
    if srv = invalid then return
    m.libError = ""
    m.libsLoaded = false
    t = createObject("roSGNode", "ApiTask")
    ' (v1.5.2 ST-5) the newer Jellyfin route on a 404, or first when Home only got an answer there
    path = "/Users/" + Util.toText(srv.userId) + "/Views"
    alt = Api.newRoute(path, Util.toText(srv.userId))
    if Api.knownRoute(srv, "home:" + Api.routeKind(path)) = "new"
        tmp = path
        path = alt
        alt = tmp
    end if
    t.request = { method: "GET", url: Util.toText(srv.url) + path, fallbackUrl: Util.toText(srv.url) + alt, headers: Api.headers(srv, true), body: "", tag: { kind: "views" }, timeout: 15000 }
    t.observeField("response", "onViews")
    m.libTask = t
    t.control = "RUN"
end sub

sub onViews(ev as object)
    r = ev.getData()
    if r.code <> 200 or r.json = invalid
        ' (instead of "Loading your libraries..." for ever)
        m.libError = "Couldn't load your libraries. " + Api.describeFailure(r)
        print "Cove: settings views -> "; r.code
        draw()
        return
    end if
    list = []
    if type(r.json.Items) = "roArray"
        for each v in r.json.Items
            list.push({ id: Util.toText(v.Id), title: Util.toText(v.Name), kind: LCase(Util.toText(v.CollectionType)), collectionType: LCase(Util.toText(v.CollectionType)) })
        end for
    end if
    m.libs = list
    ' (v1.5.2 ST-2) loaded, even with no libraries: no more "Loading your libraries..."
    m.libsLoaded = true
    draw()
end sub

' ---------------------------------------------------------------- drawing

function mkFont(bold as boolean, size as integer) as object
    f = createObject("roSGNode", "Font")
    f.uri = "font:MediumSystemFontFile"
    if bold then f.uri = "font:BoldSystemFontFile"
    f.size = size
    return f
end function

function addLabel(parent as object, text as string, x as integer, y as integer, w as integer, h as integer, fnt as object, color as string) as object
    l = parent.createChild("Label")
    l.font = fnt
    l.text = text
    l.color = color
    l.translation = [x, y]
    l.width = w
    l.height = h
    l.vertAlign = "center"
    return l
end function

function addPoster(parent as object, uri as string, x as integer, y as integer, w as integer, h as integer) as object
    p = parent.createChild("Poster")
    p.uri = uri
    p.translation = [x, y]
    p.width = w
    p.height = h
    return p
end function

' The content column: x and width (Subtitles leaves room for the preview on the right)
function contentX() as integer
    return 260
end function

function contentW() as integer
    if m.stack[0].id = "subtitles" then return 900
    return 1400
end function

' The tabs across the top, built once: { grp, bg, icon, lab } each
sub makeTabs()
    m.tabNodes = []
    n = m.tabList.count()
    tw = 150
    gap = 8
    x0 = Int((1920 - (n * tw + (n - 1) * gap)) / 2)
    for i = 0 to n - 1
        tb = m.tabList[i]
        g = m.tabsGroup.createChild("Group")
        g.translation = [x0 + i * (tw + gap), 0]
        bgp = addPoster(g, "pkg:/images/ui/set_r12.9.png", 0, 0, tw, 108)
        ic = addPoster(g, "pkg:/images/ui/icon_tab_" + tb.icon + "_44.png", 53, 14, 44, 44)
        lab = addLabel(g, tb.label, 0, 64, tw, 34, m.fTab, "0xFFFFFF9E")
        lab.horizAlign = "center"
        m.tabNodes.push({ grp: g, bg: bgp, icon: ic, lab: lab })
    end for
end sub

' Selected tab: white fill with dark icon and label while the tabs have the focus, a faint 12 % fill when the
' focus is in its settings; the others plain grey
sub paintTabs()
    t = m.global.theme
    for i = 0 to m.tabNodes.count() - 1
        n = m.tabNodes[i]
        if i = m.tab and m.zone = "tabs"
            n.bg.visible = true
            n.bg.blendColor = t.focusFill
            n.icon.blendColor = t.onFocus
            n.lab.color = t.onFocus
        else if i = m.tab
            n.bg.visible = true
            n.bg.blendColor = t.controlFill
            n.icon.blendColor = t.text
            n.lab.color = t.text
        else
            n.bg.visible = false
            n.icon.blendColor = t.text2
            n.lab.color = t.text2
        end if
    end for
end sub

' Builds the page on top of the stack again (after a change), keeping the focus on the same row
sub draw()
    t = m.global.theme
    m.bgRect.color = t.bg
    m.lineRect.color = t.divider
    paintTabs()
    entry = m.stack.peek()
    m.preview.removeChildrenIndex(m.preview.getChildCount(), 0)
    if entry.id = "subtitles" then drawPreview(m.preview)
    rows = pageRows(entry)
    m.rows = rows
    m.nodes = []
    m.focusables = []
    m.rowY = []
    m.rowH = []
    cw = contentW()
    chars = SetRows.charsFor(cw - 16)
    lst = m.list
    lst.removeChildrenIndex(lst.getChildCount(), 0)
    y = 0
    for i = 0 to rows.count() - 1
        r = rows[i]
        h = SetRows.rowHeight(r, chars)
        m.rowY.push(y)
        m.rowH.push(h)
        m.nodes.push(makeRow(lst, r, y, h, cw, chars))
        if SetRows.takesFocus(r) then m.focusables.push(i)
        y = y + h + SetRows.gapAfter(r)
    end for
    m.listH = y + 40
    ' the focus: the row it was on (by key), else the same place
    f = -1
    if Util.toText(entry.key) <> ""
        for j = 0 to m.focusables.count() - 1
            if SetRows.keyOf(rows[m.focusables[j]]) = entry.key then f = j
        end for
    end if
    if f < 0 then f = entry.focus
    if f >= m.focusables.count() then f = m.focusables.count() - 1
    if f < 0 and m.focusables.count() > 0 then f = 0
    m.focus = f
    entry.focus = f
    if f >= 0
        entry.key = SetRows.keyOf(rows[m.focusables[f]])
        if m.zone = "content" then paintRow(m.focusables[f], true)
    end if
    ' (v1.5.2 ST-3) a sub-list with nothing to focus yet (libraries still loading): the tabs take the keys, Back
    ' still closes the sub-list, and the rows get the focus back once they arrive
    if m.zone = "content" and f < 0
        m.zone = "tabs"
        m.autoTabs = m.stack.count() > 1
    else if m.zone = "tabs" and f >= 0 and Util.flag(m, "autoTabs") and m.stack.count() > 1
        m.zone = "content"
        m.autoTabs = false
        paintRow(m.focusables[f], true)
    end if
    paintTabs()
    scrollToFocus()
    if m.pop <> invalid then drawPop()
    speakFocus()
end sub

' The nodes of one row, painted as not focused: { grp, bg, lab, val, chev, check, track, knob, subs, updown, cells }
function makeRow(parent as object, r as object, y as integer, h as integer, w as integer, chars as integer) as object
    t = m.global.theme
    k = r.kind
    g = parent.createChild("Group")
    g.translation = [contentX(), y]
    n = { grp: g, bg: invalid, subs: [], cells: [] }
    if k = "head"
        addLabel(g, UCase(Util.toText(r.text)), 8, 28, w, 36, m.fHead, t.text2)
        return n
    end if
    if k = "note"
        lines = Util.wrapLines(Util.toText(r.text), chars, 8)
        for i = 0 to lines.count() - 1
            addLabel(g, lines[i], 8, 4 + i * 30, w - 16, 30, m.fSub, t.text2)
        end for
        return n
    end if
    if k = "cols"
        for i = 0 to r.cols.count() - 1
            c = addLabel(g, UCase(r.cols[i]), libColX(w, i) - 72, 4, 144, 36, m.fCols, t.text3)
            c.horizAlign = "center"
        end for
        return n
    end if
    n.bg = addPoster(g, "pkg:/images/ui/set_r12.9.png", 0, 0, w, h)
    rightEdge = w - 28
    if k = "link" or k = "choice"
        n.chev = addPoster(g, "pkg:/images/ui/icon_st_chevron_28.png", rightEdge - 28, Int((h - 28) / 2), 28, 28)
        rightEdge = rightEdge - 28 - 12
    else if k = "switch"
        n.track = addPoster(g, "pkg:/images/ui/set_pill.9.png", rightEdge - 64, Int((h - 36) / 2), 64, 36)
        kx = rightEdge - 64 + 4
        if Util.flag(r, "on") then kx = rightEdge - 64 + 32
        n.knob = addPoster(g, "pkg:/images/ui/set_knob.png", kx, Int((h - 28) / 2), 28, 28)
        rightEdge = rightEdge - 64 - 20
    else if k = "move"
        n.updown = addPoster(g, "pkg:/images/ui/icon_st_updown_28.png", rightEdge - 28, Int((h - 28) / 2), 28, 28)
        n.updown.visible = false
        rightEdge = rightEdge - 28 - 12
    else if k = "lib"
        ' (the Top Bar, Sidebar, Home Row and My Media columns: a check when on, "Off" when not)
        for i = 0 to r.cols.count() - 1
            cx = libColX(w, i)
            v = r.cols[i]
            if type(v) <> "roBoolean" and type(v) <> "Boolean"
                ' (no Home row for this kind of library: an empty cell)
            else if v
                n.cells.push(addPoster(g, "pkg:/images/ui/icon_check_28.png", cx - 14, Int((h - 28) / 2), 28, 28))
            else
                c = addLabel(g, "Off", cx - 60, 0, 120, h, m.fSub, t.text3)
                c.horizAlign = "center"
                n.cells.push(c)
            end if
        end for
        rightEdge = libColX(w, 0) - 100
    end if
    lx = 28
    if k = "lib"
        n.kindIcon = addPoster(g, "pkg:/images/ui/icon_" + Util.toText(r.icon) + "_36.png", 24, Int((h - 36) / 2), 36, 36)
        lx = 80
    end if
    twoLine = SetRows.isTwoLine(r)
    lineH = h
    if twoLine then lineH = 56
    vw = 0
    value = Util.toText(r.value)
    if value <> "" and k <> "lib"
        v = addLabel(g, value, 0, 0, 0, lineH, m.fValue, t.text2)
        v.horizAlign = "right"
        vw = v.boundingRect().width
        if vw > Int(w / 2) then vw = Int(w / 2)
        v.width = vw + 4
        v.translation = [rightEdge - vw - 4, 0]
        if twoLine then v.translation = [rightEdge - vw - 4, Int((h - lineH) / 2)]
        n.val = v
    end if
    labW = rightEdge - lx - 16
    if vw > 0 then labW = labW - vw - 20
    if labW < 200 then labW = 200
    ly = 0
    if twoLine then ly = 6
    n.lab = addLabel(g, Util.toText(r.label), lx, ly, labW, lineH, m.fRow, t.text1)
    if twoLine
        subLines = Util.wrapLines(Util.toText(r.sub), chars, 3)
        for i = 0 to subLines.count() - 1
            n.subs.push(addLabel(g, subLines[i], lx, 56 + i * 30, rightEdge - lx - vw - 24, 30, m.fSub, t.text2))
        end for
    end if
    paintRow(-1, false, n, r)
    return n
end function

' The centre of a Libraries table column (0 Top Bar, 1 Sidebar, 2 Home) in a row w wide
' (v1.5) four columns: Top Bar, Sidebar, Home Row, My Media
function libColX(w as integer, col as integer) as integer
    return w - 540 + col * 150
end function

' Paints row i focused or not (n / r: a row being made, before it is in m.nodes): focused = solid white with
' dark text; not focused = the flat 8 % row fill (a picked library: 12 %) with white text
sub paintRow(i as integer, isFocus as boolean, n = invalid as dynamic, r = invalid as dynamic)
    if n = invalid
        if i < 0 or i >= m.nodes.count() then return
        n = m.nodes[i]
        r = m.rows[i]
    end if
    if n.bg = invalid then return
    t = m.global.theme
    dark = t.onFocus
    soft = "0x111111A6"
    if isFocus
        n.bg.blendColor = t.focusFill
        n.lab.color = dark
        if n.val <> invalid then n.val.color = soft
        if n.chev <> invalid then n.chev.blendColor = soft
        for each s in n.subs
            s.color = soft
        end for
    else
        n.bg.blendColor = t.rowFill
        if Util.flag(r, "selected") then n.bg.blendColor = t.controlFill
        n.lab.color = t.text1
        if Util.flag(r, "dim") then n.lab.color = t.text3
        if n.val <> invalid
            n.val.color = t.text2
            if Util.flag(r, "dim") then n.val.color = t.text3
        end if
        if n.chev <> invalid then n.chev.blendColor = t.text2
        for each s in n.subs
            s.color = t.text2
        end for
    end if
    if n.kindIcon <> invalid
        n.kindIcon.blendColor = t.text
        if isFocus then n.kindIcon.blendColor = dark
    end if
    for each c in n.cells
        if c.subtype() = "Poster"
            c.blendColor = t.text
            if isFocus then c.blendColor = dark
        else
            c.color = t.text3
            if isFocus then c.color = soft
        end if
    end for
    if n.track <> invalid
        ' on: white track, dark knob; off: 25 % white track, white knob (on a focused white row: dark track)
        if Util.flag(r, "on")
            n.track.blendColor = t.text
            n.knob.blendColor = dark
            if isFocus
                n.track.blendColor = dark
                n.knob.blendColor = t.text
            end if
        else
            n.track.blendColor = "0xFFFFFF40"
            if isFocus then n.track.blendColor = "0x11111140"
            n.knob.blendColor = t.text
        end if
        n.track.opacity = 1.0
        n.knob.opacity = 1.0
        if Util.flag(r, "dim")
            n.track.opacity = 0.4
            n.knob.opacity = 0.4
        end if
    end if
    if n.updown <> invalid
        n.updown.visible = isFocus and m.moving <> ""
        n.updown.blendColor = dark
    end if
end sub

' Keeps the focused row inside the window, with a margin above and below (a tab's first row shows its heading)
sub scrollToFocus()
    entry = m.stack.peek()
    top = 0
    if m.focus >= 0 and m.zone <> "tabs"
        idx = m.focusables[m.focus]
        y = m.rowY[idx]
        ' (the heading and the notes above the first row of a section scroll in with it)
        j = idx - 1
        while j >= 0 and not SetRows.takesFocus(m.rows[j]) and m.rows[j].kind <> "note"
            y = m.rowY[j]
            j = j - 1
        end while
        top = SetRows.scrollFor(entry.top, y, m.rowY[idx] + m.rowH[idx] - y, 904, m.listH, 70)
    else if m.zone = "tabs"
        top = 0
    end if
    entry.top = top
    m.list.translation = [0, -top]
end sub

sub moveFocus(delta as integer)
    if m.focusables.count() = 0 then return
    nf = m.focus + delta
    if nf < 0 or nf >= m.focusables.count() then return
    paintRow(m.focusables[m.focus], false)
    m.focus = nf
    paintRow(m.focusables[nf], true)
    entry = m.stack.peek()
    entry.focus = nf
    entry.key = SetRows.keyOf(m.rows[m.focusables[nf]])
    scrollToFocus()
    speakFocus()
end sub

function focusedRow() as dynamic
    if m.focus < 0 or m.focus >= m.focusables.count() then return invalid
    return m.rows[m.focusables[m.focus]]
end function

' ---------------------------------------------------------------- tabs, sub-lists, the choice list

sub selectTab(i as integer)
    if i = m.tab then return
    m.tab = i
    m.moving = ""
    m.stack = [newEntry(m.tabList[i].id)]
    m.spokenPage = ""
    draw()
end sub

' From the tabs into the tab's settings (its first row, or where the focus was)
sub enterContent()
    if m.focusables.count() = 0 then return
    m.zone = "content"
    if m.focus < 0 then m.focus = 0
    paintTabs()
    paintRow(m.focusables[m.focus], true)
    m.spokenPage = ""
    scrollToFocus()
    speakFocus()
end sub

sub toTabs()
    if m.focus >= 0 then paintRow(m.focusables[m.focus], false)
    m.zone = "tabs"
    m.moving = ""
    paintTabs()
    scrollToFocus()
    speakFocus()
end sub

sub pushPage(id as string)
    m.moving = ""
    m.stack.push(newEntry(id))
    draw()
end sub

sub popPage()
    m.moving = ""
    if m.stack.count() > 1 then m.stack.pop()
    draw()
end sub

' Back to the tab's own page (after removing the server or profile a sub-list was about)
sub popToTab()
    while m.stack.count() > 1
        m.stack.pop()
    end while
end sub

' A choice's values in a small flat list next to its row (r need not be on the page: Reset's confirmation)
sub openPop(r as object)
    opts = choiceRows(r)
    f = 0
    for i = 0 to opts.count() - 1
        if Util.flag(opts[i], "checked") then f = i
    end for
    m.pop = { row: r, opts: opts, focus: f, top: 0 }
    m.zone = "pop"
    m.popLayer.visible = true
    drawPop()
    m.spokenKey = ""
    speakFocus()
end sub

sub closePop()
    m.pop = invalid
    m.popLayer.visible = false
    m.zone = "content"
    if m.focusables.count() = 0 then m.zone = "tabs"
    paintTabs()
    if m.zone = "content" and m.focus >= 0 then paintRow(m.focusables[m.focus], true)
end sub

' Builds the choice list: 560 wide, at the right of the content column, beside the row it changes
sub drawPop()
    p = m.pop
    t = m.global.theme
    itemH = 64
    visible = p.opts.count()
    if visible > 11 then visible = 11
    pw = 560
    ph = 12 + 48 + visible * itemH + 12
    rowY = 540
    rowH = 0
    idx = -1
    for i = 0 to m.rows.count() - 1
        if m.rows[i].kind = p.row.kind and Util.toText(m.rows[i].id) = Util.toText(p.row.id) and Util.toText(m.rows[i].label) = Util.toText(p.row.label) then idx = i
    end for
    if idx >= 0
        rowY = 176 + m.rowY[idx] - m.stack.peek().top
        rowH = m.rowH[idx]
    end if
    px = contentX() + contentW() - pw - 20
    py = SetRows.popTop(rowY, rowH, ph, 40, 1040)
    m.popPanel.translation = [px, py]
    m.popPanel.width = pw
    m.popPanel.height = ph
    m.popTitle.translation = [px + 28, py + 12]
    m.popTitle.width = pw - 56
    m.popTitle.text = UCase(Util.toText(p.row.label))
    m.popTitle.color = t.text2
    ' (scrolled so the focused value shows)
    if p.focus < p.top then p.top = p.focus
    if p.focus > p.top + visible - 1 then p.top = p.focus - visible + 1
    m.popClip.translation = [px + 12, py + 60]
    m.popClip.clippingRect = [0, 0, pw - 24, visible * itemH]
    pl = m.popList
    pl.removeChildrenIndex(pl.getChildCount(), 0)
    pl.translation = [0, -p.top * itemH]
    for i = 0 to p.opts.count() - 1
        o = p.opts[i]
        isFocus = i = p.focus
        g = pl.createChild("Group")
        g.translation = [0, i * itemH]
        bgp = addPoster(g, "pkg:/images/ui/set_r12.9.png", 0, 2, pw - 24, itemH - 4)
        bgp.blendColor = t.focusFill
        bgp.visible = isFocus
        fg = t.text1
        if isFocus then fg = t.onFocus
        if Util.flag(o, "checked")
            ck = addPoster(g, "pkg:/images/ui/icon_check_28.png", 18, Int((itemH - 28) / 2), 28, 28)
            ck.blendColor = fg
        end if
        lx = 62
        if o.swatch <> invalid
            dot = addPoster(g, "pkg:/images/ui/set_knob.png", lx, Int((itemH - 28) / 2), 28, 28)
            dot.blendColor = o.swatch
            lx = lx + 44
        end if
        addLabel(g, o.label, lx, 0, pw - 24 - lx - 16, itemH, m.fRow, fg)
    end for
end sub

function popKey(key as string) as boolean
    p = m.pop
    if key = "up" or key = "down"
        d = 1
        if key = "up" then d = -1
        nf = p.focus + d
        if nf >= 0 and nf < p.opts.count()
            p.focus = nf
            drawPop()
            speakFocus()
        end if
    else if key = "OK"
        src = p.row
        pick = p.opts[p.focus]
        closePop()
        applyValue(Util.toText(src.id), Util.toText(pick.id))
    else if key = "back"
        closePop()
        m.spokenKey = ""
        speakFocus()
    end if
    return true
end function

' "This is how subtitles will look." on a sample picture, right of the Subtitles rows (the player's own style)
sub drawPreview(g as object)
    pw = 400
    ph = 225
    top = g.createChild("Rectangle")
    top.width = pw
    top.height = ph / 2
    top.color = "0x404D66FF"
    bot = g.createChild("Rectangle")
    bot.width = pw
    bot.height = ph / 2
    bot.translation = [0, ph / 2]
    bot.color = "0xBFB399FF"
    ' (the player's style, Subs.style, scaled so Normal is 22 px as before)
    st = Subs.style(0.45)
    fs = st.fontSize
    tc = st.color
    text = "This is how subtitles will look."
    fnt = mkFont(false, fs)
    probe = createObject("roSGNode", "Label")
    probe.font = fnt
    probe.text = text
    tw = probe.boundingRect().width
    th = fs + 10
    bottomPct = Prefs.subBottom()
    ty = ph - th - Int(ph * bottomPct / 100) - 6
    if ty < 4 then ty = 4
    tx = Int((pw - tw) / 2)
    if st.bgColor <> ""
        b = g.createChild("Rectangle")
        b.width = tw + 20
        b.height = th
        b.translation = [tx - 10, ty]
        b.color = st.bgColor
    end if
    for each o in st.offsets
        addLabel(g, text, tx + o[0], ty + o[1], tw + 4, th, fnt, st.shade)
    end for
    addLabel(g, text, tx, ty, tw + 4, th, fnt, tc)
    cap = addLabel(g, "Preview", 0, ph + 8, pw, 32, m.fSub, m.global.theme.text2)
    cap.horizAlign = "center"
end sub

' ---------------------------------------------------------------- Audio Guide

' Said once per focus move: on the tabs, the tab ("Home, tab, 2 of 9"); in a tab, the page's title when the
' focus enters it, the section when the focus enters a new one, the row ("Next Up, switch, on"; "Banner
' Shows: Newest, menu button") and the help note under it; in a choice list, the value and its place
sub speakFocus()
    if not Speak.isOn() then return
    text = ""
    sig = m.zone
    if m.zone = "tabs"
        text = SetRows.tabSpeech(m.tabList[m.tab].label, m.tab, m.tabList.count())
        sig = "tabs/" + m.tab.toStr()
        m.spokenPage = ""
    else if m.zone = "pop"
        o = m.pop.opts[m.pop.focus]
        r = { kind: "option", label: o.label, checked: o.checked }
        text = SetRows.speech(r, false) + Speak.position(m.pop.focus, m.pop.opts.count())
        sig = "pop/" + m.pop.focus.toStr()
    else
        entry = m.stack.peek()
        sig = entry.id + "/" + m.stack.count().toStr()
        if sig <> m.spokenPage
            m.spokenPage = sig
            m.spokenHead = ""
            if m.stack.count() > 1 then text = pageTitle(entry) + ". "
        end if
        r = focusedRow()
        if r <> invalid
            idx = m.focusables[m.focus]
            head = ""
            for i = idx to 0 step -1
                if m.rows[i].kind = "head"
                    head = Util.toText(m.rows[i].text)
                    exit for
                end if
            end for
            if head <> m.spokenHead
                m.spokenHead = head
                if head <> "" then text = text + head + ". "
            end if
            text = text + SetRows.speech(r, m.moving <> "")
            if idx + 1 < m.rows.count() and m.rows[idx + 1].kind = "note" then text = text + ". " + Util.toText(m.rows[idx + 1].text)
        end if
        sig = sig + "/" + m.focus.toStr()
    end if
    text = Speak.clean(text)
    key = sig + "/" + text
    if key = m.spokenKey then return
    m.spokenKey = key
    Speak.say(text)
end sub

' ---------------------------------------------------------------- keys

function onKeyEvent(key as string, press as boolean) as boolean
    if not press then return false
    if m.zone = "pop" then return popKey(key)
    if m.zone = "tabs" then return tabsKey(key)
    if m.moving <> "" then return movingKey(key)
    if key = "up"
        if m.focus <= 0
            toTabs()
        else
            moveFocus(-1)
        end if
        return true
    else if key = "down"
        moveFocus(1)
        return true
    else if key = "OK"
        useFocused()
        return true
    else if key = "left" or key = "right"
        r = focusedRow()
        if r <> invalid and r.kind = "switch" and (Util.flag(r, "on")) <> (key = "right") then applyValue(r.id, onOff(key = "right"))
        return true
    else if key = "back"
        if Util.flag(m.stack.peek(), "order")
            useButton({ id: "navOrderDone" })
        else if m.stack.count() > 1
            popPage()
        else
            toTabs()
        end if
        return true
    end if
    return false
end function

' The tab row: Left / Right switch tab (its settings show at once), Down or OK go in, Back closes Settings
function tabsKey(key as string) as boolean
    m.autoTabs = false
    if key = "back" and m.stack.count() > 1
        ' (v1.5.2 ST-3) a sub-list is still drawn: Back closes it instead of Settings
        m.zone = "content"
        popPage()
        return true
    end if
    if key = "left" or key = "right"
        d = 1
        if key = "left" then d = -1
        selectTab(SetRows.tabStep(m.tab, d, m.tabList.count()))
        return true
    else if key = "down" or key = "OK"
        enterContent()
        return true
    else if key = "up"
        return true
    end if
    return false
end function

' A row picked up in an order list: Up / Down move it, OK or Back put it down
function movingKey(key as string) as boolean
    if key = "up" or key = "down"
        delta = 1
        if key = "up" then delta = -1
        moveRowBy(m.moving, delta)
    else if key = "OK" or key = "back"
        m.moving = ""
        if m.focus >= 0 then paintRow(m.focusables[m.focus], true)
        r = focusedRow()
        if r <> invalid then Speak.say(Util.toText(r.label) + ", moved")
    end if
    return true
end function

function onOff(isOn as boolean) as string
    if isOn then return "on"
    return "off"
end function

sub useFocused()
    r = focusedRow()
    if r = invalid then return
    k = r.kind
    if k = "link"
        pushPage(Util.toText(r.target))
    else if k = "choice"
        openPop(r)
    else if k = "switch"
        applyValue(r.id, onOff(not (Util.flag(r, "on"))))
    else if k = "button"
        useButton(r)
    else if k = "lib"
        ' (the library's options in the section under the table; the focus goes to its first row)
        m.menuLib = Util.toText(r.id)
        m.stack.peek().key = "button|libRename"
        draw()
    else if k = "move"
        m.moving = Util.toText(r.id)
        paintRow(m.focusables[m.focus], true)
        m.spokenKey = ""
        speakFocus()
    else if k = "server"
        m.menuServer = Util.toText(r.id)
        pushPage("srv:" + m.menuServer)
    else if k = "profile"
        m.menuProfile = Util.toText(r.id)
        pushPage("prof:" + m.menuProfile)
    end if
end sub

' ---------------------------------------------------------------- changes

' Saves one setting and builds the page again; Home is rebuilt when Settings closes if it changed something there
sub applyValue(id as string, value as string)
    homeKeys = { topBarLabels: 1, showRecent: 1, showUpNextRow: 1, homeFavorites: 1, showFavorites: 1, showNowPlaying: 1, hideSpoilers: 1, hideWatchedLatest: 1, nextUpRewatch: 1, nextUpDays: 1 }
    isOn = value = "on"
    if id = "askWho"
        ' (kept with the server's profiles, not with the settings that Reset clears; a parent PIN first while a
        ' profile with a rating limit is watching)
        guarded({ do: "askWho", on: isOn })
        return
    else if id = "background" or id = "dimWatched"
        Util.writeText(id, value)
        m.global.theme = Theme.get()
        m.top.themeChanged = true
    else if id = "navStyle"
        NavPrefs.setMenuStyle(value)
        m.top.themeChanged = true
    else if id.startsWith("nav:")
        ' "nav:<place>:<entry id>": an entry of the top bar or the sidebar
        parts = id.split(":")
        NavPrefs.setShown(parts[1], id.mid(5 + parts[1].len()), isOn, navLibs())
        m.top.themeChanged = true
    else if id.startsWith("home:")
        ' "home:<row id>": a built-in Home row
        HomeLayout.setOn(serverKey(), homeLibs(), id.mid(5), isOn)
        m.top.themeChanged = true
    else if id.startsWith("libHome:")
        ' a library's row on Home (no longer tied to the sidebar)
        NavPrefs.setLibraryOnHome(id.mid(8), isOn)
        m.top.themeChanged = true
    else if id.startsWith("libMedia:")
        ' (v1.5) a library's tile in Home's My Media row
        NavPrefs.setLibraryInMyMedia(id.mid(9), isOn)
        m.top.themeChanged = true
    else if id = "libSetAll"
        ' (v1.5) Libraries → Set All Libraries: one place for every library at once
        n = NavPrefs.setAllLibraries(value, navLibs())
        m.top.themeChanged = true
        if n > 0 then Toasts.notify(labelOf(NavPrefs.setAllActions(), value), "check")
    else if id.startsWith("libset:")
        ' "libset:<key>:<library id>": Home Row Shows (style), Sort By (sort), Show (show)
        parts = id.split(":")
        Prefs.setLibrary(id.mid(8 + parts[1].len()), parts[1], value)
        m.top.themeChanged = true
    else if id.startsWith("rating:")
        setRating(id.mid(7), value)
        return
    else if id = "resetConfirm"
        if value = "yes"
            Prefs.resetAll()
            m.global.theme = Theme.get()
            m.top.themeChanged = true
            Toasts.notify("All settings were reset", "check")
        end if
    else if id = "profHideUnrated"
        profileAction("hideUnrated", m.menuProfile)
        return
    else if id = "startQualityHome" or id = "startQualityNet"
        Prefs.setStartQuality(id, value)
    else if id = "bannerSource" or id = "bannerRefresh"
        ' (one compact key for both)
        bp = Prefs.bannerPref()
        if id = "bannerSource"
            Prefs.setBannerPref(value, bp.minutes)
        else
            Prefs.setBannerPref(bp.source, value.toInt())
        end if
        m.top.themeChanged = true
    else if id = "homeServerLayout"
        HomeLayout.setServerLayout(serverKey(), isOn)
        m.top.themeChanged = true
    else if id = "subLang"
        Util.writeText(id, value)
        Prefs.setFlag("subAlways", true)
    else if id.startsWith("seg:")
        ' (v1.3) Settings → Playback → Skip: one compact key for all kinds
        Prefs.setSegmentSkip(id.mid(4), value)
    else
        Util.writeText(id, value)
        if homeKeys.doesExist(id) then m.top.themeChanged = true
    end if
    draw()
end sub

sub useButton(r as object)
    id = Util.toText(r.id)
    if id = "subDefaults"
        for each key in ["subTextSize", "subColor", "subShadow", "subBg", "subBottom"]
            Util.writeText(key, "")
        end for
        draw()
        Toasts.notify("Subtitle style reset to the defaults", "check")
    else if id = "homeDefaultOrder"
        HomeLayout.resetOrder(serverKey())
        m.top.themeChanged = true
        m.stack.peek().key = ""
        m.stack.peek().focus = 0
        draw()
        Toasts.notify("Home rows back in the default order", "check")
    else if id = "retryLibs"
        onServer()
        draw()
    else if id = "signout"
        guarded({ do: "signout" })
    else if id = "addServer"
        guarded({ do: "addServer" })
    else if id = "switchProfile"
        m.top.action = { id: "profiles" }
    else if id = "addProfile"
        guarded({ do: "addProfile" })
    else if id = "reset"
        guarded({ do: "reset" })
    else if id = "navOrderStart" or id = "navOrderDone"
        ' Navigation → Top Bar / Sidebar: the Change Order mode (its entries as rows to move)
        entry = m.stack.peek()
        entry.order = id = "navOrderStart"
        entry.key = ""
        entry.focus = 0
        if entry.order then entry.focus = 1
        m.spokenPage = ""
        draw()
    else if id = "libRename"
        askName("lib", "Library name", libTitle(m.menuLib))
    else if id = "srvConnect"
        guarded({ do: "connect", serverId: m.menuServer })
    else if id = "srvSignout"
        guarded({ do: "signout" })
    else if id = "srvRename"
        s = Servers.find(m.menuServer)
        if s <> invalid then askName("srv", "Server name", Util.toText(s.name))
    else if id = "srvRemove"
        guarded({ do: "removeServer", serverId: m.menuServer })
    else if id.startsWith("prof:")
        ' a profile page's action: use, pinSet, pinChange, pinRemove, rating, signout
        profileAction(id.mid(5), m.menuProfile)
    end if
end sub

' ---------------------------------------------------------------- libraries and servers

' The current server's id, for its own library order
function serverKey() as string
    if m.top.server = invalid then return ""
    return Util.toText(m.top.server.id)
end function

function libTitle(id as string) as string
    for each l in Prefs.orderLibraries(m.libs, serverKey())
        if l.id = id then return l.title
    end for
    return ""
end function

' The current server's libraries in the Libraries order (with the saved names), for Home rows and NavPrefs
function homeLibs() as object
    return Prefs.orderLibraries(m.libs, serverKey())
end function

' NavPrefs' libs: [{ id, title, collectionType }] in the Libraries order
function navLibs() as object
    out = []
    for each l in homeLibs()
        out.push({ id: Util.toText(l.id), title: Util.toText(l.title), collectionType: Util.toText(l.collectionType) })
    end for
    return out
end function

function labelOf(options as object, id as string) as string
    for each o in options
        if o.id = id then return o.label
    end for
    return id
end function

function capital(s as string) as string
    if s = "" then return s
    return UCase(s.left(1)) + s.mid(1)
end function

' Moves the row being moved on an order page; the focus follows it (the page is built again by its key)
sub moveRowBy(id as string, delta as integer)
    pid = m.stack.peek().id
    moved = false
    if pid = "homeOrder"
        moved = HomeLayout.move(serverKey(), homeLibs(), id, delta)
    else if pid.startsWith("navPlace:")
        moved = NavPrefs.moveEntry(pid.mid(9), id, delta, navLibs())
    else if pid = "libOrder"
        moved = moveLibrary(id, delta)
    end if
    if moved
        m.top.themeChanged = true
        draw()
    end if
end sub

function moveLibrary(id as string, delta as integer) as boolean
    ids = []
    for each l in homeLibs()
        ids.push(l.id)
    end for
    for i = 0 to ids.count() - 1
        if ids[i] = id
            j = i + delta
            if j < 0 or j >= ids.count() then return false
            ids[i] = ids[j]
            ids[j] = id
            Prefs.saveOrder(ids, serverKey())
            return true
        end if
    end for
    return false
end function

' ---------------------------------------------------------------- profiles, PINs and the parent PIN (v0.9.1)

' (v0.9.1) The profile on Home has a rating limit: profiles, PINs, servers and Reset need a parent PIN
' (the screen's copy of the server: Settings is rebuilt after a profile switch, and profileChanged() refreshes it)
function isRestricted() as boolean
    return Ratings.limitOf(m.top.server) > 0
end function

function restrictedNote() as string
    return "A profile with a rating limit is watching: changing profiles, PINs, rating limits or servers, and Reset All Settings, ask for a parent PIN."
end function

function profileSub(srv as object, p as object) as string
    parts = []
    if p.id = Util.toText(srv.userId) then parts.push("Watching now")
    if not p.signedIn then parts.push("Signed out")
    if parts.count() = 0 then parts.push("Signed in")
    if p.hasPin then parts.push("PIN")
    if p.maxRating <> "" then parts.push("Up to " + p.maxRating)
    if p.maxRating <> "" and p.hideUnrated then parts.push("Hides unrated")
    if p.maxRating = "" and p.hasPin then parts.push("Parent")
    return Util.join(parts, "  ·  ")
end function

' The current server as saved now (profiles change while Settings is open)
function currentServer() as dynamic
    if m.top.server = invalid then return invalid
    s = Servers.find(Util.toText(m.top.server.id))
    if s = invalid then s = m.top.server
    return s
end function

' Runs act now, or after a parent PIN while a profile with a rating limit is watching
sub guarded(act as object)
    if isRestricted()
        askPin({ goal: "parent", message: "A profile with a rating limit is watching. Enter a parent PIN (the PIN of a profile without a limit) to continue." }, act)
    else
        runAct(act)
    end if
end sub

' Starts the PIN steps (PinFlow); act runs when they succeed
sub askPin(q as object, act as dynamic)
    q.serverId = serverKey()
    q.tag = act
    m.pinFlow.request = q
end sub

sub notice(text as string)
    m.pinFlow.request = { goal: "notice", serverId: serverKey(), message: text }
end sub

sub onPinResult(ev as object)
    r = ev.getData()
    if Util.flag(r, "ok") and Util.isAA(r.tag) then runAct(r.tag)
    draw()
end sub

' A profile page's entry
sub profileAction(choiceId as string, userId as string)
    srv = currentServer()
    if srv = invalid then return
    cur = userId = Util.toText(srv.userId)
    if choiceId = "use"
        m.top.action = { id: "useProfile", userId: userId }
    else if choiceId = "signout"
        if isRestricted() or cur
            guarded({ do: "signoutProfile", userId: userId })
        else
            ' (another profile's PIN guards it from being signed out here)
            askPin({ goal: "verify", userId: userId }, { do: "signoutProfile", userId: userId })
        end if
    else if choiceId = "pinSet"
        guarded({ do: "pinSet", userId: userId })
    else if choiceId = "pinChange"
        if isRestricted()
            guarded({ do: "pinSet", userId: userId })
        else
            askPin({ goal: "verify", userId: userId, message: "Enter the current PIN of this profile." }, { do: "pinSet", userId: userId })
        end if
    else if choiceId = "pinRemove"
        if Servers.isLastParent(srv, userId)
            notice("This is the only parent PIN, and a profile has a rating limit. Set a PIN on another profile without a limit, or remove the limits, first.")
        else if isRestricted()
            guarded({ do: "pinRemove", userId: userId })
        else
            askPin({ goal: "verify", userId: userId, message: "Enter the current PIN of this profile." }, { do: "pinRemove", userId: userId })
        end if
    else if choiceId = "rating" or choiceId = "hideUnrated"
        ' (always a parent PIN, never the profile's own; with no parent PIN yet, the profile on Home, which has
        ' no limit, sets one first)
        act = { do: choiceId, userId: userId }
        if Servers.parentIds(srv).count() = 0 and not isRestricted()
            askPin({ goal: "set", userId: Util.toText(srv.userId), title: "Parent PIN for " + Util.toText(srv.userName), message: "Rating limits are guarded by a parent PIN. Set a 4-digit PIN for this profile first." }, act)
        else
            askPin({ goal: "parent", message: "Enter a parent PIN (the PIN of a profile without a rating limit) to change this." }, act)
        end if
    end if
end sub

' What a profile, server or Reset entry does once it's allowed
sub runAct(act as object)
    what = Util.toText(act.do)
    uid = Util.toText(act.userId)
    srv = currentServer()
    if srv = invalid then return
    sid = Util.toText(srv.id)
    if what = "reset"
        openPop({ kind: "choice", id: "resetConfirm", label: "Reset All Settings?", options: [{ id: "yes", label: "Reset" }, { id: "no", label: "Cancel" }], cur: "no" })
        return
    else if what = "askWho"
        Servers.setAsk(sid, Util.flag(act, "on"))
    else if what = "addServer"
        m.top.action = { id: "switch" }
    else if what = "addProfile"
        m.top.action = { id: "addProfile" }
    else if what = "signout"
        m.top.action = { id: "signout" }
    else if what = "connect"
        m.top.action = { id: "connect", serverId: Util.toText(act.serverId) }
    else if what = "removeServer"
        removeServer(Util.toText(act.serverId))
    else if what = "signoutProfile"
        signOutProfile(uid)
    else if what = "pinSet"
        askPin({ goal: "set", userId: uid, doneText: "PIN saved. Cove asks for it when someone picks this profile." }, invalid)
    else if what = "pinRemove"
        Servers.setUserField(sid, uid, "p", "")
        notice("PIN removed. Anyone can pick this profile now.")
    else if what = "rating"
        m.menuProfile = uid
        openRatingChoice()
        return
    else if what = "hideUnrated"
        u = Servers.userOf(srv, uid)
        isOn = u <> invalid and Util.toText(u.h) = "1"
        value = "1"
        if isOn then value = ""
        Servers.setUserField(sid, uid, "h", value)
        profileChanged(uid)
    end if
    draw()
end sub

' Maximum rating (kids limit) for a profile: a short list with a ✓ (after the parent PIN)
sub openRatingChoice()
    srv = currentServer()
    if srv = invalid then return
    u = Servers.userOf(srv, m.menuProfile)
    if u = invalid then return
    openPop({ kind: "choice", id: "rating:" + m.menuProfile, label: "Maximum Rating for " + Util.toText(u.n), options: Ratings.choices(), cur: Util.toText(u.r) })
end sub

sub setRating(userId as string, value as string)
    srv = currentServer()
    if srv = invalid then return
    ids = Servers.parentIds(srv)
    if value <> "" and ids.count() = 1 and ids[0] = userId
        ' (a limit on the only parent would leave every limit without a parent PIN)
        notice("This is the only profile without a limit that has a PIN. Set a PIN on another profile without a limit first.")
        draw()
        return
    end if
    Servers.setUserField(Util.toText(srv.id), userId, "r", value)
    profileChanged(userId)
    draw()
end sub

' A profile's limit changed: when it's the one on Home, its lists are asked again when Settings closes
sub profileChanged(userId as string)
    srv = currentServer()
    if srv = invalid then return
    if userId = Util.toText(srv.userId)
        cur = Servers.find(Util.toText(srv.id))
        if cur <> invalid then m.top.server = cur
        m.top.action = { id: "profileChanged" }
        m.top.themeChanged = true
    end if
end sub

' (SC-13) POST /Sessions/Logout for one sign-in. The task is parked in the scene's "tasks" group, so Back right
' after Remove / Sign Out doesn't take the request with this screen (finished ones are cleared each time).
sub sendLogout(us as object)
    t = createObject("roSGNode", "ApiTask")
    t.request = { method: "POST", url: Util.toText(us.url) + "/Sessions/Logout", headers: Api.headers(us, true), body: "", tag: { kind: "logout" }, timeout: 10000 }
    holder = logoutHolder()
    if holder = invalid
        if m.logoutTasks = invalid then m.logoutTasks = []
        m.logoutTasks.push(t)
    else
        for i = holder.getChildCount() - 1 to 0 step -1
            st = holder.getChild(i).state
            if st = "done" or st = "stop" then holder.removeChildIndex(i)
        end for
        holder.appendChild(t)
    end if
    t.control = "RUN"
end sub

' The scene's "tasks" group, looked up while Settings is on screen (getScene() is invalid once it has gone)
function logoutHolder() as dynamic
    if m.tasksHolder = invalid
        sc = m.top.getScene()
        if sc <> invalid then m.tasksHolder = sc.findNode("tasks")
    end if
    return m.tasksHolder
end function

' Signs one profile out: its session on the server, then it's forgotten here
sub signOutProfile(userId as string)
    srv = currentServer()
    if srv = invalid then return
    if userId = Util.toText(srv.userId)
        m.top.action = { id: "signout" }
        return
    end if
    us = Servers.asUser(srv, userId)
    if us = invalid then return
    if Util.toText(us.token) <> "" then sendLogout(us)
    Servers.removeUser(Util.toText(srv.id), userId)
    ' (its sub-list is gone: back to the Profiles tab)
    popToTab()
end sub

' Forgets a server and ends its session there (best effort)
sub removeServer(id as string)
    s = Servers.find(id)
    if s = invalid then return
    ' (every profile's session; the tasks outlive this screen, see sendLogout)
    for each us in Servers.sessions(s)
        sendLogout(us)
    end for
    Servers.forgetAll(id)
    Servers.remove(id)
    HomeLayout.forget(id)
    popToTab()
end sub

' ---------------------------------------------------------------- rename (the Roku keyboard)

sub askName(what as string, title as string, current as string)
    m.renameFor = what
    d = createObject("roSGNode", "StandardKeyboardDialog")
    d.title = title
    d.message = ["Leave it empty to use the server's name."]
    if what = "srv" then d.message = ["The name Cove shows for this server."]
    d.text = current
    d.buttons = ["OK", "Cancel"]
    d.observeField("buttonSelected", "onNameButton")
    d.observeField("wasClosed", "onNameClosed")
    m.top.getScene().dialog = d
    m.kbTimer.control = "start"
end sub

' (the keyboard sometimes opens without the focus)
sub focusKeyboard()
    d = m.top.getScene().dialog
    if d <> invalid then d.setFocus(true)
end sub

sub onNameButton()
    d = m.top.getScene().dialog
    if d = invalid then return
    ok = d.buttonSelected = 0
    text = Util.toText(d.text).trim()
    d.unobserveField("buttonSelected")
    d.unobserveField("wasClosed")
    d.close = true
    m.keys.setFocus(true)
    if ok
        if m.renameFor = "lib"
            Prefs.setLibrary(m.menuLib, "name", text)
            m.top.themeChanged = true
        else if m.renameFor = "srv" and text <> ""
            s = Servers.find(m.menuServer)
            if s <> invalid
                s.name = text
                Servers.upsert(s)
                if m.top.server <> invalid and Util.toText(m.top.server.id) = m.menuServer
                    cur = m.top.server
                    cur.name = text
                    m.top.server = cur
                    ' MainScene's copy too (it writes it back on an expired sign-in), and Home shows the name
                    m.top.action = { id: "renamed", serverId: m.menuServer, name: text }
                    m.top.themeChanged = true
                end if
            end if
        end if
    end if
    draw()
end sub

sub onNameClosed()
    d = m.top.getScene().dialog
    if d <> invalid
        d.unobserveField("buttonSelected")
        d.unobserveField("wasClosed")
    end if
    m.keys.setFocus(true)
    draw()
end sub

sub onFocusChanged()
    if m.top.hasFocus() then m.keys.setFocus(true)
end sub
