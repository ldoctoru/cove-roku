import "pkg:/source/Util.bs"
import "pkg:/source/Prefs.bs"

' Subtitles drawn by Cove (as on the Mac, Sources/Views.swift subtitleLayer): the server's SRT is parsed into
' cues on a Task thread (ApiTask with parse "srt"), and player/SubtitleLayer shows the one for the position,
' styled from Settings → Subtitles. Roku's own caption renderer isn't used for text subtitles: it ignores the
' app's style whenever the Roku's Accessibility → Captions style isn't Default, and has only three sizes.
' The Roku's caption settings still count: captions On starts a subtitle when Cove has no choice of its own,
' and its caption style fills in the style settings left at their defaults (see setting()).
namespace Subs

    ' SRT text → [{ s: start seconds, e: end seconds, t: "line" or "line 1" + chr(10) + "line 2" }], by start
    function parseSrt(text as dynamic) as object
        cues = []
        if text = invalid or text = "" then return cues
        ' (<i>, <font ...>, {\an8} and other tags are dropped)
        tags = createObject("roRegex", "<[^>]*>|\{[^}]*\}", "")
        lines = text.replace(chr(13), "").split(chr(10))
        n = lines.count()
        i = 0
        while i < n
            arrow = lines[i].instr("-->")
            if arrow > 0
                s = srtTime(lines[i].left(arrow))
                e = srtTime(lines[i].mid(arrow + 3))
                i++
                buf = []
                while i < n
                    l = lines[i].trim()
                    ' (a malformed file without a blank line: the next cue's timing line ends this one)
                    if l = "" or l.instr("-->") > 0 then exit while
                    l = tags.replaceAll(l, "").trim()
                    if l <> "" then buf.push(l)
                    i++
                end while
                ' (and its number, just before that timing line)
                if i < n and lines[i].instr("-->") > 0 and buf.count() > 0
                    if isNumber(buf.peek()) then buf.pop()
                end if
                if buf.count() > 0 and e > s then cues.push({ s: s, e: e, t: Util.join(buf, chr(10)) })
            else
                i++
            end if
        end while
        cues.sortBy("s")
        return cues
    end function

    function isNumber(x as string) as boolean
        if x = "" then return false
        for k = 1 to x.len()
            ch = Asc(Mid(x, k, 1))
            if ch < 48 or ch > 57 then return false
        end for
        return true
    end function

    ' "00:01:02,500" (anything after the time, e.g. SRT position hints, is ignored) → 62.5
    function srtTime(x as string) as float
        tok = x.trim().split(" ")
        if tok.count() = 0 then return 0
        parts = tok[0].replace(",", ".").split(":")
        if parts.count() = 3 then return parts[0].toInt() * 3600 + parts[1].toInt() * 60 + Val(parts[2])
        if parts.count() = 2 then return parts[0].toInt() * 60 + Val(parts[1])
        return Val(parts[0])
    end function

    ' The style from Settings → Subtitles, for a 1080 px high screen (the Mac's fractions of the height).
    ' scale: 1 for the player, smaller for the Settings preview.
    function style(scale = 1.0 as float) as object
        size = setting("subTextSize", "normal")
        frac = 0.045
        if size = "smaller" then frac = 0.032
        if size = "small" then frac = 0.038
        if size = "large" then frac = 0.055
        if size = "larger" then frac = 0.066
        col = setting("subColor", "white")
        tc = "0xFFFFFFFF"
        if col = "yellow" then tc = "0xFFEB3BFF"
        if col = "gray" then tc = "0xCCCCCCFF"
        if col = "black" then tc = "0x000000FF"
        ' (colours only the Roku's caption settings have)
        if col = "red" then tc = "0xFF453AFF"
        if col = "green" then tc = "0x32D74BFF"
        if col = "blue" then tc = "0x0A84FFFF"
        if col = "magenta" then tc = "0xFF2DD4FF"
        if col = "cyan" then tc = "0x64D2FFFF"
        ' the shadow is black, or white behind black text
        shade = "0x000000E6"
        if col = "black" then shade = "0xFFFFFFE6"
        sh = setting("subShadow", "drop")
        offsets = []
        d = 2
        if scale < 0.7 then d = 1
        if sh = "drop" then offsets = [[d, d], [d + 1, d + 1]]
        if sh = "raised" then offsets = [[1, d]]
        if sh = "outline" then offsets = [[-d, 0], [d, 0], [0, -d], [0, d], [-d, -d], [d, d], [-d, d], [d, -d]]
        bg = setting("subBg", "none")
        bgColor = ""
        if bg = "semi" then bgColor = "0x00000080"
        if bg = "black" then bgColor = "0x000000FF"
        return { fontSize: Int(1080 * frac * scale + 0.5), color: tc, shade: shade, offsets: offsets, bgColor: bgColor, bottom: Prefs.subBottom() }
    end function

    ' The style settings, shared by Settings → Subtitles and the player's Subtitles menu:
    ' [{ key, label, def, options: [{ id, label }] }]
    function styleChoices() as object
        bo = []
        for each v in [0, 5, 10, 15, 20, 25, 30]
            bo.push({ id: v.toStr(), label: v.toStr() + "%" })
        end for
        return [
            { key: "subTextSize", label: "Text size", def: "normal", options: [{ id: "smaller", label: "Smaller" }, { id: "small", label: "Small" }, { id: "normal", label: "Normal" }, { id: "large", label: "Large" }, { id: "larger", label: "Larger" }] },
            { key: "subColor", label: "Text color", def: "white", options: [{ id: "white", label: "White" }, { id: "yellow", label: "Yellow" }, { id: "gray", label: "Light gray" }, { id: "black", label: "Black" }] },
            { key: "subShadow", label: "Shadow", def: "drop", options: [{ id: "none", label: "None" }, { id: "drop", label: "Drop shadow" }, { id: "outline", label: "Outline" }, { id: "raised", label: "Raised" }] },
            { key: "subBg", label: "Background", def: "none", options: [{ id: "none", label: "Transparent" }, { id: "semi", label: "Semi-transparent" }, { id: "black", label: "Black" }] },
            { key: "subBottom", label: "Distance from bottom", def: "10", options: bo }
        ]
    end function

    ' The saved value of one style setting (its default when unset)
    function current(ch as object) as string
        if ch.key = "subBottom" then return Prefs.subBottom().toStr()
        return setting(ch.key, ch.def)
    end function

    ' ---------------------------------------------------------------- the Roku's caption settings
    ' Precedence for every style setting: Cove's own choice (Settings → Subtitles, the player's Subtitles menu)
    ' > the Roku's Settings → Accessibility → Captions style (when not Default) > Cove's default.

    ' One style setting as it applies now
    function setting(key as string, def as string) as string
        v = Util.readText(key)
        if v <> "" then return v
        r = rokuStyle(key)
        if r <> "" then return r
        return def
    end function

    ' The Roku's caption style for one of Cove's style keys, as a Cove value ("" = Default / no match).
    ' Font and window settings have no counterpart (Cove draws with the system font, without a window).
    function rokuStyle(key as string) as string
        di = createObject("roDeviceInfo")
        if di = invalid then return ""
        if key = "subTextSize"
            v = LCase(Util.toText(di.GetCaptionsOption("Text/Size")))
            sizes = { "extra small": "smaller", "small": "small", "medium": "normal", "large": "large", "extra large": "larger" }
            if sizes.doesExist(v) then return sizes[v]
        else if key = "subColor"
            v = LCase(Util.toText(di.GetCaptionsOption("Text/Color")))
            if v = "white" or v = "yellow" or v = "black" or v = "red" or v = "green" or v = "blue" or v = "magenta" or v = "cyan" then return v
        else if key = "subShadow"
            v = LCase(Util.toText(di.GetCaptionsOption("Text/Effect")))
            if v = "none" then return "none"
            if v = "raised" or v = "depressed" then return "raised"
            if v = "uniform" then return "outline"
            if v.startsWith("drop shadow") then return "drop"
        else if key = "subBg"
            ' (Cove's backgrounds are black: the Roku's opacity decides which one)
            v = LCase(Util.toText(di.GetCaptionsOption("Background/Opacity")))
            if v = "off" then return "none"
            if v = "25%" or v = "75%" then return "semi"
            if v = "100%" then return "black"
        end if
        return ""
    end function

    ' The Roku's caption mode: "On", "Off", "Instant replay" (a Roku TV set to "When mute" answers "On"
    ' while muted). Only read: the app never changes the Roku's setting.
    function rokuMode() as string
        di = createObject("roDeviceInfo")
        if di = invalid then return "Off"
        return Util.toText(di.GetCaptionsMode())
    end function

    ' The subtitle language to use when the Roku's captions start them: the language from Settings → Subtitles
    ' when one was chosen there, else the Roku's caption language ("en" → "english"), else English
    function rokuLanguage() as string
        if Util.readText("subLang") <> "" then return Prefs.subLang()
        di = createObject("roDeviceInfo")
        code = ""
        if di <> invalid then code = LCase(Util.toText(di.GetPreferredCaptionLanguage()))
        if code <> ""
            for each l in Prefs.languages()
                for each c in l.codes
                    if c = code then return LCase(l.name)
                end for
            end for
        end if
        return Prefs.subLang()
    end function

    ' "Normal" for the saved value
    function currentLabel(ch as object) as string
        v = current(ch)
        for each o in ch.options
            if o.id = v then return o.label
        end for
        return v
    end function

end namespace
