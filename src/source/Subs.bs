import "pkg:/source/Util.bs"
import "pkg:/source/Prefs.bs"

' Subtitles drawn by Cove (as on the Mac, Sources/Views.swift subtitleLayer): the server's SRT is parsed into
' cues on a Task thread (ApiTask with parse "srt"), and player/SubtitleLayer shows the one for the position,
' styled from Settings → Subtitles. Roku's own caption renderer isn't used for text subtitles: it ignores the
' app's style whenever the Roku's Accessibility → Captions style isn't Default, and has only three sizes.
' The Roku's caption settings still count: captions On starts a subtitle when Cove has no choice of its own,
' and its caption style is used for every style setting left at "Roku setting", the default (see style()).
namespace Subs

    ' SRT text → [{ s: start seconds, e: end seconds, t: "line" or "line 1" + chr(10) + "line 2" }], by start
    function parseSrt(text as dynamic) as object
        cues = []
        if text = invalid or text = "" then return cues
        ' (<i>, <font ...>, {\an8} and other tags are dropped)
        tags = createObject("roRegex", "<[^>]*>|\{[^}]*\}", "")
        lines = text.replace(chr(13), "").split(chr(10))
        n = lines.count()
        i = 0
        while i < n
            arrow = lines[i].instr("-->")
            if arrow > 0
                s = srtTime(lines[i].left(arrow))
                e = srtTime(lines[i].mid(arrow + 3))
                i++
                buf = []
                while i < n
                    l = lines[i].trim()
                    ' (a malformed file without a blank line: the next cue's timing line ends this one)
                    if l = "" or l.instr("-->") > 0 then exit while
                    l = tags.replaceAll(l, "").trim()
                    if l <> "" then buf.push(l)
                    i++
                end while
                ' (and its number, just before that timing line)
                if i < n and lines[i].instr("-->") > 0 and buf.count() > 0
                    if isNumber(buf.peek()) then buf.pop()
                end if
                if buf.count() > 0 and e > s then cues.push({ s: s, e: e, t: Util.join(buf, chr(10)) })
            else
                i++
            end if
        end while
        cues.sortBy("s")
        return cues
    end function

    function isNumber(x as string) as boolean
        if x = "" then return false
        for k = 1 to x.len()
            ch = Asc(Mid(x, k, 1))
            if ch < 48 or ch > 57 then return false
        end for
        return true
    end function

    ' "00:01:02,500" (anything after the time, e.g. SRT position hints, is ignored) → 62.5
    function srtTime(x as string) as float
        tok = x.trim().split(" ")
        if tok.count() = 0 then return 0
        parts = tok[0].replace(",", ".").split(":")
        if parts.count() = 3 then return parts[0].toInt() * 3600 + parts[1].toInt() * 60 + Val(parts[2])
        if parts.count() = 2 then return parts[0].toInt() * 60 + Val(parts[1])
        return Val(parts[0])
    end function

    ' The style from Settings → Subtitles, for a 1080 px high screen (the Mac's fractions of the height).
    ' scale: 1 for the player, smaller for the Settings preview.
    ' C-1: a style setting the user hasn't set in Cove ("Roku setting", the default) follows the Roku's
    ' Settings > Accessibility > Caption style: text size, color, opacity, font, edge effect, background
    ' color and opacity, and the window (which only the Roku has).
    function style(scale = 1.0 as float) as object
        di = createObject("roDeviceInfo")
        size = setting("subTextSize", di)
        frac = 0.045
        if size = "smaller" then frac = 0.032
        if size = "small" then frac = 0.038
        if size = "large" then frac = 0.055
        if size = "larger" then frac = 0.066
        col = setting("subColor", di)
        tc = colorHex(col)
        ' (the Roku's text opacity, only while the color is the Roku's too)
        alpha = "FF"
        if not userSet("subColor") then alpha = opacityHex(captionOption(di, "Text/Opacity"), "FF")
        ' the shadow is black, or white behind black text
        shade = "0x000000E6"
        if col = "black" then shade = "0xFFFFFFE6"
        sh = setting("subShadow", di)
        offsets = []
        d = 2
        if scale < 0.7 then d = 1
        if sh = "drop" then offsets = [[d, d], [d + 1, d + 1]]
        if sh = "dropLeft" then offsets = [[-d, d], [-d - 1, d + 1]]
        if sh = "raised" then offsets = [[1, d]]
        if sh = "depressed" then offsets = [[-1, -d]]
        if sh = "outline" then offsets = [[-d, 0], [d, 0], [0, -d], [0, d], [-d, -d], [d, d], [-d, d], [d, -d]]
        bgColor = ""
        winColor = ""
        if userSet("subBg")
            bg = setting("subBg", di)
            if bg = "semi" then bgColor = "0x00000080"
            if bg = "black" then bgColor = "0x000000FF"
        else
            ' (the Roku's background and window: any color, the opacity decides whether it shows)
            a = opacityHex(captionOption(di, "Background/Opacity"), "")
            if a <> "" then bgColor = colorHex(LCase(captionOption(di, "Background/Color")), "black") + a
            a = opacityHex(captionOption(di, "Window/Opacity"), "")
            if a <> "" then winColor = colorHex(LCase(captionOption(di, "Window/Color")), "black") + a
        end if
        ' the Roku's font: only the system font is on the device, so Small Caps is drawn as capitals a
        ' little smaller and every other face as the system font
        caps = LCase(captionOption(di, "Text/Font")) = "small caps"
        if caps then frac = frac * 0.85
        return { fontSize: Int(1080 * frac * scale + 0.5), color: tc + alpha, shade: shade, offsets: offsets, bgColor: bgColor, winColor: winColor, upper: caps, fontUri: "font:MediumSystemFontFile", bottom: Prefs.subBottom() }
    end function

    ' "0xRRGGBB" for a Cove or Roku color name (fallback: the name to use when it's unknown / Default)
    function colorHex(name as string, fallback = "white" as string) as string
        hexes = { white: "0xFFFFFF", yellow: "0xFFEB3B", gray: "0xCCCCCC", black: "0x000000", red: "0xFF453A", green: "0x32D74B", blue: "0x0A84FF", magenta: "0xFF2DD4", cyan: "0x64D2FF" }
        if hexes.doesExist(name) then return hexes[name]
        return hexes[fallback]
    end function

    ' The alpha byte for a Roku opacity ("25%" → "40"); def for Default (and "" for Off)
    function opacityHex(v as string, def as string) as string
        if v = "Off" then return ""
        if v = "25%" then return "40"
        if v = "50%" then return "80"
        if v = "75%" then return "BF"
        if v = "100%" then return "FF"
        return def
    end function

    ' The style settings, shared by Settings → Subtitles and the player's Subtitles menu:
    ' [{ key, label, def, options: [{ id, label }] }]. "roku" (the default) follows the Roku's caption style.
    function styleChoices() as object
        bo = []
        for each v in [0, 5, 10, 15, 20, 25, 30]
            bo.push({ id: v.toStr(), label: v.toStr() + "%" })
        end for
        rk = { id: "roku", label: "Roku setting" }
        return [
            { key: "subTextSize", label: "Text size", def: "roku", options: [rk, { id: "smaller", label: "Smaller" }, { id: "small", label: "Small" }, { id: "normal", label: "Normal" }, { id: "large", label: "Large" }, { id: "larger", label: "Larger" }] },
            { key: "subColor", label: "Text color", def: "roku", options: [rk, { id: "white", label: "White" }, { id: "yellow", label: "Yellow" }, { id: "gray", label: "Light gray" }, { id: "black", label: "Black" }] },
            { key: "subShadow", label: "Shadow", def: "roku", options: [rk, { id: "none", label: "None" }, { id: "drop", label: "Drop shadow" }, { id: "outline", label: "Outline" }, { id: "raised", label: "Raised" }] },
            { key: "subBg", label: "Background", def: "roku", options: [rk, { id: "none", label: "Transparent" }, { id: "semi", label: "Semi-transparent" }, { id: "black", label: "Black" }] },
            { key: "subBottom", label: "Distance from bottom", def: "10", options: bo }
        ]
    end function

    ' The saved value of one style setting: "roku" while it follows the Roku's caption style
    function current(ch as object) as string
        if ch.key = "subBottom" then return Prefs.subBottom().toStr()
        if not userSet(ch.key) then return "roku"
        return Util.readText(ch.key)
    end function

    ' ---------------------------------------------------------------- the Roku's caption settings
    ' Precedence for every style setting: Cove's own choice (Settings → Subtitles, the player's Subtitles menu)
    ' > the Roku's Settings → Accessibility → Captions style (when not Default) > Cove's default.

    ' The user chose this style setting in Cove (not "Roku setting" / never set)
    function userSet(key as string) as boolean
        v = Util.readText(key)
        return v <> "" and v <> "roku"
    end function

    ' One style setting as it applies now
    function setting(key as string, di as dynamic) as string
        if userSet(key) then return Util.readText(key)
        r = rokuStyle(key, di)
        if r <> "" then return r
        defs = { subTextSize: "normal", subColor: "white", subShadow: "drop", subBg: "none" }
        return Util.toText(defs[key])
    end function

    ' One of the Roku's caption options ("" when it can't be read)
    function captionOption(di as dynamic, name as string) as string
        if di = invalid then return ""
        return Util.toText(di.GetCaptionsOption(name))
    end function

    ' The Roku's caption style for one of Cove's style keys, as a Cove value ("" = Default / no match).
    function rokuStyle(key as string, di as dynamic) as string
        if key = "subTextSize"
            v = LCase(captionOption(di, "Text/Size"))
            sizes = { "extra small": "smaller", "small": "small", "medium": "normal", "large": "large", "extra large": "larger" }
            if sizes.doesExist(v) then return sizes[v]
        else if key = "subColor"
            v = LCase(captionOption(di, "Text/Color"))
            if v = "white" or v = "yellow" or v = "black" or v = "red" or v = "green" or v = "blue" or v = "magenta" or v = "cyan" then return v
        else if key = "subShadow"
            v = LCase(captionOption(di, "Text/Effect"))
            if v = "none" then return "none"
            if v = "raised" then return "raised"
            if v = "depressed" then return "depressed"
            if v = "uniform" then return "outline"
            if v = "drop shadow (left)" then return "dropLeft"
            if v.startsWith("drop shadow") then return "drop"
        else if key = "subBg"
            v = LCase(captionOption(di, "Background/Opacity"))
            if v = "off" then return "none"
            if v = "25%" or v = "50%" or v = "75%" then return "semi"
            if v = "100%" then return "black"
        end if
        return ""
    end function

    ' The Roku's caption mode: "On", "Off", "Instant replay" (a Roku TV set to "When mute" answers "On"
    ' while muted). Only read: the app never changes the Roku's setting.
    function rokuMode() as string
        di = createObject("roDeviceInfo")
        if di = invalid then return "Off"
        return Util.toText(di.GetCaptionsMode())
    end function

    ' The subtitle language to use when the Roku's captions start them: the language from Settings → Subtitles
    ' when one was chosen there, else the Roku's caption language ("en" → "english"), else English
    function rokuLanguage() as string
        if Util.readText("subLang") <> "" then return Prefs.subLang()
        di = createObject("roDeviceInfo")
        code = ""
        if di <> invalid then code = LCase(Util.toText(di.GetPreferredCaptionLanguage()))
        if code <> ""
            for each l in Prefs.languages()
                for each c in l.codes
                    if c = code then return LCase(l.name)
                end for
            end for
        end if
        return Prefs.subLang()
    end function

    ' "Normal" for the saved value ("Roku setting" while it follows the Roku)
    function currentLabel(ch as object) as string
        v = current(ch)
        for each o in ch.options
            if o.id = v then return o.label
        end for
        return v
    end function

end namespace
