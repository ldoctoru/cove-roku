' The library grid's paging and page-key maths (v1.1.1 SP-6 / NV page keys), kept pure for the unit tests.
namespace LibGrid

    ' Cards per screen: 7 columns x 2 rows (VD-1)
    function cols() as integer
        return 7
    end function

    ' (SP-6) The first page: 6 rows, 2 on screen and 4 ahead, so the first paint waits for 42 cards at most
    function firstPage() as integer
        return 36
    end function

    ' (SP-6) Every page after the first, asked for at once and then whenever the focus nears the end
    function nextPage() as integer
        return 96
    end function

    ' (SP-6) Load the next page once the focus is within 8 rows of the last loaded card
    function needsMore(focused as integer, loaded as integer, columns as integer) as boolean
        if loaded <= 0 then return false
        return focused >= loaded - 8 * columns
    end function

    ' (SP-6) Placeholder cards shown at the end while a page loads: the rest of the last row plus one row
    function placeholderCount(loaded as integer, columns as integer) as integer
        if columns <= 0 then return 0
        rest = (columns - (loaded mod columns)) mod columns
        return rest + columns
    end function

    ' (NV page keys) How far one Rewind / Fast Forward press moves: a screen, then x2 and x4 while the key
    ' is pressed again within the repeat window (streak = presses in a row, 0 for the first)
    function jumpSize(streak as integer, screenful as integer) as integer
        if streak >= 4 then return screenful * 4
        if streak >= 2 then return screenful * 2
        return screenful
    end function

    ' (NV page keys) The card a jump lands on: the same column, never before the first card or after the last
    ' loaded one (the grid then loads more, and the next press goes on from there); -1 when nothing changes
    function jumpTarget(focused as integer, loaded as integer, size as integer, forward as boolean) as integer
        if loaded <= 0 or focused < 0 then return -1
        target = focused - size
        if forward then target = focused + size
        if target > loaded - 1 then target = loaded - 1
        if target < 0 then target = 0
        if target = focused then return -1
        return target
    end function

    ' (v1.2 NV-14) The session key a library page's position is kept under: the server and user, the page
    ' (library id, or its feed / genre / studio), the tab and every sort and filter choice. Another sort or
    ' filter is another key, so a position only comes back with the same sort and filter.
    function positionKey(serverUrl as string, userId as string, scope as string, tabId as string, sortId as string, orderId as string, showId as string, genreName as string, letterId as string) as string
        return serverUrl + "|" + userId + "|" + scope + "|" + tabId + "|" + sortId + "|" + orderId + "|" + showId + "|" + genreName + "|" + letterId
    end function

    ' (v1.2 NV-14) The most cards the first request may ask for to reach a remembered card (36 + 4 x 96): more
    ' would keep the skeleton up too long, so a card past it falls back to the end of what this loads
    function restoreCap() as integer
        return firstPage() + 4 * nextPage()
    end function

    ' (v1.2 NV-14) How many cards the first request asks for to come back on card index: the 36 + 96 + 96 ...
    ' steps of the normal paging, enough for the card's screen (two rows after its own), at most maxCards
    function restoreLimit(index as integer, maxCards as integer) as integer
        limit = firstPage()
        want = 0
        if index >= 0 then want = (Int(index / cols()) + 3) * cols()
        while limit < want and limit < maxCards
            limit = limit + nextPage()
        end while
        if limit > maxCards then limit = maxCards
        return limit
    end function

    ' (v1.2 NV-14) The card to land on: the remembered one when loaded, else the last loaded card (-1: none)
    function restoreTarget(index as integer, loaded as integer) as integer
        if loaded <= 0 or index < 0 then return -1
        if index > loaded - 1 then return loaded - 1
        return index
    end function

end namespace
