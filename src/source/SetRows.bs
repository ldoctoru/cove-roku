import "pkg:/source/Util.bs"

' (v1.5) Pure helpers for Settings in the Cove for Mac format (components/settings): tabs across the top, the
' selected tab's sections under them. Which rows take the focus, their heights, the list's scroll position,
' the choice list's place, Title Case labels and what the Audio Guide says for a row.
' A row is an AA: { kind, id, label, value, sub, on, checked, dim, target, options, cur, cols }; kinds:
'   head (section heading, grey caps), note (help text), link (opens a sub-list: value + ›), choice (opens a
'   small list with a check: value + ›), switch (on / off), button, option (a value in a choice list), move (a
'   row that can be picked up and moved), info (label + value), keys (a remote key and what it does),
'   server / profile (two lines), lib (a library in the Libraries table: Top Bar / Sidebar / Home columns) and
'   cols (the table's column titles).
namespace SetRows

    ' Rows the focus stops on (headings, notes, column titles and dimmed rows are skipped)
    function takesFocus(r as object) as boolean
        k = Util.toText(r.kind)
        if k = "head" or k = "note" or k = "cols" or k = "" then return false
        if Util.flag(r, "dim") then return false
        return true
    end function

    ' Characters per line of grey text (Medium 24) in a column this wide
    function charsFor(widthPx as integer) as integer
        n = Int(widthPx / 13)
        if n < 30 then n = 30
        return n
    end function

    function isTwoLine(r as object) as boolean
        k = Util.toText(r.kind)
        if k = "keys" or k = "server" or k = "profile" then return true
        return k = "info" and Util.toText(r.sub) <> ""
    end function

    ' A row's height; chars: characters per line of its notes and second lines
    function rowHeight(r as object, chars as integer) as integer
        k = Util.toText(r.kind)
        if k = "head" then return 70
        if k = "cols" then return 44
        if k = "note" then return 30 * Util.wrapLines(Util.toText(r.text), chars, 8).count() + 14
        if isTwoLine(r)
            n = Util.wrapLines(Util.toText(r.sub), chars, 3).count()
            if n < 1 then n = 1
            return 56 + 30 * n + 10
        end if
        return 72
    end function

    ' The gap under a row before the next one
    function gapAfter(r as object) as integer
        k = Util.toText(r.kind)
        if k = "head" or k = "cols" then return 0
        return 8
    end function

    ' The list's scroll position that keeps a row (y, h) on screen with a margin above and below it
    function scrollFor(top as integer, y as integer, h as integer, viewH as integer, total as integer, margin as integer) as integer
        t = top
        if y - margin < t then t = y - margin
        if y + h + margin > t + viewH then t = y + h + margin - viewH
        if t > total - viewH then t = total - viewH
        if t < 0 then t = 0
        return t
    end function

    ' The next tab to the left (delta -1) or right (+1); stays on the first / last one
    function tabStep(cur as integer, delta as integer, count as integer) as integer
        n = cur + delta
        if n < 0 then n = 0
        if n > count - 1 then n = count - 1
        return n
    end function

    ' The top of a choice list popH high next to a row at rowY (screen), kept between minY and maxY
    function popTop(rowY as integer, rowH as integer, popH as integer, minY as integer, maxY as integer) as integer
        y = rowY + Int(rowH / 2) - Int(popH / 2)
        if y + popH > maxY then y = maxY - popH
        if y < minY then y = minY
        return y
    end function

    ' "Text size" -> "Text Size", "Distance from bottom" -> "Distance from Bottom" (small words stay lower case)
    function titleCase(s as string) as string
        small = {}
        for each sw in ["a", "an", "and", "as", "at", "by", "for", "from", "in", "of", "on", "or", "the", "to", "with"]
            small[sw] = true
        end for
        words = s.split(" ")
        out = []
        for i = 0 to words.count() - 1
            w = words[i]
            if w <> "" and (i = 0 or not small.doesExist(LCase(w)))
                w = UCase(w.left(1)) + w.mid(1)
            end if
            out.push(w)
        end for
        return Util.join(out, " ")
    end function

    ' The 36 px icon of a library in the Libraries table: film, tv or folder
    function libIcon(collectionType as string) as string
        ct = LCase(collectionType)
        if ct = "movies" then return "film"
        if ct = "tvshows" then return "tv"
        return "folder"
    end function

    ' "5 of 6" for a list of { on }
    function countOn(list as object) as string
        n = 0
        for each e in list
            if Util.flag(e, "on") then n = n + 1
        end for
        return n.toStr() + " of " + list.count().toStr()
    end function

    ' What the Audio Guide says for a tab ("Home, tab, 2 of 9")
    function tabSpeech(label as string, index as integer, count as integer) as string
        return label + ", tab, " + (index + 1).toStr() + " of " + count.toStr()
    end function

    ' What the Audio Guide says for a focused row (moving: the row being moved)
    function speech(r as object, moving as boolean) as string
        k = Util.toText(r.kind)
        label = Util.toText(r.label)
        value = Util.toText(r.value)
        if k = "switch"
            if Util.flag(r, "on") then return label + ", switch, on"
            return label + ", switch, off"
        end if
        if k = "choice" then return label + ": " + value + ", menu button"
        if k = "link" or k = "button" or k = "lib"
            if value <> "" then return label + ", " + value + ", button"
            return label + ", button"
        end if
        if k = "option"
            if Util.flag(r, "checked") then return label + ", selected"
            return label
        end if
        if k = "move"
            if moving then return label + ", moving. Press Up or Down to move it, then OK"
            text = label
            if value <> "" then text = text + ", " + value
            return text + ", press OK to move it"
        end if
        if k = "keys" then return label + ": " + Util.toText(r.sub)
        if k = "server" or k = "profile"
            text = label + ", " + Util.toText(r.sub)
            if value <> "" then text = text + ", " + value
            return text + ", button"
        end if
        if k = "info"
            text = label
            if value <> "" then text = text + ", " + value
            if Util.toText(r.sub) <> "" then text = text + ", " + Util.toText(r.sub)
            return text
        end if
        return label
    end function

    ' A row's key for keeping the focus on it when the page is built again (ids are stable, labels may change)
    function keyOf(r as object) as string
        id = Util.toText(r.id)
        if id <> "" then return Util.toText(r.kind) + "|" + id
        return Util.toText(r.kind) + "||" + Util.toText(r.label)
    end function

end namespace
