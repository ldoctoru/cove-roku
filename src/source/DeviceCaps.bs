import "pkg:/source/Util.bs"

' What this Roku can play. Later PRs build the server's device profile from it, so the server only converts what
' the Roku can't decode (e.g. the Streambar 9102 plays HEVC Main 10 / HDR10 up to 4K but H.264 only up to 1080p).
namespace DeviceCaps

    function get() as object
        di = createObject("roDeviceInfo")
        display = di.getDisplayProperties()
        ui = di.getUIResolution()
        caps = {
            model: Util.toText(di.getModel()),
            modelName: Util.toText(di.getModelDisplayName()),
            os: osVersion(di),
            uiHeight: ui.height,
            videoMode: Util.toText(di.getVideoMode()),
            hdr10: Util.flag(display, "hdr10"),
            hlg: Util.flag(display, "hlg"),
            dolbyVision: Util.flag(display, "dolbyVision"),
            hevc: canDecode(di, "hevc", "main", "5.1"),
            hevc10: canDecode(di, "hevc", "main 10", "5.1"),
            h264: canDecode(di, "mpeg4 avc", "high", "4.2"),
            ac3: canDecodeAudio(di, "ac3"),
            eac3: canDecodeAudio(di, "eac3"),
            ' (DTS only passes through to a receiver or TV that decodes it)
            dts: canDecodeAudio(di, "dts")
        }
        caps.fourK = Instr(1, caps.videoMode, "2160") > 0
        return caps
    end function

    ' "Roku Streambar (9102X)  ·  Roku OS 15.0.4  ·  2160p60b10"
    function deviceLine(caps as object) as string
        return caps.modelName + " (" + caps.model + ")  ·  Roku OS " + caps.os + "  ·  " + caps.videoMode
    end function

    ' "HDR10, HLG  ·  HEVC 10-bit, H.264, E-AC3, AC3"
    function playbackLine(caps as object) as string
        hdr = []
        if caps.hdr10 then hdr.push("HDR10")
        if caps.hlg then hdr.push("HLG")
        if caps.dolbyVision then hdr.push("Dolby Vision")
        if hdr.count() = 0 then hdr.push("no HDR on this TV")
        codecs = []
        if caps.hevc10
            codecs.push("HEVC 10-bit")
        else if caps.hevc
            codecs.push("HEVC")
        end if
        if caps.h264 then codecs.push("H.264")
        if caps.eac3 then codecs.push("E-AC3")
        if caps.ac3 then codecs.push("AC3")
        if Util.flag(caps, "dts") then codecs.push("DTS")
        return Util.join(hdr, ", ") + "  ·  " + Util.join(codecs, ", ")
    end function

    function canDecode(di as object, codec as string, profile as string, level as string) as boolean
        r = di.canDecodeVideo({ codec: codec, profile: profile, level: level })
        return r <> invalid and Util.flag(r, "result")
    end function

    function canDecodeAudio(di as object, codec as string) as boolean
        r = di.canDecodeAudio({ codec: codec })
        return r <> invalid and Util.flag(r, "result")
    end function

    function osVersion(di as object) as string
        v = di.getOSVersion()
        if v = invalid then return "?"
        return Util.toText(v.major) + "." + Util.toText(v.minor) + "." + Util.toText(v.revision)
    end function

end namespace
