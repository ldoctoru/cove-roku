import "pkg:/source/Util.bs"
import "pkg:/source/Prefs.bs"
import "pkg:/source/NavPrefs.bs"

' Settings → Home → Rows: which Home rows show and in what order, per server.
' Row ids: "resume" (Continue Watching), "nextup", "upcoming" (v1.1: episodes not aired yet), "favorites",
' "recent" (Recently Added, all libraries), "released" (v1.1: Recently Released, by premiere date),
' "L<libraryId>" (a library's row) and "libraries" (v1.5: "My Media", the libraries' own 16:9 tiles as in Emby).
' One registry key per server, "homeRows:<serverId>": an optional "@" (use the server's Home layout), then the
' ids in order, comma separated; "+" / "-" before resume / upcoming / recent / released / libraries = switched
' on / off (no sign: the default, on for resume, upcoming and libraries, off for Recently Added and Recently
' Released; Upcoming shows only when the server has upcoming episodes). The other switches keep their
' existing keys, so Settings → Libraries and Home → Rows can't disagree: Next Up = "showUpNextRow",
' Favorites = "homeFavorites", a library's row = its "Row on Home" (v1.5: NavPrefs.libraryOnHome, no longer tied
' to the sidebar).
namespace HomeLayout

    function regKey(serverId as string) as string
        return "homeRows:" + serverId
    end function

    ' { server: boolean, order: [ids], flags: { id: boolean } } as saved (order may be empty: the default)
    function readState(serverId as string) as object
        st = { server: false, order: [], flags: {} }
        v = Util.readText(regKey(serverId))
        if v.left(1) = "@"
            st.server = true
            v = v.mid(1)
        end if
        for each tok in v.split(",")
            sign = tok.left(1)
            if sign = "-" or sign = "+"
                tok = tok.mid(1)
                st.flags[tok] = sign = "+"
            end if
            if tok <> "" then st.order.push(tok)
        end for
        return st
    end function

    sub writeState(serverId as string, st as object)
        parts = []
        for each id in st.order
            if st.flags.doesExist(id) and st.flags[id] = true
                parts.push("+" + id)
            else if st.flags.doesExist(id)
                parts.push("-" + id)
            else
                parts.push(id)
            end if
        end for
        out = Util.join(parts, ",")
        if st.server then out = "@" + out
        Util.writeText(regKey(serverId), out)
    end sub

    ' (when a server is removed)
    sub forget(serverId as string)
        sec = createObject("roRegistrySection", "Cove")
        if sec.exists(regKey(serverId))
            sec.delete(regKey(serverId))
            sec.flush()
        end if
    end sub

    function useServerLayout(serverId as string) as boolean
        return readState(serverId).server
    end function

    sub setServerLayout(serverId as string, on as boolean)
        st = readState(serverId)
        st.server = on
        writeState(serverId, st)
    end sub

    function libRowId(libId as string) as string
        return "L" + libId
    end function

    ' The rows Cove can show, in the default order. libs: the server's libraries in the Libraries order
    ' ([{ id, title, collectionType }]); (v1.5) every library can have a row, whatever its kind, and My Media
    ' comes right after Continue Watching / Next Up, as on Emby (a saved Row Order keeps its place)
    function defaultIds(libs as object) as object
        ' (v1.7 NAV M-6) "because" (Because You Watched, off by default) right after Recently Added: a saved
        ' order without it gets it after Recently Added (orderedIds), a saved default order stays the default
        ids = ["resume", "nextup", "libraries", "upcoming", "favorites", "recent", "because", "released"]
        for each l in libs
            id = Util.toText(l.id)
            if id <> "" then ids.push(libRowId(id))
        end for
        return ids
    end function

    ' (v1.5.2 ST-11) The default order before v1.5: the same rows with My Media at the end
    function oldDefaultIds(defs as object) as object
        out = []
        for each id in defs
            if id <> "libraries" then out.push(id)
        end for
        out.push("libraries")
        return out
    end function

    ' The saved order with the rows the server no longer has dropped, and new ones (a new library) placed after
    ' the row that comes before them in the default order (a saved order keeps My Media where it was)
    function orderedIds(serverId as string, libs as object) as object
        defs = defaultIds(libs)
        known = {}
        for each id in defs
            known[id] = true
        end for
        out = []
        used = {}
        for each id in readState(serverId).order
            if known.doesExist(id) and not used.doesExist(id)
                out.push(id)
                used[id] = true
            end if
        end for
        ' (a saved order that only keeps the default's own order, e.g. after Default Order: the default as it is)
        if isInOrder(out, defs) then return defs
        ' (v1.5.2 ST-11) the v1.3.2 default (My Media last, written in full by a Home row switch) was never
        ' chosen: the new default
        if out.count() > 0 and out.peek() = "libraries" and isInOrder(out, oldDefaultIds(defs)) then return defs
        for i = 0 to defs.count() - 1
            id = defs[i]
            if not used.doesExist(id)
                at = 0
                for j = i - 1 to 0 step -1
                    ' (v1.5: My Media moved up in the default order; where a saved order has it says nothing
                    ' about the rows that came after it before, so new rows aren't placed after it)
                    k = -1
                    if defs[j] <> "libraries" then k = indexIn(out, defs[j])
                    if k >= 0
                        at = k + 1
                        exit for
                    end if
                end for
                insertAt(out, at, id)
                used[id] = true
            end if
        end for
        return out
    end function

    ' Are the ids of part in the same order as in whole? (every id of part is in whole)
    function isInOrder(part as object, whole as object) as boolean
        last = -1
        for each id in part
            k = indexIn(whole, id)
            if k <= last then return false
            last = k
        end for
        return true
    end function

    function indexIn(list as object, id as string) as integer
        for i = 0 to list.count() - 1
            if list[i] = id then return i
        end for
        return -1
    end function

    sub insertAt(list as object, at as integer, id as string)
        list.push(id)
        i = list.count() - 1
        while i > at
            list[i] = list[i - 1]
            i = i - 1
        end while
        list[at] = id
    end sub

    ' Is the row switched on? (v1.5: a library's row on its own, whether or not the menus show the library)
    function isOn(serverId as string, id as string) as boolean
        if id = "nextup" then return Prefs.showUpNextRow()
        if id = "favorites" then return Prefs.flagOn("homeFavorites", true)
        if id.left(1) = "L" then return NavPrefs.libraryOnHome(id.mid(1))
        st = readState(serverId)
        if st.flags.doesExist(id) then return st.flags[id] = true
        ' (Recently Added and Recently Released are off until switched on, so Home looks as before; v1.7
        ' Because You Watched too)
        return id <> "recent" and id <> "released" and id <> "because"
    end function

    sub setOn(serverId as string, libs as object, id as string, on as boolean)
        if id = "nextup"
            Prefs.setFlag("showUpNextRow", on)
        else if id = "favorites"
            Prefs.setFlag("homeFavorites", on)
        else if id.left(1) = "L"
            NavPrefs.setLibraryOnHome(id.mid(1), on)
        else
            st = readState(serverId)
            st.order = orderedIds(serverId, libs)
            st.flags[id] = on
            writeState(serverId, st)
        end if
    end sub

    ' Moves a row one place up (-1) or down (1); returns false at either end
    function move(serverId as string, libs as object, id as string, delta as integer) as boolean
        ids = orderedIds(serverId, libs)
        i = indexIn(ids, id)
        j = i + delta
        if i < 0 or j < 0 or j >= ids.count() then return false
        ids[i] = ids[j]
        ids[j] = id
        st = readState(serverId)
        st.order = ids
        writeState(serverId, st)
        return true
    end function

    ' Back to the default order (the switches stay; they ride on the ids, so the order keeps just those)
    sub resetOrder(serverId as string)
        st = readState(serverId)
        kept = []
        for each id in ["resume", "libraries", "upcoming", "recent", "released", "because"]
            if st.flags.doesExist(id) then kept.push(id)
        end for
        st.order = kept
        writeState(serverId, st)
    end sub

    ' ---------------------------------------------------------------- the server's Home layout

    ' The web app's Home sections (DisplayPreferences "usersettings", client "emby": CustomPrefs homesection0..n)
    ' → Cove row ids in that order. latestmedia = every library's row; sections Cove doesn't have (Live TV,
    ' audio / book resume, recordings) are skipped. The web apps have no Upcoming or Recently Released section
    ' (Jellyfin web: smalllibrarytiles, librarybuttons, activerecordings, resume, resumeaudio, resumebook, livetv,
    ' nextup, latestmedia), so those two rows show only with Cove's own layout. dp = the DisplayPreferences JSON, or invalid when the
    ' request failed (→ invalid: use Cove's own order).
    function fromServer(dp as dynamic, libs as object) as dynamic
        if not Util.isAA(dp) then return invalid
        cp = Util.field(dp, "CustomPrefs")
        sections = []
        found = false
        for i = 0 to 9
            v = ""
            if Util.isAA(cp) then v = LCase(Util.toText(cp["homesection" + i.toStr()]))
            if v <> "" then found = true
            sections.push(v)
        end for
        ' (no sections saved: the web app's defaults)
        if not found then sections = ["smalllibrarytiles", "resume", "resumeaudio", "resumebook", "livetv", "nextup", "latestmedia", "none"]
        out = []
        for each s in sections
            if s = "smalllibrarytiles" or s = "librarybuttons"
                addOnce(out, "libraries")
            else if s = "resume"
                addOnce(out, "resume")
            else if s = "nextup"
                addOnce(out, "nextup")
            else if s = "latestmedia"
                for each l in libs
                    if Util.toText(l.id) <> "" then addOnce(out, libRowId(Util.toText(l.id)))
                end for
            end if
        end for
        return out
    end function

    sub addOnce(list as object, id as string)
        if indexIn(list, id) < 0 then list.push(id)
    end sub

    ' ---------------------------------------------------------------- row queries (v1.1)

    ' (v1.5) The kinds whose Latest row uses the server's /Items/Latest (grouped by series); every other kind
    ' (music, books, photos, box sets, playlists, unknown) lists its items newest first instead
    function usesLatestRoute(collectionType as string) as boolean
        ct = LCase(collectionType)
        return ct = "movies" or ct = "tvshows" or ct = "homevideos" or ct = "musicvideos" or ct = "mixed" or ct = ""
    end function

    ' (v1.5) A library row's /Items query (without the fields): its items recursively, of the types it holds
    ' (types: Items.homeTypesFor), in the row's order (latest = newest first, top, random, az)
    function libraryItemsQuery(libId as string, types as string, style as string) as string
        sortQ = "SortBy=SortName&SortOrder=Ascending"
        if style = "latest" then sortQ = "SortBy=DateCreated,SortName&SortOrder=Descending"
        if style = "top" then sortQ = "SortBy=CommunityRating,SortName&SortOrder=Descending"
        if style = "random" then sortQ = "SortBy=Random"
        return "ParentId=" + libId + "&Recursive=true&" + sortQ + "&Limit=20&IncludeItemTypes=" + types
    end function

    ' (v1.5) My Media: the libraries whose tile is switched on, in the Libraries order. libs: [{ id, ... }]
    function myMediaLibs(libs as object) as object
        out = []
        for each l in libs
            id = Util.toText(l.id)
            if id <> "" and NavPrefs.libraryInMyMedia(id) then out.push(l)
        end for
        return out
    end function

    ' Settings → Home → Hide watched in Recently Added: "&IsPlayed=false" for Recently Added, Recently Released
    ' and each library's Latest row (switch off: nothing added, so the server's own "Hide played in latest"
    ' still applies)
    function unwatchedQuery(hideWatched as boolean) as string
        if hideWatched then return "&IsPlayed=false"
        return ""
    end function

    ' The Next Up options Jellyfin has (enableRewatching 10.9+, nextUpDateCutoff); Emby has neither, so nothing is
    ' added there. cutoffIso: "" = any time.
    function nextUpQuery(isJellyfin as boolean, rewatch as boolean, cutoffIso as string) as string
        if not isJellyfin then return ""
        q = ""
        if rewatch then q = q + "&enableRewatching=true"
        if cutoffIso <> "" then q = q + "&nextUpDateCutoff=" + cutoffIso.encodeUriComponent()
        return q
    end function

    ' Recently Released: movies and episodes by premiere date, newest first, nothing that hasn't aired yet
    ' (missing / virtual episodes left out). nowIso: the current UTC time.
    function releasedQuery(nowIso as string, hideWatched as boolean) as string
        q = "Recursive=true&IncludeItemTypes=Movie,Episode&SortBy=PremiereDate,SortName&SortOrder=Descending&IsMissing=false"
        if nowIso <> "" then q = q + "&MaxPremiereDate=" + nowIso.encodeUriComponent()
        return q + unwatchedQuery(hideWatched) + "&Limit=20"
    end function

    ' ---------------------------------------------------------------- v1.6 HOME: Emby 4.10 Home sections (H-1)

    ' Emby 4.10+ keeps the Home layout in GET /Users/{id}/HomeSections (ContentSection list); Jellyfin and older
    ' Emby only have the legacy CustomPrefs homesection0..9 (fromServer). version: the server's "4.10.0.4".
    function hasHomeSections(isJellyfin as boolean, version as string) as boolean
        if isJellyfin then return false
        parts = version.split(".")
        if parts.count() < 2 then return false
        major = parts[0].toInt()
        minor = parts[1].toInt()
        return major > 4 or (major = 4 and minor >= 10)
    end function

    ' The sections of a HomeSections answer: a bare list, or { Items: [...] }; only objects
    function sectionList(json as dynamic) as object
        list = json
        if Util.isAA(json) then list = Util.field(json, "Items")
        out = []
        if type(list) <> "roArray" then return out
        for each s in list
            if Util.isAA(s) then out.push(s)
        end for
        return out
    end function

    ' Section kinds Cove can't show (music, books, Live TV, recordings): skipped, with a log line
    function sectionUnsupported(kind as string) as boolean
        for each k in ["livetv", "activerecordings", "resumeaudio", "resumebook", "nowplayingaudio", "latestaudio", "latestbooks", "latestmusic", "onnow", "upcomingtv", "recordings"]
            if k = kind then return true
        end for
        return false
    end function

    ' Emby 4.10 Home sections → Cove rows, in the server's order.
    ' resume → Continue Watching, nextup → Next Up, latestmedia → that library's row (no ParentId: every
    ' library's row, as the legacy prefs), librarytiles / smalllibrarytiles / librarybuttons → My Media,
    ' spotlight → the banner's titles (no row), Cove-unsupported kinds skipped, anything else with an Id (Dynamic
    ' media, collections, tags, genres, custom lists) → a row of its own filled by /Sections/{Id}/Items.
    ' Returns invalid when there is nothing usable (the caller falls back to the legacy prefs), else
    ' { ids: [row ids], rows: { "S:<id>": { title, landscape, sectionId, kind } }, spotlight: "<sectionId>",
    '   skipped: [kinds] }.
    function fromSections(list as dynamic, libs as object) as dynamic
        sections = sectionList(list)
        if sections.count() = 0 then return invalid
        libIds = {}
        for each l in libs
            id = Util.toText(l.id)
            if id <> "" then libIds[id] = true
        end for
        out = { ids: [], rows: {}, spotlight: "", skipped: [] }
        for each s in sections
            kind = LCase(Util.toText(Util.field(s, "SectionType")))
            sid = Util.toText(Util.field(s, "Id"))
            pid = Util.toText(Util.field(s, "ParentId"))
            if pid = "" and Util.isAA(Util.field(s, "ParentItem")) then pid = Util.toText(Util.field(s.ParentItem, "Id"))
            if kind = "resume" or kind = "resumevideo"
                addOnce(out.ids, "resume")
            else if kind = "nextup"
                addOnce(out.ids, "nextup")
            else if kind = "librarytiles" or kind = "smalllibrarytiles" or kind = "librarybuttons"
                addOnce(out.ids, "libraries")
            else if kind = "latestmedia" and pid <> "" and libIds.doesExist(pid)
                addOnce(out.ids, libRowId(pid))
            else if kind = "latestmedia" and pid = ""
                for each l in libs
                    if Util.toText(l.id) <> "" then addOnce(out.ids, libRowId(Util.toText(l.id)))
                end for
            else if kind = "spotlight" and sid <> ""
                if out.spotlight = "" then out.spotlight = sid
            else if sectionUnsupported(kind) or sid = ""
                out.skipped.push(kind)
            else
                rid = "S:" + sid
                if not out.rows.doesExist(rid)
                    out.rows[rid] = { title: sectionTitle(s), landscape: sectionWide(s), sectionId: sid, kind: kind }
                    out.ids.push(rid)
                end if
            end if
        end for
        if out.ids.count() = 0 and out.spotlight = "" then return invalid
        return out
    end function

    ' A section's row title: its CustomName, else its Name, else "More to Watch"
    function sectionTitle(s as object) as string
        name = Util.toText(Util.field(s, "CustomName")).trim()
        if name = "" then name = Util.toText(Util.field(s, "Name")).trim()
        if name = "" then name = "More to Watch"
        return name
    end function

    ' Thumb / Backdrop sections show wide 16:9 cards (as the Home Row Shows option); Primary stays posters
    function sectionWide(s as object) as boolean
        it = LCase(Util.toText(Util.field(s, "ImageType")))
        return it = "thumb" or it = "backdrop"
    end function

    ' ---------------------------------------------------------------- v1.7 NAV (M-6 Because You Watched)

    ' Settings → Home → Because You Watched → Rows: 1 / 2 / 3 (default 1); key "becauseRows" (personal)
    function becauseRows() as integer
        n = Util.readText("becauseRows").toInt()
        if n < 1 or n > 3 then return 1
        return n
    end function

    function becauseTitle(name as string) as string
        return "Because You Watched " + name
    end function

    ' GET /Movies/Recommendations (both servers): the categories, the items of each at most 12
    function recommendationsPath(uid as string, f as string) as string
        return "/Movies/Recommendations?UserId=" + uid + "&CategoryLimit=3&ItemLimit=12&" + f
    end function

    ' The last titles watched to the end (films and episodes), for the /Similar fallback
    function playedQuery() as string
        return "Recursive=true&IncludeItemTypes=Movie,Episode&SortBy=DatePlayed&SortOrder=Descending&Filters=IsPlayed&Fields=SeriesId,SeriesName&EnableImages=false&Limit=20"
    end function

    function similarPath(itemId as string, uid as string, f as string) as string
        return "/Items/" + itemId + "/Similar?UserId=" + uid + "&Limit=12&" + f
    end function

    ' The recommendation kinds that read "Because You Watched <title>" (the server's "SimilarToRecentlyPlayed";
    ' "BecauseYouWatched" where a server names it so); liked items / actors / directors are left out
    function isBecauseKind(kind as string) as boolean
        k = LCase(kind)
        return k = "similartorecentlyplayed" or k = "becauseyouwatched"
    end function

    ' /Movies/Recommendations → at most maxRows rows [{ name, baseId, items }] in the server's order: the
    ' Because kinds only, with a baseline title and at least one item, one row per baseline title
    function becauseFromRecommendations(json as dynamic, maxRows as integer) as object
        out = []
        list = json
        if Util.isAA(json) then list = Util.field(json, "Items")
        if type(list) <> "roArray" then return out
        seen = {}
        for each c in list
            if out.count() >= maxRows then exit for
            if Util.isAA(c) and isBecauseKind(Util.toText(Util.field(c, "RecommendationType")))
                name = Util.toText(Util.field(c, "BaselineItemName")).trim()
                its = Util.field(c, "Items")
                if name <> "" and not seen.doesExist(LCase(name)) and type(its) = "roArray" and its.count() > 0
                    kept = []
                    for each it in its
                        if Util.isAA(it) then kept.push(it)
                    end for
                    if kept.count() > 0
                        seen[LCase(name)] = true
                        out.push({ name: name, baseId: Util.toText(Util.field(c, "CategoryId")), items: kept })
                    end if
                end if
            end if
        end for
        return out
    end function

    ' The /Similar fallback's titles: the last watched films and series (an episode stands for its series),
    ' newest first, without the names already used (usedNames: { lcase name: true }), at most n [{ id, name }]
    function becauseBaselines(played as dynamic, usedNames as object, n as integer) as object
        out = []
        if type(played) <> "roArray" or n <= 0 then return out
        seen = {}
        for each k in usedNames
            seen[k] = true
        end for
        for each it in played
            if out.count() >= n then exit for
            if Util.isAA(it)
                id = Util.toText(Util.field(it, "Id"))
                name = Util.toText(Util.field(it, "Name"))
                if Util.toText(Util.field(it, "Type")) = "Episode"
                    id = Util.toText(Util.field(it, "SeriesId"))
                    name = Util.toText(Util.field(it, "SeriesName"))
                end if
                name = name.trim()
                if id <> "" and name <> "" and not seen.doesExist(LCase(name))
                    seen[LCase(name)] = true
                    out.push({ id: id, name: name })
                end if
            end if
        end for
        return out
    end function

    ' Where the late rows go among the rows on screen: after every shown row whose title is one of the rows
    ' queued before them (shownTitles: the titles on screen in order; before: { title: true })
    function lateRowIndex(shownTitles as object, before as object) as integer
        at = 0
        for i = 0 to shownTitles.count() - 1
            if before.doesExist(Util.toText(shownTitles[i])) then at = i + 1
        end for
        return at
    end function

end namespace
