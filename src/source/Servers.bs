import "pkg:/source/Util.bs"

' Saved servers, kept in the Roku's registry for this app (one JSON key, "servers"). Each server keeps its
' signed-in users (profiles), compactly:
'   { id, name, url, type ("emby" | "jellyfin"), version, cur (the active user's id), ask ("off" = don't ask
'     who's watching at start), users: [{ i: userId, n: name, t: token, a: avatar image tag, p: PIN salt+hash,
'     r: maximum rating, h: "1" = hide unrated titles (with a rating limit) }] }
' Records read back get the active user's fields on top, as before (userId, userName, token) plus avatar,
' maxRating and hideUnrated, so every screen keeps reading server.userId / server.token.
' (v0.9.1) A profile with a rating limit is "limited"; a "parent" is a profile without a limit that has a PIN.
' While a limited profile is active, Settings asks a parent PIN before anything that could lift the limit. A record from v0.8.0 or earlier (one
' user: userId, userName, token) is moved into users by migrate() at start (and read that way until then).
' A token belongs to the address it was issued on (SEC-1): when a server's address changes, every saved
' token of that server is cleared (the users stay, to sign in again).
namespace Servers

    function all() as object
        v = Util.readJson("servers")
        if type(v) <> "roArray" then return []
        out = []
        for each s in v
            if Util.isAA(s) then out.push(withActive(normalized(s)))
        end for
        return out
    end function

    sub saveAll(list as object)
        clean = []
        for each s in list
            clean.push(stripped(s))
        end for
        Util.writeText("servers", formatJson(clean))
        ' (v1.6 ST-9) the personal settings follow the active profile
        PrefScope.sync()
    end sub

    ' A record in the current shape: users (from the old single-user fields when needed) and cur
    function normalized(s as object) as object
        if type(s.users) <> "roArray"
            s.users = []
            s.cur = ""
            if Util.toText(s.userId) <> ""
                s.users.push({ i: Util.toText(s.userId), n: Util.toText(s.userName), t: Util.toText(s.token), a: "" })
                s.cur = Util.toText(s.userId)
            end if
        end if
        kept = []
        for each u in s.users
            if Util.isAA(u) and Util.toText(u.i) <> "" then kept.push(u)
        end for
        s.users = kept
        if s.cur = invalid then s.cur = ""
        return s
    end function

    ' The active user's fields on top of the record (what screens and requests read)
    function withActive(s as object) as object
        s.userId = Util.toText(s.cur)
        s.userName = ""
        s.token = ""
        s.avatar = ""
        s.maxRating = ""
        s.hideUnrated = false
        u = userOf(s, Util.toText(s.cur))
        if u <> invalid
            s.userName = Util.toText(u.n)
            s.token = Util.toText(u.t)
            s.avatar = Util.toText(u.a)
            s.maxRating = Util.toText(u.r)
            s.hideUnrated = Util.toText(u.h) = "1"
        end if
        return s
    end function

    ' Only what is stored (the active user's fields come from users)
    function stripped(s as object) as object
        rec = { id: Util.toText(s.id), name: Util.toText(s.name), url: Util.toText(s.url), type: Util.toText(s.type), version: Util.toText(s.version), cur: Util.toText(s.cur), users: s.users }
        if type(rec.users) <> "roArray" then rec.users = []
        if Util.toText(s.ask) <> "" then rec.ask = Util.toText(s.ask)
        return rec
    end function

    ' Moves records from v0.8.0 and earlier into the profiles shape (once: later reads find users)
    sub migrate()
        v = Util.readJson("servers")
        if type(v) <> "roArray" then return
        old = 0
        for each s in v
            if Util.isAA(s) and type(s.users) <> "roArray" then old = old + 1
        end for
        if old = 0 then return
        saveAll(all())
        print "Cove: moved "; old; " saved sign-ins into profiles"
    end sub

    function userOf(s as object, userId as string) as dynamic
        if userId = "" or type(s.users) <> "roArray" then return invalid
        for each u in s.users
            if Util.toText(u.i) = userId then return u
        end for
        return invalid
    end function

    function find(id as string) as dynamic
        for each s in all()
            if Util.toText(s.id) = id then return s
        end for
        return invalid
    end function

    ' Adds the server or updates the saved one with the same id. The users list is the stored one (profile
    ' settings change only through the functions below, so an older copy of the server can't undo them); the
    ' passed userId / userName / token / avatar update that user and make them the active one.
    sub upsert(server as object)
        list = all()
        idx = -1
        for i = 0 to list.count() - 1
            if Util.toText(list[i].id) = Util.toText(server.id) then idx = i
        end for
        if idx >= 0
            rec = list[idx]
            users = rec.users
            ' (a new address: the saved tokens were issued for the old one)
            if Util.originOf(Util.toText(rec.url)) <> Util.originOf(Util.toText(server.url))
                for each u in users
                    u.t = ""
                end for
            end if
        else
            rec = {}
            users = []
        end if
        rec.id = Util.toText(server.id)
        rec.name = Util.toText(server.name)
        rec.url = Util.toText(server.url)
        rec.type = Util.toText(server.type)
        rec.version = Util.toText(server.version)
        uid = Util.toText(server.userId)
        if uid <> ""
            u = invalid
            for each x in users
                if Util.toText(x.i) = uid then u = x
            end for
            if u = invalid
                u = { i: uid, n: "", t: "", a: "" }
                users.push(u)
            end if
            u.t = Util.toText(server.token)
            if Util.toText(server.userName) <> "" then u.n = Util.toText(server.userName)
            if server.avatar <> invalid then u.a = Util.toText(server.avatar)
        end if
        rec.users = users
        rec.cur = uid
        if idx >= 0
            list[idx] = rec
        else
            list.push(rec)
        end if
        saveAll(list)
    end sub

    ' Changes one stored field of a user (n, t, a, p, r, h); "" removes p / r / h
    sub setUserField(serverId as string, userId as string, key as string, value as string)
        list = all()
        for each s in list
            if Util.toText(s.id) = serverId
                u = userOf(s, userId)
                if u <> invalid
                    if value = "" and (key = "p" or key = "r" or key = "h")
                        u.delete(key)
                    else
                        u[key] = value
                    end if
                    saveAll(list)
                end if
                return
            end if
        end for
    end sub

    ' Makes a saved user the active one on that server (the server's record with them on top, or invalid)
    function useUser(serverId as string, userId as string) as dynamic
        list = all()
        for each s in list
            if Util.toText(s.id) = serverId and userOf(s, userId) <> invalid
                s.cur = userId
                saveAll(list)
                return withActive(s)
            end if
        end for
        return invalid
    end function

    ' Forgets one user of a server (sign out): their token, PIN and rating limit go with them
    sub removeUser(serverId as string, userId as string)
        list = all()
        for each s in list
            if Util.toText(s.id) = serverId
                kept = []
                for each u in s.users
                    if Util.toText(u.i) <> userId then kept.push(u)
                end for
                s.users = kept
                if Util.toText(s.cur) = userId then s.cur = ""
                saveAll(list)
                ' (v1.6 ST-9) their own settings go with them
                PrefScope.forgetProfile(userId)
                return
            end if
        end for
    end sub

    ' The server as each signed-in user (to end every session when the server is removed or moved)
    function sessions(s as object) as object
        out = []
        if s = invalid or type(s.users) <> "roArray" then return out
        for each u in s.users
            if Util.toText(u.t) <> "" then out.push(asUser(s, Util.toText(u.i)))
        end for
        return out
    end function

    ' A copy of the server record with this user on top (invalid if not saved)
    function asUser(s as object, userId as string) as dynamic
        if userOf(s, userId) = invalid then return invalid
        c = {}
        c.append(s)
        c.cur = userId
        return withActive(c)
    end function

    ' The profiles of a server: [{ id, name, avatar, signedIn, hasPin, maxRating, hideUnrated }]
    function profiles(s as object) as object
        out = []
        if s = invalid or type(s.users) <> "roArray" then return out
        for each u in s.users
            out.push({ id: Util.toText(u.i), name: Util.toText(u.n), avatar: Util.toText(u.a), signedIn: Util.toText(u.t) <> "", hasPin: Util.toText(u.p) <> "", maxRating: Util.toText(u.r), hideUnrated: Util.toText(u.h) = "1" })
        end for
        return out
    end function

    ' (v0.9.1) The parents: profiles without a rating limit that have a PIN (their PINs guard the limits)
    function parentIds(s as dynamic) as object
        out = []
        if s = invalid or type(s.users) <> "roArray" then return out
        for each u in s.users
            if Util.toText(u.r) = "" and Util.toText(u.p) <> "" then out.push(Util.toText(u.i))
        end for
        return out
    end function

    ' Some profile on the server has a rating limit
    function anyLimited(s as dynamic) as boolean
        if s = invalid or type(s.users) <> "roArray" then return false
        for each u in s.users
            if Util.toText(u.r) <> "" then return true
        end for
        return false
    end function

    ' The profile is the only parent while some profile has a limit (removing its PIN or adding a limit to it
    ' would leave the limits without a parent PIN)
    function isLastParent(s as dynamic, userId as string) as boolean
        ids = parentIds(s)
        return ids.count() = 1 and ids[0] = userId and anyLimited(s)
    end function

    function pinOf(s as object, userId as string) as string
        u = userOf(s, userId)
        if u = invalid then return ""
        return Util.toText(u.p)
    end function

    ' Settings → Profiles: "Ask who's watching at start" (on by default; only asked with 2 or more profiles)
    function asksWho(s as object) as boolean
        return Util.toText(s.ask) <> "off"
    end function

    sub setAsk(serverId as string, isOn as boolean)
        list = all()
        for each s in list
            if Util.toText(s.id) = serverId
                s.ask = "off"
                if isOn then s.ask = ""
                saveAll(list)
                return
            end if
        end for
    end sub

    sub remove(id as string)
        kept = []
        for each s in all()
            if Util.toText(s.id) <> id then kept.push(s)
        end for
        saveAll(kept)
        if Util.readText("active") = id then Util.writeText("active", "")
        PrefScope.sync()
        ' (its library order goes with it)
        sec = createObject("roRegistrySection", "Cove")
        if sec.exists("libOrder:" + id)
            sec.delete("libOrder:" + id)
            sec.flush()
        end if
    end sub

    function active() as dynamic
        id = Util.readText("active")
        if id = "" then return invalid
        return find(id)
    end function

    sub setActive(id as string)
        ' (v1.2) a registry write + flush on every launch cost time before Home: only when it changes
        if Util.readText("active") = id then return
        Util.writeText("active", id)
        PrefScope.sync()
    end sub

    function isJellyfin(server as object) as boolean
        return Util.toText(server.type) = "jellyfin"
    end function

    function typeName(server as object) as string
        if isJellyfin(server) then return "Jellyfin"
        return "Emby"
    end function

    ' ---------------------------------------------------------------- cleanup when a server is removed
    ' (R-8, k2) Everything Cove keeps for a server outside the "servers" record: its Home rows
    ' (homeRows:<id>), its library order (libOrder:<id>), and (v1.5.2 CS-3 / ST-1) everything kept under its tag
    ' (Prefs.tagOf): its libraries' settings (lib:<tag>:<libId>), its menu lists (navtop:<tag>, navside:<tag>),
    ' its library page filters and series languages (entries "<tag>:<id>"), and its profiles' PIN lockouts
    ' (pinWait). Call it before remove(id).
    sub forgetAll(serverId as string)
        if serverId = "" then return
        sec = createObject("roRegistrySection", "Cove")
        ' (= Prefs.tagOf: Servers doesn't import Prefs)
        tg = serverId.left(8)
        libPrefix = "lib:" + tg + ":"
        gone = 0
        for each k in sec.getKeyList()
            if k.startsWith(libPrefix) or k = "navtop:" + tg or k = "navside:" + tg
                sec.delete(k)
                gone = gone + 1
            end if
        end for
        ' (v1.6 ST-9: the shared lists and every profile's own copy, read as stored)
        for each listKey in sec.getKeyList()
            if listKey = "libFilters" or listKey = "seriesLangs" or listKey.startsWith("libFilters@") or listKey.startsWith("seriesLangs@")
                list = parseJson(sec.read(listKey))
                if type(list) = "roArray"
                    kept = Servers.withoutTag(list, tg)
                    if kept.count() <> list.count() then sec.write(listKey, formatJson(kept))
                end if
            end if
        end for
        waitMap = Util.readJson("pinWait")
        if Util.isAA(waitMap)
            prefix = serverId.left(12) + ":"
            keptWaits = {}
            for each k in waitMap
                if not k.startsWith(prefix) then keptWaits[k] = waitMap[k]
            end for
            if keptWaits.count() <> waitMap.count() then sec.write("pinWait", formatJson(keptWaits))
        end if
        for each k in ["homeRows:" + serverId, "libOrder:" + serverId]
            if sec.exists(k) then sec.delete(k)
        end for
        ' (v1.6 ST-9) and its profiles' own settings
        srv = Servers.find(serverId)
        if srv <> invalid
            for each u in srv.users
                PrefScope.forgetProfile(Util.toText(u.i))
            end for
            ' (v1.6 CS-8) and the sign-in form its address accepted (Api.authShapeOf)
            shapes = Util.readJson("authShape")
            origin = Util.originOf(Util.toText(srv.url))
            if type(shapes) = "roArray"
                keptShapes = []
                for each e in shapes
                    if Util.isAA(e) and Util.toText(e.o) <> origin then keptShapes.push(e)
                end for
                if keptShapes.count() <> shapes.count() then sec.write("authShape", formatJson(keptShapes))
            end if
        end if
        if not sec.flush() then print "Cove: registry flush failed after forgetting a server"
        print "Cove: forgot the settings of a removed server ("; gone; " keys)"
    end sub

    ' The entries ({ id: "<tag>:<id>" }) that don't belong to the server tag
    function withoutTag(list as object, tg as string) as object
        out = []
        prefix = tg + ":"
        for each e in list
            if not (Util.isAA(e) and Util.toText(e.id).startsWith(prefix)) then out.push(e)
        end for
        return out
    end function

    ' (LAN discovery, DiscoveryTask) { Address: "http://192.168.1.20:8096", Id, Name } → { id, name, address } or
    ' invalid. Any device on the network can answer, so only a plain http(s)://host[:port] address with safe
    ' characters is kept, with an optional base path (C2-9: Jellyfin's Address includes its BaseUrl, "/jellyfin").
    function parseDiscovery(text as dynamic) as dynamic
        if type(text) <> "roString" and type(text) <> "String" then return invalid
        j = ParseJson(text)
        if not Util.isAA(j) then return invalid
        addr = Util.toText(j.Address).trim()
        id = Util.toText(j.Id)
        if addr = "" or id = "" or not Util.isSafeId(id, false) then return invalid
        while addr.len() > 0 and addr.right(1) = "/"
            addr = addr.left(addr.len() - 1)
        end while
        low = LCase(addr)
        if not (low.startsWith("http://") or low.startsWith("https://")) then return invalid
        rx = createObject("roRegex", "^https?://[A-Za-z0-9.\-\[\]:]+(/[A-Za-z0-9._~\-/]*)?$", "")
        if not rx.isMatch(addr) then return invalid
        name = Util.toText(j.Name)
        if name.len() > 40 then name = name.left(40)
        if name = "" then name = Util.hostOf(addr)
        return { id: id, name: name, address: addr }
    end function

end namespace
