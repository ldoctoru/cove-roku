import "pkg:/source/Util.bs"

' Settings kept on the Roku (registry), with the same defaults as Cove for macOS (Sources/Settings.swift):
' accent / background (read by Theme.bs), "Always load my subtitle language" + the language, skip intros and
' play the next episode automatically (both on), and the quality to start with (Automatic).
namespace Prefs

    function flagOn(key as string, fallback as boolean) as boolean
        v = Util.readText(key)
        if v = "" then return fallback
        return v = "on"
    end function

    sub setFlag(key as string, on as boolean)
        if on
            Util.writeText(key, "on")
        else
            Util.writeText(key, "off")
        end if
    end sub

    function subAlways() as boolean
        return flagOn("subAlways", false)
    end function

    ' The language name, lower case ("romanian"); default English as on the Mac
    function subLang() as string
        v = Util.readText("subLang")
        if v = "" then v = "english"
        return v
    end function

    function autoSkipIntro() as boolean
        return flagOn("autoSkipIntro", true)
    end function

    ' Settings → Playback → Skip recaps (off by default: a recap is often wanted after a break)
    function autoSkipRecap() as boolean
        return flagOn("autoSkipRecap", false)
    end function

    ' Settings → Playback → Are you still watching?: after this many episodes started by Up next without a
    ' key press (0 = off; on, 2 hours without a key press also asks)
    function stillWatchingAfter() as integer
        v = text("stillWatching", "3")
        if v = "off" then return 0
        return v.toInt()
    end function

    function autoNext() as boolean
        return flagOn("autoNext", true)
    end function

    function startQuality() as integer
        return Util.readText("startQuality").toInt()
    end function

    ' A choice with a default ("sidebar", "both", ...)
    function text(key as string, fallback as string) as string
        v = Util.readText(key)
        if v = "" then return fallback
        return v
    end function

    ' ---------------------------------------------------------------- General / Home (Mac keys and defaults)

    function navStyle() as string
        return text("navStyle", "sidebar")
    end function

    function topBarLabels() as string
        return text("topBarLabels", "both")
    end function

    function showRecent() as boolean
        return flagOn("showRecent", true)
    end function

    function showFavorites() as boolean
        return flagOn("showFavorites", true)
    end function

    function showNowPlaying() as boolean
        return flagOn("showNowPlaying", true)
    end function

    function showUpNextRow() as boolean
        return flagOn("showUpNextRow", true)
    end function

    function castLarge() as boolean
        return text("castSize", "normal") = "large"
    end function

    function showEpisodeDescription() as boolean
        return flagOn("showEpisodeDescription", true)
    end function

    function skipSeconds() as integer
        v = Util.readText("skipSeconds").toInt()
        if v <= 0 then v = 10
        return v
    end function

    ' Settings → Playback → Rewind on resume: seconds to go back when a title resumes from its saved position,
    ' or when playback goes on after a pause of 5 minutes or more (0 = off)
    function rewindOnResume() as integer
        v = text("rewindOnResume", "5")
        if v = "off" then return 0
        return v.toInt()
    end function

    ' ---------------------------------------------------------------- libraries

    ' Per library (Mac LibPref + LibraryDefaults): { nav, home, style, sort, show, name }
    function library(id as string) as object
        d = Util.readJson("lib:" + id)
        if type(d) <> "roAssociativeArray" then d = {}
        if d.nav = invalid then d.nav = true
        if d.home = invalid then d.home = true
        if d.style = invalid then d.style = "latest"
        if d.sort = invalid then d.sort = "name"
        if d.show = invalid then d.show = "all"
        if d.name = invalid then d.name = ""
        return d
    end function

    sub setLibrary(id as string, key as string, value as dynamic)
        d = library(id)
        d[key] = value
        Util.writeText("lib:" + id, formatJson(d))
    end sub

    ' The registry key of a server's library order (library ids are per server, so one shared key let one
    ' server's order replace another's). The old shared key moves to the first server that reads it, the active
    ' one (Home and Settings only order the active server's libraries).
    function libOrderKey(serverId as string) as string
        key = "libOrder:" + serverId
        old = Util.readText("libOrder")
        if old <> ""
            if Util.readText(key) = "" then Util.writeText(key, old)
            sec = createObject("roRegistrySection", "Cove")
            sec.delete("libOrder")
            sec.flush()
        end if
        return key
    end function

    ' The server's libraries ([{ id, title, ... }]) in the saved order, with the saved names
    function orderLibraries(libs as object, serverId as string) as object
        order = Util.readText(libOrderKey(serverId)).split(",")
        out = []
        used = {}
        for each id in order
            for each l in libs
                if Util.toText(l.id) = id and not used.doesExist(id)
                    out.push(l)
                    used[id] = true
                end if
            end for
        end for
        for each l in libs
            if not used.doesExist(Util.toText(l.id)) then out.push(l)
        end for
        for each l in out
            n = library(Util.toText(l.id)).name
            l.serverTitle = Util.toText(l.title)
            if n <> "" then l.title = n
        end for
        return out
    end function

    sub saveOrder(ids as object, serverId as string)
        Util.writeText(libOrderKey(serverId), Util.join(ids, ","))
    end sub

    ' The library kinds that get a row on Home (HomeTask); the others have no Home setting in Settings
    function hasHomeRow(collectionType as string) as boolean
        ct = collectionType
        return ct = "movies" or ct = "tvshows" or ct = "homevideos" or ct = "musicvideos" or ct = "mixed" or ct = ""
    end function

    ' ---------------------------------------------------------------- subtitle style (Mac PlayerView sizes / colors / ...)

    function subBottom() as integer
        v = Util.readText("subBottom")
        if v = "" then return 10
        return v.toInt()
    end function

    ' ---------------------------------------------------------------- subtitle language per series

    ' "" = automatic, "off", or a language code. All series share one key ("seriesLangs", most recent last,
    ' at most 100): one key per series grew the registry without limit, and it also holds the sign-ins.
    function seriesSubLang(seriesId as string) as string
        if seriesId = "" then return ""
        for each e in seriesLangList()
            if Util.toText(e.id) = seriesId then return Util.toText(e.lang)
        end for
        return ""
    end function

    sub setSeriesSubLang(seriesId as string, lang as string)
        if seriesId = "" then return
        kept = []
        for each e in seriesLangList()
            if Util.toText(e.id) <> seriesId then kept.push(e)
        end for
        if lang <> "" then kept.push({ id: seriesId, lang: lang })
        while kept.count() > 100
            kept.shift()
        end while
        Util.writeText("seriesLangs", formatJson(kept))
    end sub

    function seriesLangList() as object
        v = Util.readJson("seriesLangs")
        if type(v) <> "roArray" then return []
        return v
    end function

    ' Once: the old "slang:<id>" keys move into the list (deleted first, so a full registry has room for it)
    sub migrateSeriesLangs()
        sec = createObject("roRegistrySection", "Cove")
        old = []
        for each k in sec.getKeyList()
            if k.startsWith("slang:") then old.push(k)
        end for
        if old.count() = 0 then return
        kept = seriesLangList()
        for each k in old
            v = sec.read(k)
            sid = k.mid(6)
            known = false
            for each e in kept
                if Util.toText(e.id) = sid then known = true
            end for
            if v <> "" and not known then kept.push({ id: sid, lang: v })
            sec.delete(k)
        end for
        sec.flush()
        while kept.count() > 100
            kept.shift()
        end while
        Util.writeText("seriesLangs", formatJson(kept))
        print "Cove: moved "; old.count(); " series subtitle languages into one registry key"
    end sub

    ' ---------------------------------------------------------------- reset

    ' Every setting back to its default; the servers and sign-ins are kept (as on the Mac)
    sub resetAll()
        sec = createObject("roRegistrySection", "Cove")
        keep = { servers: true, active: true }
        for each k in sec.getKeyList()
            if not keep.doesExist(k) then sec.delete(k)
        end for
        sec.flush()
    end sub

    ' The Mac's subtitle languages, with the codes servers use for them (ISO 639-2/B, 639-2/T, 639-1)
    function languages() as object
        return [
            { name: "English", codes: ["eng", "en"] },
            { name: "Romanian", codes: ["rum", "ron", "rom", "ro", "mol", "romanian", "română", "romana"] },
            { name: "Spanish", codes: ["spa", "es"] },
            { name: "French", codes: ["fre", "fra", "fr"] },
            { name: "German", codes: ["ger", "deu", "de"] },
            { name: "Italian", codes: ["ita", "it"] },
            { name: "Portuguese", codes: ["por", "pt", "pob"] },
            { name: "Dutch", codes: ["dut", "nld", "nl"] },
            { name: "Hungarian", codes: ["hun", "hu"] },
            { name: "Polish", codes: ["pol", "pl"] },
            { name: "Russian", codes: ["rus", "ru"] },
            { name: "Turkish", codes: ["tur", "tr"] },
            { name: "Greek", codes: ["gre", "ell", "el"] },
            { name: "Swedish", codes: ["swe", "sv"] },
            { name: "Norwegian", codes: ["nor", "nob", "nno", "no", "nb", "nn"] },
            { name: "Danish", codes: ["dan", "da"] },
            { name: "Finnish", codes: ["fin", "fi"] },
            { name: "Czech", codes: ["cze", "ces", "cs"] },
            { name: "Arabic", codes: ["ara", "ar"] },
            { name: "Hebrew", codes: ["heb", "he"] },
            { name: "Japanese", codes: ["jpn", "ja"] },
            { name: "Korean", codes: ["kor", "ko"] },
            { name: "Chinese", codes: ["chi", "zho", "zh"] }
        ]
    end function

    ' Codes for a language name ("romanian" -> ["rum", "ron", ...]); the name itself if it isn't in the list
    function codesFor(langName as string) as object
        want = LCase(langName)
        for each l in languages()
            if LCase(l.name) = want then return l.codes
        end for
        return [want]
    end function

end namespace
