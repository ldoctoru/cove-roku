import "pkg:/source/Util.bs"
import "pkg:/source/HomeBanner.bs"

' Settings kept on the Roku (registry), with the same defaults as Cove for macOS (Sources/Settings.swift):
' accent / background (read by Theme.bs), "Always load my subtitle language" + the language, skip intros and
' play the next episode automatically (both on), and the quality to start with (Automatic).
namespace Prefs

    function flagOn(key as string, fallback as boolean) as boolean
        v = Util.readText(key)
        if v = "" then return fallback
        return v = "on"
    end function

    sub setFlag(key as string, on as boolean)
        if on
            Util.writeText(key, "on")
        else
            Util.writeText(key, "off")
        end if
    end sub

    function subAlways() as boolean
        return flagOn("subAlways", false)
    end function

    ' The language name, lower case ("romanian"); default English as on the Mac
    function subLang() as string
        v = Util.readText("subLang")
        if v = "" then v = "english"
        return v
    end function

    ' Settings → Playback → Are you still watching?: after this many episodes started by Up next without a
    ' key press (0 = off; on, 2 hours without a key press also asks)
    function stillWatchingAfter() as integer
        v = text("stillWatching", "3")
        if v = "off" then return 0
        return v.toInt()
    end function

    function autoNext() as boolean
        return flagOn("autoNext", true)
    end function

    ' (v1.0) Settings → Playback → Up Next countdown: seconds before the next episode starts (0 = Off: it
    ' starts at once, without the Up Next card); 5, 10 (default) or 15
    function upNextSeconds() as integer
        v = text("upNextSecs", "10")
        if v = "off" then return 0
        n = v.toInt()
        if n <> 5 and n <> 15 then n = 10
        return n
    end function

    ' (v1.3) Settings → Playback → Skip: per segment kind "ask" (the Skip button), "auto" (skipped with a short
    ' notice) or "off" (no button). One compact registry key "segSkip" (JSON, only the kinds changed). A kind
    ' never changed keeps the v1.2 behaviour: intros follow the old "Skip intros" switch (on), recaps the old
    ' "Skip recaps" switch (off), previews, ads and credits ask.
    function segmentKinds() as object
        return ["intro", "recap", "preview", "commercial", "credits"]
    end function

    function segmentSkipDefault(kind as string) as string
        if kind = "intro" and flagOn("autoSkipIntro", true) then return "auto"
        if kind = "recap" and flagOn("autoSkipRecap", false) then return "auto"
        return "ask"
    end function

    ' { intro, recap, preview, commercial, credits } → "ask" / "auto" / "off" (one registry read)
    function segmentSkipAll() as object
        saved = Util.readJson("segSkip")
        out = {}
        for each k in segmentKinds()
            v = ""
            if Util.isAA(saved) then v = Util.toText(saved[k])
            if v <> "ask" and v <> "auto" and v <> "off" then v = segmentSkipDefault(k)
            out[k] = v
        end for
        return out
    end function

    function segmentSkipOf(kind as string) as string
        v = segmentSkipAll()[kind]
        if v = invalid then return "ask"
        return v
    end function

    sub setSegmentSkip(kind as string, value as string)
        if value <> "ask" and value <> "auto" and value <> "off" then return
        known = false
        for each k in segmentKinds()
            if k = kind then known = true
        end for
        if not known then return
        saved = Util.readJson("segSkip")
        if not Util.isAA(saved) then saved = {}
        saved[kind] = value
        Util.writeText("segSkip", formatJson(saved))
    end sub

    ' (v1.0) Settings → Playback → Ask if still watching after: seconds of playing without a key press before
    ' Cove pauses and asks (0 = Off); 1, 2 (default) or 3 hours
    function stillIdleSeconds() as integer
        v = text("stillIdle", "2")
        if v = "off" then return 0
        n = v.toInt()
        if n < 1 or n > 3 then n = 2
        return n * 3600
    end function

    ' (v1.0) Settings → Playback → Default speed: the speed every title starts at ("1" = normal)
    function defaultSpeed() as string
        v = text("defaultSpeed", "1")
        for each c in ["0.5", "0.75", "1", "1.25", "1.5", "1.75", "2"]
            if c = v then return v
        end for
        return "1"
    end function

    ' (v1.0) Settings → Playback → Cinema Mode: the server's intros (trailers, pre-rolls) before a film
    function cinemaMode() as boolean
        return flagOn("cinemaMode", false)
    end function

    ' Settings → Playback → Start with: one quality for a server on the home network, one for a server over the
    ' internet (decided by its address, Util.isPrivateHost; no address = home). 0 = Automatic. The old single
    ' "startQuality" counts for both until one of them is changed (setStartQuality then splits it).
    function startQuality(serverUrl = "" as string) as integer
        if serverUrl <> "" and not Util.isPrivateHost(Util.hostOf(serverUrl)) then return startQualityOf("startQualityNet")
        return startQualityOf("startQualityHome")
    end function

    function startQualityOf(key as string) as integer
        v = Util.readText(key)
        if v = "" then v = Util.readText("startQuality")
        return v.toInt()
    end function

    sub setStartQuality(key as string, value as string)
        old = Util.readText("startQuality")
        if old <> ""
            for each k in ["startQualityHome", "startQualityNet"]
                if Util.readText(k) = "" then Util.writeText(k, old)
            end for
            sec = createObject("roRegistrySection", "Cove")
            sec.delete("startQuality")
            sec.flush()
        end if
        Util.writeText(key, value)
    end sub

    ' Settings → Playback → Audio: the most channels to ask for (0 = Automatic: what the file has, 5.1 when
    ' the server converts; 2 = stereo, 6 = 5.1, 8 = 7.1)
    function audioChannels() as integer
        v = text("audioChannels", "auto")
        if v = "2" or v = "6" or v = "8" then return v.toInt()
        return 0
    end function

    ' The codec the server converts audio to: "auto" (surround first: E-AC3, AC3, then AAC), "aac", "ac3", "eac3"
    function audioCodec() as string
        v = text("audioCodec", "auto")
        if v = "aac" or v = "ac3" or v = "eac3" then return v
        return "auto"
    end function

    ' DTS sent unchanged to a receiver that decodes it (off by default: the server converts DTS)
    function dtsPassthrough() as boolean
        return flagOn("dtsPassthrough", false)
    end function

    ' A choice with a default ("sidebar", "both", ...)
    function text(key as string, fallback as string) as string
        v = Util.readText(key)
        if v = "" then return fallback
        return v
    end function

    ' ---------------------------------------------------------------- General / Home (Mac keys and defaults)

    function navStyle() as string
        return text("navStyle", "sidebar")
    end function

    function topBarLabels() as string
        return text("topBarLabels", "both")
    end function

    function showRecent() as boolean
        return flagOn("showRecent", true)
    end function

    function showFavorites() as boolean
        return flagOn("showFavorites", true)
    end function

    function showNowPlaying() as boolean
        return flagOn("showNowPlaying", true)
    end function

    function showUpNextRow() as boolean
        return flagOn("showUpNextRow", true)
    end function

    ' (v1.3.2) Settings → Home → Banner: "Banner shows" (rows / newest / random / favorites; default newest) and
    ' "Refresh banner" (minutes, 0 = only when Home loads), both in one compact key "banner" ("newest,0")
    function bannerPref() as object
        return HomeBanner.decodePref(Util.readText("banner"))
    end function

    sub setBannerPref(source as string, minutes as integer)
        Util.writeText("banner", HomeBanner.encodePref(source, minutes))
    end sub

    ' (v1.1) Settings → Home → Row options: Recently Added / Recently Released / Latest without watched titles
    function hideWatchedLatest() as boolean
        return flagOn("hideWatchedLatest", false)
    end function

    ' (v1.1, Jellyfin 10.9+) Next Up also offers a finished series you started again
    function nextUpRewatch() as boolean
        return flagOn("nextUpRewatch", false)
    end function

    ' (v1.1, Jellyfin) Next Up shows only series watched in the last N days; 0 = any time
    function nextUpDays() as integer
        v = text("nextUpDays", "0").toInt()
        if v < 0 then return 0
        return v
    end function

    function castLarge() as boolean
        return text("castSize", "normal") = "large"
    end function

    function showEpisodeDescription() as boolean
        return flagOn("showEpisodeDescription", true)
    end function

    ' Settings → Libraries → Hide spoilers for unwatched episodes (off by default, as in Infuse)
    function hideSpoilers() as boolean
        return flagOn("hideSpoilers", false)
    end function

    function skipSeconds() as integer
        v = Util.readText("skipSeconds").toInt()
        if v <= 0 then v = 10
        return v
    end function

    ' Settings → Playback → Jump buttons: the player's back / forward buttons and the Rewind / Fast forward
    ' keys (10, 15, 30 or 60 s; default 30)
    function jumpSeconds() as integer
        v = Util.readText("jumpSeconds").toInt()
        if v <> 10 and v <> 15 and v <> 60 then v = 30
        return v
    end function

    ' Settings → Playback → Rewind on resume: seconds to go back when a title resumes from its saved position,
    ' or when playback goes on after a pause of 5 minutes or more (0 = off)
    function rewindOnResume() as integer
        v = text("rewindOnResume", "5")
        if v = "off" then return 0
        return v.toInt()
    end function

    ' ---------------------------------------------------------------- libraries

    ' (v1.5.2 ST-1) Library ids are per server (Emby's are short numbers, "3", "4": two servers share them), so
    ' every per-library or per-series setting is kept under the active server: "lib:<tag>:<libId>", the library
    ' page filters' and the series languages' ids "<tag>:<id>", the menu lists "navtop:<tag>" / "navside:<tag>".
    ' tag = the first 8 characters of the server id (compact: the registry also holds the sign-ins).
    ' migrateScoped moves the old shared keys to the active server once; Servers.forgetAll deletes a server's.
    function tagOf(serverId as string) as string
        return serverId.left(8)
    end function

    ' The active server's tag ("" before any server is chosen: the old shared keys)
    function libScope() as string
        return Prefs.tagOf(Util.readText("active"))
    end function

    ' "<tag>:<id>" for the active server (the id alone without one)
    function scopedId(id as string) as string
        sc = Prefs.libScope()
        if sc = "" then return id
        return sc + ":" + id
    end function

    function libKey(id as string) as string
        return "lib:" + Prefs.scopedId(id)
    end function

    ' Per library (Mac LibPref + LibraryDefaults): { nav, home, style, sort, show, name, media }
    function library(id as string) as object
        d = Util.readJson(Prefs.libKey(id))
        if type(d) <> "roAssociativeArray" then d = {}
        if d.nav = invalid then d.nav = true
        if d.home = invalid then d.home = true
        if d.style = invalid then d.style = "latest"
        if d.sort = invalid then d.sort = "name"
        if d.show = invalid then d.show = "all"
        if d.name = invalid then d.name = ""
        ' (v1.5.2 ST-8) My Media: on until switched off (never read as invalid)
        if type(d.media) <> "roBoolean" and type(d.media) <> "Boolean" then d.media = true
        return d
    end function

    ' The record as written: the defaults Prefs.library fills in are left out (each lib: key stays small)
    function compactLibrary(d as object) as object
        out = {}
        defaults = { nav: true, home: true, style: "latest", sort: "name", show: "all", name: "", media: true }
        for each k in d
            ' (formatJson compares a string with a boolean safely)
            if not defaults.doesExist(k) or formatJson(d[k]) <> formatJson(defaults[k]) then out[k] = d[k]
        end for
        return out
    end function

    sub writeLibrary(id as string, d as object)
        Util.writeText(Prefs.libKey(id), formatJson(Prefs.compactLibrary(d)))
    end sub

    sub setLibrary(id as string, key as string, value as dynamic)
        d = library(id)
        d[key] = value
        Prefs.writeLibrary(id, d)
        ' (a new Settings default replaces the sort / show last chosen on the page, as on the Mac: same lf- dict)
        if key = "sort" then forgetLibFilter(id, "s")
        if key = "show" then forgetLibFilter(id, "w")
    end sub

    ' (v1.5.2 ST-1) Once, at launch (main.bs): the shared keys of v1.5.1 and before ("lib:<libId>", "navtop",
    ' "navside", unscoped ids in "libFilters" / "seriesLangs") move to the given server (the active one, else the
    ' first). Returns how many keys or entries moved.
    function migrateScoped(serverId as string) as integer
        tg = Prefs.tagOf(serverId)
        if tg = "" then return 0
        sec = createObject("roRegistrySection", "Cove")
        moved = 0
        for each k in sec.getKeyList()
            nk = ""
            if k.left(4) = "lib:" and k.mid(4).instr(":") < 0 and k.len() > 4
                nk = "lib:" + tg + ":" + k.mid(4)
            else if k = "navtop" or k = "navside"
                nk = k + ":" + tg
            end if
            if nk <> ""
                v = sec.read(k)
                sec.delete(k)
                if not sec.exists(nk) then sec.write(nk, v)
                moved = moved + 1
            end if
        end for
        for each listKey in ["libFilters", "seriesLangs"]
            list = Util.readJson(listKey)
            if type(list) = "roArray"
                changed = false
                for each e in list
                    if Util.isAA(e) and Util.toText(e.id) <> "" and Util.toText(e.id).instr(":") < 0
                        e.id = tg + ":" + Util.toText(e.id)
                        changed = true
                        moved = moved + 1
                    end if
                end for
                if changed then sec.write(listKey, formatJson(list))
            end if
        end for
        if moved > 0
            if not sec.flush() then print "Cove: registry flush failed after moving library settings"
            print "Cove: moved "; moved; " library settings to the active server"
        end if
        return moved
    end function

    ' ---------------------------------------------------------------- filters chosen on a library page

    ' The Mac keeps them per library (LibraryView save() → "lf-<id>"). Here all libraries share one key
    ' ("libFilters", most recent last, at most 25), with short fields s (sort), o (order: a / d), w (show), g (genre), l (A–Z),
    ' only the ones that differ from the defaults: the registry also holds the sign-ins.
    function libFilters(libId as string) as dynamic
        if libId = "" then return invalid
        sid = Prefs.scopedId(libId)
        for each e in libFilterList()
            if Util.isAA(e) and Util.toText(e.id) = sid then return e
        end for
        return invalid
    end function

    ' f = { s, o, w, g, l } (missing or "" = the default)
    sub setLibFilters(libId as string, f as object)
        if libId = "" then return
        sid = Prefs.scopedId(libId)
        e = { id: sid }
        for each k in ["s", "o", "w", "g", "l"]
            v = Util.toText(f[k])
            if v <> "" then e[k] = v
        end for
        kept = []
        for each o in libFilterList()
            if Util.isAA(o) and Util.toText(o.id) <> sid then kept.push(o)
        end for
        if e.count() > 1 then kept.push(e)
        while kept.count() > 25
            kept.shift()
        end while
        Util.writeText("libFilters", formatJson(kept))
    end sub

    sub forgetLibFilter(libId as string, k as string)
        e = libFilters(libId)
        if e = invalid or e[k] = invalid then return
        e.delete(k)
        e.delete("id")
        setLibFilters(libId, e)
    end sub

    function libFilterList() as object
        v = Util.readJson("libFilters")
        if type(v) <> "roArray" then return []
        return v
    end function

    ' The registry key of a server's library order (library ids are per server, so one shared key let one
    ' server's order replace another's). The old shared key moves to the first server that reads it, the active
    ' one (Home and Settings only order the active server's libraries).
    function libOrderKey(serverId as string) as string
        key = "libOrder:" + serverId
        old = Util.readText("libOrder")
        if old <> ""
            if Util.readText(key) = "" then Util.writeText(key, old)
            sec = createObject("roRegistrySection", "Cove")
            sec.delete("libOrder")
            sec.flush()
        end if
        return key
    end function

    ' The server's libraries ([{ id, title, ... }]) in the saved order, with the saved names
    function orderLibraries(libs as object, serverId as string) as object
        order = Util.readText(libOrderKey(serverId)).split(",")
        out = []
        used = {}
        for each id in order
            for each l in libs
                if Util.toText(l.id) = id and not used.doesExist(id)
                    out.push(l)
                    used[id] = true
                end if
            end for
        end for
        for each l in libs
            if not used.doesExist(Util.toText(l.id)) then out.push(l)
        end for
        for each l in out
            n = library(Util.toText(l.id)).name
            l.serverTitle = Util.toText(l.title)
            if n <> "" then l.title = n
        end for
        return out
    end function

    sub saveOrder(ids as object, serverId as string)
        Util.writeText(libOrderKey(serverId), Util.join(ids, ","))
    end sub

    ' The library kinds that hold films and shows (the banner's Newest / Random / Favorites pick from these).
    ' (v1.5) No longer gates a library's Home row or its Settings switches: every library has those.
    function holdsFilmsOrShows(collectionType as string) as boolean
        ct = collectionType
        return ct = "movies" or ct = "tvshows" or ct = "homevideos" or ct = "musicvideos" or ct = "mixed" or ct = ""
    end function

    ' ---------------------------------------------------------------- subtitle style (Mac PlayerView sizes / colors / ...)

    function subBottom() as integer
        v = Util.readText("subBottom")
        if v = "" then return 10
        return v.toInt()
    end function

    ' ---------------------------------------------------------------- subtitle and audio language per series

    ' Subtitles: "" = automatic, "off", or a language code. Audio (v1.1): "" = automatic or a language code.
    ' All series share one key ("seriesLangs", most recent last, at most 50 entries { id, lang, a }): one key
    ' per series grew the registry without limit, and it also holds the sign-ins.
    function seriesSubLang(seriesId as string) as string
        return seriesLangField(seriesId, "lang")
    end function

    sub setSeriesSubLang(seriesId as string, lang as string)
        setSeriesLangField(seriesId, "lang", lang)
    end sub

    ' (v1.1) The audio language last chosen for a series ("jpn"), "" = none
    function seriesAudioLang(seriesId as string) as string
        return seriesLangField(seriesId, "a")
    end function

    sub setSeriesAudioLang(seriesId as string, lang as string)
        setSeriesLangField(seriesId, "a", lang)
    end sub

    function seriesLangField(seriesId as string, field as string) as string
        if seriesId = "" then return ""
        sid = Prefs.scopedId(seriesId)
        for each e in seriesLangList()
            if Util.isAA(e) and Util.toText(e.id) = sid then return Util.toText(e[field])
        end for
        return ""
    end function

    ' Sets one field of a series' entry (keeping the other), moves it to the end (most recent); an entry with
    ' neither field is dropped. Nothing is written when the value doesn't change.
    sub setSeriesLangField(seriesId as string, field as string, value as string)
        if seriesId = "" then return
        sid = Prefs.scopedId(seriesId)
        kept = []
        entry = { id: sid }
        list = seriesLangList()
        last = false
        for i = 0 to list.count() - 1
            e = list[i]
            if Util.isAA(e) and Util.toText(e.id) = sid
                entry = e
                last = i = list.count() - 1
            else
                kept.push(e)
            end if
        end for
        ' (already the value and the most recent: no registry write)
        if Util.toText(entry[field]) = value and (last or value = "") then return
        if value = ""
            entry.delete(field)
        else
            entry[field] = value
        end if
        if Util.toText(entry.lang) <> "" or Util.toText(entry.a) <> "" then kept.push(entry)
        while kept.count() > 50
            kept.shift()
        end while
        Util.writeText("seriesLangs", formatJson(kept))
    end sub

    function seriesLangList() as object
        v = Util.readJson("seriesLangs")
        if type(v) <> "roArray" then return []
        return v
    end function

    ' Once: the old "slang:<id>" keys move into the list (deleted first, so a full registry has room for it)
    sub migrateSeriesLangs()
        sec = createObject("roRegistrySection", "Cove")
        old = []
        for each k in sec.getKeyList()
            if k.startsWith("slang:") then old.push(k)
        end for
        if old.count() = 0 then return
        kept = seriesLangList()
        for each k in old
            v = sec.read(k)
            sid = k.mid(6)
            known = false
            for each e in kept
                if Util.toText(e.id) = sid then known = true
            end for
            if v <> "" and not known then kept.push({ id: sid, lang: v })
            sec.delete(k)
        end for
        sec.flush()
        while kept.count() > 50
            kept.shift()
        end while
        Util.writeText("seriesLangs", formatJson(kept))
        print "Cove: moved "; old.count(); " series subtitle languages into one registry key"
    end sub

    ' ---------------------------------------------------------------- reset

    ' Every setting back to its default; the servers and sign-ins are kept (as on the Mac), and so are the
    ' wrong-PIN counters (v0.9.1: a reset must not restart the PIN lockout)
    sub resetAll()
        sec = createObject("roRegistrySection", "Cove")
        keep = { servers: true, active: true, pinWait: true }
        for each k in sec.getKeyList()
            if not keep.doesExist(k) then sec.delete(k)
        end for
        sec.flush()
    end sub

    ' The Mac's subtitle languages, with the codes servers use for them (ISO 639-2/B, 639-2/T, 639-1)
    function languages() as object
        return [
            { name: "English", codes: ["eng", "en"] },
            { name: "Romanian", codes: ["rum", "ron", "rom", "ro", "mol", "romanian", "română", "romana"] },
            { name: "Spanish", codes: ["spa", "es"] },
            { name: "French", codes: ["fre", "fra", "fr"] },
            { name: "German", codes: ["ger", "deu", "de"] },
            { name: "Italian", codes: ["ita", "it"] },
            { name: "Portuguese", codes: ["por", "pt", "pob"] },
            { name: "Dutch", codes: ["dut", "nld", "nl"] },
            { name: "Hungarian", codes: ["hun", "hu"] },
            { name: "Polish", codes: ["pol", "pl"] },
            { name: "Russian", codes: ["rus", "ru"] },
            { name: "Turkish", codes: ["tur", "tr"] },
            { name: "Greek", codes: ["gre", "ell", "el"] },
            { name: "Swedish", codes: ["swe", "sv"] },
            { name: "Norwegian", codes: ["nor", "nob", "nno", "no", "nb", "nn"] },
            { name: "Danish", codes: ["dan", "da"] },
            { name: "Finnish", codes: ["fin", "fi"] },
            { name: "Czech", codes: ["cze", "ces", "cs"] },
            { name: "Arabic", codes: ["ara", "ar"] },
            { name: "Hebrew", codes: ["heb", "he"] },
            { name: "Japanese", codes: ["jpn", "ja"] },
            { name: "Korean", codes: ["kor", "ko"] },
            { name: "Chinese", codes: ["chi", "zho", "zh"] }
        ]
    end function

    ' Codes for a language name ("romanian" -> ["rum", "ron", ...]); the name itself if it isn't in the list
    function codesFor(langName as string) as object
        want = LCase(langName)
        for each l in languages()
            if LCase(l.name) = want then return l.codes
        end for
        return [want]
    end function

end namespace
