import "pkg:/source/Util.bs"
import "pkg:/source/Prefs.bs"
import "pkg:/source/Playback.bs"

' Audio and subtitle tracks, intro / credits markers and quality choices for one item.
namespace Tracks

    ' Subtitle codecs the Roku can show itself (fetched as SRT from the server); others (PGS, VobSub, DVB)
    ' are images and must be burned into the video by the server
    function isTextCodec(codec as string) as boolean
        c = LCase(codec)
        return c = "srt" or c = "subrip" or c = "ass" or c = "ssa" or c = "vtt" or c = "webvtt" or c = "mov_text" or c = "text" or c = "smi" or c = "sami" or c = "ttml"
    end function

    ' { sourceId, audio: [{ index, label, language, isDefault }], subs: [{ index, label, language, isText, forced, isDefault }] }
    ' The tracks of one version (sourceId; "" = the first)
    function fromItem(it as object, sourceId = "" as string) as object
        t = { sourceId: "", audio: [], subs: [] }
        sources = it.MediaSources
        streams = invalid
        if type(sources) = "roArray" and sources.count() > 0
            src = sources[0]
            for each cand in sources
                if sourceId <> "" and Util.toText(cand.Id) = sourceId then src = cand
            end for
            t.sourceId = Util.toText(src.Id)
            streams = src.MediaStreams
        end if
        if type(streams) <> "roArray" then streams = it.MediaStreams
        if type(streams) <> "roArray" then return t
        for each s in streams
            kind = Util.toText(s.Type)
            label = Util.toText(s.DisplayTitle)
            if label = "" then label = Util.toText(s.Language) + " " + UCase(Util.toText(s.Codec))
            ' no language: "(SUBRIP)" -> "Unknown language (SUBRIP)"
            if label.trim().startsWith("(") or label.trim() = UCase(Util.toText(s.Codec)) then label = "Unknown language  " + label.trim()
            if Util.toText(s.Title) <> "" and label.instr(Util.toText(s.Title)) < 0 then label = label + "  ·  " + Util.toText(s.Title)
            entry = { index: s.Index, label: label.trim(), language: LCase(Util.toText(s.Language)), isDefault: Util.flag(s, "IsDefault") }
            if kind = "Audio"
                t.audio.push(entry)
            else if kind = "Subtitle"
                entry.isText = isTextCodec(Util.toText(s.Codec))
                entry.forced = Util.flag(s, "IsForced")
                ' (v1.3.1 E-2) a file next to the video (.srt from Bazarr or Cove's subtitle search): loads at once,
                ' while an embedded track is extracted from the whole file first
                entry.external = Util.flag(s, "IsExternal")
                if entry.external and LCase(entry.label).instr("external") < 0 then entry.label = entry.label + "  ·  External"
                if not entry.isText then entry.label = entry.label + "  (burned in)"
                t.subs.push(entry)
            end if
        end for
        return t
    end function

    ' The file's default audio track (what the Roku plays without the server: direct play)
    function defaultAudio(t as object) as integer
        for each a in t.audio
            if a.isDefault then return a.index
        end for
        if t.audio.count() > 0 then return t.audio[0].index
        return -1
    end function

    ' (v1.1) A commentary track, by its name (the servers have no flag for it): "Director's Commentary",
    ' "Kommentar", "Commentaire", "Comentario", "Commento"
    function isCommentary(label as string) as boolean
        l = LCase(label)
        for each w in ["commentary", "kommentar", "commentaire", "comentario", "commento"]
            if l.instr(w) >= 0 then return true
        end for
        return false
    end function

    ' The codes of the language a code belongs to ("jpn" → ["jpn", "ja"]; "ro" → ["rum", "ron", ...]), by
    ' Prefs.languages; [code] for one that isn't in that list, [] for ""
    function codesOfLanguage(code as string) as object
        c = LCase(code.trim())
        if c = "" then return []
        for each l in Prefs.languages()
            for each k in l.codes
                if k = c then return l.codes
            end for
        end for
        return [c]
    end function

    ' (v1.1) The audio track to start with. wanted: language codes in order (the series' last choice, the
    ' server account's preferred audio language); the first one with a track wins (its default-flagged
    ' track first). Without a match: the file's default. Commentary tracks are never picked on their own:
    ' the next non-commentary track is taken instead (the user can still choose one in the Audio menu).
    function startAudio(t as object, wanted as object) as integer
        if t.audio.count() = 0 then return -1
        for each w in wanted
            codes = codesOfLanguage(Util.toText(w))
            hit = -1
            for each a in t.audio
                if not isCommentary(a.label)
                    for each c in codes
                        if a.language = c and (hit < 0 or a.isDefault) then hit = a.index
                    end for
                end if
            end for
            if hit >= 0 then return hit
        end for
        d = defaultAudio(t)
        da = findAudio(t, d)
        if da = invalid or not isCommentary(da.label) then return d
        ' the default is a commentary: its language's first other track, else the first other track
        for each a in t.audio
            if not isCommentary(a.label) and a.language = da.language and da.language <> "" then return a.index
        end for
        for each a in t.audio
            if not isCommentary(a.label) then return a.index
        end for
        return d
    end function

    ' (v1.1) The server account's audio preference (Jellyfin and Emby UserConfiguration:
    ' AudioLanguagePreference, PlayDefaultAudioTrack), kept for the session in m.global.userAudio after one
    ' GET /Users/{id} per user: { lang, playDefault }, or invalid when it wasn't asked for yet
    function serverAudioPref(server as dynamic) as dynamic
        if m.global = invalid or not m.global.hasField("userAudio") then return invalid
        cache = m.global.userAudio
        if not Util.isAA(cache) then return invalid
        return cache[audioCacheKey(server)]
    end function

    ' json: the GET /Users/{id} answer (invalid after a failure: kept as "no preference" for the session)
    sub rememberServerAudio(server as dynamic, json as dynamic)
        if m.global = invalid then return
        if not m.global.hasField("userAudio") then m.global.addFields({ userAudio: {} })
        cache = m.global.userAudio
        if not Util.isAA(cache) or cache.count() > 20 then cache = {}
        cfg = Util.field(json, "Configuration")
        e = { lang: LCase(Util.toText(Util.field(cfg, "AudioLanguagePreference")).trim()), playDefault: true }
        ' (missing: true, the servers' default)
        if Util.isAA(cfg) and cfg.doesExist("PlayDefaultAudioTrack") then e.playDefault = Util.flag(cfg, "PlayDefaultAudioTrack")
        cache[audioCacheKey(server)] = e
        m.global.userAudio = cache
    end sub

    function audioCacheKey(server as dynamic) as string
        return Util.toText(Util.field(server, "id")) + ":" + Util.toText(Util.field(server, "userId"))
    end function

    ' The languages startAudio looks for, in order: the series' last choice (Prefs.seriesAudioLang), then the
    ' server account's preferred audio language. As on the servers, "Play default audio track regardless of
    ' language" (on by default) keeps a file's default-flagged track instead of that preferred language.
    function wantedAudio(t as object, seriesLang as string, pref as dynamic) as object
        out = []
        if seriesLang <> "" then out.push(seriesLang)
        if Util.isAA(pref) and Util.toText(pref.lang) <> ""
            flagged = false
            for each a in t.audio
                if a.isDefault then flagged = true
            end for
            if not (Util.flag(pref, "playDefault") and flagged) then out.push(Util.toText(pref.lang))
        end if
        return out
    end function

    ' The versions of a title (two or more MediaSources): [{ id, label }], else []
    function versions(it as object) as object
        out = []
        sources = it.MediaSources
        if type(sources) <> "roArray" or sources.count() < 2 then return out
        for each s in sources
            label = Util.toText(s.Name)
            if label = ""
                ' e.g. "4K HEVC HDR" from the video stream
                if type(s.MediaStreams) = "roArray"
                    for each st in s.MediaStreams
                        if Util.toText(st.Type) = "Video" and label = "" then label = Util.toText(st.DisplayTitle)
                    end for
                end if
            end if
            if label = "" then label = Util.toText(s.Container)
            if s.Size <> invalid and s.Size > 0
                tenths = Int(s.Size / 107374182.4 + 0.5)
                label = label + "  ·  " + (tenths \ 10).toStr() + "." + (tenths mod 10).toStr() + " GB"
            end if
            if label.len() > 60 then label = label.left(57) + "..."
            out.push({ id: Util.toText(s.Id), label: label })
        end for
        return out
    end function

    function versionLabel(list as object, sourceId as string) as string
        if list.count() = 0 then return ""
        for each v in list
            if v.id = sourceId then return v.label
        end for
        return list[0].label
    end function

    ' The subtitle for a language from Settings ("romanian"): by its codes (rum / ron / rom / ro ...), else by the
    ' track's name ("Romanian (SRT)", "Română"). Within each, as Cove for macOS bestTextSub (v1.3.1 E-2): an
    ' external text file first, then an embedded text track, then any (pictures). -1 if there is none.
    function subForLanguage(t as object, langName as string) as integer
        codes = Prefs.codesFor(langName)
        name = LCase(langName)
        for pass = 0 to 2
            for each s in t.subs
                if subPassOk(s, pass)
                    for each c in codes
                        if s.language = c then return s.index
                    end for
                end if
            end for
        end for
        for pass = 0 to 2
            for each s in t.subs
                if subPassOk(s, pass) and LCase(s.label).instr(name) >= 0 then return s.index
            end for
        end for
        return -1
    end function

    ' The three passes over one language's subtitles: 0 external text, 1 any text, 2 anything
    function subPassOk(s as object, pass as integer) as boolean
        if pass = 0 then return s.isText and Util.flag(s, "external")
        if pass = 1 then return s.isText
        return true
    end function

    ' Subtitles start off, except forced ones (foreign-language parts) or the language chosen before
    ' (external text first, then embedded text, then any; forced: external text first, then text)
    function defaultSub(t as object, preferLang as string) as integer
        if preferLang <> ""
            for pass = 0 to 2
                for each s in t.subs
                    if s.language = preferLang and subPassOk(s, pass) then return s.index
                end for
            end for
        end if
        for pass = 0 to 1
            for each s in t.subs
                if s.forced and subPassOk(s, pass) then return s.index
            end for
        end for
        return -1
    end function

    ' "external" / "embedded" (text) / "burned in", for the player's log line
    function subKindOf(t as object, index as integer) as string
        s = findSub(t, index)
        if s = invalid then return "none"
        if not s.isText then return "burned in"
        if Util.flag(s, "external") then return "external"
        return "embedded"
    end function

    function findSub(t as object, index as integer) as dynamic
        for each s in t.subs
            if s.index = index then return s
        end for
        return invalid
    end function

    function findAudio(t as object, index as integer) as dynamic
        for each a in t.audio
            if a.index = index then return a
        end for
        return invalid
    end function

    function audioLabel(t as object, index as integer) as string
        a = findAudio(t, index)
        if a = invalid then return "Default"
        return a.label
    end function

    function subLabel(t as object, index as integer) as string
        s = findSub(t, index)
        if s = invalid then return "Off"
        return s.label
    end function

    ' Quality choices: 0 = automatic (as high as the Roku and network allow)
    function qualities() as object
        return [
            { id: "0", label: "Automatic" },
            { id: "40000000", label: "40 Mbit/s (4K)" },
            { id: "20000000", label: "20 Mbit/s (1080p high)" },
            { id: "10000000", label: "10 Mbit/s (1080p)" },
            { id: "6000000", label: "6 Mbit/s (720p)" },
            { id: "3000000", label: "3 Mbit/s" }
        ]
    end function

    function qualityLabel(bitrate as integer) as string
        for each q in qualities()
            if q.id = bitrate.toStr() then return q.label
        end for
        return "Automatic"
    end function

    ' Intro and credits from Emby chapter markers (MarkerType IntroStart / IntroEnd / CreditsStart)
    ' → { introStart, introEnd, credits, creditsEnd, segs } in seconds (-1 when unknown); segs: the other
    ' skippable parts (Jellyfin recap / preview / commercial segments) as [{ key, kind, s, e }]
    function markers(it as object) as object
        r = { introStart: -1.0, introEnd: -1.0, credits: -1.0, creditsEnd: -1.0, segs: [] }
        ch = it.Chapters
        if type(ch) <> "roArray" then return r
        for each c in ch
            mt = Util.toText(c.MarkerType)
            at = Playback.seconds(c.StartPositionTicks)
            if mt = "IntroStart"
                r.introStart = at
            else if mt = "IntroEnd"
                r.introEnd = at
            else if mt = "CreditsStart"
                r.credits = at
            end if
        end for
        return r
    end function

    ' Jellyfin media segments (/MediaSegments/{id}) → same shape as markers()
    function fromSegments(json as dynamic, r as object) as object
        if json = invalid or GetInterface(json, "ifAssociativeArray") = invalid then return r
        list = json.Items
        if type(list) <> "roArray" then return r
        if r.segs = invalid then r.segs = []
        for each s in list
            kind = LCase(Util.toText(s.Type))
            st = Playback.seconds(s.StartTicks)
            en = Playback.seconds(s.EndTicks)
            if kind = "intro"
                r.introStart = st
                r.introEnd = en
            else if kind = "outro" and r.credits < 0
                r.credits = st
                r.creditsEnd = en
            else if (kind = "recap" or kind = "preview" or kind = "commercial") and en > st + 1
                r.segs.push({ key: r.segs.count().toStr(), kind: kind, s: st, e: en })
            end if
        end for
        return r
    end function

    ' The button over the video for a segment
    function segmentLabel(kind as string) as string
        if kind = "recap" then return "Skip recap"
        if kind = "preview" then return "Skip preview"
        if kind = "commercial" then return "Skip ad"
        return "Skip"
    end function

    ' (v1.3) A segment kind's name for the Settings rows and the "Skipped ..." notice
    function segmentName(kind as string) as string
        if kind = "intro" then return "Intro"
        if kind = "recap" then return "Recap"
        if kind = "preview" then return "Preview"
        if kind = "commercial" then return "Ad"
        if kind = "credits" then return "Credits"
        return "Segment"
    end function

    ' PL-11: a quality cap below the chosen file's bitrate makes the server encode the video (no copy), so
    ' the stream is handled as a conversion: H.264 within 1080p, reported as Transcode. info: PlaybackInfo.
    function capForcesEncode(info as dynamic, sourceId as string, maxBitrate as dynamic) as boolean
        cap = Util.toNumber(maxBitrate)
        if cap <= 0 or not Util.isAA(info) then return false
        sources = info.MediaSources
        if type(sources) <> "roArray" or sources.count() = 0 then return false
        src = sources[0]
        for each cand in sources
            if sourceId <> "" and Util.isAA(cand) and Util.toText(cand.Id) = sourceId then src = cand
        end for
        if not Util.isAA(src) then return false
        return Util.toNumber(src.Bitrate) > cap
    end function

    ' ---------------------------------------------------------------- v1.5.2 player

    ' (v1.5.2 P5-11) What identifies a track across a refreshed stream list (whose indexes can shift when the
    ' server adds a file): language, label (codec, title) and external
    function trackSig(t as dynamic) as string
        if not Util.isAA(t) then return ""
        ext = "0"
        if Util.flag(t, "external") then ext = "1"
        return Util.toText(t.language) + "|" + Util.toText(t.label) + "|" + ext
    end function

    ' (v1.5.2 P5-11) The index in newList of the track that had index in oldList: the same index when it still
    ' is the same track, else the first track that matches it; -1 when it is gone (or index < 0)
    function rematch(oldList as dynamic, newList as dynamic, index as integer) as integer
        if index < 0 or type(oldList) <> "roArray" or type(newList) <> "roArray" then return -1
        was = invalid
        for each t in oldList
            if Util.isAA(t) and t.index = index then was = t
        end for
        if was = invalid then return -1
        sig = trackSig(was)
        found = -1
        for each t in newList
            if Util.isAA(t) and trackSig(t) = sig
                if t.index = index then return index
                if found < 0 then found = t.index
            end if
        end for
        return found
    end function

    ' (v1.5.2 P5-11) The tracks of newList that weren't in oldList (by trackSig, not by index)
    function addedTracks(oldList as dynamic, newList as dynamic) as object
        known = {}
        if type(oldList) = "roArray"
            for each t in oldList
                known[trackSig(t)] = true
            end for
        end if
        out = []
        if type(newList) <> "roArray" then return out
        for each t in newList
            if Util.isAA(t) and not known.doesExist(trackSig(t)) then out.push(t)
        end for
        return out
    end function

    ' (v1.5.2 P5-11) The downloaded subtitle among the added ones: the first external text track, else the
    ' first text track; invalid when none
    function downloadedSub(added as object) as dynamic
        firstText = invalid
        for each t in added
            if Util.flag(t, "isText")
                if Util.flag(t, "external") then return t
                if firstText = invalid then firstText = t
            end if
        end for
        return firstText
    end function

end namespace
