import "pkg:/source/Util.bs"
import "pkg:/source/Log.bs"

' Times of day in the Roku's own format (Settings → System → Time → Clock format: 12 hour / 24 hour):
' "10:41 PM" or "22:41". Used for the player's and the details page's "Ends at".
namespace Clock

    ' The Roku's clock format is 24 hours ("24h"); 12 hours otherwise, the Roku's default ("12h")
    ' (read once per component: the player's bar redraws it twice a second)
    function uses24h() as boolean
        if m.clockIs24h <> invalid then return m.clockIs24h
        is24 = false
        di = createObject("roDeviceInfo")
        if di <> invalid and GetInterface(di, "ifDeviceInfo") <> invalid then is24 = LCase(Util.toText(di.GetClockFormat())) = "24h"
        m.clockIs24h = is24
        return is24
    end function

    ' hours 0..23, minutes 0..59 → "22:41" (24 h) or "10:41 PM" (12 h; 0:05 is "12:05 AM")
    function formatHm(hours as integer, minutes as integer, use24 as boolean) as string
        mm = Right("0" + minutes.toStr(), 2)
        if use24 then return Right("0" + hours.toStr(), 2) + ":" + mm
        suffix = " AM"
        if hours >= 12 then suffix = " PM"
        h12 = hours mod 12
        if h12 = 0 then h12 = 12
        return h12.toStr() + ":" + mm + suffix
    end function

    ' The local time secondsFromNow from now, in the Roku's format: "10:41 PM"
    function timeIn(secondsFromNow as integer) as string
        dt = createObject("roDateTime")
        dt.ToLocalTime()
        dt.FromSeconds(dt.AsSeconds() + secondsFromNow)
        return formatHm(dt.GetHours(), dt.GetMinutes(), uses24h())
    end function

    ' "Ends at 10:41 PM"
    function endsAtText(secondsFromNow as integer) as string
        return "Ends at " + timeIn(secondsFromNow)
    end function

    ' (v1.1.2) The moment now as { secs, ms }: whole UTC seconds plus milliseconds, so it fits Integers
    ' (UpTime(0) is a Float of the time since the device booted: it printed 768769536 and lost precision)
    function stampNow() as object
        dt = createObject("roDateTime")
        return { secs: dt.AsSeconds(), ms: dt.GetMilliseconds() }
    end function

    ' (v1.1.2) Milliseconds from one { secs, ms } stamp to a later one; -1 when either is missing
    function msBetween(fromStamp as dynamic, toStamp as dynamic) as integer
        if not Util.isAA(fromStamp) or not Util.isAA(toStamp) then return -1
        if fromStamp.secs = invalid or fromStamp.ms = invalid or toStamp.secs = invalid or toStamp.ms = invalid then return -1
        return (toStamp.secs - fromStamp.secs) * 1000 + (toStamp.ms - fromStamp.ms)
    end function

    ' (v1.1.2) Milliseconds since the app started (main.bs stores m.global.launchAt); -1 when unknown
    function msSinceLaunch() as integer
        if m.global = invalid or not m.global.hasField("launchAt") then return -1
        return msBetween(m.global.launchAt, stampNow())
    end function

    ' (v1.2) A startup step on the debug console, "Cove: startup  412 ms  sign-in check answered": splits the
    ' time before Home into its steps. Printed until Home's first backdrop is on screen (HomeScreen sets
    ' m.global.startupDone) and never later than 15 s after the launch (a sign-in or a profile choice)
    sub startupMark(label as string)
        if m.global = invalid then return
        if m.global.hasField("startupDone") and m.global.startupDone = true then return
        ms = msSinceLaunch()
        if ms > 15000
            if m.global.hasField("startupDone") then m.global.startupDone = true
            return
        end if
        Log.line("Cove: startup " + Util.toText(ms) + " ms  " + Util.toText(label))
    end sub

end namespace
