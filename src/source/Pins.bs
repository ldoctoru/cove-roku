import "pkg:/source/Util.bs"

' Profile PINs (4 digits). The PIN itself is never stored or printed: the profile's "p" field (Servers.bs) holds
' a random salt and a hash. Since v0.9.1 that is "k" + 16 hex characters of salt + SHA-256 applied 1000 times
' (the first round over salt:serverId:userId:pin, then over the previous digest); a v0.9.0 value (80 characters,
' one round) still verifies and is replaced by the new form at the next right PIN. This is a household lock,
' not strong protection: with only 10 000 possible PINs, anyone who can read the app's registry can find the
' PIN by trying them all, and the rounds only make that a little slower.
' Wrong tries: after every 3rd wrong PIN in a row the profile waits 30 s, then 1 min, 5 min and 15 min; the
' streak is kept in the registry ("pinWait", kept through Reset All Settings) until a right PIN is entered.
namespace Pins

    function isValid(pin as string) as boolean
        return CreateObject("roRegex", "^[0-9]{4}$", "").isMatch(pin)
    end function

    ' (v0.9.0: one round)
    function digest(salt as string, serverId as string, userId as string, pin as string) as string
        ba = CreateObject("roByteArray")
        ba.fromAsciiString(salt + ":" + serverId + ":" + userId + ":" + pin)
        d = CreateObject("roEVPDigest")
        d.setup("sha256")
        return LCase(d.process(ba))
    end function

    ' (v0.9.1) the first round as above, then 999 more over the previous digest
    function stretched(salt as string, serverId as string, userId as string, pin as string) as string
        h = digest(salt, serverId, userId, pin)
        ba = CreateObject("roByteArray")
        d = CreateObject("roEVPDigest")
        d.setup("sha256")
        for i = 2 to 1000
            ba.fromHexString(h)
            h = d.process(ba)
        end for
        return LCase(h)
    end function

    ' A new salt + hash for the profile's "p" field
    function make(serverId as string, userId as string, pin as string) as string
        salt = LCase(CreateObject("roDeviceInfo").getRandomUUID().replace("-", "")).left(16)
        if salt.len() < 16
            ' (fallback: random hex digits)
            salt = ""
            for i = 1 to 16
                salt = salt + StrI(Rnd(16) - 1, 16)
            end for
        end if
        return "k" + salt + stretched(salt, serverId, userId, pin)
    end function

    function matches(stored as string, serverId as string, userId as string, pin as string) as boolean
        if not isValid(pin) then return false
        if stored.len() = 81 and stored.left(1) = "k"
            return stretched(stored.mid(1, 16), serverId, userId, pin) = stored.mid(17)
        end if
        ' (a v0.9.0 hash)
        if stored.len() <> 80 then return false
        return digest(stored.left(16), serverId, userId, pin) = stored.mid(16)
    end function

    ' A v0.9.0 hash, to replace with make() after a right PIN
    function isOldHash(stored as string) as boolean
        return stored.len() = 80
    end function

    ' ---------------------------------------------------------------- every 3 wrong tries: 30 s, 1 min, 5 min, 15 min

    function lockKey(serverId as string, userId as string) as string
        return serverId.left(12) + ":" + userId.left(12)
    end function

    function now() as integer
        return CreateObject("roDateTime").asSeconds()
    end function

    function waits() as object
        v = Util.readJson("pinWait")
        if not Util.isAA(v) then return {}
        return v
    end function

    ' Seconds left before the profile's PIN can be tried again (0 = now)
    function waitLeft(serverId as string, userId as string) as integer
        e = waits()[lockKey(serverId, userId)]
        if not Util.isAA(e) then return 0
        left_ = Int(Util.toNumber(e.u)) - now()
        if left_ < 0 or left_ > 900 then return 0
        return left_
    end function

    ' A wrong PIN: the seconds to wait now (after the 3rd, 6th, 9th, 12th... wrong try in a row; else 0). The
    ' streak (f) only ends with a right PIN (clearWrong).
    function noteWrong(serverId as string, userId as string) as integer
        all_ = waits()
        k = lockKey(serverId, userId)
        e = all_[k]
        if not Util.isAA(e) then e = { f: 0, u: 0 }
        e.f = Int(Util.toNumber(e.f)) + 1
        wait_ = 0
        if e.f mod 3 = 0
            steps = [30, 60, 300, 900]
            idx = Int(e.f / 3) - 1
            if idx > 3 then idx = 3
            wait_ = steps[idx]
            e.u = now() + wait_
        end if
        all_[k] = e
        Util.writeText("pinWait", formatJson(all_))
        return wait_
    end function

    sub clearWrong(serverId as string, userId as string)
        all_ = waits()
        k = lockKey(serverId, userId)
        if not all_.doesExist(k) then return
        all_.delete(k)
        Util.writeText("pinWait", formatJson(all_))
    end sub

    ' "Wrong PIN. Please try again." / "Wrong PIN. Too many tries: try again in 5 min."
    function wrongText(wait_ as integer) as string
        if wait_ > 0 then return "Wrong PIN. Too many tries: try again in " + waitWords(wait_) + "."
        return "Wrong PIN. Please try again."
    end function

    function waitText(wait_ as integer) as string
        return "Too many wrong PINs. Try again in " + waitWords(wait_) + "."
    end function

    ' 45 → "45 s", 300 → "5 min", 290 → "5 min" (rounded up)
    function waitWords(wait_ as integer) as string
        if wait_ < 60 then return wait_.toStr() + " s"
        return Int((wait_ + 59) / 60).toStr() + " min"
    end function

    ' ---------------------------------------------------------------- v1.6 CORE

    ' (v1.6 CS-11, PinTask) The first profile of ids ([{ uid, stored }]) whose PIN is pin, "" = none. Each
    ' stored PIN has its own salt, so a wrong PIN costs one full check per profile: run it on a Task.
    function firstMatch(ids as object, serverId as string, pin as string) as string
        if not Pins.isValid(pin) then return ""
        for each e in ids
            if Util.isAA(e)
                uid = Util.toText(e.uid)
                stored = Util.toText(e.stored)
                if uid <> "" and stored <> "" and Pins.matches(stored, serverId, uid, pin) then return uid
            end if
        end for
        return ""
    end function

end namespace
