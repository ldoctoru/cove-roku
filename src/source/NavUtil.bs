import "pkg:/source/Util.bs"

' Small pure helpers for screen layout and focus (v1.0.1 SC-8, SC-12, SC-17); unit-tested in tests/brs/navutil.test.brs
namespace NavUtil

    ' The index of the entry with this id ([{ id, ... }]), or -1
    function indexOfId(list as object, id as string) as integer
        if id = "" or type(list) <> "roArray" then return -1
        for i = 0 to list.count() - 1
            e = list[i]
            if Util.isAA(e) and Util.toText(e.id) = id then return i
        end for
        return -1
    end function

    ' A kept focus index for a list of n entries: the last one when the list got shorter, -1 when empty
    function clampIndex(i as integer, n as integer) as integer
        if n <= 0 then return -1
        if i >= n then return n - 1
        if i < 0 then return 0
        return i
    end function

    ' The episode page's "Go to <season>" button: a long season name would push the row off the screen, so it
    ' becomes "Go to Season N" (or is cut when the number isn't known)
    function seasonButtonText(seasonTitle as string, seasonNumber as dynamic) as string
        maxName = 18
        if seasonTitle.len() <= maxName then return "Go to " + seasonTitle
        n = Util.toText(seasonNumber)
        if n <> "" then return "Go to Season " + n
        return "Go to " + seasonTitle.left(maxName - 3) + "..."
    end function

    ' How far a row of buttons moves left so the focused one (its left and right edge in the row) stays inside
    ' width: 0 while it fits, never past the row's start
    function buttonShift(focusLeft as integer, focusRight as integer, width as integer) as integer
        if focusRight <= width then return 0
        shift = width - focusRight
        if focusLeft + shift < 0 then shift = -focusLeft
        return shift
    end function

    ' (v1.1.1 NV-13) Rewind / Fast Forward in a row of cards: the column one screen of cards back or on
    ' (dir -1 / 1), kept inside the row. rowWidth / cardWidth = how many cards one screen shows.
    function pageColumn(col as integer, count as integer, rowWidth as integer, cardWidth as integer, dir as integer) as integer
        if count <= 0 then return -1
        perScreen = 1
        if cardWidth > 0 and rowWidth > cardWidth then perScreen = Int(rowWidth / cardWidth)
        nextCol = col + dir * perScreen
        if nextCol >= count then nextCol = count - 1
        if nextCol < 0 then nextCol = 0
        return nextCol
    end function

    ' The card width of row i in a RowList's rowItemSize ([[w, h], ...]; the last entry covers the rest)
    function rowCardWidth(sizes as dynamic, i as integer) as integer
        if type(sizes) <> "roArray" or sizes.count() = 0 then return 0
        k = i
        if k >= sizes.count() then k = sizes.count() - 1
        if k < 0 then k = 0
        e = sizes[k]
        if type(e) <> "roArray" or e.count() < 1 then return 0
        return Int(e[0])
    end function

end namespace
