import "pkg:/source/Util.bs"

' Small pure helpers for screen layout and focus (v1.0.1 SC-8, SC-12, SC-17); unit-tested in tests/brs/navutil.test.brs
namespace NavUtil

    ' (BG-8) The key a page is found by in MainScene's stack (stackIndexOf): a details page its item id, a person
    ' page the person's id, a genre / studio page "Genre:<id or name>"; "" for other pages
    function pageKey(kind as string, itemId as dynamic, person as dynamic, library as dynamic) as string
        if kind = "details" then return Util.toText(itemId)
        if kind = "person" and Util.isAA(person) then return Util.toText(person.id)
        if kind = "library" and Util.isAA(library) and Util.toText(library.feed) = "tag" then return tagPageKey(Util.toText(library.tagKind), Util.toText(library.tagId), Util.toText(library.tagName))
        return ""
    end function

    ' A genre / studio page's key: its kind and id (its name when it has no id)
    function tagPageKey(tagKind as string, tagId as string, tagName as string) as string
        if tagKind = "" then return ""
        if tagId <> "" then return tagKind + ":" + tagId
        if tagName = "" then return ""
        return tagKind + ":" + tagName
    end function

    ' (SC-11 / BG-8) The stack's screen kinds, bottom (Home) first: which one to close so a new screen fits under
    ' maxScreens. The oldest page above Home (details, person, library, search, favorites, now playing); never
    ' Home, the top screen, menus or the player. -1 when the stack fits or nothing can go.
    function capDropIndex(kinds as object, maxScreens as integer) as integer
        if type(kinds) <> "roArray" or kinds.count() < maxScreens then return -1
        for i = 1 to kinds.count() - 2
            k = Util.toText(kinds[i])
            if k = "details" or k = "person" or k = "library" or k = "search" or k = "favorites" or k = "nowplaying" then return i
        end for
        return -1
    end function

    ' The index of the entry with this id ([{ id, ... }]), or -1
    function indexOfId(list as object, id as string) as integer
        if id = "" or type(list) <> "roArray" then return -1
        for i = 0 to list.count() - 1
            e = list[i]
            if Util.isAA(e) and Util.toText(e.id) = id then return i
        end for
        return -1
    end function

    ' A kept focus index for a list of n entries: the last one when the list got shorter, -1 when empty
    function clampIndex(i as integer, n as integer) as integer
        if n <= 0 then return -1
        if i >= n then return n - 1
        if i < 0 then return 0
        return i
    end function

    ' The episode page's "Go to <season>" button: a long season name would push the row off the screen, so it
    ' becomes "Go to Season N" (or is cut when the number isn't known)
    function seasonButtonText(seasonTitle as string, seasonNumber as dynamic) as string
        maxName = 18
        if seasonTitle.len() <= maxName then return "Go to " + seasonTitle
        n = Util.toText(seasonNumber)
        if n <> "" then return "Go to Season " + n
        return "Go to " + seasonTitle.left(maxName - 3) + "..."
    end function

    ' How far a row of buttons moves left so the focused one (its left and right edge in the row) stays inside
    ' width: 0 while it fits, never past the row's start
    function buttonShift(focusLeft as integer, focusRight as integer, width as integer) as integer
        if focusRight <= width then return 0
        shift = width - focusRight
        if focusLeft + shift < 0 then shift = -focusLeft
        return shift
    end function

    ' (v1.1.1 NV-13) Rewind / Fast Forward in a row of cards: the column one screen of cards back or on
    ' (dir -1 / 1), kept inside the row. rowWidth / cardWidth = how many cards one screen shows.
    function pageColumn(col as integer, count as integer, rowWidth as integer, cardWidth as integer, dir as integer) as integer
        if count <= 0 then return -1
        perScreen = 1
        if cardWidth > 0 and rowWidth > cardWidth then perScreen = Int(rowWidth / cardWidth)
        nextCol = col + dir * perScreen
        if nextCol >= count then nextCol = count - 1
        if nextCol < 0 then nextCol = 0
        return nextCol
    end function

    ' The card width of row i in a RowList's rowItemSize ([[w, h], ...]; the last entry covers the rest)
    function rowCardWidth(sizes as dynamic, i as integer) as integer
        if type(sizes) <> "roArray" or sizes.count() = 0 then return 0
        k = i
        if k >= sizes.count() then k = sizes.count() - 1
        if k < 0 then k = 0
        e = sizes[k]
        if type(e) <> "roArray" or e.count() < 1 then return 0
        return Int(e[0])
    end function

    ' (v1.2 NV-7) One step along a menu of n entries that wraps: past the last back to the first and before the
    ' first on to the last (dir -1 / 1); -1 when the menu is empty
    function wrapStep(i as integer, n as integer, dir as integer) as integer
        if n <= 0 then return -1
        j = (i + dir) mod n
        if j < 0 then j = j + n
        return j
    end function

    ' (v1.2 NV-7) The next entry of the sidebar up (dir -1) or down (dir 1), wrapping round and skipping the
    ' section titles (headers[i] = true); i itself when it is the only entry, -1 when there is none
    function nextEntry(headers as object, i as integer, dir as integer) as integer
        if type(headers) <> "roArray" or headers.count() = 0 then return -1
        total = headers.count()
        j = i
        for tries = 1 to total
            j = wrapStep(j, total, dir)
            if headers[j] <> true then return j
        end for
        return -1
    end function

    ' (v1.2 NV-6) Where the sidebar opens: the entry last opened from it this session (same id and name, so a
    ' library list that changed since doesn't land on another library), else the current page, else -1
    function openEntry(list as object, lastId as string, lastLabel as string, currentId as string) as integer
        if type(list) <> "roArray" then return -1
        i = indexOfId(list, lastId)
        if i >= 0 and Util.toText(list[i].label) = lastLabel then return i
        return indexOfId(list, currentId)
    end function

    ' (v1.3.1) Playback started from Home has ended: the page to open over Home, as Cove for macOS returnAfterPlay /
    ' openPage. card: { itemId, itemType } of the Home card or banner played; played: { id, type, seriesId,
    ' seasonId } of the first title the player showed. An episode opens its series on that episode's season (its
    ' own page when the series isn't known), anything else its own page. invalid: nothing to open.
    function returnPage(card as dynamic, played as dynamic) as dynamic
        if not Util.isAA(card) or Util.toText(card.itemId) = "" then return invalid
        id = Util.toText(card.itemId)
        t = Util.toText(card.itemType)
        p = played
        if not Util.isAA(p) or Util.toText(p.id) <> id then p = invalid
        if t = "" and p <> invalid then t = Util.toText(p.type)
        if t = "Episode" or t = ""
            if p <> invalid and Util.toText(p.seriesId) <> ""
                out = { itemId: Util.toText(p.seriesId), itemType: "Series", title: "" }
                if Util.toText(p.seasonId) <> "" then out.seasonId = Util.toText(p.seasonId)
                return out
            end if
            if t = "" then return invalid
        end if
        return { itemId: id, itemType: t, title: "" }
    end function

end namespace
