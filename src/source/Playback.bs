import "pkg:/source/Prefs.bs"
import "pkg:/source/Util.bs"
import "pkg:/source/DeviceCaps.bs"
import "pkg:/source/Api.bs"
import "pkg:/source/Servers.bs"
import "pkg:/source/Log.bs"

' What to ask the server for and how to play what it returns. The device profile is built from what this Roku
' reports (DeviceCaps), so the server only converts what the Roku can't play. Streambar 9102: HEVC Main 10 /
' HDR10 up to 4K plays unchanged; H.264 only up to 1080p; TrueHD / DTS audio are converted to E-AC3 / AC3.
namespace Playback

    ' Quoted keys keep their case in the JSON sent to the server (unquoted AA keys are lower-cased)
    function profile(caps as object, maxBitrate as integer, jellyfin = false as boolean) as object
        video = ["h264"]
        if caps.hevc then video.push("hevc")
        audio = ["aac", "mp3", "flac"]
        if caps.eac3 then audio.push("eac3")
        if caps.ac3 then audio.push("ac3")
        ' Settings → Playback → Audio → DTS passthrough (only when the Roku says the receiver / TV takes DTS)
        if Prefs.dtsPassthrough() and Util.flag(caps, "dts")
            audio.push("dts")
            audio.push("dca")
        end if
        maxCh = Prefs.audioChannels()
        ' Converted audio: surround codecs first, so a 5.1 / 7.1 track keeps its channels; AAC first for stereo
        tAudio = []
        if maxCh = 2 then tAudio.push("aac")
        if caps.eac3 then tAudio.push("eac3")
        if caps.ac3 then tAudio.push("ac3")
        if maxCh <> 2 then tAudio.push("aac")
        ' Settings → Playback → Audio → Convert to: that codec first, when this Roku plays it
        pref = Prefs.audioCodec()
        playable = false
        for each a in tAudio
            if a = pref then playable = true
        end for
        if playable
            ordered = [pref]
            for each a in tAudio
                if a <> pref then ordered.push(a)
            end for
            tAudio = ordered
        end if
        tCh = "6"
        if maxCh > 0 then tCh = maxCh.toStr()
        ' Copy HEVC into the HLS stream when possible; when the server must encode it uses the first: H.264
        tVideo = "h264"
        if caps.hevc then tVideo = "h264,hevc"

        codecProfiles = [
            {
                "Type": "Video", "Codec": "h264",
                "Conditions": [
                    { "Condition": "LessThanEqual", "Property": "Width", "Value": "1920", "IsRequired": false },
                    { "Condition": "LessThanEqual", "Property": "VideoBitDepth", "Value": "8", "IsRequired": false }
                ]
            }
        ]
        ' (bit depth, a 1080p-only decoder, HDR / Dolby Vision the display lacks: DeviceCaps, PL-12)
        hevcConds = DeviceCaps.hevcConditions(caps, jellyfin)
        if hevcConds.count() > 0 then codecProfiles.push({ "Type": "Video", "Codec": "hevc", "Conditions": hevcConds })
        ' Settings → Playback → Audio → Maximum channels: a track with more is converted (downmixed) by the server
        if maxCh > 0 then codecProfiles.push({ "Type": "VideoAudio", "Conditions": [{ "Condition": "LessThanEqual", "Property": "AudioChannels", "Value": maxCh.toStr(), "IsRequired": false }] })
        maxW = "1920"
        if caps.fourK then maxW = "3840"

        return {
            "Name": "Cove Roku",
            "MaxStreamingBitrate": maxBitrate,
            "MaxStaticBitrate": maxBitrate,
            "MusicStreamingTranscodingBitrate": 192000,
            "DirectPlayProfiles": [
                { "Container": "mkv,mp4,m4v,mov,ts", "Type": "Video", "VideoCodec": Util.join(video, ","), "AudioCodec": Util.join(audio, ",") }
            ],
            "TranscodingProfiles": [
                {
                    "Container": "ts", "Type": "Video", "Protocol": "hls", "Context": "Streaming",
                    "VideoCodec": tVideo, "AudioCodec": Util.join(tAudio, ","), "MaxAudioChannels": tCh,
                    "MinSegments": "1", "BreakOnNonKeyFrames": true
                }
            ],
            "ContainerProfiles": [],
            "CodecProfiles": codecProfiles,
            "ResponseProfiles": [],
            "SubtitleProfiles": subtitleProfiles(),
            "MaxWidth": maxW
        }
    end function

    ' Text subtitles are shown by the Roku (fetched separately as SRT); image subtitles are burned in
    function subtitleProfiles() as object
        out = []
        for each f in ["srt", "subrip", "ass", "ssa", "vtt", "webvtt", "mov_text"]
            out.push({ "Format": f, "Method": "External" })
        end for
        for each f in ["pgs", "pgssub", "dvdsub", "dvbsub", "vobsub"]
            out.push({ "Format": f, "Method": "Encode" })
        end for
        return out
    end function

    ' Choices for one playback: audio / sub = stream index (-1: default audio / no subtitles), burn = the
    ' subtitle is an image the server burns in, maxBitrate = 0 for automatic, defaultAudio = the file's default
    ' server: whose address decides home network or internet (Settings → Playback → Start with); invalid = the
    ' active server
    function options(server = invalid as dynamic) as object
        srv = server
        if srv = invalid then srv = Servers.active()
        url = ""
        if Util.isAA(srv) then url = Util.toText(srv.url)
        return { audio: -1, sub: -1, burn: false, maxBitrate: Prefs.startQuality(url), defaultAudio: -1, sourceId: "" }
    end function

    function bitrateOf(opts as object) as integer
        if opts <> invalid and opts.maxBitrate <> invalid and opts.maxBitrate > 0 then return opts.maxBitrate
        return 120000000
    end function

    ' JSON for POST /Items/{id}/PlaybackInfo
    function infoBody(caps as object, opts as object, jellyfin = false as boolean) as string
        return formatJson({ "DeviceProfile": profile(caps, bitrateOf(opts), jellyfin) })
    end function

    ' Query for PlaybackInfo. forceTranscode: after a playback error, the server converts the video.
    ' Another audio track than the file's default, or burned-in subtitles, need the server too (remux / convert).
    function infoQuery(server as object, forceTranscode as boolean, opts as object) as string
        q = "UserId=" + Util.toText(server.userId) + "&IsPlayback=true&AutoOpenLiveStream=true&MaxStreamingBitrate=" + bitrateOf(opts).toStr()
        if opts.audio >= 0 then q = q + "&AudioStreamIndex=" + opts.audio.toStr()
        ' a chosen version (several files for one title)
        if Util.toText(opts.sourceId) <> "" then q = q + "&MediaSourceId=" + Util.toText(opts.sourceId)
        if opts.burn and opts.sub >= 0
            q = q + "&SubtitleStreamIndex=" + opts.sub.toStr()
        else
            q = q + "&SubtitleStreamIndex=-1"
        end if
        noDirect = noDirectOf(forceTranscode, opts)
        if noDirect then q = q + "&EnableDirectPlay=false"
        if forceTranscode then q = q + "&EnableDirectStream=false&AllowVideoStreamCopy=false"
        return q
    end function

    ' The stream to play from a PlaybackInfo answer → { url, streamFormat, method, mediaSourceId, playSessionId,
    ' sourceVideoCodec } or invalid
    function streamFrom(server as object, itemId as string, info as dynamic, forceTranscode as boolean, opts as object) as dynamic
        if info = invalid or GetInterface(info, "ifAssociativeArray") = invalid then return invalid
        sources = info.MediaSources
        if type(sources) <> "roArray" or sources.count() = 0 then return invalid
        src = sources[0]
        for each cand in sources
            if Util.toText(opts.sourceId) <> "" and Util.toText(cand.Id) = Util.toText(opts.sourceId) then src = cand
        end for
        r = {
            mediaSourceId: Util.toText(src.Id),
            playSessionId: Util.toText(info.PlaySessionId),
            sourceVideoCodec: videoCodec(src)
        }
        base = Util.toText(server.url)
        key = tokenParam(server)
        container = LCase(Util.toText(src.Container))
        noDirect = noDirectOf(forceTranscode, opts)
        if not noDirect and Util.flag(src, "SupportsDirectPlay") and container <> ""
            fmt = "mp4"
            if container.instr("mkv") >= 0 or container.instr("matroska") >= 0 then fmt = "mkv"
            if container = "ts" or container = "mpegts" then fmt = "ts"
            r.url = base + "/Videos/" + itemId + "/stream?static=true&MediaSourceId=" + r.mediaSourceId + "&PlaySessionId=" + r.playSessionId + "&DeviceId=" + Util.deviceId()
            ' Jellyfin: the token goes in the Video node's HttpHeaders, not in the URL (server / proxy logs).
            ' Emby: api_key in the URL, as before.
            r.headers = videoHeaders(server, r.url)
            if r.headers.count() = 0 then r.url = r.url + "&" + key
            r.streamFormat = fmt
            r.method = "DirectPlay"
            return r
        end if
        t = Util.toText(src.TranscodingUrl)
        if t = "" then return invalid
        ' (the token only goes along to the server itself: a relative path, or an absolute URL on the server's
        ' own host and not from https down to http; any other host named here gets no token)
        safe = Util.tokenSafeTarget(base, t)
        if not LCase(t).startsWith("http") then t = base + t
        if not safe
            Log.line("Cove: the conversion is on another host: no sign-in sent there")
        else if LCase(t).instr("api_key=") < 0 and LCase(t).instr("apikey=") < 0
            t = t + "&" + key
        end if
        Log.line("Cove: stream " + Util.redact(t.mid(base.len())))
        ' An H.264 conversion must stay within 1080p (the Roku's H.264 limit); a copied HEVC video is left alone
        ' (replaced, not appended: a repeated parameter reaches the server as "3840,1920" and it answers 500)
        if r.sourceVideoCodec <> "hevc" or forceTranscode or (opts.burn and opts.sub >= 0) then t = Util.setQuery(t, "MaxWidth", "1920")
        ' The chosen subtitle: burned in when it's an image, otherwise none in the video (the Roku shows text ones).
        ' (Set explicitly: some servers otherwise burn in the user's default subtitle.)
        if opts.burn and opts.sub >= 0
            t = Util.setQuery(Util.setQuery(t, "SubtitleStreamIndex", opts.sub.toStr()), "SubtitleMethod", "Encode")
        else
            t = Util.removeQuery(Util.removeQuery(t, "SubtitleStreamIndex"), "SubtitleMethod")
        end if
        if opts.audio >= 0 then t = Util.setQuery(t, "AudioStreamIndex", opts.audio.toStr())
        ' (v1.3.1 E-6) a forced conversion (the retry, a burned-in subtitle) at most 20 Mbit/s or the chosen
        ' quality: enough for 1080p H.264, the Roku's ceiling; a 4K source would otherwise come at up to ~100
        if forceTranscode or (opts.burn and opts.sub >= 0)
            capped = conversionBitrate(Util.toNumber(urlParam(t, "VideoBitrate")), opts)
            t = Util.setQuery(t, "VideoBitrate", capped.toStr())
            Log.line("Cove: stream: forced conversion, video at most " + Util.toText(capped \ 1000000) + " Mbit/s")
        end if
        r.url = t
        ' (Jellyfin also gets the sign-in header, for a playlist whose own URL has no key; nothing for another host)
        r.headers = []
        if safe then r.headers = videoHeaders(server, t)
        r.streamFormat = "hls"
        ' (v1.3.1 E-5) from the URL the server gave (a container remux of H.264 is a Direct Stream, an HEVC copy
        ' with DTS converted is a Transcode); the player corrects it from the server's TranscodingInfo
        r.sourceAudioCodec = audioCodecOf(src, opts.audio)
        r.method = guessMethod(t, r.sourceAudioCodec)
        ' (a forced conversion or a burned-in subtitle is always one, whatever the URL says)
        if forceTranscode or (opts.burn and opts.sub >= 0) then r.method = "Transcode"
        return r
    end function

    ' (v1.3.1 E-6) The video bitrate for a forced conversion: the URL's own when lower, else 20 Mbit/s or the
    ' chosen quality when that is lower
    function conversionBitrate(urlBitrate as dynamic, opts as object) as integer
        cap = 20000000
        if opts <> invalid and opts.maxBitrate <> invalid and opts.maxBitrate > 0 and opts.maxBitrate < cap then cap = opts.maxBitrate
        if urlBitrate <> invalid and urlBitrate > 0 and urlBitrate < cap then return Int(urlBitrate)
        return cap
    end function

    ' The file itself can't be played: a forced conversion, a burned-in subtitle, another audio track than the
    ' file's default, or (v1.7.1 SP6-3) a large MKV started as a stream (opts.remux, Settings → Playback)
    function noDirectOf(forceTranscode as boolean, opts as object) as boolean
        if forceTranscode or Util.flag(opts, "remux") then return true
        return (opts.burn and opts.sub >= 0) or (opts.audio >= 0 and opts.audio <> opts.defaultAudio)
    end function

    ' ---------------------------------------------------------------- v1.7.1 SPEED (SP6-1, SP6-3)

    ' (SP6-3) Settings → Playback → Start MKV Files as a Stream (default Off; one key for this Roku)
    function mkvStreamOn() as boolean
        return Prefs.flagOn("mkvStream", false)
    end function

    ' (SP6-3) the bitrate above which an MKV is started as a stream. v1.7.1 (Liviu's device log): 0 = every
    ' MKV, because a 7 Mbit/s 1080p MKV sat 6.5 s at 10 % buffer while the Roku read the file's layout
    function mkvStreamMinBitrate() as integer
        return 0
    end function

    ' The MediaSources entry with this Id in an item / PlaybackInfo JSON, else the first one, else invalid
    function sourceOf(info as dynamic, sourceId as string) as dynamic
        if not Util.isAA(info) or type(info.MediaSources) <> "roArray" or info.MediaSources.count() = 0 then return invalid
        for each cand in info.MediaSources
            if sourceId <> "" and Util.isAA(cand) and Util.toText(cand.Id) = sourceId then return cand
        end for
        first = info.MediaSources[0]
        if Util.isAA(first) then return first
        return invalid
    end function

    ' A source's bitrate in bit/s: its Bitrate, else Size × 8 / run time; 0 when unknown
    function sourceBitrate(src as dynamic) as integer
        if not Util.isAA(src) then return 0
        b = Util.toNumber(src.Bitrate)
        if b > 0 then return Int(b)
        bytes = Util.toNumber(src.Size)
        runSecs = seconds(src.RunTimeTicks)
        if bytes > 0 and runSecs > 0 then return Int(bytes * 8.0 / runSecs)
        return 0
    end function

    ' (SP6-3) start this source as a stream (the server repackages it into HLS, video and audio copied)?
    ' Only with the setting on, for an MKV file above mkvStreamMinBitrate (0 = any MKV, its bitrate unknown too)
    function wantsMkvStream(src as dynamic, settingOn as boolean) as boolean
        if not settingOn or not Util.isAA(src) then return false
        c = LCase(Util.toText(src.Container))
        if c.instr("mkv") < 0 and c.instr("matroska") < 0 then return false
        if mkvStreamMinBitrate() <= 0 then return true
        return sourceBitrate(src) > mkvStreamMinBitrate()
    end function

    ' (SP6-1) A number with at most 3 decimals ("23.976", "24", "0.5"); "?" when missing
    function startDec(v as dynamic) as string
        if v = invalid then return "?"
        n = Util.toNumber(v)
        if n < 0 then return "-" + startDec(-n)
        k = Int(n * 1000 + 0.5)
        whole = k \ 1000
        frac = k mod 1000
        if frac = 0 then return whole.toStr()
        f = Right("00" + frac.toStr(), 3)
        while f.len() > 0 and f.mid(f.len() - 1) = "0"
            f = f.mid(0, f.len() - 1)
        end while
        return whole.toStr() + "." + f
    end function

    ' (SP6-1) bit/s → whole Mbit/s text ("62"); "?" when unknown
    function startMbit(bps as dynamic) as string
        n = Util.toNumber(bps)
        if n <= 0 then return "?"
        return Int((n + 500000) / 1000000).toStr()
    end function

    ' (SP6-1) The file's facts for "Cove: player start <ms> content set ...":
    ' "mkv DirectPlay hevc 3840x2160 HDR 10 23.976 fps 62 Mbit/s audio eac3 6ch tracks a3 s14 resume 0 s"
    ' (a stream format other than the container is added in brackets: "mkv DirectStream (hls) ...")
    function startFacts(src as dynamic, streamFormat as string, method as string, audioIndex as integer, resumeSecs as float) as string
        if not Util.isAA(src) then return "? " + method + " (no source facts) resume " + Int(resumeSecs).toStr() + " s"
        container = LCase(Util.toText(src.Container))
        if container = "" then container = "?"
        out = container + " " + method
        if streamFormat <> "" and container.instr(streamFormat) < 0 then out = out + " (" + streamFormat + ")"
        vid = invalid
        aud = invalid
        firstAud = invalid
        na = 0
        ns = 0
        if type(src.MediaStreams) = "roArray"
            for each st in src.MediaStreams
                if Util.isAA(st)
                    kind = Util.toText(st.Type)
                    if kind = "Video" and vid = invalid then vid = st
                    if kind = "Audio"
                        na = na + 1
                        if firstAud = invalid then firstAud = st
                        if audioIndex >= 0 and Util.toNumber(st.Index) = audioIndex then aud = st
                        if audioIndex < 0 and aud = invalid and Util.flag(st, "IsDefault") then aud = st
                    end if
                    if kind = "Subtitle" then ns = ns + 1
                end if
            end for
        end if
        if aud = invalid then aud = firstAud
        if vid <> invalid
            out = out + " " + LCase(Util.toText(vid.Codec)) + " " + Util.toText(Util.toNumber(vid.Width)) + "x" + Util.toText(Util.toNumber(vid.Height))
            vr = Util.toText(vid.VideoRangeType)
            if vr = "" or LCase(vr) = "unknown" then vr = Util.toText(vid.VideoRange)
            if vr = "" then vr = "?"
            out = out + " " + vr
            fps = vid.RealFrameRate
            if Util.toNumber(fps) <= 0 then fps = vid.AverageFrameRate
            if Util.toNumber(fps) <= 0 then fps = invalid
            out = out + " " + startDec(fps) + " fps"
        else
            out = out + " no video"
        end if
        out = out + " " + startMbit(sourceBitrate(src)) + " Mbit/s"
        if aud <> invalid
            out = out + " audio " + LCase(Util.toText(aud.Codec)) + " " + Util.toText(Util.toNumber(aud.Channels)) + "ch"
        else
            out = out + " audio none"
        end if
        out = out + " tracks a" + na.toStr() + " s" + ns.toStr() + " resume " + Int(resumeSecs).toStr() + " s"
        return out
    end function

    ' (SP6-1) roDeviceInfo.GetConnectionInfo() → "WiFiConnection 802.11ac signal -52 expected 180"
    ' (expectedThroughput printed as the Roku gives it)
    function startNet(ci as dynamic) as string
        if not Util.isAA(ci) then return "unknown"
        out = Util.toText(ci.type)
        if out = "" then out = "?"
        if Util.toText(ci.protocol) <> "" then out = out + " " + Util.toText(ci.protocol)
        if ci.signal <> invalid then out = out + " signal " + Util.toText(ci.signal)
        if ci.expectedThroughput <> invalid then out = out + " expected " + Util.toText(ci.expectedThroughput)
        return out
    end function

    ' (SP6-1) Video timeToStartStreaming + playStartInfo →
    ' "1.5 s · total 7.9 · prebuf 5.2 from 0.3 · manifest 0"
    function startPlayInfo(psi as dynamic, timeToStart as dynamic) as string
        out = startDec(timeToStart) + " s"
        if not Util.isAA(psi) or psi.count() = 0 then return out + " · no playStartInfo"
        out = out + " · total " + startDec(psi.total_dur) + " · prebuf " + startDec(psi.prebuf_dur) + " from " + startDec(psi.prebuf_start) + " · manifest " + startDec(psi.manifest_dur)
        if Util.toNumber(psi.drm_load_dur) > 0 or Util.toNumber(psi.drm_lic_acq_dur) > 0 then out = out + " · drm " + startDec(psi.drm_load_dur) + " + " + startDec(psi.drm_lic_acq_dur)
        return out
    end function

    ' (SP6-1) Video streamInfo + videoFormat / audioFormat → "62000000 measured 140000000 · decodes hevc eac3"
    ' (bit/s as the Roku gives them)
    function startStreamInfo(si as dynamic, videoFormat as dynamic, audioFormat as dynamic) as string
        out = "?"
        if Util.isAA(si)
            out = Util.toText(si.streamBitrate)
            if out = "" then out = "?"
            meas = Util.toText(si.measuredBitrate)
            if meas = "" then meas = "?"
            out = out + " measured " + meas
        end if
        vf = Util.toText(videoFormat)
        if vf = "" then vf = "?"
        af = Util.toText(audioFormat)
        if af = "" then af = "?"
        return out + " · decodes " + vf + " " + af
    end function

    ' (SP6-1) the 10 % step a buffer percentage is in (0, 10 ... 100)
    function startBufStep(pct as dynamic) as integer
        n = Int(Util.toNumber(pct))
        if n < 0 then n = 0
        if n > 100 then n = 100
        return (n \ 10) * 10
    end function

    ' ---------------------------------------------------------------- end v1.7.1 SPEED

    ' (v1.3.1 E-5) The real play method of a stream, as the servers count it (Cove for macOS PlayMethod.guess):
    ' DirectPlay = the file itself (static=true); Transcode = the URL forbids a video or audio copy, burns a
    ' subtitle in, asks for an audio codec the source track isn't in, or names a reason other than the
    ' container (or the subtitle, when none is burned in); anything else on HLS is a DirectStream (a remux)
    function guessMethod(url as string, sourceAudio = "" as string) as string
        if LCase(urlParam(url, "static")) = "true" then return "DirectPlay"
        if LCase(urlParam(url, "AllowVideoStreamCopy")) = "false" then return "Transcode"
        if LCase(urlParam(url, "AllowAudioStreamCopy")) = "false" then return "Transcode"
        burn = LCase(urlParam(url, "SubtitleMethod")) = "encode"
        if burn and urlParam(url, "SubtitleStreamIndex") <> "" then return "Transcode"
        a = LCase(sourceAudio.trim())
        allowed = LCase(urlParam(url, "AudioCodec"))
        if a <> "" and allowed <> ""
            found = false
            for each c in allowed.split(",")
                if c.trim() = a then found = true
            end for
            if not found then return "Transcode"
        end if
        for each reason in urlParam(url, "TranscodeReasons").split(",")
            rs = reason.trim()
            containerOnly = rs = "ContainerNotSupported" or rs = "ContainerBitrateExceedsLimit"
            subOnly = rs = "SubtitleCodecNotSupported" or rs = "SubtitleFormatNotSupported"
            if rs <> "" and not containerOnly and (burn or not subOnly) then return "Transcode"
        end for
        return "DirectStream"
    end function

    ' (v1.3.1 E-5) The method from the server's session (GET /Sessions?DeviceId=: TranscodingInfo
    ' IsVideoDirect / IsAudioDirect), else the URL guess (Cove for macOS PlayMethod.classify)
    function classifyMethod(url as string, info as dynamic, sourceAudio = "" as string) as string
        if LCase(urlParam(url, "static")) = "true" then return "DirectPlay"
        if not Util.isAA(info) then return guessMethod(url, sourceAudio)
        hasV = info.doesExist("IsVideoDirect") and info.IsVideoDirect <> invalid
        hasA = info.doesExist("IsAudioDirect") and info.IsAudioDirect <> invalid
        if not hasV and not hasA then return guessMethod(url, sourceAudio)
        ' (a stream without audio has nothing to convert there: IsAudioDirect may be missing)
        audioOk = not hasA or Util.flag(info, "IsAudioDirect")
        if Util.flag(info, "IsVideoDirect") and audioOk then return "DirectStream"
        return "Transcode"
    end function

    ' A query parameter's value (name not case-sensitive, %2C as a comma), "" when missing
    function urlParam(url as string, name as string) as string
        q = url.instr("?")
        if q < 0 then return ""
        want = LCase(name)
        for each part in url.mid(q + 1).split("&")
            eq = part.instr("=")
            if eq > 0 and LCase(part.left(eq)) = want then return part.mid(eq + 1).replace("%2C", ",").replace("%2c", ",")
        end for
        return ""
    end function

    ' The codec of the audio track played: stream index audioIndex, else the file's default (else the first)
    function audioCodecOf(src as object, audioIndex as integer) as string
        if not Util.isAA(src) or type(src.MediaStreams) <> "roArray" then return ""
        first = ""
        flagged = ""
        for each s in src.MediaStreams
            if Util.isAA(s) and Util.toText(s.Type) = "Audio"
                c = LCase(Util.toText(s.Codec))
                if audioIndex >= 0 and Util.toNumber(s.Index) = audioIndex then return c
                if first = "" then first = c
                if flagged = "" and Util.flag(s, "IsDefault") then flagged = c
            end if
        end for
        if audioIndex >= 0 then return ""
        if flagged <> "" then return flagged
        return first
    end function

    ' The access token as a query parameter, for a URL handed to a node that can't send headers (Poster) or to
    ' Emby. Jellyfin 10.8 and later read "ApiKey"; Jellyfin 12 turns legacy authorization off, so "api_key"
    ' (like the X-Emby-Token / X-Emby-Authorization headers) answers 401 there. Emby only knows "api_key".
    function tokenParam(server as object) as string
        name = "api_key"
        if Servers.isJellyfin(server) then name = "ApiKey"
        return name + "=" + Util.toText(server.token)
    end function

    ' HttpHeaders for a Video ContentNode ("Name:value" strings): Jellyfin's sign-in header
    ' (Authorization: MediaBrowser ..., Token="..."), the form every Jellyfin from 10.8 to 12 accepts. Empty for
    ' Emby (it keeps api_key in the URL), without a token, or for a URL on another host than the server's.
    function videoHeaders(server as object, url as string) as object
        if not Servers.isJellyfin(server) or Util.toText(server.token) = "" then return []
        if not Util.tokenSafeTarget(Util.toText(server.url), url) then return []
        h = Api.headers(server, true)
        return ["Authorization:" + Util.toText(h["Authorization"])]
    end function

    function videoCodec(src as object) as string
        if type(src.MediaStreams) <> "roArray" then return ""
        for each s in src.MediaStreams
            if Util.toText(s.Type) = "Video" then return LCase(Util.toText(s.Codec))
        end for
        return ""
    end function

    ' Seconds → server ticks (100 ns), as a 64-bit number
    function ticks(secs as float) as longinteger
        whole = Int(secs)
        if whole < 0 then whole = 0
        return whole * 10000000&
    end function

    ' Server ticks (number or text) → seconds
    function seconds(t as dynamic) as float
        if t = invalid then return 0
        if GetInterface(t, "ifString") <> invalid then t = t.toFloat() * 1
        return t / 10000000
    end function

    ' JSON for /Sessions/Playing, /Playing/Progress and /Playing/Stopped
    function reportBody(s as object, positionSeconds as float, paused as boolean) as string
        return formatJson({
            "ItemId": s.itemId,
            "MediaSourceId": s.mediaSourceId,
            "PlaySessionId": s.playSessionId,
            "PositionTicks": ticks(positionSeconds),
            "IsPaused": paused,
            "CanSeek": true,
            "PlayMethod": s.method
        })
    end function

    ' The server's SRT version of a text subtitle (Cove draws it over the video). No token in the URL (it would
    ' end up in server and proxy access logs): the download sends it as a header, subtitleHeaders().
    ' (v1.3.1 E-3) endSec > 0: only the cues up to there (the route with a start position of 0 and
    ' EndPositionTicks, the same on Emby and Jellyfin 10.9+; as Cove for macOS subtitleCues(upTo:))
    function subtitleUrl(server as object, itemId as string, sourceId as string, index as integer, endSec = -1.0 as float) as string
        base = Util.toText(server.url) + "/Videos/" + itemId + "/" + sourceId + "/Subtitles/" + index.toStr()
        if endSec > 0 then return base + "/0/Stream.srt?EndPositionTicks=" + ticks(endSec).toStr()
        return base + "/Stream.srt"
    end function

    ' (v1.3.1 E-3) What to do with one subtitle download: "use" (cues came), "askAll" (the first part failed
    ' or was empty: ask for the whole track), "keep" (the whole track failed after the first part: keep it),
    ' "burnIn" (the server can't send it as text: HTTP error), "failed" (no answer in time or empty: playback
    ' goes on without; burning in would need the same slow extraction). As Cove for macOS cueStep.
    function cueStep(code as integer, cueCount as integer, piece as boolean, haveCues as boolean) as string
        if code >= 200 and code < 400 and cueCount > 0 then return "use"
        if piece then return "askAll"
        if haveCues then return "keep"
        if code >= 400 then return "burnIn"
        return "failed"
    end function

    ' (v1.3.1 E-10) The session's copy of a whole subtitle track: a key of letters, digits, _ and - only
    function subCacheKey(itemId as string, sourceId as string, index as integer) as string
        raw = itemId + "_" + sourceId + "_" + index.toStr()
        return createObject("roRegex", "[^A-Za-z0-9_-]", "").replaceAll(raw, "")
    end function

    function subCacheFile(key as string) as string
        return "tmp:/cove-sub-" + key + ".srt"
    end function

    ' The sign-in headers for the subtitle download (ApiTask), without "Accept: application/json": the answer
    ' is SRT text
    function subtitleHeaders(server as object) as object
        h = Api.headers(server, true)
        h.delete("Accept")
        return h
    end function

    ' "1:02:05" / "34:12"
    function clock(secs as float) as string
        s = Int(secs)
        h = s \ 3600
        mm = (s mod 3600) \ 60
        ss = s mod 60
        out = ""
        if h > 0 then out = h.toStr() + ":" + Right("0" + mm.toStr(), 2) + ":"
        if h = 0 then out = mm.toStr() + ":"
        return out + Right("0" + ss.toStr(), 2)
    end function


    ' ---------------------------------------------------------------- seek thumbnails

    ' Emby's BIF thumbnails (Roku's own format, parsed like Cove for macOS PlayerModel.parseBIF): magic
    ' 89 42 49 46, frame count at 12, time unit (ms) at 16, then from 64 an index of (timestamp, offset)
    ' pairs, 4-byte little-endian each, then the JPEGs. Returns { path, times (ms), offsets } or invalid.
    function readBif(path as string) as dynamic
        ' (no roFileSystem here: it can't be created on the render thread, where this runs)
        head = createObject("roByteArray")
        ok = head.readFile(path, 0, 64)
        if not ok or head.count() < 64
            ' (some firmware refuses a partial read: read it all, it's a few MB at most)
            head = createObject("roByteArray")
            head.readFile(path)
        end if
        Log.line("Cove: BIF read " + Util.toText(head.count()) + " bytes, starts " + Util.toText(head.toHexString().left(32)))
        if head.count() < 72 then return invalid
        if head[0] <> &h89 or head[1] <> &h42 or head[2] <> &h49 or head[3] <> &h46 then return invalid
        count = le32(head, 12)
        unit = le32(head, 16)
        if unit <= 0 then unit = 1000
        if count <= 0 or count > 50000 then return invalid
        idx = head
        if head.count() < 64 + (count + 1) * 8
            idx = createObject("roByteArray")
            if not idx.readFile(path, 64, (count + 1) * 8) then return invalid
            base = 0
        else
            base = 64
        end if
        times = []
        offsets = []
        for i = 0 to count
            ts = le32(idx, base + i * 8)
            if ts = &hFFFFFFFF or ts = -1 then ts = -1
            times.push(ts * unit)
            offsets.push(le32(idx, base + i * 8 + 4))
        end for
        return { path: path, times: times, offsets: offsets }
    end function

    function le32(b as object, at as integer) as integer
        if at + 3 >= b.count() then return 0
        return b[at] + b[at + 1] * 256 + b[at + 2] * 65536 + b[at + 3] * 16777216
    end function

    ' Jellyfin trickplay: tiles of TileWidth x TileHeight thumbnails, from the item's "Trickplay" field.
    ' Returns { width, height, cols, rows, count, interval, url, query } or invalid.
    function trickplayInfo(server as object, item as object, sourceId as string) as dynamic
        tp = item.Trickplay
        if type(tp) <> "roAssociativeArray" then return invalid
        widths = tp[sourceId]
        if type(widths) <> "roAssociativeArray"
            for each k in tp
                widths = tp[k]
                exit for
            end for
        end if
        if type(widths) <> "roAssociativeArray" then return invalid
        best = invalid
        bestW = 0
        for each w in widths
            n = w.toInt()
            ' the smallest at least 240 wide (Roku memory), else the largest
            if best = invalid or (n >= 240 and (bestW < 240 or n < bestW)) or (bestW < 240 and n > bestW)
                best = widths[w]
                bestW = n
            end if
        end for
        if best = invalid or best.Width = invalid or best.TileWidth = invalid then return invalid
        r = {}
        r.width = best.Width
        r.height = best.Height
        r.cols = best.TileWidth
        r.rows = best.TileHeight
        r.count = best.ThumbnailCount
        r.interval = best.Interval
        if r.interval = invalid or r.interval <= 0 then r.interval = 10000
        r.url = Util.toText(server.url) + "/Videos/" + Util.toText(item.Id) + "/Trickplay/" + bestW.toStr() + "/"
        ' (a Poster can't send headers, so the token stays in the URL: ApiKey for Jellyfin 12, see tokenParam)
        r.query = ".jpg?MediaSourceId=" + sourceId + "&" + tokenParam(server)
        return r
    end function

    ' (v1.2 SP-13b) The item JSON a details page already loaded, for the player (which then skips its own item
    ' request): the whole item without the cast (People), which the player never reads; invalid without
    ' MediaSources (nothing the player could use)
    function playerInfoOf(src as dynamic) as dynamic
        if not Util.isAA(src) or type(src.MediaSources) <> "roArray" then return invalid
        out = {}
        for each k in src
            if LCase(k) <> "people" then out[k] = src[k]
        end for
        return out
    end function

    ' (v1.2 SP-14) The fields the player reads from an episode in its series' list (previous / next, Up next,
    ' the Episodes panel, rating checks): no Overview, one image per type
    function episodeListFields() as string
        return "Fields=PrimaryImageAspectRatio,OfficialRating&EnableUserData=true&ImageTypeLimit=1&EnableImageTypes=Primary,Thumb,Backdrop"
    end function

    ' (v1.2 SP-14) Only the episodes beside epId in its series' list (the one before, itself and the one after):
    ' AdjacentTo on /Shows/{id}/Episodes (Emby and Jellyfin)
    function adjacentEpisodesPath(userKey as string, showId as string, epId as string) as string
        return "/Shows/" + showId + "/Episodes?UserId=" + userKey + "&AdjacentTo=" + epId + "&IsMissing=false&" + episodeListFields()
    end function

    ' The whole series' list (the Episodes panel, or a rating limit that has to skip episodes)
    function seriesEpisodesPath(userKey as string, showId as string) as string
        return "/Shows/" + showId + "/Episodes?UserId=" + userKey + "&IsMissing=false&" + episodeListFields()
    end function

    ' (v1.2 SP-13c) Cinema Mode intros: the old route (Emby, Jellyfin up to 10.8) or the new one (Jellyfin 10.9+)
    function introsPath(userKey as string, titleId as string, newRoute as boolean) as string
        if newRoute then return "/Items/" + titleId + "/Intros?userId=" + userKey
        return "/Users/" + userKey + "/Items/" + titleId + "/Intros"
    end function

    ' (v1.3 U-4) Left / Right held on the progress bar: the step for one key repeat after heldMs of holding.
    ' The first second keeps the normal step (Settings → Skip back / forward), then 30 s, from 3 s 60 s and
    ' from 5 s 120 s per repeat (never below the normal step).
    function holdSeekStep(heldMs as integer, baseStep as integer) as integer
        st = baseStep
        if heldMs >= 5000
            st = 120
        else if heldMs >= 3000
            st = 60
        else if heldMs >= 1000
            st = 30
        end if
        if st < baseStep then st = baseStep
        return st
    end function

    ' (v1.3 NV-16) Rewind / Fast forward pressed again within a second: the press number in that run (0 = the
    ' first) → its jump: 30, 30, 60, 60, 120, 120, then 300 s (never below the Jump buttons setting)
    function jumpStreakStep(pressIndex as integer, baseStep as integer) as integer
        steps = [30, 30, 60, 60, 120, 120, 300]
        i = pressIndex
        if i < 0 then i = 0
        if i > steps.count() - 1 then i = steps.count() - 1
        st = steps[i]
        if pressIndex <= 0 then st = baseStep
        if st < baseStep then st = baseStep
        return st
    end function

    ' (v1.3.1 E-1) Whether Cove must mark a title played itself when it stops at atSec. At 90 % or more the
    ' Stopped report already makes the server mark it (MaxResumePct, 90 by default); a second POST made the
    ' server's Trakt / Playback Reporting plugins log two plays (Cove for macOS 5724be0). Only a stop in the
    ' credits (creditsAt > 0) below 90 % needs the POST, since the server leaves that one unwatched.
    function needsPlayedMark(atSec as float, duration as float, creditsAt as float) as boolean
        if duration <= 0 or atSec >= duration * 0.9 then return false
        return creditsAt > 0 and atSec >= creditsAt
    end function

    ' (v1.3) Where the Up Next card shows in an episode: at the server's credits (Emby CreditsStart chapter,
    ' Jellyfin Outro segment), else 30 s before the end (episodes longer than 2 minutes); -1 = never
    function upNextStart(creditsAt as float, duration as float) as float
        if creditsAt > 0 and (duration <= 0 or creditsAt < duration - 1) then return creditsAt
        if duration > 120 then return duration - 30
        return -1.0
    end function

    ' ---------------------------------------------------------------- v1.5.2 player

    ' (v1.5.2 P5-2) Where an episode picked in the player (Next / Previous / Up Next / Episodes panel) starts:
    ' its saved resume point, as Cove for macOS (resumes past 30 s); 0 when watched, under 30 s or unknown
    function resumeAtOf(ep as dynamic) as float
        ud = Util.field(ep, "UserData")
        if not Util.isAA(ud) or Util.flag(ud, "Played") then return 0.0
        secs = Util.toNumber(ud.PlaybackPositionTicks) / 10000000.0
        if secs < 30 then return 0.0
        return secs
    end function

    ' (v1.5.2 P5-3) An episode the server only lists (missing / not aired yet, no file): it can't play, so it is
    ' never previous / next or in the Episodes panel
    function isMissingEpisode(ep as dynamic) as boolean
        if not Util.isAA(ep) then return false
        if Util.toText(ep.LocationType) = "Virtual" then return true
        return Util.flag(ep, "IsMissing")
    end function

    ' (v1.5.2 P5-7) Where to go on after a video error: the Video node's position, else the last position seen
    ' (it can read 0 after an error), else where the session started
    function errorResumeAt(videoPos as float, lastSeen as float, startAt as float) as float
        if videoPos >= 1 then return videoPos
        if lastSeen >= 1 then return lastSeen
        return startAt
    end function

    ' (v1.5.2 P5-8) A "finished" from the Video node that isn't the real end: the last position seen is more
    ' than a minute before the end and not yet in the credits (an HLS conversion that stopped early)
    function endedEarly(lastSeen as float, duration as float, creditsAt as float) as boolean
        if duration <= 0 then return false
        if creditsAt > 0 and lastSeen >= creditsAt then return false
        return lastSeen < duration - 60
    end function

    ' ---------------------------------------------------------------- v1.6 PLAYER (M-1 Play Collection)

    ' (isCollectionPlayable, collectionSortBy and collectionQueue moved to QuickPlay in v1.7: the Play key on a
    ' collection card, in MainScene, uses them too)

    ' (v1.6 M-1) Where the Up Next card shows in a collection's film: at the credits marker when it lies in the
    ' second half, else 5 minutes before the end, never before half the film; -1 = never (films under 10 min)
    function collectionUpNextStart(creditsAt as float, duration as float) as float
        if duration <= 0 then return -1.0
        half = duration / 2
        if creditsAt >= half and creditsAt < duration - 1 then return creditsAt
        if duration < 600 then return -1.0
        at = duration - 300
        if at < half then at = half
        return at
    end function

    ' (v1.6 M-1) "Up Next · Film 2 of 3" (next = the next film's 0-based place, count = films in the collection)
    function collectionHeading(next_ as integer, count as integer) as string
        if next_ < 0 or count <= 0 then return "Up Next"
        return "Up Next · Film " + (next_ + 1).toStr() + " of " + count.toStr()
    end function

    ' (v1.6 M-1) A film's name with its year: "The Two Towers (2002)"
    function filmTitle(entry as dynamic) as string
        n = Util.toText(Util.field(entry, "Name"))
        y = Util.toNumber(Util.field(entry, "ProductionYear"))
        if y <> invalid and y > 0 then n = n + " (" + Int(y).toStr() + ")"
        return n
    end function

end namespace
