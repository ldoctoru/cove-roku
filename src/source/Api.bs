import "pkg:/source/Util.bs"
import "pkg:/source/Servers.bs"

' Talking to Emby / Jellyfin. headers() is used on the UI thread to build requests; execute() runs on a Task
' thread (roUrlTransfer can't run on the render thread).
namespace Api

    ' The MediaBrowser authorization header. Jellyfin reads it from "Authorization", Emby from
    ' "X-Emby-Authorization" (+ "X-Emby-Token" once signed in).
    function headers(server as object, withToken as boolean) as object
        q = chr(34)
        value = "MediaBrowser Client=" + q + "Cove" + q + ", Device=" + q + headerName(Util.deviceName(), Servers.isJellyfin(server)) + q + ", DeviceId=" + q + Util.deviceId() + q + ", Version=" + q + Util.appVersion() + q
        token = ""
        if withToken then token = Util.toText(server.token)
        if token <> "" then value = value + ", Token=" + q + token + q
        h = { "Accept": "application/json" }
        if Servers.isJellyfin(server)
            h["Authorization"] = value
        else
            h["X-Emby-Authorization"] = value
            if token <> "" then h["X-Emby-Token"] = token
        end if
        return h
    end function

    ' The Roku's name as a header value: a quote or comma broke the header, and a non-ASCII name ("Sufragerie
    ' Română") is not a valid header value. Jellyfin URL-decodes the value (its own apps encode it); for Emby
    ' only plain ASCII is kept.
    function headerName(name as string, jellyfin as boolean) as string
        out = ""
        for i = 0 to name.len() - 1
            c = Asc(name.mid(i, 1))
            if c >= 32 and c < 127 and c <> 34 and c <> 44 then out = out + Chr(c)
        end for
        ' (a plain name is sent as it is, as before)
        if out = name then return name
        if jellyfin then return name.encodeUriComponent()
        out = out.trim()
        if out = "" then out = "Roku"
        return out
    end function

    ' Runs one request: { method, url, headers, body (JSON text or ""), timeout (ms), tag }
    ' → { code (HTTP status, or < 0 for a network error), json, error, tag }
    function execute(req as object) as object
        res = { code: -1, json: invalid, error: "", tag: req.tag }
        xfer = createObject("roUrlTransfer")
        port = createObject("roMessagePort")
        xfer.setPort(port)
        xfer.setUrl(req.url)
        ' Always, also for http: a server that redirects http to https needs it for the redirected request.
        ' (checks the server's certificate; no client certificate is needed, so no InitClientCertificates)
        xfer.setCertificatesFile("common:/certs/ca-bundle.crt")
        xfer.enableEncodings(true)
        xfer.retainBodyOnError(true)
        if req.headers <> invalid
            for each k in req.headers
                xfer.addHeader(k, req.headers[k])
            end for
        end if
        method = UCase(Util.toText(req.method))
        if method = "" then method = "GET"
        body = Util.toText(req.body)
        ' a request that should run later (e.g. stopping a server conversion again after 2 s and 6 s)
        if req.delay <> invalid and req.delay > 0 then sleep(req.delay)
        started = false
        if req.saveTo <> invalid
            ' download to a file (BIF thumbnails); the response has only the code
            started = xfer.asyncGetToFile(req.saveTo)
        else if method = "GET"
            started = xfer.asyncGetToString()
        else
            xfer.setRequest(method)
            if body <> "" then xfer.addHeader("Content-Type", "application/json")
            started = xfer.asyncPostFromString(body)
        end if
        if not started
            res.error = "The request couldn't be started."
            return res
        end if
        timeout = 15000
        if req.timeout <> invalid then timeout = req.timeout
        msg = wait(timeout, port)
        if type(msg) = "roUrlEvent"
            res.code = msg.getResponseCode()
            text = invalid
            if req.saveTo = invalid then text = msg.getString()
            ' (a text answer, e.g. subtitles: req.keepText; otherwise JSON)
            if req.keepText = true
                res.text = text
            else if text <> invalid and text <> ""
                res.json = parseJson(text)
            end if
            if res.code < 0 then res.error = Util.toText(msg.getFailureReason())
        else
            xfer.asyncCancel()
            res.error = "The server didn't answer in time."
        end if
        return res
    end function

    ' JSON text for {"Username": name, "Pw": password} (built by hand so the key case is kept exactly)
    function credentialsBody(name as string, password as string) as string
        return "{" + chr(34) + "Username" + chr(34) + ":" + formatJson(name) + "," + chr(34) + "Pw" + chr(34) + ":" + formatJson(password) + "}"
    end function

    ' A short, user-facing reason for a failed request
    function describeFailure(res as object) as string
        if res.code = 401 then return "The server refused the sign-in (401)."
        if res.code > 0 then return "The server answered with error " + Util.toText(res.code) + "."
        if res.error <> "" then return res.error
        return "No connection to the server."
    end function

end namespace
