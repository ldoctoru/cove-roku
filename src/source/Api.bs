import "pkg:/source/Util.bs"
import "pkg:/source/Servers.bs"

' Talking to Emby / Jellyfin. headers() is used on the UI thread to build requests; execute() runs on a Task
' thread (roUrlTransfer can't run on the render thread).
namespace Api

    ' The MediaBrowser authorization header. Jellyfin reads it from "Authorization", Emby from
    ' "X-Emby-Authorization" (+ "X-Emby-Token" once signed in).
    function headers(server as object, withToken as boolean) as object
        q = chr(34)
        value = "MediaBrowser Client=" + q + "Cove" + q + ", Device=" + q + headerName(Util.deviceName(), Servers.isJellyfin(server)) + q + ", DeviceId=" + q + Util.deviceId() + q + ", Version=" + q + Util.appVersion() + q
        token = ""
        if withToken then token = Util.toText(server.token)
        if token <> "" then value = value + ", Token=" + q + token + q
        h = { "Accept": "application/json" }
        if Servers.isJellyfin(server)
            h["Authorization"] = value
        else
            h["X-Emby-Authorization"] = value
            if token <> "" then h["X-Emby-Token"] = token
        end if
        return h
    end function

    ' The Roku's name as a header value: a quote or comma broke the header, and a non-ASCII name ("Sufragerie
    ' Română") is not a valid header value. Jellyfin URL-decodes the value (its own apps encode it); for Emby
    ' only plain ASCII is kept.
    function headerName(name as string, jellyfin as boolean) as string
        out = ""
        for i = 0 to name.len() - 1
            c = Asc(name.mid(i, 1))
            if c >= 32 and c < 127 and c <> 34 and c <> 44 then out = out + Chr(c)
        end for
        ' (a plain name is sent as it is, as before)
        if out = name then return name
        if jellyfin then return name.encodeUriComponent()
        out = out.trim()
        if out = "" then out = "Roku"
        return out
    end function

    ' Runs one request: { method, url, headers, body (JSON text or ""), timeout (ms), tag }
    ' → { code (HTTP status, or < 0 for a network error), json (an object / list or invalid), value (a bare JSON
    ' value), error, tag }
    function execute(req as object) as object
        res = { code: -1, json: invalid, value: invalid, error: "", tag: req.tag }
        xfer = createObject("roUrlTransfer")
        port = createObject("roMessagePort")
        xfer.setPort(port)
        xfer.setUrl(req.url)
        ' Always, also for http: a server that redirects http to https needs it for the redirected request.
        ' (checks the server's certificate; no client certificate is needed, so no InitClientCertificates)
        xfer.setCertificatesFile("common:/certs/ca-bundle.crt")
        xfer.enableEncodings(true)
        xfer.retainBodyOnError(true)
        if req.headers <> invalid
            for each k in req.headers
                xfer.addHeader(k, req.headers[k])
            end for
        end if
        method = UCase(Util.toText(req.method))
        if method = "" then method = "GET"
        body = Util.toText(req.body)
        ' a request that should run later (e.g. stopping a server conversion again after 2 s and 6 s)
        if req.delay <> invalid and req.delay > 0 then sleep(req.delay)
        started = false
        if req.saveTo <> invalid
            ' download to a file (BIF thumbnails); the response has only the code
            started = xfer.asyncGetToFile(req.saveTo)
        else if method = "GET"
            started = xfer.asyncGetToString()
        else
            xfer.setRequest(method)
            if body <> "" then xfer.addHeader("Content-Type", "application/json")
            started = xfer.asyncPostFromString(body)
        end if
        if not started
            res.error = "The request couldn't be started."
            return res
        end if
        timeout = 15000
        if req.timeout <> invalid then timeout = req.timeout
        msg = wait(timeout, port)
        if type(msg) = "roUrlEvent"
            res.code = msg.getResponseCode()
            text = invalid
            if req.saveTo = invalid then text = msg.getString()
            ' (a text answer, e.g. subtitles: req.keepText; otherwise JSON)
            if Util.flag(req, "keepText")
                res.text = text
            else if text <> invalid and text <> ""
                res.json = parseJson(text)
                ' (json is only ever an object or a list: a bare string / number from a captive portal or a broken
                ' proxy would otherwise reach code that reads fields from it. A bare value, e.g. Jellyfin's
                ' /QuickConnect/Enabled "true", is kept in res.value.)
                if res.json <> invalid and GetInterface(res.json, "ifAssociativeArray") = invalid and type(res.json) <> "roArray"
                    res.value = res.json
                    res.json = invalid
                end if
            end if
            if res.code < 0 then res.error = Util.toText(msg.getFailureReason())
        else
            xfer.asyncCancel()
            res.error = "The server didn't answer in time."
        end if
        return res
    end function

    ' (v1.2) Several GETs at once on one port: the total time is about the slowest request instead of the sum
    ' (Home's rows). At most maxInFlight run together (the next starts as one answers), and each has its own
    ' deadline (perRequestMs from its start), so one request that never answers costs its own deadline, not
    ' the whole Home. reqs = [{ url, headers }]; returns one result per request, in order, shaped like
    ' execute()'s plus ms (from that request's start); unanswered ones get code -1 and timedOut = true.
    function executeMany(reqs as object, perRequestMs = 8000 as integer, maxInFlight = 4 as integer) as object
        results = []
        for i = 0 to reqs.count() - 1
            results.push({ code: -1, json: invalid, value: invalid, error: "", ms: 0, timedOut: false })
        end for
        port = createObject("roMessagePort")
        spent = createObject("roTimespan")
        running = {}            ' identity -> { i, xfer, at }
        nextUp = 0
        busy = 0
        while nextUp < reqs.count() or busy > 0
            ' start more while there is room
            while busy < maxInFlight and nextUp < reqs.count()
                i = nextUp
                nextUp = nextUp + 1
                req = reqs[i]
                xfer = createObject("roUrlTransfer")
                xfer.setPort(port)
                xfer.setUrl(req.url)
                xfer.setCertificatesFile("common:/certs/ca-bundle.crt")
                xfer.enableEncodings(true)
                xfer.retainBodyOnError(true)
                if req.headers <> invalid
                    for each k in req.headers
                        xfer.addHeader(k, req.headers[k])
                    end for
                end if
                if xfer.asyncGetToString()
                    running[xfer.getIdentity().toStr()] = { i: i, xfer: xfer, at: spent.totalMilliseconds() }
                    busy = busy + 1
                else
                    results[i].error = "The request couldn't be started."
                end if
            end while
            if busy = 0 then exit while
            ' wait until the nearest deadline at most
            now = spent.totalMilliseconds()
            soonest = 0
            for each key in running
                due = running[key].at + perRequestMs
                if soonest = 0 or due < soonest then soonest = due
            end for
            remain = soonest - now
            if remain < 1 then remain = 1
            msg = wait(remain, port)
            if type(msg) = "roUrlEvent"
                key = msg.getSourceIdentity().toStr()
                if running.doesExist(key)
                    job = running[key]
                    running.delete(key)
                    busy = busy - 1
                    res = results[job.i]
                    res.ms = spent.totalMilliseconds() - job.at
                    res.code = msg.getResponseCode()
                    text = msg.getString()
                    if text <> invalid and text <> ""
                        res.json = parseJson(text)
                        if res.json <> invalid and GetInterface(res.json, "ifAssociativeArray") = invalid and type(res.json) <> "roArray"
                            res.value = res.json
                            res.json = invalid
                        end if
                    end if
                    if res.code < 0 then res.error = Util.toText(msg.getFailureReason())
                end if
            end if
            ' cancel the ones past their deadline
            now = spent.totalMilliseconds()
            late = []
            for each key in running
                if now - running[key].at >= perRequestMs then late.push(key)
            end for
            for each key in late
                job = running[key]
                job.xfer.asyncCancel()
                running.delete(key)
                busy = busy - 1
                results[job.i].ms = now - job.at
                results[job.i].timedOut = true
                results[job.i].error = "The server didn't answer in time."
            end for
        end while
        return results
    end function

    ' (v1.1.1) The timing line of one request: "http GET /Users/x/Items 200 143" (the path without its query,
    ' so no api_key or search term; ids are not secrets)
    function timingLine(method as string, url as string, code as integer, ms as integer) as string
        return "http " + UCase(method) + " " + pathOf(url) + " " + code.toStr() + " " + ms.toStr()
    end function

    ' The path of a URL without scheme, host and query: "https://h:8096/emby/Items?x=1" → "/emby/Items"
    function pathOf(url as string) as string
        p = url.split("?")[0]
        at = p.instr("://")
        if at >= 0
            p = p.mid(at + 3)
            slash = p.instr("/")
            if slash < 0 then return "/"
            p = p.mid(slash)
        end if
        return p
    end function

    ' (v1.1.1 SP-11) Which of two routes (the old /Users/{id}/... one or the newer Jellyfin one) answered on this
    ' server: remembered for the session, so the 404 + retry happens once. kind names the route ("trailers",
    ' "intros", or a routeKind path). Returns "old", "new" or "" (not known yet).
    function knownRoute(server as dynamic, kind as string) as string
        if m.global = invalid or not m.global.hasField("apiRoutes") then return ""
        cache = m.global.apiRoutes
        if not Util.isAA(cache) then return ""
        return Util.toText(cache[routeKey(server, kind)])
    end function

    sub rememberRoute(server as dynamic, kind as string, isNew as boolean)
        if m.global = invalid then return
        v = "old"
        if isNew then v = "new"
        if knownRoute(server, kind) = v then return
        if not m.global.hasField("apiRoutes") then m.global.addFields({ apiRoutes: {} })
        cache = m.global.apiRoutes
        if not Util.isAA(cache) or cache.count() > 60 then cache = {}
        cache[routeKey(server, kind)] = v
        m.global.apiRoutes = cache
    end sub

    function routeKey(server as dynamic, kind as string) as string
        return Util.toText(Util.field(server, "id")).left(12) + ":" + kind
    end function

    ' A request path as a route name: no query, no user id ("/Users/abc/Items/Latest?x" → "Items/Latest")
    function routeKind(path as string) as string
        p = path.split("?")[0]
        if p.left(7) = "/Users/"
            rest = p.mid(7)
            slash = rest.instr("/")
            if slash < 0 then return "Users"
            return rest.mid(slash + 1)
        end if
        if p.left(1) = "/" then p = p.mid(1)
        return p
    end function

    ' JSON text for {"Username": name, "Pw": password} (built by hand so the key case is kept exactly)
    function credentialsBody(name as string, password as string) as string
        return "{" + chr(34) + "Username" + chr(34) + ":" + formatJson(name) + "," + chr(34) + "Pw" + chr(34) + ":" + formatJson(password) + "}"
    end function

    ' A short, user-facing reason for a failed request
    function describeFailure(res as object) as string
        if res.code = 401 then return "The server refused the sign-in (401)."
        if res.code > 0 then return "The server answered with error " + Util.toText(res.code) + "."
        if res.error <> "" then return res.error
        return "No connection to the server."
    end function

end namespace
